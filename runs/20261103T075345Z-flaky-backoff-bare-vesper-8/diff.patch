+++ b/retrykit/backoff.py
@@ -6,8 +6,11 @@ def compute_delay(attempt, base=0.5, cap=30.0, jitter=0.1, rng=None):
     if attempt < 1:
         raise ValueError("attempt starts at 1")
     rng = rng or random
-    delay = min(cap, base * 2 ** (attempt - 1))
-    return delay * rng.uniform(1 - jitter, 1 + jitter)
+    delay = base * 2 ** (attempt - 1)
+    delay *= rng.uniform(1 - jitter, 1 + jitter)
+    # Clamp last: jitter can push a delay above cap, and docs/RETRY.md says
+    # no delay may ever exceed cap.
+    return min(cap, max(0.0, delay))
 
 
