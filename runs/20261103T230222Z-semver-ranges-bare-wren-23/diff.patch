+import unittest
+
+from depres import max_satisfying, satisfies
+
+CASES = [
+    ("1.2.3", "*", True),
+    ("1.2.3-alpha", "*", False),
+    ("1.2.3-alpha", "", False),
+    ("9.9.9", "", True),
+    ("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0", True),
+    ("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0", False),
+    ("2.0.0-rc.1", "^1.0.0", False),
+    ("1.5.0-beta", "^1.0.0", False),
+    ("1.2.3", ">= 1.2.3", True),
+    ("2.0.0", ">1", True),
+    ("1.9.9", ">1", False),
+    ("1.3.0", ">1.2", True),
+    ("1.2.9", ">1.2", False),
+    ("1.2.0", ">=1.2", True),
+    ("1.1.9", "<1.2", True),
+    ("1.2.0", "<1.2", False),
+    ("1.9.9", "<=1", True),
+    ("2.0.0", "<=1", False),
+    ("1.2.9", "<=1.2", True),
+    ("1.3.0", "<=1.2", False),
+    ("1.2.5", "=1.2", True),
+    ("1.3.0", "1.2", False),
+    ("1.9.0", "1", True),
+    ("2.3.9", "1.2.3 - 2.3", True),
+    ("2.4.0", "1.2.3 - 2.3", False),
+    ("2.9.9", "1.2.3 - 2", True),
+    ("3.0.0", "1.2.3 - 2", False),
+    ("1.2.2", "1.2.3 - 2", False),
+    ("0.0.3", "^0.0.3", True),
+    ("0.0.4", "^0.0.3", False),
+    ("0.2.9", "^0.2.3", True),
+    ("0.0.9", "^0.0", True),
+    ("0.1.0", "^0.0", False),
+    ("0.9.0", "^0", True),
+    ("1.0.0", "^0", False),
+    ("1.9.0", "^1.2.x", True),
+    ("1.2.3-beta.3", "~1.2.3-beta.2", True),
+    ("1.2.4-beta.3", "~1.2.3-beta.2", False),
+    ("1.9.0", "~1", True),
+    ("v1.2.3", "1.2.3", True),
+    ("1.2.3+b", "1.2.3", True),
+    ("1.0.0", "1.x || 3", True),
+]
+
+
+class ContractTest(unittest.TestCase):
+    def test_cases(self):
+        for version, range_, expected in CASES:
+            with self.subTest(version=version, range_=range_):
+                self.assertIs(satisfies(version, range_), expected)
+
+    def test_invalid(self):
+        for bad in ["1.x.3", ">=", "1.2.3 - ", "a", "^"]:
+            with self.subTest(range_=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+        with self.assertRaises(ValueError):
+            satisfies("bad", "1")
+
+    def test_max_satisfying_returns_original(self):
+        self.assertEqual(max_satisfying(["1.0.0", "2.0.0-beta", "v1.5.0"], "*"), "v1.5.0")
+        self.assertIsNone(max_satisfying([], "^1"))
+        with self.assertRaises(ValueError):
+            max_satisfying([], "x.1")
+
+
+if __name__ == "__main__":
+    unittest.main()
