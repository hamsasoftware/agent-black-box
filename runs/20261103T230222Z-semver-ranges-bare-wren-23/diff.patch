+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = rf"(?:x|X|\*|{_NUM})"
+_PRE_ID = r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+_PARTIAL = re.compile(
+    rf"^v?({_PART})(?:\.({_PART})(?:\.({_PART})"
+    rf"(?:-({_PRE_ID}(?:\.{_PRE_ID})*))?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?)?)?$"
+)
+_COMPARATOR = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$")
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+_HYPHEN = re.compile(r"\s+-\s+")
+
+_MIN = Version(0, 0, 0)
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, prerelease); wildcard/missing parts are None."""
+    match = _PARTIAL.match(text)
+    if not match:
+        raise ValueError(f"invalid range component: {text!r}")
+    major, minor, patch, pre = match.groups()
+    parts = []
+    seen_wild = False
+    for part in (major, minor, patch):
+        if part is None or part in ("x", "X", "*"):
+            seen_wild = True
+            parts.append(None)
+        else:
+            if seen_wild:
+                raise ValueError(f"invalid range component: {text!r}")
+            parts.append(int(part))
+    pre = tuple(pre.split(".")) if pre else ()
+    return (*parts, pre)
+
+
+def _v(major, minor, patch, pre=()):
+    return Version(major, minor, patch, pre)
+
+
+def _primitive(op, partial):
+    major, minor, patch, pre = partial
+    if major is None:
+        if op in (">", "<"):
+            return [("<", _MIN)]  # nothing is above/below "any"
+        return []
+    if op in ("", "="):
+        if minor is None:
+            return [(">=", _v(major, 0, 0)), ("<", _v(major + 1, 0, 0))]
+        if patch is None:
+            return [(">=", _v(major, minor, 0)), ("<", _v(major, minor + 1, 0))]
+        return [("=", _v(major, minor, patch, pre))]
+    if op == ">":
+        if minor is None:
+            return [(">=", _v(major + 1, 0, 0))]
+        if patch is None:
+            return [(">=", _v(major, minor + 1, 0))]
+        return [(">", _v(major, minor, patch, pre))]
+    if op == ">=":
+        return [(">=", _v(major, minor or 0, patch or 0, pre))]
+    if op == "<":
+        return [("<", _v(major, minor or 0, patch or 0, pre))]
+    if op == "<=":
+        if minor is None:
+            return [("<", _v(major + 1, 0, 0))]
+        if patch is None:
+            return [("<", _v(major, minor + 1, 0))]
+        return [("<=", _v(major, minor, patch, pre))]
+    raise ValueError(f"invalid operator: {op!r}")
+
+
+def _tilde(partial):
+    major, minor, patch, pre = partial
+    if major is None:
+        return []
+    if minor is None:
+        return [(">=", _v(major, 0, 0)), ("<", _v(major + 1, 0, 0))]
+    return [(">=", _v(major, minor, patch or 0, pre)), ("<", _v(major, minor + 1, 0))]
+
+
+def _caret(partial):
+    major, minor, patch, pre = partial
+    if major is None:
+        return []
+    if minor is None:
+        return [(">=", _v(major, 0, 0)), ("<", _v(major + 1, 0, 0))]
+    lower = (">=", _v(major, minor, patch or 0, pre))
+    if major > 0:
+        upper = _v(major + 1, 0, 0)
+    elif minor > 0 or patch is None:
+        upper = _v(0, minor + 1, 0)
+    else:
+        upper = _v(0, 0, patch + 1)
+    return [lower, ("<", upper)]
+
+
+def _hyphen(low, high):
+    result = []
+    lmajor, lminor, lpatch, lpre = low
+    if lmajor is not None:
+        result.append((">=", _v(lmajor, lminor or 0, lpatch or 0, lpre)))
+    hmajor, hminor, hpatch, hpre = high
+    if hmajor is None:
+        pass
+    elif hminor is None:
+        result.append(("<", _v(hmajor + 1, 0, 0)))
+    elif hpatch is None:
+        result.append(("<", _v(hmajor, hminor + 1, 0)))
+    else:
+        result.append(("<=", _v(hmajor, hminor, hpatch, hpre)))
+    return result
+
+
+def _parse_set(text):
+    text = text.strip()
+    if not text:
+        return []
+    if _HYPHEN.search(text):
+        parts = _HYPHEN.split(text)
+        if len(parts) != 2:
+            raise ValueError(f"invalid hyphen range: {text!r}")
+        return _hyphen(*(_parse_partial(p.strip()) for p in parts))
+    comparators = []
+    for token in _OP_SPACE.sub(r"\1", text).split():
+        op, rest = _COMPARATOR.match(token).groups()
+        partial = _parse_partial(rest)
+        if op == "~":
+            comparators += _tilde(partial)
+        elif op == "^":
+            comparators += _caret(partial)
+        else:
+            comparators += _primitive(op or "", partial)
+    return comparators
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _compare(op, version, bound):
+    if op == "<":
+        return version < bound
+    if op == "<=":
+        return version <= bound
+    if op == ">":
+        return version > bound
+    if op == ">=":
+        return version >= bound
+    return version == bound
+
+
+def _set_matches(comparators, version):
+    if not all(_compare(op, version, bound) for op, bound in comparators):
+        return False
+    if version.prerelease:
+        return any(
+            bound.prerelease and bound.release == version.release
+            for _, bound in comparators
+        )
+    return True
+
+
+def _to_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _matches(parsed, version):
+    return any(_set_matches(s, version) for s in parsed)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    parsed = _parse_range(range_)
+    return _matches(parsed, _to_version(version))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    parsed = _parse_range(range_)
+    best = best_item = None
+    for item in versions:
+        version = _to_version(item)
+        if _matches(parsed, version) and (best is None or version > best):
+            best, best_item = version, item
+    return best_item
