+++ b/tests/test_doctor.py
@@ -0,0 +1,97 @@
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.config import load_config, read_dotenv
+from payhook.doctor import doctor_report, redact_url
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SECRET = "sk_live_TESTSECRET_0123456789abcdef"
+
+
+def write_file(directory, name, text):
+    path = os.path.join(directory, name)
+    with open(path, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+class DotenvParsingTest(unittest.TestCase):
+    def parse(self, text):
+        with tempfile.TemporaryDirectory() as tmp:
+            return read_dotenv(write_file(tmp, ".env", text))
+
+    def test_export_with_quotes(self):
+        self.assertEqual(self.parse('export PAYHOOK_REGION="us"\n'), {"PAYHOOK_REGION": "us"})
+
+    def test_single_quotes_keep_hash_and_equals(self):
+        self.assertEqual(self.parse("K='a#b=c'\n"), {"K": "a#b=c"})
+
+    def test_inline_comment_after_unquoted_value(self):
+        self.assertEqual(self.parse("K=15   # seconds\n"), {"K": "15"})
+
+    def test_inline_comment_after_quoted_value(self):
+        self.assertEqual(self.parse('K="15" # seconds\n'), {"K": "15"})
+
+    def test_hash_without_space_stays_in_value(self):
+        self.assertEqual(self.parse("K=https://x.example/#frag\n"), {"K": "https://x.example/#frag"})
+
+    def test_spaces_around_key_and_value(self):
+        self.assertEqual(self.parse("  K  =  v  \n"), {"K": "v"})
+
+    def test_bom_and_comments_and_blank_lines(self):
+        self.assertEqual(self.parse("﻿# c\n\nK=v\n"), {"K": "v"})
+
+    def test_line_without_equals_is_ignored(self):
+        self.assertEqual(self.parse("garbage\nK=v\n"), {"K": "v"})
+
+    def test_export_loads_through_load_config(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = write_file(tmp, ".env", 'export PAYHOOK_TIMEOUT="25"\n')
+            config = load_config(environ={}, dotenv_path=path)
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("25", ".env"))
+
+
+class DoctorTest(unittest.TestCase):
+    def test_secrets_are_not_printed(self):
+        config = load_config(environ={"PAYHOOK_API_TOKEN": SECRET, "PAYHOOK_WEBHOOK_SECRET": "whsec_X"},
+                             dotenv_path="/nonexistent/.env")
+        text, _ = doctor_report(config, "/nonexistent/.env")
+        self.assertNotIn(SECRET, text)
+        self.assertNotIn("whsec_X", text)
+        self.assertIn(f"<redacted, {len(SECRET)} chars>", text)
+
+    def test_reports_source_for_each_setting(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = write_file(tmp, ".env", "PAYHOOK_REGION=us\nPAYHOOK_TIMEOUT=20\n")
+            config = load_config(environ={"PAYHOOK_TIMEOUT": "30"}, dotenv_path=path)
+            text, missing = doctor_report(config, path)
+        lines = {line.split()[0]: line for line in text.splitlines() if line.startswith("PAYHOOK_")}
+        self.assertIn("'us'", lines["PAYHOOK_REGION"])
+        self.assertTrue(lines["PAYHOOK_REGION"].endswith(".env"))
+        self.assertTrue(lines["PAYHOOK_TIMEOUT"].endswith("environment"))
+        self.assertTrue(lines["PAYHOOK_ENDPOINT"].endswith("default"))
+        self.assertIn("(not set)", lines["PAYHOOK_API_TOKEN"])
+        self.assertEqual(missing, ["PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"])
+
+    def test_url_credentials_are_hidden(self):
+        self.assertEqual(redact_url("https://u:[REDACTED:email]:8443/v1?x=1"),
+                         "https://***@api.example:8443/v1?x=1")
+        self.assertEqual(redact_url("https://api.example/v1"), "https://api.example/v1")
+
+    def test_doctor_command_exit_code_and_output(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            env = {k: v for k, v in os.environ.items() if not k.startswith("PAYHOOK_")}
+            env.update({"PYTHONPATH": ROOT, "PAYHOOK_API_TOKEN": SECRET,
+                        "PAYHOOK_WEBHOOK_SECRET": "whsec_Y"})
+            result = subprocess.run([sys.executable, "-m", "payhook", "doctor"],
+                                    cwd=tmp, capture_output=True, text=True, env=env)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn(SECRET, result.stdout)
+        self.assertIn("status: ok", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
