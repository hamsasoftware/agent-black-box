diff --git a/payhook/doctor.py b/payhook/doctor.py
new file mode 100644
index 0000000..9370217
--- /dev/null
+++ b/payhook/doctor.py
@@ -0,0 +1,69 @@
+"""`python -m payhook doctor`: print every setting and where its value came from.
+
+The output is meant to be pasted into support tickets, so secrets are never
+printed in full. Token and secret values are replaced by their length, and
+any password or username in a URL is hidden.
+"""
+
+import os
+from urllib.parse import urlsplit, urlunsplit
+
+from .config import DOTENV_PATH, load_config
+
+SECRET_KEYS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+SOURCE_LABELS = {"env": "environment", ".env": ".env", "default": "default"}
+
+
+def redact_url(url):
+    try:
+        parts = urlsplit(url)
+        if not parts.username and parts.password is None:
+            return url
+        host = parts.hostname or ""
+        if parts.port is not None:
+            host += f":{parts.port}"
+        return urlunsplit(parts._replace(netloc="***@" + host))
+    except ValueError:
+        return "<unparseable URL, redacted>"
+
+
+def display_value(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        return f"<redacted, {len(value)} chars>"
+    if key == "PAYHOOK_ENDPOINT":
+        return repr(redact_url(value))
+    # repr() shows surrounding spaces and quotes that a plain print would hide.
+    return repr(value)
+
+
+def doctor_report(config, dotenv_path=DOTENV_PATH):
+    """Return (text, missing) for a loaded config; missing lists unset required keys."""
+    abs_path = os.path.abspath(dotenv_path)
+    dotenv_state = "found" if os.path.exists(dotenv_path) else "not found"
+    lines = [
+        "payhook doctor",
+        f"dotenv: {abs_path} ({dotenv_state})",
+        "",
+    ]
+    rows = [("SETTING", "VALUE", "SOURCE")]
+    for key, (value, source) in config.items():
+        rows.append((key, display_value(key, value), SOURCE_LABELS.get(source, source)))
+    widths = [max(len(row[i]) for row in rows) for i in range(3)]
+    for row in rows:
+        lines.append("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip())
+
+    missing = [k for k, (v, _) in config.items() if v is None]
+    lines.append("")
+    lines.append("status: missing required settings: " + ", ".join(missing) if missing else "status: ok")
+    return "\n".join(lines) + "\n", missing
+
+
+def run_doctor(dotenv_path=DOTENV_PATH):
+    # Doctor is a report, not a gate: missing settings are listed in the
+    # output and the exit code stays 0 so the output can always be pasted.
+    text, _ = doctor_report(load_config(dotenv_path=dotenv_path), dotenv_path)
+    print(text, end="")
+    return 0
