+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _MaxJitterRng:
+    """Stand-in RNG that always picks the top of the jitter range."""
+
+    def uniform(self, lo, hi):
+        return hi
+
+
+class _MinJitterRng:
+    def uniform(self, lo, hi):
+        return lo
+
+
+class CapAfterJitterTest(unittest.TestCase):
+    # Deterministic regression tests for docs/RETRY.md step 3:
+    # no delay may exceed cap, even after jitter is applied.
+
+    def test_max_jitter_never_exceeds_cap(self):
+        # attempt 7 with base 0.5 is 32s; 32 * 1.1 = 35.2 used to exceed cap=34.
+        delay = compute_delay(7, base=0.5, cap=34, jitter=0.1, rng=_MaxJitterRng())
+        self.assertLessEqual(delay, 34)
+
+    def test_capped_attempt_at_max_jitter_equals_cap(self):
+        delay = compute_delay(10, base=0.5, cap=30, jitter=0.1, rng=_MaxJitterRng())
+        self.assertEqual(delay, 30)
+
+    def test_min_jitter_is_not_negative(self):
+        delay = compute_delay(1, base=0.5, cap=30, jitter=1.5, rng=_MinJitterRng())
+        self.assertGreaterEqual(delay, 0)
+
+    def test_schedule_respects_cap_across_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34, f"seed={seed}")
+                self.assertGreaterEqual(delay, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
