@@ -26,9 +28,31 @@ class CodecTest(unittest.TestCase):
         with self.assertRaises(ValueError):
             decode(b"nope")
 
-    def test_encoded_is_always_smaller(self):
+    def test_encoded_never_grows_by_more_than_overhead(self):
+        # "encode() always returns fewer bytes than it was given" is impossible
+        # for any lossless codec (see test_strictly_smaller_is_impossible), so
+        # the guarantee we actually make is a fixed one-byte worst-case overhead.
         for data in payloads():
-            self.assertLess(len(encode(data)), len(data), f"{len(data)} byte payload grew")
+            self.assertLessEqual(
+                len(encode(data)), len(data) + MAX_OVERHEAD, f"{len(data)} byte payload grew too much"
+            )
+
+    def test_strictly_smaller_is_impossible(self):
+        # The empty payload cannot encode to fewer than zero bytes, and by the
+        # pigeonhole principle every lossless codec must leave at least one
+        # input of every length at its original size or larger. Both facts
+        # hold for *any* implementation of encode, not just this one.
+        self.assertGreaterEqual(len(encode(b"")), 0)
+        n = 1
+        outputs = {encode(bytes([b])) for b in range(256)}
+        self.assertEqual(len(outputs), 256, "encode must be injective to round-trip")
+        shorter_than_n = {out for out in outputs if len(out) < n}
+        self.assertLess(len(shorter_than_n), 256, "only one byte string is shorter than 1 byte")
+
+    def test_decodes_legacy_bz1_blobs(self):
+        for data in payloads():
+            legacy = b"BZ1" + zlib.compress(data, 6)
+            self.assertEqual(decode(legacy), data)
 
 
