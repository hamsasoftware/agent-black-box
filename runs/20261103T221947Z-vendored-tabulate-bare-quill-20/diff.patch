@@ -0,0 +1,18 @@
+import unittest
+
+from stockreport.inventory import Item
+from stockreport.report import render
+
+
+class MarkdownEscapeTest(unittest.TestCase):
+    def test_pipe_in_name_is_escaped(self):
+        out = render([Item("X-1", "Bolt | nut", 2, 1.0)], "markdown")
+        self.assertIn("| Bolt \\| nut ", out)
+        # Every table row keeps the same four-column structure (5 pipes incl. the edges).
+        rows = [line for line in out.splitlines() if line.startswith("|")]
+        for line in rows:
+            self.assertEqual(line.replace("\\|", "").count("|"), 5, line)
+
+
+if __name__ == "__main__":
+    unittest.main()
