diff --git a/stockreport/report.py b/stockreport/report.py
index 4084f70..6b7ef3f 100644
--- a/stockreport/report.py
+++ b/stockreport/report.py
@@ -7,6 +7,14 @@ def _rows(items):
     return [[i.sku, i.name, i.qty, i.unit_price] for i in sorted(items, key=lambda i: i.sku)]
 
 
+def _md_rows(items):
+    # A literal "|" inside a cell would split the GitHub table column, so escape it.
+    return [
+        [c.replace("|", "\\|") if isinstance(c, str) else c for c in row]
+        for row in _rows(items)
+    ]
+
+
 def total_value(items):
     return sum(i.value for i in items)
 
@@ -15,4 +23,7 @@ def render(items, fmt="text"):
     if fmt == "text":
         table = tabulate(_rows(items), headers=HEADERS, style="plain", number_format=".2f")
         return f"{table}\n\nTotal stock value: {total_value(items):.2f}"
+    if fmt == "markdown":
+        table = tabulate(_md_rows(items), headers=HEADERS, style="pipe", number_format=".2f")
+        return f"{table}\n\n**Total stock value:** {total_value(items):.2f}"
     raise ValueError(f"unknown format {fmt!r}")
