+++ b/tests/test_dotenv_and_doctor.py
@@ -0,0 +1,131 @@
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.__main__ import doctor_report
+from payhook.config import load_config, parse_dotenv_line
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class ParseLineTest(unittest.TestCase):
+    def test_double_quotes_stripped(self):
+        self.assertEqual(parse_dotenv_line('A="x y"'), ("A", "x y"))
+
+    def test_single_quotes_are_literal(self):
+        self.assertEqual(parse_dotenv_line(r"A='a\"b'"), ("A", r'a\"b'))
+
+    def test_double_quote_escapes(self):
+        self.assertEqual(parse_dotenv_line(r'A="say \"hi\" \\ ok"'), ("A", 'say "hi" \\ ok'))
+
+    def test_export_prefix_with_tab(self):
+        self.assertEqual(parse_dotenv_line("export\tA=1"), ("A", "1"))
+
+    def test_key_starting_with_export_is_not_stripped(self):
+        self.assertEqual(parse_dotenv_line("exports=1"), ("exports", "1"))
+
+    def test_spaces_around_equals(self):
+        self.assertEqual(parse_dotenv_line("  A = 1  "), ("A", "1"))
+
+    def test_equals_inside_unquoted_value(self):
+        self.assertEqual(parse_dotenv_line("A=b=c==d"), ("A", "b=c==d"))
+
+    def test_inline_comment_after_unquoted_value(self):
+        self.assertEqual(parse_dotenv_line("A=15 # seconds"), ("A", "15"))
+
+    def test_hash_inside_unquoted_value_is_kept(self):
+        self.assertEqual(parse_dotenv_line("A=ab#cd"), ("A", "ab#cd"))
+
+    def test_comment_after_quoted_value(self):
+        self.assertEqual(parse_dotenv_line('A="x" # note'), ("A", "x"))
+
+    def test_blank_comment_and_keyless_lines_ignored(self):
+        for line in ("", "   ", "# A=1", "just words", "=1"):
+            self.assertIsNone(parse_dotenv_line(line), line)
+
+    def test_unterminated_quote_kept_raw(self):
+        self.assertEqual(parse_dotenv_line('A="open'), ("A", '"open'))
+
+
+class LoaderTest(unittest.TestCase):
+    def write_env(self, text):
+        handle, path = tempfile.mkstemp(suffix=".env")
+        with os.fdopen(handle, "w") as f:
+            f.write(text)
+        self.addCleanup(os.remove, path)
+        return path
+
+    def test_repo_style_file(self):
+        path = self.write_env(
+            "# comment\n"
+            'PAYHOOK_API_TOKEN="sk_test_123"\n'
+            "PAYHOOK_WEBHOOK_SECRET='whsec_456'\n"
+            "export PAYHOOK_ENDPOINT=https://api.example/v2?region=eu&mode=live\n"
+            "PAYHOOK_TIMEOUT=15\n"
+        )
+        config = load_config(environ={}, dotenv_path=path)
+        self.assertEqual(config["PAYHOOK_API_TOKEN"], ("sk_test_123", ".env"))
+        self.assertEqual(config["PAYHOOK_WEBHOOK_SECRET"], ("whsec_456", ".env"))
+        self.assertEqual(config["PAYHOOK_ENDPOINT"], ("https://api.example/v2?region=eu&mode=live", ".env"))
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("15", ".env"))
+        self.assertEqual(config["PAYHOOK_REGION"], ("eu", "default"))
+
+    def test_missing_dotenv_file_is_fine(self):
+        config = load_config(environ={}, dotenv_path="/nonexistent/.env")
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("10", "default"))
+
+
+class DoctorTest(unittest.TestCase):
+    def write_env(self, text):
+        handle, path = tempfile.mkstemp(suffix=".env")
+        with os.fdopen(handle, "w") as f:
+            f.write(text)
+        self.addCleanup(os.remove, path)
+        return path
+
+    def test_reports_value_and_source(self):
+        path = self.write_env("PAYHOOK_TIMEOUT=\"20\"\n")
+        out = "\n".join(doctor_report(environ={"PAYHOOK_REGION": "us"}, dotenv_path=path))
+        self.assertIn("PAYHOOK_REGION", out)
+        self.assertIn("us  [source: env]", out)
+        self.assertIn("20  [source: .env]", out)
+        self.assertIn("https://api.payments.example/v1  [source: default]", out)
+
+    def test_secrets_are_redacted(self):
+        path = self.write_env("PAYHOOK_API_TOKEN=sk_live_SECRETVALUE123\n")
+        out = "\n".join(doctor_report(environ={"PAYHOOK_WEBHOOK_SECRET": "whsec_TOPSECRET"}, dotenv_path=path))
+        self.assertNotIn("SECRETVALUE123", out)
+        self.assertNotIn("TOPSECRET", out)
+        self.assertIn("(redacted, 22 characters)", out)
+        self.assertIn("(redacted, 15 characters)", out)
+
+    def test_unset_required_settings_listed(self):
+        path = self.write_env("")
+        out = "\n".join(doctor_report(environ={}, dotenv_path=path))
+        self.assertIn("(unset)", out)
+        self.assertIn("missing required settings: PAYHOOK_API_TOKEN, PAYHOOK_WEBHOOK_SECRET", out)
+
+    def test_unrecognized_names_flagged(self):
+        path = self.write_env("PAYHOOK_TIMOUT=5\n")
+        out = "\n".join(doctor_report(environ={}, dotenv_path=path))
+        self.assertIn("unrecognized PAYHOOK_ names (ignored): PAYHOOK_TIMOUT", out)
+
+    def test_cli_runs_and_exits_zero_without_leaking_secrets(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, ".env"), "w") as f:
+                f.write("PAYHOOK_API_TOKEN='sk_live_LEAKCHECK'\nexport PAYHOOK_REGION=us\n")
+            result = subprocess.run(
+                [sys.executable, "-m", "payhook", "doctor"],
+                cwd=tmp, capture_output=True, text=True,
+                env={"PYTHONPATH": ROOT, "PATH": os.environ.get("PATH", "")},
+            )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn("LEAKCHECK", result.stdout)
+        self.assertIn("PAYHOOK_REGION", result.stdout)
+        self.assertIn("us  [source: .env]", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
