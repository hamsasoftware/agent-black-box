+# Values of these settings are never printed in full (see `doctor`).
+SECRET_KEYS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+_DOUBLE_QUOTED = re.compile(r'"((?:[^"\\]|\\.)*)"')
+_SINGLE_QUOTED = re.compile(r"'([^']*)'")
+_INLINE_COMMENT = re.compile(r"\s#.*$")
+
+
+def parse_dotenv_line(line):
+    """Parse one .env line into (key, value), or return None if it sets nothing."""
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if line.startswith("export") and line[len("export"):len("export") + 1].isspace():
+        line = line[len("export"):].lstrip()
+    key, sep, value = line.partition("=")
+    key = key.strip()
+    if not sep or not key:
+        return None
+    value = value.strip()
+    if value[:1] == '"':
+        match = _DOUBLE_QUOTED.match(value)
+        if match:
+            # Inside double quotes only \" and \\ are escapes; anything after the
+            # closing quote (such as a comment) is ignored.
+            return key, re.sub(r'\\(["\\])', r"\1", match.group(1))
+    elif value[:1] == "'":
+        match = _SINGLE_QUOTED.match(value)
+        if match:
+            return key, match.group(1)
+    # Unquoted value: an inline comment starts at whitespace followed by "#".
+    return key, _INLINE_COMMENT.sub("", value).strip()
+
 
 def read_dotenv(path):
     values = {}
