+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _Fixed:
+    """Stand-in rng whose uniform() always returns the same point in the range."""
+
+    def __init__(self, position):
+        # position 0.0 -> lower bound of the range, 1.0 -> upper bound
+        self.position = position
+
+    def uniform(self, low, high):
+        return low + (high - low) * self.position
+
+
+class CapAfterJitterTest(unittest.TestCase):
+    def test_upper_jitter_at_cap_is_clamped_to_cap(self):
+        # attempt 7 with base 0.5: 0.5 * 2**6 = 32, upper jitter gives 35.2 > cap 34
+        delay = compute_delay(7, base=0.5, cap=34, jitter=0.1, rng=_Fixed(1.0))
+        self.assertEqual(delay, 34)
+
+    def test_upper_jitter_below_cap_is_not_clamped(self):
+        # attempt 2 with base 0.5: 1.0 * 1.1 = 1.1, well below cap 34
+        delay = compute_delay(2, base=0.5, cap=34, jitter=0.1, rng=_Fixed(1.0))
+        self.assertAlmostEqual(delay, 1.1)
+
+    def test_lower_jitter_is_applied(self):
+        delay = compute_delay(2, base=0.5, cap=34, jitter=0.1, rng=_Fixed(0.0))
+        self.assertAlmostEqual(delay, 0.9)
+
+    def test_no_schedule_exceeds_cap_for_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34)
+                self.assertGreaterEqual(delay, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
