+"""Tests for the retention rules as decided in docs/adr/ (ADR-0001, ADR-0003, ADR-0004)."""
+
+import unittest
+from datetime import datetime, timezone
+
+from vaultsnap import Plan, Policy, Snapshot, plan_retention
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def at(stamp, tags=()):
+    """A snapshot whose id is the stamp with punctuation removed, taken at `stamp` UTC."""
+    sid = "s-" + stamp.replace("-", "").replace(":", "").replace("T", "")
+    return Snapshot(sid, datetime.fromisoformat(stamp + "+00:00"), frozenset(tags))
+
+
+def sid(stamp):
+    return "s-" + stamp.replace("-", "").replace(":", "").replace("T", "")
+
+
+class SetAsideTest(unittest.TestCase):
+    def test_future_snapshot_is_kept_and_does_not_count_toward_keep_last(self):
+        shots = [at("2026-03-21T00:00"), at("2026-03-19T03:00"), at("2026-03-18T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-21T00:00"), sid("2026-03-19T03:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-18T03:00")])
+
+    def test_snapshot_taken_exactly_at_now_is_not_set_aside(self):
+        shots = [at("2026-03-20T12:00"), at("2026-03-19T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-20T12:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-19T03:00")])
+
+    def test_protected_snapshot_does_not_count_toward_keep_last(self):
+        shots = [at("2026-03-19T03:00", ["release"]), at("2026-03-18T03:00"), at("2026-03-17T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-19T03:00"), sid("2026-03-18T03:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-17T03:00")])
+
+    def test_protected_snapshot_is_never_the_bucket_representative(self):
+        # The protected snapshot is newest on 19 March, but the untagged one must still represent that day.
+        shots = [at("2026-03-19T05:00", ["release"]), at("2026-03-19T01:00")]
+        plan = plan_retention(shots, Policy(keep_daily=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-19T05:00"), sid("2026-03-19T01:00")])
+        self.assertEqual(plan.prune, [])
+
+    def test_empty_policy_keeps_future_and_protected_too(self):
+        shots = [at("2026-03-21T00:00"), at("2026-03-19T03:00")]
+        plan = plan_retention(shots, Policy(), NOW)
+        self.assertEqual(plan.prune, [])
+        self.assertEqual(plan.keep, [sid("2026-03-21T00:00"), sid("2026-03-19T03:00")])
+
+
+class OrderingAndInputTest(unittest.TestCase):
+    def test_same_taken_at_breaks_ties_by_greater_id(self):
+        t = datetime.fromisoformat("2026-03-18T03:00:00+00:00")
+        plan = plan_retention([Snapshot("a", t), Snapshot("b", t)], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_duplicate_ids_are_rejected(self):
+        t = datetime.fromisoformat("2026-03-18T03:00:00+00:00")
+        with self.assertRaises(ValueError):
+            plan_retention([Snapshot("a", t), Snapshot("a", t)], Policy(keep_last=1), NOW)
+
+    def test_naive_now_is_rejected(self):
+        with self.assertRaises(ValueError):
+            plan_retention([at("2026-03-18T03:00")], Policy(keep_last=1), datetime(2026, 3, 20, 12, 0))
+
+    def test_every_id_appears_exactly_once(self):
+        shots = [at("2026-03-%02dT03:00" % d) for d in range(1, 15)]
+        plan = plan_retention(shots, Policy(keep_last=3, keep_daily=4, keep_weekly=1), NOW)
+        self.assertEqual(sorted(plan.keep + plan.prune), sorted(s.id for s in shots))
+        self.assertEqual(len(set(plan.keep) & set(plan.prune)), 0)
+
+
+class RuleTest(unittest.TestCase):
+    def test_empty_buckets_do_not_use_up_n(self):
+        # Days 3-9 have no snapshots, so the three newest buckets are 11, 10 and 2.
+        shots = [at("2026-03-01T03:00"), at("2026-03-02T03:00"), at("2026-03-10T03:00"), at("2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(keep_daily=3), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-11T03:00"), sid("2026-03-10T03:00"), sid("2026-03-02T03:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-01T03:00")])
+
+    def test_iso_weeks_put_new_year_days_in_week_1_of_next_year(self):
+        # ISO: 27 and 28 Dec 2025 are week (2025, 52); 29 and 30 Dec 2025 are week (2026, 1).
+        # Sunday-start weeks would put 28-30 Dec in one week, so keep_weekly=2 would keep 27 Dec instead of 28 Dec.
+        shots = [at("2025-12-27T03:00"), at("2025-12-28T03:00"), at("2025-12-29T03:00"), at("2025-12-30T03:00")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.keep, [sid("2025-12-30T03:00"), sid("2025-12-28T03:00")])
+        self.assertEqual(plan.prune, [sid("2025-12-29T03:00"), sid("2025-12-27T03:00")])
+
+    def test_monthly_uses_calendar_month_not_iso_year(self):
+        # 30 Dec 2025 is in month (2025, 12), not (2026, 12), so 1 Jan 2026 is the newer month.
+        shots = [at("2025-12-01T03:00"), at("2025-12-30T03:00"), at("2026-01-02T03:00")]
+        plan = plan_retention(shots, Policy(keep_monthly=3), NOW)
+        self.assertEqual(plan.keep, [sid("2026-01-02T03:00"), sid("2025-12-30T03:00")])
+        self.assertEqual(plan.prune, [sid("2025-12-01T03:00")])
+
+    def test_yearly_uses_calendar_year(self):
+        shots = [at("2025-12-01T03:00"), at("2025-12-30T03:00"), at("2026-01-02T03:00")]
+        plan = plan_retention(shots, Policy(keep_yearly=2), NOW)
+        self.assertEqual(plan.keep, [sid("2026-01-02T03:00"), sid("2025-12-30T03:00")])
+        self.assertEqual(plan.prune, [sid("2025-12-01T03:00")])
+
+    def test_rules_are_independent_and_their_keeps_are_unioned(self):
+        shots = [at("2024-05-01T03:00"), at("2025-03-01T03:00"), at("2025-08-01T03:00"), at("2026-01-15T03:00")]
+        plan = plan_retention(shots, Policy(keep_monthly=1, keep_yearly=2), NOW)
+        self.assertEqual(plan.keep, [sid("2026-01-15T03:00"), sid("2025-08-01T03:00")])
+        self.assertEqual(plan.prune, [sid("2025-03-01T03:00"), sid("2024-05-01T03:00")])
+
+
+class DayBoundaryTest(unittest.TestCase):
+    def test_day_start_hour_moves_early_morning_into_previous_day(self):
+        # With day_start_hour=4, 01:00-03:59 on 1 Jan belongs to 31 Dec.
+        a = at("2025-12-31T23:00")
+        b = at("2026-01-01T03:30")
+        c = at("2026-01-01T05:00")
+        plan = plan_retention([a, b, c], Policy(keep_daily=2, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, [c.id, b.id])
+        self.assertEqual(plan.prune, [a.id])
+
+    def test_tz_offset_moves_snapshots_into_local_days(self):
+        # UTC+10. X is 20 Mar 01:00 local, Y is 20 Mar 06:00 local, Z is 19 Mar 02:00 local.
+        x = at("2026-03-19T15:00")
+        y = at("2026-03-19T20:00")
+        z = at("2026-03-18T16:00")
+        plan = plan_retention([x, y, z], Policy(keep_daily=2, tz_offset_minutes=600), NOW)
+        self.assertEqual(plan.keep, [y.id, z.id])
+        self.assertEqual(plan.prune, [x.id])
+
+    def test_day_boundary_does_not_shift_keep_last_order(self):
+        # Ordering uses the real instant, so the newest snapshot is still Y, even though day keys shift.
+        x = at("2026-03-19T15:00")
+        y = at("2026-03-19T20:00")
+        plan = plan_retention([x, y], Policy(keep_last=1, tz_offset_minutes=600, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, [y.id])
+
+
+if __name__ == "__main__":
+    unittest.main()
