 from dataclasses import dataclass
+from datetime import timedelta, timezone
 
 
 @dataclass(frozen=True)
@@ -12,9 +13,85 @@ class Plan:
     prune: list
 
 
+def _is_aware(dt):
+    return dt.tzinfo is not None and dt.utcoffset() is not None
+
+
+def _bucket_date(taken_at, policy):
+    """The calendar date a snapshot belongs to (ADR-0004): shift to the fixed offset, then back by day_start_hour."""
+    local = taken_at.astimezone(timezone(timedelta(minutes=policy.tz_offset_minutes)))
+    return (local - timedelta(hours=policy.day_start_hour)).date()
+
+
+def _keep_newest_buckets(remaining, count, key_of, kept):
+    """Add to `kept` the newest snapshot of each of the `count` newest buckets (ADR-0001).
+
+    `remaining` is ordered newest first, so the first snapshot seen for a bucket is its newest.
+    """
+    newest_in_bucket = {}
+    for snap in remaining:
+        newest_in_bucket.setdefault(key_of(snap), snap.id)
+    for key in sorted(newest_in_bucket, reverse=True)[:count]:
+        kept.add(newest_in_bucket[key])
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+    Rules are defined in docs/adr/0001-retention-model.md, with ADR-0003 (ISO weeks) and
+    ADR-0004 (day boundaries) applied.
     """
-    raise NotImplementedError
+    if not _is_aware(now):
+        raise ValueError("now must be a timezone-aware datetime")
+
+    snaps = list(snapshots)
+    seen_ids = set()
+    for snap in snaps:
+        if snap.id in seen_ids:
+            raise ValueError(f"duplicate snapshot id {snap.id!r}")
+        seen_ids.add(snap.id)
+        if not _is_aware(snap.taken_at):
+            raise ValueError(f"taken_at of snapshot {snap.id!r} must be timezone-aware")
+
+    # Newer means a later taken_at; equal times are broken by the greater id.
+    ordered = sorted(snaps, key=lambda s: (s.taken_at, s.id), reverse=True)
+
+    if not policy.has_rules:
+        return Plan(keep=[s.id for s in ordered], prune=[])
+
+    # Set aside: protected-tag snapshots and snapshots from the future. Always kept, never counted.
+    kept = {
+        s.id
+        for s in ordered
+        if s.taken_at > now or (s.tags & policy.protect_tags)
+    }
+    remaining = [s for s in ordered if s.id not in kept]
+
+    if policy.keep_last:
+        kept.update(s.id for s in remaining[: policy.keep_last])
+
+    if policy.keep_daily:
+        _keep_newest_buckets(remaining, policy.keep_daily, lambda s: _bucket_date(s.taken_at, policy), kept)
+
+    if policy.keep_weekly:
+        def week_key(s):
+            iso = _bucket_date(s.taken_at, policy).isocalendar()
+            return (iso[0], iso[1])
+
+        _keep_newest_buckets(remaining, policy.keep_weekly, week_key, kept)
+
+    if policy.keep_monthly:
+        def month_key(s):
+            day = _bucket_date(s.taken_at, policy)
+            return (day.year, day.month)
+
+        _keep_newest_buckets(remaining, policy.keep_monthly, month_key, kept)
+
+    if policy.keep_yearly:
+        _keep_newest_buckets(remaining, policy.keep_yearly, lambda s: _bucket_date(s.taken_at, policy).year, kept)
+
+    return Plan(
+        keep=[s.id for s in ordered if s.id in kept],
+        prune=[s.id for s in ordered if s.id not in kept],
+    )
