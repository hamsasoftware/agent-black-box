@@ -0,0 +1,21 @@
+import unittest
+
+from relnotes import render_release
+
+
+class EdgeCaseTest(unittest.TestCase):
+    def test_multiline_comment_containing_heading(self):
+        text = "## [1.0.0] - 2024-01-01\n\na\n<!--\n## [bogus]\n-->\nb\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\na\n\nb\n")
+
+    def test_comment_at_line_end_drops_trailing_space(self):
+        text = "## [1.0.0] - 2024-01-01\n- x <!-- c -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- x\n")
+
+    def test_blank_runs_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n\na\n\n\n\nb\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\na\n\nb\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
