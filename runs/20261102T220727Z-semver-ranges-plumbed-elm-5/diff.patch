+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = rf"(?:x|X|\*|{_NUM})"
+_PARTIAL = re.compile(
+    rf"^v?({_PART})(?:\.({_PART})(?:\.({_PART})"
+    r"(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?)?)?$"
+)
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+_HYPHEN = re.compile(r"^(\S+)\s+-\s+(\S+)$")
+_TOKEN = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$")
+
+# A comparator set is a list of (op, Version) pairs, or None if unsatisfiable.
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, prerelease_text); wildcards/missing -> None."""
+    match = _PARTIAL.match(text)
+    if not match:
+        raise ValueError(f"invalid range component: {text!r}")
+    parts = [None if p in (None, "x", "X", "*") else int(p) for p in match.groups()[:3]]
+    pre = match.group(4)
+    # A wildcard may not be followed by a number (1.x.3, x.2).
+    for earlier, later in zip(parts, parts[1:]):
+        if earlier is None and later is not None:
+            raise ValueError(f"invalid range component: {text!r}")
+    if pre is not None:
+        if parts[2] is None:
+            raise ValueError(f"invalid range component: {text!r}")
+        # Validate prerelease syntax through Version itself.
+        Version.parse(f"{parts[0]}.{parts[1]}.{parts[2]}-{pre}")
+    return parts[0], parts[1], parts[2], pre
+
+
+def _full(major, minor, patch, pre=None):
+    return Version.parse(f"{major}.{minor}.{patch}" + (f"-{pre}" if pre else ""))
+
+
+def _lower(major, minor, patch, pre):
+    """>= bound with missing positions zero-filled."""
+    return (">=", _full(major, minor or 0, patch or 0, pre))
+
+
+def _below_next(major, minor, patch):
+    """< bound for the next higher partial (1 -> <2.0.0, 1.2 -> <1.3.0)."""
+    if minor is None:
+        return ("<", Version(major + 1, 0, 0))
+    return ("<", Version(major, minor + 1, 0))
+
+
+def _primitive(op, text):
+    major, minor, patch, pre = _parse_partial(text)
+    if op in ("", "="):
+        if major is None:
+            return []
+        if patch is None:
+            return [_lower(major, minor, patch, pre), _below_next(major, minor, patch)]
+        return [("=", _full(major, minor, patch, pre))]
+    if op == ">=":
+        return [] if major is None else [_lower(major, minor, patch, pre)]
+    if op == "<=":
+        if major is None:
+            return []
+        if patch is None:
+            return [_below_next(major, minor, patch)]
+        return [("<=", _full(major, minor, patch, pre))]
+    if op == ">":
+        if major is None:
+            return None  # nothing is greater than "any"
+        if patch is None:
+            lo = _below_next(major, minor, patch)[1]
+            return [(">=", lo)]
+        return [(">", _full(major, minor, patch, pre))]
+    if op == "<":
+        if major is None:
+            return None
+        return [("<", _full(major, minor or 0, patch or 0, pre))]
+    raise ValueError(f"invalid operator: {op!r}")
+
+
+def _tilde(text):
+    major, minor, patch, pre = _parse_partial(text)
+    if major is None:
+        return []
+    return [_lower(major, minor, patch, pre), _below_next(major, minor, patch)]
+
+
+def _caret(text):
+    major, minor, patch, pre = _parse_partial(text)
+    if major is None:
+        return []
+    lower = _lower(major, minor, patch, pre)
+    if major > 0 or minor is None:
+        upper = ("<", Version(major + 1, 0, 0))
+    elif minor > 0 or patch is None:
+        upper = ("<", Version(0, minor + 1, 0))
+    else:
+        upper = ("<", Version(0, 0, patch + 1))
+    return [lower, upper]
+
+
+def _hyphen(a_text, b_text):
+    a = _parse_partial(a_text)
+    b = _parse_partial(b_text)
+    comps = []
+    if a[0] is not None:
+        comps.append(_lower(*a))
+    if b[0] is not None:
+        if b[2] is None:
+            comps.append(_below_next(b[0], b[1], b[2]))
+        else:
+            comps.append(("<=", _full(*b)))
+    return comps
+
+
+def _parse_set(text):
+    text = text.strip()
+    match = _HYPHEN.match(_OP_SPACE.sub(r"\1", text)) if " - " in text or "\t-" in text else None
+    if match:
+        return _hyphen(match.group(1), match.group(2))
+    comps = []
+    for token in _OP_SPACE.sub(r"\1", text).split():
+        op, rest = _TOKEN.match(token).groups()
+        op = op or ""
+        if op == "~":
+            part = _tilde(rest)
+        elif op == "^":
+            part = _caret(rest)
+        else:
+            part = _primitive(op, rest)
+        if part is None:
+            return None
+        comps.extend(part)
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(s) for s in range_.split("||")]
+
+
+def _compare(op, version, bound):
+    if op == "=":
+        return version == bound
+    if op == "<":
+        return version < bound
+    if op == "<=":
+        return version <= bound
+    if op == ">":
+        return version > bound
+    return version >= bound
+
+
+def _set_matches(comps, version):
+    if comps is None:
+        return False
+    if not all(_compare(op, version, bound) for op, bound in comps):
+        return False
+    if version.prerelease and comps:
+        return any(
+            bound.prerelease and bound.release == version.release for _, bound in comps
+        )
+    return True
+
+
+def _to_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    parsed = _to_version(version)
+    return any(_set_matches(s, parsed) for s in sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for original in versions:
+        parsed = _to_version(original)
+        if any(_set_matches(s, parsed) for s in sets):
+            if best_version is None or parsed > best_version:
+                best, best_version = original, parsed
+    return best
