@@ -0,0 +1,119 @@
+import unittest
+from datetime import datetime
+
+from vaultsnap import Policy, Snapshot, plan_retention
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def snap(sid, stamp, *tags):
+    return Snapshot(sid, datetime.fromisoformat(stamp), frozenset(tags))
+
+
+class AdrRulesTest(unittest.TestCase):
+    # ADR-0003: weekly buckets are ISO weeks (Monday start).
+    def test_weekly_uses_iso_weeks_not_sunday_weeks(self):
+        # 2025-12-27 (Sat) and 2025-12-28 (Sun) share ISO week 2025-W52 (Mon 22 Dec to Sun 28 Dec).
+        shots = [snap("a", "2025-12-20T03:00:00+00:00"), snap("b", "2025-12-27T03:00:00+00:00"), snap("c", "2025-12-28T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.keep, ["c", "a"])
+        self.assertEqual(plan.prune, ["b"])
+
+    # ADR-0004: day_start_hour shifts the bucket time back before the date is taken.
+    def test_day_start_hour_moves_early_morning_into_previous_day(self):
+        shots = [
+            snap("p", "2025-12-30T12:00:00+00:00"),
+            snap("q", "2025-12-31T23:00:00+00:00"),
+            snap("r", "2026-01-01T03:30:00+00:00"),
+        ]
+        plan = plan_retention(shots, Policy(keep_daily=2, day_start_hour=4), NOW)
+        # r (03:30 on 1 Jan) belongs to 31 Dec, so q and r share one bucket and r is its newest.
+        self.assertEqual(plan.keep, ["r", "p"])
+        self.assertEqual(plan.prune, ["q"])
+
+    # ADR-0004: tz_offset_minutes is a fixed offset applied before the date is taken.
+    def test_tz_offset_decides_the_local_date(self):
+        shots = [
+            snap("m", "2026-03-09T12:00:00+00:00"),  # 09 Mar 21:00 at +09:00
+            snap("n", "2026-03-10T20:00:00+00:00"),  # 11 Mar 05:00 at +09:00
+            snap("o", "2026-03-11T02:00:00+00:00"),  # 11 Mar 11:00 at +09:00
+        ]
+        plan = plan_retention(shots, Policy(keep_daily=2, tz_offset_minutes=540), NOW)
+        self.assertEqual(plan.keep, ["o", "m"])
+        self.assertEqual(plan.prune, ["n"])
+
+    # ADR-0001: a rule's N counts buckets that contain snapshots; empty periods use up nothing.
+    def test_empty_months_do_not_use_up_n(self):
+        shots = [snap("x", "2026-03-05T03:00:00+00:00"), snap("y", "2025-11-20T03:00:00+00:00"), snap("z", "2025-10-03T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_monthly=2), NOW)
+        self.assertEqual(plan.keep, ["x", "y"])
+        self.assertEqual(plan.prune, ["z"])
+
+    # ADR-0001: the five rules are independent; a snapshot kept by any rule is kept.
+    def test_rules_are_combined_as_a_union(self):
+        shots = [snap("y1", "2024-06-01T03:00:00+00:00"), snap("y2", "2025-06-01T03:00:00+00:00"), snap("y3", "2026-03-19T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, keep_yearly=2), NOW)
+        self.assertEqual(plan.keep, ["y3", "y2"])
+        self.assertEqual(plan.prune, ["y1"])
+
+    # ADR-0001: a value of 0 switches a rule off; with every rule off nothing is pruned.
+    def test_zero_switches_a_rule_off(self):
+        shots = [snap("a", "2026-03-10T03:00:00+00:00"), snap("b", "2026-03-11T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=0, keep_daily=0, keep_weekly=None), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        self.assertEqual(plan.prune, [])
+
+
+class AdrSetAsideTest(unittest.TestCase):
+    # ADR-0001: a snapshot later than now is kept and does not count toward any N.
+    def test_future_snapshot_is_kept_and_not_counted(self):
+        shots = [snap("f1", "2026-03-19T03:00:00+00:00"), snap("f2", "2026-03-20T03:00:00+00:00"), snap("f3", "2026-03-21T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["f3", "f2"])
+        self.assertEqual(plan.prune, ["f1"])
+
+    # ADR-0001: a snapshot taken exactly at now is not set aside.
+    def test_snapshot_exactly_at_now_is_not_set_aside(self):
+        shots = [snap("e1", "2026-03-20T12:00:00+00:00"), snap("e2", "2026-03-20T11:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["e1"])
+        self.assertEqual(plan.prune, ["e2"])
+
+    # ADR-0001: a protected snapshot can never be the representative of a bucket.
+    def test_protected_snapshot_does_not_use_up_a_bucket(self):
+        shots = [snap("p1", "2026-03-17T13:00:00+00:00", "release"), snap("p2", "2026-03-17T01:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_daily=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan.keep, ["p1", "p2"])
+        self.assertEqual(plan.prune, [])
+
+
+class AdrOrderingAndValidationTest(unittest.TestCase):
+    # ADR-0001: equal taken_at, the greater id is the newer.
+    def test_tie_on_taken_at_breaks_by_greater_id(self):
+        shots = [snap("s-a", "2026-03-19T03:00:00+00:00"), snap("s-b", "2026-03-19T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["s-b"])
+        self.assertEqual(plan.prune, ["s-a"])
+
+    # ADR-0001: duplicate ids raise ValueError.
+    def test_duplicate_ids_are_rejected(self):
+        shots = [snap("dup", "2026-03-18T03:00:00+00:00"), snap("dup", "2026-03-19T03:00:00+00:00")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(keep_last=1), NOW)
+
+    # ADR-0001: every datetime, including now, must be timezone-aware.
+    def test_naive_now_is_rejected(self):
+        shots = [snap("a", "2026-03-18T03:00:00+00:00")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(keep_last=1), datetime(2026, 3, 20, 12, 0))
+
+    # ADR-0001: output lists hold every id once, newest first.
+    def test_output_is_newest_first_and_complete(self):
+        shots = [snap("a", "2026-03-10T03:00:00+00:00"), snap("b", "2026-03-12T03:00:00+00:00"), snap("c", "2026-03-11T03:00:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=2), NOW)
+        self.assertEqual(plan.keep, ["b", "c"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/vaultsnap/retention.py b/vaultsnap/retention.py
index 5ad59e7..b40e58d 100644
--- a/vaultsnap/retention.py
+++ b/vaultsnap/retention.py
@@ -1,4 +1,5 @@
 from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
 
 
 @dataclass(frozen=True)
@@ -12,9 +13,75 @@ class Plan:
     prune: list
 
 
+def _require_aware(value, what):
+    if value.utcoffset() is None:
+        raise ValueError(f"{what} must be timezone-aware, got {value!r}")
+
+
+def _bucket_date(taken_at, policy):
+    """Local calendar date of a snapshot's bucket time (ADR-0004): shift to the fixed offset, then back by day_start_hour."""
+    offset = timezone(timedelta(minutes=policy.tz_offset_minutes))
+    return (taken_at.astimezone(offset) - timedelta(hours=policy.day_start_hour)).date()
+
+
+def _bucket_key(rule, day):
+    if rule == "keep_daily":
+        return day
+    if rule == "keep_weekly":
+        iso_year, iso_week, _ = day.isocalendar()  # ADR-0003: ISO weeks, Monday start
+        return (iso_year, iso_week)
+    if rule == "keep_monthly":
+        return (day.year, day.month)
+    return day.year  # keep_yearly
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+    The rules are those of docs/adr/0001 (with 0003 and 0004 applied).
     """
-    raise NotImplementedError
+    if not isinstance(now, datetime):
+        raise TypeError(f"now must be a datetime, got {now!r}")
+    _require_aware(now, "now")
+
+    snaps = list(snapshots)
+    seen = set()
+    for snap in snaps:
+        _require_aware(snap.taken_at, f"taken_at of snapshot {snap.id!r}")
+        if snap.id in seen:
+            raise ValueError(f"duplicate snapshot id {snap.id!r}")
+        seen.add(snap.id)
+
+    # "Newer": later taken_at; ties broken by the greater id. Sorted newest first.
+    snaps.sort(key=lambda s: (s.taken_at, s.id), reverse=True)
+
+    if not policy.has_rules:  # ADR-0001: an empty policy never prunes
+        return Plan(keep=[s.id for s in snaps], prune=[])
+
+    keep_ids = set()
+    remaining = []  # set-aside snapshots are never candidates for any rule or bucket
+    for snap in snaps:
+        if snap.taken_at > now or not snap.tags.isdisjoint(policy.protect_tags):
+            keep_ids.add(snap.id)
+        else:
+            remaining.append(snap)
+
+    if policy.keep_last:
+        keep_ids.update(s.id for s in remaining[: policy.keep_last])
+
+    for rule in ("keep_daily", "keep_weekly", "keep_monthly", "keep_yearly"):
+        n = getattr(policy, rule)
+        if not n:
+            continue
+        newest_in_bucket = {}  # remaining is newest first, so the first snapshot seen per bucket is its newest
+        for snap in remaining:
+            key = _bucket_key(rule, _bucket_date(snap.taken_at, policy))
+            newest_in_bucket.setdefault(key, snap.id)
+        for key in sorted(newest_in_bucket, reverse=True)[:n]:
+            keep_ids.add(newest_in_bucket[key])
+
+    return Plan(
+        keep=[s.id for s in snaps if s.id in keep_ids],
+        prune=[s.id for s in snaps if s.id not in keep_ids],
+    )
