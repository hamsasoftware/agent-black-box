@@ -0,0 +1,36 @@
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class MaxRng:
+    """Worst case: always draws the top of the jitter range."""
+    def uniform(self, a, b):
+        return b
+
+
+class MinRng:
+    def uniform(self, a, b):
+        return a
+
+
+class CapTest(unittest.TestCase):
+    def test_cap_never_exceeded_with_worst_case_jitter(self):
+        for attempt in range(1, 20):
+            self.assertLessEqual(compute_delay(attempt, base=0.5, cap=34, rng=MaxRng()), 34)
+
+    def test_schedule_cap_deterministic(self):
+        r = Retrier(base=0.5, cap=34, max_attempts=7, rng=MaxRng())
+        self.assertTrue(all(d <= 34 for d in r.schedule()))
+        self.assertEqual(r.schedule()[-1], 34)
+
+    def test_jitter_still_applied_below_cap(self):
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, jitter=0.1, rng=MaxRng()), 1.1)
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, jitter=0.1, rng=MinRng()), 0.9)
+
+    def test_never_negative(self):
+        self.assertGreaterEqual(compute_delay(1, base=1, jitter=2, rng=MinRng()), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
