@@ -0,0 +1,97 @@
+import json
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from shipcalc import calc, export, limits, reports, storage, units, validate
+from shipcalc.format import format_weight
+from shipcalc.models import Item, Order
+from shipcalc.units import WeightError
+
+
+class UnitsTest(unittest.TestCase):
+    def test_rounding_is_half_to_even(self):
+        self.assertEqual(units.normalize_kg("1.0005"), "1.000")
+        self.assertEqual(units.normalize_kg("1.0015"), "1.002")
+        self.assertEqual(units.normalize_kg("2.0025"), "2.002")
+
+    def test_invalid_input(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", 1, 1.5, True, None, Decimal("1")]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError) as ctx:
+                units.normalize_kg(bad)
