@@ -1,8 +1,38 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are canonical kilogram strings ("0.250", "12.000").
 
+Arithmetic is done on integer grams, which is exact for three decimal places.
+"""
+import re
+from decimal import ROUND_HALF_EVEN, Decimal, localcontext
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+_KG = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+
+
+class WeightError(ValueError):
+    """Invalid weight input, or a total over the carrier limit."""
+
+
+def _invalid(value):
+    return WeightError(f"invalid weight: {value!r}")
+
+
+def normalize_kg(value):
+    """Return value as the canonical kilogram string, rounding half to even to 3 places."""
+    if not isinstance(value, str) or not _KG.fullmatch(value):
+        raise _invalid(value)
+    with localcontext() as ctx:
+        ctx.prec = len(value) + 10  # enough digits so quantize never overflows
+        rounded = Decimal(value).quantize(Decimal("0.001"), rounding=ROUND_HALF_EVEN)
+    return format(rounded, ".3f")
+
+
+def kg_to_g(value):
+    """Return the exact whole number of grams in value."""
+    return int(normalize_kg(value).replace(".", ""))
+
+
+def g_to_kg(grams):
+    """Return a non-negative integer number of grams as the canonical kilogram string."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise _invalid(grams)
+    return f"{grams // 1000}.{grams % 1000:03d}"
