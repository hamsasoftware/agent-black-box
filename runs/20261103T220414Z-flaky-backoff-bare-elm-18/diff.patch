+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedFactorRng:
+    """Stub rng whose uniform() always returns one end of the jitter range."""
+
+    def __init__(self, end):
+        self.end = end  # "lo" or "hi"
+
+    def uniform(self, a, b):
+        return a if self.end == "lo" else b
+
+
+class RetryPolicyTest(unittest.TestCase):
+    def test_delay_never_exceeds_cap_at_max_jitter(self):
+        # Attempt 6 with base 0.5 is 16s; attempt 7 is 32s, which jitter pushes to 35.2s.
+        rng = _FixedFactorRng("hi")
+        for attempt in range(1, 12):
+            self.assertLessEqual(compute_delay(attempt, base=0.5, cap=34, rng=rng), 34)
+
+    def test_capped_delay_equals_cap_at_max_jitter(self):
+        rng = _FixedFactorRng("hi")
+        self.assertEqual(compute_delay(7, base=0.5, cap=34, rng=rng), 34)
+
+    def test_jitter_still_applied_below_cap(self):
+        rng = _FixedFactorRng("hi")
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=30, jitter=0.1, rng=rng), 1.1)
+        rng = _FixedFactorRng("lo")
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=30, jitter=0.1, rng=rng), 0.9)
+
+    def test_schedules_respect_cap_across_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertGreaterEqual(delay, 0)
+                self.assertLessEqual(delay, 34)
+
+    def test_run_sleeps_never_exceed_cap(self):
+        slept = []
+
+        def always_fail():
+            raise ConnectionError("down")
+
+        retrier = Retrier(base=0.5, cap=34, max_attempts=8, sleep=slept.append,
+                          rng=random.Random(3))
+        with self.assertRaises(ConnectionError):
+            retrier.run(always_fail)
+        self.assertTrue(slept)
+        self.assertTrue(all(0 <= d <= 34 for d in slept))
+
+    def test_attempt_below_one_rejected(self):
+        with self.assertRaises(ValueError):
+            compute_delay(0)
+
+
+if __name__ == "__main__":
+    unittest.main()
