-"""Configuration parser.
-
-This module used to be a thin wrapper around the third-party package ``inilite``.
-"""
-import inilite
+"""Parser for the confkit configuration format. The contract is docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = rf"{_NAME}(?:\.{_NAME})*"
+_KEY_RE = re.compile(rf"({_DOTTED})[ \t]*=")
+_HEADER_RE = re.compile(rf"\[[ \t]*({_DOTTED})[ \t]*\](?:[ \t]+[#;].*|[ \t]*)")
+_DIRECTIVE_RE = re.compile(rf"@({_NAME})")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_BASED_INT_RE = re.compile(
+    r"[+-]?0(?:x[0-9a-f](?:_?[0-9a-f])*|o[0-7](?:_?[0-7])*|b[01](?:_?[01])*)",
+    re.IGNORECASE,
+)
+_FLOAT_RE = re.compile(
+    rf"[+-]?(?:{_DIGITS}\.(?:{_DIGITS})?|\.{_DIGITS})(?:[eE][+-]?[0-9]+)?"
+)
+_FLOAT_EXP_RE = re.compile(rf"[+-]?{_DIGITS}[eE][+-]?[0-9]+")
+_HEX4_RE = re.compile(r"[0-9a-fA-F]{4}")
+_TAIL_RE = re.compile(r"[ \t]*|[ \t]+[#;][^\n]*")
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_WS = " \t\n"
+
+
+class _Fail(Exception):
+    """An error inside a value; the caller adds the line number and source."""
+
+
+def _scalar(text):
+    lower = text.lower()
+    if lower in ("true", "false"):
+        return lower == "true"
+    if _DEC_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 10)
+    if _BASED_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 0)
+    if _FLOAT_RE.fullmatch(text) or _FLOAT_EXP_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
+
+
+def _double_quoted(text, i):
+    """Parse a double-quoted string starting at text[i]; return (value, index after it)."""
+    n = len(text)
+    out = []
+    k = i + 1
+    while True:
+        if k >= n or text[k] == "\n":
+            raise _Fail("unterminated string")
+        ch = text[k]
+        if ch == '"':
+            return "".join(out), k + 1
+        if ch == "\\":
+            if k + 1 >= n or text[k + 1] == "\n":
+                raise _Fail("unterminated string")
+            esc = text[k + 1]
+            if esc == "u":
+                digits = text[k + 2:k + 6]
+                if not _HEX4_RE.fullmatch(digits):
+                    raise _Fail("invalid escape \\u (needs four hex digits)")
+                out.append(chr(int(digits, 16)))
+                k += 6
+            elif esc in _ESCAPES:
+                out.append(_ESCAPES[esc])
+                k += 2
+            else:
+                raise _Fail(f"invalid escape \\{esc}")
+            continue
+        out.append(ch)
+        k += 1
+
+
+def _single_quoted(text, i):
+    close = text.find("'", i + 1)
+    newline = text.find("\n", i + 1)
+    if close < 0 or (0 <= newline < close):
+        raise _Fail("unterminated string")
+    return text[i + 1:close], close + 1
+
+
+def _quoted(text, i):
+    if text[i] == '"':
+        return _double_quoted(text, i)
+    return _single_quoted(text, i)
+
+
+def _check_string_tail(text, j):
+    if not _TAIL_RE.fullmatch(text[j:]):
+        raise _Fail("unexpected text after string")
+
+
+def _skip(text, i):
+    """Skip whitespace (including newlines) and comments; return the next significant index."""
+    n = len(text)
+    while True:
+        j = i
+        while j < n and text[j] in _WS:
+            j += 1
+        if j < n and text[j] in "#;" and j > 0 and text[j - 1] in _WS:
+            newline = text.find("\n", j)
+            i = n if newline < 0 else newline
+            continue
+        return j
+
+
+def _list(text, i):
+    """Parse a list starting at text[i] == '['; return (items, index after ']')."""
+    n = len(text)
+    items = []
+    k = i + 1
+    expect_item = True
+    while True:
+        k = _skip(text, k)
+        if k >= n:
+            raise _Fail("unterminated list")
+        ch = text[k]
+        if ch == "]":
+            return items, k + 1
+        if ch == ",":
+            if expect_item:
+                raise _Fail("invalid list: empty item")
+            expect_item = True
+            k += 1
+            continue
+        if not expect_item:
+            raise _Fail("invalid list: items need a comma between them")
+        if ch in "\"'":
+            value, k = _quoted(text, k)
+        elif ch == "[":
+            value, k = _list(text, k)
+        else:
+            j = k
+            while j < n and text[j] not in ",]\n[":
+                if j > k and text[j] in "#;" and text[j - 1] in " \t":
+                    break
+                j += 1
+            if j < n and text[j] == "[":
+                raise _Fail("invalid list: unquoted item contains '['")
+            value = _scalar(text[k:j].strip(" \t"))
+            k = j
+        items.append(value)
+        expect_item = False
+
+
+def _plain(text):
+    lines = []
+    for raw in text.split("\n"):
+        cut = len(raw)
+        for p in range(1, len(raw)):
+            if raw[p] in "#;" and raw[p - 1] in " \t":
+                cut = p
+                break
+        line = raw[:cut].strip(" \t")
+        if line:
+            lines.append(line)
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _value(text):
+    """Convert the value text (after '=', plus continuation lines joined by newlines)."""
+    n = len(text)
+    j = 0
+    while j < n and text[j] in _WS:
+        j += 1
+    if j == n:
+        return ""
+    if text[j] in "\"'":
+        value, end = _quoted(text, j)
+        _check_string_tail(text, end)
+        return value
+    if text[j] == "[":
+        items, end = _list(text, j)
+        if _skip(text, end) != n:
+            raise _Fail("invalid list: text after ']'")
+        return items
+    return _plain(text)
+
+
+class _Parser:
+    def __init__(self, stack):
+        self.result = {}
+        self.sections = set()
+        self.stack = stack  # real paths of the files currently being read
+
+    def document(self, text, source, base_dir):
+        if text.startswith("﻿"):
+            text = text[1:]
+        lines = re.split(r"\r\n|\r|\n", text)
+        n = len(lines)
+        section = ()
+        i = 0
+        while i < n:
+            line = lines[i]
+            lineno = i + 1
+            stripped = line.strip(" \t")
+            if not stripped or stripped[0] in "#;":
+                i += 1
+                continue
+            if line[0] in " \t":
+                raise ParseError("continuation without a value", lineno, source)
+            if line[0] == "[":
+                match = _HEADER_RE.fullmatch(line)
+                if not match:
+                    raise ParseError("invalid section header", lineno, source)
+                section = tuple(match.group(1).split("."))
+                if section in self.sections:
+                    raise ParseError(f"duplicate section [{match.group(1)}]", lineno, source)
+                self.sections.add(section)
+                self._make_table(section, lineno, source)
+                i += 1
+                continue
+            if line[0] == "@":
+                self._include(line, lineno, source, base_dir)
+                i += 1
+                continue
+            match = _KEY_RE.match(line)
+            if not match:
+                raise ParseError("invalid line", lineno, source)
+            pieces = [line[match.end():]]
+            j = i + 1
+            while j < n:
+                nxt = lines[j]
+                nxt_stripped = nxt.strip(" \t")
+                if not nxt_stripped or nxt_stripped[0] in "#;":
+                    j += 1
+                elif nxt[0] in " \t":
+                    pieces.append(nxt)
+                    j += 1
+                else:
+                    break
+            try:
+                value = _value("\n".join(pieces))
+            except _Fail as exc:
+                raise ParseError(str(exc), lineno, source) from None
+            path = section + tuple(match.group(1).split("."))
+            self._store(path, value, lineno, source)
+            i = j
+        return self.result
+
+    def _make_table(self, path, lineno, source):
+        node = self.result
+        for part in path:
+            if part not in node:
+                node[part] = {}
+            elif not isinstance(node[part], dict):
+                raise ParseError(f"key conflict: {'.'.join(path)}", lineno, source)
+            node = node[part]
+
+    def _store(self, path, value, lineno, source):
+        self._make_table(path[:-1], lineno, source)
+        node = self.result
+        for part in path[:-1]:
+            node = node[part]
+        last = path[-1]
+        if last in node:
+            if isinstance(node[last], dict):
+                raise ParseError(f"key conflict: {'.'.join(path)}", lineno, source)
+            raise ParseError(f"duplicate key: {'.'.join(path)}", lineno, source)
+        node[last] = value
+
+    def _include(self, line, lineno, source, base_dir):
+        match = _DIRECTIVE_RE.match(line)
+        if not match or match.group(1) != "include":
+            raise ParseError("invalid line", lineno, source)
+        rest = line[match.end():]
+        body = rest.lstrip(" \t")
+        if not rest[:1] in (" ", "\t") or body[:1] not in ('"', "'"):
+            raise ParseError("invalid include", lineno, source)
+        try:
+            rel, end = _quoted(body, 0)
+            _check_string_tail(body, end)
+        except _Fail:
+            raise ParseError("invalid include", lineno, source) from None
+        if base_dir is None:
+            raise ParseError("include needs a base directory", lineno, source)
+        target = os.path.normpath(os.path.join(base_dir, rel))
+        real = os.path.realpath(target)
+        if real in self.stack:
+            raise ParseError(f"include cycle: {rel}", lineno, source)
+        try:
+            with open(target, encoding="utf-8", newline="") as handle:
+                text = handle.read()
+        except (OSError, UnicodeDecodeError) as exc:
+            raise ParseError(f"cannot read include: {rel} ({exc})", lineno, source) from None
+        self.stack.append(real)
+        try:
+            self.document(text, target, os.path.dirname(target))
+        finally:
+            self.stack.pop()
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    return _Parser(stack=[]).document(text, source, base_dir)
 
 
 def load(path):
-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    with open(path, encoding="utf-8", newline="") as handle:
+        text = handle.read()
+    parser = _Parser(stack=[os.path.realpath(path)])
+    return parser.document(text, path, os.path.dirname(path))
