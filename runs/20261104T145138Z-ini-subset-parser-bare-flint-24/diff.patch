+"""Checks for the rules in docs/FORMAT.md that tests/test_parse.py does not cover."""
+import os
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def error_of(text, base_dir=None):
+    with self_raises() as box:
+        loads(text, base_dir=base_dir)
+    return box["error"]
+
+
+class self_raises:
+    """Context manager that captures a ParseError into box['error']."""
+
+    def __enter__(self):
+        self.box = {}
+        return self.box
+
+    def __exit__(self, kind, exc, tb):
+        if exc is None:
+            raise AssertionError("expected ParseError, nothing was raised")
+        if not isinstance(exc, ParseError):
+            return False
+        self.box["error"] = exc
+        return True
+
+
+class ScalarTest(unittest.TestCase):
+    def test_bool_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\nc = yes\n"), {"a": True, "b": False, "c": "yes"})
+
+    def test_ints(self):
+        self.assertEqual(
+            loads("a = -0\nb = 1_000\nc = -0b101\nd = 0o17\ne = 0XFF\n"),
+            {"a": 0, "b": 1000, "c": -5, "d": 15, "e": 255},
+        )
+
+    def test_floats(self):
+        self.assertEqual(
+            loads("a = .5\nb = 5.\nc = 1e3\nd = -2.5E-3\ne = 1_0.2\nf = 00.5\ng = 007e1\n"),
+            {"a": 0.5, "b": 5.0, "c": 1000.0, "d": -0.0025, "e": 10.2, "f": 0.5, "g": 70.0},
+        )
+
+    def test_strings_that_look_like_numbers_or_not_numbers(self):
+        text = "a = 007\nb = 1__0\nc = _1\nd = inf\ne = nan\nf = 1.2.3\ng = 0x\nh = 1e\ni = +\nj = .\n"
+        self.assertEqual(loads(text), {
+            "a": "007", "b": "1__0", "c": "_1", "d": "inf", "e": "nan",
+            "f": "1.2.3", "g": "0x", "h": "1e", "i": "+", "j": ".",
+        })
+
+    def test_quoted_value_is_never_converted(self):
+        self.assertEqual(loads("a = '42'\nb = \"true\"\n"), {"a": "42", "b": "true"})
+
+    def test_double_quote_escapes(self):
+        self.assertEqual(loads('a = "x\\\\y\\"z\\n\\r\\0\\u0041"\n'), {"a": "x\\y\"z\n\r\x00A"})
+
+    def test_invalid_escape(self):
+        self.assertTrue(error_of('a = "\\q"\n').message.startswith("invalid escape"))
+
+    def test_short_unicode_escape_is_invalid(self):
+        self.assertTrue(error_of('a = "\\u12"\n').message.startswith("invalid escape"))
+
+    def test_text_after_string(self):
+        self.assertTrue(error_of('a = "x" y\n').message.startswith("unexpected text after string"))
+
+    def test_comment_after_string_is_fine(self):
+        self.assertEqual(loads('a = "x" # note\n'), {"a": "x"})
+
+    def test_multiline_quoted_string_is_unterminated(self):
+        err = error_of('a = "one\n    two"\n')
+        self.assertTrue(err.message.startswith("unterminated string"))
+        self.assertEqual(err.lineno, 1)
+
+    def test_byte_order_mark_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+
+class LineTest(unittest.TestCase):
+    def test_crlf_and_cr_line_endings(self):
+        self.assertEqual(loads("a = 1\r\n[s]\rb = 2\n"), {"a": 1, "s": {"b": 2}})
+
+    def test_continuation_without_value(self):
+        for text in ("  x = 1\n", "[a]\n  x = 1\n"):
+            with self.subTest(text=text):
+                err = error_of(text, base_dir=".")
+                self.assertTrue(err.message.startswith("continuation without a value"))
+
+    def test_invalid_line(self):
+        err = error_of("ok = 1\njust words\n")
+        self.assertTrue(err.message.startswith("invalid line"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_invalid_section_header(self):
+        for text in ("[a..b]\n", "[a]x\n", "[a]#c\n", "[a\n"):
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid section header"))
+
+    def test_section_whitespace_and_comment(self):
+        self.assertEqual(loads("[ a.b ]  ; hi\nk = 1\n"), {"a": {"b": {"k": 1}}})
+
+    def test_empty_section_is_empty_dict(self):
+        self.assertEqual(loads("[x]\n"), {"x": {}})
+
+    def test_error_line_is_counted_after_blank_and_comment_lines(self):
+        err = error_of("# c\n\n  # indented comment\nbad line\n")
+        self.assertEqual(err.lineno, 4)
+
+
+class ValueShapeTest(unittest.TestCase):
+    def test_multiline_skips_blank_and_comment_lines(self):
+        text = "hosts =\n    alpha\n\n    # note\n    beta        # primary\nnext = 2\n"
+        self.assertEqual(loads(text), {"hosts": "alpha\nbeta", "next": 2})
+
+    def test_multiline_list(self):
+        self.assertEqual(loads("x = [\n  1, # one\n  2,\n  ]\n"), {"x": [1, 2]})
+        self.assertTrue(error_of("x = [\n  1,\n]\n").message.startswith("unterminated list"))
+
+    def test_nested_and_quoted_list_items(self):
+        self.assertEqual(loads("x = [[1,2],[3], \"a,b\", it's, ' q ']\n"),
+                         {"x": [[1, 2], [3], "a,b", "it's", " q "]})
+
+    def test_unquoted_items_are_scalars(self):
+        self.assertEqual(loads("x = [true, 0x10, 1.5, word]\n"), {"x": [True, 16, 1.5, "word"]})
+
+    def test_empty_plain_value(self):
+        self.assertEqual(loads("a =\nb = # only a comment\n"), {"a": "", "b": ""})
+
+    def test_hash_without_space_is_not_a_comment(self):
+        self.assertEqual(loads("a = x#y ;z\n"), {"a": "x#y"})
+
+    def test_list_errors(self):
+        cases = {
+            "x = [1,,2]\n": "invalid list",
+            "x = [,]\n": "invalid list",
+            "x = [1 2\n": "unterminated list",
+            "x = [1]]\n": "invalid list",
+            "x = [1] junk\n": "invalid list",
+            "x = [\"a\" \"b\"]\n": "invalid list",
+            "x = [a[b]\n": "invalid list",
+        }
+        for text, prefix in cases.items():
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith(prefix))
+
+    def test_value_error_reported_at_key_line(self):
+        err = error_of("x = [1,\n  2,,3]\n")
+        self.assertEqual(err.lineno, 1)
+        self.assertTrue(err.message.startswith("invalid list"))
+
+
+class ConflictTest(unittest.TestCase):
+    def test_dotted_then_section_is_fine(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_section_twice_is_duplicate(self):
+        self.assertTrue(error_of("[a]\n[a]\n").message.startswith("duplicate section"))
+
+    def test_value_then_dotted_key_is_conflict(self):
+        err = error_of("a = 1\na.b = 2\n")
+        self.assertTrue(err.message.startswith("key conflict"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_table_then_value_is_conflict(self):
+        self.assertTrue(error_of("a.b = 1\na = 2\n").message.startswith("key conflict"))
+
+    def test_value_then_section_is_conflict(self):
+        self.assertTrue(error_of("a = 1\n[a]\n").message.startswith("key conflict"))
+
+    def test_duplicate_key_in_section(self):
+        self.assertTrue(error_of("[a]\nx.y = 1\nx.y = 2\n").message.startswith("duplicate key"))
+
+    def test_bad_value_reported_before_duplicate(self):
+        self.assertTrue(error_of("a = 1\na = \"open\n").message.startswith("unterminated string"))
+
+
+class IncludeTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = self.tmp.name
+
+    def write(self, name, text):
+        path = os.path.join(self.root, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_resumes_in_its_section(self):
+        self.write("part.ini", "p = 1\n")
+        main = self.write("main.ini", "[s]\nbefore = 1\n@include 'part.ini'  # tail\nafter = 2\n")
+        self.assertEqual(load(main), {"s": {"before": 1, "after": 2}, "p": 1})
