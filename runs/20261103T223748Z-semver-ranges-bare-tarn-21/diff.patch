+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+class ContractTest(unittest.TestCase):
+    def assertSat(self, version, range_, expected):
+        self.assertIs(satisfies(version, range_), expected, f"{version} in {range_!r}")
+
+    def test_empty_set_and_star_match_release_versions(self):
+        for range_ in ("", "*", "x", "X", "  "):
+            self.assertSat("0.0.1", range_, True)
+            self.assertSat("9.9.9", range_, True)
+            self.assertSat("1.2.3-alpha", range_, False)
+
+    def test_or_of_sets(self):
+        self.assertSat("3.0.0", "1.0.0 || 3.x", True)
+        self.assertSat("2.0.0", "1.0.0 || 3.x", False)
+        self.assertSat("1.0.0", "|| 1.0.0", True)  # an empty set matches everything
+
+    def test_whitespace_after_operator(self):
+        self.assertSat("1.2.3", ">= 1.2.3", True)
+        self.assertSat("1.2.2", ">= 1.2.3", False)
+
+    def test_primitive_comparators_and_default_equals(self):
+        self.assertSat("1.2.3", "1.2.3", True)
+        self.assertSat("1.2.3", "=1.2.3", True)
+        self.assertSat("1.2.4", "1.2.3", False)
+        self.assertSat("1.2.3", "<1.2.3", False)
+        self.assertSat("1.2.2", "<1.2.3", True)
+        self.assertSat("1.2.3", "<=1.2.3", True)
+        self.assertSat("1.2.3", ">1.2.3", False)
+        self.assertSat("1.2.4", ">1.2.3", True)
+
+    def test_partial_with_operators(self):
+        self.assertSat("2.0.0", ">1", True)
+        self.assertSat("1.9.9", ">1", False)
+        self.assertSat("1.3.0", ">1.2", True)
+        self.assertSat("1.2.9", ">1.2", False)
+        self.assertSat("1.2.0", ">=1.2", True)
+        self.assertSat("1.1.9", ">=1.2", False)
+        self.assertSat("1.1.9", "<1.2", True)
+        self.assertSat("1.2.0", "<1.2", False)
+        self.assertSat("1.9.9", "<=1", True)
+        self.assertSat("2.0.0", "<=1", False)
+        self.assertSat("1.3.9", "<=1.2", False)
+        self.assertSat("1.2.9", "<=1.2", True)
+
+    def test_partial_equals(self):
+        self.assertSat("1.2.0", "=1.2", True)
+        self.assertSat("1.2.9", "=1.2", True)
+        self.assertSat("1.3.0", "=1.2", False)
+
+    def test_x_ranges(self):
+        self.assertSat("1.9.9", "1.x", True)
+        self.assertSat("2.0.0", "1.x", False)
+        self.assertSat("1.9.9", "1", True)
+        self.assertSat("1.2.9", "1.2.x", True)
+        self.assertSat("1.3.0", "1.2", False)
+        self.assertSat("1.5.0", "1.x.x", True)
+
+    def test_invalid_x_placement(self):
+        for range_ in ("1.x.3", "x.1", "1.*.2"):
+            with self.assertRaises(ValueError, msg=range_):
+                satisfies("1.0.0", range_)
+
+    def test_hyphen(self):
+        self.assertSat("1.2.3", "1.2.3 - 2.3", True)
+        self.assertSat("2.3.9", "1.2.3 - 2.3", True)
+        self.assertSat("2.4.0", "1.2.3 - 2.3", False)
+        self.assertSat("1.2.3-beta.5", "1.2.3-beta - 2.0.0", True)
+        self.assertSat("1.2.3-beta.5", "1.2.3 - 2.0.0", False)
+        self.assertSat("1.2.2", "1.2.3 - 2.3", False)
+        self.assertSat("2.9.9", "1.2.3 - 2", True)
+        self.assertSat("3.0.0", "1.2.3 - 2", False)
+        self.assertSat("1.2.0", "1.2 - 2", True)
+        self.assertSat("1.1.9", "1.2 - 2", False)
+
+    def test_tilde(self):
+        self.assertSat("1.2.3", "~1.2.3", True)
+        self.assertSat("1.2.99", "~1.2.3", True)
+        self.assertSat("1.3.0", "~1.2.3", False)
+        self.assertSat("1.2.9", "~1.2", True)
+        self.assertSat("1.3.0", "~1.2", False)
+        self.assertSat("1.9.9", "~1", True)
+        self.assertSat("2.0.0", "~1", False)
+        self.assertSat("1.2.3-beta.3", "~1.2.3-beta.2", True)
+        self.assertSat("1.2.3-beta.1", "~1.2.3-beta.2", False)
+
+    def test_caret(self):
+        self.assertSat("1.9.9", "^1.2.3", True)
+        self.assertSat("2.0.0", "^1.2.3", False)
+        self.assertSat("0.2.9", "^0.2.3", True)
+        self.assertSat("0.3.0", "^0.2.3", False)
+        self.assertSat("0.0.3", "^0.0.3", True)
+        self.assertSat("0.0.4", "^0.0.3", False)
+        self.assertSat("1.9.0", "^1.2", True)
+        self.assertSat("2.0.0", "^1.2", False)
+        self.assertSat("0.2.9", "^0.2", True)
+        self.assertSat("0.3.0", "^0.2", False)
+        self.assertSat("0.0.0", "^0.0", True)
+        self.assertSat("0.0.9", "^0.0", True)
+        self.assertSat("0.1.0", "^0.0", False)
+        self.assertSat("0.0.9", "^0.0.x", True)
+        self.assertSat("0.1.0", "^0.0.x", False)
+        self.assertSat("0.9.0", "^0", True)
+        self.assertSat("1.0.0", "^0", False)
+        self.assertSat("0.9.0", "^0.x", True)
+        self.assertSat("1.0.0", "^0.x", False)
+        self.assertSat("1.9.0", "^1", True)
+        self.assertSat("2.0.0", "^1.x", False)
+
+    def test_prerelease_rule(self):
+        self.assertSat("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0", True)
+        self.assertSat("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0", False)
+        self.assertSat("1.5.0-beta", "^1.0.0", False)
+        self.assertSat("2.0.0-rc.1", "^1.0.0", False)
+        self.assertSat("1.2.3-alpha", "*", False)
+        self.assertSat("1.2.3-alpha", "1.2.3-alpha", True)
+
+    def test_prerelease_named_by_any_comparator_in_set(self):
+        self.assertSat("1.2.3-beta", "<=1.2.3-rc <1.2.3-beta", False)
+        self.assertSat("1.2.3-alpha", "<1.2.3-beta", True)  # names 1.2.3 with a prerelease
+
+    def test_build_metadata_ignored(self):
+        self.assertSat("1.2.3+build.9", "1.2.3", True)
+        self.assertSat("v1.2.3", "^1.0.0", True)
+        self.assertSat("1.2.3", "v1.2.3", True)
+
+    def test_invalid_inputs_raise(self):
+        for range_ in (">=", "1.2.3 -", "- 1.2.3", "^1.2.3.4", "01.2.3", ">>1", "1.2-beta", "1.2.3 - 2 - 3"):
+            with self.assertRaises(ValueError, msg=range_):
+                satisfies("1.0.0", range_)
+        with self.assertRaises(ValueError):
+            satisfies("1.x", "^1.0.0")
+        with self.assertRaises(ValueError):
+            satisfies("not-a-version", "^1.0.0")
+
+    def test_invalid_range_raises_even_with_no_versions(self):
+        with self.assertRaises(ValueError):
+            max_satisfying([], ">=")
+
+
+class MaxSatisfyingContractTest(unittest.TestCase):
+    def test_returns_item_unchanged(self):
+        self.assertEqual(max_satisfying(["v1.4.0", "1.3.0"], "^1"), "v1.4.0")
+        self.assertEqual(max_satisfying(["1.2.3+a", "1.2.4+b"], "~1.2"), "1.2.4+b")
+
+    def test_skips_prereleases_unless_named(self):
+        self.assertEqual(max_satisfying(["1.2.0", "1.3.0-beta.1"], "^1.2"), "1.2.0")
+        self.assertEqual(
+            max_satisfying(["1.2.0", "1.3.0-beta.1"], ">=1.3.0-alpha <2"), "1.3.0-beta.1"
+        )
+
+    def test_empty_input(self):
+        self.assertIsNone(max_satisfying([], "*"))
+
+    def test_accepts_iterator(self):
+        self.assertEqual(max_satisfying(iter(["1.0.0", "2.0.0"]), "<2"), "1.0.0")
+
+    def test_invalid_version_in_list_raises(self):
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+
+if __name__ == "__main__":
+    unittest.main()
