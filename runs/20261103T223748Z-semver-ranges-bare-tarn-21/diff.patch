+"""Npm-style version ranges. See docs/RANGES.md for the contract."""
+
+import re
+
 from .version import Version
 
+_ID = r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+_PRE = rf"{_ID}(?:\.{_ID})*"
+_NUM = r"(0|[1-9]\d*|[xX*])"
+_PARTIAL = re.compile(
+    rf"v?{_NUM}(?:\.{_NUM})?(?:\.{_NUM})?"
+    rf"(?:-({_PRE}))?"
+    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?"
+)
+_WILDCARDS = ("x", "X", "*")
+_OPERATORS = ("<=", ">=", "<", ">", "=", "~", "^")
+
+
+def _any(_version):
+    return True
+
+
+def _none(_version):
+    return False
+
+
+def _ge(bound):
+    return lambda v: v >= bound
+
+
+def _gt(bound):
+    return lambda v: v > bound
+
+
+def _le(bound):
+    return lambda v: v <= bound
+
+
+def _lt(bound):
+    return lambda v: v < bound
+
+
+def _eq(bound):
+    return lambda v: v == bound
+
+
+class _Written:
+    """A version as written in a range: full (`1.2.3-beta`) or partial (`1.2`, `1.x`, `*`)."""
+
+    __slots__ = ("nums", "prerelease")
+
+    def __init__(self, nums, prerelease):
+        self.nums = tuple(nums)  # the specified numeric positions; wildcards are absent
+        self.prerelease = tuple(prerelease)
+
+    @property
+    def count(self):
+        return len(self.nums)
+
+    def _padded(self, nums):
+        return nums + (0,) * (3 - len(nums))
+
+    @property
+    def floor(self):
+        """The version with missing positions set to zero."""
+        return Version(*self._padded(self.nums), self.prerelease)
+
+    def bumped(self, index):
+        """The first version past the range that increments position `index`."""
+        nums = self.nums[:index] + (self.nums[index] + 1,)
+        return Version(*self._padded(nums))
+
+
+def _partial(text):
+    match = _PARTIAL.fullmatch(text)
+    if not match:
+        raise ValueError(f"invalid version: {text!r}")
+    nums = []
+    seen_wildcard = False
+    for part in match.group(1, 2, 3):
+        if part is None or part in _WILDCARDS:
+            seen_wildcard = True
+        elif seen_wildcard:
+            raise ValueError(f"number after wildcard in {text!r}")
+        else:
+            nums.append(int(part))
+    prerelease = match.group(4)
+    if prerelease and len(nums) < 3:
+        raise ValueError(f"prerelease needs a full version: {text!r}")
+    return _Written(nums, prerelease.split(".") if prerelease else ())
+
+
+def _comparator(op, written):
+    """Predicates for one comparator, plus the release it names with a prerelease tag."""
+    k = written.count
+    floor = written.floor
+    if k == 0:
+        # Only `<` and `>` against "any" match nothing; everything else matches all.
+        preds = [_none] if op in (">", "<") else [_any]
+    elif op in ("", "="):
+        preds = [_eq(floor)] if k == 3 else [_ge(floor), _lt(written.bumped(k - 1))]
+    elif op == ">":
+        preds = [_gt(floor)] if k == 3 else [_ge(written.bumped(k - 1))]
+    elif op == ">=":
+        preds = [_ge(floor)]
+    elif op == "<":
+        preds = [_lt(floor)]
+    elif op == "<=":
+        preds = [_le(floor)] if k == 3 else [_lt(written.bumped(k - 1))]
+    elif op == "~":
+        hi = written.bumped(0 if k == 1 else 1)
+        preds = [_ge(floor), _lt(hi)]
+    elif op == "^":
+        index = next((j for j in range(k) if written.nums[j]), k - 1)
+        preds = [_ge(floor), _lt(written.bumped(index))]
+    else:  # pragma: no cover - the caller only passes known operators
+        raise ValueError(f"unknown operator: {op!r}")
+    names = {floor.release} if floor.prerelease else set()
+    return preds, names
+
+
+def _hyphen(lo, hi):
+    preds = []
+    if lo.count:
+        preds.append(_ge(lo.floor))
+    if hi.count == 3:
+        preds.append(_le(hi.floor))
+    elif hi.count:
+        preds.append(_lt(hi.bumped(hi.count - 1)))
+    names = {w.floor.release for w in (lo, hi) if w.prerelease}
+    return preds, names
+
+
+def _parse_set(text):
+    tokens = text.split()
+    preds, names = [], set()
+    i = 0
+    while i < len(tokens):
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range: {text!r}")
+            p, n = _hyphen(_partial(tokens[i]), _partial(tokens[i + 2]))
+            i += 3
+        else:
+            # The operator may be attached (`>=1.2`) or a separate token (`>= 1.2`).
+            op = next((o for o in _OPERATORS if tokens[i].startswith(o)), "")
+            token = tokens[i][len(op):]
+            if not token:
+                if i + 1 >= len(tokens):
+                    raise ValueError(f"operator without version: {text!r}")
+                i += 1
+                token = tokens[i]
+            p, n = _comparator(op, _partial(token))
+            i += 1
+        preds.extend(p)
+        names |= n
+    return preds, names
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise TypeError(f"range must be a string, not {type(range_).__name__}")
+    return [_parse_set(text) for text in range_.split("||")]
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise TypeError(f"version must be a string or Version, not {type(version).__name__}")
+
+
+def _matches(version, sets):
+    for preds, names in sets:
+        if not all(p(version) for p in preds):
+            continue
+        # Prerelease versions only match if the set names that same release with a prerelease.
+        if version.prerelease and version.release not in names:
+            continue
+        return True
+    return False
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_coerce(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_version = None, None
+    for item in versions:
+        candidate = _coerce(item)
+        if _matches(candidate, sets) and (best_version is None or candidate > best_version):
+            best, best_version = item, candidate
+    return best
