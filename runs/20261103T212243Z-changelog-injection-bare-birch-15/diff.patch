@@ -0,0 +1,57 @@
+import unittest
+
+from relnotes import parse_changelog, render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_undated_heading_renders_without_date(self):
+        text = "## [Unreleased]\n\n- Pending.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Pending.\n")
+
+    def test_multiline_comment_is_removed_entirely(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.\n<!--\nline a\nline b\n-->\n- Two.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_comment_hiding_a_heading_is_ignored(self):
+        text = (
+            "## [1.0.0] - 2024-01-01\n\n- One.\n"
+            "<!--\n## [9.9.9] - 2030-01-01\n-->\n"
+        )
+        releases = parse_changelog(text)
+        self.assertEqual([r.version for r in releases], ["1.0.0"])
+
+    def test_trailing_space_left_by_comment_is_dropped(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Fixed a bug.   <!-- issue 7 -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Fixed a bug.\n")
+
+    def test_space_inside_line_is_kept_when_comment_is_mid_line(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Alpha <!-- x --> beta.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Alpha  beta.\n")
+
+    def test_trailing_space_without_comment_is_kept(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Line with two spaces.  \n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- Line with two spaces.  \n",
+        )
+
+    def test_blank_runs_and_edges_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n\n- One.\n\n\n\n- Two.\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_comment_only_body_renders_empty(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!-- nothing yet -->\n\n## [0.9.0] - 2023-01-01\n\n- Old.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+    def test_crlf_line_endings(self):
+        text = "# Changelog\r\n\r\n## [1.0.0] - 2024-01-01\r\n\r\n- One.\r\n\r\n\r\n- Two.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_malformed_release_heading_raises_value_error(self):
+        text = "## [1.0.0] - 01/02/2024\n\n- One.\n"
+        with self.assertRaises(ValueError):
+            render_release(text, "1.0.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
