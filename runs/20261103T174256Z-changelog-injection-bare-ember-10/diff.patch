+import unittest
+
+from relnotes import render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_unreleased_heading_without_date(self):
+        text = "## [Unreleased]\n\n- Pending.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Pending.\n")
+
+    def test_inline_comment_leaves_no_trailing_whitespace(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Fixed a bug.   <!-- issue 3 -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Fixed a bug.\n")
+
+    def test_comment_in_middle_of_line_keeps_surrounding_text(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Alpha <!-- note --> beta.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Alpha  beta.\n")
+
+    def test_multiline_comment_is_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One\n<!--\nsecret\n## [9.9.9] - 2099-01-01\n-->\n- Two\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One\n\n- Two\n")
+
+    def test_two_comments_on_one_line(self):
+        text = (
+            "## [1.0.0] - 2024-01-01\n\n- Body\n<!-- first --> <!-- second -->\n"
+        )
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Body\n")
+
+    def test_blank_runs_collapse_and_edges_are_trimmed(self):
+        text = (
+            "## [1.0.0] - 2024-01-01\n\n\n- A\n\n\n\n- B\n\n\n## [0.9.0] - 2023-01-01\n"
+        )
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A\n\n- B\n")
+
+    def test_body_removed_entirely_by_comments(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!-- nothing here -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+    def test_unknown_level_two_heading_does_not_leak_into_previous_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A\n\n## Links\n\n- not a note\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
