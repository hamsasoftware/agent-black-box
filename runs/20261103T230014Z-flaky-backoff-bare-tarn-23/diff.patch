--- a/retrykit/backoff.py
+++ b/retrykit/backoff.py
@@ -6,8 +6,13 @@ def compute_delay(attempt, base=0.5, cap=30.0, jitter=0.1, rng=None):
     if attempt < 1:
         raise ValueError("attempt starts at 1")
     rng = rng or random
-    delay = min(cap, base * 2 ** (attempt - 1))
-    return delay * rng.uniform(1 - jitter, 1 + jitter)
+    # Per docs/RETRY.md: exponential base delay, then jitter, then clamp to [0, cap].
+    # The clamp must come last so jitter can never push a delay above cap.
+    # min(attempt - 1, 1000) avoids float overflow for absurd attempt counts;
+    # 2**1000 * base is already far above any sane cap.
+    raw = base * 2 ** min(attempt - 1, 1000)
+    delay = raw * rng.uniform(1 - jitter, 1 + jitter)
+    return min(max(delay, 0.0), cap)
 
 
