+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedFactorRng:
+    """Stands in for random: uniform(lo, hi) returns lo + (hi - lo) * factor."""
+
+    def __init__(self, position):
+        # position 0.0 -> lower jitter bound, 1.0 -> upper jitter bound
+        self.position = position
+
+    def uniform(self, lo, hi):
+        return lo + (hi - lo) * self.position
+
+
+class RetryPolicyTest(unittest.TestCase):
+    def test_no_delay_exceeds_cap_at_maximum_jitter(self):
+        # Worst case: the jitter factor is at its upper bound (1.1).
+        # attempt 7 with base 0.5 is 32 before jitter; 32 * 1.1 = 35.2 > cap 34.
+        rng = _FixedFactorRng(1.0)
+        for attempt in range(1, 12):
+            self.assertLessEqual(
+                compute_delay(attempt, base=0.5, cap=34, jitter=0.1, rng=rng), 34
+            )
+
+    def test_capped_attempt_is_exactly_cap_at_maximum_jitter(self):
+        # Jitter applies before the clamp, so an over-cap base still lands on cap.
+        rng = _FixedFactorRng(1.0)
+        self.assertEqual(compute_delay(7, base=0.5, cap=34, jitter=0.1, rng=rng), 34)
+
+    def test_uncapped_attempt_gets_full_jitter_range(self):
+        low = compute_delay(1, base=1, cap=100, jitter=0.1, rng=_FixedFactorRng(0.0))
+        high = compute_delay(1, base=1, cap=100, jitter=0.1, rng=_FixedFactorRng(1.0))
+        self.assertAlmostEqual(low, 0.9)
+        self.assertAlmostEqual(high, 1.1)
+
+    def test_schedule_never_exceeds_cap_across_many_seeds(self):
+        # Seeded, so this is reproducible; covers many jitter draws.
+        for seed in range(500):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34)
+                self.assertGreaterEqual(delay, 0)
+
+    def test_huge_attempt_number_does_not_overflow(self):
+        self.assertEqual(
+            compute_delay(5000, base=0.5, cap=30, jitter=0.1, rng=_FixedFactorRng(1.0)), 30
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
