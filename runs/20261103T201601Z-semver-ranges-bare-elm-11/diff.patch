+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+def _sat(version, range_):
+    return satisfies(version, range_)
+
+
+class DocExamplesTest(unittest.TestCase):
+    def test_partial_with_operator(self):
+        cases = [
+            (">1", "2.0.0", True), (">1", "1.9.9", False),
+            (">1.2", "1.3.0", True), (">1.2", "1.2.9", False),
+            (">=1.2", "1.2.0", True), (">=1.2", "1.1.9", False),
+            ("<1.2", "1.1.9", True), ("<1.2", "1.2.0", False),
+            ("<=1", "1.9.9", True), ("<=1", "2.0.0", False),
+            ("<=1.2", "1.2.9", True), ("<=1.2", "1.3.0", False),
+            ("=1.2", "1.2.5", True), ("=1.2", "1.3.0", False),
+        ]
+        for range_, version, expected in cases:
+            with self.subTest(range=range_, version=version):
+                self.assertIs(_sat(version, range_), expected)
+
+    def test_x_ranges(self):
+        for range_ in ("*", "", "x", "X", "1.x", "1", "1.X.X"):
+            with self.subTest(range=range_):
+                self.assertIs(_sat("1.0.0", range_), True)
+        self.assertIs(_sat("2.0.0", "1.X.X"), False)
+        self.assertIs(_sat("1.9.9", "1.2.x"), False)
+        self.assertIs(_sat("1.2.9", "1.2.x"), True)
+        self.assertIs(_sat("1.2.0", "1.2"), True)
+        self.assertIs(_sat("2.0.0", "1"), False)
+
+    def test_wildcard_then_number_is_invalid(self):
+        with self.assertRaises(ValueError):
+            satisfies("1.0.0", "1.x.3")
+
+    def test_hyphen_partials(self):
+        self.assertIs(_sat("2.3.9", "1.2.3 - 2.3"), True)
+        self.assertIs(_sat("2.4.0", "1.2.3 - 2.3"), False)
+        self.assertIs(_sat("2.9.9", "1.2.3 - 2"), True)
+        self.assertIs(_sat("3.0.0", "1.2.3 - 2"), False)
+        self.assertIs(_sat("1.2.3", "1.2.3 - 2.3"), True)
+        self.assertIs(_sat("1.2.2", "1.2.3 - 2.3"), False)
+
+    def test_tilde(self):
+        cases = [
+            ("~1.2.3", "1.2.9", True), ("~1.2.3", "1.3.0", False), ("~1.2.3", "1.2.2", False),
+            ("~1.2", "1.2.0", True), ("~1.2", "1.3.0", False),
+            ("~1", "1.9.0", True), ("~1", "2.0.0", False),
+            ("~1.2.3-beta.2", "1.2.3-beta.3", True), ("~1.2.3-beta.2", "1.2.3", True),
+            ("~1.2.3-beta.2", "1.3.0", False),
+        ]
+        for range_, version, expected in cases:
+            with self.subTest(range=range_, version=version):
+                self.assertIs(_sat(version, range_), expected)
+
+    def test_caret(self):
+        cases = [
+            ("^1.2.3", "1.9.0", True), ("^1.2.3", "2.0.0", False),
+            ("^0.2.3", "0.2.9", True), ("^0.2.3", "0.3.0", False),
+            ("^0.0.3", "0.0.3", True), ("^0.0.3", "0.0.4", False),
+            ("^1.2", "1.9.9", True), ("^1.2", "2.0.0", False),
+            ("^1.2.x", "2.0.0", False), ("^0.2", "0.2.9", True), ("^0.2", "0.3.0", False),
+            ("^0.0", "0.0.9", True), ("^0.0", "0.1.0", False),
+            ("^0.0.x", "0.0.9", True), ("^0.0.x", "0.1.0", False),
+            ("^1", "1.9.9", True), ("^1", "2.0.0", False),
+            ("^1.x", "1.9.9", True), ("^1.x", "2.0.0", False),
+            ("^0", "0.9.9", True), ("^0", "1.0.0", False),
+            ("^0.x", "0.9.9", True), ("^0.x", "1.0.0", False),
+        ]
+        for range_, version, expected in cases:
+            with self.subTest(range=range_, version=version):
+                self.assertIs(_sat(version, range_), expected)
+
+
+class PrereleaseRuleTest(unittest.TestCase):
+    def test_doc_examples(self):
+        self.assertIs(_sat("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0"), True)
+        self.assertIs(_sat("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0"), False)
+        self.assertIs(_sat("2.0.0-rc.1", "^1.0.0"), False)
+        self.assertIs(_sat("1.5.0-beta", "^1.0.0"), False)
+
+    def test_star_and_empty_reject_prereleases(self):
+        self.assertIs(_sat("1.2.3-alpha", "*"), False)
+        self.assertIs(_sat("1.2.3-alpha", ""), False)
+        self.assertIs(_sat("1.2.3", "*"), True)
+
+    def test_prerelease_named_in_other_set_does_not_count(self):
+        self.assertIs(_sat("1.2.3-alpha.1", "1.2.3-alpha.1 || >=1.0.0"), True)
+        self.assertIs(_sat("1.2.3-alpha.2", "1.2.3-alpha.1 || >=1.0.0"), False)
+
+
+class GrammarTest(unittest.TestCase):
+    def test_space_between_operator_and_version(self):
+        self.assertIs(_sat("1.2.3", ">= 1.2.3"), True)
+        self.assertIs(_sat("1.2.2", ">= 1.2.3"), False)
+
+    def test_build_metadata_ignored(self):
+        self.assertIs(_sat("1.2.3+build.9", "=1.2.3+other"), True)
+
+    def test_v_prefix(self):
+        self.assertIs(_sat("v1.2.3", "^1.0.0"), True)
+        self.assertIs(_sat("1.2.3", ">=v1.2"), True)
+
+    def test_invalid_ranges(self):
+        for bad in (">=", "1.2.3 -", "- 1.2.3", ">= - 2", "~>1.2", "01.2.3", "1.2.3.4", ">1.2.3-"):
+            with self.subTest(range=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+
+    def test_invalid_version(self):
+        with self.assertRaises(ValueError):
+            satisfies("1.2", "^1.0.0")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+    def test_invalid_range_raises_even_with_no_versions(self):
+        with self.assertRaises(ValueError):
+            max_satisfying([], ">=")
+
+    def test_union_empty_alternative_matches_any_release(self):
+        self.assertIs(_sat("9.9.9", "1.0.0 ||"), True)
+
+
+class MaxSatisfyingContractTest(unittest.TestCase):
+    def test_returns_original_string(self):
+        self.assertEqual(max_satisfying(["1.2.3+a", "v1.4.0"], "*"), "v1.4.0")
+
+    def test_prerelease_ordering(self):
+        self.assertEqual(
+            max_satisfying(["1.0.0-alpha", "1.0.0-beta.2", "1.0.0-beta.11"], ">=1.0.0-alpha"),
+            "1.0.0-beta.11",
+        )
+
+    def test_empty_input(self):
+        self.assertIsNone(max_satisfying([], "*"))
+
+
+if __name__ == "__main__":
+    unittest.main()
