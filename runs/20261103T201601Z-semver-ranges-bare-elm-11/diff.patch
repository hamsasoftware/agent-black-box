+"""npm-style version ranges. See docs/RANGES.md for the contract."""
+
+import re
+
 from .version import Version
 
+_OPERATORS = ("<=", ">=", "<", ">", "=", "~", "^")
+_TOKEN = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$", re.DOTALL)
+_NUMBER = re.compile(r"^(0|[1-9]\d*)$")
+_WILDCARDS = ("x", "X", "*")
+_NEVER = "never"
+
+
+def _parse_partial(text):
+    """Parse a partial version such as ``1``, ``1.2.x`` or ``*``.
+
+    Returns three components, ``None`` marking a wildcard position.
+    """
+    if text[:1] == "v":
+        text = text[1:]
+    core = text.split("+", 1)[0]
+    if "-" in core:
+        raise ValueError(f"invalid version: {text!r}")
+    parts = core.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version: {text!r}")
+    comps = []
+    wildcard_seen = False
+    for part in parts:
+        if part in _WILDCARDS:
+            wildcard_seen = True
+            comps.append(None)
+        elif _NUMBER.match(part) and not wildcard_seen:
+            comps.append(int(part))
+        else:
+            raise ValueError(f"invalid version: {text!r}")
+    return comps + [None] * (3 - len(comps))
+
+
+def _bump(values, index):
+    """Increment ``values[index]`` and zero everything after it."""
+    return Version(*(values[:index] + [values[index] + 1] + [0] * (2 - index)))
+
+
+def _expand(op, text):
+    """Turn one comparator (operator plus version text) into primitive bounds.
+
+    Each primitive is ``(op, Version)`` with op one of ``< <= > >= =``, or
+    ``(_NEVER, None)`` for an unsatisfiable comparator. An empty list means
+    the comparator places no bound at all.
+    """
+    if text == "":
+        if op:
+            raise ValueError(f"missing version after {op!r}")
+        text = "*"
+    try:
+        full = Version.parse(text)
+    except ValueError:
+        full = None
+
+    if full is not None:
+        comps = list(full.release)
+        base = full
+        count = 3
+    else:
+        comps = _parse_partial(text)
+        count = next((i for i, c in enumerate(comps) if c is None), 3)
+        if count == 0:
+            # Wildcard: matches anything, except that "<" and ">" match nothing.
+            if op in ("<", ">"):
+                return [(_NEVER, None)]
+            return []
+        values = [c or 0 for c in comps]
+        base = Version(*values)
+
+    values = [c or 0 for c in comps]
+    op = op or "="
+
+    if op == "=":
+        if full is not None:
+            return [("=", full)]
+        return [(">=", base), ("<", _bump(values, count - 1))]
+    if op == ">":
+        if full is not None:
+            return [(">", full)]
+        return [(">=", _bump(values, count - 1))]
+    if op == ">=":
+        return [(">=", base)]
+    if op == "<":
+        return [("<", base)]
+    if op == "<=":
+        if full is not None:
+            return [("<=", full)]
+        return [("<", _bump(values, count - 1))]
+    if op == "~":
+        index = 1 if count >= 2 else 0
+        return [(">=", base), ("<", _bump(values, index))]
+    if op == "^":
+        index = next((i for i in range(count) if values[i] != 0), count - 1)
+        return [(">=", base), ("<", _bump(values, index))]
+    raise ValueError(f"unknown operator {op!r}")  # pragma: no cover
+
+
+def _split_items(set_text):
+    """Tokenize a comparator set into ``("cmp", text)`` and ``("hyphen", a, b)``."""
+    tokens = set_text.split()
+    items = []
+    i = 0
+    while i < len(tokens):
+        token = tokens[i]
+        if token == "-":
+            if not items or items[-1][0] != "cmp" or i + 1 >= len(tokens):
+                raise ValueError(f"invalid hyphen range: {set_text!r}")
+            low = items.pop()[1]
+            high = tokens[i + 1]
+            for operand in (low, high):
+                if operand[:1] in _OPERATORS or operand == "-":
+                    raise ValueError(f"invalid hyphen range: {set_text!r}")
+            items.append(("hyphen", low, high))
+            i += 2
+            continue
+        if token in _OPERATORS and i + 1 < len(tokens) and tokens[i + 1] != "-":
+            token += tokens[i + 1]
+            i += 2
+        else:
+            i += 1
+        items.append(("cmp", token))
+    return items
+
+
+def _parse_set(set_text):
+    """Return ``(primitives, prerelease_releases)`` for one comparator set."""
+    primitives = []
+    named = set()
+
+    def note(version_text):
+        try:
+            version = Version.parse(version_text)
+        except ValueError:
+            return
+        if version.prerelease:
+            named.add(version.release)
+
+    for item in _split_items(set_text):
+        if item[0] == "hyphen":
+            _, low, high = item
+            note(low)
+            note(high)
+            primitives += _expand(">=", low)
+            primitives += _expand("<=", high)
+        else:
+            match = _TOKEN.match(item[1])
+            op, text = match.group(1) or "", match.group(2)
+            note(text)
+            primitives += _expand(op, text)
+    return primitives, named
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _as_version(version):
+    if isinstance(version, Version):
+        return version
+    return Version.parse(version)
+
+
+def _in_set(version, primitives, named):
+    if version.prerelease and version.release not in named:
+        return False
+    for op, bound in primitives:
+        if op == _NEVER:
+            return False
+        if op == "=" and not version == bound:
+            return False
+        if op == ">" and not version > bound:
+            return False
+        if op == ">=" and not version >= bound:
+            return False
+        if op == "<" and not version < bound:
+            return False
+        if op == "<=" and not version <= bound:
+            return False
+    return True
+
+
+def _matches(version, parsed_range):
+    return any(_in_set(version, primitives, named) for primitives, named in parsed_range)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    """Return True if ``version`` satisfies the npm-style ``range_``."""
+    return _matches(_as_version(version), _parse_range(range_))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    """Return the highest of ``versions`` satisfying ``range_``, as given, or None."""
+    parsed = _parse_range(range_)
+    best = None
+    best_version = None
+    for candidate in versions:
+        version = _as_version(candidate)
+        if not _matches(version, parsed):
+            continue
+        if best_version is None or version > best_version:
+            best, best_version = candidate, version
+    return best
