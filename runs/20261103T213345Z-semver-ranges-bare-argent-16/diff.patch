+import operator
+import re
+
 from .version import Version
 
+_OP_TOKENS = frozenset(["<", "<=", ">", ">=", "=", "~", "^"])
+_OP_PREFIX = re.compile(r"(<=|>=|<|>|=|~|\^)?")
+_PARTIAL = re.compile(
+    r"^v?([0-9]+|[xX*])(?:\.([0-9]+|[xX*])(?:\.([0-9]+|[xX*]))?)?"
+    r"(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?$"
+)
+_WILDCARDS = frozenset(["x", "X", "*"])
+_CMP = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "==": operator.eq,
+}
+
+_ZERO = Version(0, 0, 0)
+# Atoms are (comparison, Version) pairs; a set matches when every atom holds.
+_ANY = [(">=", _ZERO)]
+_NOTHING = [("<", _ZERO)]
+
+
+def _caret_upper(major, minor, patch):
+    if major > 0 or minor is None:
+        return Version(major + 1, 0, 0)
+    if minor > 0 or patch is None:
+        return Version(0, minor + 1, 0)
+    return Version(0, 0, patch + 1)
+
+
+def _parse_comparator(token):
+    """Return (op, major, minor, patch, full) for one comparator token.
+
+    Missing or wildcard positions are None. `full` is the Version when the
+    token names a complete version, otherwise None.
+    """
+    prefix = _OP_PREFIX.match(token)
+    op = prefix.group(1) or ""
+    body = token[prefix.end():]
+    match = _PARTIAL.match(body)
+    if not match:
+        raise ValueError(f"invalid comparator: {token!r}")
+    groups = match.groups()
+    prerelease = groups[3]
+    numbers = []
+    seen_wildcard = False
+    for group in groups[:3]:
+        if group is None or group in _WILDCARDS:
+            seen_wildcard = True
+            numbers.append(None)
+        elif seen_wildcard:
+            raise ValueError(f"invalid comparator: {token!r}")
+        else:
+            numbers.append(int(group))
+    major, minor, patch = numbers
+    if prerelease is not None and None in numbers:
+        raise ValueError(f"invalid comparator: {token!r}")
+    full = Version.parse(body) if None not in numbers else None
+    return op, major, minor, patch, full
+
+
+def _expand(op, major, minor, patch, full):
+    """Turn one comparator into atoms, following the rules in docs/RANGES.md."""
+    if major is None:
+        return list(_ANY) if op in ("", "=", "<=", ">=", "~", "^") else list(_NOTHING)
+
+    if full is not None:
+        if op in ("", "="):
+            return [("==", full)]
+        if op == "~":
+            return [(">=", full), ("<", Version(major, minor + 1, 0))]
+        if op == "^":
+            return [(">=", full), ("<", _caret_upper(major, minor, patch))]
+        return [(op, full)]
+
+    # Partial version: minor or patch is missing or a wildcard.
+    lower = Version(major, minor or 0, 0)
+    if minor is not None:
+        next_up = Version(major, minor + 1, 0)
+    else:
+        next_up = Version(major + 1, 0, 0)
+    if op in ("", "="):
+        return [(">=", lower), ("<", next_up)]
+    if op == ">=":
+        return [(">=", lower)]
+    if op == "<":
+        return [("<", lower)]
+    if op == ">":
+        return [(">=", next_up)]
+    if op == "<=":
+        return [("<", next_up)]
+    if op == "~":
+        return [(">=", lower), ("<", next_up)]
+    if op == "^":
+        return [(">=", lower), ("<", _caret_upper(major, minor, None))]
+    raise ValueError(f"unknown operator: {op!r}")
+
+
+def _hyphen(low_token, high_token):
+    op_a, *a = _parse_comparator(low_token)
+    op_b, *b = _parse_comparator(high_token)
+    if op_a or op_b:
+        raise ValueError(f"operator not allowed in hyphen range: {low_token} - {high_token}")
+    major, minor, patch, full_a = a
+    if full_a is not None:
+        lower = full_a
+    else:
+        lower = Version(major or 0, minor or 0, patch or 0)
+    return [(">=", lower)] + _expand("<=", *b)
+
+
+def _parse_set(text):
+    tokens = text.split()
+    atoms = []
+    i = 0
+    while i < len(tokens):
+        token = tokens[i]
+        if token in _OP_TOKENS:
+            if i + 1 >= len(tokens):
+                raise ValueError(f"operator without version: {text!r}")
+            token += tokens[i + 1]
+            i += 2
+        elif i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"hyphen range missing upper bound: {text!r}")
+            atoms.extend(_hyphen(token, tokens[i + 2]))
+            i += 3
+            continue
+        else:
+            i += 1
+        op, major, minor, patch, full = _parse_comparator(token)
+        atoms.extend(_expand(op, major, minor, patch, full))
+    return atoms
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _as_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _set_matches(version, atoms):
+    if not all(_CMP[op](version, bound) for op, bound in atoms):
+        return False
+    if version.prerelease:
+        # A prerelease only matches if the set names the same release with a prerelease.
+        return any(bound.prerelease and bound.release == version.release for _, bound in atoms)
+    return True
+
+
+def _matches(version, sets):
+    return any(_set_matches(version, atoms) for atoms in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_as_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        candidate = _as_version(item)
+        if _matches(candidate, sets) and (best_version is None or candidate > best_version):
+            best = item
+            best_version = candidate
+    return best
