@@ -3,8 +3,18 @@ from tabulate import tabulate
 HEADERS = ["SKU", "Name", "Qty", "Unit price"]
 
 
-def _rows(items):
-    return [[i.sku, i.name, i.qty, i.unit_price] for i in sorted(items, key=lambda i: i.sku)]
+FORMATS = ("text", "markdown")
+
+
+def _rows(items, escape_pipes=False):
+    def cell(value):
+        # A literal "|" would end a GitHub markdown table cell early.
+        return str(value).replace("|", r"\|") if escape_pipes else value
+
+    return [
+        [cell(i.sku), cell(i.name), i.qty, i.unit_price]
+        for i in sorted(items, key=lambda i: i.sku)
+    ]
 
 
 def total_value(items):
@@ -15,4 +25,13 @@ def render(items, fmt="text"):
     if fmt == "text":
         table = tabulate(_rows(items), headers=HEADERS, style="plain", number_format=".2f")
         return f"{table}\n\nTotal stock value: {total_value(items):.2f}"
+    if fmt == "markdown":
+        table = tabulate(
+            _rows(items, escape_pipes=True),
+            headers=HEADERS,
+            style="pipe",
+            align=["l", "l", "r", "r"],
+            number_format=".2f",
+        )
+        return f"{table}\n\n**Total stock value:** {total_value(items):.2f}"
     raise ValueError(f"unknown format {fmt!r}")
