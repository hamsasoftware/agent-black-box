@@ -2,7 +2,13 @@ import re
 from dataclasses import dataclass, field
 from typing import Optional
 
-HEADING = re.compile(r"^## \[(?P<version>[^\]]+)\] - (?P<date>\d{4}-\d{2}-\d{2})\s*$")
+# Release headings: "## [2.4.0] - 2024-05-02", or "## [Unreleased]" with no date.
+HEADING = re.compile(
+    r"^## \[(?P<version>[^\]]+)\](?: - (?P<date>\d{4}-\d{2}-\d{2}))?\s*$"
+)
+
+# Maintainer comments. May be inline or span several lines.
+COMMENT = re.compile(r"[ \t]*<!--.*?-->", re.DOTALL)
 
 
 @dataclass
@@ -12,12 +18,34 @@ class Release:
     body: list = field(default_factory=list)
 
 
+def _strip_comments(text):
+    text = COMMENT.sub("", text)
+    # Removing a comment can leave trailing whitespace on its line; drop it.
+    return [line.rstrip() for line in text.splitlines()]
+
+
+def _tidy(lines):
+    """Collapse blank runs to one blank line and trim leading/trailing blanks."""
+    out = []
+    for line in lines:
+        if line == "" and (not out or out[-1] == ""):
+            continue
+        out.append(line)
+    while out and out[-1] == "":
+        out.pop()
+    while out and out[0] == "":
+        out.pop(0)
+    return out
+
+
 def parse_changelog(text):
     releases = []
     current = None
-    for line in text.splitlines():
+    for line in _strip_comments(text):
         if line.startswith("## "):
             match = HEADING.match(line)
+            if match is None:
+                raise ValueError(f"unrecognised release heading: {line!r}")
             current = Release(match.group("version"), match.group("date"))
             releases.append(current)
         elif current is not None:
@@ -28,6 +56,11 @@ def parse_changelog(text):
 def render_release(text, version):
     for release in parse_changelog(text):
         if release.version == version:
-            body = "\n".join(release.body).strip()
-            return f"# {release.version} ({release.date})\n\n{body}\n"
+            header = f"# {release.version}"
+            if release.date:
+                header += f" ({release.date})"
+            body = "\n".join(_tidy(release.body))
+            if not body:
+                return header + "\n"
+            return f"{header}\n\n{body}\n"
     raise LookupError(version)
