-import inilite
+"""Configuration parser for the format described in docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_ENTRY = re.compile("(" + _DOTTED + r")[ \t]*=")
+_HEADER = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\](.*)")
+_INCLUDE = re.compile(r"@include(?![A-Za-z0-9_-])")
+_LINE_END = re.compile(r"\r\n|\r|\n")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_DEC_INT = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_BASED_INT = [
+    (re.compile(r"([+-]?)0[xX]([0-9a-fA-F](?:_?[0-9a-fA-F])*)"), 16),
+    (re.compile(r"([+-]?)0[oO]([0-7](?:_?[0-7])*)"), 8),
+    (re.compile(r"([+-]?)0[bB]([01](?:_?[01])*)"), 2),
+]
+_FLOAT = re.compile(
+    r"[+-]?(?:(?:" + _DIGITS + r"\.(?:" + _DIGITS + r")?|\." + _DIGITS + r")"
+    r"(?:[eE][+-]?[0-9]+)?"
+    r"|" + _DIGITS + r"[eE][+-]?[0-9]+)"
+)
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX = "0123456789abcdefABCDEF"
+
+
+class _Bad(Exception):
+    """A value-level error. The caller attaches the line number of the key."""
+
+
+class _State:
+    def __init__(self):
+        self.root = {}
+        self.defined = set()  # full paths of sections defined by headers
+        self.stack = []       # real paths of the files being loaded
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    st = _State()
+    _parse(text, base_dir, source, st)
+    return st.root
 
 
 def load(path):
     with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+        text = handle.read()
+    st = _State()
+    st.stack.append(os.path.realpath(path))
+    _parse(text, os.path.dirname(path), path, st)
+    return st.root
+
+
+def _parse(text, base_dir, source, st):
+    if text.startswith("﻿"):
+        text = text[1:]
+    section = ()
+    pending = None  # [path, lineno, pieces] of the entry being read
+    for lineno, line in enumerate(_LINE_END.split(text), 1):
+        stripped = line.lstrip(" \t")
+        if not stripped or stripped[0] in "#;":
+            continue
+        if line[0] in " \t":
+            if pending is None:
+                raise ParseError("continuation without a value", lineno, source)
+            pending[2].append(line)
+            continue
+        if pending is not None:
+            _finish(st, pending, source)
+            pending = None
+        if line[0] == "[":
+            section = _header(st, line, lineno, source)
+        elif _INCLUDE.match(line):
+            _include(st, line, lineno, base_dir, source)
+        else:
+            match = _ENTRY.match(line)
+            if not match:
+                raise ParseError("invalid line", lineno, source)
+            key = tuple(match.group(1).split("."))
+            pending = [section + key, lineno, [line[match.end():]]]
+    if pending is not None:
+        _finish(st, pending, source)
+
+
+def _header(st, line, lineno, source):
+    match = _HEADER.match(line)
+    if not match or not _tail_ok(match.group(2)):
+        raise ParseError("invalid section header", lineno, source)
+    path = tuple(match.group(1).split("."))
+    if path in st.defined:
+        raise ParseError(f"duplicate section {_dotted(path)}", lineno, source)
+    st.defined.add(path)
+    node = st.root
+    for depth in range(len(path)):
+        node = _child_table(node, path, depth, lineno, source)
+    return path
+
+
+def _include(st, line, lineno, base_dir, source):
+    rest = line[len("@include"):]
+    body = rest.lstrip(" \t")
+    if rest[:1] not in (" ", "\t") or body[:1] not in ('"', "'"):
+        raise ParseError("invalid include", lineno, source)
+    try:
+        path, end = _scan_quoted(body, 0)
+    except _Bad:
+        raise ParseError("invalid include", lineno, source)
+    if not _tail_ok(body[end:]):
+        raise ParseError("invalid include", lineno, source)
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    target = os.path.normpath(os.path.join(base_dir, path))
+    real = os.path.realpath(target)
+    if real in st.stack:
+        raise ParseError("include cycle", lineno, source)
+    try:
+        with open(target, encoding="utf-8") as handle:
+            text = handle.read()
+    except (OSError, UnicodeDecodeError):
+        raise ParseError(f"cannot read include {path}", lineno, source)
+    st.stack.append(real)
+    _parse(text, os.path.dirname(target), target, st)
+    st.stack.pop()
+
+
+def _finish(st, pending, source):
+    path, lineno, pieces = pending
+    try:
+        value = _value(pieces)
+    except _Bad as exc:
+        raise ParseError(str(exc), lineno, source)
+    node = st.root
+    for depth in range(len(path) - 1):
+        node = _child_table(node, path, depth, lineno, source)
+    last = path[-1]
+    if last in node:
+        if isinstance(node[last], dict):
+            raise ParseError(f"key conflict {_dotted(path)}", lineno, source)
+        raise ParseError(f"duplicate key {_dotted(path)}", lineno, source)
+    node[last] = value
+
+
+def _child_table(node, path, depth, lineno, source):
+    part = path[depth]
+    if part not in node:
+        node[part] = {}
+    child = node[part]
+    if not isinstance(child, dict):
+        raise ParseError(f"key conflict {_dotted(path[:depth + 1])}", lineno, source)
+    return child
+
+
+def _dotted(path):
+    return ".".join(path)
+
+
+def _tail_ok(rest):
+    """True if rest is only whitespace, or whitespace and an inline comment."""
+    body = rest.lstrip(" \t")
+    if not body:
+        return True
+    return body[0] in "#;" and len(body) < len(rest)
+
+
+def _strip_comment(text):
+    for i, c in enumerate(text):
+        if c in "#;" and (i == 0 or text[i - 1] in " \t"):
+            return text[:i]
+    return text
+
+
+def _value(pieces):
+    """Turn the raw pieces of an entry (text after '=', then continuation lines) into a value."""
+    trimmed = [p.lstrip(" \t") for p in pieces]
+    content = [t for t in trimmed if t and t[0] not in "#;"]
+    if not content:
+        return ""
+    first = content[0][0]
+    if first in "\"'":
+        text = content[0]
+        value, end = _scan_quoted(text, 0)
+        if len(content) > 1 or not _tail_ok(text[end:]):
+            raise _Bad("unexpected text after string")
+        return value
+    if first == "[":
+        text = "\n".join(content)
+        value, end = _parse_list(text, 0)
+        if _skip(text, end) != len(text):
+            raise _Bad("invalid list")
+        return value
+    lines = []
+    for piece in pieces:
+        t = _strip_comment(piece).strip(" \t")
+        if t:
+            lines.append(t)
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _scan_quoted(s, i):
+    """Read the quoted string starting at s[i]. Returns (value, index after closing quote)."""
+    quote = s[i]
+    n = len(s)
+    if quote == "'":
+        line_end = s.find("\n", i + 1)
+        limit = n if line_end < 0 else line_end
+        close = s.find("'", i + 1, limit)
+        if close < 0:
+            raise _Bad("unterminated string")
+        return s[i + 1:close], close + 1
+    out = []
+    j = i + 1
+    while True:
+        if j >= n or s[j] == "\n":
+            raise _Bad("unterminated string")
+        c = s[j]
+        if c == '"':
+            return "".join(out), j + 1
+        if c == "\\":
+            if j + 1 >= n or s[j + 1] == "\n":
+                raise _Bad("unterminated string")
+            e = s[j + 1]
+            if e == "u":
+                digits = s[j + 2:j + 6]
+                if len(digits) != 4 or not all(h in _HEX for h in digits):
+                    raise _Bad("invalid escape \\u")
+                out.append(chr(int(digits, 16)))
+                j += 6
+                continue
+            if e not in _ESCAPES:
+                raise _Bad(f"invalid escape \\{e}")
+            out.append(_ESCAPES[e])
+            j += 2
+            continue
+        out.append(c)
+        j += 1
+
+
+def _skip(s, i):
+    """Skip whitespace, newlines and comments inside a list."""
+    n = len(s)
+    while i < n:
+        c = s[i]
+        if c in " \t\n":
+            i += 1
+        elif c in "#;" and (i == 0 or s[i - 1] in " \t\n"):
+            end = s.find("\n", i)
+            i = n if end < 0 else end
+        else:
+            break
+    return i
+
+
+def _parse_list(s, i):
+    """Parse the list starting at s[i] == '['. Returns (items, index after ']')."""
+    n = len(s)
+    items = []
+    i = _skip(s, i + 1)
+    if i >= n:
+        raise _Bad("unterminated list")
+    if s[i] == "]":
+        return items, i + 1
+    while True:
+        if i >= n:
+            raise _Bad("unterminated list")
+        c = s[i]
+        if c == "[":
+            item, i = _parse_list(s, i)
+        elif c in "\"'":
+            item, i = _scan_quoted(s, i)
+        elif c in ",]":
+            raise _Bad("invalid list")
+        else:
+            item, i = _scan_token(s, i)
+        items.append(item)
+        i = _skip(s, i)
+        if i >= n:
+            raise _Bad("unterminated list")
+        if s[i] == "]":
+            return items, i + 1
+        if s[i] != ",":
+            raise _Bad("invalid list")
+        i = _skip(s, i + 1)
+        if i >= n:
+            raise _Bad("unterminated list")
+        if s[i] == "]":
+            return items, i + 1
+
+
+def _scan_token(s, i):
+    """Read an unquoted list item starting at s[i]. Returns (scalar, end index)."""
+    n = len(s)
+    j = i
+    while j < n:
+        c = s[j]
+        if c in ",]\n":
+            break
+        if c == "[":
+            raise _Bad("invalid list")
+        if c in "#;" and j > i and s[j - 1] in " \t":
+            break
+        j += 1
+    return _scalar(s[i:j].strip(" \t")), j
+
+
+def _scalar(tok):
+    low = tok.lower()
+    if low == "true":
+        return True
+    if low == "false":
+        return False
+    if _DEC_INT.fullmatch(tok):
+        return int(tok.replace("_", ""))
+    for pattern, base in _BASED_INT:
+        match = pattern.fullmatch(tok)
+        if match:
+            return int(match.group(1) + match.group(2).replace("_", ""), base)
+    if _FLOAT.fullmatch(tok):
+        return float(tok.replace("_", ""))
+    return tok
