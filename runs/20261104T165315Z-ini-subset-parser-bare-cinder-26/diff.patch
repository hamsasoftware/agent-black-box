@@ -0,0 +1,189 @@
+import os
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def error_of(text, **kwargs):
+    try:
+        loads(text, **kwargs)
+    except ParseError as exc:
+        return exc
+    raise AssertionError(f"no ParseError for {text!r}")
+
+
+class ScalarTest(unittest.TestCase):
+    def test_bool_int_float_forms(self):
+        text = (
+            "a = True\nb = FALSE\nc = -0\nd = 1_000\ne = 0xFF\nf = -0b101\ng = 0o17\n"
+            "h = 1.5\ni = .5\nj = 5.\nk = 1e3\nl = -2.5E-3\nm = 1_0.2\n"
+        )
+        self.assertEqual(loads(text), {
+            "a": True, "b": False, "c": 0, "d": 1000, "e": 255, "f": -5, "g": 15,
+            "h": 1.5, "i": 0.5, "j": 5.0, "k": 1000.0, "l": -0.0025, "m": 10.2,
+        })
+
+    def test_non_numbers_stay_strings(self):
+        text = "a = 007\nb = 1__0\nc = _1\nd = inf\ne = nan\nf = yes\ng = 1.2.3\nh = 0x\ni = 1e\nj = +\nk = .\n"
+        result = loads(text)
+        for key in "abcdefghijk":
+            self.assertIsInstance(result[key], str, key)
+        self.assertEqual(result["a"], "007")
+        self.assertEqual(result["b"], "1__0")
+
+    def test_leading_zero_float(self):
+        self.assertEqual(loads("a = 00.5\nb = 007e1\n"), {"a": 0.5, "b": 70.0})
+
+    def test_bom_and_crlf(self):
+        self.assertEqual(loads("\ufeffa = 1\r\n[s]\r\nb = x\r\n"), {"a": 1, "s": {"b": "x"}})
+
+    def test_plain_multiline_is_not_converted(self):
+        self.assertEqual(loads("a =\n    1\n    2\n"), {"a": "1\n2"})
+
+
+class ListTest(unittest.TestCase):
+    def test_nested_and_trailing_comma(self):
+        self.assertEqual(loads("a = [[1, 2], [\"x\"], ]\n"), {"a": [[1, 2], ["x"]]})
+
+    def test_quote_inside_token_is_ordinary(self):
+        self.assertEqual(loads("a = [it's, 2]\n"), {"a": ["it's", 2]})
+
+    def test_comments_inside_list(self):
+        text = "a = [1, # first\n    2, ; second\n    3]  # done\n"
+        self.assertEqual(loads(text), {"a": [1, 2, 3]})
+
+    def test_quote_mid_token_is_ordinary(self):
+        self.assertEqual(loads('a = [1 "b"]\n'), {"a": ['1 "b"']})
+
+    def test_invalid_lists(self):
+        for text in ["a = [1,,2]\n", "a = [,]\n", "a = [\"a\" \"b\"]\n", "a = [1]x\n", "a = [a[b]\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid list"))
+
+    def test_unterminated_list_at_end(self):
+        self.assertTrue(error_of("a = [1, 2\n").message.startswith("unterminated list"))
+
+    def test_unterminated_quoted_item(self):
+        self.assertTrue(error_of('a = ["x]\n').message.startswith("unterminated string"))
+
+
+class StringErrorTest(unittest.TestCase):
+    def test_invalid_escape(self):
+        err = error_of('a = "x\\q"\n')
+        self.assertTrue(err.message.startswith("invalid escape"))
+        self.assertEqual(err.lineno, 1)
+
+    def test_backslash_at_end_of_line_is_unterminated(self):
+        self.assertTrue(error_of('a = "x\\\n').message.startswith("unterminated string"))
+
+    def test_text_after_string(self):
+        self.assertTrue(error_of('a = "x" y\n').message.startswith("unexpected text after string"))
+
+    def test_unicode_escape_and_single_quotes(self):
+        self.assertEqual(loads('a = "\\u0041\\0"\nb = \'\\x\'\n'), {"a": "A\0", "b": "\\x"})
+
+
+class StructureTest(unittest.TestCase):
+    def test_header_then_parent_is_fine(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_empty_header_gives_empty_dict(self):
+        self.assertEqual(loads("[a]\n[ b ]  ; note\n"), {"a": {}, "b": {}})
+
+    def test_dotted_key_in_section(self):
+        self.assertEqual(loads("[a]\nx.y = 1\nx.z = 2\n"), {"a": {"x": {"y": 1, "z": 2}}})
+
+    def test_key_conflicts(self):
+        cases = [("a = 1\na.b = 2\n", 2), ("a = 1\n[a]\n", 2), ("a.b = 1\na = 2\n", 2),
+                 ("[a.b]\nx = 1\n[a]\nb = 2\n", 4), ("a = 1\n[a.b]\n", 2)]
+        for text, lineno in cases:
+            with self.subTest(text=text):
+                err = error_of(text)
+                self.assertTrue(err.message.startswith("key conflict"), err.message)
+                self.assertEqual(err.lineno, lineno)
+
+    def test_duplicate_section_counts_explicit_headers_only(self):
+        self.assertEqual(loads("[a.b]\n[a]\n"), {"a": {"b": {}}})
+        self.assertTrue(error_of("[a]\n[a]\n").message.startswith("duplicate section"))
+
+    def test_bad_section_header(self):
+        for text in ["[a b]\n", "[a]x\n", "[a\n", "[a.]\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid section header"))
+
+    def test_continuation_without_value(self):
+        for text in ["  x\n", "[a]\n  x\n"]:
+            with self.subTest(text=text):
+                err = error_of(text)
+                self.assertTrue(err.message.startswith("continuation without a value"), err.message)
+
+    def test_continuation_after_include(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, "x.ini"), "w", encoding="utf-8") as handle:
+                handle.write("y = 1\n")
+            err = error_of('@include "x.ini"\n  z\n', base_dir=tmp)
+        self.assertTrue(err.message.startswith("continuation without a value"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_invalid_line(self):
+        err = error_of("ok = 1\nno equals here\n")
+        self.assertTrue(err.message.startswith("invalid line"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_value_error_reported_at_key_line(self):
+        err = error_of('a = 1\nb = "x\n  y"\n')
+        self.assertTrue(err.message.startswith("unterminated string"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_error_string_format(self):
+        err = error_of("a = 1\na = 2\n")
+        self.assertEqual(str(err), "<string>:2: duplicate key a")
+        self.assertIsInstance(err, ValueError)
+
+
+class IncludeErrorTest(unittest.TestCase):
+    def test_include_without_base_dir(self):
+        err = error_of('@include "x.ini"\n')
+        self.assertTrue(err.message.startswith("include needs a base directory"))
+
+    def test_invalid_include_forms(self):
+        for text in ["@include\n", "@include x.ini\n", '@include "x.ini\n',
+                     '@include "x.ini"y\n', '@include "x.ini"#c\n', '@include"x.ini"\n']:
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text, base_dir=".").message.startswith("invalid include"))
+
+    def test_includes_word_is_invalid_line(self):
+        self.assertTrue(error_of("@includes = 1\n", base_dir=".").message.startswith("invalid line"))
+
+    def test_missing_include(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            err = error_of('x = 1\n@include "nope.ini"\n', base_dir=tmp)
+            self.assertTrue(err.message.startswith("cannot read include"))
+            self.assertEqual(err.lineno, 2)
+
+    def test_error_inside_include_has_its_own_source(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, "sub.ini"), "w", encoding="utf-8") as handle:
+                handle.write("ok = 1\nbad = \"x\n")
+            with open(os.path.join(tmp, "main.ini"), "w", encoding="utf-8") as handle:
+                handle.write('@include "sub/../sub.ini"\n')
+            with self.assertRaises(ParseError) as ctx:
+                load(os.path.join(tmp, "main.ini"))
+        self.assertEqual(ctx.exception.source, os.path.join(tmp, "sub.ini"))
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertTrue(ctx.exception.message.startswith("unterminated string"))
+
+    def test_same_file_twice_is_duplicate_not_cycle(self):
+        with tempfile.TemporaryDirectory() as tmp:
