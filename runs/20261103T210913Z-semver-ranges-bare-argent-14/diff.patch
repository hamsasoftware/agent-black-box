+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+class ContractTest(unittest.TestCase):
+    def check(self, version, range_, expected):
+        self.assertIs(satisfies(version, range_), expected, f"{version} in {range_!r}")
+
+    def test_empty_and_wildcards(self):
+        for range_ in ("", "   ", "*", "x", "X", "1.2.3 || "):
+            self.check("0.0.1", range_, True)
+            self.check("9.9.9", range_, True)
+        self.check("1.2.3-alpha", "*", False)
+        self.check("1.2.3-alpha", "", False)
+        self.check("1.2.3-alpha", "1.x", False)
+
+    def test_whitespace_after_operator(self):
+        self.check("1.2.3", ">= 1.2.3", True)
+        self.check("1.2.2", ">= 1.2.3", False)
+        self.check("1.2.3", "> 1.2.2 < 1.3", True)
+
+    def test_partial_with_operators(self):
+        self.check("2.0.0", ">1", True)
+        self.check("1.9.9", ">1", False)
+        self.check("1.3.0", ">1.2", True)
+        self.check("1.2.9", ">1.2", False)
+        self.check("1.2.0", ">=1.2", True)
+        self.check("1.1.9", "<1.2", True)
+        self.check("1.2.0", "<1.2", False)
+        self.check("1.9.9", "<=1", True)
+        self.check("2.0.0", "<=1", False)
+        self.check("1.3.0", "<=1.2", False)
+        self.check("1.2.9", "=1.2", True)
+        self.check("1.3.0", "=1.2", False)
+
+    def test_x_ranges(self):
+        self.check("1.9.9", "1", True)
+        self.check("2.0.0", "1", False)
+        self.check("1.2.9", "1.2.x", True)
+        self.check("1.3.0", "1.2", False)
+        self.check("1.2.0", "1.2.X", True)
+
+    def test_hyphen(self):
+        self.check("1.2.3", "1.2.3 - 2.3", True)
+        self.check("2.3.9", "1.2.3 - 2.3", True)
+        self.check("2.4.0", "1.2.3 - 2.3", False)
+        self.check("1.2.2", "1.2.3 - 2", False)
+        self.check("2.9.9", "1.2.3 - 2", True)
+        self.check("3.0.0", "1.2.3 - 2", False)
+
+    def test_tilde(self):
+        self.check("1.2.3", "~1.2.3", True)
+        self.check("1.3.0", "~1.2.3", False)
+        self.check("1.2.9", "~1.2", True)
+        self.check("1.3.0", "~1.2", False)
+        self.check("1.9.0", "~1", True)
+        self.check("2.0.0", "~1", False)
+        self.check("1.2.3-beta.3", "~1.2.3-beta.2", True)
+        self.check("1.3.0-beta.3", "~1.2.3-beta.2", False)
+
+    def test_caret(self):
+        self.check("1.9.9", "^1.2.3", True)
+        self.check("2.0.0", "^1.2.3", False)
+        self.check("0.2.9", "^0.2.3", True)
+        self.check("0.3.0", "^0.2.3", False)
+        self.check("0.0.3", "^0.0.3", True)
+        self.check("0.0.4", "^0.0.3", False)
+        self.check("1.9.0", "^1.2", True)
+        self.check("2.0.0", "^1.2.x", False)
+        self.check("0.2.9", "^0.2", True)
+        self.check("0.3.0", "^0.2", False)
+        self.check("0.0.9", "^0.0", True)
+        self.check("0.1.0", "^0.0.x", False)
+        self.check("0.9.9", "^0", True)
+        self.check("1.0.0", "^0", False)
+        self.check("1.9.0", "^1.x", True)
+        self.check("0.9.0", "^0.x", True)
+        self.check("1.0.0", "^0.x", False)
+
+    def test_or_sets_and_leading_v(self):
+        self.check("v1.5.0", "^1.0.0 || ^3.0.0", True)
+        self.check("2.5.0", "^1.0.0 || ^3.0.0", False)
+        self.check("1.5.0", "v1.0.0 || v1.5", True)
+        self.check("1.5.0", "v1.0.0 || v3", False)
+
+    def test_build_metadata_ignored(self):
+        self.check("1.2.3+build.9", "1.2.3", True)
+        self.check("1.2.3", ">=1.2.3+build.1", True)
+
+    def test_prerelease_rule(self):
+        self.check("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0", True)
+        self.check("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0", False)
+        self.check("1.5.0-beta", "^1.0.0", False)
+        self.check("2.0.0-rc.1", "^1.0.0", False)
+        self.check("1.2.3-alpha.1", "1.2.3-alpha.1", True)
+        self.check("1.2.3-alpha.2", "1.2.3-alpha.1", False)
+
+    def test_invalid_ranges(self):
+        for bad in (">=", "1.x.3", "1.2.3 -", "- 1.2.3", "a.b", "1.2.3 - 2 - 3",
+                    ">= >=1.0.0", "^01.2.3", "1.2.3.4"):
+            with self.subTest(range=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+
+    def test_invalid_version(self):
+        with self.assertRaises(ValueError):
+            satisfies("1.2", "*")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+    def test_max_satisfying_returns_original_and_handles_prereleases(self):
+        versions = ["v1.4.0", "1.4.1-beta.1", "1.3.9", "2.0.0"]
+        self.assertEqual(max_satisfying(versions, "^1.0.0"), "v1.4.0")
+        self.assertEqual(max_satisfying(versions, ">=1.4.1-beta.0 <1.5"), "1.4.1-beta.1")
+        self.assertIsNone(max_satisfying([], "*"))
+        self.assertEqual(max_satisfying(iter(["1.0.0", "1.0.2"]), "1"), "1.0.2")
+
+    def test_max_satisfying_empty_set_excludes_prereleases(self):
+        self.assertEqual(max_satisfying(["1.0.0", "2.0.0-rc.1"], "*"), "1.0.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
