+"""npm-style version ranges. See docs/RANGES.md for the contract."""
+
+import re
+from functools import lru_cache
+
 from .version import Version
 
+_ZERO = Version(0, 0, 0)
+_BARE_OP = re.compile(r"^(<=|>=|<|>|=|~|\^)$")
+_TERM = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$", re.S)
+_WILD = frozenset(("x", "X", "*"))
+_NUMBER = re.compile(r"^(0|[1-9]\d*)$")
+
+
+def _parse_operand(text):
+    """Return a full Version, or a 3-list of ints/None (None = wildcard position)."""
+    if not text:
+        raise ValueError("missing version in range")
+    if re.search(r"[-+]", text):
+        # Prerelease or build metadata: only valid on a full version.
+        return Version.parse(text)
+    body = text[1:] if text[:1] in ("v", "V") else text
+    parts = body.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version in range: {text!r}")
+    nums = []
+    wild = False
+    for part in parts + [None] * (3 - len(parts)):
+        if part is None or part in _WILD:
+            wild = True
+            nums.append(None)
+        elif wild:
+            raise ValueError(f"number may not follow a wildcard: {text!r}")
+        elif _NUMBER.match(part):
+            nums.append(int(part))
+        else:
+            raise ValueError(f"invalid version in range: {text!r}")
+    if not wild:
+        return Version(*nums)
+    return nums
+
+
+def _concrete(nums):
+    return sum(1 for n in nums if n is not None)
+
+
+def _floor(nums):
+    return Version(*(n or 0 for n in nums))
+
+
+def _next_after(nums):
+    """Smallest version above every version matching the partial `nums`."""
+    k = _concrete(nums)
+    if k == 1:
+        return Version(nums[0] + 1, 0, 0)
+    return Version(nums[0], nums[1] + 1, 0)
+
+
+def _caret_upper(major, minor, patch):
+    if major > 0:
+        return Version(major + 1, 0, 0)
+    if minor > 0:
+        return Version(0, minor + 1, 0)
+    return Version(0, 0, patch + 1)
+
+
+def _expand(op, operand):
+    """Turn one comparator into primitive (op, Version) bounds."""
+    nothing = [("<", _ZERO)]
+    if isinstance(operand, Version):
+        v = operand
+        if op in ("", "="):
+            return [("=", v)]
+        if op in ("<", "<=", ">", ">="):
+            return [(op, v)]
+        if op == "~":
+            return [(">=", v), ("<", Version(v.major, v.minor + 1, 0))]
+        return [(">=", v), ("<", _caret_upper(v.major, v.minor, v.patch))]
+
+    nums = operand
+    k = _concrete(nums)
+    if k == 0:
+        # `*`, `x`, `X`: matches any release; nothing for strict comparisons.
+        return [(">=", _ZERO)] if op in ("", "=", ">=", "<=", "~", "^") else nothing
+    lo = _floor(nums)
+    hi = _next_after(nums)
+    if op in ("", "="):
+        return [(">=", lo), ("<", hi)]
+    if op == ">=":
+        return [(">=", lo)]
+    if op == "<":
+        return [("<", lo)]
+    if op == ">":
+        return [(">=", hi)]
+    if op == "<=":
+        return [("<", hi)]
+    if op == "~":
+        if k == 1:
+            return [(">=", lo), ("<", Version(nums[0] + 1, 0, 0))]
+        return [(">=", lo), ("<", Version(nums[0], nums[1] + 1, 0))]
+    # caret, partial
+    if nums[0] == 0 and k == 1:
+        upper = Version(1, 0, 0)
+    elif nums[0] > 0:
+        upper = Version(nums[0] + 1, 0, 0)
+    else:
+        upper = Version(0, nums[1] + 1, 0)
+    return [(">=", lo), ("<", upper)]
+
+
+def _hyphen(low, high):
+    lo_op = _parse_operand(low)
+    hi_op = _parse_operand(high)
+    if isinstance(lo_op, Version):
+        prims = [(">=", lo_op)]
+    elif _concrete(lo_op) == 0:
+        prims = [(">=", _ZERO)]
+    else:
+        prims = [(">=", _floor(lo_op))]
+    if isinstance(hi_op, Version):
+        prims.append(("<=", hi_op))
+    elif _concrete(hi_op) > 0:
+        prims.append(("<", _next_after(hi_op)))
+    return prims
+
+
+def _parse_set(text):
+    tokens = text.split()
+    if not tokens:
+        return ((">=", _ZERO),)
+    prims = []
+    i, n = 0, len(tokens)
+    while i < n:
+        if i + 1 < n and tokens[i + 1] == "-":
+            if i + 2 >= n:
+                raise ValueError(f"incomplete hyphen range: {text!r}")
+            prims.extend(_hyphen(tokens[i], tokens[i + 2]))
+            i += 3
+            continue
+        token = tokens[i]
+        if _BARE_OP.match(token):
+            if i + 1 >= n:
+                raise ValueError(f"operator without version: {text!r}")
+            token += tokens[i + 1]
+            i += 2
+        else:
+            i += 1
+        match = _TERM.match(token)
+        op = match.group(1) or ""
+        prims.extend(_expand(op, _parse_operand(match.group(2))))
+    return tuple(prims)
+
+
+@lru_cache(maxsize=512)
+def _parse_range(range_):
+    return tuple(_parse_set(part) for part in range_.split("||"))
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise ValueError(f"invalid version: {version!r}")
+
+
+def _set_matches(prims, version):
+    for op, bound in prims:
+        if op == "<":
+            ok = version < bound
+        elif op == "<=":
+            ok = version <= bound
+        elif op == ">":
+            ok = version > bound
+        elif op == ">=":
+            ok = version >= bound
+        else:
+            ok = version == bound
+        if not ok:
+            return False
+    if version.prerelease:
+        # A prerelease only matches if some comparator in the set names the
+        # same major.minor.patch with a prerelease tag.
+        return any(
+            bound.prerelease and bound.release == version.release for _, bound in prims
+        )
+    return True
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    v = _coerce(version)
+    return any(_set_matches(prims, v) for prims in _parse_range(range_))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        v = _coerce(item)
+        if any(_set_matches(prims, v) for prims in sets):
+            if best_version is None or v > best_version:
+                best, best_version = item, v
+    return best
