+    text = strip_comments(text.replace("\r\n", "\n"))
+    for line in text.split("\n"):
+        heading = HEADING.match(line) if line.startswith("## ") else None
+        if heading:
+            current = Release(heading.group("version"), heading.group("date"))
             releases.append(current)
         elif current is not None:
             current.body.append(line)
     return releases
 
 
+def _normalize_body(lines):
+    # Collapse runs of blank lines to one, and drop leading and trailing blank lines.
+    body = []
+    for line in lines:
+        if line.strip() == "":
+            if body and body[-1] == "":
+                continue
+            body.append("")
+        else:
+            body.append(line)
+    while body and body[-1] == "":
+        body.pop()
+    while body and body[0] == "":
+        body.pop(0)
+    return "\n".join(body)
+
+
 def render_release(text, version):
     for release in parse_changelog(text):
         if release.version == version:
-            body = "\n".join(release.body).strip()
-            return f"# {release.version} ({release.date})\n\n{body}\n"
+            header = f"# {release.version} ({release.date})" if release.date else f"# {release.version}"
+            body = _normalize_body(release.body)
+            if not body:
+                return f"{header}\n"
