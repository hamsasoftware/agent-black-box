@@ -0,0 +1,49 @@
+import unittest
+
+from relnotes import render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_multiline_comment_between_entries_is_removed(self):
+        text = "## [1.0.0] - 2024-01-02\n\n- One.\n<!--\nnote\n\n## [9.9.9] - 2099-01-01\n-->\n- Two.\n"
+        # The comment's line breaks are not whitespace on a line, so one blank line remains.
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- One.\n\n- Two.\n")
+
+    def test_comment_inside_text_keeps_surrounding_text(self):
+        text = "## [1.0.0] - 2024-01-02\n\n- Keep <!-- drop --> this.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- Keep  this.\n")
+
+    def test_two_comments_on_one_line_do_not_merge(self):
+        text = "## [1.0.0] - 2024-01-02\n\n- A <!-- x --> keep <!-- y -->\n- B\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- A  keep\n- B\n")
+
+    def test_blank_lines_and_comment_only_lines_collapse(self):
+        text = "## [1.0.0] - 2024-01-02\n\n\n<!-- top -->\n\n\n- A\n\n<!-- mid -->\n\n\n- B\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- A\n\n- B\n")
+
+    def test_windows_line_endings(self):
+        text = "## [1.0.0] - 2024-01-02\r\n\r\n- A <!-- c -->\r\n- B\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- A\n- B\n")
+
+    def test_unreleased_without_date_renders_plain_heading(self):
+        text = "## [Unreleased]\n\n### Added\n- X.\n\n## [1.0.0] - 2024-01-02\n\n- Y.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n### Added\n- X.\n")
+
+    def test_empty_body(self):
+        text = "## [1.0.0] - 2024-01-02\n\n<!-- nothing yet -->\n\n## [0.9.0] - 2023-01-01\n\n- Z.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n")
+
+    def test_heading_with_inline_code_mention_is_not_a_release(self):
+        text = (
+            "## [2.0.0] - 2024-05-02\n\n"
+            "- Support for `## [Unreleased]` sections.\n\n"
+            "## [1.0.0] - 2024-01-02\n\n- Y.\n"
+        )
+        self.assertEqual(
+            render_release(text, "2.0.0"),
+            "# 2.0.0 (2024-05-02)\n\n- Support for `## [Unreleased]` sections.\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
