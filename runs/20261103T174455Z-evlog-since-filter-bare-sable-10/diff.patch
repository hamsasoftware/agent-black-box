 @dataclass(frozen=True)
@@ -29,5 +29,18 @@ def read_events(path):
                 yield parse_line(line)
 
 
+def as_utc(ts):
+    """Return ts as an aware UTC datetime. Naive timestamps are UTC by convention."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def since(events, cutoff):
+    """Keep events at or after cutoff. cutoff must be an aware datetime."""
+    cutoff = as_utc(cutoff)
+    return (event for event in events if as_utc(event.ts) >= cutoff)
+
+
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
diff --git a/tests/test_since.py b/tests/test_since.py
new file mode 100644
index 0000000..2358278
--- /dev/null
+++ b/tests/test_since.py
@@ -0,0 +1,110 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from datetime import datetime, timezone
+
+from evlog.cli import main, parse_since
+from evlog.events import Event, as_utc, parse_line, since
+
+
+def write_events(path, events):
+    with open(path, "w") as f:
+        for event in events:
+            f.write(json.dumps(event) + "\n")
+
+
+def event(ts, level="error"):
+    return {"ts": ts, "service": "api", "level": level, "msg": ""}
+
+
+class ParseSinceTest(unittest.TestCase):
+    def test_date_is_midnight_utc(self):
+        self.assertEqual(parse_since("2024-03-10"), datetime(2024, 3, 10, tzinfo=timezone.utc))
+
+    def test_rejects_other_formats(self):
+        for bad in ["10/03/2024", "yesterday", "2024-13-01", "", "2024-03-10T12:00"]:
+            with self.subTest(value=bad):
+                with self.assertRaises(Exception) as ctx:
+                    parse_since(bad)
+                self.assertIn("expected a date like 2024-03-10", str(ctx.exception))
+
+
+class SinceFilterTest(unittest.TestCase):
+    def test_naive_timestamps_are_utc(self):
+        cutoff = parse_since("2024-03-10")
+        before = Event(ts=datetime(2024, 3, 9, 23, 59, 59), service="api", level="error")
+        at = Event(ts=datetime(2024, 3, 10, 0, 0, 0), service="api", level="error")
+        kept = list(since([before, at], cutoff))
+        self.assertEqual(kept, [at])
+
+    def test_offset_timestamps_compared_in_utc(self):
+        # 2024-03-09 23:30 at UTC-05:00 is 2024-03-10 04:30 UTC, so it is on/after the cutoff.
+        late_evening_us = parse_line(
+            json.dumps(event("2024-03-09T23:30:00-05:00"))
+        )
+        # 2024-03-10 01:00 at UTC+09:00 is 2024-03-09 16:00 UTC, so it is before the cutoff.
+        early_morning_asia = parse_line(
+            json.dumps(event("2024-03-10T01:00:00+09:00"))
+        )
+        kept = list(since([late_evening_us, early_morning_asia], parse_since("2024-03-10")))
+        self.assertEqual(kept, [late_evening_us])
+
+    def test_as_utc_handles_naive_and_aware(self):
+        naive = datetime(2024, 3, 10, 12, 0)
+        self.assertEqual(as_utc(naive), datetime(2024, 3, 10, 12, 0, tzinfo=timezone.utc))
+        aware = datetime(2024, 3, 10, 12, 0, tzinfo=timezone.utc)
+        self.assertEqual(as_utc(aware), aware)
+
+
+class ReportSinceCliTest(unittest.TestCase):
+    def setUp(self):
+        handle, self.path = tempfile.mkstemp(suffix=".jsonl")
+        os.close(handle)
+        write_events(
+            self.path,
+            [
+                event("2024-03-09T23:59:59+00:00"),
+                event("2024-03-10 00:00:00"),
+                event("2024-03-10T00:00:00-05:00", level="info"),
+                event("2024-03-10T12:00:00+00:00", level="info"),
+            ],
+        )
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def test_without_since_counts_everything(self):
+        out = io.StringIO()
+        main(["report", self.path], out=out)
+        self.assertEqual(out.getvalue().splitlines()[-1], "total 4")
+
+    def test_since_boundary_is_inclusive_utc(self):
+        out = io.StringIO()
+        code = main(["report", self.path, "--since", "2024-03-10"], out=out)
+        self.assertEqual(code, 0)
+        # 00:00 UTC on the 10th is kept; 2024-03-10T00:00-05:00 is 05:00 UTC, also kept.
+        self.assertEqual(out.getvalue().splitlines(), ["api error 1", "api info 2", "total 3"])
+
+    def test_bad_date_is_a_usage_error_not_a_traceback(self):
+        for args in (["--since", "10/03/2024"], ["--since", "2024-02-30"], ["--since"]):
+            with self.subTest(args=args):
+                err = io.StringIO()
+                out = io.StringIO()
+                with contextlib.redirect_stderr(err), self.assertRaises(SystemExit) as ctx:
+                    main(["report", self.path, *args], out=out)
+                self.assertEqual(ctx.exception.code, 2)
+                self.assertIn("usage: evlog report", err.getvalue())
+                self.assertEqual(out.getvalue(), "")
+
+    def test_bad_date_message_names_the_value(self):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), self.assertRaises(SystemExit):
+            main(["report", self.path, "--since", "10/03/2024"], out=io.StringIO())
+        self.assertIn("expected a date like 2024-03-10, got '10/03/2024'", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
