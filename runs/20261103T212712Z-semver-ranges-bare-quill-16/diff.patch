+import operator
+import re
+
 from .version import Version
 
+_PRE = (
+    r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+    r"(?:\.(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*))*"
+)
+_PART = r"(0|[1-9]\d*|[xX*])"
+_PARTIAL = re.compile(
+    rf"^v?{_PART}(?:\.{_PART})?(?:\.{_PART})?"
+    rf"(?:-({_PRE}))?"
+    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"
+)
+_WILDCARDS = frozenset("xX*")
+_TOKEN = re.compile(r"^(<=|>=|<|>|=|\^|~)?(.*)$")
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+
+def _parse_partial(text):
+    """Return (numbers, prerelease) for a possibly partial version.
+
+    ``numbers`` holds only the specified leading numeric positions, so its
+    length is the number of positions that are not wildcards or missing.
+    """
+    match = _PARTIAL.match(text)
+    if not match:
+        raise ValueError(f"invalid version in range: {text!r}")
+    parts = match.group(1), match.group(2), match.group(3)
+    pre = match.group(4)
+    numbers = []
+    wild = False
+    for part in parts:
+        if part is None or part in _WILDCARDS:
+            wild = True
+        elif wild:
+            raise ValueError(f"number after wildcard in {text!r}")
+        else:
+            numbers.append(int(part))
+    if wild and pre:
+        raise ValueError(f"prerelease on partial version {text!r}")
+    return numbers, (tuple(pre.split(".")) if pre else ())
+
+
+def _pad(numbers):
+    return list(numbers) + [0] * (3 - len(numbers))
+
+
+def _bump(numbers, index):
+    """Return the version obtained by incrementing position ``index``."""
+    padded = _pad(numbers)
+    return Version(*padded[:index], padded[index] + 1, *([0] * (2 - index)))
+
+
+def _primitive(op, text):
+    numbers, pre = _parse_partial(text)
+    k = len(numbers)
+    if k == 3:
+        version = Version(*numbers, pre)
+        if op in ("", "="):
+            return [("=", version)]
+        return [(op, version)]
+
+    low = Version(*_pad(numbers), pre)
+    high = _bump(numbers, k - 1) if k else None
+    if op == ">":
+        # ">1" means ">=2.0.0"; ">*" matches nothing.
+        return [(">=", high)] if high else [("<", low)]
+    if op == ">=":
+        return [(">=", low)]
+    if op == "<":
+        # "<1.2" means "<1.2.0"; "<*" matches nothing (nothing is below 0.0.0).
+        return [("<", low)]
+    if op == "<=":
+        # "<=1.2" means "<1.3.0"; "<=*" matches everything.
+        return [("<", high)] if high else [(">=", low)]
+    # Bare or "=": an X-range.
+    if high is None:
+        return [(">=", low)]
+    return [(">=", low), ("<", high)]
+
+
+def _caret(text):
+    numbers, pre = _parse_partial(text)
+    k = len(numbers)
+    if k == 0:
+        return [(">=", Version(0, 0, 0))]
+    padded = _pad(numbers)
+    index = next((i for i in range(k) if padded[i] != 0), k - 1)
+    return [(">=", Version(*padded, pre)), ("<", _bump(numbers, index))]
+
+
+def _tilde(text):
+    numbers, pre = _parse_partial(text)
+    k = len(numbers)
+    if k == 0:
+        return [(">=", Version(0, 0, 0))]
+    return [(">=", Version(*_pad(numbers), pre)), ("<", _bump(numbers, min(k, 2) - 1))]
+
+
+def _hyphen(low_text, high_text):
+    low_numbers, low_pre = _parse_partial(low_text)
+    high_numbers, high_pre = _parse_partial(high_text)
+    comps = [(">=", Version(*_pad(low_numbers), low_pre))]
+    k = len(high_numbers)
+    if k == 3:
+        comps.append(("<=", Version(*high_numbers, high_pre)))
+    elif k > 0:
+        comps.append(("<", _bump(high_numbers, k - 1)))
+    return comps
+
+
+def _parse_set(text):
+    text = re.sub(r"(<=|>=|<|>|=|\^|~)\s+", r"\1", text.strip())
+    tokens = text.split()
+    comps = []
+    i = 0
+    while i < len(tokens):
+        if i + 2 < len(tokens) and tokens[i + 1] == "-":
+            comps.extend(_hyphen(tokens[i], tokens[i + 2]))
+            i += 3
+            continue
+        match = _TOKEN.match(tokens[i])
+        op, body = match.group(1) or "", match.group(2)
+        if not body:
+            raise ValueError(f"operator without version: {tokens[i]!r}")
+        if op == "^":
+            comps.extend(_caret(body))
+        elif op == "~":
+            comps.extend(_tilde(body))
+        else:
+            comps.extend(_primitive(op, body))
+        i += 1
+    return comps
+
+
+def _parse_range(range_):
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    return Version.parse(version)
+
+
+def _match_set(version, comps):
+    if not all(_OPS[op](version, bound) for op, bound in comps):
+        return False
+    if version.prerelease:
+        return any(
+            bound.prerelease and bound.release == version.release for _, bound in comps
+        )
+    return True
+
+
+def _match(version, sets):
+    return any(_match_set(version, comps) for comps in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _match(_coerce(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        candidate = _coerce(item)
+        if _match(candidate, sets) and (best_version is None or candidate > best_version):
+            best, best_version = item, candidate
+    return best
