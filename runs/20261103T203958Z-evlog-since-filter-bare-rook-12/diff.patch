--- a/evlog/events.py
+++ b/evlog/events.py
@@ -1,7 +1,7 @@
 import json
 from collections import Counter
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timezone
 
 
 @dataclass(frozen=True)
@@ -31,3 +31,22 @@ def read_events(path):
 
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
+
+
+def as_utc(ts):
+    """Naive timestamps are UTC (legacy collectors); aware ones are converted."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def parse_since(text):
+    """Parse a --since value (date or ISO datetime); naive values are UTC."""
+    try:
+        return as_utc(datetime.fromisoformat(text))
+    except ValueError:
+        raise ValueError(f"invalid --since value {text!r}: expected YYYY-MM-DD or ISO datetime")
+
+
+def filter_since(events, since):
+    return (event for event in events if as_utc(event.ts) >= since)
