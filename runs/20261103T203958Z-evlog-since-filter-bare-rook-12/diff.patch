@@ -0,0 +1,45 @@
+import contextlib
+import io
+import unittest
+
+from evlog.cli import main
+from tests.test_report import ReportTest
+
+
+class SinceTest(ReportTest):
+    # Reuses the fixture only; the inherited tests are disabled here
+    # (they already run in test_report).
+    test_counts_every_event = None
+    test_since_excludes_older_days = None
+
+    def test_since_respects_offsets(self):
+        # 2024-03-12T08:15+09:00 is 2024-03-11T23:15Z: before this cutoff
+        _, lines = self.run_cli("--since", "2024-03-12")
+        self.assertEqual(lines, ["worker error 1", "worker info 1", "total 2"])
+
+    def test_since_datetime_is_inclusive(self):
+        _, lines = self.run_cli("--since", "2024-03-13T06:00:00+00:00")
+        self.assertEqual(lines, ["worker error 1", "total 1"])
+
+    def test_since_future_gives_zero_total(self):
+        _, lines = self.run_cli("--since", "2030-01-01")
+        self.assertEqual(lines, ["total 0"])
+
+    def test_bad_since_is_clean_error(self):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), self.assertRaises(SystemExit) as cm:
+            self.run_cli("--since", "yesterday")
+        self.assertEqual(cm.exception.code, 2)
+        self.assertIn("invalid --since", err.getvalue())
+        self.assertNotIn("Traceback", err.getvalue())
+
+    def test_missing_file_is_clean_error(self):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), self.assertRaises(SystemExit) as cm:
+            main(["report", self.path + ".nope"], out=io.StringIO())
+        self.assertEqual(cm.exception.code, 2)
+        self.assertNotIn("Traceback", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
