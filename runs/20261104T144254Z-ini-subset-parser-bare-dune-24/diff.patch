+"""Configuration parser. The format is specified in docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_WS = " \t"
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_KEY_RE = re.compile("(" + _DOTTED + r")[ \t]*=")
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\](?:[ \t]+[#;].*)?[ \t]*")
+_NAME_CHAR_RE = re.compile(r"[A-Za-z0-9_-]")
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX4_RE = re.compile(r"[0-9A-Fa-f]{4}")
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_DIG = r"[0-9](?:_?[0-9])*"
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:(?:" + _DIG + r"\.(?:" + _DIG + r")?|\." + _DIG + r")(?:[eE][+-]?[0-9]+)?"
+    + "|" + _DIG + r"[eE][+-]?[0-9]+)"
+)
+
+
+def _prefixed_re(letter, digit):
+    return re.compile(r"([+-]?)0" + letter + "(" + digit + ")", re.IGNORECASE)
+
+
+_PREFIXED_INTS = (
+    (_prefixed_re("x", r"[0-9a-f](?:_?[0-9a-f])*"), 16),
+    (_prefixed_re("o", r"[0-7](?:_?[0-7])*"), 8),
+    (_prefixed_re("b", r"[01](?:_?[01])*"), 2),
+)
+
+
+class _Fail(Exception):
+    """A value-level error. The caller reports it at the key line."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+class _State:
+    def __init__(self, stack):
+        self.result = {}
+        self.defined = set()   # section paths already opened by a header
+        self.stack = stack     # real paths of the files being parsed
+
+
+class _Entry:
+    def __init__(self, lineno, section, key, first):
+        self.lineno = lineno
+        self.section = section
+        self.key = key
+        self.segments = [first]
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    state = _State([])
+    _parse_text(state, text, source, base_dir)
+    return state.result
 
 
 def load(path):
     with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+        text = handle.read()
+    state = _State([os.path.realpath(path)])
+    _parse_text(state, text, path, os.path.dirname(path) or ".")
+    return state.result
+
+
+def _parse_text(state, text, source, base_dir):
+    if text.startswith("﻿"):
+        text = text[1:]
+    section = ()
+    pending = None
+    for lineno, raw in enumerate(re.split(r"\r\n|\r|\n", text), 1):
+        stripped = raw.strip(_WS)
+        if not stripped or stripped[0] in "#;":
+            continue
+        if raw[0] in _WS:
+            if pending is None:
+                raise ParseError("continuation without a value", lineno, source)
+            pending.segments.append(stripped)
+            continue
+        if pending is not None:
+            _finish(state, pending, source)
+            pending = None
+        if raw[0] == "[":
+            match = _HEADER_RE.fullmatch(raw)
+            if match is None:
+                raise ParseError("invalid section header", lineno, source)
+            section = tuple(match.group(1).split("."))
+            _open_section(state, section, lineno, source)
+        elif raw[0] == "@":
+            _include(state, raw, lineno, source, base_dir)
+        else:
+            match = _KEY_RE.match(raw)
+            if match is None:
+                raise ParseError("invalid line", lineno, source)
+            key = tuple(match.group(1).split("."))
+            pending = _Entry(lineno, section, key, raw[match.end():])
+    if pending is not None:
+        _finish(state, pending, source)
+
+
+def _open_section(state, parts, lineno, source):
+    name = ".".join(parts)
+    if parts in state.defined:
+        raise ParseError(f"duplicate section: {name}", lineno, source)
+    node = state.result
+    for part in parts:
+        if part not in node:
+            node[part] = {}
+        elif not isinstance(node[part], dict):
+            raise ParseError(f"key conflict: {name}", lineno, source)
+        node = node[part]
+    state.defined.add(parts)
+
+
+def _finish(state, entry, source):
+    try:
+        value = _value(entry.segments)
+    except _Fail as failure:
+        raise ParseError(failure.message, entry.lineno, source) from None
+    _store(state, entry.section + entry.key, value, entry.lineno, source)
+
+
+def _store(state, path, value, lineno, source):
+    name = ".".join(path)
+    parent = state.result
+    for part in path[:-1]:
+        if part not in parent:
+            parent = None
+            break
+        child = parent[part]
+        if not isinstance(child, dict):
+            raise ParseError(f"key conflict: {name}", lineno, source)
+        parent = child
+    if parent is not None and path[-1] in parent:
+        if isinstance(parent[path[-1]], dict):
+            raise ParseError(f"key conflict: {name}", lineno, source)
+        raise ParseError(f"duplicate key: {name}", lineno, source)
+    node = state.result
+    for part in path[:-1]:
+        node = node.setdefault(part, {})
+    node[path[-1]] = value
+
+
+def _include(state, raw, lineno, source, base_dir):
+    if not raw.startswith("@include") or _NAME_CHAR_RE.match(raw[8:9]):
+        raise ParseError("invalid line", lineno, source)
+    try:
+        path = _include_path(raw[8:].strip(_WS))
+    except _Fail as failure:
+        raise ParseError(failure.message, lineno, source) from None
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    target = os.path.join(base_dir, path)
+    real = os.path.realpath(target)
+    if real in state.stack:
+        raise ParseError(f"include cycle: {path}", lineno, source)
+    try:
+        with open(target, encoding="utf-8") as handle:
+            text = handle.read()
+    except (OSError, UnicodeDecodeError):
+        raise ParseError(f"cannot read include: {path}", lineno, source) from None
+    child_source = os.path.normpath(target)
+    state.stack.append(real)
+    _parse_text(state, text, child_source, os.path.dirname(child_source) or ".")
+    state.stack.pop()
+
+
+def _include_path(body):
+    if not body or body[0] not in "\"'":
+        raise _Fail("invalid include")
+    try:
+        path, end = _quoted(body, 0)
+        _check_tail(body, end)
+    except _Fail:
+        raise _Fail("invalid include") from None
+    return path
+
+
+def _value(segments):
+    parts = []
+    for text in segments:
+        text = text.strip(_WS)
+        if text and text[0] not in "#;":
+            parts.append(text)
+    if not parts:
+        return ""
+    first = parts[0][0]
+    if first in "\"'":
+        joined = "\n".join(parts)
+        value, end = _quoted(joined, 0)
+        _check_tail(joined, end)
+        return value
+    if first == "[":
+        joined = "\n".join(parts)
+        value, end = _list(joined, 0)
+        if _skip_ws(joined, end) != len(joined):
+            raise _Fail("invalid list")
+        return value
+    lines = [line for line in (_strip_comment(p).strip(_WS) for p in parts) if line]
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _quoted(text, i):
+    """Parse a quoted string starting at text[i]. Returns (value, index after it)."""
+    quote = text[i]
+    n = len(text)
+    j = i + 1
+    out = []
+    while True:
+        if j >= n or text[j] == "\n":
+            raise _Fail("unterminated string")
+        c = text[j]
+        if c == quote:
+            return "".join(out), j + 1
+        if quote == "'" or c != "\\":
+            out.append(c)
+            j += 1
+            continue
+        if j + 1 >= n or text[j + 1] == "\n":
+            raise _Fail("unterminated string")
+        e = text[j + 1]
+        if e in _ESCAPES:
+            out.append(_ESCAPES[e])
+            j += 2
+        elif e == "u" and _HEX4_RE.fullmatch(text[j + 2:j + 6]):
+            out.append(chr(int(text[j + 2:j + 6], 16)))
+            j += 6
+        else:
+            raise _Fail("invalid escape")
+
+
+def _check_tail(text, end):
+    """After a quoted string only whitespace or an inline comment may follow, on the same line."""
+    rest = text[end:]
+    if "\n" in rest:
+        raise _Fail("unexpected text after string")
+    if rest.strip(_WS) and not re.fullmatch(r"[ \t]+[#;].*", rest):
+        raise _Fail("unexpected text after string")
+
+
+def _list(text, i):
+    """Parse a list starting at text[i] == '['. Returns (items, index after ']')."""
+    n = len(text)
+    items = []
+    i += 1
+    expect_item = True
+    while True:
+        i = _skip_ws(text, i)
+        if i >= n:
+            raise _Fail("unterminated list")
+        c = text[i]
+        if c == "]":
+            return items, i + 1
+        if not expect_item:
+            if c != ",":
+                raise _Fail("invalid list")
+            expect_item = True
+            i += 1
+            continue
+        if c == ",":
+            raise _Fail("invalid list")
+        if c in "\"'":
+            value, i = _quoted(text, i)
+        elif c == "[":
+            value, i = _list(text, i)
+        else:
+            j = i
+            while j < n and text[j] not in ",]\n[" and not _is_comment_at(text, j):
+                j += 1
+            if j < n and text[j] == "[":
+                raise _Fail("invalid list")
+            value = _scalar(text[i:j].strip(_WS))
+            i = j
+        items.append(value)
+        expect_item = False
+
+
+def _is_comment_at(text, i):
+    return text[i] in "#;" and (i == 0 or text[i - 1] in " \t\n")
+
+
+def _skip_ws(text, i):
+    """Skip spaces, tabs, newlines and inline comments."""
+    n = len(text)
+    while i < n:
+        if text[i] in " \t\n":
+            i += 1
+        elif _is_comment_at(text, i):
+            nl = text.find("\n", i)
+            i = n if nl == -1 else nl
+        else:
+            break
+    return i
+
+
+def _strip_comment(text):
+    for i, c in enumerate(text):
+        if c in "#;" and (i == 0 or text[i - 1] in _WS):
+            return text[:i]
+    return text
+
+
+def _scalar(token):
+    lowered = token.lower()
+    if lowered == "true":
+        return True
+    if lowered == "false":
+        return False
+    if _DEC_INT_RE.fullmatch(token):
+        return int(token.replace("_", ""))
+    for pattern, base in _PREFIXED_INTS:
+        match = pattern.fullmatch(token)
+        if match:
+            value = int(match.group(2).replace("_", ""), base)
+            return -value if match.group(1) == "-" else value
+    if _FLOAT_RE.fullmatch(token):
+        return float(token.replace("_", ""))
+    return token
