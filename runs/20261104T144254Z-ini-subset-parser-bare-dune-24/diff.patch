+import os
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def error_of(text, **kwargs):
+    try:
+        loads(text, **kwargs)
+    except ParseError as exc:
+        return exc
+    raise AssertionError(f"no ParseError for {text!r}")
+
+
+class ScalarTest(unittest.TestCase):
+    def test_bool_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\nc = tRue\n"), {"a": True, "b": False, "c": True})
+
+    def test_int_forms(self):
+        self.assertEqual(
+            loads("a = -0\nb = 1_000\nc = +7\nd = 0xFF\ne = -0b101\nf = 0o17\ng = 0XaB\n"),
+            {"a": 0, "b": 1000, "c": 7, "d": 255, "e": -5, "f": 15, "g": 171},
+        )
+
+    def test_float_forms(self):
+        self.assertEqual(
+            loads("a = 1.5\nb = .5\nc = 5.\nd = 1e3\ne = -2.5E-3\nf = 1_0.2\ng = 00.5\nh = 007e1\n"),
+            {"a": 1.5, "b": 0.5, "c": 5.0, "d": 1000.0, "e": -0.0025, "f": 10.2, "g": 0.5, "h": 70.0},
+        )
+
+    def test_non_numbers_stay_strings(self):
+        text = "a = 1__0\nb = _1\nc = inf\nd = nan\ne = yes\nf = 1.2.3\ng = 0x\nh = 1e\ni = +\nj = .\nk = 0_0\n"
+        self.assertEqual(loads(text), {
+            "a": "1__0", "b": "_1", "c": "inf", "d": "nan", "e": "yes", "f": "1.2.3",
+            "g": "0x", "h": "1e", "i": "+", "j": ".", "k": "0_0",
+        })
+
+    def test_quoted_value_is_never_converted(self):
+        self.assertEqual(loads('a = "true"\nb = \'1.5\'\n'), {"a": "true", "b": "1.5"})
+
+
+class StringTest(unittest.TestCase):
+    def test_quoted_escapes(self):
+        self.assertEqual(loads(r'a = "\\ \" \u00e9 \0x"' + "\n"), {"a": '\\ " \u00e9 \0x'})
+
+    def test_single_quote_is_literal(self):
+        self.assertEqual(loads(r"a = 'x\\y\'"+ "\n"), {"a": "x\\\\y\\"})
+
+    def test_invalid_escape(self):
+        exc = error_of('a = "\\q"\n')
+        self.assertTrue(exc.message.startswith("invalid escape"))
+        self.assertEqual(exc.lineno, 1)
+
+    def test_short_unicode_escape_is_invalid(self):
+        self.assertTrue(error_of('a = "\\u12"\n').message.startswith("invalid escape"))
+
+    def test_text_after_string(self):
+        self.assertEqual(loads('a = "x"  # ok\n'), {"a": "x"})
+        self.assertTrue(error_of('a = "x" y\n').message.startswith("unexpected text after string"))
+        self.assertTrue(error_of('a = "x"# no\n').message.startswith("unexpected text after string"))
+
+    def test_string_must_close_on_its_line(self):
+        exc = error_of('a = "one\ntwo"\n')
+        self.assertTrue(exc.message.startswith("unterminated string"))
+        self.assertEqual(exc.lineno, 1)
+
+    def test_error_in_continuation_reported_at_key_line(self):
+        exc = error_of('ok = 1\nmulti =\n    "abc\n    def"\n')
+        self.assertEqual(exc.lineno, 2)
+        self.assertTrue(exc.message.startswith("unterminated string"))
+
+    def test_plain_multiline_keeps_quotes_and_brackets(self):
+        self.assertEqual(loads('a = x\n  "[y]"\n'), {"a": 'x\n"[y]"'})
+
+
+class ListTest(unittest.TestCase):
+    def test_trailing_comma_and_nesting(self):
+        self.assertEqual(loads("a = [1, [2, 'x'], ]\n"), {"a": [1, [2, "x"]]})
+
+    def test_quote_inside_token_is_ordinary(self):
+        self.assertEqual(loads("a = [it's]\n"), {"a": ["it's"]})
+
+    def test_comment_inside_list(self):
+        self.assertEqual(loads('a = [ 1, # first\n  "#x" ] # end\n'), {"a": [1, "#x"]})
+
+    def test_bad_lists(self):
+        for text in ["a = [,]\n", "a = [1,,2]\n", "a = [\"x\" \"y\"]\n", "a = [[1][2]]\n", "a = [1]x\n", "a = [a[b]]\n", "a = [1]#c\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid list"))
+
+    def test_unterminated_list(self):
+        self.assertTrue(error_of("a = [1,\n  2,\n").message.startswith("unterminated list"))
+
+
+class SectionTest(unittest.TestCase):
+    def test_spaces_in_header_and_comment(self):
+        self.assertEqual(loads("[ a.b ]   ; c\nk = 1\n"), {"a": {"b": {"k": 1}}})
+
+    def test_empty_section(self):
+        self.assertEqual(loads("[a]\n[b]\n"), {"a": {}, "b": {}})
+
+    def test_invalid_header(self):
+        for text in ["[a]x\n", "[a]#c\n", "[a..b]\n", "[1a]\n", "[a\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid section header"))
+
+    def test_implicit_table_is_not_a_duplicate(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_key_conflicts(self):
+        self.assertTrue(error_of("a = 1\na.b = 2\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a.b = 1\na = 2\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a = 1\n[a]\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("[a.b]\nc = 1\n[a]\nb = 2\n").message.startswith("key conflict"))
+
+    def test_dotted_key_and_header_collide_as_duplicate(self):
+        exc = error_of("[a]\nb.c = 1\n[a.b]\nc = 2\n")
+        self.assertTrue(exc.message.startswith("duplicate key"))
+        self.assertEqual(exc.lineno, 4)
+
+
+class LineTest(unittest.TestCase):
+    def test_crlf_and_cr_line_endings(self):
+        self.assertEqual(loads("a = 1\r\n[s]\rb = 2\r"), {"a": 1, "s": {"b": 2}})
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+    def test_comment_inside_multiline_value(self):
+        self.assertEqual(loads("a =\n  x\n  # note\n\n  y # c\n"), {"a": "x\ny"})
+
+    def test_continuation_without_value(self):
+        for text in ["  x = 1\n", "[a]\n  b\n"]:
+            with self.subTest(text=text):
+                msg = error_of(text, base_dir=".").message
+                self.assertTrue(msg.startswith("continuation without a value"), msg)
+
+    def test_invalid_line(self):
+        self.assertTrue(error_of("just words\n").message.startswith("invalid line"))
+        self.assertTrue(error_of("@includes \"x\"\n", base_dir=".").message.startswith("invalid line"))
+
+    def test_error_source_and_str(self):
+        exc = error_of("a = 1\n\n???\n", source="cfg/x.ini")
+        self.assertEqual(str(exc), "cfg/x.ini:3: invalid line")
+        self.assertEqual(exc.source, "cfg/x.ini")
+
+
+class IncludeTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def write(self, name, text):
+        path = os.path.join(self.tmp.name, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_needs_base_dir(self):
+        exc = error_of('@include "x.ini"\n')
+        self.assertTrue(exc.message.startswith("include needs a base directory"))
+
+    def test_include_starts_at_top_level_and_main_resumes_section(self):
+        self.write("part.ini", "[inner]\nv = 1\n")
+        main = self.write("main.ini", "[s]\n@include 'part.ini'  # c\nk = 2\n")
+        self.assertEqual(load(main), {"s": {"k": 2}, "inner": {"v": 1}})
+
+    def test_include_path_relative_to_including_file(self):
+        self.write("sub/leaf.ini", "z = 9\n")
+        self.write("sub/mid.ini", '@include "leaf.ini"\n')
+        main = self.write("main.ini", '@include "sub/mid.ini"\n')
+        self.assertEqual(load(main), {"z": 9})
+
+    def test_error_in_included_file_uses_its_source(self):
+        self.write("sub/bad.ini", "x = 1\nbroken line\n")
+        main = self.write("main.ini", '@include "sub/bad.ini"\n')
+        exc = None
+        try:
+            load(main)
+        except ParseError as caught:
+            exc = caught
+        self.assertIsNotNone(exc)
+        self.assertEqual(exc.lineno, 2)
+        self.assertEqual(exc.source, os.path.join(self.tmp.name, "sub", "bad.ini"))
+        self.assertTrue(exc.message.startswith("invalid line"))
+
+    def test_cannot_read_include(self):
+        main = self.write("main.ini", '@include "missing.ini"\n')
+        self.assertTrue(
+            _catch(lambda: load(main)).message.startswith("cannot read include")
+        )
+
+    def test_continuation_after_include(self):
+        self.write("ok.ini", "v = 1\n")
+        main = self.write("main.ini", '@include "ok.ini"\n  y\n')
+        self.assertTrue(_catch(lambda: load(main)).message.startswith("continuation without a value"))
+
+    def test_self_include_is_a_cycle(self):
+        main = self.write("self.ini", '@include "self.ini"\n')
+        self.assertTrue(_catch(lambda: load(main)).message.startswith("include cycle"))
+
+    def test_same_file_twice_is_duplicates_not_cycle(self):
+        self.write("common.ini", "x = 1\n")
+        main = self.write("main.ini", '@include "common.ini"\n@include "common.ini"\n')
+        exc = _catch(lambda: load(main))
+        self.assertTrue(exc.message.startswith("duplicate key"))
+
+    def test_invalid_include(self):
+        self.assertTrue(error_of("@include x.ini\n", base_dir=".").message.startswith("invalid include"))
+
+    def test_missing_top_level_file_is_oserror(self):
+        with self.assertRaises(OSError):
