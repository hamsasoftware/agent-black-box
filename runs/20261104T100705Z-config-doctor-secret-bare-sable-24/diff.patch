+def parse_dotenv_line(line):
+    """Return (key, value) for an assignment line, or None for blanks, comments and non-assignments."""
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if line.startswith("export") and line[len("export"):len("export") + 1].isspace():
+        line = line[len("export"):].lstrip()
+    if "=" not in line:
