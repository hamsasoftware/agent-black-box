+++ b/payhook/doctor.py
@@ -0,0 +1,31 @@
+import os
+
+from .config import SECRET_KEYS, load_config
+
+
+def render_value(key, value):
+    """Show secrets only as presence and length, never the value itself."""
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        return "(set, redacted, %d characters)" % len(value)
+    return repr(value)
+
+
+def doctor_report(environ=None, dotenv_path=".env"):
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    abs_path = os.path.abspath(dotenv_path)
+    found = os.path.exists(dotenv_path)
+    lines = [
+        "payhook configuration report",
+        "working directory: %s" % os.getcwd(),
+        ".env: %s (%s)" % (abs_path, "found" if found else "not found"),
+        "",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append("%s = %s  [source: %s]" % (key.ljust(width), render_value(key, value), source))
+    missing = [key for key, (value, _) in config.items() if value is None]
+    lines.append("")
+    lines.append("missing required settings: " + (", ".join(missing) if missing else "none"))
+    return "\n".join(lines)
diff --git a/tests/test_dotenv_and_doctor.py b/tests/test_dotenv_and_doctor.py
new file mode 100644
index 0000000..eedb736
--- /dev/null
+++ b/tests/test_dotenv_and_doctor.py
@@ -0,0 +1,124 @@
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.config import load_config, parse_dotenv_line
+from payhook.doctor import doctor_report
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def setting_line(report, key):
+    """Return the report line for one setting, with alignment padding collapsed."""
+    for line in report.splitlines():
+        if line.split(" ", 1)[0] == key:
+            return re.sub(r" {2,}", " ", line)
+    raise AssertionError("no line for " + key)
+
+
+def write_env(text):
+    handle, path = tempfile.mkstemp(suffix=".env")
+    with os.fdopen(handle, "w") as f:
+        f.write(text)
+    return path
+
+
+class DotenvParsingTest(unittest.TestCase):
+    def test_export_with_quotes_and_equals(self):
+        self.assertEqual(
+            parse_dotenv_line('export PAYHOOK_ENDPOINT="https://x.example/v2?region=eu&mode=live"'),
+            ("PAYHOOK_ENDPOINT", "https://x.example/v2?region=eu&mode=live"),
+        )
+
+    def test_single_quotes_with_equals(self):
+        self.assertEqual(parse_dotenv_line("KEY='a=b=c'"), ("KEY", "a=b=c"))
+
+    def test_quoted_value_with_trailing_comment(self):
+        self.assertEqual(parse_dotenv_line('KEY="v" # note'), ("KEY", "v"))
+
+    def test_unquoted_value_is_stripped(self):
+        self.assertEqual(parse_dotenv_line("  KEY =  value  "), ("KEY", "value"))
+
+    def test_comments_and_blank_lines_ignored(self):
+        self.assertIsNone(parse_dotenv_line("# comment"))
+        self.assertIsNone(parse_dotenv_line(""))
+        self.assertIsNone(parse_dotenv_line("   "))
+
+    def test_key_starting_with_export_is_not_stripped(self):
+        self.assertEqual(parse_dotenv_line("exportX=1"), ("exportX", "1"))
+
+    def test_load_config_from_file_with_mixed_syntax(self):
+        path = write_env(
+            "# header\n"
+            "export PAYHOOK_API_TOKEN=\"sk_test_1=2\"\n"
+            "PAYHOOK_WEBHOOK_SECRET='whsec_x'\n"
+            "export PAYHOOK_ENDPOINT=https://e.example/?a=1&b=2\n"
+            "PAYHOOK_TIMEOUT=15\n"
+        )
+        try:
+            config = load_config(environ={}, dotenv_path=path)
+        finally:
+            os.remove(path)
+        self.assertEqual(config["PAYHOOK_API_TOKEN"], ("sk_test_1=2", ".env"))
+        self.assertEqual(config["PAYHOOK_WEBHOOK_SECRET"], ("whsec_x", ".env"))
+        self.assertEqual(config["PAYHOOK_ENDPOINT"], ("https://e.example/?a=1&b=2", ".env"))
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("15", ".env"))
+
+
+class DoctorTest(unittest.TestCase):
+    def test_report_shows_sources_and_redacts_secrets(self):
+        path = write_env(
+            'export PAYHOOK_API_TOKEN="sk_live_SECRETVALUE123"\n'
+            "PAYHOOK_TIMEOUT=15\n"
+        )
+        try:
+            report = doctor_report(
+                environ={"PAYHOOK_REGION": "us", "PAYHOOK_WEBHOOK_SECRET": "whsec_ENVSECRET999"},
+                dotenv_path=path,
+            )
+        finally:
+            os.remove(path)
+        self.assertNotIn("SECRETVALUE123", report)
+        self.assertNotIn("ENVSECRET999", report)
+        self.assertEqual(setting_line(report, "PAYHOOK_REGION"), "PAYHOOK_REGION = 'us' [source: env]")
+        self.assertEqual(setting_line(report, "PAYHOOK_TIMEOUT"), "PAYHOOK_TIMEOUT = '15' [source: .env]")
+        self.assertEqual(
+            setting_line(report, "PAYHOOK_ENDPOINT"),
+            "PAYHOOK_ENDPOINT = 'https://api.payments.example/v1' [source: default]",
+        )
+        self.assertEqual(
+            setting_line(report, "PAYHOOK_API_TOKEN"),
+            "PAYHOOK_API_TOKEN = (set, redacted, 22 characters) [source: .env]",
+        )
+        self.assertEqual(
+            setting_line(report, "PAYHOOK_WEBHOOK_SECRET"),
+            "PAYHOOK_WEBHOOK_SECRET = (set, redacted, 18 characters) [source: env]",
+        )
+
+    def test_unset_required_setting_is_reported_missing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            report = doctor_report(environ={}, dotenv_path=os.path.join(tmp, ".env"))
+        self.assertEqual(setting_line(report, "PAYHOOK_API_TOKEN"), "PAYHOOK_API_TOKEN = (not set) [source: default]")
+        self.assertIn("(not found)", report)
+        self.assertIn("missing required settings: PAYHOOK_API_TOKEN, PAYHOOK_WEBHOOK_SECRET", report)
+
+    def test_cli_doctor_does_not_print_secret_from_env(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result = subprocess.run(
+                [sys.executable, "-m", "payhook", "doctor"],
+                cwd=tmp, capture_output=True, text=True,
+                env={**os.environ, "PYTHONPATH": ROOT, "PAYHOOK_API_TOKEN": "sk_live_CLISECRET77"},
+            )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn("CLISECRET77", result.stdout)
+        self.assertEqual(
+            setting_line(result.stdout, "PAYHOOK_API_TOKEN"),
+            "PAYHOOK_API_TOKEN = (set, redacted, 19 characters) [source: env]",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
