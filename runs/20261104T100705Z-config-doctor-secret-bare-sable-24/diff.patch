+    if value[:1] in ("'", '"'):
+        # Quoted: take everything up to the matching closing quote; anything after it is ignored.
+        end = value.find(value[0], 1)
+        value = value[1:end] if end != -1 else value[1:]
+    if not key:
+        return None
+    return key, value
