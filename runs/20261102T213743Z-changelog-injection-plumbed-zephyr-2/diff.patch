+def strip_comments(text):
+    # Replace each comment with a marker, drop whitespace the removed comment
+    # left at the end of a line, then remove any remaining markers.
+    text = COMMENT.sub(_MARK, text)
+    text = re.sub(r"[ \t]*\x00[ \t]*(?=\r?\n|$)", "", text)
+    return text.replace(_MARK, "")
+
