+def _unquote(value):
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
+        return value[1:-1]
+    return value
+
+
+def redact(key, value):
+    """Mask secret values, keeping a short prefix so the key type is identifiable."""
+    if value is None or key not in SECRET_KEYS:
+        return value
+    return value[:3] + "****" if len(value) > 8 else "****"
+
