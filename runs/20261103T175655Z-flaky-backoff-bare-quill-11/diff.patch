+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedRng:
+    """Stands in for random.Random and always returns the same jitter factor."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def uniform(self, a, b):
+        return self.value
+
+
+class CapTest(unittest.TestCase):
+    def test_jitter_at_maximum_never_exceeds_cap(self):
+        # Before the fix, cap * (1 + jitter) was returned here.
+        delay = compute_delay(7, base=0.5, cap=34, jitter=0.1, rng=_FixedRng(1.1))
+        self.assertEqual(delay, 34)
+
+    def test_capped_attempts_are_bounded_for_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertGreaterEqual(delay, 0)
+                self.assertLessEqual(delay, 34)
+
+    def test_delay_never_negative(self):
+        delay = compute_delay(1, base=0.5, cap=30, jitter=1.0, rng=_FixedRng(0.0))
+        self.assertEqual(delay, 0.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
