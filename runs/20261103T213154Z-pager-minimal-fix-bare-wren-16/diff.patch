+import unittest
+
+from shopapi.listing import getPageCount
+
+
+class PageCountRegressionTest(unittest.TestCase):
+    def test_partial_last_page_is_counted(self):
+        self.assertEqual(getPageCount(237, 50), 5)
+
+    def test_single_partial_page(self):
+        self.assertEqual(getPageCount(1, 50), 1)
+
+    def test_one_over_multiple(self):
+        self.assertEqual(getPageCount(101, 50), 3)
+
+    def test_zero_items(self):
+        self.assertEqual(getPageCount(0, 50), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
