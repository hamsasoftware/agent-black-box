+"""Configuration parser for the format described in docs/FORMAT.md."""
+import os
+import re
+import string
 
 from .errors import ParseError
 
 
+class _ValueErr(Exception):
+    """A value-level error. The caller reports it at the line of the key."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_NAME_CHARS = string.ascii_letters + string.digits + "_-"
+_ENTRY_RE = re.compile(rf"({_NAME}(?:\.{_NAME})*)[ \t]*=")
+_HEADER_RE = re.compile(rf"\[[ \t]*({_NAME}(?:\.{_NAME})*)[ \t]*\](?:[ \t]*|[ \t]+[#;].*)")
+_TAIL_COMMENT_RE = re.compile(r"[ \t]+[#;].*")
+_NEWLINE_RE = re.compile(r"\r\n|\r|\n")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_INT_PREFIXED_RE = re.compile(
+    r"[+-]?0(?:[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*"
+    r"|[oO][0-7](?:_?[0-7])*"
+    r"|[bB][01](?:_?[01])*)"
+)
+_FLOAT_RE = re.compile(
+    rf"[+-]?(?:(?:{_DIGITS}\.(?:{_DIGITS})?|\.{_DIGITS})(?:[eE][+-]?[0-9]+)?"
+    rf"|{_DIGITS}[eE][+-]?[0-9]+)"
+)
+
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX_DIGITS = "0123456789abcdefABCDEF"
+
+
+class _State:
+    def __init__(self):
+        self.result = {}
+        self.sections = set()
+
+
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    state = _State()
+    _parse(state, text, source, base_dir, ())
+    return state.result
 
 
 def load(path):
     with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+        text = handle.read()
+    state = _State()
+    _parse(state, text, path, os.path.dirname(path), (os.path.realpath(path),))
+    return state.result
+
+
+# ---------------------------------------------------------------- documents
+
+def _parse(state, text, source, base_dir, chain):
+    """Parse one file's text into ``state``. ``chain`` holds the real paths of the files being included."""
+    if text.startswith("﻿"):
+        text = text[1:]
+    lines = _NEWLINE_RE.split(text)
+    section = state.result
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        lineno = i + 1
+        stripped = line.lstrip(" \t")
+        if not stripped or stripped[0] in "#;":
+            i += 1
+            continue
+        if line[0] in " \t":
+            raise ParseError("continuation without a value", lineno, source)
+        if line[0] == "[":
+            match = _HEADER_RE.fullmatch(line)
+            if match is None:
+                raise ParseError("invalid section header", lineno, source)
+            name = match.group(1)
+            parts = name.split(".")
+            key = tuple(parts)
+            if key in state.sections:
+                raise ParseError(f"duplicate section '{name}'", lineno, source)
+            section = _table(state.result, parts, name, lineno, source)
+            state.sections.add(key)
+            i += 1
+            continue
+        if line.startswith("@include") and (len(line) == 8 or line[8] not in _NAME_CHARS):
+            _include(state, line, lineno, source, base_dir, chain)
+            i += 1
+            continue
+        match = _ENTRY_RE.match(line)
+        if match is None:
+            raise ParseError("invalid line", lineno, source)
+        conts = []
+        j = i + 1
+        while j < len(lines):
+            nxt = lines[j]
+            nxt_stripped = nxt.lstrip(" \t")
+            if not nxt_stripped or nxt_stripped[0] in "#;":
+                j += 1
+                continue
+            if nxt[0] not in " \t":
+                break
+            conts.append(nxt)
+            j += 1
+        i = j
+        try:
+            value = _parse_value(line, match.end() - 1, conts)
+        except _ValueErr as exc:
+            raise ParseError(exc.message, lineno, source) from None
+        _store(section, match.group(1), value, lineno, source)
+
+
+def _table(node, parts, name, lineno, source):
+    """Return the table at ``parts`` below ``node``, creating missing tables on the way."""
+    for part in parts:
+        if part not in node:
+            node[part] = {}
+        if not isinstance(node[part], dict):
+            raise ParseError(f"key conflict '{name}'", lineno, source)
+        node = node[part]
+    return node
+
+
+def _store(section, name, value, lineno, source):
+    parts = name.split(".")
+    node = _table(section, parts[:-1], name, lineno, source)
+    last = parts[-1]
+    if last in node:
+        if isinstance(node[last], dict):
+            raise ParseError(f"key conflict '{name}'", lineno, source)
+        raise ParseError(f"duplicate key '{name}'", lineno, source)
+    node[last] = value
+
+
+def _include(state, line, lineno, source, base_dir, chain):
+    rest = line[len("@include"):]
+    if not rest or rest[0] not in " \t":
+        raise ParseError("invalid include", lineno, source)
+    text = rest.lstrip(" \t")
+    if not text or text[0] not in "\"'":
+        raise ParseError("invalid include", lineno, source)
+    try:
+        path, end = _parse_string(text, 0)
+    except _ValueErr:
+        raise ParseError("invalid include", lineno, source) from None
+    tail = text[end:]
+    if tail.strip(" \t") and not _TAIL_COMMENT_RE.fullmatch(tail):
+        raise ParseError("invalid include", lineno, source)
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    target = os.path.join(base_dir, path)
+    real = os.path.realpath(target)
+    if real in chain:
+        raise ParseError(f"include cycle '{path}'", lineno, source)
+    try:
+        with open(target, encoding="utf-8") as handle:
+            body = handle.read()
+    except (OSError, UnicodeError) as exc:
+        raise ParseError(f"cannot read include '{path}': {exc}", lineno, source) from None
+    _parse(state, body, os.path.normpath(target), os.path.dirname(target), chain + (real,))
+
+
+# ------------------------------------------------------------------ values
+
+def _comment_start(line, start):
+    """Index of the inline comment in ``line`` at or after ``start``, or ``len(line)``."""
+    for i in range(start, len(line)):
+        if line[i] in "#;" and (i == 0 or line[i - 1] in " \t"):
+            return i
+    return len(line)
+
+
+def _skip(text, pos):
+    """Skip whitespace (including newlines) and comments, as allowed between list items."""
+    n = len(text)
+    while pos < n:
+        c = text[pos]
+        if c in " \t\n":
+            pos += 1
+        elif c in "#;" and (pos == 0 or text[pos - 1] in " \t\n"):
+            end = text.find("\n", pos)
+            pos = n if end == -1 else end
+        else:
+            break
+    return pos
+
+
+def _parse_value(line, eq, conts):
+    """Return the Python value of the entry whose '=' is at ``line[eq]``, with continuation lines ``conts``."""
+    cs = _comment_start(line, eq + 1)
+    head = line[eq + 1:cs].strip(" \t")
+    if head:
+        first = head[0]
+    elif conts:
+        first = conts[0].lstrip(" \t")[0]
+    else:
+        first = ""
+
+    if first == "[":
+        text = "\n".join([line[eq + 1:]] + conts)
+        pos = _skip(text, 0)
+        items, pos = _parse_list(text, pos)
+        if _skip(text, pos) != len(text):
+            raise _ValueErr("invalid list")
+        return items
+
+    if first in ("'", '"'):
+        text = "\n".join([line[eq + 1:]] + conts)
+        pos = _skip(text, 0)
+        value, pos = _parse_string(text, pos)
+        j = pos
+        while j < len(text) and text[j] in " \t":
+            j += 1
+        if j < len(text) and text[j] in "#;" and text[j - 1] in " \t":
+            j = text.find("\n", j)
+            if j == -1:
+                j = len(text)
+        if j < len(text):
+            raise _ValueErr("unexpected text after string")
+        return value
+
+    pieces = []
+    if head:
+        pieces.append(head)
+    for cont in conts:
+        piece = cont[:_comment_start(cont, 0)].strip(" \t")
+        if piece:
+            pieces.append(piece)
+    if not pieces:
+        return ""
+    if len(pieces) == 1:
+        return _scalar(pieces[0])
+    return "\n".join(pieces)
+
+
+def _parse_string(text, pos):
+    """Parse the quoted string starting at ``text[pos]``. Return (value, index after the closing quote)."""
+    quote = text[pos]
+    n = len(text)
+    i = pos + 1
+    out = []
+    while True:
+        if i >= n or text[i] == "\n":
+            raise _ValueErr("unterminated string")
+        c = text[i]
+        if c == quote:
+            return "".join(out), i + 1
+        if quote == '"' and c == "\\":
+            if i + 1 >= n or text[i + 1] == "\n":
+                raise _ValueErr("unterminated string")
+            esc = text[i + 1]
+            if esc == "u":
+                digits = text[i + 2:i + 6]
+                if len(digits) != 4 or any(d not in _HEX_DIGITS for d in digits):
+                    raise _ValueErr("invalid escape '\\u'")
+                out.append(chr(int(digits, 16)))
+                i += 6
+                continue
+            if esc in _ESCAPES:
+                out.append(_ESCAPES[esc])
+                i += 2
+                continue
+            raise _ValueErr(f"invalid escape '\\{esc}'")
+        out.append(c)
+        i += 1
+
+
+def _parse_list(text, pos):
+    """Parse the list whose '[' is at ``text[pos]``. Return (items, index after the closing bracket)."""
+    n = len(text)
+    pos += 1
+    items = []
+    want_item = True
+    while True:
+        pos = _skip(text, pos)
+        if pos >= n:
+            raise _ValueErr("unterminated list")
+        c = text[pos]
+        if c == "]":
+            return items, pos + 1
+        if c == ",":
+            if want_item:
+                raise _ValueErr("invalid list")
+            want_item = True
+            pos += 1
+            continue
+        if not want_item:
+            raise _ValueErr("invalid list")
+        if c in "'\"":
+            item, pos = _parse_string(text, pos)
+        elif c == "[":
+            item, pos = _parse_list(text, pos)
+        else:
+            start = pos
+            while pos < n and text[pos] not in ",]\n[":
+                if text[pos] in "#;" and text[pos - 1] in " \t":
+                    break
+                pos += 1
+            if pos < n and text[pos] == "[":
+                raise _ValueErr("invalid list")
+            token = text[start:pos].strip(" \t")
+            if not token:
+                raise _ValueErr("invalid list")
+            item = _scalar(token)
+        items.append(item)
+        want_item = False
+
+
+def _scalar(text):
+    if text.isascii() and text.lower() in ("true", "false"):
+        return text.lower() == "true"
+    if _INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 10)
+    if _INT_PREFIXED_RE.fullmatch(text):
+        return int(text.replace("_", ""), 0)
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
