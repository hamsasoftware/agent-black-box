+class IncludeTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def write(self, name, text):
+        path = os.path.join(self.tmp.name, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_returns_to_its_section(self):
+        self.write("part.ini", "inner = 1\n")
+        main = self.write("main.ini", "[s]\nbefore = 1\n@include 'part.ini'  # note\nafter = 2\n")
+        self.assertEqual(load(main), {"s": {"before": 1, "after": 2}, "inner": 1})
+
+    def test_include_path_resolved_against_including_file(self):
+        self.write("sub/leaf.ini", "leaf = yes\n")
+        self.write("sub/mid.ini", '@include "leaf.ini"\n')
+        main = self.write("main.ini", '@include "sub/mid.ini"\n')
+        self.assertEqual(load(main), {"leaf": "yes"})
+
+    def test_duplicate_across_include(self):
+        self.write("other.ini", "x = 1\n")
+        main = self.write("main.ini", 'x = 0\n@include "other.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+        self.assertTrue(ctx.exception.source.endswith("other.ini"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_error_in_include_has_its_own_source_and_line(self):
+        self.write("bad.ini", "ok = 1\nbad = [1,,]\n")
+        main = self.write("main.ini", "a = 1\n@include \"bad.ini\"\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertEqual(ctx.exception.source, os.path.normpath(os.path.join(self.tmp.name, "bad.ini")))
+
+    def test_self_include_is_a_cycle(self):
+        main = self.write("self.ini", '@include "self.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("include cycle"))
+
+    def test_same_file_twice_is_not_a_cycle(self):
+        self.write("shared.ini", "v = 1\n")
+        self.write("left.ini", '@include "shared.ini"\n')
+        main = self.write("main.ini", '@include "left.ini"\n@include "shared.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+
+    def test_missing_include(self):
+        main = self.write("main.ini", '@include "nope.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("cannot read include"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_include_without_base_dir(self):
+        err = error_of('@include "x.ini"\n')
+        self.assertTrue(err.message.startswith("include needs a base directory"))
+
+    def test_loads_with_base_dir(self):
+        self.write("x.ini", "x = 5\n")
+        self.assertEqual(loads('@include "x.ini"\n', base_dir=self.tmp.name), {"x": 5})
+
+    def test_invalid_include_forms(self):
+        for text in ("@include\n", "@include x.ini\n", "@include \"x.ini\n", "@include \"x.ini\" y\n",
+                     "@include \"x.ini\"# c\n", "@include \"a\\q\"\n"):
+            with self.subTest(text=text):
+                err = error_of(text, base_dir=self.tmp.name)
+                self.assertTrue(err.message.startswith("invalid include"))
+
+    def test_includes_is_invalid_line(self):
+        self.assertTrue(error_of('@includes "x"\n', base_dir=self.tmp.name).message.startswith("invalid line"))
+
+    def test_bom_in_included_file(self):
+        with open(os.path.join(self.tmp.name, "bom.ini"), "w", encoding="utf-8") as handle:
+            handle.write("\ufeffb = 2\n")
+        self.assertEqual(loads('@include "bom.ini"\n', base_dir=self.tmp.name), {"b": 2})
+
