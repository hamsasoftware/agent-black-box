+"""Tests for the parts of docs/FORMAT.md that tests/test_parse.py does not cover."""
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def error_of(text, **kwargs):
+    """Return the ParseError that loads(text) raises; fail if it does not raise one."""
+    try:
+        loads(text, **kwargs)
+    except ParseError as exc:
+        return exc
+    raise AssertionError(f"no ParseError for {text!r}")
+
+
+class LineTest(unittest.TestCase):
+    def test_line_endings(self):
+        self.assertEqual(loads("a = 1\r\nb = 2\rc = 3\n"), {"a": 1, "b": 2, "c": 3})
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+    def test_continuation_without_value(self):
+        for text in ("  x = 1\n", "[a]\n  x = 1\n"):
+            with self.subTest(text=text):
+                err = error_of(text)
+                self.assertTrue(err.message.startswith("continuation without a value"))
+        self.assertEqual(error_of("[a]\n  x = 1\n").lineno, 2)
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, "x.ini"), "w", encoding="utf-8") as handle:
+                handle.write("z = 1\n")
+            err = error_of('@include "x.ini"\n  y = 1\n', base_dir=tmp)
+        self.assertTrue(err.message.startswith("continuation without a value"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_invalid_line_and_header(self):
+        self.assertTrue(error_of("just words\n").message.startswith("invalid line"))
+        self.assertTrue(error_of("[a\n").message.startswith("invalid section header"))
+        self.assertTrue(error_of("[a] junk\n").message.startswith("invalid section header"))
+        self.assertTrue(error_of("[a]#c\n").message.startswith("invalid section header"))
+
+
+class SectionTest(unittest.TestCase):
+    def test_spaces_inside_brackets_and_comment_after(self):
+        self.assertEqual(loads("[ a.b ]  ; c\nk = 1\n"), {"a": {"b": {"k": 1}}})
+
+    def test_empty_section(self):
+        self.assertEqual(loads("[a]\n[b]\n"), {"a": {}, "b": {}})
+
+    def test_dotted_header_then_plain_header_is_fine(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_dotted_key_does_not_define_section(self):
+        self.assertEqual(loads("[a]\nb.c = 1\n[a.b]\nd = 2\n"), {"a": {"b": {"c": 1, "d": 2}}})
+
+    def test_key_conflicts(self):
+        self.assertTrue(error_of("a = 1\n[a]\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a = 1\n[a.b]\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a = 1\na.b = 2\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a.b = 1\na = 2\n").message.startswith("key conflict"))
+
+
+class ValueScalarTest(unittest.TestCase):
+    def test_bool_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\nc = tRuE\n"), {"a": True, "b": False, "c": True})
+
+    def test_int_forms(self):
+        self.assertEqual(
+            loads("a = +7\nb = -0\nc = 1_000\nd = -0b101\ne = 0o17\nf = 0XfF\n"),
+            {"a": 7, "b": 0, "c": 1000, "d": -5, "e": 15, "f": 255},
+        )
+
+    def test_float_forms(self):
+        self.assertEqual(
+            loads("a = 1.5\nb = .5\nc = 5.\nd = 1e3\ne = -2.5E-3\nf = 1_0.2\ng = 00.5\nh = 007e1\n"),
+            {"a": 1.5, "b": 0.5, "c": 5.0, "d": 1000.0, "e": -0.0025, "f": 10.2, "g": 0.5, "h": 70.0},
+        )
+
+    def test_strings_that_look_numeric(self):
+        text = "a = 007\nb = 1__0\nc = _1\nd = inf\ne = nan\nf = yes\ng = 1.2.3\nh = 0x\ni = 1e\nj = +\nk = .\n"
+        result = loads(text)
+        self.assertEqual(result, {
+            "a": "007", "b": "1__0", "c": "_1", "d": "inf", "e": "nan", "f": "yes",
+            "g": "1.2.3", "h": "0x", "i": "1e", "j": "+", "k": ".",
+        })
+
+    def test_empty_value(self):
+        self.assertEqual(loads("a =\nb = # only a comment\nc =\n  # comment\n"), {"a": "", "b": "", "c": ""})
+
+    def test_quoted_string_is_never_converted(self):
+        self.assertEqual(loads('a = "42"\nb = \'true\'\n'), {"a": "42", "b": "true"})
+
+    def test_string_escapes(self):
+        self.assertEqual(loads('a = "q\\"x\\\\y\\n\\r\\0\\u0041"\n')["a"], 'q"x\\y\n\r\x00A')
+
+    def test_invalid_escape_and_unterminated(self):
+        self.assertTrue(error_of('a = "\\q"\n').message.startswith("invalid escape"))
+        self.assertTrue(error_of('a = "\\u41"\n').message.startswith("invalid escape"))
+        self.assertTrue(error_of('a = "abc\\\n').message.startswith("unterminated string"))
+        self.assertTrue(error_of("a = 'open\n").message.startswith("unterminated string"))
+
+    def test_unexpected_text_after_string(self):
+        self.assertTrue(error_of('a = "x" y\n').message.startswith("unexpected text after string"))
+        self.assertTrue(error_of('a = "x"#c\n').message.startswith("unexpected text after string"))
+        self.assertEqual(loads('a = "x"   # ok\n'), {"a": "x"})
+
+    def test_multiline_quoted_string_is_an_error(self):
+        err = error_of('a = "x"\n   more\n')
+        self.assertTrue(err.message.startswith("unexpected text after string"))
+        self.assertEqual(err.lineno, 1)
+
+    def test_plain_multiline_keeps_quotes_and_brackets(self):
+        self.assertEqual(loads('a = x "y"\n   [z]\n'), {"a": 'x "y"\n[z]'})
+
+    def test_plain_comment_rules(self):
+        self.assertEqual(loads("a = x;y # c\n"), {"a": "x;y"})
+        self.assertEqual(loads("a =#c\n"), {"a": "#c"})
+
+
+class ListTest(unittest.TestCase):
+    def test_trailing_comma_and_nesting(self):
+        self.assertEqual(loads("a = [1, [2, 'x'], ]\n"), {"a": [1, [2, "x"]]})
+
+    def test_quote_inside_unquoted_item_is_ordinary(self):
+        self.assertEqual(loads("a = [it's]\n"), {"a": ["it's"]})
+
+    def test_items_are_scalars(self):
+        self.assertEqual(loads("a = [true, 0x1F, 2.5, text value]\n"), {"a": [True, 31, 2.5, "text value"]})
+
+    def test_comments_and_newlines_between_items(self):
+        text = "a = [\n  1,  # first\n  # whole line comment\n  2\n  ]\nb = 3\n"
+        self.assertEqual(loads(text), {"a": [1, 2], "b": 3})
+
+    def test_column_zero_bracket_ends_the_entry(self):
+        self.assertTrue(error_of("a = [\n  1\n]\n").message.startswith("unterminated list"))
+
+    def test_unquoted_item_may_contain_spaces(self):
+        self.assertEqual(loads('a = [1 2 "x"]\n'), {"a": ['1 2 "x"']})
+
+    def test_invalid_lists(self):
+        for text in ("a = [,]\n", "a = [1,,2]\n", "a = [\"x\" \"y\"]\n", "a = [1] x\n", "a = [1[2]]\n", 'a = ["a"b]\n'):
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid list"))
+
+    def test_unterminated_list(self):
+        self.assertTrue(error_of("a = [1, 2\n").message.startswith("unterminated list"))
+        self.assertTrue(error_of("a = [1, 2\n  3\n").message.startswith("invalid list"))
+
+    def test_unterminated_string_in_list(self):
+        self.assertTrue(error_of('a = ["x]\n').message.startswith("unterminated string"))
+
+    def test_value_error_reported_at_key_line(self):
+        err = error_of("a = 1\nb = [1,\n  2,,\n  3]\n")
+        self.assertEqual(err.lineno, 2)
+        self.assertTrue(err.message.startswith("invalid list"))
