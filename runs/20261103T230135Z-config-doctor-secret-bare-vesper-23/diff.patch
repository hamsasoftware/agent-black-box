index 6d91a58..79033d4 100644
--- a/payhook/config.py
+++ b/payhook/config.py
@@ -18,11 +18,37 @@ def read_dotenv(path):
             line = line.strip()
             if not line or line.startswith("#"):
                 continue
-            key, value = line.split("=")
+            if line.startswith("export") and line[6:7].isspace():
+                line = line[6:].lstrip()
+            if "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            key = key.strip()
+            value = value.strip()
+            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
+                value = value[1:-1]
+            else:
+                # unquoted: strip trailing inline comment
+                for i, ch in enumerate(value):
+                    if ch == "#" and i > 0 and value[i - 1].isspace():
+                        value = value[:i].rstrip()
+                        break
             values[key] = value
     return values
 
 
+SECRETS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def mask(key, value):
+    """Display form of a value; secrets never shown in full."""
+    if value is None:
+        return "(not set)"
+    if key in SECRETS:
+        return "****" + value[-4:] if len(value) > 12 else "****"
+    return value
+
+
 def load_config(environ=None, dotenv_path=".env"):
     environ = os.environ if environ is None else environ
     dotenv = read_dotenv(dotenv_path)
