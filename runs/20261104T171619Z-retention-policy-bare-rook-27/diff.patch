+"""Tests that pin the rules of docs/adr/ which tests/test_retention.py does not cover."""
+
+import unittest
+from datetime import datetime, timezone
+
+from vaultsnap import Plan, Policy, Snapshot, plan_retention
+from vaultsnap.retention import _zone_offset
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def snap(sid, stamp, tags=(), parent=None):
+    return Snapshot(sid, datetime.fromisoformat(stamp + "+00:00"), frozenset(tags), parent)
+
+
+class WindowTest(unittest.TestCase):
+    def test_window_alone_keeps_recent_and_prunes_the_rest(self):
+        # ADR-0006: 72h = 3 days. The 60-hour-old snapshot is in the window; the old one is not, and no bucket rule keeps it.
+        shots = [snap("new", "2026-03-20T00:00"), snap("mid", "2026-03-18T00:00"), snap("old", "2026-03-01T00:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=72), NOW)
+        self.assertEqual(plan, Plan(keep=["new", "mid"], prune=["old"]))
+
+    def test_exactly_at_the_window_edge_is_in_the_window(self):
+        # ADR-0006: "exactly that old is in the window": 48h before NOW is 2026-03-18T12:00.
+        shots = [snap("edge", "2026-03-18T12:00"), snap("past", "2026-03-18T11:59")]
+        plan = plan_retention(shots, Policy(keep_within_hours=48), NOW)
+        self.assertEqual(plan, Plan(keep=["edge"], prune=["past"]))
+
+    def test_window_snapshots_do_not_count_toward_bucket_rules(self):
+        # ADR-0009 (reverts ADR-0006's interaction): the window snapshot is set aside, so keep_daily=1 picks 03-18.
+        shots = [snap("w1", "2026-03-19T03:00"), snap("w2", "2026-03-18T03:00"), snap("w3", "2026-03-17T03:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=48, keep_daily=1), NOW)
+        self.assertEqual(plan, Plan(keep=["w1", "w2"], prune=["w3"]))
+
+
+class OverrideOrderTest(unittest.TestCase):
+    def test_expired_snapshot_is_pruned_even_when_a_rule_would_keep_it(self):
+        # ADR-0008 line 3: expired beats keep_last.
+        shots = [snap("e", "2026-03-19T03:00", ["scratch"]), snap("f", "2026-03-18T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=5, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=["f"], prune=["e"]))
+
+    def test_expired_snapshot_inside_the_window_is_pruned(self):
+        # ADR-0009: line 3 (expired) comes before line 4 (window).
+        shots = [snap("e", "2026-03-19T03:00", ["scratch"])]
+        plan = plan_retention(shots, Policy(keep_within_hours=48, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=[], prune=["e"]))
+
+    def test_protect_beats_expire(self):
+        # ADR-0008: a tag in both lists -> line 1 wins.
+        shots = [snap("p", "2026-03-10T03:00", ["release", "scratch"]), snap("q", "2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, protect_tags={"release"}, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=["q", "p"], prune=[]))
+
+    def test_protected_snapshot_does_not_count_toward_keep_last(self):
+        # ADR-0001 set-aside: protected snapshots are not counted by keep_last.
+        shots = [snap("p", "2026-03-12T03:00", ["release"]), snap("a", "2026-03-10T03:00"), snap("b", "2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan, Plan(keep=["p", "b"], prune=["a"]))
+
+    def test_empty_policy_still_prunes_expired(self):
+        # ADR-0008 "Empty policy".
+        shots = [snap("a", "2026-03-10T03:00", ["scratch"]), snap("b", "2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=["b"], prune=["a"]))
+
+    def test_snapshot_later_than_now_is_kept_and_not_counted(self):
+        # ADR-0001 set-aside: later than now -> kept, not counted.
+        shots = [snap("future", "2026-03-25T03:00"), snap("a", "2026-03-19T03:00"), snap("b", "2026-03-18T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=["future", "a"], prune=["b"]))
+
+
+class ParentTest(unittest.TestCase):
+    def test_kept_snapshot_holds_its_parent_chain_and_pruned_snapshot_holds_nothing(self):
+        # ADR-0007. P <- Q <- R are held by R (keep_last=1); X is pruned and does not hold Y.
+        shots = [
+            snap("P", "2026-03-05T03:00"),
+            snap("Q", "2026-03-10T03:00", parent="P"),
+            snap("R", "2026-03-19T03:00", parent="Q"),
+            snap("X", "2026-03-18T03:00", parent="Y"),
+            snap("Y", "2026-03-17T03:00"),
+        ]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=["R", "Q", "P"], prune=["X", "Y"]))
+
+    def test_expired_parent_is_held_by_a_kept_child(self):
+        # ADR-0007 overrides line 3 of ADR-0008.
+        shots = [snap("E", "2026-03-15T03:00", ["scratch"]), snap("R", "2026-03-19T03:00", parent="E")]
+        plan = plan_retention(shots, Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=["R", "E"], prune=[]))
+
+    def test_missing_parent_raises(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00", parent="ghost")], Policy(), NOW)
+
+    def test_self_parent_raises(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00", parent="a")], Policy(), NOW)
+
+    def test_cycle_raises(self):
+        shots = [snap("a", "2026-03-10T03:00", parent="b"), snap("b", "2026-03-11T03:00", parent="a")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(keep_last=1), NOW)
+
+
+class InputTest(unittest.TestCase):
+    def test_duplicate_ids_raise(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00"), snap("a", "2026-03-11T03:00")], Policy(), NOW)
+
+    def test_naive_now_raises(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00")], Policy(keep_last=1), datetime(2026, 3, 20, 12))
+
+    def test_same_taken_at_greater_id_is_newer(self):
+        # ADR-0001 "Ordering".
+        shots = [snap("a", "2026-03-10T03:00"), snap("b", "2026-03-10T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=["b"], prune=["a"]))
+
+
+class BucketTest(unittest.TestCase):
+    def test_weeks_are_iso_weeks_across_new_year(self):
+        # ADR-0003: 2025-12-29 and 2026-01-04 are both ISO week (2026, 1); 2026-01-05 is (2026, 2).
+        shots = [snap("a", "2025-12-29T03:00"), snap("b", "2026-01-04T03:00"), snap("c", "2026-01-05T03:00")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan, Plan(keep=["c", "b"], prune=["a"]))
+
+    def test_month_start_day_moves_the_monthly_cycle(self):
+        # ADR-0010: with month_start_day=15, 2026-01-10 is in the (2025, 12) cycle.
+        shots = [snap("a", "2026-01-10T03:00"), snap("b", "2026-01-20T03:00"), snap("c", "2025-12-20T03:00")]
+        plan = plan_retention(shots, Policy(keep_monthly=2, month_start_day=15), NOW)
+        self.assertEqual(plan, Plan(keep=["b", "a"], prune=["c"]))
+
+    def test_day_boundary_shifts_the_daily_buckets(self):
+        # ADR-0004: with day_start_hour=4, 01-01 03:30 belongs to 12-31; 01-01 05:00 to 01-01.
+        shots = [snap("a", "2026-01-01T03:30"), snap("b", "2025-12-31T12:00"), snap("c", "2026-01-01T05:00")]
+        plan = plan_retention(shots, Policy(keep_daily=2, day_start_hour=4), NOW)
+        self.assertEqual(plan, Plan(keep=["c", "a"], prune=["b"]))
+
+    def test_named_zone_offset_is_read_at_taken_at_and_ignores_tz_offset(self):
+        # ADR-0005: lakeside is +60 at 2026-03-28 (before its 03-29 01:00Z switch); tz_offset_minutes=-720 has no effect.
+        # Zone dates: w -> 03-29, x and y -> 03-28. Keep the newest of the two newest buckets: w and x.
+        shots = [snap("w", "2026-03-28T23:30"), snap("x", "2026-03-28T20:00"), snap("y", "2026-03-28T10:00")]
+        later = datetime.fromisoformat("2026-04-01T00:00:00+00:00")  # so that the snapshots are not later than now
+        plan = plan_retention(shots, Policy(zone="lakeside", tz_offset_minutes=-720, keep_daily=2), later)
+        self.assertEqual(plan, Plan(keep=["w", "x"], prune=["y"]))
+
+    def test_zone_offset_switches_at_the_row_instant(self):
+        # ADR-0005: at the exact instant of a row the new offset applies.
+        self.assertEqual(_zone_offset("lakeside", datetime(2026, 3, 29, 0, 59, tzinfo=timezone.utc)), 60)
+        self.assertEqual(_zone_offset("lakeside", datetime(2026, 3, 29, 1, 0, tzinfo=timezone.utc)), 120)
+        self.assertEqual(_zone_offset("harbor", datetime(2026, 4, 4, 16, 29, tzinfo=timezone.utc)), 630)
+        self.assertEqual(_zone_offset("harbor", datetime(2026, 4, 4, 16, 30, tzinfo=timezone.utc)), 570)
+        # Before the first row, the initial offset; after the last row, the last row's offset.
+        self.assertEqual(_zone_offset("harbor", datetime(2000, 1, 1, tzinfo=timezone.utc)), 630)
+        self.assertEqual(_zone_offset("lakeside", datetime(2040, 1, 1, tzinfo=timezone.utc)), 60)
+
+
+if __name__ == "__main__":
+    unittest.main()
