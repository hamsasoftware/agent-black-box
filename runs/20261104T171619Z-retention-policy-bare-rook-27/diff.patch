+def _check_aware(value, what):
+    if value.tzinfo is None or value.utcoffset() is None:
+        raise ValueError(f"{what} must be timezone-aware, got {value!r}")
+
+
+def _check_graph(by_id):
+    """ADR-0007: a parent must be a snapshot of the plan, and parents must not form a cycle."""
+    for snap in by_id.values():
+        if snap.parent is not None and snap.parent not in by_id:
+            raise ValueError(f"snapshot {snap.id!r} has parent {snap.parent!r}, which is not in the plan")
+    for snap in by_id.values():
+        seen = {snap.id}
+        cur = snap.parent
+        while cur is not None:
+            if cur in seen:
+                raise ValueError(f"parent cycle through snapshot {snap.id!r}")
+            seen.add(cur)
+            cur = by_id[cur].parent
+
+
+def _newer_key(snap):
+    # ADR-0001 "Ordering": later taken_at is newer; on a tie the greater id is newer.
+    return (snap.taken_at, snap.id)
+
+
+def _zone_offset(zone, instant_utc):
+    """ADR-0005: the offset in minutes that `zone` has at `instant_utc` (an aware UTC datetime)."""
+    initial, rows = ZONE_TABLES[zone]
+    offset = initial
+    for start, row_offset in rows:
+        if start <= instant_utc:
+            offset = row_offset
+        else:
+            break
+    return offset
+
+
+def _bucket_date(snap, policy):
+    """ADR-0004 (with ADR-0005 for zones): the calendar date the snapshot's buckets are computed from."""
+    instant = snap.taken_at.astimezone(timezone.utc)
+    if policy.zone is None:
+        offset = policy.tz_offset_minutes
+    else:
+        offset = _zone_offset(policy.zone, instant)
+    shifted = instant + timedelta(minutes=offset) - timedelta(hours=policy.day_start_hour)
+    return shifted.date()
+
+
+def _iso_week_key(day):
+    # ADR-0003: (ISO year, ISO week), Monday start.
+    iso_year, iso_week, _ = day.isocalendar()
+    return (iso_year, iso_week)
+
+
+def _monthly_key(day, month_start_day):
+    # ADR-0010: a month's cycle starts on day min(month_start_day, last day of that month).
+    year, month = day.year, day.month
+    start = min(month_start_day, monthrange(year, month)[1])
+    if day.day < start:
+        month -= 1
+        if month == 0:
+            month, year = 12, year - 1
+    return (year, month)
+
+
+def _newest_per_bucket(remaining, key_of, n):
+    """ADR-0001 "Buckets": keep the newest snapshot of each of the n newest buckets.
+
+    `remaining` is ordered newest first, so the first snapshot seen in a bucket is its newest.
+    """
+    newest = {}
+    for snap in remaining:
+        newest.setdefault(key_of(snap), snap)
+    chosen = sorted(newest, reverse=True)[:n]
+    return {newest[key].id for key in chosen}
+
+
+def _rule_keepers(remaining, policy):
+    """Apply keep_last and the four bucket rules to the remaining snapshots (newest first)."""
+    keep = set()
+    if policy.keep_last:
+        keep.update(snap.id for snap in remaining[: policy.keep_last])
+    if policy.keep_daily:
+        keep |= _newest_per_bucket(remaining, lambda s: _bucket_date(s, policy), policy.keep_daily)
+    if policy.keep_weekly:
+        keep |= _newest_per_bucket(
+            remaining, lambda s: _iso_week_key(_bucket_date(s, policy)), policy.keep_weekly
+        )
+    if policy.keep_monthly:
+        keep |= _newest_per_bucket(
+            remaining, lambda s: _monthly_key(_bucket_date(s, policy), policy.month_start_day), policy.keep_monthly
+        )
+    if policy.keep_yearly:
+        keep |= _newest_per_bucket(remaining, lambda s: _bucket_date(s, policy).year, policy.keep_yearly)
+    return keep
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+    The rules are those of docs/adr/ (see the index there and the Status line of each record).
     """
