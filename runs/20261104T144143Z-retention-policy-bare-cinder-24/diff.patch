index 0000000..96bd062
--- /dev/null
+++ b/tests/test_retention_adr.py
@@ -0,0 +1,105 @@
+import unittest
+from datetime import datetime, timedelta, timezone
+
+from vaultsnap import Policy, Snapshot, plan_retention
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+UTC = timezone.utc
+
+
+def snap(sid, stamp, *tags):
+    """Snapshot with an explicit id and an ISO timestamp; a timezone is needed in `stamp`."""
+    return Snapshot(sid, datetime.fromisoformat(stamp), frozenset(tags))
+
+
+class IsoWeekTest(unittest.TestCase):
+    # ADR-0003: weeks are ISO weeks, so 2025-12-28 is (2025, 52) and 2025-12-30 is (2026, 1).
+    def test_iso_week_year_differs_from_calendar_year_at_new_year(self):
+        shots = [snap("a", "2025-12-28T03:00+00:00"), snap("b", "2025-12-30T03:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        self.assertEqual(plan.prune, [])
+
+
+class MonthlyYearlyTest(unittest.TestCase):
+    # ADR-0003: 2025-12-30 is in monthly bucket (2025, 12) and yearly bucket 2025.
+    def test_december_30_is_in_calendar_month_and_year(self):
+        shots = [snap("a", "2025-12-30T03:00+00:00"), snap("b", "2026-01-05T03:00+00:00")]
+        self.assertEqual(plan_retention(shots, Policy(keep_monthly=2), NOW).prune, [])
+        plan = plan_retention(shots, Policy(keep_yearly=1), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+class DayBoundaryTest(unittest.TestCase):
+    # ADR-0004: with day_start_hour=4 a 03:30 snapshot on 1 Jan belongs to the 31 Dec day.
+    def test_day_start_hour_moves_early_morning_into_previous_day(self):
+        shots = [snap("a", "2025-12-31T23:00+00:00"), snap("b", "2026-01-01T03:30+00:00")]
+        plan = plan_retention(shots, Policy(keep_daily=1, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_day_start_hour_applies_to_all_rules(self):
+        shots = [snap("a", "2025-12-31T23:00+00:00"), snap("b", "2026-01-01T03:30+00:00")]
+        plan = plan_retention(shots, Policy(keep_yearly=2, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, ["b"])
+
+    # ADR-0004: tz_offset_minutes is a fixed offset; +600 is UTC+10.
+    def test_tz_offset_decides_the_local_day(self):
+        shots = [
+            snap("a", "2026-03-09T12:00+00:00"),  # local 03-09 22:00
+            snap("b", "2026-03-10T15:00+00:00"),  # local 03-11 01:00
+            snap("c", "2026-03-11T05:00+00:00"),  # local 03-11 15:00
+        ]
+        plan = plan_retention(shots, Policy(keep_daily=2, tz_offset_minutes=600), NOW)
+        self.assertEqual(plan.keep, ["c", "a"])
+        self.assertEqual(plan.prune, ["b"])
+
+
+class SetAsideTest(unittest.TestCase):
+    def test_future_snapshot_is_kept_and_does_not_count(self):
+        shots = [snap("a", "2026-03-10T03:00+00:00"), snap("b", "2026-03-11T03:00+00:00"), snap("f", "2026-03-25T03:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["f", "b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_snapshot_exactly_at_now_is_not_set_aside(self):
+        shots = [snap("a", "2026-03-11T03:00+00:00"), snap("n", "2026-03-20T12:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["n"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_protected_snapshot_is_never_a_bucket_representative(self):
+        shots = [snap("plain", "2026-03-11T01:00+00:00"), snap("rel", "2026-03-11T09:00+00:00", "release")]
+        plan = plan_retention(shots, Policy(keep_daily=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan.keep, ["rel", "plain"])
+        self.assertEqual(plan.prune, [])
+
+
+class CountingTest(unittest.TestCase):
+    def test_empty_periods_do_not_use_up_n(self):
+        shots = [snap("a", "2026-03-01T03:00+00:00"), snap("b", "2026-03-02T03:00+00:00"), snap("c", "2026-03-10T03:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_daily=2), NOW)
+        self.assertEqual(plan.keep, ["c", "b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_same_taken_at_breaks_ties_by_greater_id(self):
+        t = "2026-03-11T03:00+00:00"
+        plan = plan_retention([snap("a", t), snap("b", t)], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+class InputValidationTest(unittest.TestCase):
+    def test_naive_now_is_rejected(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-11T03:00+00:00")], Policy(keep_last=1), datetime(2026, 3, 20, 12))
+
+    def test_duplicate_ids_are_rejected(self):
+        shots = [snap("a", "2026-03-10T03:00+00:00"), snap("a", "2026-03-11T03:00+00:00")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(keep_last=1), NOW)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/vaultsnap/retention.py b/vaultsnap/retention.py
index 5ad59e7..7169ada 100644
--- a/vaultsnap/retention.py
+++ b/vaultsnap/retention.py
@@ -1,4 +1,5 @@
 from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
 
 
 @dataclass(frozen=True)
@@ -16,5 +17,59 @@ def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+    The rules are those of docs/adr/0001 (with 0003 for ISO weeks and 0004 for day boundaries).
     """
-    raise NotImplementedError
+    snaps = list(snapshots)
+    _require_aware(now, "now")
+    seen = set()
+    for s in snaps:
+        _require_aware(s.taken_at, f"taken_at of snapshot {s.id!r}")
+        if s.id in seen:
+            raise ValueError(f"duplicate snapshot id {s.id!r}")
+        seen.add(s.id)
+
+    # Newest first. Ties on taken_at are broken by the greater id (ADR-0001, "Ordering").
+    ordered = sorted(snaps, key=lambda s: (s.taken_at, s.id), reverse=True)
+
+    # An empty policy never prunes (ADR-0001, "Rules").
+    if not policy.has_rules:
+        return Plan(keep=[s.id for s in ordered], prune=[])
+
+    # Set-aside snapshots: protected tags, or taken after `now` (ADR-0001, "Set-aside snapshots").
+    kept = {s.id for s in ordered if not s.tags.isdisjoint(policy.protect_tags) or s.taken_at > now}
+    remaining = [s for s in ordered if s.id not in kept]
+
+    if policy.keep_last:
+        kept.update(s.id for s in remaining[: policy.keep_last])
+
+    # Bucket keys are derived from the bucket time (ADR-0004); weeks are ISO weeks (ADR-0003).
+    bucket_keys = {
+        "keep_daily": lambda b: b.date(),
+        "keep_weekly": lambda b: b.isocalendar()[:2],
+        "keep_monthly": lambda b: (b.year, b.month),
+        "keep_yearly": lambda b: b.year,
+    }
+    for rule, key_of in bucket_keys.items():
+        count = getattr(policy, rule)
+        if not count:
+            continue
+        newest_in_bucket = {}
+        for s in remaining:  # newest first, so the first snapshot seen per bucket is its newest
+            newest_in_bucket.setdefault(key_of(_bucket_time(s.taken_at, policy)), s.id)
+        for key in sorted(newest_in_bucket, reverse=True)[:count]:
+            kept.add(newest_in_bucket[key])
+
+    keep = [s.id for s in ordered if s.id in kept]
+    prune = [s.id for s in ordered if s.id not in kept]
+    return Plan(keep=keep, prune=prune)
+
+
+def _require_aware(value, what):
+    if not isinstance(value, datetime) or value.utcoffset() is None:
+        raise ValueError(f"{what} must be a timezone-aware datetime, got {value!r}")
+
+
+def _bucket_time(taken_at, policy):
+    """Local time of a snapshot with the policy's fixed offset, shifted back by day_start_hour (ADR-0004)."""
+    local = taken_at.astimezone(timezone(timedelta(minutes=policy.tz_offset_minutes)))
+    return local - timedelta(hours=policy.day_start_hour)
