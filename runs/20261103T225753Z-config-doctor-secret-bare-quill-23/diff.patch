                 continue
-            key, value = line.split("=")
-            values[key] = value
+            if line.startswith("export") and line[6:7] in (" ", "\t"):
+                line = line[6:].lstrip()
+            if "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            values[key.strip()] = _parse_value(value)
     return values
 
 
+SECRETS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def mask(key, value):
+    """Redact secrets so output is safe to paste into a support ticket."""
+    if value is None or key not in SECRETS:
+        return value
+    return "<set, %d chars>" % len(value) if value else "<empty>"
+
