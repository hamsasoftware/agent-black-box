+def _parse_value(raw):
+    raw = raw.strip()
+    if raw and raw[0] in "\"'":
+        end = raw.find(raw[0], 1)
+        if end != -1:
+            return raw[1:end]
+    # unquoted: strip a trailing inline comment (" #...")
+    for i, ch in enumerate(raw):
+        if ch == "#" and i > 0 and raw[i - 1] in " \t":
+            return raw[:i].rstrip()
+    return raw
+
