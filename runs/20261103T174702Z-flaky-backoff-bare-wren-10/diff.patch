+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedRng:
+    """Stand-in rng that always picks one end of the jitter range."""
+
+    def __init__(self, pick):
+        self.pick = pick
+
+    def uniform(self, lo, hi):
+        return hi if self.pick == "high" else lo
+
+
+class RetryPolicyTest(unittest.TestCase):
+    def test_delay_never_exceeds_cap_at_maximum_jitter(self):
+        # Pre-jitter 32 * 1.1 = 35.2 would exceed cap 34 without the post-jitter clamp.
+        retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=_FixedRng("high"))
+        for delay in retrier.schedule():
+            self.assertLessEqual(delay, 34)
+        self.assertEqual(retrier.schedule()[-1], 34)
+
+    def test_delay_never_exceeds_cap_over_many_random_draws(self):
+        rng = random.Random(12345)
+        for _ in range(2000):
+            delay = compute_delay(10, base=0.5, cap=34, jitter=0.1, rng=rng)
+            self.assertLessEqual(delay, 34)
+            self.assertGreaterEqual(delay, 0)
+
+    def test_jitter_range_is_applied_below_cap(self):
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, jitter=0.1, rng=_FixedRng("high")), 1.1)
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, jitter=0.1, rng=_FixedRng("low")), 0.9)
+
+
+if __name__ == "__main__":
+    unittest.main()
