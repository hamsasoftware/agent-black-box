new file mode 100644
index 0000000..4603b13
--- /dev/null
+++ b/tests/test_comments.py
@@ -0,0 +1,25 @@
+import unittest
+
+from relnotes import render_release
+
+
+def render(body):
+    return render_release("## [1.0.0] - 2024-01-01\n" + body, "1.0.0")
+
+
+class CommentTest(unittest.TestCase):
+    def test_multiline_inline_comment(self):
+        self.assertEqual(render("a <!-- x\ny\n--> \nb\n"), "# 1.0.0 (2024-01-01)\n\na\nb\n")
+
+    def test_two_comments_on_one_line(self):
+        self.assertEqual(render("a <!-- x --> b <!-- y -->\n"), "# 1.0.0 (2024-01-01)\n\na  b\n")
+
+    def test_heading_inside_comment_ignored(self):
+        self.assertEqual(render("a\n<!--\n## [2.0.0] - 2025-01-01\n-->\n"), "# 1.0.0 (2024-01-01)\n\na\n")
+
+    def test_blank_runs_collapse(self):
+        self.assertEqual(render("\n\na\n\n\n\nb\n\n\n"), "# 1.0.0 (2024-01-01)\n\na\n\nb\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
