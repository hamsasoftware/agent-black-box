+HEADING = re.compile(r"^## \[(?P<version>[^\]]+)\](?: - (?P<date>\d{4}-\d{2}-\d{2}))?\s*$")
+COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
+_MARK = "\x00"
+
+
+def strip_comments(text):
+    """Remove HTML comments; drop whitespace they leave at the end of a line."""
+    text = COMMENT.sub(_MARK, text.replace(_MARK, ""))
+    lines = []
+    for line in text.split("\n"):
+        if line.rstrip().endswith(_MARK):
+            line = line.replace(_MARK, "").rstrip()
+        else:
+            line = line.replace(_MARK, "")
+        lines.append(line)
+    return "\n".join(lines)
 
 
