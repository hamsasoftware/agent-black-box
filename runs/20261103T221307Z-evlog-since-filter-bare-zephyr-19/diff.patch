+def parse_day(value):
+    """Parse a YYYY-MM-DD argument into midnight UTC of that day."""
+    try:
+        day = datetime.strptime(value, "%Y-%m-%d")
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date {value!r}: expected YYYY-MM-DD, e.g. 2024-03-10")
+    return day.replace(tzinfo=timezone.utc)
 
 
