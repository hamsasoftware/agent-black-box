+"""Checks of docs/MIGRATION.md, ROUNDING.md and FORMATS.md that the other tests do not reach."""
+import json
+import os
+import tempfile
+import unittest
+
+from shipcalc import auditlog, export, importer, plugins, storage, surcharges
+from shipcalc.calc import order_weight_kg
+from shipcalc.limits import check_total_kg
+from shipcalc.models import Item, Order
+from shipcalc.pricing import freight_cents
+from shipcalc.tare import net_after_percent_kg, tare_for_percent_kg
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+from shipcalc.validate import validate_item
+from shipcalc.weighbridge import within_tolerance
+
+
+class UnitsTest(unittest.TestCase):
+    def test_half_even_rounding_to_three_places(self):
+        self.assertEqual(normalize_kg("1.0005"), "1.000")
+        self.assertEqual(normalize_kg("1.0015"), "1.002")
+        self.assertEqual(normalize_kg("2.0025"), "2.002")
+        self.assertEqual(normalize_kg("0.0004"), "0.000")
+        self.assertEqual(normalize_kg("1000.0004"), "1000.000")
+
+    def test_invalid_input(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", 1, 1.0, True, None]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+
+    def test_message_of_invalid_input(self):
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg(1500)
+        self.assertEqual(str(ctx.exception), "invalid weight: 1500")
+
+    def test_gram_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        for bad in [True, -1, 1.5, "1"]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+    def test_carrier_limit_boundary(self):
+        self.assertEqual(check_total_kg("2147483.647"), "2147483.647")
+        with self.assertRaises(WeightError):
+            check_total_kg("2147483.648")
+
+
+class RoundingTest(unittest.TestCase):
+    def test_freight_half_even(self):
+        self.assertEqual(freight_cents("0.003", 500), 2)
+        self.assertEqual(freight_cents("0.001", 499), 0)
+        self.assertEqual(freight_cents("1.0015", 100), 100)
+
+    def test_tare_and_net(self):
+        self.assertEqual(tare_for_percent_kg("10.015", 10), "1.002")
+        self.assertEqual(net_after_percent_kg("0.015", 50), "0.007")
+
+    def test_weighbridge_boundary_is_within(self):
+        self.assertTrue(within_tolerance("10.025", "10.225"))
+        self.assertFalse(within_tolerance("10.025", "10.226"))
+
+    def test_average_is_rounded_half_even(self):
+        from shipcalc.reports import average_weight_kg
+
+        self.assertEqual(average_weight_kg(Order([Item("A", "0.001"), Item("B", "0.002")])), "0.002")
+
+
+class ValidateTest(unittest.TestCase):
+    def test_valid_item(self):
+        self.assertEqual(validate_item({"sku": "A", "weight_kg": "1.000", "qty": 1}), [])
+
+    def test_range_applies_after_rounding(self):
+        self.assertIn("weight_kg: out of range 0.001..1000.000",
+                      validate_item({"sku": "A", "weight_kg": "0.0004", "qty": 1}))
+        self.assertEqual(validate_item({"sku": "A", "weight_kg": "1000.0004", "qty": 1}), [])
+
+    def test_missing_and_invalid_weight(self):
+        self.assertIn("weight_kg: missing", validate_item({"sku": "A", "weight_g": 5, "qty": 1}))
+        problems = validate_item({"sku": "A", "weight_kg": "heavy", "qty": 1})
+        self.assertTrue(any(p.startswith("weight_kg:") for p in problems))
+
+
+class CsvTest(unittest.TestCase):
+    def test_grams_and_kilograms_columns(self):
+        old = importer.parse_csv("sku,weight_g,qty\nA,1250,2\n")
+        self.assertEqual((old.items[0].weight_kg, old.items[0].qty), ("1.250", 2))
+        new = importer.parse_csv("sku,weight_kg\r\nB,0.0015\r\n")
+        self.assertEqual(new.items[0].weight_kg, "0.002")
+
+    def test_both_weight_columns_are_rejected(self):
+        with self.assertRaisesRegex(ValueError, "both weight_g and weight_kg"):
+            importer.parse_csv("sku,weight_g,weight_kg\nA,1,1\n")
+
+    def test_export_keeps_grams(self):
+        order = Order([Item("A", "1.250", 2)])
+        self.assertEqual(export.to_csv(order), "sku,weight_g,qty\nA,1250,2\n")
+        self.assertEqual(export.edi_segment(order), "WGT*G*2500~")
+        self.assertEqual(export.barcode(order), "WT0000002500")
+        self.assertEqual(export.carrier_payload(order), {"weight_g": 2500, "parcels": 1})
+
+
+class StorageTest(unittest.TestCase):
+    def test_schema_1_file_is_read_and_schema_2_is_written(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "order.json")
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump({"schema": 1, "items": [{"sku": "A", "weight_g": 350, "qty": 2}]}, handle)
+            order = storage.load(path)
+            self.assertEqual(order.items[0].weight_kg, "0.350")
+            storage.save(order, path)
+            with open(path, encoding="utf-8") as handle:
+                self.assertEqual(json.load(handle)["schema"], 2)
+
+    def test_unsupported_schema(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "order.json")
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump({"schema": True, "items": []}, handle)
+            with self.assertRaisesRegex(ValueError, "unsupported schema: True"):
+                storage.load(path)
+
+
+class AuditLogTest(unittest.TestCase):
+    def test_version_1_and_2_entries(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "log.jsonl")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write('{"event": "add", "qty": 2, "sku": "MUG-01", "v": 1, "weight_g": 350}\n')
+            auditlog.write_entry(path, "add", "BOOK-07", "1.200")
+            self.assertEqual(auditlog.total_added_kg(path), "1.900")
+            first = auditlog.read_entries(path)[0]
+            self.assertEqual(first["weight_kg"], "0.350")
+            self.assertNotIn("weight_g", first)
+
+    def test_unknown_version(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "log.jsonl")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write('{"event": "add", "v": "2"}\n')
+            with self.assertRaisesRegex(ValueError, "unsupported log version"):
+                auditlog.read_entries(path)
+
+
+class SurchargeAndPluginTest(unittest.TestCase):
+    def test_schema_1_table_is_converted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "table.json")
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump({"schema": 1, "bands": [{"max_g": 1000, "cents": 0}], "over_cents": 9}, handle)
+            table = surcharges.load(path)
+            self.assertEqual(table["bands"], [{"max_kg": "1.000", "cents": 0}])
+            self.assertEqual(surcharges.cents_for("1.001", table), 9)
+
+    def test_shipped_table_bands(self):
+        self.assertEqual(surcharges.cents_for("1.000"), 0)
+        self.assertEqual(surcharges.cents_for("15.001"), 900)
+
+    def test_schema_1_plugin_options_are_converted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "plugins.json")
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump({"schema": 1, "plugins": [
+                    {"module": "shipcalc.extras.fragile", "options": {"cents": 120, "max_unit_g": 300}}]}, handle)
+            (plugin,) = plugins.load(path)
+            self.assertEqual(plugin.max_unit, "0.300")
+
+    def test_shipped_plugins_example(self):
+        order = Order([Item("A", "0.300", 3), Item("B", "4.000")])
+        self.assertEqual(order_weight_kg(order), "4.900")
+        self.assertEqual(plugins.extras_cents(order), 360 + 0 + 90)
+
+
+if __name__ == "__main__":
+    unittest.main()
