diff --git a/tests/test_migration.py b/tests/test_migration.py
new file mode 100644
index 0000000..e6266f2
--- /dev/null
+++ b/tests/test_migration.py
@@ -0,0 +1,129 @@
+import json
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from shipcalc import cache, cli, export, limits, reports, storage
+from shipcalc.calc import order_weight_kg
+from shipcalc.format import format_weight
+from shipcalc.models import Item, Order
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+from shipcalc.validate import validate_item
+
+
+class UnitsTest(unittest.TestCase):
+    def test_rounding(self):
+        for raw, want in [("1.0005", "1.000"), ("1.0015", "1.002"), ("2.0025", "2.002"),
+                          ("1.00051", "1.001"), ("2", "2.000"), ("0.2500", "0.250")]:
+            self.assertEqual(normalize_kg(raw), want)
+
+    def test_invalid(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".",
+                    "1\n", "١", 1500, 1.5, True, None, Decimal("1")]:
+            with self.assertRaises(WeightError, msg=repr(bad)) as ctx:
+                normalize_kg(bad)
+            self.assertEqual(str(ctx.exception), f"invalid weight: {bad!r}")
+
+    def test_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        for bad in [-1, True, 1.0, "1"]:
+            with self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+
+class LimitsTest(unittest.TestCase):
+    def test_carrier_limit(self):
+        self.assertEqual(limits.check_total_kg("2147483.647"), "2147483.647")
+        with self.assertRaises(WeightError):
+            limits.check_total_kg("2147483.648")
+
+
+class ReportsTest(unittest.TestCase):
+    def test_average(self):
+        self.assertEqual(reports.average_weight_kg(Order()), "0.000")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "1"), Item("B", "2")])), "1.500")
+        # 0.001 + 0.002 over 2 units = 0.0015 -> half to even 0.002; 0.001 over 2 = 0.0005 -> 0.000
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001"), Item("B", "0.002")])), "0.002")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001", 1), Item("B", "0", 1)])), "0.000")
+
+    def test_bands_and_heaviest(self):
+        order = Order([Item("A", "0.500"), Item("B", "0.501"), Item("C", "2.000"), Item("D", "2.001")])
+        self.assertEqual(reports.weight_bands(order), {"light": 1, "medium": 2, "heavy": 1})
+        self.assertEqual([i.sku for i in reports.heaviest(order, 2)], ["D", "C"])
+
+
+class OutputTest(unittest.TestCase):
+    def setUp(self):
+        self.order = Order([Item("MUG-01", "0.350", 2), Item("BOOK-07", "1.200")])
+
+    def test_cache_key(self):
+        self.assertEqual(cache.quote_key(self.order, "eu"), "quote:v2:eu:1.900:2")
+
+    def test_format(self):
+        self.assertEqual(format_weight("0.25"), "0.250 kg")
+        self.assertEqual(format_weight("12"), "12.000 kg")
+
+    def test_export_grams(self):
+        self.assertEqual(export.to_csv(self.order), "sku,weight_g,qty\nMUG-01,350,2\nBOOK-07,1200,1\n")
+        payload = export.carrier_payload(self.order)
+        self.assertEqual(payload, {"weight_g": 1900, "parcels": 1})
+        self.assertIs(type(payload["weight_g"]), int)
+
+    def test_total_over_limit(self):
+        order = Order([Item("X", "1000.000", 2147484)])
+        with self.assertRaises(WeightError):
+            order_weight_kg(order)
+
