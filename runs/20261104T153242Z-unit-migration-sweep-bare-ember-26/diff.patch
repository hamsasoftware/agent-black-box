+class ValidateTest(unittest.TestCase):
+    def test_ranges(self):
+        ok = {"sku": "A", "qty": 1}
+        self.assertEqual(validate_item({**ok, "weight_kg": "0.001"}), [])
+        self.assertEqual(validate_item({**ok, "weight_kg": "1000.0004"}), [])
+        self.assertEqual(validate_item({**ok, "weight_kg": "0.0004"}),
+                         ["weight_kg: out of range 0.001..1000.000"])
+        self.assertEqual(validate_item({**ok, "weight_kg": "1000.001"}),
+                         ["weight_kg: out of range 0.001..1000.000"])
+        for bad in ["abc", 5, "-1"]:
+            problems = validate_item({**ok, "weight_kg": bad})
+            self.assertEqual(len(problems), 1)
+            self.assertTrue(problems[0].startswith("weight_kg:"))
+        self.assertEqual(validate_item({**ok, "weight_g": 5}), ["weight_kg: missing"])
+
