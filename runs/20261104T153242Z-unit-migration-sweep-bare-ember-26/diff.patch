+class StorageCliTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.dir.cleanup)
+        self.path = os.path.join(self.dir.name, "o.json")
+
+    def _write(self, data):
+        with open(self.path, "w") as f:
+            json.dump(data, f)
+
+    def test_schema_1_and_2(self):
+        self._write({"schema": 1, "items": [{"sku": "A", "weight_g": 1250, "qty": 2}]})
+        self.assertEqual(storage.load(self.path).items[0].weight_kg, "1.250")
+        self._write({"schema": 2, "items": [{"sku": "A", "weight_kg": "1.5", "qty": 2}]})
+        self.assertEqual(storage.load(self.path).items[0].weight_kg, "1.500")
+        self._write({"schema": 1, "items": [{"sku": "A", "weight_g": "1250"}]})
+        with self.assertRaises(WeightError):
+            storage.load(self.path)
+        self._write({"schema": 3, "items": []})
+        with self.assertRaises(ValueError):
+            storage.load(self.path)
+
+    def test_save_and_cli_add(self):
+        self._write({"schema": 1, "items": []})
+        self.assertEqual(cli.main(["add", self.path, "A", "0.25", "2"]), 0)
+        with open(self.path) as f:
+            data = json.load(f)
+        self.assertEqual(data["schema"], 2)
+        self.assertEqual(data["items"][0]["weight_kg"], "0.250")
+        self.assertEqual(cli.main(["add", self.path, "B", "abc", "1"]), 2)
+
