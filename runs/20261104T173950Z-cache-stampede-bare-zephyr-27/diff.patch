-"""A thread-safe cache with a time to live and a loader callback."""
+"""A thread-safe cache with a time to live, single-flight loads, an LRU size bound, stale serving and timeouts.
+
+All shared state is guarded by one lock. The loader itself always runs outside the lock. Each key with a load in
+flight has a _Flight record; waiters block on a Condition built on the same lock. The wait-for graph used for
+deadlock detection is `_waiting` (thread id -> the flight that thread waits for) together with each flight's owner.
+See docs/CONTRACT.md for the guarantees.
+"""
 import threading
 import time
+from collections import OrderedDict
 
 from .stats import Stats
 
 
+class DeadlockError(RuntimeError):
+    """A get would wait for a load whose owner thread (through its loaders) is waiting for the calling thread."""
+
+
+def _is_number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+class _Entry:
+    __slots__ = ("value", "loaded_at")
+
+    def __init__(self, value, loaded_at):
+        self.value = value
+        self.loaded_at = loaded_at
+
+
+class _Flight:
+    """One load in flight. `kind` is set when it completes: "value", "stale" (result is a stale value) or "error"."""
+
+    __slots__ = ("owner", "cond", "done", "kind", "result")
+
+    def __init__(self, owner, lock):
+        self.owner = owner
+        self.cond = threading.Condition(lock)
+        self.done = False
+        self.kind = None
+        self.result = None
+
+
 class TTLCache:
