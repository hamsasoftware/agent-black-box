--- a/stockreport/report.py
+++ b/stockreport/report.py
@@ -7,6 +7,18 @@ def _rows(items):
     return [[i.sku, i.name, i.qty, i.unit_price] for i in sorted(items, key=lambda i: i.sku)]
 
 
+def _md_cell(text):
+    # A bare "|" or newline would split the GitHub table row, so escape / flatten them.
+    return str(text).replace("|", "\\|").replace("\r", " ").replace("\n", " ")
+
+
+def _md_rows(items):
+    return [
+        [_md_cell(i.sku), _md_cell(i.name), i.qty, i.unit_price]
+        for i in sorted(items, key=lambda i: i.sku)
+    ]
+
+
 def total_value(items):
     return sum(i.value for i in items)
 
@@ -15,4 +27,12 @@ def render(items, fmt="text"):
     if fmt == "text":
         table = tabulate(_rows(items), headers=HEADERS, style="plain", number_format=".2f")
         return f"{table}\n\nTotal stock value: {total_value(items):.2f}"
+    if fmt == "markdown":
+        # Explicit alignment: qty is numeric, but the escaped name cells are strings,
+        # so the default per-column detection is not relied on.
+        table = tabulate(
+            _md_rows(items), headers=HEADERS, style="pipe",
+            align=["l", "l", "r", "r"], number_format=".2f",
+        )
+        return f"{table}\n\n**Total stock value:** {total_value(items):.2f}"
     raise ValueError(f"unknown format {fmt!r}")
