+"""Configuration parser for the format described in docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_BOM = "﻿"
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_ENTRY_RE = re.compile(r"(" + _DOTTED + r")[ \t]*=(.*)\Z", re.S)
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\](.*)\Z", re.S)
+
+_D = r"[0-9](?:_?[0-9])*"
+_INT_DEC = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)\Z")
+_INT_PREFIXED = re.compile(
+    r"[+-]?0(?:[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*"
+    r"|[oO][0-7](?:_?[0-7])*|[bB][01](?:_?[01])*)\Z"
+)
+_EXP = r"[eE][+-]?[0-9]+"
+_FLOAT = re.compile(
+    r"[+-]?(?:(?:" + _D + r"\.(?:" + _D + r")?|\." + _D + r")(?:" + _EXP + r")?"
+    r"|" + _D + _EXP + r")\Z"
+)
+_HEX = "0123456789abcdefABCDEF"
+_WS = " \t"
+
+
+class _ValueError(Exception):
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+def _convert(text):
+    low = text.lower()
+    if low == "true":
+        return True
+    if low == "false":
+        return False
+    if _INT_DEC.match(text):
+        return int(text.replace("_", ""), 10)
+    if _INT_PREFIXED.match(text):
+        return int(text.replace("_", ""), 0)
+    if _FLOAT.match(text):
+        return float(text.replace("_", ""))
+    return text
+
+
+def _strip_comment(line):
+    for i, ch in enumerate(line):
+        if ch in "#;" and (i == 0 or line[i - 1] in _WS):
+            return line[:i]
+    return line
+
+
+def _skip(s, p):
+    """Skip whitespace, newlines and comments."""
+    n = len(s)
+    while p < n:
+        c = s[p]
+        if c in " \t\n":
+            p += 1
+        elif c in "#;" and (p == 0 or s[p - 1] in " \t\n"):
+            q = s.find("\n", p)
+            p = n if q < 0 else q
+        else:
+            break
+    return p
+
+
+_SIMPLE_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+
+
+def _quoted(s, p):
+    """Parse a quoted string starting at s[p]; return (value, next position)."""
+    n = len(s)
+    quote = s[p]
+    p += 1
+    if quote == "'":
+        q = p
+        while q < n and s[q] not in "'\n":
+            q += 1
+        if q >= n or s[q] == "\n":
+            raise _ValueError("unterminated string")
+        return s[p:q], q + 1
+    out = []
+    while True:
+        if p >= n or s[p] == "\n":
+            raise _ValueError("unterminated string")
+        c = s[p]
+        if c == '"':
+            return "".join(out), p + 1
+        if c == "\\":
+            e = s[p + 1] if p + 1 < n else ""
+            if e and e in _SIMPLE_ESCAPES:
+                out.append(_SIMPLE_ESCAPES[e])
+                p += 2
+            elif e == "u":
+                digits = s[p + 2:p + 6]
+                if len(digits) != 4 or any(d not in _HEX for d in digits):
+                    raise _ValueError("invalid escape")
+                out.append(chr(int(digits, 16)))
+                p += 6
+            else:
+                raise _ValueError("invalid escape")
+        else:
+            out.append(c)
+            p += 1
+
+
+def _list(s, p):
+    """Parse a list starting at s[p] == '['; return (items, next position)."""
+    n = len(s)
+    p += 1
+    items = []
+    want_item = True
+    while True:
+        p = _skip(s, p)
+        if p >= n:
+            raise _ValueError("unterminated list")
+        c = s[p]
+        if want_item:
+            if c == "]":
+                # empty list, or a single trailing comma
+                return items, p + 1
+            if c == ",":
+                raise _ValueError("invalid list")
+            if c in "\"'":
+                value, p = _quoted(s, p)
+            elif c == "[":
+                value, p = _list(s, p)
+            else:
+                start = p
+                while p < n:
+                    ch = s[p]
+                    if ch in ",]\n":
+                        break
+                    if ch == "[":
+                        raise _ValueError("invalid list")
+                    if ch in "#;" and s[p - 1] in _WS:
+                        break
+                    p += 1
+                value = _convert(s[start:p].strip(_WS))
+            items.append(value)
+            want_item = False
+        else:
+            if c == ",":
+                want_item = True
+                p += 1
+            elif c == "]":
+                return items, p + 1
+            else:
+                raise _ValueError("invalid list")
+
+
+def _parse_value(first, conts):
+    s = "\n".join([first] + conts)
+    n = len(s)
+    p = _skip(s, 0)
+    if p < n and s[p] in "\"'":
+        value, p = _quoted(s, p)
+        if _skip(s, p) < n:
+            raise _ValueError("unexpected text after string")
+        return value
+    if p < n and s[p] == "[":
+        value, p = _list(s, p)
+        if _skip(s, p) < n:
+            raise _ValueError("invalid list")
+        return value
+    lines = [_strip_comment(x).strip(_WS) for x in [first] + conts]
+    lines = [x for x in lines if x]
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _convert(lines[0])
+    return "\n".join(lines)
+
+
+class _State:
+    def __init__(self):
+        self.result = {}
+        self.sections = set()
+
+
+def _table(state, path, lineno, source):
+    """Walk (creating as needed) the tables along path; return the innermost."""
+    node = state.result
+    for part in path:
+        child = node.get(part)
+        if child is None:
+            child = node[part] = {}
+        elif not isinstance(child, dict):
+            raise ParseError("key conflict: " + ".".join(path), lineno, source)
+        node = child
+    return node
+
+
+def _only_comment(rest):
+    rest_s = rest.strip(_WS)
+    return not rest_s or (rest[0] in _WS and rest_s[0] in "#;")
+
+
+def _process(text, base_dir, source, state, stack):
+    lines = re.split(r"\r\n|\n|\r", text)
+    total = len(lines)
+    section = ()
+    i = 0
+    while i < total:
+        line = lines[i]
+        lineno = i + 1
+        stripped = line.strip(_WS)
+        if not stripped or stripped[0] in "#;":
+            i += 1
+            continue
+        if line[0] in _WS:
+            raise ParseError("continuation without a value", lineno, source)
+        if line[0] == "[":
+            m = _HEADER_RE.match(line)
+            if not m or not _only_comment(m.group(2)):
+                raise ParseError("invalid section header", lineno, source)
+            name = m.group(1)
+            path = tuple(name.split("."))
+            parent = _table(state, path[:-1], lineno, source)
+            existing = parent.get(path[-1])
+            if existing is not None and not isinstance(existing, dict):
+                raise ParseError("key conflict: " + name, lineno, source)
+            if path in state.sections:
+                raise ParseError("duplicate section: " + name, lineno, source)
+            if existing is None:
+                parent[path[-1]] = {}
+            state.sections.add(path)
+            section = path
+            i += 1
+            continue
+        if line.startswith("@include") and not re.match(
+            r"[A-Za-z0-9_-]", line[8:9] or " "
+        ):
+            _include(line, lineno, base_dir, source, state, stack)
+            i += 1
+            continue
+        m = _ENTRY_RE.match(line)
+        if not m:
+            raise ParseError("invalid line", lineno, source)
+        key, first = m.group(1), m.group(2)
+        conts = []
+        j = i + 1
+        while j < total:
+            nxt = lines[j]
+            st = nxt.strip(_WS)
+            if not st or st[0] in "#;":
+                j += 1
+            elif nxt[0] in _WS:
+                conts.append(nxt)
+                j += 1
+            else:
+                break
+        try:
+            value = _parse_value(first, conts)
+        except _ValueError as exc:
+            raise ParseError(exc.message, lineno, source) from None
+        parts = section + tuple(key.split("."))
+        parent = _table(state, parts[:-1], lineno, source)
+        if parts[-1] in parent:
+            if isinstance(parent[parts[-1]], dict):
+                raise ParseError("key conflict: " + key, lineno, source)
+            raise ParseError("duplicate key: " + key, lineno, source)
+        parent[parts[-1]] = value
+        i = j
+
+
+def _include(line, lineno, base_dir, source, state, stack):
+    rest = line[len("@include"):]
+    p = len(rest) - len(rest.lstrip(_WS))
+    if p >= len(rest) or rest[p] not in "\"'":
+        raise ParseError("invalid include", lineno, source)
+    try:
+        path, p = _quoted(rest, p)
+    except _ValueError as exc:
+        raise ParseError(exc.message, lineno, source) from None
+    tail = rest[p:]
+    if not _only_comment(tail):
+        raise ParseError("invalid include", lineno, source)
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    target = os.path.normpath(os.path.join(base_dir, path))
+    real = os.path.realpath(target)
+    if real in stack:
+        raise ParseError("include cycle: " + path, lineno, source)
+    try:
+        with open(target, encoding="utf-8", newline="") as handle:
+            sub = handle.read()
+    except (OSError, ValueError):
+        raise ParseError("cannot read include: " + path, lineno, source) from None
+    if sub.startswith(_BOM):
+        sub = sub[1:]
+    _process(sub, os.path.dirname(target), target, state, stack + [real])
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    if text.startswith(_BOM):
+        text = text[1:]
+    state = _State()
+    _process(text, base_dir, source, state, [])
+    return state.result
 
 
 def load(path):
-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    with open(path, encoding="utf-8", newline="") as handle:
+        text = handle.read()
+    if text.startswith(_BOM):
+        text = text[1:]
+    state = _State()
+    _process(text, os.path.dirname(path), path, state, [os.path.realpath(path)])
+    return state.result
