+"""Tests pinning docs/RETRY.md: jitter is applied, and no delay exceeds cap."""
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedRng:
+    """Stub RNG whose uniform() always returns the given value."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def uniform(self, lo, hi):
+        return self.value
+
+
+class RetryPolicyTest(unittest.TestCase):
+    def test_cap_holds_at_upper_jitter_bound(self):
+        # Worst case: the capped exponential sits at cap and jitter is maximal.
+        delay = compute_delay(10, base=0.5, cap=34, jitter=0.1, rng=_FixedRng(1.1))
+        self.assertEqual(delay, 34)
+
+    def test_cap_holds_across_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34)
+
+    def test_cap_holds_for_large_attempts(self):
+        # base * 2 ** (attempt - 1) overflows the cap long before this.
+        for attempt in (20, 50, 200):
+            delay = compute_delay(attempt, base=0.5, cap=30, jitter=0.5, rng=_FixedRng(1.5))
+            self.assertEqual(delay, 30)
+
+    def test_jitter_applied_below_cap(self):
+        delay = compute_delay(2, base=1, cap=100, jitter=0.1, rng=_FixedRng(0.9))
+        self.assertAlmostEqual(delay, 1.8)
+
+    def test_jitter_bounds_uncapped(self):
+        for seed in range(500):
+            delay = compute_delay(3, base=1, cap=100, jitter=0.1, rng=random.Random(seed))
+            self.assertGreaterEqual(delay, 3.6)
+            self.assertLessEqual(delay, 4.4)
+
+    def test_default_rng_is_usable(self):
+        delay = compute_delay(1, base=0.5, cap=30)
+        self.assertGreaterEqual(delay, 0.45)
+        self.assertLessEqual(delay, 0.55)
+
+    def test_zero_jitter_is_exact_even_with_falsy_rng(self):
+        class FalsyRng:
+            def __bool__(self):
+                return False
+
+            def uniform(self, lo, hi):
+                return 1.0
+
+        self.assertEqual(compute_delay(1, base=2, cap=30, jitter=0, rng=FalsyRng()), 2)
+
+    def test_attempt_below_one_rejected(self):
+        with self.assertRaises(ValueError):
+            compute_delay(0)
+
+
+if __name__ == "__main__":
+    unittest.main()
