+# Values for these keys are never printed in full (see payhook/doctor.py).
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+_EXPORT_PREFIX = re.compile(r"^export\s+")
+_INLINE_COMMENT = re.compile(r"\s#")
+
+
+def _parse_quoted(raw, quote):
+    """Return the contents of a quoted value, or None if it is not properly quoted."""
+    body = []
+    i = 1
+    while i < len(raw):
+        ch = raw[i]
+        if quote == '"' and ch == "\\" and i + 1 < len(raw) and raw[i + 1] in '"\\':
+            body.append(raw[i + 1])
+            i += 2
+            continue
+        if ch == quote:
+            rest = raw[i + 1:].strip()
+            if rest and not rest.startswith("#"):
+                return None
+            return "".join(body)
+        body.append(ch)
+        i += 1
+    return None
+
+
+def _parse_value(raw):
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        quoted = _parse_quoted(raw, raw[0])
+        if quoted is not None:
+            return quoted
+    # Unquoted: a " #" starts a comment.
+    match = _INLINE_COMMENT.search(raw)
+    if match:
+        raw = raw[:match.start()]
+    return raw.strip()
+
 
 def read_dotenv(path):
