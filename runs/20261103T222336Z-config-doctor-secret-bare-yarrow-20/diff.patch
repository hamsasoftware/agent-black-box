@@ -0,0 +1,82 @@
+import io
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.doctor import run_doctor
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+TOKEN = "tok_live_SUPERSECRET1234567890"
+
+
+def setting_line(out, key):
+    for line in out.splitlines():
+        if line.startswith(key + " "):
+            return line.split(" = ", 1)[1]
+    raise AssertionError(f"no line for {key} in:\n{out}")
+
+
+class DoctorTest(unittest.TestCase):
+    def run_cli(self, cwd, env_extra):
+        env = {k: v for k, v in os.environ.items() if not k.startswith("PAYHOOK_")}
+        env.update({"PYTHONPATH": ROOT, **env_extra})
+        return subprocess.run(
+            [sys.executable, "-m", "payhook", "doctor"],
+            cwd=cwd, capture_output=True, text=True, env=env,
+        )
+
+    def test_reports_value_and_source_for_each_setting(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, ".env"), "w") as f:
+                f.write('export PAYHOOK_ENDPOINT="https://x.example/?a=1&b=2"\nPAYHOOK_TIMEOUT=20\n')
+            result = self.run_cli(tmp, {"PAYHOOK_REGION": "us"})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        out = result.stdout
+        self.assertEqual(setting_line(out, "PAYHOOK_ENDPOINT"), "'https://x.example/?a=1&b=2'  [from .env]")
+        self.assertEqual(setting_line(out, "PAYHOOK_TIMEOUT"), "'20'  [from .env]")
+        self.assertEqual(setting_line(out, "PAYHOOK_REGION"), "'us'  [from env]")
+        self.assertEqual(setting_line(out, "PAYHOOK_WEBHOOK_SECRET"), "(not set)  [from default]")
+        self.assertEqual(setting_line(out, "PAYHOOK_API_TOKEN"), "(not set)  [from default]")
+        self.assertIn("required settings missing: PAYHOOK_API_TOKEN, PAYHOOK_WEBHOOK_SECRET", out)
+
+    def test_secret_values_are_never_printed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, ".env"), "w") as f:
+                f.write(f"PAYHOOK_API_TOKEN={TOKEN}\n")
+            secret = "whsec_hidden_value"
+            result = self.run_cli(tmp, {"PAYHOOK_WEBHOOK_SECRET": secret})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        out = result.stdout
+        self.assertNotIn(TOKEN, out)
+        self.assertNotIn("SUPERSECRET", out)
+        self.assertNotIn(secret, out)
+        self.assertEqual(setting_line(out, "PAYHOOK_API_TOKEN"),
+                         f"(set, {len(TOKEN)} characters, hidden)  [from .env]")
+        self.assertEqual(setting_line(out, "PAYHOOK_WEBHOOK_SECRET"),
+                         f"(set, {len(secret)} characters, hidden)  [from env]")
+
+    def test_shows_dotenv_path_and_whether_it_was_found(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result = self.run_cli(tmp, {})
+        self.assertIn(f"dotenv file: {os.path.join(tmp, '.env')} (not found)", result.stdout)
+
+    def test_all_present_message(self):
+        out = io.StringIO()
+        code = run_doctor(out, environ={"PAYHOOK_API_TOKEN": "a", "PAYHOOK_WEBHOOK_SECRET": "b"},
+                          dotenv_path=os.path.join(ROOT, "does-not-exist.env"))
+        self.assertEqual(code, 0)
+        self.assertIn("all required settings present", out.getvalue())
+
+    def test_unknown_subcommand_still_rejected(self):
+        result = subprocess.run(
+            [sys.executable, "-m", "payhook", "nope"],
+            cwd=ROOT, capture_output=True, text=True, env={**os.environ, "PYTHONPATH": ROOT},
+        )
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("check|doctor", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
