@@ -0,0 +1,66 @@
+import os
+import tempfile
+import unittest
+
+from payhook.config import load_config, read_dotenv
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def parse(text):
+    handle, path = tempfile.mkstemp(suffix=".env")
+    with os.fdopen(handle, "w") as f:
+        f.write(text)
+    try:
+        return read_dotenv(path)
+    finally:
+        os.remove(path)
+
+
+class DotenvParsingTest(unittest.TestCase):
+    def test_export_with_quoted_value_containing_equals(self):
+        values = parse('export PAYHOOK_ENDPOINT="https://x.example/v2?region=eu&mode=live"\n')
+        self.assertEqual(values, {"PAYHOOK_ENDPOINT": "https://x.example/v2?region=eu&mode=live"})
+
+    def test_unquoted_value_with_equals_is_kept_whole(self):
+        self.assertEqual(parse("A=b=c\n"), {"A": "b=c"})
+
+    def test_single_quotes_keep_backslashes_and_double_quotes(self):
+        self.assertEqual(parse("A='x\\y\"z'\n"), {"A": 'x\\y"z'})
+
+    def test_double_quotes_unescape_quote_and_backslash(self):
+        self.assertEqual(parse('A="say \\"hi\\" \\\\"\n'), {"A": 'say "hi" \\'})
+
+    def test_export_with_extra_spaces_and_spaces_around_equals(self):
+        self.assertEqual(parse("export   A  =  1  \n"), {"A": "1"})
+
+    def test_inline_comment_after_unquoted_value_is_dropped(self):
+        self.assertEqual(parse("A=eu # the region\nB=x#y\n"), {"A": "eu", "B": "x#y"})
+
+    def test_inline_comment_after_quoted_value(self):
+        self.assertEqual(parse('A="eu"  # region\n'), {"A": "eu"})
+
+    def test_hash_inside_quotes_is_kept(self):
+        self.assertEqual(parse('A="a #b"\n'), {"A": "a #b"})
+
+    def test_comments_blank_lines_and_crlf(self):
+        self.assertEqual(parse("# note\n\r\nA=1\r\n"), {"A": "1"})
+
+    def test_malformed_lines_are_skipped(self):
+        self.assertEqual(parse("no equals here\n=orphan\nA=1\n"), {"A": "1"})
+
+    def test_unterminated_quote_is_taken_literally(self):
+        self.assertEqual(parse('A="oops\n'), {"A": '"oops'})
+
+    def test_repo_env_file_loads_full_endpoint(self):
+        # Read-only check against the repo's own .env (must not be modified).
+        config = load_config(environ={}, dotenv_path=os.path.join(ROOT, ".env"))
+        self.assertEqual(
+            config["PAYHOOK_ENDPOINT"],
+            ("https://api.payments.example/v2?region=eu&mode=live", ".env"),
+        )
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("15", ".env"))
+
+
+if __name__ == "__main__":
+    unittest.main()
