+import os
+
+from .config import SECRET_KEYS, load_config
+
+
+def _show(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        return f"(set, {len(value)} characters, hidden)"
+    return repr(value)
+
+
+def run_doctor(out, environ=None, dotenv_path=".env"):
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    dotenv_abs = os.path.abspath(dotenv_path)
+    dotenv_state = "found" if os.path.exists(dotenv_path) else "not found"
+
+    print("payhook doctor", file=out)
+    print(f"dotenv file: {dotenv_abs} ({dotenv_state})", file=out)
+    print("", file=out)
+
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        print(f"{key.ljust(width)} = {_show(key, value)}  [from {source}]", file=out)
+
+    missing = [key for key, (value, _) in config.items() if value is None]
+    print("", file=out)
+    if missing:
+        print("required settings missing: " + ", ".join(missing), file=out)
+    else:
+        print("all required settings present", file=out)
+    print("secret values are hidden; only their length is shown", file=out)
+    return 0
