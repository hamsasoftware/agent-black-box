 import os
+import re
 
 DEFAULTS = {
     "PAYHOOK_API_TOKEN": None,
@@ -8,18 +9,64 @@ DEFAULTS = {
     "PAYHOOK_REGION": "eu",
 }
 
+# Values of these settings are never printed in full (e.g. by `doctor`).
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+_INLINE_COMMENT = re.compile(r"\s+#")
+
+
+def parse_dotenv_line(line):
+    """Parse one line of a .env file. Returns (key, value) or None.
+
+    Supports `KEY=value`, an optional leading `export `, single or double
+    quoted values (double quotes allow \\" and \\\\ escapes), unquoted values
+    with a trailing ` # comment`, blank lines and `#` comment lines.
+    """
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if re.match(r"export\s", line):
+        line = line[len("export"):].lstrip()
+    if "=" not in line:
+        return None
+    key, _, raw = line.partition("=")
+    key = key.strip()
+    if not key:
+        return None
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        quote = raw[0]
+        chars = []
+        i = 1
+        closed = False
+        while i < len(raw):
+            c = raw[i]
+            if quote == '"' and c == "\\" and i + 1 < len(raw) and raw[i + 1] in '"\\':
+                chars.append(raw[i + 1])
+                i += 2
+                continue
+            if c == quote:
+                closed = True
+                break
+            chars.append(c)
+            i += 1
+        # An unterminated quote is kept verbatim rather than silently truncated.
+        value = "".join(chars) if closed else raw
+    else:
+        value = _INLINE_COMMENT.split(raw, maxsplit=1)[0].rstrip()
+    return key, value
+
 
 def read_dotenv(path):
     values = {}
     if not os.path.exists(path):
         return values
-    with open(path, encoding="utf-8") as handle:
+    with open(path, encoding="utf-8-sig") as handle:
         for line in handle:
-            line = line.strip()
-            if not line or line.startswith("#"):
-                continue
-            key, value = line.split("=")
-            values[key] = value
+            parsed = parse_dotenv_line(line)
+            if parsed is not None:
+                key, value = parsed
+                values[key] = value
     return values
 
 
diff --git a/payhook/doctor.py b/payhook/doctor.py
new file mode 100644
index 0000000..77a2ff7
--- /dev/null
+++ b/payhook/doctor.py
@@ -0,0 +1,35 @@
+import os
+
+from .config import SECRET_KEYS, load_config
+
+
+def describe_value(key, value):
+    if key in SECRET_KEYS:
+        return "<set, hidden>" if value is not None else "<not set>"
+    if value is None:
+        return "<not set>"
+    # repr() makes stray spaces, quotes and empty values visible.
+    return repr(value)
+
+
+def doctor_report(environ=None, dotenv_path=".env"):
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    abs_path = os.path.abspath(dotenv_path)
+    found = "found" if os.path.exists(dotenv_path) else "not found"
+    rows = [
+        (key, describe_value(key, value), source) for key, (value, source) in config.items()
+    ]
+    key_width = max(len("setting"), *(len(k) for k, _, _ in rows)) + 2
+    value_width = max(len("effective value"), *(len(v) for _, v, _ in rows)) + 2
+    lines = [
+        "payhook doctor",
+        f"dotenv file: {abs_path} ({found})",
+        "",
+        f"{'setting':<{key_width}}{'effective value':<{value_width}}source",
+    ]
+    for key, value, source in rows:
+        lines.append(f"{key:<{key_width}}{value:<{value_width}}{source}")
+    missing = [k for k, (v, _) in config.items() if v is None]
+    lines.append("")
+    lines.append("missing required: " + ", ".join(missing) if missing else "missing required: none")
+    return "\n".join(lines)
diff --git a/tests/test_dotenv_and_doctor.py b/tests/test_dotenv_and_doctor.py
new file mode 100644
index 0000000..9b84e03
--- /dev/null
+++ b/tests/test_dotenv_and_doctor.py
@@ -0,0 +1,100 @@
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.config import load_config, parse_dotenv_line
+from payhook.doctor import doctor_report
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def write_env(text):
+    handle, path = tempfile.mkstemp(suffix=".env")
+    with os.fdopen(handle, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+class ParseLineTest(unittest.TestCase):
+    def test_plain(self):
+        self.assertEqual(parse_dotenv_line("A=b"), ("A", "b"))
+
+    def test_export_with_spaces_and_padding(self):
+        self.assertEqual(parse_dotenv_line("  export\tA = b  "), ("A", "b"))
+
+    def test_export_is_not_a_key_prefix(self):
+        self.assertEqual(parse_dotenv_line("exporter=1"), ("exporter", "1"))
+
+    def test_double_quotes_with_escapes_and_hash(self):
+        self.assertEqual(parse_dotenv_line(r'A="x # y \"z\" \\"'), ("A", 'x # y "z" \\'))
+
+    def test_single_quotes_are_literal(self):
+        self.assertEqual(parse_dotenv_line(r"A='a\nb'"), ("A", r"a\nb"))
+
+    def test_quoted_empty_value(self):
+        self.assertEqual(parse_dotenv_line('A=""'), ("A", ""))
+
+    def test_inline_comment_on_unquoted_value(self):
+        self.assertEqual(parse_dotenv_line("A=eu   # region"), ("A", "eu"))
+
+    def test_hash_inside_unquoted_value_is_kept(self):
+        self.assertEqual(parse_dotenv_line("A=abc#def"), ("A", "abc#def"))
+
+    def test_ignored_lines(self):
+        self.assertIsNone(parse_dotenv_line(""))
+        self.assertIsNone(parse_dotenv_line("   # comment"))
+        self.assertIsNone(parse_dotenv_line("no equals sign"))
+        self.assertIsNone(parse_dotenv_line("=value"))
+
+
+class LoaderTest(unittest.TestCase):
+    def test_bom_and_mixed_lines(self):
+        path = write_env('﻿export PAYHOOK_REGION="us"\n# c\nPAYHOOK_TIMEOUT=\'5\'\n')
+        config = load_config(environ={}, dotenv_path=path)
+        self.assertEqual(config["PAYHOOK_REGION"], ("us", ".env"))
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("5", ".env"))
+
+    def test_missing_dotenv_falls_back_to_default(self):
+        config = load_config(environ={}, dotenv_path="/nonexistent/.env")
+        self.assertEqual(config["PAYHOOK_REGION"], ("eu", "default"))
+
+
+class DoctorTest(unittest.TestCase):
+    def test_secrets_are_hidden_and_sources_reported(self):
+        path = write_env('export PAYHOOK_API_TOKEN="tok-SECRET-123"\nPAYHOOK_REGION=us\n')
+        report = doctor_report(environ={"PAYHOOK_WEBHOOK_SECRET": "whs-SECRET-456"}, dotenv_path=path)
+        self.assertNotIn("tok-SECRET-123", report)
+        self.assertNotIn("whs-SECRET-456", report)
+        self.assertIn("PAYHOOK_API_TOKEN", report)
+        self.assertIn("<set, hidden>", report)
+        region_line = [l for l in report.splitlines() if l.startswith("PAYHOOK_REGION")][0]
+        self.assertIn("'us'", region_line)
+        self.assertTrue(region_line.endswith(".env"))
+        self.assertIn("missing required: none", report)
+
+    def test_unset_required_secret_is_reported_missing(self):
+        report = doctor_report(environ={}, dotenv_path="/nonexistent/.env")
+        self.assertIn("missing required: PAYHOOK_API_TOKEN, PAYHOOK_WEBHOOK_SECRET", report)
+        self.assertIn("(not found)", report)
+
+    def test_doctor_command_on_repo_dotenv_hides_secrets(self):
+        # Read-only: runs against the repo's .env without modifying it.
+        env = {k: v for k, v in os.environ.items() if not k.startswith("PAYHOOK_")}
+        env["PYTHONPATH"] = ROOT
+        result = subprocess.run(
+            [sys.executable, "-m", "payhook", "doctor"],
+            cwd=ROOT, capture_output=True, text=True, env=env,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("PAYHOOK_ENDPOINT", result.stdout)
+        with open(os.path.join(ROOT, ".env"), encoding="utf-8") as f:
+            for line in f:
+                parsed = parse_dotenv_line(line)
+                if parsed and parsed[0] in ("PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"):
+                    self.assertNotIn(parsed[1], result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
