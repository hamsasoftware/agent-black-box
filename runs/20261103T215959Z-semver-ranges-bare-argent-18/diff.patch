+import unittest
+
+from depres import max_satisfying, satisfies
+
+CASES = [
+    # (range, matching, non-matching)
+    ("", ["0.0.0", "9.9.9"], ["1.0.0-alpha"]),
+    ("*", ["1.2.3"], ["1.2.3-alpha"]),
+    ("1", ["1.0.0", "1.9.9"], ["0.9.9", "2.0.0"]),
+    ("1.2", ["1.2.0", "1.2.9"], ["1.3.0", "1.1.9"]),
+    (">1", ["2.0.0"], ["1.9.9"]),
+    (">1.2", ["1.3.0"], ["1.2.9"]),
+    (">=1.2", ["1.2.0"], ["1.1.9"]),
+    ("<1.2", ["1.1.9"], ["1.2.0"]),
+    ("<=1", ["1.9.9"], ["2.0.0"]),
+    ("<=1.2", ["1.2.9"], ["1.3.0"]),
+    ("=1.2", ["1.2.5"], ["1.3.0"]),
+    ("= 1.2.3", ["1.2.3"], ["1.2.4"]),
+    (">= 1.2.3", ["1.2.3"], ["1.2.2"]),
+    ("1.2.3 - 2.3", ["1.2.3", "2.3.9"], ["2.4.0", "1.2.2"]),
+    ("1.2.3 - 2", ["2.9.9"], ["3.0.0"]),
+    ("1.2 - 2.0.0", ["1.2.0", "2.0.0"], ["2.0.1"]),
+    ("~1.2.3", ["1.2.9"], ["1.3.0", "1.2.2"]),
+    ("~1", ["1.9.0"], ["2.0.0"]),
+    ("~1.2.3-beta.2", ["1.2.3-beta.4", "1.2.3"], ["1.2.3-beta.1", "1.3.0"]),
+    ("^0.0.3", ["0.0.3"], ["0.0.4"]),
+    ("^0.2.3", ["0.2.9"], ["0.3.0"]),
+    ("^1.2.x", ["1.9.0"], ["2.0.0"]),
+    ("^0.0", ["0.0.9"], ["0.1.0"]),
+    ("^0.0.x", ["0.0.9"], ["0.1.0"]),
+    ("^0", ["0.9.9"], ["1.0.0"]),
+    ("^0.x", ["0.9.9"], ["1.0.0"]),
+    ("^1.0.0", ["1.5.0"], ["2.0.0-rc.1", "1.5.0-beta"]),
+    (">=1.2.3-alpha.1 <1.3.0", ["1.2.3-alpha.7"], ["1.2.4-alpha.1"]),
+    ("^1 || ^3", ["3.1.0"], ["2.0.0"]),
+    ("v1.2.3", ["1.2.3"], ["1.2.4"]),
+]
+
+
+class SpecTest(unittest.TestCase):
+    def test_cases(self):
+        for range_, yes, no in CASES:
+            for v in yes:
+                self.assertIs(satisfies(v, range_), True, f"{v} in {range_!r}")
+            for v in no:
+                self.assertIs(satisfies(v, range_), False, f"{v} in {range_!r}")
+
+    def test_invalid(self):
+        for bad in ["1.x.3", ">=", "^", "foo", "1.2.3 -", "1.2.3 - 2 - 3", ">=1.2.3 - 2"]:
+            with self.assertRaises(ValueError, msg=bad):
+                satisfies("1.0.0", bad)
+        with self.assertRaises(ValueError):
+            satisfies("nope", "*")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bad"], "*")
+
+    def test_max_returns_original_string(self):
+        self.assertEqual(max_satisfying(["v1.2.0", "1.1.0+b"], "1.x"), "v1.2.0")
+        self.assertIsNone(max_satisfying([], "*"))
+
+
+if __name__ == "__main__":
+    unittest.main()
