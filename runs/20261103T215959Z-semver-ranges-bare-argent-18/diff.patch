+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = rf"[xX*]|{_NUM}"
+_IDENT = r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+_PARTIAL = re.compile(
+    rf"^[vV]?({_PART})(?:\.({_PART}))?(?:\.({_PART}))?"
+    rf"(?:-({_IDENT}(?:\.{_IDENT})*))?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"
+)
+_OP = re.compile(r"^(<=|>=|<|>|=|~>|~|\^)$")
+_TOKEN = re.compile(r"^(<=|>=|<|>|=|~>|~|\^)?(.*)$")
+
+# Lower than every version: nothing satisfies "< _NEVER".
+_NEVER = ("<", Version(0, 0, 0, ("0",)))
+
+
+def _parse_partial(text):
+    """Return (parts, prerelease); parts is the leading run of concrete numbers."""
+    m = _PARTIAL.match(text)
+    if not m:
+        raise ValueError(f"invalid version in range: {text!r}")
+    pre = m.group(4)
+    parts = []
+    seen_wild = False
+    for g in m.groups()[:3]:
+        if g is None or g in ("x", "X", "*"):
+            seen_wild = True
+        elif seen_wild:
+            raise ValueError(f"invalid range version (number after wildcard): {text!r}")
+        else:
+            parts.append(int(g))
+    if pre and len(parts) < 3:
+        raise ValueError(f"prerelease on partial version: {text!r}")
+    return parts, tuple(pre.split(".")) if pre else ()
+
+
+def _lo(parts, pre=()):
+    p = list(parts) + [0] * (3 - len(parts))
+    return Version(p[0], p[1], p[2], pre)
+
+
+def _next(parts):
+    """Lowest release above everything matching the partial (parts non-empty)."""
+    p = list(parts)
+    p[-1] += 1
+    return _lo(p)
+
+
+def _primitive(op, text):
+    parts, pre = _parse_partial(text)
+    if op in ("", "="):
+        if not parts:
+            return []
+        if len(parts) == 3:
+            return [("=", _lo(parts, pre))]
+        return [(">=", _lo(parts)), ("<", _next(parts))]
+    if not parts:
+        return [] if op in (">=", "<=") else [_NEVER]
+    if len(parts) == 3:
+        return [(op, _lo(parts, pre))]
+    if op == ">":
+        return [(">=", _next(parts))]
+    if op == ">=":
+        return [(">=", _lo(parts))]
+    if op == "<":
+        return [("<", _lo(parts))]
+    return [("<", _next(parts))]  # "<="
+
+
+def _tilde(text):
+    parts, pre = _parse_partial(text)
+    if not parts:
+        return []
+    if len(parts) == 1:
+        return [(">=", _lo(parts)), ("<", _next(parts))]
+    return [(">=", _lo(parts, pre)), ("<", _next(parts[:2]))]
+
+
+def _caret(text):
+    parts, pre = _parse_partial(text)
+    if not parts:
+        return []
+    idx = next((i for i, n in enumerate(parts) if n != 0), len(parts) - 1)
+    return [(">=", _lo(parts, pre)), ("<", _next(parts[: idx + 1]))]
+
+
+def _hyphen(a, b):
+    ap, apre = _parse_partial(a)
+    bp, bpre = _parse_partial(b)
+    out = []
+    if ap:
+        out.append((">=", _lo(ap, apre)))
+    if bp:
+        out.append(("<=", _lo(bp, bpre)) if len(bp) == 3 else ("<", _next(bp)))
+    return out
+
+
+def _parse_set(text):
+    tokens = text.split()
+    # Glue a bare operator to the version that follows it.
+    merged = []
+    i = 0
+    while i < len(tokens):
+        tok = tokens[i]
+        if _OP.match(tok):
+            if i + 1 >= len(tokens):
+                raise ValueError(f"operator without version in range: {text!r}")
+            tok += tokens[i + 1]
+            i += 1
+        merged.append(tok)
+        i += 1
+    if "-" in merged:
+        if len(merged) != 3 or merged[1] != "-":
+            raise ValueError(f"invalid hyphen range: {text!r}")
+        return _hyphen(merged[0], merged[2])
+    comps = []
+    for tok in merged:
+        m = _TOKEN.match(tok)
+        op, rest = m.group(1) or "", m.group(2)
+        if op in ("~", "~>"):
+            comps += _tilde(rest)
+        elif op == "^":
+            comps += _caret(rest)
+        else:
+            comps += _primitive(op, rest)
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(s) for s in range_.split("||")]
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _test(v, op, c):
+    if op == "<":
+        return v < c
+    if op == "<=":
+        return v <= c
+    if op == ">":
+        return v > c
+    if op == ">=":
+        return v >= c
+    return v == c
+
+
+def _set_matches(v, comps):
+    if not all(_test(v, op, c) for op, c in comps):
+        return False
+    if v.prerelease:
+        return any(c.prerelease and c.release == v.release for _, c in comps)
+    return True
+
+
+def _matches(v, sets):
+    return any(_set_matches(v, s) for s in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_coerce(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_v = None, None
+    for item in versions:
+        v = _coerce(item)
+        if _matches(v, sets) and (best_v is None or v > best_v):
+            best, best_v = item, v
+    return best
