+"""npm-style version range matching. The contract is docs/RANGES.md."""
+import operator
+import re
+from functools import lru_cache
+
 from .version import Version
 
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+# Marker for a comparator that can never match (for example "<*").
+_NEVER = "never"
+_ZERO = (0, 0, 0)
+
+_NUM = r"(?:0|[1-9]\d*)"
+_PART = rf"(?:{_NUM}|[xX*])"
+_PARTIAL = re.compile(rf"v?({_PART})(?:\.({_PART}))?(?:\.({_PART}))?")
+_FULL = re.compile(r"v?\d+\.\d+\.\d+(?:[-+].*)?")
+_COMPARATOR = re.compile(r"(<=|>=|<|>|=|~|\^)?(.*)", re.DOTALL)
+_OP_TOKENS = {"<", "<=", ">", ">=", "=", "~", "^"}
+_OPERAND_START = re.compile(r"[vVxX*0-9]")
+
+
+def _operand(text):
+    """A full Version, or a list of the numeric parts of a partial version."""
+    if _FULL.fullmatch(text):
+        return Version.parse(text)
+    match = _PARTIAL.fullmatch(text)
+    if not match:
+        raise ValueError(f"invalid version or range part: {text!r}")
+    nums = []
+    wildcard = False
+    for part in match.groups():
+        if part is None or part in ("x", "X", "*"):
+            wildcard = True
+        elif wildcard:
+            raise ValueError(f"number after wildcard in {text!r}")
+        else:
+            nums.append(int(part))
+    return nums
+
+
+def _release(nums):
+    return tuple(nums) + (0,) * (3 - len(nums))
+
+
+def _lower(operand):
+    """The lowest version a partial or full operand stands for."""
+    if isinstance(operand, Version):
+        return operand
+    return Version(*_release(operand))
+
+
+def _bump(nums, index):
+    """Release with the position at `index` incremented and the rest zeroed."""
+    head = list(nums[: index + 1])
+    head[index] += 1
+    return Version(*_release(head))
+
+
+def _primitive(op, operand):
+    """Comparators for `op operand`, where op is one of "", "=", "<", "<=", ">", ">="."""
+    if isinstance(operand, Version):
+        return [(op or "=", operand)]
+    n = len(operand)
+    if n == 0:
+        if op in ("<", ">"):
+            return [(_NEVER, None)]
+        return [(">=", Version(*_ZERO))]
+    base = _lower(operand)
+    ceil = _bump(operand, n - 1)
+    if op in ("", "="):
+        return [(">=", base), ("<", ceil)]
+    return {
+        ">": [(">=", ceil)],
+        ">=": [(">=", base)],
+        "<": [("<", base)],
+        "<=": [("<", ceil)],
+    }[op]
+
+
+def _tilde(operand):
+    nums = operand.release if isinstance(operand, Version) else operand
+    if len(nums) == 0:
+        return [(">=", Version(*_ZERO))]
+    index = 0 if len(nums) == 1 else 1
+    return [(">=", _lower(operand)), ("<", _bump(nums, index))]
+
+
+def _caret(operand):
+    nums = operand.release if isinstance(operand, Version) else operand
+    if len(nums) == 0:
+        return [(">=", Version(*_ZERO))]
+    index = next((i for i, n in enumerate(nums) if n != 0), len(nums) - 1)
+    return [(">=", _lower(operand)), ("<", _bump(nums, index))]
+
+
+def _hyphen(low, high):
+    comparators = [(">=", _lower(low))]
+    if isinstance(high, Version):
+        comparators.append(("<=", high))
+    elif len(high) > 0:
+        comparators.append(("<", _bump(high, len(high) - 1)))
+    return comparators
+
+
+def _parse_set(text):
+    tokens = []
+    i = 0
+    raw = text.split()
+    while i < len(raw):
+        # Join an operator to a following version: ">= 1.2.3" is ">=1.2.3".
+        if raw[i] in _OP_TOKENS and i + 1 < len(raw) and _OPERAND_START.match(raw[i + 1]):
+            tokens.append(raw[i] + raw[i + 1])
+            i += 2
+        else:
+            tokens.append(raw[i])
+            i += 1
+
+    comparators = []
+    i = 0
+    while i < len(tokens):
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range in {text!r}")
+            comparators += _hyphen(_operand(tokens[i]), _operand(tokens[i + 2]))
+            i += 3
+            continue
+        match = _COMPARATOR.fullmatch(tokens[i])
+        op, body = match.group(1) or "", match.group(2)
+        if op in ("~", "^"):
+            operand = _operand(body)
+            comparators += _tilde(operand) if op == "~" else _caret(operand)
+        else:
+            comparators += _primitive(op, _operand(body))
+        i += 1
+    return tuple(comparators)
+
+
+@lru_cache(maxsize=1024)
+def _parse_range(range_):
+    return tuple(_parse_set(part) for part in range_.split("||"))
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    return Version.parse(version)
+
+
+def _matches_set(comparators, version):
+    if any(op == _NEVER for op, _ in comparators):
+        return False
+    # Prerelease versions only match if a comparator in the set names the
+    # same release with a prerelease tag.
+    if version.prerelease and not any(
+        bound.prerelease and bound.release == version.release
+        for _, bound in comparators
+    ):
+        return False
+    return all(_OPS[op](version, bound) for op, bound in comparators)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    version = _coerce(version)
+    return any(_matches_set(comparators, version) for comparators in _parse_range(range_))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        version = _coerce(item)
+        if best_version is not None and not version > best_version:
+            continue
+        if any(_matches_set(comparators, version) for comparators in sets):
+            best, best_version = item, version
+    return best
