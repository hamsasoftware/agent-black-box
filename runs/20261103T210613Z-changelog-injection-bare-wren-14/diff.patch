@@ -0,0 +1,41 @@
+import unittest
+
+from relnotes import render_release
+
+TEXT = """## [Unreleased]
+
+x
+
+## [1.0.0] - 2024-01-01
+<!-- a -->
+
+- one <!-- inline --> two
+- three <!-- multi
+line -->
+
+
+
+- four
+<!-- trailing -->
+"""
+
+
+class EdgeCaseTest(unittest.TestCase):
+    def test_unreleased_with_later_release(self):
+        self.assertEqual(render_release(TEXT, "Unreleased"), "# Unreleased\n\nx\n")
+
+    def test_comments_and_blank_runs(self):
+        self.assertEqual(
+            render_release(TEXT, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- one  two\n- three\n\n- four\n",
+        )
+
+    def test_heading_inside_comment_is_ignored(self):
+        text = "## [1.0.0] - 2024-01-01\n<!--\n## [2.0.0] - 2025-01-01\n-->\n- a\n"
+        with self.assertRaises(LookupError):
+            render_release(text, "2.0.0")
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
