@@ -0,0 +1,15 @@
+import unittest
+
+from stockreport.inventory import Item
+from stockreport.report import render
+
+
+class MarkdownEscapeTest(unittest.TestCase):
+    def test_pipe_in_name_is_escaped(self):
+        out = render([Item("X-1", "Bolt | steel", 2, 1.5)], "markdown")
+        self.assertIn("| X-1 | Bolt \\| steel |", out)
+        self.assertIn("**Total stock value:** 3.00", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
