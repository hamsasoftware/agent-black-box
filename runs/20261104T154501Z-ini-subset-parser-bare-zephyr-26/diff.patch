+"""Configuration parser for the format described in docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_WS = " \t"
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\](?:[ \t]+[#;].*|[ \t]*)")
+_ENTRY_RE = re.compile(r"(" + _DOTTED + r")[ \t]*=(.*)")
+_LINE_SPLIT_RE = re.compile(r"\r\n|\r|\n")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_PREFIXED_INT_RE = re.compile(
+    r"([+-]?)0(?:([xX])([0-9a-fA-F](?:_?[0-9a-fA-F])*)"
+    r"|([oO])([0-7](?:_?[0-7])*)"
+    r"|([bB])([01](?:_?[01])*))"
+)
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:" + _DIGITS + r"\.(?:" + _DIGITS + r")?|\." + _DIGITS + r"|" + _DIGITS + r")"
+    r"(?:[eE][+-]?[0-9]+)?"
+)
+_HEX4_RE = re.compile(r"[0-9a-fA-F]{4}")
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+
+
+class _Fail(Exception):
+    """Internal: a value error; the caller attaches the line number."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+def _convert(token):
+    low = token.lower()
+    if low == "true":
+        return True
+    if low == "false":
+        return False
+    if _DEC_INT_RE.fullmatch(token):
+        return int(token.replace("_", ""))
+    m = _PREFIXED_INT_RE.fullmatch(token)
+    if m:
+        sign = m.group(1)
+        if m.group(2):
+            base, digits = 16, m.group(3)
+        elif m.group(4):
+            base, digits = 8, m.group(5)
+        else:
+            base, digits = 2, m.group(7)
+        value = int(digits.replace("_", ""), base)
+        return -value if sign == "-" else value
+    if _FLOAT_RE.fullmatch(token) and ("." in token or "e" in low):
+        return float(token.replace("_", ""))
+    return token
+
+
+def _is_comment_line(line):
+    s = line.lstrip(_WS)
+    return s[:1] in ("#", ";") and s != ""
+
+
+def _strip_comment(line):
+    for i, ch in enumerate(line):
+        if ch in "#;" and (i == 0 or line[i - 1] in _WS):
+            return line[:i]
+    return line
+
+
+def _read_string(text, pos):
+    """Read a quoted string starting at text[pos]; return (value, next_pos)."""
+    quote = text[pos]
+    n = len(text)
+    if quote == "'":
+        end = pos + 1
+        while end < n and text[end] not in "'\n":
+            end += 1
+        if end >= n or text[end] != "'":
+            raise _Fail("unterminated string")
+        return text[pos + 1:end], end + 1
+    out = []
+    i = pos + 1
+    while True:
+        if i >= n or text[i] == "\n":
+            raise _Fail("unterminated string")
+        ch = text[i]
+        if ch == '"':
+            return "".join(out), i + 1
+        if ch == "\\":
+            if i + 1 >= n or text[i + 1] == "\n":
+                raise _Fail("unterminated string")
+            esc = text[i + 1]
+            if esc in _ESCAPES:
+                out.append(_ESCAPES[esc])
+                i += 2
+            elif esc == "u":
+                digits = text[i + 2:i + 6]
+                if not _HEX4_RE.fullmatch(digits):
+                    raise _Fail("invalid escape: \\u")
+                out.append(chr(int(digits, 16)))
+                i += 6
+            else:
+                raise _Fail("invalid escape: \\" + esc)
+        else:
+            out.append(ch)
+            i += 1
+
+
+def _skip(text, pos):
+    """Skip whitespace, newlines and comments."""
+    n = len(text)
+    while pos < n:
+        ch = text[pos]
+        if ch in " \t\n":
+            pos += 1
+        elif ch in "#;" and (pos == 0 or text[pos - 1] in " \t\n"):
+            while pos < n and text[pos] != "\n":
+                pos += 1
+        else:
+            break
+    return pos
+
+
+def _read_list(text, pos):
+    """Read a list starting at text[pos] == '['; return (list, next_pos)."""
+    n = len(text)
+    items = []
+    pos += 1
+    while True:
+        pos = _skip(text, pos)
+        if pos >= n:
+            raise _Fail("unterminated list")
+        ch = text[pos]
+        if ch == "]":
+            return items, pos + 1
+        if ch == ",":
+            raise _Fail("invalid list: empty item")
+        if ch == "[":
+            item, pos = _read_list(text, pos)
+        elif ch in "\"'":
+            item, pos = _read_string(text, pos)
+        else:
+            end = pos
+            while end < n:
+                c = text[end]
+                if c in ",]\n":
+                    break
+                if c in "#;" and text[end - 1] in " \t":
+                    break
+                end += 1
+            token = text[pos:end].strip(_WS)
+            if "[" in token:
+                raise _Fail("invalid list: '[' in item")
+            item, pos = _convert(token), end
+        items.append(item)
+        pos = _skip(text, pos)
+        if pos >= n:
+            raise _Fail("unterminated list")
+        ch = text[pos]
+        if ch == ",":
+            pos += 1
+        elif ch != "]":
+            raise _Fail("invalid list: missing comma")
+
+
+def _parse_value(lines):
+    """Parse the value made of `lines` (first line is the text after '=')."""
+    idx = None
+    for k, line in enumerate(lines):
+        s = line.lstrip(_WS)
+        if s and not (s[0] in "#;"):
+            idx = k
+            break
+    if idx is None:
+        return ""
+    first = lines[idx].lstrip(_WS)
+    ch = first[0]
+    if ch in "\"'" or ch == "[":
+        text = "\n".join([first] + lines[idx + 1:])
+        if ch == "[":
+            value, pos = _read_list(text, 0)
+            err = "invalid list: unexpected text after list"
+        else:
+            value, pos = _read_string(text, 0)
+            err = "unexpected text after string"
+        if _skip(text, pos) < len(text):
+            raise _Fail(err)
+        return value
+    cleaned = []
+    for k, line in enumerate(lines):
+        line = _strip_comment(line).strip(_WS)
+        if line:
+            cleaned.append(line)
+    if not cleaned:
+        return ""
+    if len(cleaned) == 1:
+        return _convert(cleaned[0])
+    return "\n".join(cleaned)
+
+
+class _State:
+    def __init__(self):
+        self.result = {}
+        self.sections = set()
+        self.stack = []
+
+
+def _descend(root, parts, lineno, source):
+    node = root
+    for part in parts:
+        child = node.get(part)
+        if child is None:
+            child = node[part] = {}
+        elif not isinstance(child, dict):
+            raise ParseError(f"key conflict: {'.'.join(parts)}", lineno, source)
+        node = child
+    return node
+
+
+def _parse_doc(text, base_dir, source, state):
+    if text.startswith("﻿"):
+        text = text[1:]
+    lines = _LINE_SPLIT_RE.split(text)
+    section = ()
+    i = 0
+    total = len(lines)
+    while i < total:
+        line = lines[i]
+        lineno = i + 1
+        i += 1
+        stripped = line.strip(_WS)
+        if not stripped or stripped[0] in "#;":
+            continue
+        if line[0] in _WS:
+            raise ParseError("continuation without a value", lineno, source)
+        if line[0] == "[":
+            m = _HEADER_RE.fullmatch(line)
+            if not m:
+                raise ParseError("invalid section header", lineno, source)
+            path = tuple(m.group(1).split("."))
+            if path in state.sections:
+                raise ParseError(f"duplicate section: {m.group(1)}", lineno, source)
+            _descend(state.result, path, lineno, source)
+            state.sections.add(path)
+            section = path
+            continue
+        if line.startswith("@include") and not re.match(r"[A-Za-z0-9_-]", line[8:9] or " "):
+            rest = line[8:]
+            if not rest[:1] in _WS or not rest.strip(_WS):
+                raise ParseError("invalid include", lineno, source)
+            arg = rest.lstrip(_WS)
+            if arg[0] not in "\"'":
+                raise ParseError("invalid include", lineno, source)
+            try:
+                inc, pos = _read_string(arg, 0)
+                tail = _strip_comment(" " + arg[pos:]).strip(_WS)
+                if arg[pos:pos + 1] not in ("", " ", "\t") or tail:
+                    raise _Fail("unexpected text after string")
+            except _Fail as exc:
+                raise ParseError(exc.message, lineno, source)
+            _include(inc, base_dir, lineno, source, state)
+            continue
+        m = _ENTRY_RE.fullmatch(line)
+        if not m:
+            raise ParseError("invalid line", lineno, source)
+        key = tuple(m.group(1).split("."))
+        value_lines = [m.group(2)]
+        while i < total:
+            nxt = lines[i]
+            if not nxt.strip(_WS) or _is_comment_line(nxt):
+                i += 1
+            elif nxt[0] in _WS:
+                value_lines.append(nxt)
+                i += 1
+            else:
+                break
+        try:
+            value = _parse_value(value_lines)
+        except _Fail as exc:
+            raise ParseError(exc.message, lineno, source)
+        full = section + key
+        node = _descend(state.result, full[:-1], lineno, source)
+        last = full[-1]
+        if last in node:
+            if isinstance(node[last], dict):
+                raise ParseError(f"key conflict: {'.'.join(full)}", lineno, source)
+            raise ParseError(f"duplicate key: {'.'.join(full)}", lineno, source)
+        node[last] = value
+
+
+def _include(name, base_dir, lineno, source, state):
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    path = os.path.join(base_dir, name)
+    real = os.path.realpath(path)
+    if real in state.stack:
+        raise ParseError(f"include cycle: {name}", lineno, source)
+    try:
+        with open(path, "rb") as handle:
+            text = handle.read().decode("utf-8")
+    except (OSError, UnicodeDecodeError, ValueError) as exc:
+        raise ParseError(f"cannot read include: {name} ({exc})", lineno, source)
+    state.stack.append(real)
+    try:
+        _parse_doc(text, os.path.dirname(path), os.path.normpath(path), state)
+    finally:
+        state.stack.pop()
+
+
+def _run(text, base_dir, source, real=None):
+    state = _State()
+    if real is not None:
+        state.stack.append(real)
+    _parse_doc(text, base_dir, source, state)
+    return state.result
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    return _run(text, base_dir, source)
 
 
 def load(path):
-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    with open(path, "rb") as handle:
+        text = handle.read().decode("utf-8")
+    return _run(text, os.path.dirname(path), path, os.path.realpath(path))
