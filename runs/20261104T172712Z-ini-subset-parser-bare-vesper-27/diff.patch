+class CommandLineErrorTest(unittest.TestCase):
+    def run_cli(self, args):
+        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        return subprocess.run([sys.executable, "-m", "confkit"] + args,
+                              cwd=root, capture_output=True, text=True)
+
+    def test_missing_get_key_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("[server]\nport = 9000\n")
+            result = self.run_cli([path, "--get", "server.host"])
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stderr.strip(), "no such key: server.host")
+
+    def test_parse_error_exits_1(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("a = 1\nb = \"open\n")
+            result = self.run_cli([path])
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stderr.strip(), path + ':2: unterminated string')
+
+    def test_full_json_output(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("name = x\n[s]\nhosts =\n    a\n    b  # c\n")
+            result = self.run_cli([path])
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('"hosts": "a\\nb"', result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
