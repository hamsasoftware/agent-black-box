 """
-import inilite
+import os
+import re
 
 from .errors import ParseError
 
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\]")
+_ENTRY_RE = re.compile("(" + _DOTTED + r")[ \t]*=")
+_NAME_CHAR_RE = re.compile(r"[A-Za-z0-9_-]")
+_LINE_END_RE = re.compile(r"\r\n|\n|\r")
+
+_DIG = r"[0-9](?:_?[0-9])*"
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_PREFIXED_INT_RE = re.compile(
+    r"[+-]?(?:0[xX](?:_?[0-9a-fA-F])+|0[oO](?:_?[0-7])+|0[bB](?:_?[01])+)"
+)
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:(?:" + _DIG + r"\.(?:" + _DIG + r")?|\." + _DIG + r")(?:[eE][+-]?[0-9]+)?"
+    r"|" + _DIG + r"[eE][+-]?[0-9]+)"
+)
+
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX_DIGITS = "0123456789abcdefABCDEF"
+
+
+class _Fail(Exception):
+    """A value-level error. The caller attaches the line number."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    return _Document().process(text, source, base_dir, ())
 
 
 def load(path):
+    base_dir = os.path.dirname(path)
     with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+        text = handle.read()
+    return _Document().process(text, path, base_dir, (os.path.realpath(path),))
+
+
+class _Entry:
+    def __init__(self, path, lineno, first):
+        self.path = path
+        self.lineno = lineno
+        self.first = first
+        self.conts = []
+
+
+class _Document:
+    def __init__(self):
+        self.result = {}
+        self.defined = set()
+
+    def process(self, text, source, base_dir, chain):
+        """Parse one file's text into self.result. chain holds the real paths of
+        the files being included, outermost first, for cycle detection."""
+        if text.startswith("﻿"):
+            text = text[1:]
+        section = ()
+        pending = None
+        for lineno, line in enumerate(_LINE_END_RE.split(text), 1):
+            stripped = line.lstrip(" \t")
+            if not stripped or stripped[0] in "#;":
+                continue
+            if line[0] in " \t":
+                if pending is None:
+                    raise ParseError("continuation without a value", lineno, source)
+                pending.conts.append(stripped.rstrip(" \t"))
+                continue
+            if pending is not None:
+                self._finish_entry(pending, source)
+                pending = None
+            if line[0] == "[":
+                section = self._header(line, lineno, source)
+            elif _is_include(line):
+                self._include(line, lineno, source, base_dir, chain)
+            else:
+                match = _ENTRY_RE.match(line)
+                if match is None:
+                    raise ParseError("invalid line: " + line.strip(), lineno, source)
+                pending = _Entry(section + tuple(match.group(1).split(".")),
+                                 lineno, line[match.end():])
+        if pending is not None:
+            self._finish_entry(pending, source)
+        return self.result
+
+    def _finish_entry(self, entry, source):
+        try:
+            value = _parse_value(entry.first, entry.conts)
+        except _Fail as exc:
+            raise ParseError(exc.message, entry.lineno, source)
+        self._store(entry.path, value, entry.lineno, source)
+
+    def _store(self, path, value, lineno, source):
+        table = self.result
+        for name in path[:-1]:
+            if name not in table:
+                table[name] = {}
+            elif not isinstance(table[name], dict):
+                raise ParseError("key conflict: " + ".".join(path), lineno, source)
+            table = table[name]
+        last = path[-1]
+        if last in table:
+            if isinstance(table[last], dict):
+                raise ParseError("key conflict: " + ".".join(path), lineno, source)
+            raise ParseError("duplicate key: " + ".".join(path), lineno, source)
+        table[last] = value
+
+    def _header(self, line, lineno, source):
+        match = _HEADER_RE.match(line)
+        if match is None:
+            raise ParseError("invalid section header: " + line.strip(), lineno, source)
+        rest = line[match.end():]
+        after = rest.lstrip(" \t")
+        if after and not (len(after) < len(rest) and after[0] in "#;"):
+            raise ParseError("invalid section header: " + line.strip(), lineno, source)
+        path = tuple(match.group(1).split("."))
+        name = ".".join(path)
+        if path in self.defined:
+            raise ParseError("duplicate section: [" + name + "]", lineno, source)
+        table = self.result
+        for part in path:
+            if part not in table:
+                table[part] = {}
+            elif not isinstance(table[part], dict):
+                raise ParseError("key conflict: [" + name + "]", lineno, source)
+            table = table[part]
+        self.defined.add(path)
+        return path
+
+    def _include(self, line, lineno, source, base_dir, chain):
+        rest = line[len("@include"):]
+        after_ws = rest.lstrip(" \t")
+        if not after_ws or len(after_ws) == len(rest):
+            raise ParseError("invalid include: expected a quoted path", lineno, source)
+        if after_ws[0] not in "\"'":
+            raise ParseError("invalid include: path must be quoted", lineno, source)
+        try:
+            name, end = _read_quoted(after_ws, 0)
+        except _Fail as exc:
+            raise ParseError("invalid include: " + exc.message, lineno, source)
+        tail = after_ws[end:]
+        stripped_tail = tail.lstrip(" \t")
+        if stripped_tail and not (len(stripped_tail) < len(tail) and stripped_tail[0] in "#;"):
+            raise ParseError("invalid include: unexpected text after path", lineno, source)
+        if base_dir is None:
+            raise ParseError("include needs a base directory", lineno, source)
+        target = os.path.normpath(os.path.join(base_dir, name))
+        real = os.path.realpath(target)
+        if real in chain:
+            raise ParseError("include cycle: " + name, lineno, source)
+        try:
+            with open(target, encoding="utf-8") as handle:
+                text = handle.read()
+        except (OSError, ValueError) as exc:
+            raise ParseError("cannot read include " + name + ": " + str(exc), lineno, source)
+        self.process(text, target, os.path.dirname(target), chain + (real,))
+
+
+def _is_include(line):
+    if not line.startswith("@include"):
+        return False
+    return len(line) == len("@include") or _NAME_CHAR_RE.match(line[len("@include")]) is None
+
+
+def _parse_value(first, conts):
+    first = first.strip(" \t")
+    if first[:1] in ("#", ";"):
+        first = ""
+    segs = ([first] if first else []) + conts
+    if not segs:
+        return ""
+    head = segs[0][0]
+    if head in ("\"", "'"):
+        return _quoted_value(segs)
+    if head == "[":
+        text = "\n".join(segs)
+        items, end = _read_list(text, 0)
+        if _skip(text, end) < len(text):
+            raise _Fail("invalid list: text after closing bracket")
+        return items
+    lines = [_strip_comment(seg).strip(" \t") for seg in segs]
+    lines = [line for line in lines if line]
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _quoted_value(segs):
+    seg = segs[0]
+    value, end = _read_quoted(seg, 0)
+    tail = seg[end:]
+    stripped_tail = tail.lstrip(" \t")
+    ok = not stripped_tail or (len(stripped_tail) < len(tail) and stripped_tail[0] in "#;")
+    if len(segs) > 1 or not ok:
+        raise _Fail("unexpected text after string")
+    return value
+
+
+def _read_quoted(s, i):
+    """Read the quoted string starting at s[i]. Returns (value, index after the
+    closing quote). The string must close before the end of the line."""
+    quote = s[i]
+    out = []
+    j = i + 1
+    n = len(s)
+    while True:
+        if j >= n or s[j] == "\n":
+            raise _Fail("unterminated string")
+        c = s[j]
+        if c == quote:
+            return "".join(out), j + 1
+        if c == "\\" and quote == '"':
+            if j + 1 >= n or s[j + 1] == "\n":
+                raise _Fail("unterminated string")
+            e = s[j + 1]
+            if e in _ESCAPES:
+                out.append(_ESCAPES[e])
+                j += 2
+                continue
+            if e == "u":
+                digits = s[j + 2:j + 6]
+                if len(digits) == 4 and all(d in _HEX_DIGITS for d in digits):
+                    out.append(chr(int(digits, 16)))
+                    j += 6
+                    continue
+            raise _Fail("invalid escape")
+        out.append(c)
+        j += 1
+
+
+def _read_list(s, i):
+    """Read the list starting at s[i] == "[". Returns (items, index after "]")."""
+    items = []
+    n = len(s)
+    j = i + 1
+    while True:
+        j = _skip(s, j)
+        if j >= n:
+            raise _Fail("unterminated list")
+        c = s[j]
+        if c == "]":
+            return items, j + 1
+        if c == ",":
+            raise _Fail("invalid list: empty item")
+        if c == "[":
+            value, j = _read_list(s, j)
+        elif c in "\"'":
+            value, j = _read_quoted(s, j)
+        else:
+            k = j
+            while k < n and s[k] not in ",][\n" and not (s[k] in "#;" and s[k - 1] in " \t"):
+                k += 1
+            if k < n and s[k] == "[":
+                raise _Fail("invalid list")
+            value = _scalar(s[j:k].strip(" \t"))
+            j = k
+        items.append(value)
+        j = _skip(s, j)
+        if j >= n:
+            raise _Fail("unterminated list")
+        if s[j] == ",":
+            j += 1
+            continue
+        if s[j] == "]":
+            return items, j + 1
+        raise _Fail("invalid list")
+
+
+def _skip(s, j):
+    """Skip whitespace (including newlines) and comments inside a list."""
+    n = len(s)
+    while j < n:
+        c = s[j]
+        if c in " \t\n":
+            j += 1
+        elif c in "#;" and (j == 0 or s[j - 1] in " \t\n"):
+            k = s.find("\n", j)
+            j = n if k < 0 else k
+        else:
+            break
+    return j
+
+
+def _strip_comment(seg):
+    for i, c in enumerate(seg):
+        if c in "#;" and (i == 0 or seg[i - 1] in " \t"):
+            return seg[:i]
+    return seg
+
+
+def _scalar(text):
+    low = text.lower()
+    if low == "true":
+        return True
+    if low == "false":
+        return False
+    if _DEC_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 10)
+    if _PREFIXED_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 0)
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
