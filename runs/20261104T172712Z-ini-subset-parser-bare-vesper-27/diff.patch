+class IncludeTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.dir = self.tmp.name
+
+    def write(self, name, text):
+        path = os.path.join(self.dir, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_needs_base_dir_in_loads(self):
+        err = error_of('@include "x.ini"\n')
+        self.assertTrue(err.message.startswith("include needs a base directory"))
+
+    def test_base_dir_resolves_relative_path(self):
+        self.write("sub/inner.ini", "v = 1\n")
+        self.assertEqual(loads('@include "sub/inner.ini"\n', base_dir=self.dir), {"v": 1})
+
+    def test_include_starts_at_top_level_and_parent_resumes_section(self):
+        self.write("part.ini", "[other]\nz = 9\n")
+        text = '[main]\n@include "part.ini"\nafter = 1\n'
+        self.assertEqual(loads(text, base_dir=self.dir),
+                         {"main": {"after": 1}, "other": {"z": 9}})
+
+    def test_included_file_without_section_gets_top_level(self):
+        self.write("top.ini", "k = 1\n")
+        self.assertEqual(loads('[s]\n@include "top.ini"\n', base_dir=self.dir),
+                         {"s": {}, "k": 1})
+
+    def test_invalid_include_forms(self):
+        for text in (
+            "@include\n",
+            "@include x.ini\n",
+            '@include"x.ini"\n',
+            '@include "x.ini\n',
+            '@include "x.ini" extra\n',
+            '@include "x.ini"#c\n',
+            '@include "bad\\q.ini"\n',
+        ):
+            with self.subTest(text=text):
+                err = error_of(text, base_dir=self.dir)
+                self.assertTrue(err.message.startswith("invalid include"), err.message)
+                self.assertEqual(err.lineno, 1)
+
+    def test_includes_word_is_invalid_line(self):
+        self.assertTrue(error_of("@includes \"x\"\n").message.startswith("invalid line"))
+
+    def test_missing_include_is_cannot_read(self):
+        err = error_of('a = 1\n@include "nope.ini"\n', base_dir=self.dir)
+        self.assertTrue(err.message.startswith("cannot read include"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_directory_include_is_cannot_read(self):
+        os.makedirs(os.path.join(self.dir, "d"))
+        err = error_of('@include "d"\n', base_dir=self.dir)
+        self.assertTrue(err.message.startswith("cannot read include"))
+
+    def test_error_inside_include_uses_its_source_and_line(self):
+        self.write("sub/bad.ini", "ok = 1\nx = [1, \"b\" \"c\"]\n")
+        main = self.write("main.ini", '@include "sub/bad.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        err = ctx.exception
+        self.assertTrue(err.message.startswith("invalid list"))
+        self.assertEqual(err.lineno, 2)
+        self.assertEqual(err.source, os.path.normpath(os.path.join(self.dir, "sub/bad.ini")))
+
+    def test_include_continuation_is_error(self):
+        self.write("c.ini", "x = 1\n")
+        err = error_of('@include "c.ini"\n  more\n', base_dir=self.dir)
+        self.assertTrue(err.message.startswith("continuation without a value"))
+
+    def test_same_file_included_twice_is_not_a_cycle(self):
+        self.write("shared.ini", "[s]\nv = 1\n")
+        self.write("a.ini", '@include "shared.ini"\n')
+        main = self.write("main.ini", '@include "a.ini"\n@include "shared.ini"\n')
+        err = None
+        try:
+            load(main)
+        except ParseError as exc:
+            err = exc
+        self.assertIsNotNone(err)
+        self.assertTrue(err.message.startswith("duplicate section"))
+        self.assertEqual(err.lineno, 1)
+
+    def test_self_include_is_cycle(self):
+        main = self.write("self.ini", '@include "self.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("include cycle"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_load_missing_file_is_oserror(self):
+        with self.assertRaises(OSError) as ctx:
+            load(os.path.join(self.dir, "missing.ini"))
+        self.assertNotIsInstance(ctx.exception, ParseError)
+
+    def test_load_source_is_path_as_given(self):
+        path = self.write("c.ini", "x = [\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(path)
+        self.assertEqual(ctx.exception.source, path)
+        self.assertEqual(ctx.exception.lineno, 1)
+
