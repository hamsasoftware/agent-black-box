+"""Tests for the rules in docs/FORMAT.md that tests/test_parse.py does not cover."""
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def error_of(text, **kwargs):
+    with self_raises() as holder:
+        loads(text, **kwargs)
+    return holder["error"]
+
+
+class self_raises:
+    """Context manager that captures a ParseError into a dict."""
+
+    def __enter__(self):
+        self.holder = {}
+        return self.holder
+
+    def __exit__(self, exc_type, exc, tb):
+        if exc_type is None:
+            raise AssertionError("expected ParseError, nothing was raised")
+        if not issubclass(exc_type, ParseError):
+            return False
+        self.holder["error"] = exc
+        return True
+
+
+class LineTest(unittest.TestCase):
+    def test_crlf_and_cr_line_endings(self):
+        self.assertEqual(loads("a = 1\r\nb = 2\rc = 3\n"), {"a": 1, "b": 2, "c": 3})
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+    def test_blank_and_indented_comment_lines(self):
+        text = "a =\n   x\n\n   # inside\n   y\n"
+        self.assertEqual(loads(text), {"a": "x\ny"})
+
+    def test_continuation_without_value(self):
+        for text in ("   x\n", "[s]\n  x = 1\n"):
+            with self.subTest(text=text):
+                err = error_of(text)
+                self.assertTrue(err.message.startswith("continuation without a value"))
+
+    def test_invalid_line(self):
+        err = error_of("ok = 1\n1bad = 2\n")
+        self.assertEqual(err.lineno, 2)
+        self.assertTrue(err.message.startswith("invalid line"))
+
+    def test_invalid_section_headers(self):
+        for text in ("[a.]\n", "[]\n", "[a\n", "[a]x\n", "[a]#x\n", "[a b]\n"):
+            with self.subTest(text=text):
+                err = error_of(text)
+                self.assertTrue(err.message.startswith("invalid section header"))
+                self.assertEqual(err.lineno, 1)
+
+    def test_header_with_inline_comment_and_inner_spaces(self):
+        self.assertEqual(loads("[ a.b ]  # note\nx = 1\n"), {"a": {"b": {"x": 1}}})
+
+
+class ScalarTest(unittest.TestCase):
+    def test_booleans_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\n"), {"a": True, "b": False})
+
+    def test_integers(self):
+        self.assertEqual(
+            loads("a = -0\nb = 1_000\nc = +7\nd = 0xFF\ne = -0b101\nf = 0o17\ng = 0XaB\n"),
+            {"a": 0, "b": 1000, "c": 7, "d": 255, "e": -5, "f": 15, "g": 171},
+        )
+
+    def test_floats(self):
+        self.assertEqual(
+            loads("a = .5\nb = 5.\nc = 1e3\nd = -2.5E-3\ne = 1_0.2\nf = 00.5\ng = 007e1\n"),
+            {"a": 0.5, "b": 5.0, "c": 1000.0, "d": -0.0025, "e": 10.2, "f": 0.5, "g": 70.0},
+        )
+
+    def test_strings_that_look_numeric(self):
+        text = "a = 007\nb = 1__0\nc = _1\nd = inf\ne = nan\nf = yes\ng = 1.2.3\nh = 0x\ni = 1e\nj = +\nk = .\nl = 1_\n"
+        self.assertEqual(loads(text), {
+            "a": "007", "b": "1__0", "c": "_1", "d": "inf", "e": "nan", "f": "yes",
+            "g": "1.2.3", "h": "0x", "i": "1e", "j": "+", "k": ".", "l": "1_",
+        })
+
+    def test_quoted_value_is_never_converted(self):
+        self.assertEqual(loads('a = "true"\nb = "12"\nc = \'1.5\'\n'),
+                         {"a": "true", "b": "12", "c": "1.5"})
+
+    def test_plain_multiline_values_are_not_converted(self):
+        self.assertEqual(loads("a =\n  1\n  2\n"), {"a": "1\n2"})
+
+    def test_empty_value(self):
+        self.assertEqual(loads("a =\nb = # only a comment\n"), {"a": "", "b": ""})
+
+
+class QuotedTest(unittest.TestCase):
+    def test_escapes(self):
+        self.assertEqual(loads('a = "q\\"x\\\\y\\n\\r\\0\\u00e9"\n'),
+                         {"a": 'q"x\\y\n\r\0\u00e9'})
+
+    def test_single_quotes_have_no_escapes(self):
+        self.assertEqual(loads("a = 'x\\'\n"), {"a": "x\\"})
+
+    def test_invalid_escape(self):
+        for text in ('a = "\\q"\n', 'a = "\\u12"\n', 'a = "\\uZZZZ"\n'):
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid escape"))
+
+    def test_backslash_at_end_of_line_is_unterminated(self):
+        self.assertTrue(error_of('a = "abc\\\n').message.startswith("unterminated string"))
+
+    def test_text_after_string(self):
+        self.assertEqual(error_of('a = "x"y\n').message.split(":")[0], "unexpected text after string")
+        self.assertEqual(loads('a = "x"  # ok\n'), {"a": "x"})
+        self.assertTrue(error_of('a = "x"#y\n').message.startswith("unexpected text after string"))
+
+    def test_string_cannot_span_lines(self):
+        err = error_of('a = "one\n  two"\n')
+        self.assertTrue(err.message.startswith("unterminated string"))
+        self.assertEqual(err.lineno, 1)
+
+
+class CommentTest(unittest.TestCase):
+    def test_hash_inside_word_is_not_a_comment(self):
+        self.assertEqual(loads("x = a;b\ny = a#b # real\n"), {"x": "a;b", "y": "a#b"})
+
+    def test_semicolon_comment(self):
+        self.assertEqual(loads("x = 1 ; note\n"), {"x": 1})
+
+
+class ListTest(unittest.TestCase):
+    def test_nested_and_trailing_comma(self):
+        self.assertEqual(loads("a = [1, [2, 3], x,]\n"), {"a": [1, [2, 3], "x"]})
+
+    def test_quote_inside_unquoted_item_is_ordinary(self):
+        self.assertEqual(loads("a = [it's, \"b\"]\n"), {"a": ["it's", "b"]})
+
+    def test_comments_in_multiline_list(self):
+        text = 'a = [\n    "x # not a comment",  # real comment\n    # whole line\n    2\n    ]\n'
+        self.assertEqual(loads(text), {"a": ["x # not a comment", 2]})
+
+    def test_items_are_scalars_except_quoted(self):
+        self.assertEqual(loads("a = [true, '5', 0x10]\n"), {"a": [True, "5", 16]})
+
+    def test_empty_items(self):
+        for text in ("a = [1,,2]\n", "a = [,]\n"):
+            with self.subTest(text=text):
+                self.assertTrue(error_of(text).message.startswith("invalid list"))
+
+    def test_unquoted_token_runs_to_comma_or_bracket(self):
+        self.assertEqual(loads("a = [1 2, x y ]\n"), {"a": ["1 2", "x y"]})
+
+    def test_missing_comma_after_quoted_or_nested_item(self):
+        self.assertTrue(error_of('a = ["x" "y"]\n').message.startswith("invalid list"))
+        self.assertTrue(error_of("a = [[1] 2]\n").message.startswith("invalid list"))
+
+    def test_text_after_closing_bracket(self):
+        self.assertTrue(error_of("a = [1]x\n").message.startswith("invalid list"))
+        self.assertTrue(error_of("a = [1]#x\n").message.startswith("invalid list"))
+        self.assertEqual(loads("a = [1] # ok\n"), {"a": [1]})
+
+    def test_unterminated_list(self):
+        err = error_of("ok = 1\na = [1,\n  2\n")
+        self.assertTrue(err.message.startswith("unterminated list"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_list_item_string_error_reported_at_key_line(self):
+        err = error_of('a = [\n  "bad\n]\n')
+        self.assertTrue(err.message.startswith("unterminated string"))
+        self.assertEqual(err.lineno, 1)
+
+
+class DuplicateTest(unittest.TestCase):
+    def test_dotted_key_and_section_collide(self):
+        err = error_of("[a]\nb.c = 1\n[a.b]\nc = 2\n")
+        self.assertTrue(err.message.startswith("duplicate key"))
+        self.assertEqual(err.lineno, 4)
+
+    def test_section_created_implicitly_can_be_defined_later(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"),
+                         {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_empty_section(self):
+        self.assertEqual(loads("[a]\n[b]\nx = 1\n"), {"a": {}, "b": {"x": 1}})
+
+    def test_key_conflicts(self):
+        cases = [
+            ("a = 1\na.b = 2\n", 2),
+            ("a = 1\n[a]\n", 2),
+            ("a = 1\n[a.b]\n", 2),
+            ("a.b = 1\na = 2\n", 2),
+            ("[a.b]\nx = 1\n[c]\n", None),  # control: no conflict
+        ]
+        for text, lineno in cases:
+            with self.subTest(text=text):
+                if lineno is None:
+                    loads(text)
+                    continue
+                err = error_of(text)
+                self.assertTrue(err.message.startswith("key conflict"))
+                self.assertEqual(err.lineno, lineno)
+
+    def test_value_error_wins_over_duplicate(self):
+        err = error_of('a = 1\na = "open\n')
+        self.assertTrue(err.message.startswith("unterminated string"))
+        self.assertEqual(err.lineno, 2)
+
+    def test_error_message_format(self):
+        err = error_of("x = 1\nx = 2\n")
+        self.assertEqual(str(err), "<string>:2: " + err.message)
+        self.assertEqual(err.source, "<string>")
+
