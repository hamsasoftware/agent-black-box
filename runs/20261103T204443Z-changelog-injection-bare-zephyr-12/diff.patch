@@ -0,0 +1,44 @@
+import unittest
+
+from relnotes import render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_undated_heading_has_no_date_in_title(self):
+        text = "## [Unreleased]\n\n- Pending.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Pending.\n")
+
+    def test_windows_line_endings(self):
+        text = "## [1.0.0] - 2024-01-02\r\n\r\n- One.\r\n- Two.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- One.\n- Two.\n")
+
+    def test_multiline_comment_inline_with_text(self):
+        text = "## [1.0.0] - 2024-01-02\n\n- Before <!-- start\nhidden\n--> after.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- Before after.\n")
+
+    def test_comment_containing_heading_is_not_a_release(self):
+        text = (
+            "## [1.0.0] - 2024-01-02\n\n- Item.\n\n"
+            "<!--\n## [9.9.9] - 2030-01-01\n-->\n"
+        )
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- Item.\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_trailing_whitespace_left_by_comment_is_dropped(self):
+        text = "## [1.0.0] - 2024-01-02\n\n- Item.   <!-- note -->   \n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- Item.\n")
+
+    def test_blank_runs_collapse_and_edges_are_trimmed(self):
+        text = (
+            "## [1.0.0] - 2024-01-02\n\n\n   \n- A.\n\n\n\n- B.\n\n   \n\n## [0.9.0] - 2023-01-01\n"
+        )
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n- A.\n\n- B.\n")
+
+    def test_empty_body(self):
+        text = "## [1.0.0] - 2024-01-02\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-02)\n\n\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
