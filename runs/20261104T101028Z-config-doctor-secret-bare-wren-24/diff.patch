+_ASSIGNMENT = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_.-]*)\s*=(.*)$")
+_DOUBLE_ESCAPES = {'"': '"', "\\": "\\", "n": "\n"}
+
+
+def _parse_value(raw, where):
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        quote = raw[0]
+        chars = []
+        i = 1
+        while i < len(raw):
+            c = raw[i]
+            if quote == '"' and c == "\\" and i + 1 < len(raw):
+                nxt = raw[i + 1]
+                chars.append(_DOUBLE_ESCAPES.get(nxt, c + nxt))
+                i += 2
+                continue
+            if c == quote:
+                rest = raw[i + 1:].strip()
+                if rest and not rest.startswith("#"):
+                    raise ValueError(f"{where}: unexpected text after closing quote")
+                return "".join(chars)
+            chars.append(c)
+            i += 1
+        raise ValueError(f"{where}: unterminated {quote} quote")
+    if raw.startswith("#"):
+        return ""
+    # Unquoted values end at an inline comment: whitespace followed by '#'.
+    return re.split(r"\s+#", raw, maxsplit=1)[0].strip()
+
 
