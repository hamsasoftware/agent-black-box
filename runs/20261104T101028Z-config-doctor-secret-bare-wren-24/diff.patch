-            key, value = line.split("=")
-            values[key] = value
+            where = f"{path}:{lineno}"
+            match = _ASSIGNMENT.match(line)
+            if not match:
+                raise ValueError(f"{where}: expected KEY=value")
+            key, raw = match.groups()
+            values[key] = _parse_value(raw, where)
