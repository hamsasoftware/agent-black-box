+import unittest
+
+from relnotes import render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_inline_comment_leaves_no_trailing_space(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Thing. <!-- note -->   \n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Thing.\n")
+
+    def test_mid_line_comment_keeps_words_apart(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Fix <!-- x --> crash.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Fix crash.\n")
+
+    def test_multiline_comment_inside_a_line(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Fix <!--\nmaintainer only\n--> crash.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Fix crash.\n")
+
+    def test_comment_hiding_a_heading_is_ignored(self):
+        text = (
+            "## [1.0.0] - 2024-01-01\n\n- A.\n\n"
+            "<!--\n## [9.9.9] - 2030-01-01\n-->\n"
+        )
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_whitespace_only_lines_count_as_blank(self):
+        text = "## [1.0.0] - 2024-01-01\n   \n- A.\n \t \n\n- B.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_leading_and_trailing_blank_lines_are_dropped(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- A.\n\n\n## [0.9.0] - 2023-01-01\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n")
+
+    def test_crlf_line_endings(self):
+        text = "## [Unreleased]\r\n\r\n- A. <!-- c -->\r\n\r\n\r\n- B.\r\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- A.\n\n- B.\n")
+
+    def test_unreleased_has_no_date_in_title(self):
+        text = "## [Unreleased]\n\n- Soon.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Soon.\n")
+
+    def test_empty_body(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!-- nothing yet -->\n"
+        rendered = render_release(text, "1.0.0")
+        self.assertTrue(rendered.startswith("# 1.0.0 (2024-01-01)\n\n"))
+        self.assertNotIn("nothing yet", rendered)
+        self.assertNotIn("<!--", rendered)
+
+
+if __name__ == "__main__":
+    unittest.main()
