+"""Tests for the rules in docs/FORMAT.md that the original tests do not cover."""
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def error_of(text, **kwargs):
+    try:
+        loads(text, **kwargs)
+    except ParseError as exc:
+        return exc
+    raise AssertionError(f"no ParseError for {text!r}")
+
+
+class ScalarTest(unittest.TestCase):
+    def test_bool_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\nc = tRuE\n"), {"a": True, "b": False, "c": True})
+
+    def test_int_forms(self):
+        text = "a = -0\nb = +7\nc = 1_000\nd = 0xFF\ne = -0b101\nf = 0o17\ng = 0XaB\n"
+        self.assertEqual(loads(text), {"a": 0, "b": 7, "c": 1000, "d": 255, "e": -5, "f": 15, "g": 171})
+
+    def test_float_forms(self):
+        text = "a = .5\nb = 5.\nc = 1e3\nd = -2.5E-3\ne = 1_0.2\nf = 00.5\ng = 007e1\n"
+        self.assertEqual(loads(text), {
+            "a": 0.5, "b": 5.0, "c": 1000.0, "d": -0.0025, "e": 10.2, "f": 0.5, "g": 70.0,
+        })
+
+    def test_strings_that_look_numeric(self):
+        expected = {
+            "a": "007", "b": "1__0", "c": "_1", "d": "inf", "e": "nan", "f": "yes",
+            "g": "1.2.3", "h": "0x", "i": "1e", "j": "+", "k": ".",
+        }
+        text = "".join(f"{key} = {value}\n" for key, value in expected.items())
+        self.assertEqual(loads(text), expected)
+
+    def test_multiline_plain_value_is_string_even_if_scalar_looking(self):
+        self.assertEqual(loads("a = 1\n    2\n"), {"a": "1\n2"})
+
+    def test_single_line_after_empty_first_line_is_scalar(self):
+        self.assertEqual(loads("port =\n    8080\n"), {"port": 8080})
+
+
+class StringTest(unittest.TestCase):
+    def test_escapes(self):
+        self.assertEqual(loads('a = "q\\"b\\\\c\\n\\r\\0\\u0041"\n'), {"a": 'q"b\\c\n\r\x00A'})
+
+    def test_invalid_escape(self):
+        self.assertTrue(error_of('a = "x\\q"\n').message.startswith("invalid escape"))
+
+    def test_short_unicode_escape(self):
+        self.assertTrue(error_of('a = "\\u12"\n').message.startswith("invalid escape"))
+
+    def test_unexpected_text_after_string(self):
+        exc = error_of('a = "x" y\n')
+        self.assertTrue(exc.message.startswith("unexpected text after string"))
+        self.assertEqual(exc.lineno, 1)
+
+    def test_comment_after_string_is_fine(self):
+        self.assertEqual(loads('a = "x"  ; note\n'), {"a": "x"})
+
+    def test_hash_inside_quotes_is_not_a_comment(self):
+        self.assertEqual(loads('a = "x # y"\n'), {"a": "x # y"})
+
+    def test_quoted_value_error_reported_at_key_line(self):
+        exc = error_of('ok = 1\nbad = "a\n   b"\n')
+        self.assertTrue(exc.message.startswith("unterminated string"))
+        self.assertEqual(exc.lineno, 2)
+
+
+class ListTest(unittest.TestCase):
+    def test_nested_and_quoted_items(self):
+        self.assertEqual(loads("a = [[1, 2], [], 'x,y']\n"), {"a": [[1, 2], [], "x,y"]})
+
+    def test_quote_inside_token_is_ordinary(self):
+        self.assertEqual(loads("a = [it's]\n"), {"a": ["it's"]})
+
+    def test_trailing_comma_and_comment_between_items(self):
+        self.assertEqual(loads("a = [1, # first\n    2,\n    ]  # done\n"), {"a": [1, 2]})
+
+    def test_empty_items_are_errors(self):
+        for text in ("a = [1,,2]\n", "a = [,]\n"):
+            self.assertTrue(error_of(text).message.startswith("invalid list"), text)
+
+    def test_missing_comma(self):
+        self.assertTrue(error_of("a = ['a' 'b']\n").message.startswith("invalid list"))
+
+    def test_text_after_closing_bracket(self):
+        self.assertTrue(error_of("a = [1] x\n").message.startswith("invalid list"))
+
+    def test_unterminated_list(self):
+        exc = error_of("a = [1,\n    2\n")
+        self.assertTrue(exc.message.startswith("unterminated list"))
+        self.assertEqual(exc.lineno, 1)
+
+    def test_bracket_inside_token_is_invalid(self):
+        self.assertTrue(error_of("a = [x[1]]\n").message.startswith("invalid list"))
+
+
+class LineTest(unittest.TestCase):
+    def test_crlf_and_cr_line_endings_count_lines(self):
+        exc = error_of("a = 1\r\nb = 2\rc = 3\r\n[x]\r\n[x]\r\n")
+        self.assertTrue(exc.message.startswith("duplicate section"))
+        self.assertEqual(exc.lineno, 5)
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+    def test_continuation_without_value(self):
+        for text in ("  x = 1\n", "[a]\n  x = 1\n", "[a]\n\n   stray\n"):
+            self.assertTrue(error_of(text).message.startswith("continuation without a value"), text)
+
+    def test_comment_lines_do_not_end_multiline_value(self):
+        self.assertEqual(loads("a =\n  one\n# note\n  two\n"), {"a": "one\ntwo"})
+
+    def test_invalid_line(self):
+        for text in ("just words\n", "a b = 1\n", "= 1\n", "a..b = 1\n"):
+            self.assertTrue(error_of(text).message.startswith("invalid line"), text)
+
+    def test_invalid_section_header(self):
+        for text in ("[a\n", "[a] x\n", "[ a . b ]x\n", "[a]#c\n", "[]\n"):
+            self.assertTrue(error_of(text).message.startswith("invalid section header"), text)
+
+    def test_section_header_whitespace_and_comment(self):
+        self.assertEqual(loads("[ a.b ]   ; c\nk = 1\n"), {"a": {"b": {"k": 1}}})
+
+
+class TableTest(unittest.TestCase):
+    def test_header_without_keys_is_empty_dict(self):
+        self.assertEqual(loads("[a]\n[b]\nk = 1\n"), {"a": {}, "b": {"k": 1}})
+
+    def test_dotted_header_then_plain_header_is_fine(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_dotted_key_creates_table_that_header_can_declare(self):
+        self.assertEqual(loads("[s]\nx.y = 1\n[s.x]\nz = 2\n"), {"s": {"x": {"y": 1, "z": 2}}})
+
+    def test_key_conflicts(self):
+        cases = [
+            "a = 1\na.b = 2\n",
+            "a = 1\n[a]\n",
+            "a = 1\n[a.b]\n",
+            "a.b = 1\na = 2\n",
+            "[a]\nx = 1\n[b]\na = 1\n[b.a]\n",
+            "a.b = 1\na.b.c = 2\n",
+        ]
+        for text in cases:
+            self.assertTrue(error_of(text).message.startswith("key conflict"), text)
+
+    def test_dotted_duplicate_key(self):
+        exc = error_of("a.b = 1\na.b = 2\n")
+        self.assertTrue(exc.message.startswith("duplicate key"))
+        self.assertEqual(exc.lineno, 2)
+
+    def test_value_error_wins_over_duplicate_key(self):
+        exc = error_of('a = 1\na = "bad\n')
+        self.assertTrue(exc.message.startswith("unterminated string"))
+        self.assertEqual(exc.lineno, 2)
+
+    def test_parse_error_attributes_and_str(self):
+        exc = error_of("x = 1\n\nx = 2\n", source="given.ini")
+        self.assertIsInstance(exc, ValueError)
+        self.assertEqual(exc.lineno, 3)
+        self.assertEqual(exc.source, "given.ini")
+        self.assertEqual(str(exc), "given.ini:3: " + exc.message)
+
+
+class IncludeRuleTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.dir = self.tmp.name
+
+    def write(self, name, text):
+        path = os.path.join(self.dir, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_keeps_including_section(self):
+        self.write("part.ini", "k = 1\n")
+        self.write("main.ini", "[s]\n@include 'part.ini'\nafter = 2\n")
+        self.assertEqual(load(os.path.join(self.dir, "main.ini")), {"s": {"after": 2}, "k": 1})
+
+    def test_include_path_relative_to_including_file(self):
+        self.write("sub/inner.ini", "v = 3\n")
+        self.write("sub/mid.ini", '@include "inner.ini"\n')
+        main = self.write("main.ini", '@include "sub/mid.ini"\n')
+        self.assertEqual(load(main), {"v": 3})
+
+    def test_include_error_has_included_source_and_line(self):
+        self.write("bad.ini", "ok = 1\nbad = [1,\n")
+        main = self.write("main.ini", "\n@include \"sub/../bad.ini\"\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertEqual(ctx.exception.source, os.path.join(self.dir, "bad.ini"))
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertTrue(ctx.exception.message.startswith("unterminated list"))
+
+    def test_duplicate_across_include_reported_in_included_file(self):
+        self.write("base.ini", "x = 1\n")
+        main = self.write("main.ini", "x = 0\n@include \"base.ini\"\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+        self.assertEqual(ctx.exception.source, os.path.join(self.dir, "base.ini"))
+
+    def test_same_file_twice_is_not_a_cycle(self):
+        self.write("common.ini", "c = 1\n")
+        self.write("a.ini", '@include "common.ini"\n')
+        main = self.write("main.ini", '@include "a.ini"\n@include "common.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+
+    def test_self_include_is_cycle(self):
+        main = self.write("self.ini", '@include "self.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("include cycle"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_include_without_base_dir(self):
+        exc = error_of('@include "x.ini"\n')
+        self.assertTrue(exc.message.startswith("include needs a base directory"))
+        self.assertEqual(exc.lineno, 1)
+
+    def test_missing_include(self):
+        exc = None
+        try:
+            loads('a = 1\n@include "nope.ini"\n', base_dir=self.dir)
+        except ParseError as caught:
+            exc = caught
+        self.assertTrue(exc.message.startswith("cannot read include"))
+        self.assertEqual(exc.lineno, 2)
+
+    def test_invalid_include_forms(self):
+        for text in ("@include\n", "@include x.ini\n", '@include "a.ini" junk\n', "@includes \"a.ini\"\n"):
+            exc = error_of(text, base_dir=self.dir)
+            expected = "invalid line" if "@includes" in text else "invalid include"
+            self.assertTrue(exc.message.startswith(expected), text)
+
+    def test_include_comment_and_continuation_rule(self):
+        self.write("p.ini", "p = 1\n")
+        main = self.write("main.ini", '@include "p.ini"   # ok\n  stray\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("continuation without a value"))
+        self.assertEqual(ctx.exception.lineno, 2)
+
+    def test_load_missing_file_raises_oserror(self):
+        with self.assertRaises(OSError):
+            load(os.path.join(self.dir, "missing.ini"))
+
+
+class CommandLineRuleTest(unittest.TestCase):
+    def run_cli(self, args):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("[server]\nport = 9000\nhosts = [a, b]\n")
+            full_args = [sys.executable, "-m", "confkit", *[path if a == "PATH" else a for a in args]]
+            return subprocess.run(full_args, cwd=ROOT, capture_output=True, text=True)
+
+    def test_full_dump_is_json(self):
+        result = self.run_cli(["PATH"])
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn('"port": 9000', result.stdout)
+
+    def test_missing_key_exits_2(self):
+        result = self.run_cli(["PATH", "--get", "server.nope"])
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stderr.strip(), "no such key: server.nope")
+
+    def test_parse_error_exits_1(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "bad.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("a = 1\na = 2\n")
+            result = subprocess.run([sys.executable, "-m", "confkit", path],
+                                    cwd=ROOT, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 1)
+        self.assertTrue(result.stderr.strip().endswith(":2: duplicate key: a"), result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
