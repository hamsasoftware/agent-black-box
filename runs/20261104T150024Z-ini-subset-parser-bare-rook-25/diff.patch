-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    with open(path, encoding="utf-8", newline="") as handle:
+        text = handle.read()
+    state = _State()
+    state.stack.append(os.path.realpath(path))
+    return _parse(text, os.path.dirname(path), path, state)
+
+
+def _parse(text, base_dir, source, state):
+    if text.startswith("﻿"):
+        text = text[1:]
+    section = []
+    entry = None
+    for lineno, line in enumerate(_LINE_END_RE.split(text), 1):
+        stripped = line.strip(" \t")
+        if not stripped or stripped[0] in "#;":
+            continue
+        if line[0] in " \t":
+            if entry is None:
+                raise ParseError("continuation without a value", lineno, source)
+            entry.parts.append(stripped)
+            continue
+        if entry is not None:
+            _finish_entry(entry, state, source)
+            entry = None
+        if line[0] == "[":
+            section = _header(line, lineno, state, source)
+        elif line[0] == "@":
+            _include(line, lineno, base_dir, state, source)
+        else:
+            match = _KEY_RE.match(line)
+            if match is None:
+                raise ParseError("invalid line", lineno, source)
+            entry = _Entry(section + match.group(1).split("."), lineno, [line[match.end():]])
+    if entry is not None:
+        _finish_entry(entry, state, source)
+    return state.root
+
+
+def _header(line, lineno, state, source):
+    match = _HEADER_RE.match(line)
+    if match is None or _skip(line, match.end()) != len(line):
+        raise ParseError("invalid section header", lineno, source)
+    path = match.group(1).split(".")
+    parent = _descend(state.root, path[:-1], lineno, source)
+    name = path[-1]
+    if name not in parent:
+        parent[name] = {}
+    elif not isinstance(parent[name], dict):
+        raise ParseError(f"key conflict: {'.'.join(path)}", lineno, source)
+    elif tuple(path) in state.sections:
+        raise ParseError(f"duplicate section: {'.'.join(path)}", lineno, source)
+    state.sections.add(tuple(path))
+    return path
+
+
+def _include(line, lineno, base_dir, state, source):
+    match = _DIRECTIVE_RE.match(line)
+    if match.group(1) != "include":
+        raise ParseError("invalid line", lineno, source)
+    i = match.end()
+    while i < len(line) and line[i] in " \t":
+        i += 1
+    try:
+        if i >= len(line) or line[i] not in "\"'":
+            raise _Invalid("invalid include")
+        path, end = _quoted(line, i)
+    except _Invalid:
+        raise ParseError("invalid include", lineno, source) from None
+    if _skip(line, end) != len(line):
+        raise ParseError("invalid include", lineno, source)
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    full = os.path.normpath(os.path.join(base_dir, path))
+    real = os.path.realpath(full)
+    if real in state.stack:
+        raise ParseError(f"include cycle: {path}", lineno, source)
+    try:
+        with open(full, encoding="utf-8", newline="") as handle:
+            text = handle.read()
+    except (OSError, UnicodeDecodeError):
+        raise ParseError(f"cannot read include: {path}", lineno, source) from None
+    state.stack.append(real)
+    try:
+        _parse(text, os.path.dirname(full), full, state)
+    finally:
+        state.stack.pop()
+
+
+def _finish_entry(entry, state, source):
+    try:
+        value = _parse_value("\n".join(entry.parts))
+    except _Invalid as exc:
+        raise ParseError(exc.message, entry.lineno, source) from None
+    parent = _descend(state.root, entry.path[:-1], entry.lineno, source)
+    key = entry.path[-1]
+    if key in parent:
+        if isinstance(parent[key], dict):
+            raise ParseError(f"key conflict: {'.'.join(entry.path)}", entry.lineno, source)
+        raise ParseError(f"duplicate key: {'.'.join(entry.path)}", entry.lineno, source)
+    parent[key] = value
+
+
+def _descend(root, names, lineno, source):
+    """Return the table at ``names``, creating missing tables along the way."""
+    node = root
+    for i, name in enumerate(names):
+        if name not in node:
+            node[name] = {}
+        elif not isinstance(node[name], dict):
+            raise ParseError(f"key conflict: {'.'.join(names[:i + 1])}", lineno, source)
+        node = node[name]
+    return node
+
+
+def _skip(s, i):
+    """Skip whitespace (including newlines) and comments starting at ``i``.
+
+    A ``#`` or ``;`` starts a comment only at the start of ``s`` or after whitespace.
+    Returns the index of the first character that is neither.
+    """
+    n = len(s)
+    while True:
+        while i < n and s[i] in " \t\n":
+            i += 1
+        if i < n and s[i] in "#;" and (i == 0 or s[i - 1] in " \t\n"):
+            newline = s.find("\n", i)
+            if newline == -1:
+                return n
+            i = newline
+            continue
+        return i
+
+
+def _strip_comment(line):
+    """Remove an inline comment from a plain (unquoted) value line and trim it."""
+    for j, c in enumerate(line):
+        if c in "#;" and (j == 0 or line[j - 1] in " \t"):
+            return line[:j].strip(" \t")
+    return line.strip(" \t")
+
+
+def _parse_value(text):
+    n = len(text)
+    k = _skip(text, 0)
+    if k >= n:
+        return ""
+    c = text[k]
+    if c in "\"'":
+        value, end = _quoted(text, k)
+        if _skip(text, end) != n:
+            raise _Invalid("unexpected text after string")
+        return value
+    if c == "[":
+        value, end = _list(text, k)
+        if _skip(text, end) != n:
+            raise _Invalid("invalid list")
+        return value
+    lines = [_strip_comment(part) for part in text.split("\n")]
+    lines = [line for line in lines if line]
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _quoted(s, i):
+    """Parse the quoted string starting at ``s[i]``. Returns (value, index after the closing quote)."""
+    quote = s[i]
+    n = len(s)
+    j = i + 1
+    if quote == "'":
+        end = s.find("'", j)
+        newline = s.find("\n", j)
+        if end == -1 or (newline != -1 and newline < end):
+            raise _Invalid("unterminated string")
+        return s[j:end], end + 1
+    out = []
+    while True:
+        if j >= n or s[j] == "\n":
+            raise _Invalid("unterminated string")
+        c = s[j]
+        if c == quote:
+            return "".join(out), j + 1
+        if c != "\\":
+            out.append(c)
+            j += 1
+            continue
+        if j + 1 >= n or s[j + 1] == "\n":
+            raise _Invalid("unterminated string")
+        escape = s[j + 1]
+        if escape == "u":
+            digits = s[j + 2:j + 6]
+            if len(digits) != 4 or any(d not in string.hexdigits for d in digits):
+                raise _Invalid("invalid escape")
+            out.append(chr(int(digits, 16)))
+            j += 6
+            continue
+        if escape not in _ESCAPES:
+            raise _Invalid("invalid escape")
+        out.append(_ESCAPES[escape])
+        j += 2
+
+
+def _list(s, i):
+    """Parse the list starting at ``s[i]`` (a ``[``). Returns (items, index after ``]``)."""
+    n = len(s)
+    items = []
+    i = _skip(s, i + 1)
+    if i < n and s[i] == "]":
+        return items, i + 1
+    while True:
+        if i >= n:
+            raise _Invalid("unterminated list")
+        c = s[i]
+        if c in ",]":
+            raise _Invalid("invalid list")
+        if c in "\"'":
+            value, i = _quoted(s, i)
+        elif c == "[":
+            value, i = _list(s, i)
+        else:
+            j = i
+            while j < n and s[j] not in ",]\n":
+                if s[j] in "#;" and s[j - 1] in " \t":
+                    break
+                if s[j] == "[":
+                    raise _Invalid("invalid list")
+                j += 1
+            if j >= n:
+                raise _Invalid("unterminated list")
+            value = _scalar(s[i:j].strip(" \t"))
+            i = j
+        items.append(value)
+        i = _skip(s, i)
+        if i >= n:
+            raise _Invalid("unterminated list")
+        if s[i] == "]":
+            return items, i + 1
+        if s[i] != ",":
+            raise _Invalid("invalid list")
+        i = _skip(s, i + 1)
+        if i < n and s[i] == "]":
+            return items, i + 1
+
+
+def _scalar(text):
+    lowered = text.lower()
+    if lowered in ("true", "false"):
+        return lowered == "true"
+    if _DEC_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""))
+    for base, regex in _RADIX_RE:
+        match = regex.fullmatch(text)
+        if match:
+            value = int(match.group(2).replace("_", ""), base)
+            return -value if match.group(1) == "-" else value
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
