+"""Configuration parser for the format described in docs/FORMAT.md."""
+import os
+import re
+import string
 
 from .errors import ParseError
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\]")
+_KEY_RE = re.compile(r"(" + _DOTTED + r")[ \t]*=")
+_DIRECTIVE_RE = re.compile(r"@([A-Za-z_][A-Za-z0-9_-]*)?")
+_LINE_END_RE = re.compile(r"\r\n|\r|\n")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:(?:" + _DIGITS + r"\.(?:" + _DIGITS + r")?|\." + _DIGITS + r")(?:[eE][+-]?[0-9]+)?"
+    r"|" + _DIGITS + r"[eE][+-]?[0-9]+)"
+)
+_RADIX_RE = (
+    (16, re.compile(r"([+-]?)0[xX]([0-9a-fA-F](?:_?[0-9a-fA-F])*)")),
+    (8, re.compile(r"([+-]?)0[oO]([0-7](?:_?[0-7])*)")),
+    (2, re.compile(r"([+-]?)0[bB]([01](?:_?[01])*)")),
+)
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+
+
+class _Invalid(Exception):
+    """Internal: a value or include path is malformed. Turned into ParseError by the caller."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+class _Entry:
+    __slots__ = ("path", "lineno", "parts")
+
+    def __init__(self, path, lineno, parts):
+        self.path = path
+        self.lineno = lineno
+        self.parts = parts
+
+
+class _State:
+    def __init__(self):
+        self.root = {}
+        self.sections = set()  # full paths of headers seen so far
+        self.stack = []  # real paths of the files being parsed (for cycle detection)
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    state = _State()
+    return _parse(text, base_dir, source, state)
 
 
