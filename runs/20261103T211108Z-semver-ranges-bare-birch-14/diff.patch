+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = r"(?:x|X|\*|" + _NUM + ")"
+_PARTIAL = re.compile(
+    r"^v?(" + _PART + r")(?:\.(" + _PART + r")(?:\.(" + _PART + r")"
+    r"(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?)?)?$"
+)
+_OP = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$")
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+
+# Matches nothing: no version is below the lowest possible prerelease.
+_NEVER = [("<", Version(0, 0, 0, ("0",)))]
+
+
+def _invalid(text):
+    return ValueError("invalid range: %r" % (text,))
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, prerelease); None marks a wildcard/missing part."""
+    m = _PARTIAL.match(text)
+    if not m:
+        raise _invalid(text)
+    parts = []
+    wild = False
+    for g in m.groups()[:3]:
+        if g is None or g in ("x", "X", "*"):
+            parts.append(None)
+            wild = True
+        else:
+            if wild:  # a number after a wildcard, e.g. 1.x.3
+                raise _invalid(text)
+            parts.append(int(g))
+    pre = m.group(4)
+    if pre is not None:
+        if wild:
+            raise _invalid(text)
+        try:
+            pre = Version.parse("0.0.0-" + pre).prerelease
+        except ValueError:
+            raise _invalid(text)
+    return parts[0], parts[1], parts[2], pre or ()
+
+
+def _lower(p):
+    M, m, pt, pre = p
+    return Version(M or 0, m or 0, pt or 0, pre)
+
+
+def _next(p):
+    """Exclusive upper bound for a partial: bump the last given position."""
+    M, m, pt, _ = p
+    if m is None:
+        return Version(M + 1, 0, 0)
+    if pt is None:
+        return Version(M, m + 1, 0)
+    return Version(M, m, pt + 1)
+
+
+def _xrange(p):
+    if p[0] is None:
+        return []
+    if p[2] is not None:
+        return [("=", _lower(p))]
+    return [(">=", _lower(p)), ("<", _next(p))]
+
+
+def _tilde(p):
+    M, m, _, _ = p
+    if M is None:
+        return []
+    upper = Version(M + 1, 0, 0) if m is None else Version(M, m + 1, 0)
+    return [(">=", _lower(p)), ("<", upper)]
+
+
+def _caret(p):
+    M, m, pt, _ = p
+    if M is None:
+        return []
+    if M > 0 or m is None:
+        upper = Version(M + 1, 0, 0)
+    elif m > 0 or pt is None:
+        upper = Version(0, m + 1, 0)
+    else:
+        upper = Version(0, 0, pt + 1)
+    return [(">=", _lower(p)), ("<", upper)]
+
+
+def _primitive(op, p):
+    if op in ("", "="):
+        return _xrange(p)
+    if op == "~":
+        return _tilde(p)
+    if op == "^":
+        return _caret(p)
+    if p[0] is None:  # wildcard major: >=* and <=* match all, >* and <* nothing
+        return [] if op in (">=", "<=") else list(_NEVER)
+    full = p[2] is not None
+    if op == ">=":
+        return [(">=", _lower(p))]
+    if op == "<":
+        return [("<", _lower(p))]
+    if op == ">":
+        return [(">", _lower(p))] if full else [(">=", _next(p))]
+    # "<="
+    return [("<=", _lower(p))] if full else [("<", _next(p))]
+
+
+def _hyphen(a, b):
+    pa, pb = _parse_partial(a), _parse_partial(b)
+    out = []
+    if pa[0] is not None:
+        out.append((">=", _lower(pa)))
+    if pb[0] is not None:
+        if pb[2] is not None:
+            out.append(("<=", _lower(pb)))
+        else:
+            out.append(("<", _next(pb)))
+    return out
+
+
+def _has_op(token):
+    return _OP.match(token).group(1) is not None
+
+
+def _parse_set(text):
+    tokens = _OP_SPACE.sub(r"\1", text).split()
+    comps = []
+    i = 0
+    while i < len(tokens):
+        tok = tokens[i]
+        if tok == "-":
+            raise _invalid(text)
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens) or _has_op(tok) or _has_op(tokens[i + 2]):
+                raise _invalid(text)
+            comps.extend(_hyphen(tok, tokens[i + 2]))
+            i += 3
+            continue
+        op, rest = _OP.match(tok).groups()
+        if not rest:
+            raise _invalid(text)
+        comps.extend(_primitive(op or "", _parse_partial(rest)))
+        i += 1
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise _invalid(range_)
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+_TESTS = {
+    "<": lambda a, b: a < b,
+    "<=": lambda a, b: a <= b,
+    ">": lambda a, b: a > b,
+    ">=": lambda a, b: a >= b,
+    "=": lambda a, b: a == b,
+}
+
+
+def _set_matches(v, comps):
+    if not all(_TESTS[op](v, c) for op, c in comps):
+        return False
+    if v.prerelease:
+        return any(c.prerelease and c.release == v.release for _, c in comps)
+    return True
+
+
+def _parse_version(version):
+    if not isinstance(version, str):
+        raise ValueError("invalid version: %r" % (version,))
+    return Version.parse(version)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    v = _parse_version(version)
+    return any(_set_matches(v, s) for s in sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_v = None, None
+    for item in versions:
+        v = _parse_version(item)
+        if any(_set_matches(v, s) for s in sets) and (best_v is None or v > best_v):
+            best, best_v = item, v
+    return best
