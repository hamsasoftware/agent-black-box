+def mask_secret(value):
+    """Mask a secret for display, keeping only a short prefix and the length."""
+    if value is None:
+        return None
+    if len(value) <= 8:
+        return "****"
+    return "%s****(%d chars)" % (value[:4], len(value))
+
+
+def describe_config(config):
+    """Return (key, display_value, source) rows with secrets masked."""
+    rows = []
+    for key, (value, source) in config.items():
+        if key in SECRET_KEYS:
+            value = mask_secret(value)
+        rows.append((key, "<unset>" if value is None else value, source))
+    return rows
