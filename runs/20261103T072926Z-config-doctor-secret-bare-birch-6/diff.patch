+def _unquote(value):
+    """Strip one pair of matching surrounding quotes, if present."""
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        return value[1:-1]
+    return value
+
+
+def parse_dotenv_line(line):
+    """Return (key, value) for a dotenv line, or None for blank/comment/malformed lines.
+
+    Supports ``KEY=value``, an optional leading ``export``, single or double
+    quotes around the value, and ``=`` characters inside the value.
+    """
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if line.startswith("export ") or line.startswith("export\t"):
+        line = line[len("export"):].lstrip()
+    if "=" not in line:
+        return None
+    key, value = line.split("=", 1)
+    key = key.strip()
+    if not key:
+        return None
+    return key, _unquote(value.strip())
+
 
