@@ -0,0 +1,52 @@
+import unittest
+
+from relnotes import render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_multiline_inline_comment_is_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Fixed a <!-- note\nspanning lines --> thing.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Fixed a  thing.\n")
+
+    def test_comment_at_line_end_drops_trailing_whitespace(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Item one   <!-- a -->  \n- Item two\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Item one\n- Item two\n")
+
+    def test_two_comments_on_one_line(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- a <!-- x --> b <!-- y -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a  b\n")
+
+    def test_comment_inside_unreleased_section(self):
+        text = "## [Unreleased]\n\n<!-- nothing yet -->\n\n### Added\n- Thing.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n### Added\n- Thing.\n")
+
+    def test_blank_runs_and_edges_are_collapsed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n\n- One.\n\n\n\n- Two.\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_whitespace_only_lines_count_as_blank(self):
+        text = "## [1.0.0] - 2024-01-01\n   \n- One.\n \t \n- Two.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_windows_line_endings(self):
+        text = "# Changelog\r\n\r\n## [Unreleased]\r\n\r\n## [1.0.0] - 2024-01-01\r\n\r\n- One.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n")
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n")
+
+    def test_comment_hiding_a_heading_is_not_a_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!--\n## [0.9.0] - 2023-01-01\n-->\n- One.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "0.9.0")
+
+    def test_single_digit_day_date(self):
+        text = "## [2.4.0] - 2024-05-02\n\n- Dates work.\n"
+        self.assertEqual(render_release(text, "2.4.0"), "# 2.4.0 (2024-05-02)\n\n- Dates work.\n")
+
+    def test_release_with_empty_body(self):
+        text = "## [1.0.0] - 2024-01-01\n\n## [0.9.0] - 2023-01-01\n- Old.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
