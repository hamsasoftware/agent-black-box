 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timezone
 
 
 @dataclass(frozen=True)
@@ -29,5 +29,18 @@ def read_events(path):
                 yield parse_line(line)
 
 
+def as_utc(ts):
+    """Naive timestamps are UTC (legacy collectors); aware ones are converted."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def since(events, start):
+    """Keep events at or after ``start`` (a naive ``start`` is UTC)."""
+    start = as_utc(start)
+    return (event for event in events if as_utc(event.ts) >= start)
+
+
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
