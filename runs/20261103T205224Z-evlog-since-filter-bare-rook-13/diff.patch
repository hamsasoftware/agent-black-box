+def parse_day(text):
+    # strptime alone also accepts "2024-3-1", so require the zero-padded form explicitly.
+    if re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
+        try:
+            return datetime.strptime(text, "%Y-%m-%d").date()
+        except ValueError:
+            pass  # e.g. 2024-02-30; reported below
+    raise argparse.ArgumentTypeError(f"invalid date {text!r}: expected YYYY-MM-DD, e.g. 2024-03-10")
 
 
