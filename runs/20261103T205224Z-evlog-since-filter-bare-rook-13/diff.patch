 @dataclass(frozen=True)
@@ -31,3 +31,15 @@ def read_events(path):
 
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
+
+
+def to_utc(ts):
+    """Return an aware UTC datetime. Naive timestamps are UTC by convention."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def events_since(events, day):
+    """Keep events whose UTC date is `day` (a date) or later."""
+    return (event for event in events if to_utc(event.ts).date() >= day)
diff --git a/tests/test_since.py b/tests/test_since.py
new file mode 100644
index 0000000..6c4e182
--- /dev/null
+++ b/tests/test_since.py
@@ -0,0 +1,139 @@
+import io
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from datetime import date, datetime, timezone
+
+from evlog.cli import main, parse_day
+from evlog.events import events_since, parse_line, to_utc
+
+
+def write_file(lines):
+    handle, path = tempfile.mkstemp(suffix=".jsonl")
+    with os.fdopen(handle, "w") as f:
+        for line in lines:
+            f.write(line + "\n")
+    return path
+
+
+class ParseDayTest(unittest.TestCase):
+    def test_accepts_iso_date(self):
+        self.assertEqual(parse_day("2024-03-10"), date(2024, 3, 10))
+
+    def test_rejects_other_formats(self):
+        for bad in ["2024/03/10", "10-03-2024", "2024-3-1", "2024-03-10T00:00:00", "", "yesterday"]:
+            with self.subTest(bad=bad):
+                with self.assertRaises(Exception) as ctx:
+                    parse_day(bad)
+                self.assertIn("YYYY-MM-DD", str(ctx.exception))
+
+    def test_rejects_impossible_date(self):
+        with self.assertRaises(Exception):
+            parse_day("2024-02-30")
+
+
+class ToUtcTest(unittest.TestCase):
+    def test_naive_is_treated_as_utc(self):
+        self.assertEqual(to_utc(datetime(2024, 3, 9, 22, 10)), datetime(2024, 3, 9, 22, 10, tzinfo=timezone.utc))
+
+    def test_aware_is_converted(self):
+        ts = datetime.fromisoformat("2024-03-12T08:15:00+09:00")
+        self.assertEqual(to_utc(ts), datetime(2024, 3, 11, 23, 15, tzinfo=timezone.utc))
+
+
+class EventsSinceTest(unittest.TestCase):
+    def event(self, ts):
+        return parse_line(json.dumps({"ts": ts, "service": "s", "level": "info"}))
+
+    def test_boundary_day_is_included(self):
+        events = [self.event("2024-03-09T23:59:59+00:00"), self.event("2024-03-10T00:00:00+00:00")]
+        kept = list(events_since(events, date(2024, 3, 10)))
+        self.assertEqual([e.ts.isoformat() for e in kept], ["2024-03-10T00:00:00+00:00"])
+
+    def test_uses_utc_date_not_local_date(self):
+        # 2024-03-10 01:00 at UTC+05 is 2024-03-09 20:00 UTC, so it is before the cutoff.
+        events = [self.event("2024-03-10T01:00:00+05:00")]
+        self.assertEqual(list(events_since(events, date(2024, 3, 10))), [])
+
+    def test_naive_and_aware_mix_without_error(self):
+        events = [self.event("2024-03-10 06:00:00"), self.event("2024-03-10T06:00:00+00:00")]
+        self.assertEqual(len(list(events_since(events, date(2024, 3, 10)))), 2)
+
+
+class SinceCliTest(unittest.TestCase):
+    def setUp(self):
+        self.path = write_file([
+            json.dumps({"ts": "2024-03-09T23:00:00+00:00", "service": "api", "level": "error"}),
+            json.dumps({"ts": "2024-03-10T12:00:00+00:00", "service": "api", "level": "info"}),
+        ])
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def test_since_counts_from_that_day(self):
+        out = io.StringIO()
+        code = main(["report", self.path, "--since", "2024-03-10"], out=out)
+        self.assertEqual(code, 0)
+        self.assertEqual(out.getvalue().splitlines(), ["api info 1", "total 1"])
+
+    def test_since_equals_form(self):
+        out = io.StringIO()
+        main(["report", self.path, "--since=2024-03-10"], out=out)
+        self.assertEqual(out.getvalue().splitlines(), ["api info 1", "total 1"])
+
+    def test_since_can_come_before_path(self):
+        out = io.StringIO()
+        main(["report", "--since", "2024-03-10", self.path], out=out)
+        self.assertEqual(out.getvalue().splitlines(), ["api info 1", "total 1"])
+
+    def test_without_since_counts_everything(self):
+        out = io.StringIO()
+        main(["report", self.path], out=out)
+        self.assertEqual(out.getvalue().splitlines(), ["api error 1", "api info 1", "total 2"])
+
+    def test_no_events_on_or_after_day_gives_zero_total(self):
+        out = io.StringIO()
+        main(["report", self.path, "--since", "2025-01-01"], out=out)
+        self.assertEqual(out.getvalue().splitlines(), ["total 0"])
+
+
+class SinceErrorsTest(unittest.TestCase):
+    """Bad command-line input must produce a message and non-traceback exit, not a crash."""
+
+    def run_module(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "evlog", *args],
+            capture_output=True,
+            text=True,
+            cwd=os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+        )
+
+    def test_bad_date_is_usage_error(self):
+        proc = self.run_module("report", "/nonexistent", "--since", "03/10/2024")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("invalid date '03/10/2024'", proc.stderr)
+        self.assertIn("YYYY-MM-DD", proc.stderr)
+        self.assertNotIn("Traceback", proc.stderr)
+
+    def test_missing_since_value_is_usage_error(self):
+        proc = self.run_module("report", "/nonexistent", "--since")
+        self.assertEqual(proc.returncode, 2)
+        self.assertNotIn("Traceback", proc.stderr)
+
+    def test_missing_file_is_clear_error(self):
+        proc = self.run_module("report", "/nonexistent/events.jsonl", "--since", "2024-03-10")
+        self.assertEqual(proc.returncode, 1)
+        self.assertIn("cannot read /nonexistent/events.jsonl", proc.stderr)
+        self.assertNotIn("Traceback", proc.stderr)
+
+    def test_main_raises_system_exit_on_bad_date(self):
+        with self.assertRaises(SystemExit) as ctx:
+            main(["report", "x.jsonl", "--since", "nope"], out=io.StringIO())
+        self.assertEqual(ctx.exception.code, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
