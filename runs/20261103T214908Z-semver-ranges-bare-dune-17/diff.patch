+"""npm-style version ranges. The contract is docs/RANGES.md."""
+
+import operator
+import re
+
 from .version import Version
 
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+# Marker for a comparator that can never match (e.g. ">*" or "<x").
+_NEVER = ("!", None)
+
+# Joins an operator to a following version: ">= 1.2.3" -> ">=1.2.3".
+_OP_SPACE = re.compile(r"(\^|~|<=|>=|<|>|=)\s+")
+# Splits off a leading operator from a comparator token.
+_COMPARATOR = re.compile(r"(\^|~|<=|>=|<|>|=)?(.*)", re.DOTALL)
+# One numeric or wildcard position of a partial version.
+_PART = r"(0|[1-9]\d*|[xX*])"
+_PARTIAL = re.compile(rf"v?{_PART}(?:\.{_PART})?(?:\.{_PART})?")
+
+
+def _version_part(text):
+    """Parse the version after an operator.
+
+    Returns (nums, n, full): nums is a 3-tuple padded with zeros, n is the
+    number of specified numeric positions (0-3), and full is the Version when
+    n == 3, else None.
+    """
+    if "-" in text or "+" in text:
+        # Prerelease and build metadata are only allowed on full versions.
+        full = Version.parse(text)
+        return full.release, 3, full
+    match = _PARTIAL.fullmatch(text)
+    if not match:
+        raise ValueError(f"invalid version in range: {text!r}")
+    nums = []
+    seen_wildcard = False
+    for part in match.groups():
+        if part is None or part in ("x", "X", "*"):
+            seen_wildcard = True
+        elif seen_wildcard:
+            raise ValueError(f"number after wildcard in range: {text!r}")
+        else:
+            nums.append(int(part))
+    n = len(nums)
+    if n == 3:
+        full = Version.parse(text)
+        return full.release, 3, full
+    return tuple(nums + [0] * (3 - n)), n, None
+
+
+def _bump(nums, level):
+    """Version with the position at `level` (1-based) incremented, lower positions zeroed."""
+    idx = level - 1
+    return Version(*(list(nums[:idx]) + [nums[idx] + 1] + [0] * (2 - idx)))
+
+
+def _floor(nums, full):
+    return full if full is not None else Version(*nums)
+
+
+def _expand(op, text):
+    """Expand a plain comparator (operator and version) into (op, Version) pairs."""
+    nums, n, full = _version_part(text)
+    if n == 0:
+        # "*", "x", "" and their operator forms.
+        return [] if op in ("", "=", ">=", "<=") else [_NEVER]
+    if n == 3:
+        return [(op or "=", full)]
+    lo = Version(*nums)
+    hi = _bump(nums, n)
+    if op in ("", "="):
+        return [(">=", lo), ("<", hi)]
+    if op == ">=":
+        return [(">=", lo)]
+    if op == "<":
+        return [("<", lo)]
+    if op == ">":
+        return [(">=", hi)]
+    return [("<", hi)]  # "<="
+
+
+def _expand_caret(text):
+    nums, n, full = _version_part(text)
+    if n == 0:
+        return []
+    width = 3 if n == 3 else n
+    # Bump the left-most non-zero specified position; if all are zero, the last one.
+    idx = next((i for i in range(width) if nums[i] != 0), width - 1)
+    return [(">=", _floor(nums, full)), ("<", _bump(nums, idx + 1))]
+
+
+def _expand_tilde(text):
+    nums, n, full = _version_part(text)
+    if n == 0:
+        return []
+    level = 1 if n == 1 else 2
+    return [(">=", _floor(nums, full)), ("<", _bump(nums, level))]
+
+
+def _parse_set(text):
+    """Parse one comparator set. Returns a list of (op, Version) pairs, or None if it matches nothing."""
+    tokens = _OP_SPACE.sub(r"\1", text.strip()).split()
+    comparators = []
+    never = False
+    i = 0
+    while i < len(tokens):
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            # Hyphen range: "A - B" means ">=A <=B", with B's partial rules.
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range: {text!r}")
+            comparators += _expand(">=", tokens[i])
+            comparators += _expand("<=", tokens[i + 2])
+            i += 3
+            continue
+        match = _COMPARATOR.fullmatch(tokens[i])
+        op, body = match.group(1) or "", match.group(2)
+        if not body:
+            raise ValueError(f"missing version in range: {text!r}")
+        if op == "^":
+            found = _expand_caret(body)
+        elif op == "~":
+            found = _expand_tilde(body)
+        else:
+            found = _expand(op, body)
+        if _NEVER in found:
+            never = True
+        comparators += [c for c in found if c != _NEVER]
+        i += 1
+    return None if never else comparators
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    sets = [_parse_set(part) for part in range_.split("||")]
+    return [s for s in sets if s is not None]
+
+
+def _to_version(value):
+    if isinstance(value, Version):
+        return value
+    if isinstance(value, str):
+        return Version.parse(value)
+    raise ValueError(f"invalid version: {value!r}")
+
+
+def _set_matches(comparators, version):
+    for op, bound in comparators:
+        if not _OPS[op](version, bound):
+            return False
+    if version.prerelease:
+        # A prerelease only matches if the set names a prerelease on the same release.
+        return any(bound.prerelease and bound.release == version.release for _, bound in comparators)
+    return True
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    """True if `version` satisfies the npm-style `range_`. Raises ValueError on bad input."""
+    v = _to_version(version)
+    sets = _parse_range(range_)
+    return any(_set_matches(s, v) for s in sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    """The highest of `versions` satisfying `range_`, as given, or None."""
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        v = _to_version(item)
+        if (best_version is None or v > best_version) and any(_set_matches(s, v) for s in sets):
+            best = item
+            best_version = v
+    return best
