@@ -0,0 +1,135 @@
+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+def matches(range_, versions):
+    return [v for v in versions if satisfies(v, range_)]
+
+
+class DocExamplesTest(unittest.TestCase):
+    """Examples taken from docs/RANGES.md."""
+
+    def assertMatches(self, range_, yes, no):
+        for v in yes:
+            self.assertTrue(satisfies(v, range_), f"{v} should satisfy {range_!r}")
+        for v in no:
+            self.assertFalse(satisfies(v, range_), f"{v} should not satisfy {range_!r}")
+
+    def test_partial_with_operator(self):
+        self.assertMatches(">1", ["2.0.0"], ["1.9.9"])
+        self.assertMatches(">1.2", ["1.3.0"], ["1.2.9"])
+        self.assertMatches(">=1.2", ["1.2.0"], ["1.1.9"])
+        self.assertMatches("<1.2", ["1.1.9"], ["1.2.0"])
+        self.assertMatches("<=1", ["1.9.9"], ["2.0.0"])
+        self.assertMatches("<=1.2", ["1.2.9"], ["1.3.0"])
+        self.assertMatches("=1.2", ["1.2.0", "1.2.9"], ["1.3.0", "1.1.9"])
+        self.assertMatches("1.2", ["1.2.5"], ["1.3.0"])
+
+    def test_x_ranges(self):
+        for r in ("*", "", "x", "X"):
+            self.assertMatches(r, ["0.0.0", "9.9.9"], ["1.0.0-alpha"])
+        self.assertMatches("1.X", ["1.0.0"], ["2.0.0"])
+        self.assertMatches("1.x", ["1.0.0", "1.9.9"], ["2.0.0", "0.9.9"])
+        self.assertMatches("1.2.x", ["1.2.0", "1.2.9"], ["1.3.0"])
+        self.assertMatches("1.2", ["1.2.0", "1.2.9"], ["1.3.0"])
+
+    def test_empty_set_matches_any_release(self):
+        self.assertMatches("", ["0.0.0", "3.1.4"], ["1.0.0-rc.1"])
+
+    def test_operator_whitespace(self):
+        self.assertMatches(">= 1.2.3", ["1.2.3"], ["1.2.2"])
+        self.assertMatches(">=1.2.3 < 2", ["1.5.0"], ["2.0.0"])
+
+    def test_hyphen(self):
+        self.assertMatches("1.2.3 - 2.3", ["1.2.3", "2.3.9"], ["1.2.2", "2.4.0"])
+        self.assertMatches("1.2.3 - 2", ["2.9.9"], ["3.0.0"])
+        self.assertMatches("1.2 - 2.3", ["1.2.0"], ["1.1.9"])
+
+    def test_tilde(self):
+        self.assertMatches("~1.2.3", ["1.2.3", "1.2.9"], ["1.3.0", "1.2.2"])
+        self.assertMatches("~1.2", ["1.2.0", "1.2.9"], ["1.3.0"])
+        self.assertMatches("~1", ["1.0.0", "1.9.9"], ["2.0.0"])
+        self.assertMatches("~1.2.3-beta.2", ["1.2.3-beta.2", "1.2.9"], ["1.3.0"])
+
+    def test_caret(self):
+        self.assertMatches("^1.2.3", ["1.2.3", "1.9.0"], ["2.0.0", "1.2.2"])
+        self.assertMatches("^0.2.3", ["0.2.3", "0.2.9"], ["0.3.0"])
+        self.assertMatches("^0.0.3", ["0.0.3"], ["0.0.4"])
+        self.assertMatches("^1.2", ["1.2.0", "1.9.0"], ["2.0.0"])
+        self.assertMatches("^1.2.x", ["1.9.0"], ["2.0.0"])
+        self.assertMatches("^0.2", ["0.2.9"], ["0.3.0"])
+        self.assertMatches("^0.0", ["0.0.9"], ["0.1.0"])
+        self.assertMatches("^0.0.x", ["0.0.9"], ["0.1.0"])
+        self.assertMatches("^1", ["1.9.9"], ["2.0.0"])
+        self.assertMatches("^1.x", ["1.9.9"], ["2.0.0"])
+        self.assertMatches("^0", ["0.9.9"], ["1.0.0"])
+        self.assertMatches("^0.x", ["0.9.9"], ["1.0.0"])
+
+
+class PrereleaseRuleTest(unittest.TestCase):
+    def test_named_prerelease_on_same_release(self):
+        self.assertTrue(satisfies("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0"))
+        self.assertFalse(satisfies("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0"))
+
+    def test_caret_excludes_prereleases(self):
+        self.assertFalse(satisfies("2.0.0-rc.1", "^1.0.0"))
+        self.assertFalse(satisfies("1.5.0-beta", "^1.0.0"))
+
+    def test_star_and_empty_exclude_prereleases(self):
+        self.assertFalse(satisfies("1.2.3-alpha", "*"))
+        self.assertFalse(satisfies("1.2.3-alpha", ""))
+
+    def test_prerelease_rule_is_per_set(self):
+        # The prerelease names 1.2.3 in set one only; set two must not admit 1.2.3-alpha.
+        self.assertTrue(satisfies("1.2.3-alpha", ">=1.2.3-alpha <2 || ^3.0.0"))
+        self.assertFalse(satisfies("1.2.3-alpha", "^1.0.0 || >=1.2.3-beta"))
+
+    def test_exact_prerelease(self):
+        self.assertTrue(satisfies("1.2.3-beta.2", "=1.2.3-beta.2"))
+        self.assertFalse(satisfies("1.2.3-beta.3", "=1.2.3-beta.2"))
+
+
+class VersionFormatTest(unittest.TestCase):
+    def test_leading_v_and_build_metadata(self):
+        self.assertTrue(satisfies("v1.2.3", "^1.0.0"))
+        self.assertTrue(satisfies("1.2.3+build.5", ">=v1.2.3"))
+        self.assertTrue(satisfies("1.2.3+a", "1.2.3+b"))
+
+
+class InvalidInputTest(unittest.TestCase):
+    def test_invalid_ranges(self):
+        for bad in (">=", "1.x.3", "1.2.3.4", "01.2.3", "1.2.3 - ", "- 1.2.3", "^", "~", "1.2-beta", ">*x", "<>1", "a.b"):
+            with self.subTest(range=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+
+    def test_invalid_versions(self):
+        for bad in ("1.2", "x.1.2", "1.2.3-", "", "1.2.3.4"):
+            with self.subTest(version=bad):
+                with self.assertRaises(ValueError):
+                    satisfies(bad, "*")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+    def test_invalid_range_raises_even_for_empty_input(self):
+        with self.assertRaises(ValueError):
+            max_satisfying([], ">=")
+
+
+class MaxSatisfyingContractTest(unittest.TestCase):
+    def test_returns_original_string(self):
+        self.assertEqual(max_satisfying(["v1.4.0", "1.3.0"], "^1"), "v1.4.0")
+
+    def test_skips_prereleases_unless_named(self):
+        self.assertEqual(max_satisfying(["1.4.0", "2.0.0-rc.1", "1.5.0-beta"], "^1.0.0"), "1.4.0")
+
+    def test_empty_iterable(self):
+        self.assertIsNone(max_satisfying([], "*"))
+
+    def test_accepts_generator(self):
+        self.assertEqual(max_satisfying((v for v in ["1.0.0", "1.1.0"]), "1.x"), "1.1.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
