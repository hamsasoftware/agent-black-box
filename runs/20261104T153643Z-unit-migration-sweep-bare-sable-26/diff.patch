diff --git a/tests/test_migration.py b/tests/test_migration.py
new file mode 100644
index 0000000..eb0c4a4
--- /dev/null
+++ b/tests/test_migration.py
@@ -0,0 +1,114 @@
+import json
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from shipcalc import cache, export, reports, storage, units, validate
+from shipcalc.calc import order_weight_kg
+from shipcalc.cli import main
+from shipcalc.format import format_weight
+from shipcalc.limits import check_total_kg
+from shipcalc.models import Item, Order
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+
+
+class UnitsTest(unittest.TestCase):
+    def test_rounding_half_even(self):
+        for raw, want in [("1.0005", "1.000"), ("1.0015", "1.002"), ("2.0025", "2.002"),
+                          ("1.00051", "1.001"), ("2", "2.000"), ("0.0004", "0.000")]:
+            self.assertEqual(normalize_kg(raw), want)
+
+    def test_invalid(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".",
+                    "1\n", 1500, 1.5, True, None, Decimal("1")]:
+            with self.assertRaises(WeightError) as ctx:
+                normalize_kg(bad)
+            self.assertEqual(str(ctx.exception), f"invalid weight: {bad!r}")
+
+    def test_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        for bad in (-1, True, 1.0, "1"):
+            with self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+
+class LimitsTest(unittest.TestCase):
+    def test_carrier_limit(self):
+        self.assertEqual(check_total_kg("2147483.647"), "2147483.647")
+        with self.assertRaises(WeightError):
+            check_total_kg("2147483.648")
+
+
+class ValidateTest(unittest.TestCase):
+    def test_range_after_rounding(self):
+        ok = {"sku": "A", "qty": 1}
+        self.assertEqual(validate.validate_item({**ok, "weight_kg": "1000.0004"}), [])
+        self.assertEqual(validate.validate_item({**ok, "weight_kg": "1000.0006"}),
+                         ["weight_kg: out of range 0.001..1000.000"])
+        self.assertEqual(validate.validate_item({**ok, "weight_kg": "0.0004"}),
+                         ["weight_kg: out of range 0.001..1000.000"])
+        self.assertEqual(validate.validate_item({**ok, "weight_kg": "0.001"}), [])
+        self.assertTrue(validate.validate_item({**ok, "weight_kg": 5})[0].startswith("weight_kg:"))
+        self.assertEqual(validate.validate_item({**ok, "weight_g": 5}), ["weight_kg: missing"])
+
+
+class ReportsTest(unittest.TestCase):
+    def test_average_and_bands(self):
+        self.assertEqual(reports.average_weight_kg(Order()), "0.000")
+        order = Order([Item("A", "0.001"), Item("B", "0.002")])
+        self.assertEqual(reports.average_weight_kg(order), "0.002")  # 1.5 g -> even
+        order = Order([Item("A", "0.002"), Item("B", "0.003")])
+        self.assertEqual(reports.average_weight_kg(order), "0.002")  # 2.5 g -> even
+        order = Order([Item("A", "0.500"), Item("B", "2.000"), Item("C", "2.001", 2)])
+        self.assertEqual(reports.weight_bands(order), {"light": 1, "medium": 1, "heavy": 2})
+        self.assertEqual([i.sku for i in reports.heaviest(order, 2)], ["C", "B"])
