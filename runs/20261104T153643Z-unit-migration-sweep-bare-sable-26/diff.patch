+class StorageCliTest(unittest.TestCase):
+    def test_schema1_and_cli(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "o.json")
+            with open(path, "w") as fh:
+                json.dump({"schema": 1, "items": [{"sku": "A", "weight_g": 350, "qty": 2}]}, fh)
+            self.assertEqual(storage.load(path).items[0].weight_kg, "0.350")
+            self.assertEqual(main(["add", path, "B", "1.5", "1"]), 0)
+            with open(path) as fh:
+                data = json.load(fh)
+            self.assertEqual(data["schema"], 2)
+            self.assertEqual(data["items"][1]["weight_kg"], "1.500")
+            self.assertEqual(main(["add", path, "C", "-1", "1"]), 2)
+            with open(path, "w") as fh:
+                json.dump({"schema": 1, "items": [{"sku": "A", "weight_g": "5"}]}, fh)
+            with self.assertRaises(WeightError):
+                storage.load(path)
+            with open(path, "w") as fh:
+                json.dump({"schema": 3, "items": []}, fh)
+            with self.assertRaises(ValueError):
+                storage.load(path)
