index f69aa94..4e4131b 100644
--- a/shipcalc/units.py
+++ b/shipcalc/units.py
@@ -1,8 +1,45 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are kilograms written as decimal strings with exactly
+three decimal places (e.g. "0.250"). Arithmetic uses integers (grams)."""
+import re
 
+_INPUT = re.compile(r"([0-9]+)(?:\.([0-9]+))?")
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+
+class WeightError(ValueError):
+    """Invalid weight input, or a total over the carrier limit."""
+
+
+def _invalid(value):
+    return WeightError(f"invalid weight: {value!r}")
+
+
+def kg_to_g(value):
+    """Normalise value and return the exact whole number of grams (int)."""
+    if not isinstance(value, str):
+        raise _invalid(value)
+    match = _INPUT.fullmatch(value)
+    if match is None:
+        raise _invalid(value)
+    whole, frac = match.group(1), match.group(2) or ""
+    try:
+        grams = int(whole) * 1000 + int(frac[:3].ljust(3, "0"))
+    except ValueError:  # absurdly long digit strings
+        raise _invalid(value) from None
+    rest = frac[3:]
+    if rest:
+        first = rest[0]
+        if first > "5" or (first == "5" and (rest[1:].strip("0") != "" or grams % 2 == 1)):
+            grams += 1
+    return grams
+
+
+def g_to_kg(grams):
+    """Return the canonical kilogram string for a non-negative int of grams."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise _invalid(grams)
+    return f"{grams // 1000}.{grams % 1000:03d}"
+
+
+def normalize_kg(value):
+    """Return value in canonical form, or raise WeightError."""
+    return g_to_kg(kg_to_g(value))
