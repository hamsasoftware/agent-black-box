@@ -0,0 +1,18 @@
+import unittest
+
+from relnotes import render_release
+
+
+class CommentTest(unittest.TestCase):
+    def test_multiline_comment_and_blank_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\nA <!-- x\ny --> \n\n\n<!-- z -->\n\n\nB\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\nA\n\nB\n")
+
+    def test_comment_hiding_heading_is_ignored(self):
+        text = "## [1.0.0] - 2024-01-01\n- a\n<!--\n## [0.9.0] - 2023-01-01\n-->\n"
+        with self.assertRaises(LookupError):
+            render_release(text, "0.9.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
