+# Matches `KEY=...` with an optional leading `export ` keyword.
+_LINE_RE = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
+
+
+def _parse_value(raw):
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        quote = raw[0]
+        out = []
+        i = 1
+        while i < len(raw):
+            ch = raw[i]
+            if quote == '"' and ch == "\\" and i + 1 < len(raw) and raw[i + 1] in ('"', "\\"):
+                out.append(raw[i + 1])
+                i += 2
+                continue
+            if ch == quote:
+                # Anything after the closing quote (such as a comment) is ignored.
+                return "".join(out)
+            out.append(ch)
+            i += 1
+        # Unclosed quote: keep the value as written rather than guessing.
+        return raw
+    # Unquoted: a `#` preceded by whitespace starts a comment.
+    match = re.search(r"\s#", raw)
+    if match:
+        raw = raw[: match.start()]
+    return raw.strip()
+
 
