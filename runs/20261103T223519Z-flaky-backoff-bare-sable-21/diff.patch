@@ -0,0 +1,48 @@
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _MaxJitterRng:
+    """Stub rng that always picks the top of the jitter range."""
+
+    def uniform(self, low, high):
+        return high
+
+
+class _MinJitterRng:
+    def uniform(self, low, high):
+        return low
+
+
+class CapTest(unittest.TestCase):
+    def test_capped_delay_is_never_scaled_past_cap(self):
+        # Before the fix, a capped delay with maximal jitter came out as 1.1 * cap.
+        delay = compute_delay(10, base=0.5, cap=34, jitter=0.1, rng=_MaxJitterRng())
+        self.assertEqual(delay, 34)
+
+    def test_uncapped_delay_jitters_downward(self):
+        # Nominal 8 is below cap 10, so the minimum jitter factor applies unclamped.
+        delay = compute_delay(4, base=1, cap=10, jitter=0.1, rng=_MinJitterRng())
+        self.assertAlmostEqual(delay, 8 * 0.9)
+
+    def test_schedule_respects_cap_for_many_seeds(self):
+        for seed in range(500):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=12, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertGreaterEqual(delay, 0)
+                self.assertLessEqual(delay, 34)
+
+    def test_uncapped_delays_stay_within_jitter_band(self):
+        rng = random.Random(3)
+        for attempt in range(1, 5):
+            for _ in range(200):
+                nominal = 0.5 * 2 ** (attempt - 1)
+                delay = compute_delay(attempt, base=0.5, cap=1000, jitter=0.1, rng=rng)
+                self.assertGreaterEqual(delay, nominal * 0.9 - 1e-12)
+                self.assertLessEqual(delay, nominal * 1.1 + 1e-12)
+
+
+if __name__ == "__main__":
+    unittest.main()
