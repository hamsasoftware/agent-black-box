+class ExtraTest(unittest.TestCase):
+    def test_export_and_quotes_combined_and_comments(self):
+        path = write_env('export PAYHOOK_REGION="us" \n# c\nPAYHOOK_TIMEOUT=5 # note\nbad line\n')
+        config = load_config(environ={}, dotenv_path=path)
+        self.assertEqual(config["PAYHOOK_REGION"], ("us", ".env"))
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("5", ".env"))
+
+    def test_doctor_hides_secrets_and_shows_source(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result = subprocess.run(
+                [sys.executable, "-m", "payhook", "doctor"],
+                cwd=tmp, capture_output=True, text=True,
+                env={**os.environ, "PYTHONPATH": ROOT, "PAYHOOK_API_TOKEN": "sekret123"},
+            )
+        self.assertNotIn("sekret123", result.stdout)
+        self.assertIn("PAYHOOK_TIMEOUT = 10 [default]", result.stdout)
+        self.assertIn("PAYHOOK_API_TOKEN = (set, hidden, 9 chars) [env]", result.stdout)
+
