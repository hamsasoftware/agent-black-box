+# The four counted bucket rules, in the order they are applied (order does not affect the result).
+BUCKET_RULES = ("keep_daily", "keep_weekly", "keep_monthly", "keep_yearly")
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
     """
-    raise NotImplementedError
+    _require_aware(now, "now")
+    snaps = list(snapshots)
+    by_id = {}
+    for snap in snaps:
+        _require_aware(snap.taken_at, f"taken_at of snapshot {snap.id!r}")
+        if snap.id in by_id:
+            raise ValueError(f"duplicate snapshot id {snap.id!r}")
+        by_id[snap.id] = snap
+    _check_parents(by_id)
+
+    ordered = sorted(snaps, key=_newest_key, reverse=True)
+    kept = set()
+    remaining = []
+    for snap in ordered:
+        # ADR-0008 order of overrides, with ADR-0009's window as line 4.
+        if snap.tags & policy.protect_tags:  # 1. protected: kept, set aside
+            kept.add(snap.id)
+        elif snap.taken_at > now:  # 2. later than now (clock skew): kept, set aside
+            kept.add(snap.id)
+        elif snap.tags & policy.expire_tags:  # 3. expired: pruned, excluded from the rules
+            continue
+        elif policy.keep_within_hours and now - snap.taken_at <= timedelta(hours=policy.keep_within_hours):
+            kept.add(snap.id)  # 4. in the window (ADR-0006): kept, set aside
+        else:  # 5. among the remaining snapshots
+            remaining.append(snap)
+
+    if policy.has_rules:
+        kept |= _rule_choices(remaining, policy)
+    else:
+        # ADR-0001 / ADR-0008: with no rule on, every remaining snapshot is kept.
+        kept.update(snap.id for snap in remaining)
+
+    # ADR-0007: the dependency step, after everything else. Kept snapshots hold their parents, transitively.
+    frontier = list(kept)
+    while frontier:
+        parent = by_id[frontier.pop()].parent
+        if parent is not None and parent not in kept:
+            kept.add(parent)
+            frontier.append(parent)
+
+    return Plan(
+        keep=[snap.id for snap in ordered if snap.id in kept],
+        prune=[snap.id for snap in ordered if snap.id not in kept],
+    )
+
+
+def _require_aware(moment, what):
+    if moment.utcoffset() is None:
+        raise ValueError(f"{what} must be timezone-aware, got {moment!r}")
+
+
+def _newest_key(snap):
+    """'Newer' means a later taken_at; on a tie, the greater id (ADR-0001 Ordering)."""
+    return (snap.taken_at, snap.id)
+
+
+def _check_parents(by_id):
+    """ADR-0007: a parent must be a snapshot of the plan, and parent chains must not contain a cycle."""
+    for snap in by_id.values():
+        if snap.parent is not None and snap.parent not in by_id:
+            raise ValueError(f"snapshot {snap.id!r} has parent {snap.parent!r}, which is not in the plan")
+    checked = set()
+    for start in by_id:
+        path = set()
+        node = start
+        while node is not None and node not in checked:
+            if node in path:
+                raise ValueError(f"parent cycle through snapshot {node!r}")
+            path.add(node)
+            node = by_id[node].parent
+        checked |= path
+
+
+def _rule_choices(remaining, policy):
+    """Ids chosen by keep_last and the bucket rules, looking only at the remaining snapshots."""
+    chosen = set()
+    if policy.keep_last:
+        newest_first = sorted(remaining, key=_newest_key, reverse=True)
+        chosen.update(snap.id for snap in newest_first[: policy.keep_last])
+
+    keys = {snap.id: _bucket_keys(snap, policy) for snap in remaining}
+    for rule in BUCKET_RULES:
+        count = getattr(policy, rule)
+        if not count:
+            continue
+        newest_in_bucket = {}
+        for snap in remaining:
+            key = keys[snap.id][rule]
+            current = newest_in_bucket.get(key)
+            if current is None or _newest_key(snap) > _newest_key(current):
+                newest_in_bucket[key] = snap
+        for key in sorted(newest_in_bucket, reverse=True)[:count]:
+            chosen.add(newest_in_bucket[key].id)
+    return chosen
+
+
+def _bucket_keys(snap, policy):
+    day = _bucket_date(snap.taken_at, policy)
+    iso_year, iso_week, _ = day.isocalendar()
+    return {
+        "keep_daily": day,
+        "keep_weekly": (iso_year, iso_week),  # ADR-0003: ISO weeks
+        "keep_monthly": _month_key(day, policy.month_start_day),  # ADR-0010
+        "keep_yearly": day.year,
+    }
+
+
+def _bucket_date(taken_at, policy):
+    """ADR-0004 / ADR-0005: the local date that all bucket keys of a snapshot derive from."""
+    offset = _offset_minutes(taken_at, policy)
+    shifted = taken_at.astimezone(_UTC) + timedelta(minutes=offset) - timedelta(hours=policy.day_start_hour)
+    return shifted.date()
+
+
+def _offset_minutes(taken_at, policy):
+    if policy.zone is None:
+        return policy.tz_offset_minutes
+    initial, rows = ZONE_TABLES[policy.zone]
+    offset = initial
+    for instant, minutes in rows:
+        if taken_at >= instant:
+            offset = minutes
+        else:
+            break
+    return offset
+
+
+def _month_key(day, month_start_day):
+    """ADR-0010: the cycle of a month starts on day min(month_start_day, last day of that month)."""
+    year, month = day.year, day.month
+    last = calendar.monthrange(year, month)[1]
+    if day.day < min(month_start_day, last):
+        month -= 1
+        if month == 0:
+            month, year = 12, year - 1
+    return (year, month)
