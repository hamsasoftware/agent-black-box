+import unittest
+from datetime import datetime
+
+from vaultsnap import Plan, Policy, Snapshot, plan_retention
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def at(stamp, *tags, parent=None, id=None):
+    """Snapshot taken at `stamp` (ISO, UTC unless it carries an offset). The id is derived from the stamp."""
+    if "+" not in stamp[10:] and not stamp.endswith("Z"):
+        stamp += "+00:00"
+    moment = datetime.fromisoformat(stamp)
+    return Snapshot(id or "s-" + stamp[:16].replace("-", "").replace(":", "").replace("T", ""), moment, frozenset(tags), parent)
+
+
+class IsoWeekTest(unittest.TestCase):
+    def test_weeks_start_on_monday_and_follow_iso_year(self):
+        # 2025-12-28 is a Sunday (ISO 2025-W52); 2025-12-29 is a Monday (ISO 2026-W01).
+        sun, mon = at("2025-12-28T03:00"), at("2025-12-29T03:00")
+        plan = plan_retention([sun, mon], Policy(keep_weekly=1), NOW)
+        self.assertEqual(plan.keep, [mon.id])
+        self.assertEqual(plan.prune, [sun.id])
+
+    def test_two_different_iso_weeks_are_two_buckets(self):
+        sun, mon = at("2025-12-28T03:00"), at("2025-12-29T03:00")
+        plan = plan_retention([sun, mon], Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.prune, [])
+
+
+class DayBoundaryTest(unittest.TestCase):
+    def test_day_start_hour_moves_the_day(self):
+        # With day_start_hour=4, 03:30 on 1 January is still 31 December.
+        late = at("2025-12-31T23:00")
+        early = at("2026-01-01T03:30")
+        plan = plan_retention([late, early], Policy(keep_daily=1, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, [early.id])
+        self.assertEqual(plan.prune, [late.id])
+
+    def test_tz_offset_minutes_moves_the_day(self):
+        # +120 minutes: 23:30 UTC on 1 January is already 2 January locally, 12:00 UTC is still the 1st.
+        a = at("2026-01-01T23:30")
+        b = at("2026-01-01T12:00")
+        plan = plan_retention([a, b], Policy(keep_daily=2, tz_offset_minutes=120), NOW)
+        self.assertEqual(plan.prune, [])
+        # With no offset both fall on the 1st, so only one daily bucket exists.
+        plan = plan_retention([a, b], Policy(keep_daily=2), NOW)
+        self.assertEqual(plan.prune, [b.id])
+
+    def test_named_zone_uses_its_own_offset_and_ignores_tz_offset_minutes(self):
+        # harbor is +630 in March 2026. 16:00 UTC is 02:30 on the 30th locally;
+        # a fixed -720 offset would put both snapshots on the 29th.
+        late = at("2026-03-29T16:00")
+        early = at("2026-03-29T10:00")
+        plan = plan_retention([late, early], Policy(keep_daily=2, zone="harbor", tz_offset_minutes=-720), NOW)
+        self.assertEqual(plan.prune, [])
+
+    def test_zone_offset_is_looked_up_per_snapshot(self):
+        # lakeside is +60 before 2026-03-29T01:00Z and +120 after it.
+        before = at("2026-03-29T00:30")  # +60 -> 01:30 on the 29th
+        after = at("2026-03-29T22:30")  # +120 -> 00:30 on the 30th
+        plan = plan_retention([before, after], Policy(keep_daily=2, zone="lakeside"), NOW)
+        self.assertEqual(plan.prune, [])
+
+
+class MonthCycleTest(unittest.TestCase):
+    def test_month_start_day_15_puts_early_january_in_december(self):
+        jan10 = at("2026-01-10T03:00")
+        jan20 = at("2026-01-20T03:00")
+        plan = plan_retention([jan10, jan20], Policy(keep_monthly=2, month_start_day=15), NOW)
+        self.assertEqual(plan.prune, [])
+
+    def test_default_month_start_keeps_one_january_bucket(self):
+        jan10 = at("2026-01-10T03:00")
+        jan20 = at("2026-01-20T03:00")
+        plan = plan_retention([jan10, jan20], Policy(keep_monthly=2), NOW)
+        self.assertEqual(plan.keep, [jan20.id])
+
+    def test_short_month_uses_the_last_day(self):
+        # month_start_day=31: the cycle of February 2027 starts on 28 February,
+        # so 2027-02-28 and 2027-03-30 share the cycle (2027, 2).
+        feb28 = at("2027-02-28T03:00")
+        mar30 = at("2027-03-30T03:00")
+        later = datetime.fromisoformat("2027-06-01T00:00:00+00:00")  # both dates must lie before `now`
+        plan = plan_retention([feb28, mar30], Policy(keep_monthly=1, month_start_day=31), later)
+        self.assertEqual(plan.keep, [mar30.id])
+        self.assertEqual(plan.prune, [feb28.id])
+
+
+class WindowTest(unittest.TestCase):
+    def test_window_snapshots_are_set_aside_and_not_representatives(self):
+        # D is 16 hours old (in the 24 h window), C is 27 hours old (outside it).
+        # D must not be the representative of the 19th: C is.
+        c = at("2026-03-19T09:00")
+        d = at("2026-03-19T20:00")
+        e = at("2026-03-18T05:00")
+        plan = plan_retention([c, d, e], Policy(keep_within_hours=24, keep_daily=1), NOW)
+        self.assertEqual(plan.keep, [d.id, c.id])
+        self.assertEqual(plan.prune, [e.id])
+
+    def test_window_alone_keeps_only_the_window(self):
+        recent = at("2026-03-20T06:00")
+        old = at("2026-03-10T06:00")
+        plan = plan_retention([recent, old], Policy(keep_within_hours=24), NOW)
+        self.assertEqual(plan.keep, [recent.id])
+        self.assertEqual(plan.prune, [old.id])
+
+    def test_window_boundary_is_inclusive(self):
+        exactly = at("2026-03-19T12:00")
+        plan = plan_retention([exactly], Policy(keep_within_hours=24), NOW)
+        self.assertEqual(plan.keep, [exactly.id])
+
+    def test_zero_window_is_off(self):
+        old = at("2026-03-10T06:00")
+        plan = plan_retention([old], Policy(keep_within_hours=0), NOW)
+        self.assertEqual(plan.keep, [old.id])
+
+
+class OverrideOrderTest(unittest.TestCase):
+    def test_expired_snapshot_is_pruned_even_if_keep_last_would_keep_it(self):
+        scratch = at("2026-03-19T03:00", "scratch")
+        real = at("2026-03-18T03:00")
+        plan = plan_retention([scratch, real], Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, [real.id])
+        self.assertEqual(plan.prune, [scratch.id])
+
+    def test_protect_wins_over_expire(self):
+        both = at("2026-03-19T03:00", "scratch", "release")
+        plan = plan_retention([both], Policy(keep_last=1, protect_tags={"release"}, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.prune, [])
+
+    def test_expired_inside_window_is_pruned(self):
+        scratch = at("2026-03-20T06:00", "scratch")
+        plan = plan_retention([scratch], Policy(keep_within_hours=24, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.prune, [scratch.id])
+
+    def test_expired_is_pruned_under_an_empty_policy(self):
+        scratch = at("2026-03-19T03:00", "scratch")
+        keep = at("2026-03-18T03:00")
+        plan = plan_retention([scratch, keep], Policy(expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, [keep.id])
+        self.assertEqual(plan.prune, [scratch.id])
+
+    def test_future_snapshot_is_kept_and_not_counted(self):
+        future = at("2026-03-21T03:00")
+        past = at("2026-03-11T03:00")
+        plan = plan_retention([future, past], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, [future.id, past.id])
+
+
+class ParentTest(unittest.TestCase):
+    def test_parent_of_a_kept_snapshot_is_held(self):
+        full = at("2026-03-10T03:00", "scratch")
+        child = at("2026-03-12T03:00", parent=full.id)
+        newest = at("2026-03-13T03:00", parent=child.id)
+        plan = plan_retention([full, child, newest], Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, [newest.id, child.id, full.id])
+        self.assertEqual(plan.prune, [])
+
+    def test_held_snapshot_does_not_count_toward_keep_last(self):
+        parent = at("2026-03-10T03:00")
+        child = at("2026-03-12T03:00", parent=parent.id)
+        plan = plan_retention([parent, child], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, [child.id, parent.id])
+
+    def test_pruned_child_holds_nothing(self):
+        parent = at("2026-03-10T03:00")
+        child = at("2026-03-11T03:00", parent=parent.id)
+        newest = at("2026-03-12T03:00")
+        plan = plan_retention([parent, child, newest], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, [newest.id])
+        self.assertEqual(plan.prune, [child.id, parent.id])
+
+    def test_parent_may_be_newer_than_child(self):
+        # The newer parent is expired, but the protected child holds it, so it is kept.
+        later = at("2026-03-12T03:00", "scratch", id="s-later")
+        child = at("2026-03-10T03:00", "release", parent="s-later")
+        plan = plan_retention(
+            [child, later], Policy(keep_last=1, protect_tags={"release"}, expire_tags={"scratch"}), NOW
+        )
+        self.assertEqual(plan.keep, [later.id, child.id])
+        self.assertEqual(plan.prune, [])
+
+    def test_missing_parent_raises(self):
+        child = at("2026-03-10T03:00", parent="nope")
+        with self.assertRaises(ValueError):
+            plan_retention([child], Policy(), NOW)
+
+    def test_self_parent_raises_even_with_empty_policy(self):
+        s = at("2026-03-10T03:00", id="s-a", parent="s-a")
+        with self.assertRaises(ValueError):
+            plan_retention([s], Policy(), NOW)
+
+    def test_parent_cycle_raises(self):
+        a = at("2026-03-10T03:00", id="s-a", parent="s-b")
+        b = at("2026-03-11T03:00", id="s-b", parent="s-a")
+        with self.assertRaises(ValueError):
+            plan_retention([a, b], Policy(keep_last=1), NOW)
+
+
+class InputTest(unittest.TestCase):
+    def test_duplicate_ids_raise(self):
+        a = at("2026-03-10T03:00", id="s-x")
+        b = at("2026-03-11T03:00", id="s-x")
+        with self.assertRaises(ValueError):
+            plan_retention([a, b], Policy(keep_last=1), NOW)
+
+    def test_naive_now_raises(self):
+        with self.assertRaises(ValueError):
+            plan_retention([at("2026-03-10T03:00")], Policy(keep_last=1), datetime(2026, 3, 20, 12))
+
+    def test_same_instant_ties_break_on_greater_id(self):
+        a = at("2026-03-10T03:00", id="s-a")
+        b = at("2026-03-10T03:00", id="s-b")
+        plan = plan_retention([a, b], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["s-b"])
+        self.assertEqual(plan.prune, ["s-a"])
+
+    def test_every_id_appears_exactly_once(self):
+        shots = [at("2026-03-%02dT03:00" % d) for d in range(1, 15)]
+        plan = plan_retention(shots, Policy(keep_last=3, keep_daily=2, keep_weekly=1), NOW)
+        self.assertEqual(sorted(plan.keep + plan.prune), sorted(s.id for s in shots))
+        self.assertIsInstance(plan, Plan)
+
+
+if __name__ == "__main__":
+    unittest.main()
