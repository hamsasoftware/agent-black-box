+def total_added_kg(path):
+    """Sum of weight times qty over the 'add' entries that have a weight.
+
+    >>> import os, tempfile
+    >>> log = os.path.join(tempfile.mkdtemp(), "log.jsonl")
+    >>> write_entry(log, "add", "MUG-01", "0.350", 2)
+    >>> total_added_kg(log)
+    '0.700'
+    """
+    total_g = 0
+    for entry in read_entries(path):
+        if entry.get("event") == "add" and "weight_kg" in entry:
+            total_g += kg_to_g(entry["weight_kg"]) * entry.get("qty", 1)
+    return g_to_kg(total_g)
