+class UnitsTest(unittest.TestCase):
+    def test_rounding_half_even(self):
+        self.assertEqual(normalize_kg("1.0005"), "1.000")
+        self.assertEqual(normalize_kg("1.0015"), "1.002")
+        self.assertEqual(normalize_kg("2.0025"), "2.002")
+        self.assertEqual(normalize_kg("1.0004"), "1.000")
+        self.assertEqual(normalize_kg("1.00051"), "1.001")
+        self.assertEqual(normalize_kg("12"), "12.000")
+
+    def test_invalid_input(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", 1, 1.5, True, None]:
+            with self.subTest(value=bad), self.assertRaises(WeightError) as ctx:
+                normalize_kg(bad)
+            self.assertTrue(str(ctx.exception).startswith("invalid weight: "))
+        with self.assertRaises(ValueError):
+            normalize_kg("abc")
+
+    def test_error_message_uses_repr(self):
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg("abc")
+        self.assertEqual(str(ctx.exception), "invalid weight: 'abc'")
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg(1500)
+        self.assertEqual(str(ctx.exception), "invalid weight: 1500")
+
+    def test_grams_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        for bad in [-1, True, 1.5, "1000", None]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                g_to_kg(bad)
+
