+import operator
+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = rf"(x|X|\*|{_NUM})"
+_PRE_ID = r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+_PARTIAL = re.compile(
+    rf"^v?{_PART}(?:\.{_PART}(?:\.{_PART}"
+    rf"(?:-({_PRE_ID}(?:\.{_PRE_ID})*))?"
+    rf"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?)?)?$"
+)
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+# Lowest possible version; nothing is below it (used for "matches nothing").
+_FLOOR = Version(0, 0, 0, ("0",))
+_NEVER = [("<", _FLOOR)]
+
+
+def _partial(text):
+    """Parse a partial version into (major, minor, patch, prerelease); None = wildcard."""
+    m = _PARTIAL.match(text)
+    if not m:
+        raise ValueError(f"invalid range component: {text!r}")
+    nums = []
+    for g in m.groups()[:3]:
+        nums.append(None if g is None or g in "xX*" else int(g))
+    # a wildcard may not be followed by a number
+    for i in range(1, 3):
+        if nums[i - 1] is None and nums[i] is not None:
+            raise ValueError(f"invalid range component: {text!r}")
+    pre = tuple(m.group(4).split(".")) if m.group(4) else ()
+    return nums[0], nums[1], nums[2], pre
+
+
+def _full(M, m, p, pre=()):
+    return Version(M, m or 0, p or 0, pre)
+
+
+def _ge(v):
+    return (">=", v)
+
+
+def _lt(v):
+    return ("<", v)
+
+
+def _lower(p):
+    """Comparators for '>=' partial."""
+    M, m, pt, pre = p
+    return [] if M is None else [_ge(_full(M, m, pt, pre))]
+
+
+def _upper_exclusive(p):
+    """Comparator for '< next-after-partial' (partial with at least a major)."""
+    M, m, pt, _ = p
+    if m is None:
+        return _lt(Version(M + 1, 0, 0))
+    return _lt(Version(M, m + 1, 0))
+
+
+def _primitive(op, p):
+    M, m, pt, pre = p
+    full = pt is not None
+    if op in ("", "="):
+        if M is None:
+            return []
+        if full:
+            return [("=", Version(M, m, pt, pre))]
+        return [_ge(_full(M, m, 0)), _upper_exclusive(p)]
+    if op == ">":
+        if M is None:
+            return _NEVER
+        if full:
+            return [(">", Version(M, m, pt, pre))]
+        return [_ge(Version(M + 1, 0, 0) if m is None else Version(M, m + 1, 0))]
+    if op == ">=":
+        return _lower(p)
+    if op == "<":
+        return _NEVER if M is None else [_lt(_full(M, m, pt, pre))]
+    if op == "<=":
+        if M is None:
+            return []
+        if full:
+            return [("<=", Version(M, m, pt, pre))]
+        return [_upper_exclusive(p)]
+    raise ValueError(f"invalid operator: {op!r}")
+
+
+def _tilde(p):
+    M, m, pt, pre = p
+    if M is None:
+        return []
+    if m is None:
+        return [_ge(Version(M, 0, 0)), _lt(Version(M + 1, 0, 0))]
+    return [_ge(_full(M, m, pt, pre)), _lt(Version(M, m + 1, 0))]
+
+
+def _caret(p):
+    M, m, pt, pre = p
+    if M is None:
+        return []
+    if m is None:
+        return [_ge(Version(M, 0, 0)), _lt(Version(M + 1, 0, 0))]
+    lower = _ge(_full(M, m, pt, pre))
+    if M > 0:
+        return [lower, _lt(Version(M + 1, 0, 0))]
+    if pt is None or m > 0:
+        return [lower, _lt(Version(0, m + 1, 0))]
+    return [lower, _lt(Version(0, 0, pt + 1))]
+
+
+def _hyphen(a, b):
+    out = _lower(a)
+    M, m, pt, pre = b
+    if M is None:
+        return out
+    if pt is not None:
+        out.append(("<=", Version(M, m, pt, pre)))
+    else:
+        out.append(_upper_exclusive(b))
+    return out
+
+
+def _parse_set(text):
+    text = _OP_SPACE.sub(r"\1", text.strip())
+    tokens = text.split()
+    comps = []
+    i = 0
+    while i < len(tokens):
+        tok = tokens[i]
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"invalid hyphen range: {text!r}")
+            comps += _hyphen(_partial(tok), _partial(tokens[i + 2]))
+            i += 3
+            continue
+        if tok == "-":
+            raise ValueError(f"invalid hyphen range: {text!r}")
+        if tok[0] == "~":
+            comps += _tilde(_partial(tok[1:]))
+        elif tok[0] == "^":
+            comps += _caret(_partial(tok[1:]))
+        else:
+            m = re.match(r"^(<=|>=|<|>|=)?(.*)$", tok)
+            comps += _primitive(m.group(1) or "", _partial(m.group(2)))
+        i += 1
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(s) for s in range_.split("||")]
+
+
+def _version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _set_matches(v, comps):
+    if not all(_OPS[op](v, cv) for op, cv in comps):
+        return False
+    if v.prerelease:
+        return any(cv.prerelease and cv.release == v.release for _, cv in comps)
+    return True
+
+
+def _matches(v, sets):
+    return any(_set_matches(v, s) for s in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_v = None
+    for item in versions:
+        v = _version(item)
+        if _matches(v, sets) and (best_v is None or v > best_v):
+            best, best_v = item, v
+    return best
