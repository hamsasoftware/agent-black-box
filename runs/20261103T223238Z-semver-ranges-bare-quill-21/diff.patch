@@ -0,0 +1,160 @@
+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+def _inside(range_, versions):
+    return [v for v in versions if satisfies(v, range_)]
+
+
+class ContractExamplesTest(unittest.TestCase):
+    """Each example from docs/RANGES.md, probed at the boundaries of its interval."""
+
+    def assertRange(self, range_, yes, no):
+        for v in yes:
+            self.assertTrue(satisfies(v, range_), f"{v} should satisfy {range_!r}")
+        for v in no:
+            self.assertFalse(satisfies(v, range_), f"{v} should not satisfy {range_!r}")
+
+    def test_partial_with_operator_table(self):
+        self.assertRange(">1", ["2.0.0", "9.9.9"], ["1.9.9", "1.0.0"])
+        self.assertRange(">1.2", ["1.3.0"], ["1.2.9", "1.2.0"])
+        self.assertRange(">=1.2", ["1.2.0"], ["1.1.9"])
+        self.assertRange("<1.2", ["1.1.9"], ["1.2.0", "1.2.1"])
+        self.assertRange("<=1", ["1.9.9", "1.0.0"], ["2.0.0"])
+        self.assertRange("<=1.2", ["1.2.9"], ["1.3.0"])
+        self.assertRange("=1.2", ["1.2.0", "1.2.9"], ["1.3.0", "1.1.9"])
+
+    def test_x_ranges(self):
+        self.assertRange("1.x", ["1.0.0", "1.9.9"], ["0.9.9", "2.0.0"])
+        self.assertRange("1", ["1.0.0", "1.9.9"], ["0.9.9", "2.0.0"])
+        self.assertRange("1.2.x", ["1.2.0", "1.2.9"], ["1.1.9", "1.3.0"])
+        self.assertRange("1.2", ["1.2.0", "1.2.9"], ["1.1.9", "1.3.0"])
+        self.assertRange("*", ["0.0.0", "99.0.0"], [])
+        self.assertRange("", ["0.0.0", "99.0.0"], [])
+        self.assertRange("X", ["3.1.4"], [])
+
+    def test_hyphen_partial_bounds(self):
+        self.assertRange("1.2.3 - 2.3", ["1.2.3", "2.3.9"], ["1.2.2", "2.4.0"])
+        self.assertRange("1.2.3 - 2", ["1.2.3", "2.9.9"], ["1.2.2", "3.0.0"])
+        self.assertRange("1.2 - 2.3", ["1.2.0", "2.3.9"], ["1.1.9", "2.4.0"])
+
+    def test_tilde(self):
+        self.assertRange("~1.2.3", ["1.2.3", "1.2.9"], ["1.2.2", "1.3.0"])
+        self.assertRange("~1.2", ["1.2.0", "1.2.9"], ["1.3.0"])
+        self.assertRange("~1", ["1.0.0", "1.9.9"], ["2.0.0"])
+        self.assertRange("~1.2.3-beta.2", ["1.2.3-beta.2", "1.2.3", "1.2.9"], ["1.3.0", "1.2.3-beta.1"])
+
+    def test_caret_boundaries(self):
+        self.assertRange("^1.2.3", ["1.2.3", "1.9.9"], ["2.0.0", "1.2.2"])
+        self.assertRange("^0.2.3", ["0.2.3", "0.2.9"], ["0.3.0", "0.2.2"])
+        self.assertRange("^0.0.3", ["0.0.3"], ["0.0.4", "0.1.0"])
+        self.assertRange("^1.2", ["1.2.0", "1.9.9"], ["2.0.0"])
+        self.assertRange("^1.2.x", ["1.2.0", "1.9.9"], ["2.0.0"])
+        self.assertRange("^0.2", ["0.2.0", "0.2.9"], ["0.3.0"])
+        self.assertRange("^0.0", ["0.0.0", "0.0.9"], ["0.1.0"])
+        self.assertRange("^0.0.x", ["0.0.0", "0.0.9"], ["0.1.0"])
+        self.assertRange("^1", ["1.0.0", "1.9.9"], ["2.0.0"])
+        self.assertRange("^1.x", ["1.0.0", "1.9.9"], ["2.0.0"])
+        self.assertRange("^0", ["0.0.0", "0.9.9"], ["1.0.0"])
+        self.assertRange("^0.x", ["0.0.0", "0.9.9"], ["1.0.0"])
+
+
+class OperatorWhitespaceTest(unittest.TestCase):
+    def test_space_between_operator_and_version(self):
+        for range_ in (">= 1.2.3", ">=1.2.3", ">=  1.2.3"):
+            self.assertTrue(satisfies("1.2.3", range_), range_)
+            self.assertFalse(satisfies("1.2.2", range_), range_)
+
+    def test_space_in_tilde_and_caret(self):
+        self.assertTrue(satisfies("1.2.9", "~ 1.2.3"))
+        self.assertTrue(satisfies("1.9.9", "^ 1.2.3"))
+
+    def test_comparator_set_is_conjunction(self):
+        self.assertTrue(satisfies("1.5.0", ">=1.2.0 <2.0.0"))
+        self.assertFalse(satisfies("2.0.0", ">=1.2.0 <2.0.0"))
+
+    def test_union(self):
+        self.assertTrue(satisfies("0.4.5", "^0.4 || >=1.0.0 <2"))
+        self.assertTrue(satisfies("1.5.0", "^0.4 || >=1.0.0 <2"))
+        self.assertFalse(satisfies("0.5.0", "^0.4 || >=1.0.0 <2"))
+        self.assertFalse(satisfies("1.5.0", "^0.4 || >=2"))
+
+    def test_empty_alternative_matches_everything(self):
+        self.assertTrue(satisfies("7.0.0", "1.0.0 ||"))
+
+
+class PrereleaseTest(unittest.TestCase):
+    def test_prerelease_in_same_release_as_named_comparator(self):
+        self.assertTrue(satisfies("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0"))
+        self.assertFalse(satisfies("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0"))
+
+    def test_caret_never_matches_prerelease_of_next_major(self):
+        self.assertFalse(satisfies("2.0.0-rc.1", "^1.0.0"))
+        self.assertFalse(satisfies("1.5.0-beta", "^1.0.0"))
+
+    def test_wildcards_do_not_match_prereleases(self):
+        self.assertFalse(satisfies("1.2.3-alpha", "*"))
+        self.assertFalse(satisfies("1.2.3-alpha", ""))
+        self.assertFalse(satisfies("1.2.3-alpha", "1.x"))
+
+    def test_prerelease_matches_exact_equality(self):
+        self.assertTrue(satisfies("1.2.3-beta.2", "=1.2.3-beta.2"))
+        self.assertFalse(satisfies("1.2.3-beta.3", "=1.2.3-beta.2"))
+
+    def test_prerelease_ordering(self):
+        self.assertTrue(satisfies("1.0.0-alpha.2", ">1.0.0-alpha.1"))
+        self.assertFalse(satisfies("1.0.0-alpha", ">1.0.0-alpha.1"))
+        self.assertTrue(satisfies("1.0.0", ">1.0.0-rc.9"))
+
+    def test_hyphen_names_prerelease_anchor(self):
+        self.assertTrue(satisfies("1.2.3-rc.1", "1.2.3-rc.0 - 2"))
+
+
+class BuildMetadataTest(unittest.TestCase):
+    def test_build_metadata_is_ignored(self):
+        self.assertTrue(satisfies("1.2.3+build.9", "1.2.3"))
+        self.assertTrue(satisfies("1.2.3", ">=1.2.3+build.5"))
+        self.assertTrue(satisfies("v1.2.3", "1.2.3"))
+
+
+class ErrorsTest(unittest.TestCase):
+    def test_invalid_ranges_raise(self):
+        for bad in (">=", "1.x.3", "=", "~", "^", "1.2.3-", "1.2.3 - ", "abc", "1.2.3.4", ">=-1.0.0", "1.2-beta"):
+            with self.subTest(range=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+
+    def test_invalid_version_raises(self):
+        for bad in ("1.2", "x.y.z", "1.2.3.4", "", "01.2.3"):
+            with self.subTest(version=bad):
+                with self.assertRaises(ValueError):
+                    satisfies(bad, "*")
+
+    def test_max_satisfying_raises_on_invalid_range_and_version(self):
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0"], ">=")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+
+class MaxSatisfyingContractTest(unittest.TestCase):
+    def test_returns_item_as_given(self):
+        self.assertEqual(max_satisfying(["v1.4.0", "1.3.0"], "^1"), "v1.4.0")
+
+    def test_skips_prereleases_unless_named(self):
+        self.assertEqual(max_satisfying(["1.4.0", "2.0.0-rc.1"], "^1"), "1.4.0")
+        self.assertEqual(max_satisfying(["1.4.0", "2.0.0-rc.1"], ">=2.0.0-rc.0"), "2.0.0-rc.1")
+
+    def test_prerelease_below_release(self):
+        self.assertEqual(max_satisfying(["1.0.0-rc.1", "1.0.0"], "*"), "1.0.0")
+
+    def test_empty_input(self):
+        self.assertIsNone(max_satisfying([], "*"))
+
+    def test_accepts_iterator(self):
+        self.assertEqual(max_satisfying(iter(["1.0.0", "1.1.0"]), "1"), "1.1.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
