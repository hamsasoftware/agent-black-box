+import operator
+import re
+
 from .version import Version
 
+# Operators that may be separated from their version by whitespace (">= 1.2.3").
+_OPERATORS = ("<=", ">=", "<", ">", "=", "~", "^")
+_COMPARE = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+_LEADING_OP = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$", re.DOTALL)
+_NUMBER = re.compile(r"^(?:0|[1-9]\d*)$")
+_PRE_ID = re.compile(r"^(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)$")
+_BUILD = re.compile(r"^[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*$")
+_WILDCARDS = ("x", "X", "*")
+
+
+class _Partial:
+    """A parsed version or partial version; ``None`` marks a wildcard or a missing position."""
+
+    __slots__ = ("major", "minor", "patch", "pre")
+
+    def __init__(self, major, minor, patch, pre):
+        self.major = major
+        self.minor = minor
+        self.patch = patch
+        self.pre = pre
+
+    @property
+    def is_any(self):
+        return self.major is None
+
+    @property
+    def is_full(self):
+        return self.patch is not None
+
+    @property
+    def release(self):
+        return (self.major, self.minor, self.patch)
+
+    def lower(self):
+        """The smallest version this (partial) version stands for."""
+        return Version(self.major or 0, self.minor or 0, self.patch or 0, self.pre)
+
+    def next_boundary(self):
+        """The first version above everything this partial covers; only used for partials."""
+        if self.minor is None:
+            return Version(self.major + 1, 0, 0)
+        return Version(self.major, self.minor + 1, 0)
+
+
+def _parse_partial(text, original):
+    """Parse ``1.2.3-pre+build``, ``1.2``, ``1.x``, ``*`` and similar."""
+    body = text[1:] if text[:1] == "v" else text
+    body, plus, build = body.partition("+")
+    if plus and not _BUILD.match(build):
+        raise ValueError(f"invalid version in range: {original!r}")
+
+    core, dash, pre_text = body.partition("-")
+    pre = ()
+    if dash:
+        ids = pre_text.split(".")
+        if not all(_PRE_ID.match(i) for i in ids):
+            raise ValueError(f"invalid prerelease in range: {original!r}")
+        pre = tuple(ids)
+
+    parts = core.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version in range: {original!r}")
+    values = []
+    for part in parts:
+        if part in _WILDCARDS:
+            values.append(None)
+        elif None in values or not _NUMBER.match(part):
+            # A number after a wildcard (1.x.3) or a non-numeric part is invalid.
+            raise ValueError(f"invalid version in range: {original!r}")
+        else:
+            values.append(int(part))
+    values += [None] * (3 - len(values))
+
+    if pre and None in values:
+        raise ValueError(f"prerelease needs a full version: {original!r}")
+    return _Partial(*values, pre)
+
+
+def _comparator_bounds(op, p):
+    """Translate one comparator into ``(op, Version)`` bounds, or ``None`` if it matches nothing."""
+    if p.is_any:
+        # Wildcards match everything, except strict comparisons, which match nothing.
+        return None if op in (">", "<") else []
+
+    if op in ("~", "^"):
+        return _tilde_bounds(p) if op == "~" else _caret_bounds(p)
+
+    full = p.is_full
+    if op in ("", "="):
+        return [("=", p.lower())] if full else [(">=", p.lower()), ("<", p.next_boundary())]
+    if op == ">":
+        return [(">", p.lower())] if full else [(">=", p.next_boundary())]
+    if op == ">=":
+        return [(">=", p.lower())]
+    if op == "<":
+        return [("<", p.lower())]
+    if op == "<=":
+        return [("<=", p.lower())] if full else [("<", p.next_boundary())]
+    raise AssertionError(op)  # pragma: no cover - the caller only passes known operators
+
+
+def _tilde_bounds(p):
+    upper = Version(p.major, p.minor + 1, 0) if p.minor is not None else Version(p.major + 1, 0, 0)
+    return [(">=", p.lower()), ("<", upper)]
+
+
+def _caret_bounds(p):
+    if p.major != 0 or p.minor is None:
+        upper = Version(p.major + 1, 0, 0)
+    elif p.minor != 0:
+        upper = Version(0, p.minor + 1, 0)
+    elif p.patch is None:
+        upper = Version(0, 1, 0)
+    else:
+        upper = Version(0, 0, p.patch + 1)
+    return [(">=", p.lower()), ("<", upper)]
+
+
+def _hyphen_bounds(a, b):
+    bounds = []
+    if not a.is_any:
+        bounds.append((">=", a.lower()))
+    if not b.is_any:
+        if b.is_full:
+            bounds.append(("<=", b.lower()))
+        else:
+            bounds.append(("<", b.next_boundary()))
+    return bounds
+
+
+def _tokenize(text):
+    """Split a comparator set on whitespace, joining operators to the versions after them."""
+    raw = text.split()
+    tokens = []
+    i = 0
+    while i < len(raw):
+        token = raw[i]
+        if token in _OPERATORS:
+            if i + 1 >= len(raw):
+                raise ValueError(f"operator without version in range: {text!r}")
+            token += raw[i + 1]
+            i += 2
+        else:
+            i += 1
+        tokens.append(token)
+    return tokens
+
+
+def _parse_set(text):
+    """Parse one comparator set into ``(bounds, anchors, never)``.
+
+    ``bounds`` is a list of ``(op, Version)``. ``anchors`` holds the release tuples that some
+    comparator names with a prerelease tag. ``never`` is True if the set cannot match anything.
+    """
+    tokens = _tokenize(text)
+    bounds = []
+    anchors = set()
+    never = False
+    i = 0
+    while i < len(tokens):
+        if i + 2 < len(tokens) and tokens[i + 1] == "-":
+            # Hyphen range: "A - B".
+            a = _parse_partial(tokens[i], text)
+            b = _parse_partial(tokens[i + 2], text)
+            bounds.extend(_hyphen_bounds(a, b))
+            named = (a, b)
+            i += 3
+        else:
+            match = _LEADING_OP.match(tokens[i])
+            op, body = match.group(1) or "", match.group(2)
+            if not body:
+                raise ValueError(f"operator without version in range: {text!r}")
+            p = _parse_partial(body, text)
+            comp = _comparator_bounds(op, p)
+            if comp is None:
+                never = True
+            else:
+                bounds.extend(comp)
+            named = (p,)
+            i += 1
+        for p in named:
+            if p.pre:
+                anchors.add(p.release)
+    return bounds, anchors, never
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"range must be a string: {range_!r}")
+    return [_parse_set(alternative) for alternative in range_.split("||")]
+
+
+def _set_matches(version, parsed_set):
+    bounds, anchors, never = parsed_set
+    if never:
+        return False
+    # Prerelease versions only match when a comparator in the same set names that release
+    # with a prerelease tag.
+    if version.prerelease and version.release not in anchors:
+        return False
+    return all(_COMPARE[op](version, bound) for op, bound in bounds)
+
+
+def _as_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"version must be a string: {version!r}")
+    return Version.parse(version)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    """Return True if ``version`` satisfies the npm-style ``range_``."""
+    parsed = _parse_range(range_)
+    v = _as_version(version)
+    return any(_set_matches(v, s) for s in parsed)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    """Return the highest of ``versions`` that satisfies ``range_``, as given, or None."""
+    parsed = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        v = _as_version(item)
+        if any(_set_matches(v, s) for s in parsed):
+            if best_version is None or v > best_version:
+                best = item
+                best_version = v
+    return best
