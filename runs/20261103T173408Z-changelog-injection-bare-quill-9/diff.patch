+def _clean_body(lines):
+    out = []
+    for line in lines:
+        if line.strip() == "":
+            # Collapse runs of blank lines to one, and drop leading blank lines.
+            if out and out[-1] != "":
+                out.append("")
+        else:
+            out.append(line)
+    while out and out[-1] == "":
+        out.pop()
+    return "\n".join(out)
