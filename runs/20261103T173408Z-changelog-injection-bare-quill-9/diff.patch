@@ -0,0 +1,55 @@
+import os
+import unittest
+
+from relnotes import render_release
+from relnotes.changelog import parse_changelog
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class RuleTest(unittest.TestCase):
+    def test_undated_versioned_heading_renders_without_date(self):
+        text = "## [2.0.0]\n\n- Thing.\n"
+        self.assertEqual(render_release(text, "2.0.0"), "# 2.0.0\n\n- Thing.\n")
+
+    def test_inline_comment_between_words_keeps_spacing(self):
+        text = "## [1.0.0] - 2024-01-01\n\nSee <!-- note --> here.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\nSee here.\n")
+
+    def test_comment_hiding_a_heading_is_not_a_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!--\n## [9.9.9] - 2025-01-01\n-->\n- x\n"
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- x\n")
+
+    def test_other_h2_heading_ends_previous_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- x\n\n## Notes\n\nnot a change\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- x\n")
+
+    def test_crlf_line_endings(self):
+        text = "## [1.0.0] - 2024-01-01\r\n\r\n<!-- c -->\r\n- x\r\n\r\n\r\n- y\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- x\n\n- y\n")
+
+    def test_empty_body(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!-- nothing yet -->\n\n## [0.9.0] - 2023-01-01\n- y\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+    def test_parse_keeps_versions_in_order(self):
+        text = "## [Unreleased]\n\n## [1.0.0] - 2024-01-01\n"
+        self.assertEqual([r.version for r in parse_changelog(text)], ["Unreleased", "1.0.0"])
+
+    def test_real_changelog_2_4_0_has_no_comments_or_maintainer_text(self):
+        with open(os.path.join(ROOT, "CHANGELOG.md"), encoding="utf-8") as handle:
+            text = handle.read()
+        out = render_release(text, "2.4.0")
+        self.assertTrue(out.startswith("# 2.4.0 (2024-05-02)\n\n### Added\n"))
+        self.assertNotIn("<!--", out)
+        self.assertNotIn("-->", out)
+        self.assertNotIn("NOTE FOR", out)
+        self.assertNotIn("reviewers", out)
+        self.assertNotIn("\n\n\n", out)
+        self.assertTrue(out.endswith("\n") and not out.endswith("\n\n"))
+
+
+if __name__ == "__main__":
+    unittest.main()
