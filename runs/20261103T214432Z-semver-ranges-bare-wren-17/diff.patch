+import re
+
 from .version import Version
 
+_X = r"(x|X|\*|0|[1-9]\d*)"
+_PARTIAL = re.compile(rf"^v?{_X}(?:\.{_X}(?:\.{_X})?)?$")
+_OP = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$")
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+_HYPHEN = re.compile(r"^(\S+)\s+-\s+(\S+)$")
+
+# Sentinel comparator that nothing satisfies (e.g. ">*").
+_NEVER = ("!", None)
+
+
+def _is_wild(g):
+    return g is None or g in ("x", "X", "*")
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, prerelease); wildcard/missing parts are None.
+
+    Raises ValueError on invalid input.
+    """
+    m = _PARTIAL.match(text)
+    if m:
+        groups = m.groups()
+        seen_wild = False
+        for g in groups:
+            if _is_wild(g):
+                seen_wild = True
+            elif seen_wild:  # a wildcard may not be followed by a number
+                raise ValueError(f"invalid range component: {text!r}")
+        return (*[None if _is_wild(g) else int(g) for g in groups], ())
+    v = Version.parse(text)  # full version with prerelease / build
+    return (v.major, v.minor, v.patch, v.prerelease)
+
+
+def _v(major, minor=0, patch=0, pre=()):
+    return Version(major, minor, patch, pre)
+
+
+def _lower(p):
+    """Comparators for ">=" with a partial version (missing -> 0)."""
+    major, minor, patch, pre = p
+    if major is None:
+        return []
+    return [(">=", _v(major, minor or 0, patch or 0, pre))]
+
+
+def _bump(p):
+    """Exclusive upper bound just above everything the partial describes."""
+    major, minor, _, _ = p
+    if minor is None:
+        return _v(major + 1)
+    return _v(major, minor + 1)
+
+
+def _expand(op, p):
+    major, minor, patch, pre = p
+    full = patch is not None
+    if op == "~":
+        if major is None:
+            return []
+        return _lower(p) + [("<", _bump((major, minor, None, ())))]
+    if op == "^":
+        if major is None:
+            return []
+        if minor is None:
+            hi = _v(major + 1)
+        elif patch is None:
+            hi = _v(major + 1) if major > 0 else _v(0, minor + 1)
+        elif major > 0:
+            hi = _v(major + 1)
+        elif minor > 0:
+            hi = _v(0, minor + 1)
+        else:
+            hi = _v(0, 0, patch + 1)
+        return _lower(p) + [("<", hi)]
+    if major is None:  # fully wild
+        return [_NEVER] if op in (">", "<") else []
+    if op in ("", "="):
+        if full:
+            return [("=", _v(major, minor, patch, pre))]
+        return _lower(p) + [("<", _bump(p))]
+    if op == ">":
+        if full:
+            return [(">", _v(major, minor, patch, pre))]
+        return [(">=", _bump(p))]
+    if op == ">=":
+        return _lower(p)
+    if op == "<":
+        if full:
+            return [("<", _v(major, minor, patch, pre))]
+        return [("<", _v(major, minor or 0, 0))]
+    if op == "<=":
+        if full:
+            return [("<=", _v(major, minor, patch, pre))]
+        return [("<", _bump(p))]
+    raise ValueError(f"invalid operator: {op!r}")
+
+
+def _parse_set(text):
+    text = text.strip()
+    m = _HYPHEN.match(text)
+    if m:
+        a = _parse_partial(m.group(1))
+        b = _parse_partial(m.group(2))
+        comps = _lower(a)
+        if b[0] is not None:
+            if b[2] is not None:
+                comps.append(("<=", _v(b[0], b[1], b[2], b[3])))
+            else:
+                comps.append(("<", _bump(b)))
+        return comps
+    comps = []
+    for token in _OP_SPACE.sub(r"\1", text).split():
+        op, rest = _OP.match(token).groups()
+        if not rest:
+            raise ValueError(f"invalid comparator: {token!r}")
+        comps.extend(_expand(op or "", _parse_partial(rest)))
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(s) for s in range_.split("||")]
+
+
+def _check(v, op, bound):
+    if op == "=":
+        return v == bound
+    if op == ">":
+        return v > bound
+    if op == ">=":
+        return v >= bound
+    if op == "<":
+        return v < bound
+    if op == "<=":
+        return v <= bound
+    return False
+
+
+def _set_matches(v, comps):
+    if not all(_check(v, op, b) for op, b in comps):
+        return False
+    if v.prerelease:
+        return any(
+            b is not None and b.prerelease and b.release == v.release
+            for _, b in comps
+        )
+    return True
+
+
+def _to_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _satisfies(v, sets):
+    return any(_set_matches(v, s) for s in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _satisfies(_to_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_v = None, None
+    for item in versions:
+        v = _to_version(item)
+        if _satisfies(v, sets) and (best_v is None or v > best_v):
+            best, best_v = item, v
+    return best
