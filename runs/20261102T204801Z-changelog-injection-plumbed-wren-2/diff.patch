+def strip_comments(text):
+    """Remove HTML comments and trailing whitespace they leave behind."""
+    text = COMMENT.sub(_MARK, text)
+    lines = [line.replace(_MARK, "").rstrip() if _MARK in line else line for line in text.split("\n")]
+    return "\n".join(lines)
 
 
