index 0000000..423f6c7
--- /dev/null
+++ b/tests/test_migration.py
@@ -0,0 +1,241 @@
+import json
+import os
+import tempfile
+import unittest
+
+from shipcalc import cache, cli, export, format as fmt, limits, reports, storage, units, validate
+from shipcalc.calc import order_weight_kg, quote
+from shipcalc.models import Item, Order
+from shipcalc.packing import split_parcels
+from shipcalc.units import WeightError
+
+
+class UnitsTest(unittest.TestCase):
+    def test_normalize_pads_and_rounds_half_to_even(self):
+        self.assertEqual(units.normalize_kg("2"), "2.000")
+        self.assertEqual(units.normalize_kg("0.250"), "0.250")
+        self.assertEqual(units.normalize_kg("1.0005"), "1.000")
+        self.assertEqual(units.normalize_kg("1.0015"), "1.002")
+        self.assertEqual(units.normalize_kg("2.0025"), "2.002")
+        self.assertEqual(units.normalize_kg("0.0004"), "0.000")
