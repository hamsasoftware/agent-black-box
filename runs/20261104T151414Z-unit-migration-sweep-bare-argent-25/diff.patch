+    def test_schema2_is_normalised_on_load(self):
+        self._write({"schema": 2, "items": [{"sku": "A", "weight_kg": "1.5", "qty": 1}]})
+        self.assertEqual(storage.load(self.path).items[0].weight_kg, "1.500")
