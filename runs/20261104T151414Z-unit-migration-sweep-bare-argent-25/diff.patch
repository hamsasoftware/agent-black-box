+    def test_schema2_invalid_weight_raises(self):
+        self._write({"schema": 2, "items": [{"sku": "A", "weight_kg": "1,5", "qty": 1}]})
+        with self.assertRaises(WeightError):
+            storage.load(self.path)
+
+    def test_unknown_schema_raises_value_error(self):
+        for bad in [3, True, "2", None]:
+            with self.subTest(schema=bad):
+                self._write({"schema": bad, "items": []})
+                with self.assertRaises(ValueError):
+                    storage.load(self.path)
+
+    def test_save_writes_schema2(self):
+        storage.save(Order([Item("A", "0.250")]), self.path)
+        with open(self.path, encoding="utf-8") as handle:
+            data = json.load(handle)
