index f69aa94..1208ff2 100644
--- a/shipcalc/units.py
+++ b/shipcalc/units.py
@@ -1,8 +1,41 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are canonical kilogram strings ("0.250") everywhere in the package.
 
+See docs/MIGRATION.md. Whole grams appear only in the conversions kg_to_g and g_to_kg.
+"""
+import re
+from decimal import ROUND_HALF_EVEN, Decimal, localcontext
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+
+class WeightError(ValueError):
+    """Invalid weight input, or a total over the carrier limit."""
+
+
+_ACCEPTED = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+_MILLI = Decimal("0.001")
+
+
+def normalize_kg(value):
+    """Return value as a canonical kg string, rounding to three places half to even.
+
+    Raises WeightError for anything that is not a str of digits with an optional point.
+    """
+    if not isinstance(value, str) or _ACCEPTED.fullmatch(value) is None:
+        raise WeightError(f"invalid weight: {value!r}")
+    with localcontext() as ctx:
+        ctx.prec = len(value) + 10  # enough digits that quantize never overflows
+        rounded = Decimal(value).quantize(_MILLI, rounding=ROUND_HALF_EVEN)
+    return f"{rounded:f}"
+
+
+def kg_to_g(value):
+    """Return the exact whole number of grams in value (a whole number of grams)."""
+    whole, _, fraction = normalize_kg(value).partition(".")
+    return int(whole) * 1000 + int(fraction)
+
+
+def g_to_kg(grams):
+    """Return a non-negative whole number of grams as a canonical kg string."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise WeightError(f"invalid weight: {grams!r}")
+    digits = str(grams).rjust(4, "0")
+    return f"{digits[:-3]}.{digits[-3:]}"
