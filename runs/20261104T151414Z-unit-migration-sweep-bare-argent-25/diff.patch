+        self.assertEqual(order.items[0].weight_kg, "1.250")
+        self.assertEqual(order.items[0].qty, 2)
+
+    def test_schema1_invalid_grams_raise(self):
+        for bad in [-5, "350", True, 1.5]:
+            with self.subTest(value=bad):
+                self._write({"schema": 1, "items": [{"sku": "A", "weight_g": bad}]})
+                with self.assertRaises(WeightError):
+                    storage.load(self.path)
