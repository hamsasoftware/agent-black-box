+    def test_invalid_input_raises_weight_error_with_message(self):
+        bad = ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", "1_000"]
+        for value in bad:
+            with self.subTest(value=value), self.assertRaises(WeightError) as ctx:
+                units.normalize_kg(value)
+            self.assertEqual(str(ctx.exception), f"invalid weight: {value!r}")
+        for value in [1, 1.5, True, None]:
+            with self.subTest(value=value), self.assertRaises(WeightError):
+                units.normalize_kg(value)
