+class StorageTest(unittest.TestCase):
+    def setUp(self):
+        self._dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self._dir.name, "order.json")
+
+    def tearDown(self):
+        self._dir.cleanup()
+
+    def _write(self, data):
+        with open(self.path, "w", encoding="utf-8") as handle:
+            json.dump(data, handle)
+
+    def test_schema1_loads_grams_exactly(self):
+        self._write({"schema": 1, "items": [{"sku": "A", "weight_g": 1250, "qty": 2}]})
