+class ReportsTest(unittest.TestCase):
+    def test_average_rounds_half_to_even(self):
+        # total 0.003 kg over 2 units: 1.5 g, ties to even -> 2 g
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001"), Item("B", "0.002")])), "0.002")
+        # total 0.001 kg over 2 units: 0.5 g, ties to even -> 0 g
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001"), Item("B", "0.000")])), "0.000")
+        # total 0.002 kg over 2 units: exactly 1 g
