+import re
+
 from .version import Version
 
+_OPS = ("<=", ">=", "<", ">", "=", "~", "^")
+_PARTIAL = re.compile(r"^v?([xX*]|\d+)(?:\.([xX*]|\d+)(?:\.([xX*]|\d+))?)?$")
+_WILD = ("x", "X", "*")
+# Lowest possible version: "< NOTHING" matches nothing.
+_NOTHING = ("<", Version(0, 0, 0, ("0",)))
+
+
+def _v(major, minor=0, patch=0):
+    return Version(major, minor, patch)
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, full_version_or_None); None means wildcard/missing."""
+    match = _PARTIAL.match(text)
+    if match:
+        parts = []
+        for group in match.groups():
+            if group is None or group in _WILD:
+                parts.append(None)
+            else:
+                parts.append(int(group))
+        # A wildcard may not be followed by a number.
+        for i in range(2):
+            if parts[i] is None and parts[i + 1] is not None:
+                raise ValueError(f"invalid range: {text!r}")
+        if parts[2] is None:
+            return parts[0], parts[1], None, None
+        text = text.strip()  # plain MAJOR.MINOR.PATCH: fall through to full parse
+    try:
+        full = Version.parse(text)
+    except ValueError:
+        raise ValueError(f"invalid range component: {text!r}") from None
+    return full.major, full.minor, full.patch, full
+
+
+def _lower(M, m, p, full):
+    """Comparators for '>= partial' (missing positions are zero)."""
+    if M is None:
+        return []
+    if full is not None:
+        return [(">=", full)]
+    return [(">=", _v(M, m or 0, p or 0))]
+
+
+def _next_up(M, m, p):
+    """Exclusive upper bound for a partial: the 'next' version above it."""
+    if M is None:
+        return []
+    if m is None:
+        return [("<", _v(M + 1))]
+    if p is None:
+        return [("<", _v(M, m + 1))]
+    return None  # full version
+
+
+def _desugar(op, text):
+    M, m, p, full = _parse_partial(text)
+    if op in ("", "="):
+        if M is None:
+            return []
+        if full is not None:
+            return [("=", full)]
+        return _lower(M, m, p, full) + _next_up(M, m, p)
+    if op == ">":
+        if M is None:
+            return [_NOTHING]
+        if full is not None:
+            return [(">", full)]
+        return [(">=", _v(M + 1))] if m is None else [(">=", _v(M, m + 1))]
+    if op == ">=":
+        return _lower(M, m, p, full)
+    if op == "<":
+        if M is None:
+            return [_NOTHING]
+        return [("<", full if full is not None else _v(M, m or 0, p or 0))]
+    if op == "<=":
+        if M is None:
+            return []
+        if full is not None:
+            return [("<=", full)]
+        return _next_up(M, m, p)
+    if op == "~":
+        if M is None:
+            return []
+        if m is None:
+            return _lower(M, m, p, full) + [("<", _v(M + 1))]
+        return _lower(M, m, p, full) + [("<", _v(M, m + 1))]
+    if op == "^":
+        if M is None:
+            return []
+        if M > 0 or m is None:
+            upper = _v(M + 1)
+        elif m > 0 or p is None:
+            upper = _v(0, m + 1)
+        else:
+            upper = _v(0, 0, p + 1)
+        return _lower(M, m, p, full) + [("<", upper)]
+    raise ValueError(f"invalid operator: {op!r}")
+
+
+def _hyphen(a, b):
+    M, m, p, full = _parse_partial(a)
+    low = _lower(M, m, p, full)
+    M, m, p, full = _parse_partial(b)
+    if full is not None:
+        return low + [("<=", full)]
+    return low + _next_up(M, m, p)
+
+
+def _parse_set(text):
+    text = text.strip()
+    text = re.sub(r"(<=|>=|<|>|=|~|\^)\s+", r"\1", text)
+    tokens = text.split()
+    comparators = []
+    i = 0
+    while i < len(tokens):
+        tok = tokens[i]
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens) or tok == "-":
+                raise ValueError(f"invalid hyphen range: {text!r}")
+            comparators += _hyphen(tok, tokens[i + 2])
+            i += 3
+            continue
+        if tok == "-":
+            raise ValueError(f"invalid hyphen range: {text!r}")
+        op = ""
+        for candidate in _OPS:
+            if tok.startswith(candidate):
+                op = candidate
+                break
+        comparators += _desugar(op, tok[len(op):])
+        i += 1
+    return comparators
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _parse_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _test(op, a, b):
+    if op == "<":
+        return a < b
+    if op == "<=":
+        return a <= b
+    if op == ">":
+        return a > b
+    if op == ">=":
+        return a >= b
+    return a == b
+
+
+def _matches(ver, sets):
+    for comparators in sets:
+        if not all(_test(op, ver, other) for op, other in comparators):
+            continue
+        if ver.prerelease and not any(
+            other.prerelease and other.release == ver.release for _, other in comparators
+        ):
+            continue
+        return True
+    return False
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_parse_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_ver = None
+    for item in versions:
+        ver = _parse_version(item)
+        if _matches(ver, sets) and (best_ver is None or ver > best_ver):
+            best, best_ver = item, ver
+    return best
