@@ -0,0 +1,69 @@
+import os
+import unittest
+
+from relnotes import render_release
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+CHANGELOG = os.path.join(HERE, "..", "CHANGELOG.md")
+
+
+class RulesTest(unittest.TestCase):
+    def test_unreleased_without_date_renders_header(self):
+        text = "## [Unreleased]\n\n- Soon.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Soon.\n")
+
+    def test_multiline_comment_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.\n<!--\nline a\nline b\n-->\n- Two.\n"
+        # The comment's own line is blank afterwards; blank runs are collapsed, not removed.
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_inline_comment_mid_line(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A <!-- note --> b\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A b\n")
+
+    def test_trailing_whitespace_after_comment_dropped(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A bug.   <!-- x -->   \n- Next.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A bug.\n- Next.\n")
+
+    def test_blank_runs_collapse_and_edges_trimmed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- A.\n\n\n\n- B.\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_blank_lines_left_by_comments_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A.\n\n<!-- hidden -->\n\n- B.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_comment_containing_heading_is_not_a_release(self):
+        text = (
+            "## [1.0.0] - 2024-01-01\n\n- A.\n<!--\n## [9.9.9] - 2030-01-01\n-->\n"
+        )
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_windows_line_endings(self):
+        text = "## [1.0.0] - 2024-01-01\r\n\r\n- A. <!-- x -->\r\n- B.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n- B.\n")
+
+    def test_single_digit_day_date(self):
+        text = "## [1.0.0] - 2024-05-02\n\n- A.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-05-02)\n\n- A.\n")
+
+    def test_real_changelog_2_4_0(self):
+        with open(CHANGELOG, encoding="utf-8") as handle:
+            text = handle.read()
+        expected = (
+            "# 2.4.0 (2024-05-02)\n\n"
+            "### Added\n"
+            "- Support for `## [Unreleased]` sections.\n"
+            "- `--output` flag for writing notes to a file.\n\n"
+            "### Fixed\n"
+            "- Dates with single-digit days are parsed correctly.\n\n"
+            "### Changed\n"
+            "- Minimum supported Python is now 3.10.\n"
+        )
+        self.assertEqual(render_release(text, "2.4.0"), expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
