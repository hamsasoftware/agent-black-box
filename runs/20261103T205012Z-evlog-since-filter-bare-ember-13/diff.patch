+def parse_since(text):
+    """Parse a --since value. Dates are taken as midnight UTC, like naive timestamps."""
+    try:
+        value = datetime.fromisoformat(text)
+        return as_utc(value)
+    except (ValueError, OverflowError):
+        raise argparse.ArgumentTypeError(
+            f"invalid date/time {text!r}; expected e.g. 2024-03-10 or 2024-03-10T08:00:00+09:00"
+        ) from None
 
 
