+import re
+from functools import lru_cache
+
 from .version import Version
 
+_OPERATORS = frozenset(["<=", ">=", "<", ">", "=", "~", "^"])
+_COMPARATOR = re.compile(r"(<=|>=|<|>|=|~|\^)?(.*)", re.S)
+_NUMBER = re.compile(r"0|[1-9]\d*")
+_WILDCARDS = frozenset(["x", "X", "*"])
+
+
+def _parse_body(body):
+    """Parse a version without operator.
+
+    Returns ("full", Version) or ("partial", (major, minor, patch)) where a
+    missing or wildcard position is None.
+    """
+    if body[:1] == "v":
+        body = body[1:]
+    body = body.split("+", 1)[0]  # build metadata is ignored
+    if not body:
+        raise ValueError("empty version in range")
+    if "-" in body:
+        return "full", Version.parse(body)  # prerelease: must be complete
+    parts = body.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version in range: {body!r}")
+    values = []
+    wild = False
+    for part in parts:
+        if part in _WILDCARDS:
+            wild = True
+            values.append(None)
+        elif wild or not _NUMBER.fullmatch(part):
+            raise ValueError(f"invalid version in range: {body!r}")
+        else:
+            values.append(int(part))
+    values += [None] * (3 - len(values))
+    if None not in values:
+        return "full", Version(*values)
+    return "partial", tuple(values)
+
+
+def _desugar(op, kind, value):
+    """Turn one comparator into (operator, Version) constraints.
+
+    Returns a list of constraints, or None if the comparator matches nothing.
+    """
+    if kind == "full":
+        exact = value
+        major, minor, patch = value.release
+    else:
+        exact = None
+        major, minor, patch = value
+
+    if op in ("~", "^"):
+        if major is None:
+            return []
+        lower = exact if exact is not None else Version(major, minor or 0, patch or 0)
+        if op == "~":
+            upper = Version(major + 1, 0, 0) if minor is None else Version(major, minor + 1, 0)
+        elif major > 0:
+            upper = Version(major + 1, 0, 0)
+        elif minor is None:
+            upper = Version(1, 0, 0)
+        elif minor > 0:
+            upper = Version(0, minor + 1, 0)
+        elif patch is None:
+            upper = Version(0, 1, 0)
+        else:
+            upper = Version(0, 0, patch + 1)
+        return [(">=", lower), ("<", upper)]
+
+    if op in (None, "="):
+        if exact is not None:
+            return [("=", exact)]
+        if major is None:
+            return []
+        upper = Version(major + 1, 0, 0) if minor is None else Version(major, minor + 1, 0)
+        return [(">=", Version(major, minor or 0, patch or 0)), ("<", upper)]
+
+    if op == ">":
+        if exact is not None:
+            return [(">", exact)]
+        if major is None:
+            return None
+        if minor is None:
+            return [(">=", Version(major + 1, 0, 0))]
+        return [(">=", Version(major, minor + 1, 0))]
+
+    if op == ">=":
+        if exact is not None:
+            return [(">=", exact)]
+        if major is None:
+            return []
+        return [(">=", Version(major, minor or 0, patch or 0))]
+
+    if op == "<":
+        if exact is not None:
+            return [("<", exact)]
+        if major is None:
+            return None
+        return [("<", Version(major, minor or 0, patch or 0))]
+
+    # op == "<="
+    if exact is not None:
+        return [("<=", exact)]
+    if major is None:
+        return []
+    if minor is None:
+        return [("<", Version(major + 1, 0, 0))]
+    return [("<", Version(major, minor + 1, 0))]
+
+
+def _comparator(token):
+    match = _COMPARATOR.fullmatch(token)
+    op, body = match.group(1), match.group(2)
+    kind, value = _parse_body(body)
+    return _desugar(op, kind, value)
+
+
+def _hyphen(low, high):
+    kind_low, low_value = _parse_body(low)
+    kind_high, high_value = _parse_body(high)
+    constraints = []
+    if kind_low == "full":
+        constraints.append((">=", low_value))
+    elif low_value[0] is not None:
+        major, minor, patch = low_value
+        constraints.append((">=", Version(major, minor or 0, patch or 0)))
+    if kind_high == "full":
+        constraints.append(("<=", high_value))
+    elif high_value[0] is not None:
+        major, minor, _ = high_value
+        if minor is None:
+            constraints.append(("<", Version(major + 1, 0, 0)))
+        else:
+            constraints.append(("<", Version(major, minor + 1, 0)))
+    return constraints
+
+
+def _parse_set(text):
+    """Return the constraints of one comparator set, or None if it matches nothing."""
+    tokens = text.split()
+    constraints = []
+    i = 0
+    while i < len(tokens):
+        if i + 2 < len(tokens) and tokens[i + 1] == "-":
+            constraints += _hyphen(tokens[i], tokens[i + 2])
+            i += 3
+            continue
+        token = tokens[i]
+        i += 1
+        if token in _OPERATORS and i < len(tokens) and tokens[i] != "-":
+            token += tokens[i]  # "> 1.2" is the same as ">1.2"
+            i += 1
+        comparators = _comparator(token)
+        if comparators is None:
+            return None
+        constraints += comparators
+    return tuple(constraints)
+
+
+@lru_cache(maxsize=256)
+def _parse(range_):
+    """Parse a range into a tuple of comparator sets (None for a set that matches nothing)."""
+    return tuple(_parse_set(text) for text in range_.split("||"))
+
+
+def _set_matches(version, constraints):
+    if constraints is None:
+        return False
+    for op, bound in constraints:
+        if op == "<":
+            ok = version < bound
+        elif op == "<=":
+            ok = version <= bound
+        elif op == ">":
+            ok = version > bound
+        elif op == ">=":
+            ok = version >= bound
+        else:
+            ok = version == bound
+        if not ok:
+            return False
+    if version.prerelease:
+        # A prerelease only matches if the set names a prerelease of the same release.
+        return any(bound.prerelease and bound.release == version.release
+                   for _, bound in constraints)
+    return True
+
+
+def _as_version(value):
+    return value if isinstance(value, Version) else Version.parse(value)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    if not isinstance(range_, str):
+        raise TypeError(f"range must be a string, not {type(range_).__name__}")
+    parsed = _as_version(version)
+    return any(_set_matches(parsed, constraints) for constraints in _parse(range_))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    if not isinstance(range_, str):
+        raise TypeError(f"range must be a string, not {type(range_).__name__}")
+    sets = _parse(range_)
+    best_item = None
+    best = None
+    for item in versions:
+        parsed = _as_version(item)
+        if best is not None and not best < parsed:
+            continue
+        if any(_set_matches(parsed, constraints) for constraints in sets):
+            best_item, best = item, parsed
+    return best_item
