+def parse_since(value):
+    """Parse a --since value (a date like 2024-03-10, or an ISO timestamp) into aware UTC."""
+    try:
+        ts = datetime.fromisoformat(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(
+            f"invalid date {value!r}: expected YYYY-MM-DD or an ISO 8601 timestamp, e.g. 2024-03-10"
+        ) from None
+    return to_utc(ts)
 
 
