@@ -0,0 +1,38 @@
+import os
+
+from .config import DEFAULTS, load_config
+
+# Secrets are never printed in full, because doctor output is pasted into tickets.
+SECRET_KEYS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def _show(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        if len(value) > 8:
+            return f"(redacted, {len(value)} chars, ends with {value[-4:]!r})"
+        return f"(redacted, {len(value)} chars)"
+    return repr(value)
+
+
+def format_doctor(config, dotenv_path=".env"):
+    width = max(len(key) for key in config)
+    lines = [
+        "payhook doctor",
+        f"working directory: {os.getcwd()}",
+        f"dotenv file: {os.path.abspath(dotenv_path)} "
+        + ("(found)" if os.path.exists(dotenv_path) else "(not found)"),
+        "settings:",
+    ]
+    for key, (value, source) in config.items():
+        lines.append(f"  {key.ljust(width)} = {_show(key, value)}  [source: {source}]")
+    missing = [k for k, (v, _) in config.items() if v is None]
+    lines.append("missing required: " + (", ".join(missing) if missing else "none"))
+    return "\n".join(lines)
+
+
+def run_doctor(dotenv_path=".env"):
+    config = load_config(dotenv_path=dotenv_path)
+    print(format_doctor(config, dotenv_path=dotenv_path))
+    return 0
