+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedRng:
+    """Stand-in RNG that always returns one end of the jitter range."""
+
+    def __init__(self, factor):
+        self.factor = factor
+
+    def uniform(self, lo, hi):
+        return lo + (hi - lo) * self.factor
+
+
+class CapRegressionTest(unittest.TestCase):
+    def test_max_jitter_never_exceeds_cap(self):
+        # Uncapped base for attempt 7 is 32; with jitter 1.1 that is 35.2 > cap=34.
+        delay = compute_delay(7, base=0.5, cap=34, jitter=0.1, rng=_FixedRng(1.0))
+        self.assertEqual(delay, 34)
+
+    def test_capped_attempt_is_exactly_cap_at_max_jitter(self):
+        delay = compute_delay(20, base=0.5, cap=34, jitter=0.1, rng=_FixedRng(1.0))
+        self.assertEqual(delay, 34)
+
+    def test_schedule_respects_cap_for_many_seeds(self):
+        # Deterministic: every seed is fixed, so this either always passes or always fails.
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertGreaterEqual(delay, 0)
+                self.assertLessEqual(delay, 34)
+
+    def test_delays_are_never_negative(self):
+        rng = random.Random(3)
+        for attempt in range(1, 12):
+            delay = compute_delay(attempt, base=0.5, cap=30, jitter=0.1, rng=rng)
+            self.assertGreaterEqual(delay, 0)
+            self.assertLessEqual(delay, 30)
+
+
+if __name__ == "__main__":
+    unittest.main()
