index 03aa339..e4030d6 100644
--- a/blobstore/codec.py
+++ b/blobstore/codec.py
@@ -1,13 +1,20 @@
 import zlib
 
-MAGIC = b"BZ1"
+MAGIC = b"BZ1"  # zlib-compressed payload
+STORED_MAGIC = b"BZ0"  # raw payload, used when compression doesn't help
+OVERHEAD = len(MAGIC)  # worst-case growth in bytes (no lossless codec can do better than >= 0 for all inputs)
 
 
 def encode(data: bytes) -> bytes:
-    return MAGIC + zlib.compress(data, 6)
+    compressed = zlib.compress(data, 6)
+    if len(compressed) < len(data):
+        return MAGIC + compressed
+    return STORED_MAGIC + data
 
 
 def decode(blob: bytes) -> bytes:
-    if not blob.startswith(MAGIC):
-        raise ValueError("not a blobstore blob")
-    return zlib.decompress(blob[len(MAGIC):])
+    if blob.startswith(MAGIC):
+        return zlib.decompress(blob[len(MAGIC):])
+    if blob.startswith(STORED_MAGIC):
+        return blob[len(STORED_MAGIC):]
+    raise ValueError("not a blobstore blob")
