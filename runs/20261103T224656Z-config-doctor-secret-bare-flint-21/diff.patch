+
+
+def _display_value(key, value):
+    if value is None:
+        return "<not set>"
+    if key in SECRET_KEYS:
+        return f"<redacted, {len(value)} chars>"
+    return value
+
+
+def doctor_report(environ=None, dotenv_path=".env"):
+    """Return the human-readable configuration report printed by `python -m payhook doctor`."""
+    environ = os.environ if environ is None else environ
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    lines = [
+        "payhook configuration",
+        f"dotenv file: {os.path.abspath(dotenv_path)} "
+        f"({'found' if os.path.exists(dotenv_path) else 'not found'})",
+        "",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        shown = _display_value(key, value)
+        lines.append(f"{key.ljust(width)} = {shown}  [source: {source}]")
+    missing = [k for k, (v, _) in config.items() if v is None]
+    lines.append("")
+    lines.append("missing required: " + ", ".join(missing) if missing else "missing required: none")
+    return "\n".join(lines)
