+# Settings whose values must never be printed in full (doctor output is pasted into tickets).
+SECRET_KEYS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def _unquote(value):
+    """Strip one matching pair of surrounding quotes. Single quotes are literal;
+    double quotes also honour backslash escapes for \\" and \\\\."""
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        inner = value[1:-1]
+        if value[0] == '"':
+            inner = inner.replace('\\"', '"').replace("\\\\", "\\")
+        return inner
+    return value
+
+
+def _parse_line(line):
+    """Return (key, value) for a KEY=VALUE line, or None for blank, comment or malformed lines."""
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if line.startswith("export ") or line.startswith("export\t"):
+        line = line[len("export"):].lstrip()
+    if "=" not in line:
+        return None
+    key, value = line.split("=", 1)
+    key = key.strip()
+    if not key:
+        return None
+    return key, _unquote(value.strip())
+
 
 def read_dotenv(path):
