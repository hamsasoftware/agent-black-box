+"""npm-style version ranges. The contract is docs/RANGES.md."""
+
+import operator
+import re
+
 from .version import Version
 
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+# An operator followed by spaces is joined to its version: ">= 1.2.3" -> ">=1.2.3".
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+# Optional operator, then the rest of the comparator text.
+_COMPARATOR = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$")
+# A possibly partial version: positions are digits or wildcards, the rest is prerelease/build.
+_PARTIAL = re.compile(r"^[vV]?(\d+|[xX*])?(?:\.(\d+|[xX*]))?(?:\.(\d+|[xX*]))?(.*)$")
+_WILDCARDS = ("x", "X", "*")
+
+
+def _partial(text):
+    """Split a partial version into (major, minor, patch, rest); wildcards and gaps are None."""
+    match = _PARTIAL.match(text)
+    if not match:
+        raise ValueError(f"invalid version in range: {text!r}")
+    raw = match.group(1, 2, 3)
+    rest = match.group(4)
+    parts = []
+    wild = False
+    for item in raw:
+        if item is None or item in _WILDCARDS:
+            wild = True
+            parts.append(None)
+        elif wild:
+            # A wildcard may not be followed by a number: "1.x.3" is invalid.
+            raise ValueError(f"invalid version in range: {text!r}")
+        else:
+            parts.append(int(item))
+    major, minor, patch = parts
+    if rest and (patch is None or rest[0] not in "-+"):
+        raise ValueError(f"invalid version in range: {text!r}")
+    return major, minor, patch, rest
+
+
+def _version(major, minor, patch, rest):
+    return Version.parse(f"{major}.{minor}.{patch}{rest}")
+
+
+def _lower(major, minor, patch, rest):
+    """The lowest version a partial can stand for (missing positions are zero)."""
+    return _version(major or 0, minor or 0, patch or 0, rest)
+
+
+def _ceiling(major, minor):
+    """The first version above everything a partial major[.minor] stands for, or None for any."""
+    if major is None:
+        return None
+    if minor is None:
+        return Version(major + 1, 0, 0)
+    return Version(major, minor + 1, 0)
+
+
+def _hyphen(low_text, high_text):
+    prims = []
+    major, minor, patch, rest = _partial(low_text)
+    if major is not None:
+        prims.append((">=", _lower(major, minor, patch, rest)))
+    major, minor, patch, rest = _partial(high_text)
+    if patch is not None:
+        prims.append(("<=", _version(major, minor, patch, rest)))
+    else:
+        # A partial high bound means "below the next": "2.3" is <2.4.0, "2" is <3.0.0.
+        ceiling = _ceiling(major, minor)
+        if ceiling is not None:
+            prims.append(("<", ceiling))
+    return prims
+
+
+def _comparator(op, text):
+    """Expand one comparator into primitive (operator, Version) bounds."""
+    if not text:
+        raise ValueError(f"comparator {op!r} has no version")
+    major, minor, patch, rest = _partial(text)
+    full = patch is not None
+    if op in ("", "="):
+        if full:
+            return [("=", _version(major, minor, patch, rest))]
+        if major is None:
+            return []
+        return [(">=", _lower(major, minor, patch, rest)), ("<", _ceiling(major, minor))]
+    if op == ">":
+        if full:
+            return [(">", _version(major, minor, patch, rest))]
+        ceiling = _ceiling(major, minor)
+        # ">*" matches nothing.
+        return [(">=", ceiling)] if ceiling is not None else [("<", Version(0, 0, 0))]
+    if op == ">=":
+        if full:
+            return [(">=", _version(major, minor, patch, rest))]
+        return [(">=", _lower(major, minor, patch, rest))]
+    if op == "<":
+        if full:
+            return [("<", _version(major, minor, patch, rest))]
+        return [("<", _lower(major, minor, patch, rest))]
+    if op == "<=":
+        if full:
+            return [("<=", _version(major, minor, patch, rest))]
+        ceiling = _ceiling(major, minor)
+        return [("<", ceiling)] if ceiling is not None else []
+    if major is None:
+        return []  # "~*" and "^*" match any release
+    if op == "~":
+        if full:
+            upper = Version(major, minor + 1, 0)
+        else:
+            upper = _ceiling(major, minor)
+        return [(">=", _lower(major, minor, patch, rest)), ("<", upper)]
+    if op == "^":
+        if full:
+            if major > 0:
+                upper = Version(major + 1, 0, 0)
+            elif minor > 0:
+                upper = Version(0, minor + 1, 0)
+            else:
+                upper = Version(0, 0, patch + 1)
+        else:
+            if major > 0:
+                upper = Version(major + 1, 0, 0)
+            elif minor is None:
+                upper = Version(1, 0, 0)
+            else:
+                upper = Version(0, minor + 1, 0)
+        return [(">=", _lower(major, minor, patch, rest)), ("<", upper)]
+    raise ValueError(f"unknown operator {op!r}")  # pragma: no cover
+
+
+def _parse_set(text):
+    """Parse one comparator set into a list of primitive (operator, Version) bounds."""
+    tokens = _OP_SPACE.sub(r"\1", text.strip()).split()
+    prims = []
+    i = 0
+    while i < len(tokens):
+        if i + 2 < len(tokens) and tokens[i + 1] == "-":
+            prims.extend(_hyphen(tokens[i], tokens[i + 2]))
+            i += 3
+            continue
+        match = _COMPARATOR.match(tokens[i])
+        prims.extend(_comparator(match.group(1) or "", match.group(2)))
+        i += 1
+    return prims
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise TypeError(f"range must be a string, not {type(range_).__name__}")
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise TypeError(f"version must be a string, not {type(version).__name__}")
+
+
+def _matches(version, sets):
+    for prims in sets:
+        if not all(_OPS[op](version, bound) for op, bound in prims):
+            continue
+        # Prerelease versions match only when a comparator in the same set names
+        # the same MAJOR.MINOR.PATCH with a prerelease tag.
+        if version.prerelease and not any(
+            bound.prerelease and bound.release == version.release for _, bound in prims
+        ):
+            continue
+        return True
+    return False
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_coerce(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        candidate = _coerce(item)
+        if _matches(candidate, sets) and (best_version is None or candidate > best_version):
+            best, best_version = item, candidate
+    return best
