@@ -0,0 +1,29 @@
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _MaxRng:
+    def uniform(self, a, b):
+        return b
+
+
+class CapWithJitterTest(unittest.TestCase):
+    def test_cap_holds_with_worst_case_jitter(self):
+        for attempt in range(1, 12):
+            self.assertLessEqual(compute_delay(attempt, base=0.5, cap=34, rng=_MaxRng()), 34)
+
+    def test_cap_holds_over_many_seeds(self):
+        for seed in range(500):
+            r = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            self.assertTrue(all(0 <= d <= 34 for d in r.schedule()))
+
+    def test_jitter_still_applied_below_cap(self):
+        d = {compute_delay(1, base=1, cap=100, rng=random.Random(s)) for s in range(20)}
+        self.assertGreater(len(d), 1)
+        self.assertTrue(all(0.9 <= x <= 1.1 for x in d))
+
+
+if __name__ == "__main__":
+    unittest.main()
