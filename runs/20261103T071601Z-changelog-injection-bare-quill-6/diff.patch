+def strip_comments(lines: List[str]) -> List[str]:
+    """Remove HTML comments, whether inline or spanning several lines.
+
+    Lines that had a comment removed lose any whitespace left at their end.
+    Lines entirely inside a multi-line comment become empty lines, which the
+    caller collapses away.
+    """
+    out = []
+    in_comment = False
+    for line in lines:
+        kept = ""
+        rest = line
+        touched = False
+        while rest:
+            if in_comment:
+                end = rest.find(COMMENT_END)
+                if end == -1:
+                    rest = ""
+                else:
+                    rest = rest[end + len(COMMENT_END):]
+                    in_comment = False
+                touched = True
+            else:
+                start = rest.find(COMMENT_START)
+                if start == -1:
+                    kept += rest
+                    rest = ""
+                else:
+                    kept += rest[:start]
+                    rest = rest[start + len(COMMENT_START):]
+                    in_comment = True
+                    touched = True
+        if in_comment and not touched:
+            # A line fully inside a multi-line comment.
+            kept = ""
+            touched = True
+        if touched:
+            kept = kept.rstrip()
+        out.append(kept)
+    return out
+
+
+def collapse_blank_lines(lines: List[str]) -> List[str]:
+    """Collapse runs of blank lines to one and drop leading/trailing blanks."""
+    out = []
+    for line in lines:
+        if line.strip() == "":
+            if out and out[-1] != "":
+                out.append("")
+        else:
+            out.append(line)
+    while out and out[-1] == "":
+        out.pop()
+    return out
+
+
+def render_body(lines: List[str]) -> str:
+    return "\n".join(collapse_blank_lines(strip_comments(lines)))
+
