+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _Max:
+    def uniform(self, a, b):
+        return b
+
+
+class CapWithJitterTest(unittest.TestCase):
+    def test_cap_never_exceeded_for_any_seed(self):
+        for seed in range(2000):
+            r = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for d in r.schedule():
+                self.assertLessEqual(d, 34)
+                self.assertGreaterEqual(d, 0)
+
+    def test_worst_case_jitter_is_clamped(self):
+        self.assertEqual(compute_delay(7, base=0.5, cap=34, rng=_Max()), 34)
+
+    def test_jitter_still_applied_below_cap(self):
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, jitter=0.1, rng=_Max()), 1.1)
+
+    def test_jitter_still_varies_when_nominal_delay_equals_cap(self):
+        # Nominal 32 == cap: downward jitter survives, upward is clamped.
+        delays = {compute_delay(7, base=0.5, cap=32, jitter=0.1, rng=random.Random(s)) for s in range(50)}
+        self.assertGreater(len(delays), 1)
+        self.assertLessEqual(max(delays), 32)
+
+
+if __name__ == "__main__":
+    unittest.main()
