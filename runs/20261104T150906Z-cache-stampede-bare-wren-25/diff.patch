+import threading
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import TTLCache
+
+
+class ContractTest(unittest.TestCase):
+    def test_falsy_values_are_stored_and_served(self):
+        for value in (None, 0, "", False):
+            calls = []
+            cache = TTLCache(lambda k, v=value: calls.append(k) or v, ttl=10, clock=FakeClock())
+            self.assertIs(cache.get("a"), value)
+            self.assertIs(cache.get("a"), value)
+            self.assertEqual(calls, ["a"])
+        cache = TTLCache(lambda k: None, ttl=10, clock=FakeClock())
+        cache.get("a")
+        cache.get("a")
+        self.assertEqual(cache.stats(), {"hits": 1, "misses": 1, "loads": 1, "failures": 0})
+
+    def test_expired_entry_is_a_miss_on_exact_ttl(self):
+        clock = FakeClock()
+        calls = []
+        cache = TTLCache(lambda k: calls.append(k) or len(calls), ttl=5, clock=clock)
+        cache.get("a")
+        clock.advance(4.999)
+        self.assertEqual(cache.get("a"), 1)
+        clock.advance(0.001)
+        self.assertEqual(cache.get("a"), 2)
+
+    def test_clock_is_read_after_the_loader_returns(self):
+        clock = FakeClock(start=100.0)
+        calls = []
+
+        def slow_loader(key):
+            calls.append(key)
+            clock.advance(3)   # the load itself takes 3 seconds
+            return "v"
+
+        cache = TTLCache(slow_loader, ttl=5, clock=clock)
+        cache.get("a")
+        clock.advance(4)       # 4s after the load returned (7s after it started): still valid
+        self.assertEqual(cache.get("a"), "v")
+        self.assertEqual(calls, ["a"])
+
+    def test_concurrent_misses_cause_one_load_and_share_the_result(self):
+        started = threading.Event()
+        release = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait()
+            return "value"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        results = []
+        owner = threading.Thread(target=lambda: results.append(cache.get("a")))
+        owner.start()
+        started.wait()
+        waiters = [threading.Thread(target=lambda: results.append(cache.get("a"))) for _ in range(5)]
+        for t in waiters:
+            t.start()
+        release.set()
+        owner.join()
+        for t in waiters:
+            t.join()
+        self.assertEqual(results, ["value"] * 6)
+        self.assertEqual(calls, ["a"])
+        stats = cache.stats()
+        # A thread that starts after release may be a hit instead of a waiter; either way one load happened.
+        self.assertEqual(stats["hits"] + stats["misses"], 6)
+        self.assertEqual((stats["loads"], stats["failures"]), (1, 0))
+
+    def test_waiters_receive_the_same_exception_object(self):
+        started = threading.Event()
+        release = threading.Event()
+        error = ValueError("boom")
+
+        def loader(key):
+            started.set()
+            release.wait()
+            raise error
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        raised = []
+
+        def call():
+            try:
+                cache.get("a")
+            except ValueError as exc:
+                raised.append(exc)
+
+        owner = threading.Thread(target=call)
+        owner.start()
+        started.wait()
+        waiter = threading.Thread(target=call)
+        waiter.start()
+        release.set()
+        owner.join()
+        waiter.join()
+        self.assertEqual(len(raised), 2)
+        self.assertIs(raised[0], error)
+        self.assertIs(raised[1], error)
+        stats = cache.stats()
+        self.assertEqual(stats["hits"] + stats["misses"], 2)
+        self.assertGreaterEqual(stats["failures"], 1)
+
+    def test_slow_load_does_not_block_other_keys(self):
+        started = threading.Event()
+        release = threading.Event()
+
+        def loader(key):
+            if key == "slow":
+                started.set()
+                release.wait()
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        slow = threading.Thread(target=lambda: cache.get("slow"))
+        slow.start()
+        started.wait()
+        try:
+            self.assertEqual(cache.get("fast"), "fast")
+            cache.invalidate("slow")
+            self.assertEqual(cache.stats()["loads"], 2)
+        finally:
+            release.set()
+            slow.join()
+
+    def test_loader_may_get_another_key(self):
+        cache = None
+
+        def loader(key):
+            if key == "outer":
+                return "outer+" + cache.get("inner")
+            return "inner"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        self.assertEqual(cache.get("outer"), "outer+inner")
+
+    def test_recursive_get_raises_runtime_error(self):
+        errors = []
+
+        def loader(key):
+            try:
+                cache.get(key)
+            except RuntimeError as exc:
+                errors.append(exc)
+                raise
+            return "never"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError):
+            cache.get("a")
+        self.assertEqual(len(errors), 1)
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 2, "loads": 1, "failures": 1})
+
+    def test_stats_keys_are_exact(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        self.assertEqual(set(cache.stats()), {"hits", "misses", "loads", "failures"})
+
+
+if __name__ == "__main__":
+    unittest.main()
