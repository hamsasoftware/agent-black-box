+# `KEY=value`, optionally prefixed with `export `. Anything else is ignored.
+_LINE_RE = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
+
+
+def _parse_value(raw):
+    value = raw.strip()
+    if value[:1] in ("'", '"'):
+        end = value.find(value[0], 1)
+        if end != -1:
+            # Quoted: take everything between the quotes; anything after is ignored.
+            return value[1:end]
+    # Unquoted: a `#` preceded by whitespace starts an inline comment.
+    for i, ch in enumerate(value):
+        if ch == "#" and i > 0 and value[i - 1].isspace():
+            return value[:i].rstrip()
+    return value
+
 
