new file mode 100644
index 0000000..744f06f
--- /dev/null
+++ b/payhook/doctor.py
@@ -0,0 +1,38 @@
+import os
+
+from .config import DEFAULTS, SECRET_KEYS, load_config
+
+
+def _display(key, value):
+    if value is None:
+        return "<not set>"
+    if key in SECRET_KEYS:
+        # Never print secrets, not even partially: tickets are shared widely.
+        return f"<set, {len(value)} chars, masked>"
+    return value
+
+
+def render_doctor(config, dotenv_path):
+    lines = ["payhook doctor", ""]
+    found = "found" if os.path.exists(dotenv_path) else "not found"
+    lines.append(f"dotenv file: {os.path.abspath(dotenv_path)} ({found})")
+    lines.append("")
+    width = max(len(key) for key in DEFAULTS)
+    labels = {"env": "environment", ".env": ".env", "default": "default"}
+    shown = [
+        (key, _display(key, value), labels[source])
+        for key, (value, source) in config.items()
+    ]
+    value_width = max(len(text) for _, text, _ in shown)
+    lines.append(f"{'setting'.ljust(width)}  {'effective value'.ljust(value_width)}  source")
+    for key, text, source in shown:
+        lines.append(f"{key.ljust(width)}  {text.ljust(value_width)}  {source}")
+    missing = [k for k, (v, _) in config.items() if v is None]
+    lines.append("")
+    lines.append("missing required: " + (", ".join(missing) if missing else "none"))
+    return "\n".join(lines)
+
+
+def doctor(dotenv_path=".env", environ=None):
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    return render_doctor(config, dotenv_path)
