+class ReportsTest(unittest.TestCase):
+    def test_average_rounds_half_to_even(self):
+        order = Order([Item("A", "1.000", 3)])
+        self.assertEqual(reports.average_weight_kg(order), "1.000")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001", 2)])), "0.001")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.005", 2)])), "0.005")
+        # ties: 3 g over 2 units is 1.5 g -> 2 g; 7 g over 2 units is 3.5 g -> 4 g
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001"), Item("B", "0.002")])), "0.002")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.005"), Item("B", "0.002")])), "0.004")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "1.900", 1), Item("B", "0.001", 2)])), "0.634")
+
+    def test_average_of_empty_order(self):
+        self.assertEqual(reports.average_weight_kg(Order()), "0.000")
+
+    def test_heaviest_and_bands(self):
+        order = Order([Item("B", "0.500", 2), Item("A", "0.500"), Item("C", "2.000"), Item("D", "2.001")])
+        self.assertEqual([i.sku for i in reports.heaviest(order, 3)], ["D", "C", "A"])
+        self.assertEqual(reports.weight_bands(order), {"light": 3, "medium": 1, "heavy": 1})
