diff --git a/tests/test_migration.py b/tests/test_migration.py
new file mode 100644
index 0000000..018fd9d
--- /dev/null
+++ b/tests/test_migration.py
@@ -0,0 +1,211 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from shipcalc import cache, cli, export, format as fmt, limits, reports, storage
+from shipcalc.calc import order_weight_kg
+from shipcalc.models import Item, Order
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+from shipcalc.validate import validate_item
+
+
+class UnitsTest(unittest.TestCase):
+    def test_normalize_pads_and_keeps_three_places(self):
+        self.assertEqual(normalize_kg("2"), "2.000")
+        self.assertEqual(normalize_kg("0.250"), "0.250")
+        self.assertEqual(normalize_kg("1000.000"), "1000.000")
+
+    def test_rounds_half_to_even(self):
+        self.assertEqual(normalize_kg("1.0005"), "1.000")
+        self.assertEqual(normalize_kg("1.0015"), "1.002")
+        self.assertEqual(normalize_kg("2.0025"), "2.002")
+        self.assertEqual(normalize_kg("1.2345"), "1.234")
+        self.assertEqual(normalize_kg("1.2346"), "1.235")
+
+    def test_rejects_invalid_strings(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", "١"]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+
+    def test_rejects_non_strings_with_repr_message(self):
+        for bad in [1, 1.5, True, None]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError) as ctx:
+                normalize_kg(bad)
+            self.assertEqual(str(ctx.exception), f"invalid weight: {bad!r}")
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg("abc")
+        self.assertEqual(str(ctx.exception), "invalid weight: 'abc'")
+
+    def test_weight_error_is_value_error(self):
+        self.assertTrue(issubclass(WeightError, ValueError))
+
+    def test_kg_and_grams_conversions(self):
