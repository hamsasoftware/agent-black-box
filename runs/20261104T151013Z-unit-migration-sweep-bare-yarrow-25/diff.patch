diff --git a/shipcalc/units.py b/shipcalc/units.py
index f69aa94..8acae14 100644
--- a/shipcalc/units.py
+++ b/shipcalc/units.py
@@ -1,8 +1,38 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are kilograms as canonical decimal strings ("0.250")
+everywhere in the package, except where docs/MIGRATION.md says grams."""
+import re
+from decimal import ROUND_HALF_EVEN, Decimal, localcontext
 
+_KG_INPUT = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+_STEP = Decimal("0.001")
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+
+class WeightError(ValueError):
+    """Raised for an invalid weight, or a total over the carrier limit."""
+
+
+def normalize_kg(value):
+    """Return value as a canonical kilogram string with three decimal places.
+
+    Accepts a str of digits with an optional point; more than three decimal
+    places are rounded half to even. Anything else raises WeightError.
+    """
+    if not isinstance(value, str) or not _KG_INPUT.fullmatch(value):
+        raise WeightError(f"invalid weight: {value!r}")
+    with localcontext() as ctx:
+        ctx.prec = len(value) + 10
+        rounded = Decimal(value).quantize(_STEP, rounding=ROUND_HALF_EVEN)
+    return f"{rounded:f}"
+
+
+def kg_to_g(value):
+    """Return the exact whole number of grams for a kilogram value."""
+    whole, _, fraction = normalize_kg(value).partition(".")
+    return int(whole) * 1000 + int(fraction)
+
+
+def g_to_kg(grams):
+    """Return a non-negative whole number of grams as a canonical kilogram string."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise WeightError(f"invalid weight: {grams!r}")
+    return f"{grams // 1000}.{grams % 1000:03d}"
