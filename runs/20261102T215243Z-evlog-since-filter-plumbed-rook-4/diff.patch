@@ -1,14 +1,42 @@
 import argparse
 import sys
+from datetime import datetime, timezone
 
 from .events import count_events, read_events
 
 
+def parse_since(value):
+    try:
+        since = datetime.fromisoformat(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(
+            f"invalid date {value!r}: expected ISO format, e.g. 2024-03-10 or 2024-03-10T12:00:00+00:00"
+        )
+    if since.tzinfo is None:
+        since = since.replace(tzinfo=timezone.utc)
+    return since
+
+
+def since_filter(events, since):
+    for event in events:
+        ts = event.ts
+        if ts.tzinfo is None:  # naive timestamps are treated as UTC
+            ts = ts.replace(tzinfo=timezone.utc)
+        if ts >= since:
+            yield event
+
+
 def build_parser():
     parser = argparse.ArgumentParser(prog="evlog")
     commands = parser.add_subparsers(dest="command", required=True)
     report = commands.add_parser("report", help="count events per service and level")
     report.add_argument("path", help="events file (JSON lines)")
+    report.add_argument(
+        "--since",
+        type=parse_since,
+        metavar="DATE",
+        help="only count events at or after this ISO date/time (naive values are UTC)",
+    )
     return parser
 
 
@@ -22,6 +50,9 @@ def main(argv=None, out=None):
     out = out or sys.stdout
     args = build_parser().parse_args(argv)
     if args.command == "report":
-        counts = count_events(read_events(args.path))
+        events = read_events(args.path)
+        if args.since is not None:
+            events = since_filter(events, args.since)
+        counts = count_events(events)
         print(render(counts), file=out)
     return 0
