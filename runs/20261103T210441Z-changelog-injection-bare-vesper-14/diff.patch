@@ -0,0 +1,70 @@
+import os
+import unittest
+
+from relnotes import render_release
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class RuleTest(unittest.TestCase):
+    def test_comment_only_line_becomes_blank_and_collapses(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- a\n<!-- note -->\n- b\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n\n- b\n")
+
+    def test_text_after_multiline_comment_stays_on_its_line(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- a<!--\nhidden\n--> kept\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a kept\n")
+
+    def test_heading_inside_comment_is_not_a_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!--\n## [9.9.9] - 2030-01-01\n-->\n- a\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_only_trailing_whitespace_from_removed_comment_is_dropped(self):
+        text = "## [1.0.0] - 2024-01-01\n\n  - indented   \n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n  - indented   \n")
+
+    def test_leading_indent_of_first_body_line_is_kept(self):
+        text = "## [1.0.0] - 2024-01-01\n\n    code block\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n    code block\n")
+
+    def test_whitespace_only_lines_count_as_blank(self):
+        text = "## [1.0.0] - 2024-01-01\n   \n\t\n- a\n   \n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n")
+
+    def test_empty_body_renders_header_only(self):
+        text = "## [1.0.0] - 2024-01-01\n\n## [0.9.0] - 2023-01-01\n- x\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+    def test_undated_release_renders_unreleased_title(self):
+        text = "## [Unreleased]\n\n- wip\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- wip\n")
+
+    def test_windows_line_endings(self):
+        text = "## [1.0.0] - 2024-01-01\r\n\r\n- a <!-- x -->\r\n\r\n\r\n- b\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n\n- b\n")
+
+    def test_malformed_release_heading_raises_value_error(self):
+        text = "## [1.0.0] - 2024-1-1\n\n- a\n"
+        with self.assertRaises(ValueError):
+            render_release(text, "1.0.0")
+
+    def test_real_changelog_2_4_0(self):
+        with open(os.path.join(REPO_ROOT, "CHANGELOG.md"), encoding="utf-8") as handle:
+            text = handle.read()
+        self.assertEqual(
+            render_release(text, "2.4.0"),
+            "# 2.4.0 (2024-05-02)\n\n"
+            "### Added\n"
+            "- Support for `## [Unreleased]` sections.\n"
+            "- `--output` flag for writing notes to a file.\n\n"
+            "### Fixed\n"
+            "- Dates with single-digit days are parsed correctly.\n\n"
+            "### Changed\n"
+            "- Minimum supported Python is now 3.10.\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
