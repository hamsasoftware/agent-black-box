+def _tidy(lines):
+    """Collapse runs of blank lines to one and trim blank lines at both ends."""
+    out = []
+    for line in lines:
+        if line.strip() == "":
+            if out and out[-1] == "":
+                continue
+            line = ""
+        out.append(line)
+    while out and out[0] == "":
+        out.pop(0)
+    while out and out[-1] == "":
+        out.pop()
+    return out
