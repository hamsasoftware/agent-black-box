+    A comment is replaced in place, so text after a multi-line comment's
+    closing ``-->`` stays on the line where the comment began. Lines that
+    had a comment removed lose their trailing whitespace.
+    """
+    lines = []
+    for line in COMMENT.sub(_MARK, text).splitlines():
+        if _MARK in line:
+            line = line.replace(_MARK, "").rstrip()
+        lines.append(line)
+    return lines
