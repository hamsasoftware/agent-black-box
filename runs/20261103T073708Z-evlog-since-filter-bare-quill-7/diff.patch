     report.add_argument("path", help="events file (JSON lines)")
+    report.add_argument(
+        "--since",
+        type=parse_since,
+        metavar="YYYY-MM-DD",
+        help="only count events at or after midnight UTC on this date",
+    )
     return parser
 
 
@@ -22,6 +38,13 @@ def main(argv=None, out=None):
     out = out or sys.stdout
