+import unittest
+
+from depres import max_satisfying, satisfies
+
+CASES = [
+    # (range, version, expected)
+    ("", "1.2.3", True), ("*", "0.0.0", True), ("", "1.2.3-alpha", False),
+    ("*", "1.2.3-alpha", False),
+    ("1.x", "1.9.9", True), ("1", "2.0.0", False), ("1.2", "1.2.9", True), ("1.2.x", "1.3.0", False),
+    (">1", "1.9.9", False), (">1", "2.0.0", True), (">1.2", "1.2.9", False), (">1.2", "1.3.0", True),
+    (">=1.2", "1.2.0", True), ("<1.2", "1.2.0", False), ("<1.2", "1.1.9", True),
+    ("<=1", "1.9.9", True), ("<=1", "2.0.0", False), ("<=1.2", "1.2.9", True), ("<=1.2", "1.3.0", False),
+    ("=1.2", "1.2.5", True), ("=1.2", "1.3.0", False), ("1.2.3", "1.2.3", True), ("=1.2.3", "1.2.4", False),
+    (">= 1.2.3", "1.2.3", True), ("1.2.3 - 2.3", "2.3.9", True), ("1.2.3 - 2.3", "2.4.0", False),
+    ("1.2.3 - 2", "2.9.9", True), ("1.2.3 - 2", "3.0.0", False), ("1.2 - 2", "1.2.0", True),
+    ("~1.2.3", "1.2.9", True), ("~1.2.3", "1.3.0", False), ("~1.2", "1.2.0", True), ("~1", "1.9.0", True),
+    ("~1", "2.0.0", False), ("~1.2.3-beta.2", "1.2.3-beta.4", True), ("~1.2.3-beta.2", "1.2.3", True),
+    ("~1.2.3-beta.2", "1.2.3-beta.1", False),
+    ("^0.0.3", "0.0.3", True), ("^0.0.3", "0.0.4", False), ("^1.2.x", "1.9.0", True), ("^0.0", "0.0.9", True),
+    ("^0.0", "0.1.0", False), ("^0.0.x", "0.1.0", False), ("^0", "0.9.0", True), ("^0.x", "1.0.0", False),
+    ("^1", "1.9.0", True), ("^0.2", "0.3.0", False),
+    (">=1.2.3-alpha.1 <1.3.0", "1.2.3-alpha.7", True), (">=1.2.3-alpha.1 <1.3.0", "1.2.4-alpha.1", False),
+    ("^1.0.0", "2.0.0-rc.1", False), ("^1.0.0", "1.5.0-beta", False),
+    ("^1.2.3-beta.2", "1.2.3-beta.3", True), ("^1.2.3-beta.2", "1.2.4-beta.3", False),
+    ("<2.0.0 || >=3.0.0", "2.5.0", False), ("1.x || ", "5.0.0", True),
+    ("1.2.3", "v1.2.3+build.5", True),
+]
+
+
+class ContractTest(unittest.TestCase):
+    def test_cases(self):
+        for range_, version, expected in CASES:
+            with self.subTest(range=range_, version=version):
+                self.assertIs(satisfies(version, range_), expected)
+
+    def test_invalid(self):
+        for r in ["1.x.3", ">=", "1.2.3 -", "- 1.2.3", "~", "foo", "1.2.3.4", ">>1"]:
+            with self.subTest(range=r), self.assertRaises(ValueError):
+                satisfies("1.0.0", r)
+        with self.assertRaises(ValueError):
+            satisfies("nope", "*")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bad"], "*")
+
+    def test_max_returns_original_string(self):
+        self.assertEqual(max_satisfying(["v1.2.0", "1.1.0+b"], "^1"), "v1.2.0")
+        self.assertEqual(max_satisfying(iter(["1.0.0-rc.1", "1.0.0-rc.2"]), ">=1.0.0-rc.1"), "1.0.0-rc.2")
