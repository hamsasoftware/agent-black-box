+import re
+
 from .version import Version
 
+_PART = r"(x|X|\*|0|[1-9]\d*)"
+_PARTIAL = re.compile(r"^v?" + _PART + r"(?:\." + _PART + r"(?:\." + _PART + r")?)?$")
+_OPS = ("<=", ">=", "<", ">", "=", "~", "^")
+_NEVER = ("<", Version(0, 0, 0))
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, prerelease); missing/wildcard parts are None."""
+    m = _PARTIAL.match(text)
+    if m:
+        parts = [None if g in ("x", "X", "*") else int(g) for g in m.groups() if g is not None]
+        parts += [None] * (3 - len(parts))
+        # a wildcard may not be followed by a number
+        for i in range(2):
+            if parts[i] is None and parts[i + 1] is not None:
+                raise ValueError("invalid range: wildcard followed by number in %r" % text)
+        return parts[0], parts[1], parts[2], ()
+    try:
+        v = Version.parse(text)  # full version, possibly with prerelease/build
+    except ValueError:
+        raise ValueError("invalid range component: %r" % text) from None
+    return v.major, v.minor, v.patch, v.prerelease
+
+
+def _count(p):
+    return sum(x is not None for x in p[:3])
+
+
+def _lower(p):
+    if _count(p) == 0:
+        return []
+    return [(">=", Version(p[0], p[1] or 0, p[2] or 0, p[3]))]
+
+
+def _next(p):
+    """Exclusive upper bound just above everything the partial describes."""
+    n = _count(p)
+    if n == 1:
+        return Version(p[0] + 1, 0, 0)
+    if n == 2:
+        return Version(p[0], p[1] + 1, 0)
+    raise AssertionError
+
+
+def _primitive(op, p):
+    n = _count(p)
+    if n == 3:
+        return [(op or "=", Version(p[0], p[1], p[2], p[3]))]
+    if n == 0:
+        return [_NEVER] if op in ("<", ">") else []
+    if op in (None, "="):
+        return _lower(p) + [("<", _next(p))]
+    if op == ">":
+        return [(">=", _next(p))]
+    if op == ">=":
+        return _lower(p)
+    if op == "<":
+        return [("<", Version(p[0], p[1] or 0, 0))]
+    if op == "<=":
+        return [("<", _next(p))]
+    raise AssertionError
+
+
+def _tilde(p):
+    n = _count(p)
+    if n == 0:
+        return []
+    upper = _next(p) if n < 3 else Version(p[0], p[1] + 1, 0)
+    return _lower(p) + [("<", upper)]
+
+
+def _caret(p):
+    n = _count(p)
+    if n == 0:
+        return []
+    if n == 1 or p[0] > 0:
+        upper = Version(p[0] + 1, 0, 0)
+    elif n == 2 or p[1] > 0:
+        upper = Version(0, p[1] + 1, 0)
+    else:
+        upper = Version(0, 0, p[2] + 1)
+    return _lower(p) + [("<", upper)]
+
+
+def _hyphen(a, b):
+    pa, pb = _parse_partial(a), _parse_partial(b)
+    out = _lower(pa)
+    n = _count(pb)
+    if n == 3:
+        out.append(("<=", Version(pb[0], pb[1], pb[2], pb[3])))
+    elif n:
+        out.append(("<", _next(pb)))
+    return out
+
+
+def _tokens(text):
+    raw = text.split()
+    merged = []
+    i = 0
+    while i < len(raw):
+        tok = raw[i]
+        if tok in _OPS:
+            if i + 1 >= len(raw):
+                raise ValueError("invalid range: dangling operator %r" % tok)
+            tok += raw[i + 1]
+            i += 1
+        merged.append(tok)
+        i += 1
+    return merged
+
+
+def _parse_set(text):
+    toks = _tokens(text)
+    comps = []
+    i = 0
+    while i < len(toks):
+        if i + 1 < len(toks) and toks[i + 1] == "-":
+            if i + 2 >= len(toks):
+                raise ValueError("invalid range: dangling hyphen")
+            comps += _hyphen(toks[i], toks[i + 2])
+            i += 3
+            continue
+        tok = toks[i]
+        i += 1
+        if tok == "-":
+            raise ValueError("invalid range: misplaced hyphen")
+        op = next((o for o in _OPS if tok.startswith(o)), None)
+        p = _parse_partial(tok[len(op):] if op else tok)
+        if op == "~":
+            comps += _tilde(p)
+        elif op == "^":
+            comps += _caret(p)
+        else:
+            comps += _primitive(op, p)
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError("invalid range: %r" % (range_,))
+    return [_parse_set(s) for s in range_.split("||")]
+
+
+def _parse_version(version):
+    if not isinstance(version, str):
+        raise ValueError("invalid version: %r" % (version,))
+    return Version.parse(version)
+
+
+_TESTS = {
+    "<": lambda a, b: a < b,
+    "<=": lambda a, b: a <= b,
+    ">": lambda a, b: a > b,
+    ">=": lambda a, b: a >= b,
+    "=": lambda a, b: a == b,
+}
+
+
+def _set_matches(v, comps):
+    if not all(_TESTS[op](v, c) for op, c in comps):
+        return False
+    if v.prerelease:
+        return any(c.prerelease and c.release == v.release for _, c in comps)
+    return True
+
+
+def _matches(v, sets):
+    return any(_set_matches(v, s) for s in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_parse_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_v = None, None
+    for text in versions:
+        v = _parse_version(text)
+        if _matches(v, sets) and (best_v is None or v > best_v):
+            best, best_v = text, v
+    return best
