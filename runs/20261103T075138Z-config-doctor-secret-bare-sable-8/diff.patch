 import os
+import re
 
 DEFAULTS = {
     "PAYHOOK_API_TOKEN": None,
@@ -8,18 +9,52 @@ DEFAULTS = {
     "PAYHOOK_REGION": "eu",
 }
 
+# Values of these settings are never printed in full (e.g. by `doctor`).
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+_EXPORT_PREFIX = re.compile(r"^export\s+")
+_INLINE_COMMENT = re.compile(r"\s#.*$")
+
+
+def _parse_value(raw):
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        quote = raw[0]
+        out = []
+        i = 1
+        while i < len(raw):
+            ch = raw[i]
+            if quote == '"' and ch == "\\" and i + 1 < len(raw) and raw[i + 1] in ('"', "\\"):
+                out.append(raw[i + 1])
+                i += 2
+                continue
+            if ch == quote:
+                # Anything after the closing quote (such as a comment) is ignored.
+                return "".join(out)
+            out.append(ch)
+            i += 1
+        # Unterminated quote: keep the text as written rather than guessing.
+        return raw
+    # Unquoted: a " #" starts a comment; a "#" directly after text is part of the value.
+    return _INLINE_COMMENT.sub("", raw).strip()
+
 
 def read_dotenv(path):
     values = {}
     if not os.path.exists(path):
         return values
-    with open(path, encoding="utf-8") as handle:
+    with open(path, encoding="utf-8-sig") as handle:
         for line in handle:
             line = line.strip()
             if not line or line.startswith("#"):
                 continue
-            key, value = line.split("=")
-            values[key] = value
+            line = _EXPORT_PREFIX.sub("", line)
+            if "=" not in line:
+                continue
+            key, _, raw = line.partition("=")
+            key = key.strip()
+            if key:
+                values[key] = _parse_value(raw)
     return values
 
 
