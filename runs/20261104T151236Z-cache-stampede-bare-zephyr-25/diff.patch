+"""Tests for the guarantees in docs/CONTRACT.md that test_cache.py does not cover.
+
+No test sleeps. Threads are synchronised with events, and every blocking call is bounded by a join timeout
+so a regression fails instead of hanging.
+"""
+import threading
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import TTLCache
+
+JOIN_TIMEOUT = 5
+
+
+def run_in_thread(fn):
+    """Run fn in a thread; return (thread, result_box). result_box holds ('ok', value) or ('err', exc)."""
+    box = []
+
+    def target():
+        try:
+            box.append(("ok", fn()))
+        except BaseException as exc:  # recorded and inspected by the test
+            box.append(("err", exc))
+
+    t = threading.Thread(target=target, daemon=True)
+    t.start()
+    return t, box
+
+
+def join_all(threads):
+    for t in threads:
+        t.join(JOIN_TIMEOUT)
+        if t.is_alive():
+            raise AssertionError("thread did not finish: a waiting call was left waiting")
+
+
+class ExpiryTest(unittest.TestCase):
+    def test_entry_exactly_ttl_old_is_expired(self):
+        clock = FakeClock()
+        calls = []
+        cache = TTLCache(lambda k: calls.append(k) or len(calls), ttl=10, clock=clock)
+        self.assertEqual(cache.get("a"), 1)
+        clock.advance(10)
+        self.assertEqual(cache.get("a"), 2)
+
+    def test_loaded_at_is_read_after_the_loader_returns(self):
+        clock = FakeClock()
+
+        def slow(key):
+            clock.advance(5)  # the loader takes 5 seconds
+            return "v"
+
+        cache = TTLCache(slow, ttl=10, clock=clock)
+        cache.get("a")
+        # Stamped at t=5 (after the loader), so at t=14 the age is 9: still valid.
+        clock.advance(9)
+        calls = []
+        cache._loader = lambda k: calls.append(k) or "again"
+        self.assertEqual(cache.get("a"), "v")
+        self.assertEqual(calls, [])
+
+
+class ValueTest(unittest.TestCase):
+    def test_falsy_and_none_values_are_stored_and_served(self):
+        for value in (None, 0, "", False):
+            with self.subTest(value=value):
+                calls = []
+
+                def loader(key, value=value):
+                    calls.append(key)
+                    return value
+
+                cache = TTLCache(loader, ttl=10, clock=FakeClock())
+                self.assertIs(cache.get("a"), value)
+                self.assertIs(cache.get("a"), value)
+                self.assertEqual(calls, ["a"])
+                self.assertEqual(cache.stats()["hits"], 1)
+
+
+class ConfigTest(unittest.TestCase):
+    def test_default_clock_is_time_monotonic(self):
+        import time
+
+        cache = TTLCache(lambda k: k, ttl=1)
+        self.assertIs(cache._clock, time.monotonic)
+
+    def test_negative_ttl_is_rejected(self):
+        with self.assertRaises(ValueError):
+            TTLCache(lambda k: k, ttl=-1)
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_gets_on_a_missing_key_cause_one_load(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return "v"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        leader, leader_box = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = [run_in_thread(lambda: cache.get("a")) for _ in range(6)]
+        release.set()
+        join_all([leader] + [t for t, _ in waiters])
+
+        self.assertEqual(calls, ["a"])
+        self.assertEqual(leader_box, [("ok", "v")])
+        self.assertEqual([box for _, box in waiters], [[("ok", "v")]] * 6)
+        stats = cache.stats()
+        self.assertEqual(stats["loads"], 1)
+        self.assertEqual(stats["hits"] + stats["misses"], 7)
+
+    def test_concurrent_gets_on_an_expired_key_cause_one_reload(self):
+        clock = FakeClock()
+        release = threading.Event()
+        reload_started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            if len(calls) == 2:
+                reload_started.set()
+                release.wait(JOIN_TIMEOUT)
+            return len(calls)
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("a"), 1)
+        clock.advance(10)
+        reloader, reload_box = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(reload_started.wait(JOIN_TIMEOUT))
+        waiters = [run_in_thread(lambda: cache.get("a")) for _ in range(4)]
+        release.set()
+        join_all([reloader] + [t for t, _ in waiters])
+
+        self.assertEqual(calls, ["a", "a"])
+        self.assertEqual(reload_box, [("ok", 2)])
+        self.assertEqual([box for _, box in waiters], [[("ok", 2)]] * 4)
+
+
+class NoExpiredValueTest(unittest.TestCase):
+    def test_expired_entry_is_not_served_while_a_reload_is_in_flight(self):
+        clock = FakeClock()
+        release = threading.Event()
+        reload_started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            if len(calls) == 2:
+                reload_started.set()
+                release.wait(JOIN_TIMEOUT)
+            return f"v{len(calls)}"
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("a"), "v1")
+        clock.advance(10)
+        reloader, _ = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(reload_started.wait(JOIN_TIMEOUT))
+        waiter, box = run_in_thread(lambda: cache.get("a"))
+        release.set()
+        join_all([reloader, waiter])
+        self.assertEqual(box, [("ok", "v2")])
+
+
+class FailureTest(unittest.TestCase):
+    def test_waiters_get_the_same_exception_object(self):
+        release = threading.Event()
+        started = threading.Event()
+        error = ValueError("boom")
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise error
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        leader, leader_box = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = [run_in_thread(lambda: cache.get("a")) for _ in range(3)]
+        release.set()
+        join_all([leader] + [t for t, _ in waiters])
+
+        self.assertEqual(calls, ["a"])
+        self.assertIs(leader_box[0][1], error)
+        for _, box in waiters:
+            self.assertIs(box[0][1], error)
+        stats = cache.stats()
+        self.assertEqual(stats["failures"], 1)
+        self.assertEqual(stats["loads"], 1)
+
+    def test_a_get_after_a_failure_retries_and_is_stored(self):
+        clock = FakeClock()
+        outcomes = [RuntimeError("first"), "second"]
+
+        def loader(key):
+            outcome = outcomes.pop(0)
+            if isinstance(outcome, Exception):
+                raise outcome
+            return outcome
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        with self.assertRaises(RuntimeError):
+            cache.get("a")
+        self.assertEqual(cache.get("a"), "second")
+        self.assertEqual(cache.get("a"), "second")
+        self.assertEqual(outcomes, [])
+
+    def test_base_exception_still_releases_waiters(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise KeyboardInterrupt()
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        leader, leader_box = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiter, waiter_box = run_in_thread(lambda: cache.get("a"))
+        release.set()
+        join_all([leader, waiter])
+        self.assertIsInstance(leader_box[0][1], KeyboardInterrupt)
+        self.assertIsInstance(waiter_box[0][1], KeyboardInterrupt)
+
+
+class RecursionTest(unittest.TestCase):
+    def test_loader_calling_get_for_its_own_key_raises_runtime_error(self):
+        cache = None
+
+        def loader(key):
+            return cache.get(key)  # programming error
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError):
+            cache.get("a")
+        stats = cache.stats()
+        self.assertEqual(stats["failures"], 1)  # the outer load failed
+        self.assertEqual(stats["misses"], 2)  # the rejected inner call counts as a miss
+        self.assertEqual(stats["loads"], 1)
+
+    def test_loader_may_get_a_different_key(self):
+        cache = None
+
+        def loader(key):
+            if key == "outer":
+                return ("outer", cache.get("inner"))
+            return "inner-value"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        self.assertEqual(cache.get("outer"), ("outer", "inner-value"))
+
+
+class IndependenceTest(unittest.TestCase):
+    def test_slow_load_does_not_block_other_keys_invalidate_or_stats(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            if key == "slow":
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return key
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        slow, slow_box = run_in_thread(lambda: cache.get("slow"))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+
+        other, other_box = run_in_thread(lambda: cache.get("fast"))
+        inval, _ = run_in_thread(lambda: cache.invalidate("slow"))
+        stats, stats_box = run_in_thread(cache.stats)
+        join_all([other, inval, stats])  # would time out if any of them waited for the slow load
+
+        self.assertEqual(other_box, [("ok", "fast")])
+        self.assertEqual(stats_box[0][0], "ok")
+        release.set()
+        join_all([slow])
+        self.assertEqual(slow_box, [("ok", "slow")])
+
+    def test_invalidate_during_a_load_keeps_the_load_result(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return f"v{len(calls)}"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        leader, leader_box = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        cache.invalidate("a")
+        release.set()
+        join_all([leader])
+        self.assertEqual(leader_box, [("ok", "v1")])
+        self.assertEqual(cache.get("a"), "v1")  # stored when the load completed
+        self.assertEqual(calls, ["a"])
+
+    def test_invalidate_does_not_change_stats(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        cache.get("a")
+        before = cache.stats()
+        cache.invalidate("a")
+        cache.invalidate("missing")
+        self.assertEqual(cache.stats(), before)
+
+
+class StatsTest(unittest.TestCase):
+    def test_stats_has_exactly_the_documented_keys(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        self.assertEqual(set(cache.stats()), {"hits", "misses", "loads", "failures"})
+
+    def test_counters_are_exact_under_concurrency(self):
+        cache = TTLCache(lambda k: k, ttl=600, clock=FakeClock())
+        per_thread = 200
+        n_threads = 8
+
+        def work():
+            for i in range(per_thread):
+                cache.get(i % 10)
+
+        threads = [threading.Thread(target=work) for _ in range(n_threads)]
+        for t in threads:
+            t.start()
+        join_all(threads)
+        stats = cache.stats()
+        self.assertEqual(stats["hits"] + stats["misses"], per_thread * n_threads)
+        self.assertEqual(stats["loads"], 10)
+        self.assertEqual(stats["failures"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
