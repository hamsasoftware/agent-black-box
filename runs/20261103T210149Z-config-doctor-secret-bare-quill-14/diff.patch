-            key, value = line.split("=")
-            values[key] = value
+            if re.match(r"export\s", line):
+                line = line[len("export"):].lstrip()
+            if "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            values[key.strip()] = _parse_value(value.strip())
     return values
 
 
