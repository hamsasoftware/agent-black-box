+# Settings whose values must never be printed (e.g. by `doctor`).
+SECRETS = ("PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET")
+
+
+def _parse_value(value):
+    if value[:1] in ("'", '"'):
+        end = value.find(value[0], 1)
+        if end != -1:
+            return value[1:end]
+    # unquoted: drop a trailing " # comment"
+    return re.split(r"\s+#", value, maxsplit=1)[0].rstrip()
+
 
 def read_dotenv(path):
