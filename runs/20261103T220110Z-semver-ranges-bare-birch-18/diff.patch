+"""npm-style version ranges. The contract is docs/RANGES.md."""
+
+import re
+from functools import lru_cache
+
 from .version import Version
 
+_NUM = r"(?:0|[1-9]\d*)"
+_WILDCARDS = ("x", "X", "*")
+_ZERO = Version(0, 0, 0)
+# Matches "1.2.3" in sets; "never" marks a comparator no version can satisfy.
+_NEVER = None
+
+
+def _operand(text):
+    """Parse the version part of a comparator.
+
+    Returns (nums, full): nums is the list of defined leading numeric parts
+    (0 to 3 items, fewer than 3 for partial versions). full is a Version when
+    the operand is a complete version (possibly with prerelease), else None.
+    """
+    core = text.split("+", 1)[0]
+    if "-" in core:
+        version = Version.parse(text)
+        return [version.major, version.minor, version.patch], version
+    body = core[1:] if core.startswith("v") else core
+    parts = body.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version: {text!r}")
+    nums = []
+    wild = False
+    for part in parts:
+        if part in _WILDCARDS:
+            wild = True
+        elif wild or not re.fullmatch(_NUM, part):
+            raise ValueError(f"invalid version: {text!r}")
+        else:
+            nums.append(int(part))
+    if len(nums) == 3:
+        return nums, Version(*nums)
+    return nums, None
+
+
+def _pad(nums):
+    return Version(*(nums + [0] * (3 - len(nums))))
+
+
+def _next(nums):
+    """Exclusive upper bound for a partial version: bump its last defined part."""
+    if len(nums) == 1:
+        return Version(nums[0] + 1, 0, 0)
+    return Version(nums[0], nums[1] + 1, 0)
+
+
+def _comparator(text):
+    """Expand one comparator into primitive (op, Version) bounds, or _NEVER."""
+    match = re.fullmatch(r"(<=|>=|<|>|=|~>|~|\^)?(.+)", text)
+    if not match:
+        raise ValueError(f"invalid comparator: {text!r}")
+    op = match.group(1) or "="
+    if op == "~>":
+        op = "~"
+    nums, full = _operand(match.group(2))
+
+    if op in ("~", "^"):
+        if not nums:
+            return [(">=", _ZERO)]
+        lo = full if full is not None else _pad(nums)
+        major = nums[0]
+        minor = nums[1] if len(nums) > 1 else 0
+        if op == "~":
+            # ~1 -> <2.0.0; ~1.2 and ~1.2.3 -> <1.3.0
+            upper = Version(major + 1, 0, 0) if len(nums) == 1 else Version(major, minor + 1, 0)
+        elif major > 0 or len(nums) == 1:
+            # ^1.x, ^0 -> <(major+1).0.0
+            upper = Version(major + 1, 0, 0)
+        elif minor > 0 or len(nums) == 2:
+            # ^0.2.x, ^0.0 -> <0.(minor+1).0
+            upper = Version(0, minor + 1, 0)
+        else:
+            # ^0.0.3 -> <0.0.4
+            upper = Version(0, 0, nums[2] + 1)
+        return [(">=", lo), ("<", upper)]
+
+    if full is not None:
+        return [(op, full)]
+    if not nums:
+        if op in ("<", ">"):
+            return _NEVER
+        return [(">=", _ZERO)]
+
+    lo = _pad(nums)
+    hi = _next(nums)
+    if op == "=":
+        return [(">=", lo), ("<", hi)]
+    if op == ">":
+        return [(">=", hi)]
+    if op == "<=":
+        return [("<", hi)]
+    return [(op, lo)]  # ">=" or "<"
+
+
+def _hyphen(lo_text, hi_text):
+    lo_nums, lo_full = _operand(lo_text)
+    hi_nums, hi_full = _operand(hi_text)
+    prims = []
+    if lo_full is not None:
+        prims.append((">=", lo_full))
+    elif lo_nums:
+        prims.append((">=", _pad(lo_nums)))
+    if hi_full is not None:
+        prims.append(("<=", hi_full))
+    elif hi_nums:
+        prims.append(("<", _next(hi_nums)))
+    return prims
+
+
+def _compile_set(text):
+    """Compile one comparator set into a tuple of (op, Version) bounds, or _NEVER."""
+    spaced = re.sub(r"\s*(<=|>=|<|>|=|~>|~|\^)\s*", r" \1", text)
+    tokens = spaced.split()
+    if len(tokens) == 3 and tokens[1] == "-":
+        return tuple(_hyphen(tokens[0], tokens[2]))
+    prims = []
+    for token in tokens:
+        expanded = _comparator(token)
+        if expanded is _NEVER:
+            return _NEVER
+        prims.extend(expanded)
+    return tuple(prims)
+
+
+@lru_cache(maxsize=256)
+def _compile(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return tuple(_compile_set(part) for part in range_.split("||"))
+
+
+def _cmp(version, op, bound):
+    if op == "=":
+        return version == bound
+    if op == "<":
+        return version < bound
+    if op == "<=":
+        return version < bound or version == bound
+    if op == ">":
+        return bound < version
+    return not version < bound  # ">="
+
+
+def _set_matches(version, prims):
+    if prims is _NEVER:
+        return False
+    if not all(_cmp(version, op, bound) for op, bound in prims):
+        return False
+    if version.prerelease:
+        return any(
+            bound.prerelease and bound.release == version.release for _, bound in prims
+        )
+    return True
+
+
+def _as_version(value):
+    return value if isinstance(value, Version) else Version.parse(value)
+
+
+def _matches(version, sets):
+    return any(_set_matches(version, prims) for prims in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _compile(range_)
+    return _matches(_as_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _compile(range_)
+    best = None
+    best_version = None
+    for text in versions:
+        parsed = _as_version(text)
+        if _matches(parsed, sets) and (best_version is None or parsed > best_version):
+            best = text
+            best_version = parsed
+    return best
