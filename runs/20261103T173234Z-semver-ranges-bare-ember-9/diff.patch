+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+class ContractTest(unittest.TestCase):
+    def assertMatches(self, range_, versions, expected):
+        for version in versions:
+            with self.subTest(version=version, range=range_):
+                self.assertIs(satisfies(version, range_), expected)
+
+    def test_empty_and_star_match_everything(self):
+        self.assertMatches("", ["0.0.0", "1.2.3", "9.9.9"], True)
+        self.assertMatches("*", ["0.0.0", "1.2.3", "9.9.9"], True)
+        self.assertMatches("x", ["0.0.0", "1.2.3"], True)
+        self.assertMatches("X", ["0.0.0", "1.2.3"], True)
+
+    def test_empty_set_in_union_matches_everything(self):
+        self.assertTrue(satisfies("3.0.0", "1.0.0 ||"))
+
+    def test_primitives(self):
+        self.assertMatches("<1.2.3", ["1.2.2"], True)
+        self.assertMatches("<1.2.3", ["1.2.3", "1.2.4"], False)
+        self.assertMatches("<=1.2.3", ["1.2.3"], True)
+        self.assertMatches(">1.2.3", ["1.2.3"], False)
+        self.assertMatches(">=1.2.3", ["1.2.3"], True)
+        self.assertMatches("=1.2.3", ["1.2.3"], True)
+        self.assertMatches("1.2.3", ["1.2.3"], True)
+        self.assertMatches("1.2.3", ["1.2.4"], False)
+
+    def test_whitespace_between_operator_and_version(self):
+        self.assertTrue(satisfies("1.5.0", ">= 1.2.3"))
+        self.assertTrue(satisfies("1.5.0", ">= 1.2.3 < 2"))
+        self.assertFalse(satisfies("2.0.0", ">= 1.2.3 < 2"))
+
+    def test_partial_versions_and_x_ranges(self):
+        self.assertMatches("1.x", ["1.0.0", "1.9.9"], True)
+        self.assertMatches("1.x", ["0.9.9", "2.0.0"], False)
+        self.assertMatches("1", ["1.0.0", "1.9.9"], True)
+        self.assertMatches("1.2.x", ["1.2.0", "1.2.9"], True)
+        self.assertMatches("1.2.x", ["1.3.0"], False)
+        self.assertMatches("1.2", ["1.2.0", "1.2.9"], True)
+        self.assertMatches("1.2", ["1.3.0"], False)
+        self.assertMatches("1.X.X", ["1.4.4"], True)
+
+    def test_invalid_wildcard_followed_by_number(self):
+        with self.assertRaises(ValueError):
+            satisfies("1.0.0", "1.x.3")
+
+    def test_partial_with_operators(self):
+        cases = [
+            (">1", "2.0.0", True), (">1", "1.9.9", False),
+            (">1.2", "1.3.0", True), (">1.2", "1.2.9", False),
+            (">=1.2", "1.2.0", True), (">=1.2", "1.1.9", False),
+            ("<1.2", "1.1.9", True), ("<1.2", "1.2.0", False),
+            ("<=1", "1.9.9", True), ("<=1", "2.0.0", False),
+            ("<=1.2", "1.2.9", True), ("<=1.2", "1.3.0", False),
+            ("=1.2", "1.2.5", True), ("=1.2", "1.3.0", False),
+        ]
+        for range_, version, expected in cases:
+            with self.subTest(range=range_, version=version):
+                self.assertIs(satisfies(version, range_), expected)
+
+    def test_hyphen(self):
+        self.assertMatches("1.2.3 - 2.3", ["1.2.3", "2.3.9"], True)
+        self.assertMatches("1.2.3 - 2.3", ["1.2.2", "2.4.0"], False)
+        self.assertMatches("1.2.3 - 2", ["2.9.9"], True)
+        self.assertMatches("1.2.3 - 2", ["3.0.0"], False)
+
+    def test_hyphen_requires_spaces(self):
+        # Without spaces, "1.2.3-2.3" is one prerelease version, not a hyphen range.
+        self.assertTrue(satisfies("1.2.3-2.3", "1.2.3-2.3"))
+        self.assertFalse(satisfies("1.5.0", "1.2.3-2.3"))
+
+    def test_tilde(self):
+        self.assertMatches("~1.2.3", ["1.2.3", "1.2.9"], True)
+        self.assertMatches("~1.2.3", ["1.3.0"], False)
+        self.assertMatches("~1.2", ["1.2.0", "1.2.9"], True)
+        self.assertMatches("~1.2", ["1.3.0"], False)
+        self.assertMatches("~1", ["1.0.0", "1.9.0"], True)
+        self.assertMatches("~1", ["2.0.0"], False)
+        self.assertMatches("~1.2.3-beta.2", ["1.2.3-beta.2", "1.2.3", "1.2.9"], True)
+        self.assertMatches("~1.2.3-beta.2", ["1.2.3-beta.1", "1.3.0"], False)
+
+    def test_caret(self):
+        self.assertMatches("^1.2.3", ["1.2.3", "1.9.0"], True)
+        self.assertMatches("^1.2.3", ["1.2.2", "2.0.0"], False)
+        self.assertMatches("^0.2.3", ["0.2.9"], True)
+        self.assertMatches("^0.2.3", ["0.3.0", "0.2.2"], False)
+        self.assertMatches("^0.0.3", ["0.0.3"], True)
+        self.assertMatches("^0.0.3", ["0.0.4"], False)
+        self.assertMatches("^1.2", ["1.9.9"], True)
+        self.assertMatches("^1.2", ["2.0.0"], False)
+        self.assertMatches("^1.2.x", ["1.9.9"], True)
+        self.assertMatches("^1.2.x", ["2.0.0"], False)
+        self.assertMatches("^0.2", ["0.2.9"], True)
+        self.assertMatches("^0.2", ["0.3.0"], False)
+        self.assertMatches("^0.0", ["0.0.9"], True)
+        self.assertMatches("^0.0", ["0.1.0"], False)
+        self.assertMatches("^0.0.x", ["0.0.9"], True)
+        self.assertMatches("^0.0.x", ["0.1.0"], False)
+        self.assertMatches("^1", ["1.9.9"], True)
+        self.assertMatches("^1", ["2.0.0"], False)
+        self.assertMatches("^1.x", ["1.9.9"], True)
+        self.assertMatches("^1.x", ["2.0.0"], False)
+        self.assertMatches("^0", ["0.9.9"], True)
+        self.assertMatches("^0", ["1.0.0"], False)
+        self.assertMatches("^0.x", ["0.9.9"], True)
+        self.assertMatches("^0.x", ["1.0.0"], False)
+
+    def test_union(self):
+        self.assertMatches("1.2.3 || >=2.0.0 <3", ["1.2.3", "2.5.0"], True)
+        self.assertMatches("1.2.3 || >=2.0.0 <3", ["1.2.4", "3.0.0"], False)
+
+    def test_prerelease_needs_matching_tuple_in_same_set(self):
+        self.assertMatches(">=1.2.3-alpha.1 <1.3.0", ["1.2.3-alpha.7"], True)
+        self.assertMatches(">=1.2.3-alpha.1 <1.3.0", ["1.2.4-alpha.1"], False)
+        self.assertMatches("^1.0.0", ["2.0.0-rc.1", "1.5.0-beta"], False)
+
+    def test_prerelease_does_not_match_across_union_sets(self):
+        # The prerelease comparator is in a different set than the version's release.
+        self.assertFalse(satisfies("1.2.3-beta.1", "1.2.3-beta.0 || >=1.0.0 <2"))
+        self.assertTrue(satisfies("1.2.3-beta.1", "1.2.3-beta.0 || >=1.0.0 <2 >=1.2.3-beta.0"))
+
+    def test_build_metadata_ignored(self):
+        self.assertTrue(satisfies("1.2.3+build.9", "=1.2.3+other"))
+        self.assertTrue(satisfies("v1.2.3", "^1.0.0"))
+
+    def test_invalid_ranges(self):
+        for bad in [">=", "^", "1.x.3", "1.2.3 - ", "- 1.2.3", "01.2.3", ">=1 - 2", "1.2.3-"]:
+            with self.subTest(range=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+
+    def test_invalid_version_raises(self):
+        with self.assertRaises(ValueError):
+            satisfies("1.2", "^1.0.0")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+
+class MaxSatisfyingContractTest(unittest.TestCase):
+    def test_returns_original_text(self):
+        self.assertEqual(max_satisfying(["v1.4.0", "1.3.0"], "^1"), "v1.4.0")
+
+    def test_excludes_prereleases_unless_matched(self):
+        self.assertEqual(max_satisfying(["1.4.0", "1.5.0-beta"], "^1"), "1.4.0")
+        self.assertEqual(max_satisfying(["1.4.0", "1.5.0-beta"], ">=1.5.0-alpha <2"), "1.5.0-beta")
+
+    def test_empty_iterable(self):
+        self.assertIsNone(max_satisfying([], "*"))
+
+    def test_accepts_generator_and_orders_prereleases(self):
+        result = max_satisfying((v for v in ["1.0.0-alpha.2", "1.0.0-alpha.10", "1.0.0-alpha.1"]),
+                                ">=1.0.0-alpha.1")
+        self.assertEqual(result, "1.0.0-alpha.10")
+
+    def test_invalid_range_raises_even_without_versions(self):
+        with self.assertRaises(ValueError):
+            max_satisfying([], ">=")
+
+
+if __name__ == "__main__":
+    unittest.main()
