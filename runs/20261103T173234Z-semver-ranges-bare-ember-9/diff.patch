+import re
+from functools import lru_cache
+
 from .version import Version
 
+_OPERATORS = ("<=", ">=", "<", ">", "=", "^", "~")
+_ITEM = re.compile(r"(<=|>=|<|>|=|\^|~)?(.*)", re.DOTALL)
+_NUMBER = re.compile(r"0|[1-9]\d*")
+_WILDCARDS = ("x", "X", "*")
+
+# A comparator that no version satisfies: nothing is below 0.0.0.
+_NEVER = (("<", Version(0, 0, 0)),)
+
+
+class _Partial:
+    """A version with optional trailing positions: 1, 1.2, 1.2.x, 1.2.3-pre."""
+
+    __slots__ = ("nums", "n", "prerelease")
+
+    def __init__(self, nums, prerelease):
+        self.nums = nums  # three entries, int or None (wildcard or missing)
+        self.n = sum(1 for x in nums if x is not None)  # leading specified count
+        self.prerelease = prerelease
+
+    @classmethod
+    def parse(cls, text):
+        if text.startswith("v"):
+            text = text[1:]
+        text = text.split("+", 1)[0]  # build metadata is ignored
+        core, sep, pre = text.partition("-")
+        parts = core.split(".")
+        if not 1 <= len(parts) <= 3:
+            raise ValueError(f"invalid version in range: {text!r}")
+        nums = []
+        seen_wildcard = False
+        for part in parts:
+            if part in _WILDCARDS:
+                seen_wildcard = True
+                nums.append(None)
+            elif seen_wildcard or not _NUMBER.fullmatch(part):
+                raise ValueError(f"invalid version in range: {text!r}")
+            else:
+                nums.append(int(part))
+        nums += [None] * (3 - len(nums))
+        if sep:
+            if None in nums:
+                raise ValueError(f"prerelease needs a full version: {text!r}")
+            prerelease = Version.parse(f"{nums[0]}.{nums[1]}.{nums[2]}-{pre}").prerelease
+        else:
+            prerelease = ()
+        return cls(tuple(nums), prerelease)
+
+    def lower(self):
+        """The smallest version this partial stands for, with zeros filled in."""
+        a, b, c = (0 if x is None else x for x in self.nums)
+        return Version(a, b, c, self.prerelease)
+
+    def upper(self, index):
+        """The first version past the position `index`, e.g. 1.2 at index 1 is 1.3.0."""
+        nums = [self.nums[i] or 0 for i in range(index)] + [self.nums[index] + 1]
+        nums += [0] * (3 - len(nums))
+        return Version(*nums)
+
+    def past_last(self):
+        """The first version past the last specified position, or None if all are wildcards."""
+        return self.upper(self.n - 1) if self.n else None
+
+
+def _expand(op, p):
+    """Turn one comparator into primitive (op, Version) pairs; all must hold."""
+    if op == "^":
+        if p.n == 0:
+            return []
+        first_nonzero = next((i for i in range(p.n) if p.nums[i] != 0), p.n - 1)
+        return [(">=", p.lower()), ("<", p.upper(first_nonzero))]
+    if op == "~":
+        if p.n == 0:
+            return []
+        return [(">=", p.lower()), ("<", p.upper(min(p.n, 2) - 1))]
+    full = p.n == 3
+    if op in ("", "="):
+        if p.n == 0:
+            return []
+        if full:
+            return [("=", p.lower())]
+        return [(">=", p.lower()), ("<", p.past_last())]
+    if op == ">":
+        if p.n == 0:
+            return list(_NEVER)
+        return [(">", p.lower())] if full else [(">=", p.past_last())]
+    if op == ">=":
+        return [] if p.n == 0 else [(">=", p.lower())]
+    if op == "<":
+        return list(_NEVER) if p.n == 0 else [("<", p.lower())]
+    if op == "<=":
+        if p.n == 0:
+            return []
+        return [("<=", p.lower())] if full else [("<", p.past_last())]
+    raise ValueError(f"unknown operator: {op!r}")
+
+
+def _hyphen(low, high):
+    lo = _Partial.parse(low)
+    hi = _Partial.parse(high)
+    comparators = [(">=", lo.lower())]
+    if hi.n == 3:
+        comparators.append(("<=", hi.lower()))
+    elif hi.n > 0:
+        comparators.append(("<", hi.past_last()))
+    return comparators
+
+
+def _split_set(text):
+    """Split a comparator set into items: plain comparators and ('-', low, high) hyphen pairs."""
+    tokens = text.split()
+    items = []
+    i = 0
+    while i < len(tokens):
+        token = tokens[i]
+        if token == "-":
+            if not items or isinstance(items[-1], tuple) or i + 1 >= len(tokens):
+                raise ValueError(f"invalid hyphen range: {text!r}")
+            low = items.pop()
+            if _ITEM.fullmatch(low).group(1):
+                raise ValueError(f"invalid hyphen range: {text!r}")
+            items.append(("-", low, tokens[i + 1]))
+            i += 2
+            continue
+        if token in _OPERATORS:
+            if i + 1 >= len(tokens):
+                raise ValueError(f"operator without version: {text!r}")
+            token += tokens[i + 1]
+            i += 1
+        items.append(token)
+        i += 1
+    return items
+
+
+def _parse_set(text):
+    comparators = []
+    for item in _split_set(text):
+        if isinstance(item, tuple):
+            comparators.extend(_hyphen(item[1], item[2]))
+        else:
+            match = _ITEM.fullmatch(item)
+            op, body = match.group(1) or "", match.group(2)
+            comparators.extend(_expand(op, _Partial.parse(body)))
+    return tuple(comparators)
+
+
+@lru_cache(maxsize=256)
+def _parse_range(range_):
+    return tuple(_parse_set(part) for part in range_.split("||"))
+
+
+def _set_matches(version, comparators):
+    for op, bound in comparators:
+        if op == "<" and not version < bound:
+            return False
+        if op == "<=" and not version <= bound:
+            return False
+        if op == ">" and not version > bound:
+            return False
+        if op == ">=" and not version >= bound:
+            return False
+        if op == "=" and not version == bound:
+            return False
+    if version.prerelease:
+        # Prereleases only match when a comparator in the same set names
+        # the same major.minor.patch with a prerelease tag.
+        return any(bound.prerelease and bound.release == version.release
+                   for _, bound in comparators)
+    return True
+
+
+def _as_version(version):
+    return version if isinstance(version, Version) else Version.parse(version)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    parsed = _parse_range(range_)
+    version = _as_version(version)
+    return any(_set_matches(version, comparators) for comparators in parsed)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    parsed = _parse_range(range_)
+    best = None
+    best_version = None
+    for text in versions:
+        version = _as_version(text)
+        if any(_set_matches(version, c) for c in parsed):
+            if best_version is None or version > best_version:
+                best, best_version = text, version
+    return best
