+"""Deterministic checks of the retry policy in docs/RETRY.md."""
+
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _MaxJitterRng:
+    """Always returns the top of the jitter range: uniform(a, b) -> b."""
+
+    def uniform(self, a, b):
+        return b
+
+
+class _MinJitterRng:
+    def uniform(self, a, b):
+        return a
+
+
+class BackoffPolicyTest(unittest.TestCase):
+    def test_cap_holds_under_maximum_positive_jitter(self):
+        # Uncapped attempt 7 is 32s; 32 * 1.1 = 35.2 used to escape cap=34.
+        retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=_MaxJitterRng())
+        self.assertLessEqual(max(retrier.schedule()), 34)
+
+    def test_capped_delay_is_exactly_cap_at_max_jitter(self):
+        self.assertEqual(
+            compute_delay(10, base=0.5, cap=30.0, jitter=0.1, rng=_MaxJitterRng()), 30.0
+        )
+
+    def test_cap_holds_across_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertGreaterEqual(delay, 0)
+                self.assertLessEqual(delay, 34)
+
+    def test_jitter_stays_within_bounds_below_cap(self):
+        # attempt 1 with base 0.5: uncapped 0.5, jitter 0.1 -> [0.45, 0.55].
+        self.assertAlmostEqual(
+            compute_delay(1, base=0.5, jitter=0.1, rng=_MinJitterRng()), 0.45
+        )
+        self.assertAlmostEqual(
+            compute_delay(1, base=0.5, jitter=0.1, rng=_MaxJitterRng()), 0.55
+        )
+
+
+
+if __name__ == "__main__":
+    unittest.main()
