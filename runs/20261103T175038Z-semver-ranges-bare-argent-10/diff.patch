+"""npm-style version ranges. See docs/RANGES.md for the contract."""
+
+import operator
+import re
+from functools import lru_cache
+
 from .version import Version
 
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+# Smallest possible prerelease: nothing is below it, so `<0.0.0-0` matches nothing.
+_NOTHING = ("<", Version(0, 0, 0, ("0",)))
+
+_NUMERIC_OR_WILD = re.compile(r"0|[1-9]\d*")
+_WILD = ("x", "X", "*")
+
+
+def _parse_version_text(text):
+    """Parse a possibly partial version. Returns (numbers, full_version_or_None).
+
+    `numbers` holds the explicitly given numeric positions (0 to 3 of them).
+    `full_version` is set only when all three positions are given.
+    """
+    match = re.fullmatch(r"v?([^-+]+)(?:-([^+]+))?(?:\+(.+))?", text)
+    if not match:
+        raise ValueError(f"invalid version in range: {text!r}")
+    core, pre, _build = match.groups()
+    parts = core.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version in range: {text!r}")
+    numbers = []
+    wild = False
+    for part in parts:
+        if part in _WILD:
+            wild = True
+        elif _NUMERIC_OR_WILD.fullmatch(part):
+            if wild:
+                raise ValueError(f"number after wildcard in range: {text!r}")
+            numbers.append(int(part))
+        else:
+            raise ValueError(f"invalid version in range: {text!r}")
+    if len(numbers) == 3:
+        return numbers, Version.parse(text)
+    if pre is not None:
+        raise ValueError(f"prerelease needs a full version: {text!r}")
+    return numbers, None
+
+
+def _lower(numbers, full):
+    if full is not None:
+        return full
+    return Version(*(numbers + [0] * (3 - len(numbers))))
+
+
+def _bump(numbers, index):
+    """Smallest version above the range covered by bumping position `index`."""
+    values = numbers + [0] * (3 - len(numbers))
+    values[index] += 1
+    for j in range(index + 1, 3):
+        values[j] = 0
+    return Version(*values)
+
+
+def _expand_comparator(token):
+    match = re.fullmatch(r"(<=|>=|<|>|=|~|\^)?(.*)", token)
+    op, text = match.groups()
+    numbers, full = _parse_version_text(text)
+    n = len(numbers)
+
+    if op == "~":
+        if n == 0:
+            return []
+        index = 0 if n == 1 else 1
+        return [(">=", _lower(numbers, full)), ("<", _bump(numbers, index))]
+
+    if op == "^":
+        if n == 0:
+            return []
+        index = next((i for i in range(n) if numbers[i] != 0), n - 1)
+        return [(">=", _lower(numbers, full)), ("<", _bump(numbers, index))]
+
+    if op in (None, "="):
+        if n == 3:
+            return [("=", full)]
+        if n == 0:
+            return []
+        return [(">=", _lower(numbers, full)), ("<", _bump(numbers, n - 1))]
+
+    if op == ">=":
+        return [] if n == 0 else [(">=", _lower(numbers, full))]
+
+    if op == "<":
+        if n == 0:
+            return [_NOTHING]
+        return [("<", _lower(numbers, full))]
+
+    if op == "<=":
+        if n == 0:
+            return []
+        if n == 3:
+            return [("<=", full)]
+        return [("<", _bump(numbers, n - 1))]
+
+    # op == ">"
+    if n == 0:
+        return [_NOTHING]
+    if n == 3:
+        return [(">", full)]
+    return [(">=", _bump(numbers, n - 1))]
+
+
+def _expand_hyphen(low_text, high_text):
+    if re.match(r"[<>=~^]", low_text) or re.match(r"[<>=~^]", high_text):
+        raise ValueError(f"operator not allowed in hyphen range: {low_text} - {high_text}")
+    low_numbers, low_full = _parse_version_text(low_text)
+    high_numbers, high_full = _parse_version_text(high_text)
+    comparators = [(">=", _lower(low_numbers, low_full))]
+    if len(high_numbers) == 3:
+        comparators.append(("<=", high_full))
+    elif high_numbers:
+        comparators.append(("<", _bump(high_numbers, len(high_numbers) - 1)))
+    return comparators
+
+
+def _parse_set(text):
+    tokens = re.sub(r"(<=|>=|<|>|=|~|\^)\s+", r"\1", text).split()
+    comparators = []
+    i = 0
+    while i < len(tokens):
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range: {text!r}")
+            comparators.extend(_expand_hyphen(tokens[i], tokens[i + 2]))
+            i += 3
+        else:
+            comparators.extend(_expand_comparator(tokens[i]))
+            i += 1
+    return tuple(comparators)
+
+
+@lru_cache(maxsize=512)
+def _parse_range(range_):
+    """Return the range as a tuple of comparator sets; each set is a tuple of (op, Version)."""
+    return tuple(_parse_set(part) for part in range_.split("||"))
+
+
+def _set_matches(version, comparators):
+    if not comparators:
+        return True
+    if not all(_OPS[op](version, target) for op, target in comparators):
+        return False
+    if version.prerelease:
+        return any(
+            target.prerelease and target.release == version.release
+            for _, target in comparators
+        )
+    return True
+
+
+def _coerce_version(version):
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise TypeError(f"version must be a string or Version, not {type(version).__name__}")
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    parsed = _parse_range(range_)
+    version = _coerce_version(version)
+    return any(_set_matches(version, comparators) for comparators in parsed)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    parsed = _parse_range(range_)
+    best = None
+    best_version = None
+    for text in versions:
+        version = _coerce_version(text)
+        if best_version is not None and not best_version < version:
+            continue
+        if any(_set_matches(version, comparators) for comparators in parsed):
+            best = text
+            best_version = version
+    return best
