+import unittest
+
+from generated.catalog_client import CatalogClient
+from shopapi.listing import fetchAllProducts, getPageCount
+
+
+class PartialPageTest(unittest.TestCase):
+    def test_page_count_rounds_up(self):
+        self.assertEqual(getPageCount(101, 50), 3)
+        self.assertEqual(getPageCount(1, 50), 1)
+        self.assertEqual(getPageCount(0, 50), 0)
+
+    def test_fetch_includes_partial_last_page(self):
+        products = fetchAllProducts(CatalogClient(total=237))
+        self.assertEqual(len(products), 237)
+
+
+if __name__ == "__main__":
+    unittest.main()
