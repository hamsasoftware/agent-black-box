@@ -0,0 +1,41 @@
+import os
+from urllib.parse import urlsplit, urlunsplit
+
+from .config import SECRET_KEYS
+
+
+def _redact_url(value):
+    """Hide any user:password@ part of a URL, keep the rest for support."""
+    try:
+        parts = urlsplit(value)
+    except ValueError:
+        return value
+    if "@" not in parts.netloc:
+        return value
+    host = parts.netloc.rsplit("@", 1)[1]
+    return urlunsplit((parts.scheme, "***@" + host, parts.path, parts.query, parts.fragment))
+
+
+def _display(key, value):
+    if value is None:
+        return "<not set>"
+    if key in SECRET_KEYS:
+        return f"<set, {len(value)} characters, hidden>"
+    if key == "PAYHOOK_ENDPOINT":
+        return _redact_url(value)
+    return value
+
+
+def format_doctor(config, dotenv_path):
+    """Return the doctor report as text. Secret values are never included."""
+    abs_path = os.path.abspath(dotenv_path)
+    found = "found" if os.path.exists(dotenv_path) else "not found"
+    lines = [
+        "payhook doctor",
+        f"dotenv file: {abs_path} ({found})",
+        "",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append(f"{key.ljust(width)} = {_display(key, value)}  [source: {source}]")
+    return "\n".join(lines) + "\n"
