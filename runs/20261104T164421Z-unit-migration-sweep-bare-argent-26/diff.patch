+A canonical weight has digits, a point and exactly three decimal places: "0.250".
+Arithmetic goes through whole grams (ints), which is exact for three decimal places.
+
+>>> normalize_kg("0.250")
+'0.250'
+>>> kg_to_g("1.25")
+1250
+>>> g_to_kg(1250)
+'1.250'
 """
+import re
+from decimal import ROUND_HALF_EVEN, Context, Decimal
+
+_KG_INPUT = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+_QUANTUM = Decimal("0.001")
+
+
+class WeightError(ValueError):
+    """An invalid weight, or a total over the carrier limit."""
+
+
+def normalize_kg(value):
+    """Return the canonical form of a weight given as a string, rounding half to even to three places.
+
+    >>> normalize_kg("1.5")
+    '1.500'
+    >>> normalize_kg("1.0005")
+    '1.000'
+    >>> normalize_kg("1.0015")
+    '1.002'
+    """
+    if not isinstance(value, str) or not _KG_INPUT.fullmatch(value):
+        raise WeightError(f"invalid weight: {value!r}")
+    # The context precision follows the input length so that no digit is lost.
+    context = Context(prec=len(value) + 4, rounding=ROUND_HALF_EVEN)
+    return format(context.quantize(Decimal(value), _QUANTUM), "f")
+
+
+def kg_to_g(value):
+    """Whole grams of a weight, exactly.
+
+    >>> kg_to_g("1.25")
+    1250
+    >>> kg_to_g("0.001")
+    1
+    """
+    return int(normalize_kg(value).replace(".", ""))
 
 
