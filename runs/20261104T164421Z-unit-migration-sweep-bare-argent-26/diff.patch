+class ValidateTest(unittest.TestCase):
+    def data(self, weight):
+        return {"sku": "A", "weight_kg": weight, "qty": 1}
+
+    def test_range_applies_after_rounding(self):
+        self.assertIn("weight_kg: out of range 0.001..1000.000", validate.validate_item(self.data("0.0004")))
+        self.assertEqual(validate.validate_item(self.data("1000.0004")), [])
+
+    def test_invalid_weight_is_a_problem(self):
