+"""Checks of the examples and rules in docs/MIGRATION.md, docs/ROUNDING.md and docs/FORMATS.md."""
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from shipcalc import auditlog, cli, export, importer, plugins, storage, surcharges, validate
+from shipcalc.calc import order_weight_kg
+from shipcalc.limits import check_total_kg
+from shipcalc.models import Item, Order
+from shipcalc.pallets import fill_percent, pallet_count
+from shipcalc.pricing import freight_cents
+from shipcalc.reports import average_weight_kg, weight_bands
+from shipcalc.tare import net_after_percent_kg, net_weight_kg, tare_for_percent_kg
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+from shipcalc.weighbridge import allowance_kg, deviation_kg, within_tolerance
+
+
+class NormalizeTest(unittest.TestCase):
+    def test_canonical_form(self):
+        self.assertEqual(normalize_kg("2"), "2.000")
+        self.assertEqual(normalize_kg("1.5"), "1.500")
+        self.assertEqual(normalize_kg("1000.000"), "1000.000")
+
+    def test_half_even_rounding(self):
+        self.assertEqual(normalize_kg("1.0005"), "1.000")
+        self.assertEqual(normalize_kg("1.0015"), "1.002")
+        self.assertEqual(normalize_kg("2.0025"), "2.002")
+        self.assertEqual(normalize_kg("1.2345"), "1.234")
+
+    def test_invalid_input(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", "١"]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+        for bad in [1, 1.0, True, None]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+
+    def test_error_message(self):
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg("abc")
+        self.assertEqual(str(ctx.exception), "invalid weight: 'abc'")
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg(1500)
+        self.assertEqual(str(ctx.exception), "invalid weight: 1500")
+        self.assertTrue(issubclass(WeightError, ValueError))
+
+    def test_gram_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        for bad in [-1, True, 1.0, "1"]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+
+class FreightTest(unittest.TestCase):
+    def test_table(self):
+        self.assertEqual(freight_cents("0.125", 100), 12)
+        self.assertEqual(freight_cents("0.375", 100), 38)
+        self.assertEqual(freight_cents("0.003", 500), 2)
+        self.assertEqual(freight_cents("0.001", 499), 0)
+        self.assertEqual(freight_cents("2.000", 350), 700)
+        self.assertEqual(freight_cents("1.0005", 100), 100)
+        self.assertEqual(freight_cents("1.0015", 100), 100)
+
+    def test_rate_must_be_int(self):
+        with self.assertRaises(ValueError):
+            freight_cents("1.000", True)
+        with self.assertRaises(ValueError):
+            freight_cents("1.000", -1)
+
+
+class PalletTest(unittest.TestCase):
+    def order(self, weight):
+        return Order([Item("A", weight)])
+
+    def test_table(self):
+        cases = [
+            ("250.000", 1, 50),
+            ("1.250", 1, 0),
+            ("2.500", 1, 0),
+            ("7.500", 1, 2),
+            ("12.500", 1, 2),
+            ("500.000", 1, 100),
+            ("500.001", 2, 50),
+        ]
+        for weight, count, percent in cases:
+            with self.subTest(weight=weight):
+                self.assertEqual(pallet_count(self.order(weight)), count)
+                self.assertEqual(fill_percent(self.order(weight)), percent)
+
+    def test_empty_order(self):
+        self.assertEqual(pallet_count(Order()), 0)
+        self.assertEqual(fill_percent(Order()), 0)
+
+
+class WeighbridgeTest(unittest.TestCase):
+    def test_allowance_table(self):
+        self.assertEqual(allowance_kg("1.000"), "0.020")
+        self.assertEqual(allowance_kg("10.025"), "0.200")
+        self.assertEqual(allowance_kg("10.075"), "0.202")
+        self.assertEqual(allowance_kg("0.500"), "0.020")
+
+    def test_tolerance_table(self):
+        self.assertTrue(within_tolerance("1.000", "1.020"))
+        self.assertFalse(within_tolerance("1.000", "1.021"))
+        self.assertTrue(within_tolerance("10.025", "10.225"))
+        self.assertFalse(within_tolerance("10.025", "10.226"))
+        self.assertTrue(within_tolerance("10.075", "9.873"))
+        self.assertTrue(within_tolerance("0.500", "0.480"))
+
+    def test_deviation(self):
+        self.assertEqual(deviation_kg("1.000", "0.980"), "0.020")
+
+
+class TareTest(unittest.TestCase):
+    def test_table(self):
+        self.assertEqual(tare_for_percent_kg("10.005", 10), "1.000")
+        self.assertEqual(tare_for_percent_kg("10.015", 10), "1.002")
+        self.assertEqual(tare_for_percent_kg("0.005", 50), "0.002")
+        self.assertEqual(tare_for_percent_kg("0.015", 50), "0.008")
+        self.assertEqual(tare_for_percent_kg("3.000", 0), "0.000")
+        self.assertEqual(net_after_percent_kg("10.005", 10), "9.005")
+        self.assertEqual(net_after_percent_kg("10.015", 10), "9.013")
+        self.assertEqual(net_after_percent_kg("0.005", 50), "0.003")
+        self.assertEqual(net_after_percent_kg("0.015", 50), "0.007")
+
+    def test_net_weight(self):
+        self.assertEqual(net_weight_kg("2.000", "0.500"), "1.500")
+        self.assertEqual(net_weight_kg("2.000", "2.000"), "0.000")
+        with self.assertRaises(WeightError):
+            net_weight_kg("2.000", "2.001")
+
+    def test_percent_checks_weight_first(self):
+        with self.assertRaises(WeightError):
+            tare_for_percent_kg("x", True)
+        with self.assertRaises(ValueError):
+            tare_for_percent_kg("1.000", 101)
+
+
+class ReportsTest(unittest.TestCase):
+    def test_average_rounds_half_even(self):
+        self.assertEqual(average_weight_kg(Order()), "0.000")
+        self.assertEqual(average_weight_kg(Order([Item("A", "1.000"), Item("B", "2.000", 2)])), "1.667")
+
+    def test_bands_boundaries(self):
+        order = Order([Item("A", "0.500"), Item("B", "0.501"), Item("C", "2.000"), Item("D", "2.001")])
+        self.assertEqual(weight_bands(order), {"light": 1, "medium": 2, "heavy": 1})
+
+
+class SurchargeTest(unittest.TestCase):
+    def test_bands(self):
+        table = surcharges.load()
+        self.assertEqual(surcharges.cents_for("1.000", table), 0)
+        self.assertEqual(surcharges.cents_for("1.001", table), 150)
+        self.assertEqual(surcharges.cents_for("15.000", table), 400)
+        self.assertEqual(surcharges.cents_for("15.001", table), 900)
+
+    def test_schema_1_is_read_and_converted(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "old.json")
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump({"schema": 1, "bands": [{"max_g": 15000, "cents": 4}, {"max_g": 1000, "cents": 0}],
+                           "over_cents": 9}, handle)
+            table = surcharges.load(path)
+        self.assertEqual(table["bands"], [{"max_kg": "1.000", "cents": 0}, {"max_kg": "15.000", "cents": 4}])
+
+    def test_unsupported_schema(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "x.json")
+            with open(path, "w", encoding="utf-8") as handle:
+                json.dump({"schema": True, "bands": [], "over_cents": 0}, handle)
+            with self.assertRaises(ValueError):
+                surcharges.load(path)
+
+
+class CarrierLimitTest(unittest.TestCase):
+    def test_limit_is_inclusive(self):
+        self.assertEqual(check_total_kg("2147483.647"), "2147483.647")
+        with self.assertRaises(WeightError):
+            check_total_kg("2147483.648")
+
+    def test_order_total_applies_limit(self):
+        order = Order([Item("A", "1000.000", 2000), Item("B", "147483.648")])
