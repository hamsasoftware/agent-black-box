+class AuditLogTest(unittest.TestCase):
+    def test_reads_both_versions(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "log.jsonl")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write('{"event": "add", "qty": 2, "sku": "MUG-01", "v": 1, "weight_g": 350}\n')
+                handle.write("\n")
+                handle.write('{"event": "add", "qty": 1, "sku": "BOOK", "v": 2, "weight_kg": "1.200"}\n')
+                handle.write('{"event": "note"}\n')
+            entries = auditlog.read_entries(path)
+            self.assertEqual(entries[0], {"event": "add", "qty": 2, "sku": "MUG-01", "v": 2, "weight_kg": "0.350"})
+            self.assertEqual(entries[2], {"event": "note", "v": 2})
+            self.assertEqual(auditlog.total_added_kg(path), "1.900")
+
+    def test_bad_versions(self):
+        for version in ["true", "2.0", '"2"', "3"]:
+            with tempfile.TemporaryDirectory() as tmp:
+                path = os.path.join(tmp, "log.jsonl")
+                with open(path, "w", encoding="utf-8") as handle:
+                    handle.write('{"event": "add", "v": ' + version + ', "weight_kg": "1.000"}\n')
+                with self.subTest(version=version), self.assertRaises(ValueError):
+                    auditlog.read_entries(path)
+
+    def test_write_rejects_invalid_weight_and_leaves_file(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "log.jsonl")
+            with self.assertRaises(WeightError):
+                auditlog.write_entry(path, "add", "A", 250)
+            self.assertFalse(os.path.exists(path))
+            auditlog.write_entry(path, "add", "A", "0.250", 2)
+            with open(path, encoding="utf-8") as handle:
+                line = handle.read()
+            self.assertEqual(line, '{"event": "add", "qty": 2, "sku": "A", "v": 2, "weight_kg": "0.250"}\n')
+
