+class ImporterTest(unittest.TestCase):
+    def test_grams_and_kilograms_columns(self):
+        order = importer.parse_csv("sku,weight_g,qty\nA,250,2\nB,1500,1\n")
+        self.assertEqual([(i.sku, i.weight_kg, i.qty) for i in order.items], [("A", "0.250", 2), ("B", "1.500", 1)])
+        order = importer.parse_csv("qty , sku,weight_kg\r\n3,A,1.0005\r\n")
+        self.assertEqual([(i.sku, i.weight_kg, i.qty) for i in order.items], [("A", "1.000", 3)])
+
+    def test_header_errors(self):
+        cases = [
+            ("", "empty file"),
+            ("sku,weight_g,colour", "unknown column: 'colour'"),
+            ("sku,weight_g,sku", "duplicate column: 'sku'"),
+            ("weight_g,qty", "missing column: 'sku'"),
+            ("sku,weight_g,weight_kg", "both weight_g and weight_kg"),
+            ("sku,qty", "missing weight column"),
+        ]
+        for text, message in cases:
+            with self.subTest(text=text), self.assertRaises(ValueError) as ctx:
+                importer.parse_csv(text)
+            self.assertEqual(str(ctx.exception), message)
+
+    def test_row_errors(self):
+        with self.assertRaises(ValueError) as ctx:
