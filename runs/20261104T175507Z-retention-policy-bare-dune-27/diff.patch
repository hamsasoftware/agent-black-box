+import calendar
+from bisect import bisect_right
 from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
+
+UTC = timezone.utc
 
 
 @dataclass(frozen=True)
@@ -12,9 +17,179 @@ class Plan:
     prune: list
 
 
+# ADR-0005: the offset of a named zone. Each row is (instant in UTC, offset in minutes from that instant on).
+_ZONE_TABLES = {
+    "lakeside": (60, [
+        (datetime(2022, 3, 27, 1, 0, tzinfo=UTC), 120),
+        (datetime(2022, 10, 30, 1, 0, tzinfo=UTC), 60),
+        (datetime(2023, 3, 26, 1, 0, tzinfo=UTC), 120),
+        (datetime(2023, 10, 29, 1, 0, tzinfo=UTC), 60),
+        (datetime(2024, 3, 31, 1, 0, tzinfo=UTC), 120),
+        (datetime(2024, 10, 27, 1, 0, tzinfo=UTC), 60),
+        (datetime(2025, 3, 30, 1, 0, tzinfo=UTC), 120),
+        (datetime(2025, 10, 26, 1, 0, tzinfo=UTC), 60),
+        (datetime(2026, 3, 29, 1, 0, tzinfo=UTC), 120),
+        (datetime(2026, 10, 25, 1, 0, tzinfo=UTC), 60),
+        (datetime(2027, 3, 28, 1, 0, tzinfo=UTC), 120),
+        (datetime(2027, 10, 31, 1, 0, tzinfo=UTC), 60),
+    ]),
+    "harbor": (630, [
+        (datetime(2022, 4, 2, 16, 30, tzinfo=UTC), 570),
+        (datetime(2022, 10, 1, 16, 30, tzinfo=UTC), 630),
+        (datetime(2023, 4, 1, 16, 30, tzinfo=UTC), 570),
+        (datetime(2023, 9, 30, 16, 30, tzinfo=UTC), 630),
+        (datetime(2024, 4, 6, 16, 30, tzinfo=UTC), 570),
+        (datetime(2024, 10, 5, 16, 30, tzinfo=UTC), 630),
+        (datetime(2025, 4, 5, 16, 30, tzinfo=UTC), 570),
+        (datetime(2025, 10, 4, 16, 30, tzinfo=UTC), 630),
+        (datetime(2026, 4, 4, 16, 30, tzinfo=UTC), 570),
+        (datetime(2026, 10, 3, 16, 30, tzinfo=UTC), 630),
+        (datetime(2027, 4, 3, 16, 30, tzinfo=UTC), 570),
+        (datetime(2027, 10, 2, 16, 30, tzinfo=UTC), 630),
+    ]),
+}
+_ZONES = {
+    name: (initial, [instant for instant, _ in rows], [offset for _, offset in rows])
+    for name, (initial, rows) in _ZONE_TABLES.items()
+}
+
+
+def _zone_offset(zone, taken_at):
+    """ADR-0005: the offset in minutes that `zone` has at the instant `taken_at`."""
+    initial, instants, offsets = _ZONES[zone]
+    index = bisect_right(instants, taken_at)
+    return initial if index == 0 else offsets[index - 1]
+
+
+def _local_day(snapshot, policy):
+    """ADR-0004 and ADR-0005: the calendar date that all bucket keys of a snapshot derive from."""
+    if policy.zone is None:
+        offset = policy.tz_offset_minutes
+    else:
+        offset = _zone_offset(policy.zone, snapshot.taken_at)
+    local = snapshot.taken_at.astimezone(timezone(timedelta(minutes=offset)))
+    return (local - timedelta(hours=policy.day_start_hour)).date()
+
+
+def _monthly_key(day, month_start_day):
+    """ADR-0010: (year, month) of the billing cycle that `day` falls in."""
+    year, month = day.year, day.month
+    last = calendar.monthrange(year, month)[1]
+    if day.day >= min(month_start_day, last):
+        return (year, month)
+    return (year, month - 1) if month > 1 else (year - 1, 12)
+
+
+def _weekly_key(day):
+    """ADR-0003: (ISO year, ISO week)."""
+    iso_year, iso_week, _ = day.isocalendar()
+    return (iso_year, iso_week)
+
+
+def _newest_first_key(snapshot):
+    """ADR-0001 "Ordering": later taken_at is newer; on a tie, the greater id is newer."""
+    return (snapshot.taken_at, snapshot.id)
+
+
+def _check_inputs(snapshots, now):
+    """ADR-0001 "Inputs" and ADR-0007 "Parents": raise ValueError for every input the records reject."""
+    if now.utcoffset() is None:
+        raise ValueError(f"now must be timezone-aware, got {now!r}")
+    by_id = {}
+    for snapshot in snapshots:
+        if snapshot.taken_at.utcoffset() is None:
+            raise ValueError(f"taken_at must be timezone-aware, got {snapshot.taken_at!r} for {snapshot.id!r}")
+        if snapshot.id in by_id:
+            raise ValueError(f"duplicate snapshot id {snapshot.id!r}")
+        by_id[snapshot.id] = snapshot
+    for snapshot in by_id.values():
+        if snapshot.parent is not None and snapshot.parent not in by_id:
+            raise ValueError(f"snapshot {snapshot.id!r} has parent {snapshot.parent!r}, which is not in the plan")
+    verified = set()
+    for start in by_id:
+        path, on_path, current = [], set(), start
+        while current is not None and current not in verified:
+            if current in on_path:
+                raise ValueError(f"parent cycle through snapshot {current!r}")
+            on_path.add(current)
+            path.append(current)
+            current = by_id[current].parent
+        verified.update(path)
+    return by_id
+
+
+def _in_window(snapshot, policy, now):
+    """ADR-0006: not later than now, and at most keep_within_hours old (inclusive). None and 0 mean off."""
+    hours = policy.keep_within_hours
+    if not hours:
+        return False
+    return snapshot.taken_at <= now and now - snapshot.taken_at <= timedelta(hours=hours)
+
