+import unittest
+from datetime import datetime, timedelta, timezone
+
+from vaultsnap import Policy, Snapshot, plan_retention
+from vaultsnap.retention import _zone_offset
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def at(stamp, offset=0):
+    """A timezone-aware datetime from 'YYYY-MM-DDTHH:MM' (UTC unless an offset in minutes is given)."""
+    return datetime.fromisoformat(stamp).replace(tzinfo=timezone(timedelta(minutes=offset)))
+
+
+def snap(sid, stamp, *tags, parent=None):
+    return Snapshot(sid, at(stamp), frozenset(tags), parent)
+
+
+class SetAsideAndOverrideTest(unittest.TestCase):
+    def test_future_snapshot_is_kept_and_does_not_count(self):
+        shots = [snap("a", "2026-03-10T03:00"), snap("b", "2026-03-11T03:00"), snap("f", "2026-03-25T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["f", "b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_protected_beats_expired(self):
+        shots = [snap("a", "2026-03-10T03:00", "keep", "scratch"), snap("b", "2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(protect_tags={"keep"}, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        self.assertEqual(plan.prune, [])
+
+    def test_expired_snapshot_is_pruned_even_when_a_rule_would_keep_it(self):
+        shots = [snap("a", "2026-03-10T03:00"), snap("b", "2026-03-11T03:00", "scratch")]
+        plan = plan_retention(shots, Policy(keep_last=5, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["a"])
+        self.assertEqual(plan.prune, ["b"])
+
+    def test_empty_policy_keeps_everything_except_expired(self):
+        shots = [snap("a", "2026-03-10T03:00"), snap("b", "2026-03-11T03:00", "scratch")]
+        plan = plan_retention(shots, Policy(expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["a"])
+        self.assertEqual(plan.prune, ["b"])
+
+
+class KeepWithinTest(unittest.TestCase):
+    def test_window_boundary_is_inclusive_and_window_is_set_aside(self):
+        # keep_within_hours=48: the window starts exactly at 2026-03-18T12:00.
+        shots = [
+            snap("edge", "2026-03-18T12:00"),
+            snap("late", "2026-03-18T11:59"),
+            snap("old1", "2026-03-17T03:00"),
+            snap("old2", "2026-03-16T03:00"),
+        ]
+        plan = plan_retention(shots, Policy(keep_within_hours=48, keep_daily=1), NOW)
+        # "edge" is in the window and does not take the daily slot of 2026-03-18; "late" does.
+        self.assertEqual(plan.keep, ["edge", "late"])
+        self.assertEqual(plan.prune, ["old1", "old2"])
+
+    def test_window_snapshots_do_not_count_toward_keep_last(self):
+        shots = [snap("win", "2026-03-20T11:00"), snap("a", "2026-03-10T03:00"), snap("b", "2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=24, keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["win", "b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_zero_hours_is_off_and_keeps_everything_under_an_empty_policy(self):
+        shots = [snap("a", "2026-03-10T03:00"), snap("b", "2026-03-19T03:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=0), NOW)
+        self.assertEqual(plan.prune, [])
+
+    def test_expired_snapshot_inside_the_window_is_pruned(self):
+        shots = [snap("a", "2026-03-20T11:00", "scratch"), snap("b", "2026-03-10T03:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=24, keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+class BucketTest(unittest.TestCase):
+    def test_iso_week_across_new_year(self):
+        # ISO week 2026-W01 starts Monday 2025-12-29; Sunday 2025-12-28 is in 2025-W52.
+        shots = [snap("sun", "2025-12-28T03:00"), snap("mon", "2025-12-29T03:00"), snap("thu", "2026-01-01T03:00")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.keep, ["thu", "sun"])
+        self.assertEqual(plan.prune, ["mon"])
+
+    def test_day_start_hour_moves_early_morning_into_the_previous_day(self):
+        shots = [snap("a", "2025-12-31T23:00"), snap("b", "2026-01-01T03:30"), snap("c", "2026-01-01T05:00")]
+        plan = plan_retention(shots, Policy(keep_daily=2, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, ["c", "b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_tz_offset_minutes_shifts_the_day(self):
+        shots = [snap("a", "2026-03-18T20:00"), snap("b", "2026-03-18T23:30")]
+        # +120: 20:00 UTC is 22:00 on the 18th, 23:30 UTC is 01:30 on the 19th.
+        plan = plan_retention(shots, Policy(keep_daily=2, tz_offset_minutes=120), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        plan = plan_retention(shots, Policy(keep_daily=1, tz_offset_minutes=120), NOW)
+        self.assertEqual(plan.keep, ["b"])
+
+    def test_monthly_cycle_starting_on_the_15th(self):
+        shots = [snap("jan10", "2026-01-10T03:00"), snap("jan20", "2026-01-20T03:00"), snap("dec20", "2025-12-20T03:00")]
+        # Cycle keys: 2026-01-10 and 2025-12-20 are both in (2025, 12); 2026-01-20 is in (2026, 1).
+        plan = plan_retention(shots, Policy(keep_monthly=2, month_start_day=15), NOW)
+        self.assertEqual(plan.keep, ["jan20", "jan10"])
+        self.assertEqual(plan.prune, ["dec20"])
+
+    def test_yearly_key_is_the_calendar_year_whatever_month_start_day_says(self):
+        shots = [snap("jan10", "2026-01-10T03:00"), snap("dec20", "2025-12-20T03:00")]
+        plan = plan_retention(shots, Policy(keep_yearly=1, month_start_day=15), NOW)
+        self.assertEqual(plan.keep, ["jan10"])
+
+    def test_month_start_day_31_in_short_months(self):
+        shots = [snap("feb28", "2027-02-28T03:00"), snap("mar30", "2027-03-30T03:00"), snap("mar31", "2027-03-31T03:00")]
+        # Cycle (2027, 2) runs 28 Feb to 30 Mar; cycle (2027, 3) starts 31 Mar.
+        plan = plan_retention(shots, Policy(keep_monthly=2, month_start_day=31), at("2027-04-01T12:00"))
+        self.assertEqual(plan.keep, ["mar31", "mar30"])
+        self.assertEqual(plan.prune, ["feb28"])
+
+
+class ZoneTest(unittest.TestCase):
+    def test_lakeside_offsets_at_the_switch_instant(self):
+        switch = at("2026-03-29T01:00")
+        self.assertEqual(_zone_offset("lakeside", switch), 120)
+        self.assertEqual(_zone_offset("lakeside", switch - timedelta(seconds=1)), 60)
+
+    def test_harbor_offsets_at_the_switch_instant(self):
+        switch = at("2026-10-03T16:30")
+        self.assertEqual(_zone_offset("harbor", switch), 630)
+        self.assertEqual(_zone_offset("harbor", switch - timedelta(seconds=1)), 570)
+
+    def test_offsets_before_the_first_row_and_after_the_last(self):
+        self.assertEqual(_zone_offset("lakeside", at("2000-01-01T00:00")), 60)
+        self.assertEqual(_zone_offset("harbor", at("2000-01-01T00:00")), 630)
+        self.assertEqual(_zone_offset("lakeside", at("2040-07-01T00:00")), 60)
+
+    def test_zone_is_used_and_tz_offset_minutes_is_ignored(self):
+        # Under lakeside, 2026-03-28T22:30Z is 23:30 on the 28th (+60); 2026-03-28T23:45Z is 00:45 on the 29th.
+        # tz_offset_minutes=840 would move both snapshots to the 29th; it must have no effect.
+        shots = [snap("p", "2026-03-28T22:30"), snap("q", "2026-03-28T23:45"), snap("t", "2026-03-28T20:00")]
+        plan = plan_retention(shots, Policy(keep_daily=2, zone="lakeside", tz_offset_minutes=840), at("2026-04-01T12:00"))
+        self.assertEqual(plan.keep, ["q", "p"])
+        self.assertEqual(plan.prune, ["t"])
+
+
+class ParentTest(unittest.TestCase):
+    def test_parent_of_a_kept_snapshot_is_kept(self):
+        shots = [snap("a", "2026-03-01T03:00"), snap("b", "2026-03-02T03:00", parent="a"), snap("c", "2026-03-03T03:00", parent="b")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["c", "b", "a"])
+        self.assertEqual(plan.prune, [])
+
+    def test_a_pruned_child_holds_nothing(self):
+        shots = [snap("r", "2026-03-05T03:00"), snap("q", "2026-03-10T03:00", parent="r"), snap("s", "2026-03-11T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["s"])
+        self.assertEqual(plan.prune, ["q", "r"])
+
+    def test_held_snapshot_does_not_count_toward_keep_last(self):
+        shots = [snap("p", "2026-03-12T03:00", "scratch"), snap("k", "2026-03-10T03:00", parent="p"), snap("o", "2026-03-09T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["p", "k"])
+        self.assertEqual(plan.prune, ["o"])
+
+    def test_dependency_step_overrides_expire(self):
+        shots = [snap("p", "2026-03-10T03:00", "scratch"), snap("c", "2026-03-11T03:00", parent="p")]
+        plan = plan_retention(shots, Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["c", "p"])
+
+    def test_missing_parent_is_rejected_even_with_an_empty_policy(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("c", "2026-03-10T03:00", parent="nope")], Policy(), NOW)
+
+    def test_self_parent_is_a_cycle(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00", parent="a")], Policy(), NOW)
+
+    def test_two_snapshot_cycle_is_rejected(self):
+        shots = [snap("a", "2026-03-10T03:00", parent="b"), snap("b", "2026-03-11T03:00", parent="a")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(keep_last=1), NOW)
+
+
+class InputTest(unittest.TestCase):
+    def test_naive_now_is_rejected(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00")], Policy(), datetime(2026, 3, 20, 12, 0))
+
+    def test_duplicate_ids_are_rejected(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("a", "2026-03-10T03:00"), snap("a", "2026-03-11T03:00")], Policy(), NOW)
+
+    def test_equal_taken_at_is_broken_by_the_greater_id(self):
+        shots = [snap("a", "2026-03-10T03:00"), snap("b", "2026-03-10T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+if __name__ == "__main__":
+    unittest.main()
