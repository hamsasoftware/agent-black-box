     if attempt < 1:
         raise ValueError("attempt starts at 1")
     rng = rng or random
-    delay = min(cap, base * 2 ** (attempt - 1))
-    return delay * rng.uniform(1 - jitter, 1 + jitter)
+    delay = base * 2 ** (attempt - 1)
+    delay *= rng.uniform(1 - jitter, 1 + jitter)
+    # Clamp last: jitter must not push the delay past cap (docs/RETRY.md).
+    return max(0.0, min(cap, delay))
 
 
