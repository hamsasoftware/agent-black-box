+def as_utc(ts):
+    """Naive timestamps (legacy collectors) are UTC."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts
+
+
+def filter_since(events, since):
+    since = as_utc(since)
+    for event in events:
+        if as_utc(event.ts) >= since:
