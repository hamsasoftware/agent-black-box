+import re
+
 from .version import Version
 
+_ZERO = Version(0, 0, 0)
+_OP_ONLY = re.compile(r"<=|>=|<|>|=|~|\^")
+_TOKEN = re.compile(r"(<=|>=|<|>|=|~|\^)?(.*)", re.S)
+_NUMBER = re.compile(r"0|[1-9]\d*")
+_WILD = ("x", "X", "*")
+_PRE_ID = re.compile(r"[0-9A-Za-z-]+")
+
+
+def _parse_version_text(text):
+    """Parse a possibly partial version without operator.
+
+    Returns (parts, prerelease) where parts is a list of 3 entries, each an int
+    or None for a wildcard/missing position.
+    """
+    text = text.strip()
+    if text.startswith("v"):
+        if text == "v":
+            raise ValueError("invalid version: 'v'")
+        text = text[1:]
+    text = text.split("+", 1)[0]  # build metadata is ignored
+    pre = ()
+    if "-" in text:
+        text, pre_text = text.split("-", 1)
+        ids = pre_text.split(".")
+        for ident in ids:
+            if not _PRE_ID.fullmatch(ident):
+                raise ValueError(f"invalid prerelease: {pre_text!r}")
+            if ident.isdigit() and len(ident) > 1 and ident[0] == "0":
+                raise ValueError(f"invalid prerelease: {pre_text!r}")
+        pre = tuple(ids)
+    raw = text.split(".") if text else []
+    if len(raw) > 3:
+        raise ValueError(f"invalid version: {text!r}")
+    parts = []
+    seen_wild = False
+    for piece in raw:
+        if piece in _WILD:
+            seen_wild = True
+            parts.append(None)
+        elif _NUMBER.fullmatch(piece):
+            if seen_wild:
+                raise ValueError("a number may not follow a wildcard")
+            parts.append(int(piece))
+        else:
+            raise ValueError(f"invalid version: {text!r}")
+    parts += [None] * (3 - len(parts))
+    if pre and None in parts:
+        raise ValueError("prerelease requires a full version")
+    return parts, pre
+
+
+def _lower(parts, pre=()):
+    return Version(*[p or 0 for p in parts], prerelease=pre)
+
+
+def _bump(parts, idx):
+    nums = [p or 0 for p in parts]
+    nums[idx] += 1
+    for j in range(idx + 1, 3):
+        nums[j] = 0
+    return Version(*nums)
+
+
+def _comparators(op, text):
+    """Expand one operator + version text into a list of (op, Version)."""
+    parts, pre = _parse_version_text(text)
+    if op in ("~", "^"):
+        if parts[0] is None:
+            return [(">=", _ZERO)]
+        if op == "~":
+            idx = 0 if parts[1] is None else 1
+        else:
+            n = parts.index(None) if None in parts else 3
+            idx = next((i for i in range(n) if parts[i] != 0), n - 1)
+        return [(">=", _lower(parts, pre)), ("<", _bump(parts, idx))]
+
+    if None not in parts:
+        return [("=" if op in ("", "=") else op, _lower(parts, pre))]
+
+    # Partial version with an operator (or none).
+    k = parts.index(None)
+    if k == 0:
+        return [("<", _ZERO)] if op in ("<", ">") else [(">=", _ZERO)]
+    lower = _lower(parts)
+    upper = _bump(parts, k - 1)
+    if op in ("", "="):
+        return [(">=", lower), ("<", upper)]
+    if op == ">":
+        return [(">=", upper)]
+    if op == ">=":
+        return [(">=", lower)]
+    if op == "<":
+        return [("<", lower)]
+    return [("<", upper)]  # "<="
+
+
+def _parse_set(text):
+    tokens = text.split()
+    comps = []
+    i = 0
+    while i < len(tokens):
+        if i + 2 < len(tokens) and tokens[i + 1] == "-":
+            # Hyphen range: A - B
+            comps += _comparators(">=", tokens[i])
+            comps += _comparators("<=", tokens[i + 2])
+            i += 3
+            continue
+        token = tokens[i]
+        if _OP_ONLY.fullmatch(token):
+            if i + 1 >= len(tokens) or _OP_ONLY.fullmatch(tokens[i + 1]):
+                raise ValueError(f"operator without version: {token!r}")
+            token += tokens[i + 1]
+            i += 1
+        match = _TOKEN.fullmatch(token)
+        op, body = match.group(1) or "", match.group(2)
+        comps += _comparators(op, body)
+        i += 1
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    if not range_.strip():
+        return [[(">=", _ZERO)]]
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+def _to_version(value):
+    if isinstance(value, Version):
+        return value
+    if not isinstance(value, str):
+        raise ValueError(f"invalid version: {value!r}")
+    return Version.parse(value)
+
+
+def _cmp(version, op, bound):
+    if op == "<":
+        return version < bound
+    if op == "<=":
+        return not bound < version
+    if op == ">":
+        return bound < version
+    if op == ">=":
+        return not version < bound
+    return version == bound  # "="
+
+
+def _matches(version, sets):
+    for comps in sets:
+        if not all(_cmp(version, op, bound) for op, bound in comps):
+            continue
+        if version.prerelease and not any(
+            bound.prerelease and bound.release == version.release for _, bound in comps
+        ):
+            continue
+        return True
+    return False
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_to_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        candidate = _to_version(item)
+        if _matches(candidate, sets) and (best_version is None or best_version < candidate):
+            best, best_version = item, candidate
+    return best
