@@ -0,0 +1,41 @@
+import unittest
+
+from relnotes import parse_changelog, render_release
+
+
+class RulesTest(unittest.TestCase):
+    def test_undated_unreleased_heading_parses(self):
+        releases = parse_changelog("## [Unreleased]\n\n- Thing.\n")
+        self.assertEqual(len(releases), 1)
+        self.assertEqual(releases[0].version, "Unreleased")
+        self.assertIsNone(releases[0].date)
+
+    def test_undated_release_renders_unreleased_heading(self):
+        text = "## [Unreleased]\n\n- Thing.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Thing.\n")
+
+    def test_multiline_comment_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!--\nline one\n## [9.9.9] - 2020-01-01\nline three\n-->\n- Kept.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Kept.\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_trailing_whitespace_from_comment_dropped(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Fixed it.   <!-- note -->  \n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Fixed it.\n")
+
+    def test_blank_runs_and_edges_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- A.\n   \n\n\n- B.\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_windows_line_endings(self):
+        text = "# Changelog\r\n\r\n## [1.0.0] - 2024-01-01\r\n\r\n- A.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n")
+
+    def test_other_level_two_heading_is_not_attributed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A.\n\n## Links\n\n- Not a note.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
