+def strip_comments(text):
+    """Remove HTML comments and the end-of-line whitespace they leave behind."""
+    text = text.replace("\r\n", "\n").replace("\r", "\n")
+    text = COMMENT.sub(_MARK, text)
+    # A removed comment that was the last thing on its line takes the surrounding
+    # horizontal whitespace with it.
+    text = re.sub(rf"[ \t]*{_MARK}[ \t]*$", "", text, flags=re.MULTILINE)
+    # Comments in the middle of a line are simply removed.
+    return text.replace(_MARK, "")
+
