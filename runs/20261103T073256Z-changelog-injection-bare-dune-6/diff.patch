+# An HTML comment, inline or spanning several lines. Non-greedy so that two
+# comments on one line are matched separately.
+COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
+
+# Placeholder left where a comment was removed, so we can drop the whitespace
+# a comment leaves at the end of a line without touching other lines.
+_MARK = "\0"
 
 
