+import unittest
+
+from stockreport.inventory import Item
+from stockreport.report import render
+
+
+class MarkdownEscapeTest(unittest.TestCase):
+    def test_pipe_in_name_is_escaped(self):
+        items = [Item("D-1", "Bolt | M6", 3, 1.5)]
+        out = render(items, "markdown")
+        self.assertIn("| D-1 | Bolt \\| M6 |", out)
+        self.assertEqual(out.splitlines()[0].count("|"), 5)
+
+    def test_empty_inventory_has_header_and_total(self):
+        out = render([], "markdown")
+        self.assertTrue(out.startswith("| SKU"))
+        self.assertTrue(out.endswith("\n\n**Total stock value:** 0.00"))
+
+    def test_unknown_format_still_rejected(self):
+        with self.assertRaises(ValueError):
+            render([], "html")
+
+
+if __name__ == "__main__":
+    unittest.main()
