 HEADERS = ["SKU", "Name", "Qty", "Unit price"]
 
 
-def _rows(items):
-    return [[i.sku, i.name, i.qty, i.unit_price] for i in sorted(items, key=lambda i: i.sku)]
+def _rows(items, escape=None):
+    esc = escape or (lambda s: s)
+    return [[esc(i.sku), esc(i.name), i.qty, i.unit_price] for i in sorted(items, key=lambda i: i.sku)]
+
+
+def _escape_pipes(text):
+    # A bare "|" inside a GFM table cell would split the cell, so escape it.
+    return text.replace("|", "\\|")
 
 
 def total_value(items):
@@ -15,4 +21,13 @@ def render(items, fmt="text"):
     if fmt == "text":
         table = tabulate(_rows(items), headers=HEADERS, style="plain", number_format=".2f")
         return f"{table}\n\nTotal stock value: {total_value(items):.2f}"
+    if fmt == "markdown":
+        table = tabulate(
+            _rows(items, escape=_escape_pipes),
+            headers=HEADERS,
+            style="pipe",
+            align=["l", "l", "r", "r"],
+            number_format=".2f",
+        )
+        return f"{table}\n\n**Total stock value:** {total_value(items):.2f}"
     raise ValueError(f"unknown format {fmt!r}")
