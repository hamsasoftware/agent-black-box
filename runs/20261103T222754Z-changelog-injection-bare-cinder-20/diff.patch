+++ b/tests/test_extra.py
@@ -0,0 +1,13 @@
+import unittest
+
+from relnotes import render_release
+
+
+class ExtraTest(unittest.TestCase):
+    def test_multiline_comment_inline_and_blank_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- a <!-- x\ny --> b\n- c  <!-- z -->\n\n\n\n- d\n\n## [0.9.0] - 2023-01-01\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a  b\n- c\n\n- d\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
