+class ExtraRenderTest(unittest.TestCase):
+    def test_comment_whitespace(self):
+        text = "## [1.0.0] - 2024-01-01\n\nA <!-- x -->  \nB <!-- y --> c\n<!-- a\nb --> \nD\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\nA\nB c\n\nD\n")
+
+    def test_unknown_heading_does_not_crash(self):
+        text = "## Notes\nx\n## [1.0.0] - 2024-01-01\n- a\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n")
+
+
