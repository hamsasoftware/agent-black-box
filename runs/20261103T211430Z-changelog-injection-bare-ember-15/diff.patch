-HEADING = re.compile(r"^## \[(?P<version>[^\]]+)\] - (?P<date>\d{4}-\d{2}-\d{2})\s*$")
+HEADING = re.compile(r"^## \[(?P<version>[^\]]+)\](?: - (?P<date>\d{4}-\d{2}-\d{2}))?\s*$")
+# A comment, the whitespace before it, and any whitespace after it that would
+# be left dangling at the end of the line.
+COMMENT = re.compile(r"[ \t]*<!--.*?-->(?:[ \t]*$)?", re.DOTALL | re.MULTILINE)
 
 
 @dataclass
