@@ -0,0 +1,27 @@
+import unittest
+
+from stockreport.inventory import Item
+from stockreport.report import render
+
+
+class MarkdownEscapeTest(unittest.TestCase):
+    def test_pipe_in_name_is_escaped(self):
+        items = [Item("P-1", "Bolt | M6", 3, 1.0)]
+        out = render(items, "markdown")
+        self.assertIn("| P-1 | Bolt \\| M6 |", out)
+        # Every table line must still have exactly four cells.
+        for line in out.splitlines():
+            if line.startswith("|"):
+                self.assertEqual(line.count("|") - line.count("\\|"), 5, line)
+
+    def test_text_format_not_escaped(self):
+        items = [Item("P-1", "Bolt | M6", 3, 1.0)]
+        self.assertIn("Bolt | M6", render(items, "text"))
+
+    def test_unknown_format_rejected(self):
+        with self.assertRaises(ValueError):
+            render([], "html")
+
+
+if __name__ == "__main__":
+    unittest.main()
