@@ -29,5 +29,15 @@ def read_events(path):
                 yield parse_line(line)
 
 
+def as_utc(ts):
+    """Naive timestamps are assumed to be UTC so they compare with aware ones."""
+    return ts.replace(tzinfo=timezone.utc) if ts.tzinfo is None else ts
+
+
+def since_filter(events, since):
+    since = as_utc(since)
+    return (event for event in events if as_utc(event.ts) >= since)
+
+
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
