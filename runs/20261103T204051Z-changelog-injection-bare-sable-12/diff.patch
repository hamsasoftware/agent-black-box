     body: list = field(default_factory=list)
 
 
+def _strip_comments(text):
+    """Remove HTML comments.
+
+    A comment that is the only thing on its line takes the whole line with it.
+    Otherwise, whitespace the comment leaves at the end of its line is dropped.
+    """
+    pieces = []
+    last = 0
+    for match in COMMENT.finditer(text):
+        before = text[last:match.start()]
+        end = match.end()
+        line_start = text.rfind("\n", 0, match.start()) + 1
+        starts_line = text[line_start:match.start()].strip() == ""
+        if TRAILING_SPACE.match(text, end):
+            end = TRAILING_SPACE.match(text, end).end()
+            if starts_line:
+                cut = match.start() - max(line_start, last)
+                before = before[: len(before) - cut]
+                if text.startswith("\n", end):
+                    end += 1
+            else:
+                before = before.rstrip(" \t")
+        pieces.append(before)
+        last = end
+    pieces.append(text[last:])
+    return "".join(pieces)
+
+
