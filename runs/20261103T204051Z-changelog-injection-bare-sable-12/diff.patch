+def _tidy_body(lines):
+    """Blank out whitespace-only lines, collapse blank runs, trim the ends."""
+    out = []
+    for line in lines:
+        if line.strip() == "":
+            line = ""
+            if out and out[-1] == "":
+                continue
+        out.append(line)
+    while out and out[0] == "":
+        out.pop(0)
+    while out and out[-1] == "":
+        out.pop()
+    return "\n".join(out)
+
