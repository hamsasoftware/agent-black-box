@@ -0,0 +1,70 @@
+import unittest
+
+from relnotes import parse_changelog, render_release
+
+
+class RuleTest(unittest.TestCase):
+    def test_multiline_comment_hides_heading_like_lines(self):
+        text = (
+            "## [1.0.0] - 2024-01-01\n\n"
+            "- Real change.\n\n"
+            "<!--\n## [9.9.9] - 2099-01-01\nnot a release\n-->\n"
+        )
+        releases = parse_changelog(text)
+        self.assertEqual([r.version for r in releases], ["1.0.0"])
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- Real change.\n",
+        )
+
+    def test_comment_on_its_own_line_leaves_no_blank_run(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.\n<!-- hidden -->\n- Two.\n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- One.\n- Two.\n",
+        )
+
+    def test_trailing_space_left_by_comment_is_dropped(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Item.   <!-- note -->   \n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- Item.\n",
+        )
+
+    def test_crlf_line_endings(self):
+        text = "## [1.0.0] - 2024-01-01\r\n\r\n- A.\r\n\r\n\r\n- B.\r\n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n",
+        )
+
+    def test_whitespace_only_lines_count_as_blank(self):
+        text = "## [1.0.0] - 2024-01-01\n   \n- A.\n \t \n   \n- B.\n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n",
+        )
+
+    def test_indentation_of_content_is_kept(self):
+        text = "## [1.0.0] - 2024-01-01\n\n    indented code\n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n    indented code\n",
+        )
+
+    def test_release_with_empty_body(self):
+        text = "## [1.0.0] - 2024-01-01\n\n## [0.9.0] - 2023-01-01\n- Old.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+    def test_undated_version_heading_has_no_date_in_title(self):
+        text = "## [Unreleased]\n\n- Soon.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- Soon.\n")
+
+    def test_malformed_release_heading_raises_value_error(self):
+        text = "## [1.0.0] - 01/02/2024\n\n- A.\n"
+        with self.assertRaises(ValueError):
+            render_release(text, "1.0.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
