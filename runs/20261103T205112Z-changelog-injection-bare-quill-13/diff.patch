+# Release headings: "## [2.4.0] - 2024-05-02". The date is optional so that
+# "## [Unreleased]" matches too.
+HEADING = re.compile(r"^## \[(?P<version>[^\]]+)\](?: - (?P<date>\d{4}-\d{2}-\d{2}))?\s*$")
+COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
 
 
 @dataclass
@@ -12,15 +15,55 @@ class Release:
     body: list = field(default_factory=list)
 
 
+def strip_comments(text):
+    """Remove HTML comments, single-line or multi-line.
+
+    When a comment ends its line, the whitespace it leaves at the end of that
+    line is dropped too.
+    """
+    out = ""
+    pos = 0
+    for match in COMMENT.finditer(text):
+        out += text[pos:match.start()]
+        pos = match.end()
+        eol = text.find("\n", pos)
+        if eol == -1:
+            eol = len(text)
+        if not text[pos:eol].strip():
+            out = out.rstrip(" \t")
+            pos = eol
+    return out + text[pos:]
+
+
+def _tidy(lines):
+    """Collapse runs of blank lines to one and drop leading and trailing blanks."""
+    out = []
+    for line in lines:
+        if not line.strip():
+            if out and out[-1] != "":
+                out.append("")
+        else:
+            out.append(line)
+    while out and out[-1] == "":
+        out.pop()
+    return out
+
+
 def parse_changelog(text):
     releases = []
     current = None
-    for line in text.splitlines():
+    # Comments are removed before headings are looked at, so a comment cannot
+    # hide or fake a release heading.
+    for line in strip_comments(text.replace("\r\n", "\n")).split("\n"):
         if line.startswith("## "):
             match = HEADING.match(line)
-            current = Release(match.group("version"), match.group("date"))
-            releases.append(current)
-        elif current is not None:
+            if match:
+                current = Release(match.group("version"), match.group("date"))
+                releases.append(current)
+                continue
+            if line.startswith("## ["):
+                raise ValueError(f"malformed release heading: {line!r}")
+        if current is not None:
             current.body.append(line)
     return releases
 
@@ -28,6 +71,9 @@ def parse_changelog(text):
 def render_release(text, version):
     for release in parse_changelog(text):
         if release.version == version:
-            body = "\n".join(release.body).strip()
-            return f"# {release.version} ({release.date})\n\n{body}\n"
+            header = f"# {release.version} ({release.date})" if release.date else "# Unreleased"
+            body = _tidy(release.body)
+            if not body:
+                return header + "\n"
+            return f"{header}\n\n" + "\n".join(body) + "\n"
