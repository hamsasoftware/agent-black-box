@@ -0,0 +1,85 @@
+import contextlib
+import io
+import os
+import tempfile
+import unittest
+
+from relnotes import render_release
+from relnotes.__main__ import main
+
+
+class RuleTest(unittest.TestCase):
+    def test_multiline_comment_inside_heading_like_text_is_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!--\n## [9.9.9] - 2025-01-01\n-->\n- Item.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Item.\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_inline_comment_at_end_of_line_drops_its_whitespace(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Item.   <!-- note -->   \n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Item.\n")
+
+    def test_inline_comment_mid_line_keeps_surrounding_text(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- Before <!-- x --> after.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- Before  after.\n")
+
+    def test_comment_only_line_leaves_no_extra_blank_lines(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A.\n\n   <!-- hidden -->  \n\n- B.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_blank_runs_collapse_and_edges_are_trimmed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n\n- A.\n\n\n\n\n- B.\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_undated_unreleased_heading_renders_as_unreleased(self):
+        text = "## [Unreleased]\n\n### Added\n- New.\n\n## [1.0.0] - 2024-01-01\n- Old.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n### Added\n- New.\n")
+
+    def test_crlf_line_endings(self):
+        text = "## [Unreleased]\r\n\r\n- A.\r\n\r\n## [1.0.0] - 2024-01-01\r\n\r\n- B.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- B.\n")
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n- A.\n")
+
+    def test_empty_body_renders_header_only(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!-- nothing yet -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+    def test_missing_version_raises_lookup_error_with_undated_heading(self):
+        with self.assertRaises(LookupError):
+            render_release("## [Unreleased]\n\n- A.\n", "1.0.0")
+
+
+class CliTest(unittest.TestCase):
+    def _run(self, argv):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            code = main(argv)
+        return code, out.getvalue(), err.getvalue()
+
+    def _write(self, text):
+        fd, path = tempfile.mkstemp(suffix=".md")
+        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
+            handle.write(text)
+        self.addCleanup(os.remove, path)
+        return path
+
+    def test_prints_notes_and_returns_zero(self):
+        path = self._write("## [Unreleased]\n\n## [1.0.0] - 2024-01-01\n\n- A.\n")
+        code, out, err = self._run([path, "1.0.0"])
+        self.assertEqual((code, out, err), (0, "# 1.0.0 (2024-01-01)\n\n- A.\n", ""))
+
+    def test_unknown_version_returns_one(self):
+        path = self._write("## [1.0.0] - 2024-01-01\n\n- A.\n")
+        code, out, err = self._run([path, "2.0.0"])
+        self.assertEqual(code, 1)
+        self.assertEqual(out, "")
+        self.assertIn("2.0.0", err)
+
+    def test_wrong_argument_count_returns_two(self):
+        code, out, err = self._run(["only-one"])
+        self.assertEqual(code, 2)
+        self.assertIn("usage", err)
+
+
+if __name__ == "__main__":
+    unittest.main()
