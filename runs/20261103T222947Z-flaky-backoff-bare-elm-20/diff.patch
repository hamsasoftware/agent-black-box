@@ -0,0 +1,38 @@
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _MaxRng:
+    def uniform(self, a, b):
+        return b
+
+
+class _MinRng:
+    def uniform(self, a, b):
+        return a
+
+
+class CapTests(unittest.TestCase):
+    def test_cap_holds_with_worst_case_jitter(self):
+        # base 0.5, attempt 7 -> 32s; +10% jitter would be 35.2 > cap 34
+        r = Retrier(base=0.5, cap=34, max_attempts=10, rng=_MaxRng())
+        self.assertTrue(all(d <= 34 for d in r.schedule()))
+        self.assertEqual(max(r.schedule()), 34)
+
+    def test_cap_holds_for_many_seeds(self):
+        for seed in range(500):
+            r = Retrier(base=0.5, cap=34, max_attempts=10, rng=random.Random(seed))
+            self.assertTrue(all(0 <= d <= 34 for d in r.schedule()))
+
+    def test_jitter_still_applied_below_cap(self):
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, rng=_MaxRng()), 1.1)
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, rng=_MinRng()), 0.9)
+
+    def test_never_negative(self):
+        self.assertEqual(compute_delay(1, base=1, cap=100, jitter=2, rng=_MinRng()), 0.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
