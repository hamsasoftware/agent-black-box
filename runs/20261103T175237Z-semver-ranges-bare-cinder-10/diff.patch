+"""npm-style version ranges. The contract is docs/RANGES.md."""
+
+import operator
+import re
+
 from .version import Version
 
+# An operator followed by whitespace and a version is allowed (">= 1.2.3").
+# Only collapse the space when a version-like character follows, so "> = 1"
+# is left alone and rejected.
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+(?=[vVxX*0-9])")
+_OPERATOR = re.compile(r"(<=|>=|<|>|=|~|\^)?")
+_PART = re.compile(r"0|[1-9]\d*|[xX*]")
+_BUILD = re.compile(r"[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*")
+
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+_NEVER = ("never", None)
+
+
+def _parse_term(token):
+    """Parse one comparator token into (op, parts, full).
+
+    parts is a list of three ints or None (None = wildcard / missing).
+    full is a Version when the token names a complete version, else None.
+    """
+    op = _OPERATOR.match(token).group(1) or ""
+    rest = token[len(op):]
+    if rest[:1] == "v":
+        rest = rest[1:]
+    rest, plus, build = rest.partition("+")
+    if plus and not _BUILD.fullmatch(build):
+        raise ValueError(f"invalid build metadata in {token!r}")
+    core, dash, pre = rest.partition("-")
+
+    segments = core.split(".")
+    if len(segments) > 3:
+        raise ValueError(f"invalid range term: {token!r}")
+    parts = []
+    wildcard = False
+    for seg in segments:
+        if not _PART.fullmatch(seg):
+            raise ValueError(f"invalid range term: {token!r}")
+        if seg in ("x", "X", "*"):
+            wildcard = True
+            parts.append(None)
+        elif wildcard:
+            raise ValueError(f"number after wildcard in {token!r}")
+        else:
+            parts.append(int(seg))
+    parts += [None] * (3 - len(parts))
+
+    if dash:
+        # Prereleases only make sense on a complete version.
+        if wildcard or None in parts:
+            raise ValueError(f"prerelease on partial version: {token!r}")
+        full = Version.parse(f"{parts[0]}.{parts[1]}.{parts[2]}-{pre}")
+    elif not wildcard and None not in parts:
+        full = Version(parts[0], parts[1], parts[2])
+    else:
+        full = None
+    return op, parts, full
+
+
+def _next(parts):
+    """Exclusive upper bound for a partial version: next minor, or next major if no minor."""
+    p0, p1, _ = parts
+    if p1 is None:
+        return Version(p0 + 1, 0, 0)
+    return Version(p0, p1 + 1, 0)
+
+
+def _caret_upper(parts):
+    p0, p1, p2 = parts
+    if p0 > 0:
+        return Version(p0 + 1, 0, 0)
+    if p1 is None:
+        return Version(1, 0, 0)
+    if p1 > 0:
+        return Version(0, p1 + 1, 0)
+    if p2 is None:
+        return Version(0, 1, 0)
+    return Version(0, 0, p2 + 1)
+
+
+def _term_comparators(op, parts, full):
+    """Expand one term into (op, bound) pairs that must all hold."""
+    op = op or "="
+    p0, p1, p2 = parts
+
+    if full is not None and op in ("=", "<", "<=", ">", ">="):
+        return [(op, full)]
+
+    if p0 is None:  # "*", "x", "1.x" style wildcard in the first position
+        if op in ("=", ">=", "<=", "~", "^"):
+            return []
+        return [_NEVER]  # ">*" and "<*" match nothing
+
+    lower = full if full is not None else Version(p0, p1 or 0, p2 or 0)
+    upper = _next(parts)
+    if op == "=":
+        return [(">=", lower), ("<", upper)]
+    if op == ">":
+        return [(">=", upper)]
+    if op == ">=":
+        return [(">=", lower)]
+    if op == "<":
+        return [("<", lower)]
+    if op == "<=":
+        return [("<", upper)]
+    if op == "~":
+        return [(">=", lower), ("<", upper)]
+    if op == "^":
+        return [(">=", lower), ("<", _caret_upper(parts))]
+    raise ValueError(f"unknown operator {op!r}")
+
+
+def _hyphen_comparators(low, high):
+    op_low, parts_low, full_low = low
+    op_high, parts_high, full_high = high
+    if op_low or op_high:
+        raise ValueError("operators are not allowed in a hyphen range")
+
+    if parts_low[0] is None:
+        lower = Version(0, 0, 0)
+    else:
+        lower = full_low or Version(parts_low[0], parts_low[1] or 0, parts_low[2] or 0)
+    comps = [(">=", lower)]
+
+    if full_high is not None:
+        comps.append(("<=", full_high))
+    elif parts_high[0] is not None:
+        comps.append(("<", _next(parts_high)))
+    return comps
+
+
+def _compile_set(text):
+    """Compile one comparator set into (comparators, prerelease anchors)."""
+    tokens = _OP_SPACE.sub(r"\1", text.strip()).split()
+    if not tokens:
+        return [], set()  # an empty set matches every version
+
+    if "-" in tokens:
+        if len(tokens) != 3 or tokens[1] != "-":
+            raise ValueError(f"invalid hyphen range: {text!r}")
+        comps = _hyphen_comparators(_parse_term(tokens[0]), _parse_term(tokens[2]))
+    else:
+        comps = []
+        for token in tokens:
+            comps.extend(_term_comparators(*_parse_term(token)))
+
+    anchors = {bound.release for _, bound in comps if bound is not None and bound.prerelease}
+    return comps, anchors
+
+
+def _compile(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"range must be a string: {range_!r}")
+    return [_compile_set(part) for part in range_.split("||")]
+
+
+def _as_version(value):
+    if isinstance(value, Version):
+        return value
+    if isinstance(value, str):
+        return Version.parse(value)
+    raise ValueError(f"invalid version: {value!r}")
+
+
+def _set_matches(comps, anchors, version):
+    # A prerelease only matches if a comparator in the same set names the same
+    # MAJOR.MINOR.PATCH with a prerelease tag.
+    if version.prerelease and version.release not in anchors:
+        return False
+    for op, bound in comps:
+        if op == "never" or not _OPS[op](version, bound):
+            return False
+    return True
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    parsed = _as_version(version)
+    return any(_set_matches(comps, anchors, parsed) for comps, anchors in _compile(range_))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _compile(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        candidate = _as_version(item)  # invalid entries raise, even if they would not match
+        if best_version is not None and not best_version < candidate:
+            continue
+        if any(_set_matches(comps, anchors, candidate) for comps, anchors in sets):
+            best, best_version = item, candidate
+    return best
