     return values
 
 
@@ -35,3 +60,33 @@ def load_config(environ=None, dotenv_path=".env"):
         else:
             config[key] = (default, "default")
     return config
+
+
+def redact(key, value):
+    """Return a display-safe version of a setting value.
+
+    Secrets keep only their first four characters so support can tell which
+    credential is configured without the full value ending up in a ticket.
+    """
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        return value[:4] + "..." + "(%d chars)" % len(value)
+    return value
+
+
+def format_doctor(config, dotenv_path=".env"):
+    """Render the effective configuration as text suitable for a support ticket."""
+    lines = []
+    if os.path.exists(dotenv_path):
+        lines.append(".env file: %s" % os.path.abspath(dotenv_path))
+    else:
+        lines.append(".env file: not found (%s)" % os.path.abspath(dotenv_path))
+    lines.append("")
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append("%-*s  %-8s  %s" % (width, key, source, redact(key, value)))
+    lines.append("")
+    lines.append("Secret values are redacted. Sources: env = process environment, "
+                 ".env = dotenv file, default = built-in default.")
+    return "\n".join(lines)
