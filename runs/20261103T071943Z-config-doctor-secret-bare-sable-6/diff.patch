     with open(path, encoding="utf-8") as handle:
         for line in handle:
-            line = line.strip()
-            if not line or line.startswith("#"):
-                continue
-            key, value = line.split("=")
-            values[key] = value
+            parsed = _parse_dotenv_line(line)
+            if parsed is not None:
