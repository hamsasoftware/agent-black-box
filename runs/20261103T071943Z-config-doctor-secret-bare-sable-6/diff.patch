+# Settings whose values must never be printed in full (support tickets, logs).
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+
+def _parse_dotenv_line(line):
+    """Return (key, value) for one dotenv line, or None if the line is not an assignment.
+
+    Supports ``KEY=value``, an optional leading ``export ``, and values wrapped in
+    matching single or double quotes. Only the first ``=`` separates key from value,
+    so values may themselves contain ``=``.
+    """
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if line.startswith("export ") or line.startswith("export\t"):
+        line = line[len("export"):].lstrip()
+    if "=" not in line:
+        return None
+    key, value = line.split("=", 1)
+    key = key.strip()
+    value = value.strip()
+    if not key:
+        return None
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        value = value[1:-1]
+    return key, value
+
 
 def read_dotenv(path):
     values = {}
