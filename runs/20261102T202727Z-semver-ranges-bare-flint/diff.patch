+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = rf"(?:{_NUM}|[xX*])"
+_PRE_ID = r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+_PARTIAL = re.compile(
+    rf"^[vV]?({_PART})(?:\.({_PART})(?:\.({_PART})"
+    rf"(?:-({_PRE_ID}(?:\.{_PRE_ID})*))?"
+    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?)?)?$"
+)
+_OPERATOR = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$", re.S)
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+
+# A comparator that nothing satisfies (used for e.g. ``>*``).
+_NOTHING = ("<", Version(0, 0, 0))
+
+
+def _parse_partial(text):
+    """Return (major, minor, patch, prerelease); wildcards/missing are None."""
+    match = _PARTIAL.match(text)
+    if not match:
+        raise ValueError(f"invalid range component: {text!r}")
+    parts = []
+    wildcard = False
+    for group in match.groups()[:3]:
+        if group is None or group in ("x", "X", "*"):
+            wildcard = True
+            parts.append(None)
+        else:
+            if wildcard:
+                raise ValueError(f"invalid range component: {text!r}")
+            parts.append(int(group))
+    pre = match.group(4)
+    return (*parts, tuple(pre.split(".")) if pre else ())
+
+
+def _v(major, minor, patch, pre=()):
+    return Version(major, minor, patch, pre)
+
+
+def _next_minor(major, minor):
+    return _v(major, minor + 1, 0)
+
+
+def _next_major(major):
+    return _v(major + 1, 0, 0)
+
+
+def _lower(partial):
+    """Comparators for ``>=partial`` (missing positions are zero)."""
+    major, minor, patch, pre = partial
+    if major is None:
+        return []
+    return [(">=", _v(major, minor or 0, patch or 0, pre))]
+
+
+def _upper_inclusive(partial):
+    """Comparators for ``<=partial`` where a partial means 'below the next'."""
+    major, minor, patch, pre = partial
+    if major is None:
+        return []
+    if minor is None:
+        return [("<", _next_major(major))]
+    if patch is None:
+        return [("<", _next_minor(major, minor))]
+    return [("<=", _v(major, minor, patch, pre))]
+
+
+def _primitive(op, partial):
+    major, minor, patch, pre = partial
+    if op in ("", "="):
+        if major is None:
+            return []
+        if minor is None:
+            return _lower(partial) + [("<", _next_major(major))]
+        if patch is None:
+            return _lower(partial) + [("<", _next_minor(major, minor))]
+        return [("=", _v(major, minor, patch, pre))]
+    if op == ">":
+        if major is None:
+            return [_NOTHING]
+        if minor is None:
+            return [(">=", _next_major(major))]
+        if patch is None:
+            return [(">=", _next_minor(major, minor))]
+        return [(">", _v(major, minor, patch, pre))]
+    if op == ">=":
+        return _lower(partial)
+    if op == "<":
+        if major is None:
+            return [_NOTHING]
+        return [("<", _v(major, minor or 0, patch or 0, pre))]
+    if op == "<=":
+        return _upper_inclusive(partial)
+    raise ValueError(f"invalid operator: {op!r}")
+
+
+def _tilde(partial):
+    major, minor, patch, pre = partial
+    if major is None:
+        return []
+    if minor is None:
+        return _lower(partial) + [("<", _next_major(major))]
+    return _lower(partial) + [("<", _next_minor(major, minor))]
+
+
+def _caret(partial):
+    major, minor, patch, pre = partial
+    if major is None:
+        return []
+    lower = _lower(partial)
+    if major > 0:
+        return lower + [("<", _next_major(major))]
+    if minor is None:
+        return lower + [("<", _next_major(0))]
+    if minor > 0 or patch is None:
+        return lower + [("<", _next_minor(0, minor))]
+    return lower + [("<", _v(0, 0, patch + 1))]
+
+
+def _parse_set(text):
+    text = _OP_SPACE.sub(r"\1", text.strip())
+    tokens = text.split()
+    comparators = []
+    i = 0
+    while i < len(tokens):
+        token = tokens[i]
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range: {text!r}")
+            low, high = tokens[i], tokens[i + 2]
+            if _OPERATOR.match(low).group(1) or _OPERATOR.match(high).group(1):
+                raise ValueError(f"invalid hyphen range: {text!r}")
+            comparators += _lower(_parse_partial(low)) + _upper_inclusive(_parse_partial(high))
+            i += 3
+            continue
+        op, rest = _OPERATOR.match(token).groups()
+        partial = _parse_partial(rest)
+        if op == "~":
+            comparators += _tilde(partial)
+        elif op == "^":
+            comparators += _caret(partial)
+        else:
+            comparators += _primitive(op or "", partial)
+        i += 1
+    return comparators
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return [_parse_set(part) for part in range_.split("||")]
+
+
+_OPS = {
+    "<": lambda a, b: a < b,
+    "<=": lambda a, b: a <= b,
+    ">": lambda a, b: a > b,
+    ">=": lambda a, b: a >= b,
+    "=": lambda a, b: a == b,
+}
+
+
+def _set_matches(version, comparators):
+    if not all(_OPS[op](version, bound) for op, bound in comparators):
+        return False
+    if version.prerelease:
+        return any(
+            bound.prerelease and bound.release == version.release
+            for _, bound in comparators
+        )
+    return True
+
+
+def _to_version(version):
+    return version if isinstance(version, Version) else Version.parse(version)
+
+
+def _matches(version, sets):
+    return any(_set_matches(version, comparators) for comparators in sets)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    return _matches(_to_version(version), sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_version = None, None
+    for original in versions:
+        parsed = _to_version(original)
+        if _matches(parsed, sets) and (best_version is None or parsed > best_version):
+            best, best_version = original, parsed
+    return best
