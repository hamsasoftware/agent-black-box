+import unittest
+from datetime import datetime
+
+from vaultsnap import Plan, Policy, Snapshot, plan_retention
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def snap(stamp, *tags, sid=None):
+    """Snapshot at `stamp` (an offset may be included, else +00:00)."""
+    if "+" not in stamp[10:] and "Z" not in stamp:
+        stamp += "+00:00"
+    return Snapshot(sid or "s-" + stamp[:16].replace("-", "").replace(":", "").replace("T", ""), datetime.fromisoformat(stamp), frozenset(tags))
+
+
+class RetentionRulesTest(unittest.TestCase):
+    # ADR-0003: weekly buckets are ISO (year, week), Monday start.
+    def test_weeks_are_iso_not_sunday_start(self):
+        a = snap("2025-12-27T03:00", sid="sat-dec27")   # ISO 2025-W52
+        b = snap("2026-01-03T03:00", sid="sat-jan03")   # ISO 2026-W01
+        c = snap("2026-01-04T03:00", sid="sun-jan04")   # ISO 2026-W01
+        plan = plan_retention([a, b, c], Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.keep, ["sun-jan04", "sat-dec27"])
+        self.assertEqual(plan.prune, ["sat-jan03"])
+
+    def test_iso_week_year_can_differ_from_calendar_year(self):
+        # 2025-12-30 is weekly (2026, 1), monthly (2025, 12), yearly 2025.
+        a = snap("2025-12-30T03:00", sid="dec30")
+        b = snap("2026-01-02T03:00", sid="jan02")
+        self.assertEqual(plan_retention([a, b], Policy(keep_weekly=1), NOW).keep, ["jan02"])
+        self.assertEqual(plan_retention([a, b], Policy(keep_monthly=2), NOW).keep, ["jan02", "dec30"])
+        self.assertEqual(plan_retention([a, b], Policy(keep_yearly=1), NOW).keep, ["jan02"])
+        self.assertEqual(plan_retention([a, b], Policy(keep_yearly=2), NOW).keep, ["jan02", "dec30"])
+
+    # ADR-0004: bucket time = taken_at in the fixed offset, minus day_start_hour.
+    def test_day_start_hour_moves_early_morning_into_previous_day(self):
+        a = snap("2025-12-31T23:00", sid="dec31-2300")
+        b = snap("2026-01-01T03:30", sid="jan01-0330")  # bucket 2025-12-31
+        c = snap("2026-01-01T05:00", sid="jan01-0500")  # bucket 2026-01-01
+        plan = plan_retention([a, b, c], Policy(keep_daily=2, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, ["jan01-0500", "jan01-0330"])
+        self.assertEqual(plan.prune, ["dec31-2300"])
+
+    def test_tz_offset_moves_bucket_date(self):
+        a = snap("2026-03-01T23:30", sid="mar01-2330")  # 2026-03-02 00:30 at +01:00
+        b = snap("2026-03-02T10:00", sid="mar02-1000")  # 2026-03-02 11:00 at +01:00
+        plan = plan_retention([a, b], Policy(keep_daily=2, tz_offset_minutes=60), NOW)
+        self.assertEqual(plan.keep, ["mar02-1000"])
+        self.assertEqual(plan.prune, ["mar01-2330"])
+
+    def test_offset_in_snapshot_timestamp_is_respected(self):
+        # 2026-03-02T00:30+02:00 is 2026-03-01T22:30 UTC: with the default UTC buckets it is 03-01.
+        a = snap("2026-03-02T00:30+02:00", sid="late-utc-0130")
+        b = snap("2026-03-01T12:00", sid="mar01-1200")
+        plan = plan_retention([a, b], Policy(keep_daily=2), NOW)
+        self.assertEqual(plan.keep, ["late-utc-0130"])
+        self.assertEqual(plan.prune, ["mar01-1200"])
+
+    # Set-aside snapshots: future ones and protected ones.
+    def test_future_snapshot_is_kept_and_does_not_count(self):
+        future = snap("2026-03-21T03:00", sid="future")
+        a = snap("2026-03-19T03:00", sid="mar19")
+        b = snap("2026-03-18T03:00", sid="mar18")
+        plan = plan_retention([future, a, b], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["future", "mar19"])
+        self.assertEqual(plan.prune, ["mar18"])
+
+    def test_snapshot_exactly_at_now_is_not_set_aside(self):
+        at_now = snap("2026-03-20T12:00", sid="at-now")
+        a = snap("2026-03-19T03:00", sid="mar19")
+        plan = plan_retention([at_now, a], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["at-now"])
+        self.assertEqual(plan.prune, ["mar19"])
+
+    def test_protected_snapshot_is_never_a_bucket_representative(self):
+        tagged = snap("2026-03-18T10:00", "release", sid="tagged")
+        untagged = snap("2026-03-18T08:00", sid="untagged")
+        older = snap("2026-03-17T08:00", sid="older")
+        plan = plan_retention([tagged, untagged, older], Policy(keep_daily=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan.keep, ["tagged", "untagged"])
+        self.assertEqual(plan.prune, ["older"])
+
+    # Ordering and gaps.
+    def test_same_taken_at_greater_id_is_newer(self):
+        a = snap("2026-03-18T10:00", sid="a")
+        b = snap("2026-03-18T10:00", sid="b")
+        plan = plan_retention([a, b], Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_empty_periods_do_not_use_up_n(self):
+        shots = [snap("2026-03-01T03:00", sid="mar01"), snap("2026-03-17T03:00", sid="mar17"), snap("2026-03-18T03:00", sid="mar18")]
+        plan = plan_retention(shots, Policy(keep_daily=2), NOW)
+        self.assertEqual(plan.keep, ["mar18", "mar17"])
+        self.assertEqual(plan.prune, ["mar01"])
+
+    def test_rules_are_independent_and_union(self):
+        shots = [
+            snap("2024-05-01T03:00", sid="y2024"),
+            snap("2025-06-01T03:00", sid="y2025-jun"),
+            snap("2025-07-01T03:00", sid="y2025-jul"),
+            snap("2026-03-18T03:00", sid="y2026"),
+        ]
+        plan = plan_retention(shots, Policy(keep_last=1, keep_yearly=2), NOW)
+        self.assertEqual(plan.keep, ["y2026", "y2025-jul"])
+        self.assertEqual(plan.prune, ["y2025-jun", "y2024"])
+
+    # Empty policy and validation.
+    def test_empty_policy_keeps_everything_even_future(self):
+        shots = [snap("2026-03-21T03:00", sid="future"), snap("2026-03-01T03:00", sid="mar01")]
+        plan = plan_retention(shots, Policy(), NOW)
+        self.assertEqual(plan, Plan(keep=["future", "mar01"], prune=[]))
+
+    def test_zero_counts_are_off(self):
+        shots = [snap("2026-03-18T03:00", sid="a"), snap("2026-03-17T03:00", sid="b")]
+        plan = plan_retention(shots, Policy(keep_last=0, keep_daily=0), NOW)
+        self.assertEqual(plan, Plan(keep=["a", "b"], prune=[]))
+
+    def test_naive_now_is_rejected(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("2026-03-18T03:00")], Policy(keep_last=1), datetime(2026, 3, 20, 12, 0))
+
+    def test_naive_taken_at_is_rejected_even_with_empty_policy(self):
+        with self.assertRaises(ValueError):
+            plan_retention([Snapshot("x", datetime(2026, 3, 1, 3, 0))], Policy(), NOW)
+
+    def test_duplicate_ids_are_rejected(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("2026-03-18T03:00", sid="same"), snap("2026-03-17T03:00", sid="same")], Policy(keep_last=1), NOW)
+
+    def test_every_id_appears_exactly_once(self):
+        shots = [snap(f"2026-03-{d:02d}T03:00", sid=f"d{d}") for d in range(1, 21)]
+        plan = plan_retention(shots, Policy(keep_last=3, keep_daily=4, keep_weekly=2, keep_monthly=1), NOW)
+        self.assertEqual(sorted(plan.keep + plan.prune), sorted(s.id for s in shots))
+        self.assertEqual(len(set(plan.keep) & set(plan.prune)), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
