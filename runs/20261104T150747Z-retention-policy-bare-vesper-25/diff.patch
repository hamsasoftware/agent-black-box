@@ -1,4 +1,5 @@
 from dataclasses import dataclass
+from datetime import timedelta, timezone
 
 
 @dataclass(frozen=True)
@@ -12,9 +13,68 @@ class Plan:
     prune: list
 
 
+def _require_aware(value, what):
+    if value.tzinfo is None or value.utcoffset() is None:
+        raise ValueError(f"{what} must be timezone-aware, got {value!r}")
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+
+    The rules are in docs/adr/: ADR-0001 (model), ADR-0003 (ISO weeks), ADR-0004 (day boundary).
     """
-    raise NotImplementedError
+    _require_aware(now, "now")
+    shots = list(snapshots)
+    seen = set()
+    for s in shots:
+        _require_aware(s.taken_at, f"taken_at of snapshot {s.id!r}")
+        if s.id in seen:
+            raise ValueError(f"duplicate snapshot id {s.id!r}")
+        seen.add(s.id)
+
+    # Newer = later taken_at; on a tie, the greater id is newer. Lists below are newest first.
+    newest_first = sorted(shots, key=lambda s: (s.taken_at, s.id), reverse=True)
+
+    # An empty policy never prunes.
+    if not policy.has_rules:
+        return Plan(keep=[s.id for s in newest_first], prune=[])
+
+    kept = set()
+    remaining = []  # snapshots the rules may act on, newest first
+    for s in newest_first:
+        # Set aside: protected-tag snapshots, and snapshots after `now` (clock-skew guard).
+        if s.taken_at > now or not policy.protect_tags.isdisjoint(s.tags):
+            kept.add(s.id)
+        else:
+            remaining.append(s)
+
+    if policy.keep_last:
+        kept.update(s.id for s in remaining[: policy.keep_last])
+
+    def bucket_date(taken_at):
+        # ADR-0004: shift to the fixed offset, then back by day_start_hour; its date is the bucket date.
+        local = taken_at.astimezone(timezone(timedelta(minutes=policy.tz_offset_minutes)))
+        return (local - timedelta(hours=policy.day_start_hour)).date()
+
+    # ADR-0001 buckets; weekly key is the ISO (year, week) pair per ADR-0003.
+    key_rules = (
+        ("keep_daily", lambda d: d),
+        ("keep_weekly", lambda d: d.isocalendar()[:2]),
+        ("keep_monthly", lambda d: (d.year, d.month)),
+        ("keep_yearly", lambda d: d.year),
+    )
+    for rule, key_of in key_rules:
+        count = getattr(policy, rule)
+        if not count:
+            continue
+        newest_in_bucket = {}  # bucket key -> newest remaining snapshot in that bucket
+        for s in remaining:
+            newest_in_bucket.setdefault(key_of(bucket_date(s.taken_at)), s)
+        for key in sorted(newest_in_bucket, reverse=True)[:count]:
+            kept.add(newest_in_bucket[key].id)
+
+    keep = [s.id for s in newest_first if s.id in kept]
+    prune = [s.id for s in newest_first if s.id not in kept]
+    return Plan(keep=keep, prune=prune)
