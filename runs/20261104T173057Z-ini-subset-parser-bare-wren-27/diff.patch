+"""Edge cases from docs/FORMAT.md. Each test names the rule it checks."""
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class ParseErrorTest(unittest.TestCase):
+    def assertError(self, text, message, lineno, **kwargs):
+        with self.assertRaises(ParseError) as ctx:
+            loads(text, **kwargs)
+        self.assertTrue(
+            ctx.exception.message.startswith(message),
+            f"message {ctx.exception.message!r} does not start with {message!r}",
+        )
+        self.assertEqual(ctx.exception.lineno, lineno)
+        self.assertEqual(str(ctx.exception), f"<string>:{lineno}: {ctx.exception.message}")
+
+    def test_invalid_line(self):
+        self.assertError("ok = 1\nno equals here\n", "invalid line", 2)
+        self.assertError("@includes \"x\"\n", "invalid line", 1)
+        self.assertError("a..b = 1\n", "invalid line", 1)
+
+    def test_continuation_without_value(self):
+        self.assertError("   stray\n", "continuation without a value", 1)
+        self.assertError("[a]\n  stray\n", "continuation without a value", 2)
+
+    def test_invalid_section_header(self):
+        self.assertError("[a]x\n", "invalid section header", 1)
+        self.assertError("[a . b]\n", "invalid section header", 1)
+        self.assertError("[a\n", "invalid section header", 1)
+
+    def test_key_conflicts(self):
+        self.assertError("a = 1\na.b = 2\n", "key conflict", 2)
+        self.assertError("a.b = 1\na = 2\n", "key conflict", 2)
+        self.assertError("a = 1\n[a]\n", "key conflict", 2)
+
+    def test_invalid_escape_and_trailing_text(self):
+        self.assertError('x = "a\\qb"\n', "invalid escape", 1)
+        self.assertError('x = "\\u12"\n', "invalid escape", 1)
+        self.assertError('x = "a"b\n', "unexpected text after string", 1)
+        self.assertError('x = "a"#c\n', "unexpected text after string", 1)
+
+    def test_backslash_at_end_of_line_is_unterminated(self):
+        self.assertError('x = "abc\\\ny = 1\n', "unterminated string", 1)
+
+    def test_list_errors(self):
+        self.assertError("x = [1,,2]\n", "invalid list", 1)
+        self.assertError("x = [,]\n", "invalid list", 1)
+        self.assertError('x = ["a" "b"]\n', "invalid list", 1)
+        self.assertError("x = [1] 2\n", "invalid list", 1)
+        self.assertError("x = [1, 2\n", "unterminated list", 1)
+
+    def test_error_in_continuation_reported_at_key_line(self):
+        self.assertError('a = 1\nx = "ok"\n    more\n', "unexpected text after string", 2)
+        self.assertError('x = "ok\n    more"\n', "unterminated string", 1)
+        self.assertError("x =\n    [1,\n    2\n", "unterminated list", 1)
+
+    def test_duplicate_key_wins_only_after_value_parses(self):
+        self.assertError("x = 1\nx = \"bad\\q\"\n", "invalid escape", 2)
+
+    def test_duplicate_section_across_dotted_tables_is_ok(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_error_str_format(self):
+        error = ParseError("duplicate key a", 7, "f.ini")
+        self.assertEqual(str(error), "f.ini:7: duplicate key a")
+        self.assertIsInstance(error, ValueError)
+
+
+class SectionAndKeyTest(unittest.TestCase):
+    def test_header_spacing_and_comments(self):
+        self.assertEqual(loads("[ a.b ]  # note\nx = 1\n"), {"a": {"b": {"x": 1}}})
+        self.assertEqual(loads("[a] ; note\n"), {"a": {}})
+
+    def test_empty_section_is_empty_dict(self):
+        self.assertEqual(loads("[a]\n[b]\n"), {"a": {}, "b": {}})
+
+    def test_keys_before_header_are_top_level(self):
+        self.assertEqual(loads("x = 1\n[s]\ny = 2\n"), {"x": 1, "s": {"y": 2}})
+
+    def test_dotted_key_does_not_define_section(self):
+        self.assertEqual(loads("a.b = 1\n[a]\nc = 2\n"), {"a": {"b": 1, "c": 2}})
+
+    def test_key_order_is_definition_order(self):
+        self.assertEqual(list(loads("z = 1\na = 2\n[m]\nk = 0\n")), ["z", "a", "m"])
+
+    def test_spaces_around_equals_and_dotted_key_in_section(self):
+        self.assertEqual(loads("[a]\nx.y   =   3\n"), {"a": {"x": {"y": 3}}})
+
+    def test_crlf_and_cr_line_endings_keep_line_numbers(self):
+        self.assertEqual(loads("a = 1\r\nb = 2\r\n"), {"a": 1, "b": 2})
+        with self.assertRaises(ParseError) as ctx:
+            loads("a = 1\rb = 1\ra = 2\r")
+        self.assertEqual(ctx.exception.lineno, 3)
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+
+class ValueRuleTest(unittest.TestCase):
+    def test_scalar_table(self):
+        text = (
+            "t1 = True\nt2 = FALSE\n"
+            "i1 = +7\ni2 = -0\ni3 = 1_000\n"
+            "h = 0xFF\no = 0o17\nb = -0b101\nH = 0X1f\n"
+            "f1 = 1.5\nf2 = .5\nf3 = 5.\nf4 = 1e3\nf5 = -2.5E-3\nf6 = 1_0.2\n"
+            "f7 = 00.5\nf8 = 007e1\n"
+            "s1 = 007\ns2 = 1__0\ns3 = _1\ns4 = inf\ns5 = nan\ns6 = yes\n"
+            "s7 = 1.2.3\ns8 = 0x\ns9 = 1e\ns10 = +\ns11 = .\ns12 = 0_0\n"
+        )
+        result = loads(text)
+        self.assertEqual(result["t1"], True)
+        self.assertEqual(result["t2"], False)
+        self.assertEqual([result["i1"], result["i2"], result["i3"]], [7, 0, 1000])
+        self.assertEqual([result["h"], result["o"], result["b"], result["H"]], [255, 15, -5, 31])
+        self.assertEqual(
+            [result[k] for k in ("f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8")],
+            [1.5, 0.5, 5.0, 1000.0, -0.0025, 10.2, 0.5, 70.0],
+        )
+        for key in ("s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9", "s10", "s11", "s12"):
+            self.assertIsInstance(result[key], str, key)
+        self.assertEqual(result["s1"], "007")
+
+    def test_quoted_values_are_never_converted(self):
+        self.assertEqual(loads("a = 'true'\nb = \"42\"\n"), {"a": "true", "b": "42"})
+
+    def test_quoted_string_escapes(self):
+        self.assertEqual(loads('a = "\\u0041\\\\\\"\\0"\n'), {"a": 'A\\"\0'})
+        self.assertEqual(loads("a = 'x\\ty'\n"), {"a": "x\\ty"})
+
+    def test_quoted_value_with_comment(self):
+        self.assertEqual(loads('a = "x" # note\n'), {"a": "x"})
+
+    def test_plain_text_with_quotes_and_brackets(self):
+        self.assertEqual(loads("a = say \"hi\" [x]\n"), {"a": 'say "hi" [x]'})
+
+    def test_plain_multiline_skips_blank_and_comment_lines(self):
+        text = "v =\n\n    one\n    # skipped\n    two  # two\n"
+        self.assertEqual(loads(text), {"v": "one\ntwo"})
+
+    def test_multiline_value_on_first_line(self):
+        self.assertEqual(loads("v = first\n    second\n"), {"v": "first\nsecond"})
+
+    def test_list_details(self):
+        text = (
+            "a = [1, 'x', \"y z\", [2, 3], [], it's,]\n"
+            "b = [\n"
+            "    # comment inside list\n"
+            "    alpha,   # trailing\n"
+            "    beta\n"
+            "    ]\n"
+            "c = [0x10, true, 1.5]\n"
+            "d = [#x]\n"
+        )
+        result = loads(text)
+        self.assertEqual(result["a"], [1, "x", "y z", [2, 3], [], "it's"])
+        self.assertEqual(result["b"], ["alpha", "beta"])
+        self.assertEqual(result["c"], [16, True, 1.5])
+        self.assertEqual(result["d"], ["#x"])
+
+    def test_list_with_comment_then_nothing_is_unterminated(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads("a = [1 # c]\n")
+        self.assertEqual(ctx.exception.message.split(":")[0], "unterminated list")
+
+    def test_top_level_comment_before_list(self):
+        self.assertEqual(loads("a = # note\n    [1, 2]\n"), {"a": [1, 2]})
+
