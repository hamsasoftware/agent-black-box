+class CommandLineRuleTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "confkit", *args],
+            cwd=ROOT, capture_output=True, text=True,
+        )
+
+    def write_tmp(self, tmp, text):
+        path = os.path.join(tmp, "c.ini")
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_prints_whole_document_as_json(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result = self.run_cli(self.write_tmp(tmp, "[s]\nport = 1\n"))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, '{\n  "s": {\n    "port": 1\n  }\n}\n')
+
+    def test_missing_get_key_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            result = self.run_cli(self.write_tmp(tmp, "a = 1\n"), "--get", "b.c")
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("no such key: b.c", result.stderr)
+
+    def test_parse_error_exits_1(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = self.write_tmp(tmp, "a = 1\na = 2\n")
+            result = self.run_cli(path)
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stderr.strip(), f"{path}:2: duplicate key a")
+
+
+if __name__ == "__main__":
+    unittest.main()
