+class IncludeRuleTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.dir = self.tmp.name
+
+    def write(self, name, text):
+        path = os.path.join(self.dir, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_without_base_dir_is_error(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('@include "x.ini"\n')
+        self.assertTrue(ctx.exception.message.startswith("include needs a base directory"))
+
+    def test_include_resumes_in_its_section(self):
+        self.write("part.ini", "inner = 1\n")
+        text = "[s]\n@include \"part.ini\"\nafter = 2\n"
+        self.assertEqual(loads(text, base_dir=self.dir), {"s": {"after": 2}, "inner": 1})
+
+    def test_include_path_forms(self):
+        self.write("sub/x.ini", "v = 'x'\n")
+        result = loads("@include 'sub/x.ini'   # c\n", base_dir=self.dir)
+        self.assertEqual(result, {"v": "x"})
+
+    def test_malformed_include_paths(self):
+        for text in ("@include\n", "@include x.ini\n", "@include \"x.ini\n",
+                     "@include \"x.ini\"junk\n", "@include \"x.ini\"#c\n", "@include \"a\\q\"\n"):
+            with self.subTest(text=text):
+                with self.assertRaises(ParseError) as ctx:
+                    loads(text, base_dir=self.dir)
+                self.assertTrue(ctx.exception.message.startswith("invalid include"))
+                self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_missing_include_is_cannot_read(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('x = 1\n@include "nope.ini"\n', base_dir=self.dir)
+        self.assertTrue(ctx.exception.message.startswith("cannot read include"))
+        self.assertEqual(ctx.exception.lineno, 2)
+
+    def test_continuation_after_include_is_error(self):
+        self.write("p.ini", "a = 1\n")
+        with self.assertRaises(ParseError) as ctx:
+            loads('@include "p.ini"\n    more\n', base_dir=self.dir)
+        self.assertTrue(ctx.exception.message.startswith("continuation without a value"))
+
+    def test_error_inside_include_has_its_own_source(self):
+        self.write("sub/bad.ini", "ok = 1\nbad line\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(self.write("main.ini", '@include "sub/bad.ini"\n'))
+        self.assertEqual(ctx.exception.source, os.path.normpath(os.path.join(self.dir, "sub/bad.ini")))
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertTrue(ctx.exception.message.startswith("invalid line"))
+
+    def test_nested_relative_includes_resolve_from_including_file(self):
+        self.write("a/one.ini", '@include "two.ini"\n')
+        self.write("a/two.ini", "deep = yes\n")
+        self.assertEqual(load(self.write("main.ini", '@include "a/one.ini"\n')), {"deep": "yes"})
+
+    def test_same_file_twice_is_duplicate_not_cycle(self):
+        self.write("p.ini", "a = 1\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(self.write("main.ini", '@include "p.ini"\n@include "p.ini"\n'))
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+        self.assertEqual(ctx.exception.lineno, 1)
+        self.assertEqual(ctx.exception.source, os.path.join(self.dir, "p.ini"))
+
+    def test_self_include_is_cycle(self):
+        main = self.write("main.ini", '@include "main.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("include cycle"))
+        self.assertEqual(ctx.exception.lineno, 1)
+        self.assertEqual(ctx.exception.source, main)
+
+    def test_load_missing_file_raises_oserror(self):
+        with self.assertRaises(OSError):
+            load(os.path.join(self.dir, "missing.ini"))
+
