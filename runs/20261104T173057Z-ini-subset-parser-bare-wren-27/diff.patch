-"""Configuration parser.
+"""Configuration parser for the format described in docs/FORMAT.md.
 
-This module used to be a thin wrapper around the third-party package ``inilite``.
+The parser reads the document top to bottom and stops at the first error.
 """
-import inilite
+import os
+import re
 
 from .errors import ParseError
 
 
+class _Syntax(Exception):
+    """A problem inside one value; the caller adds the key's line number."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = rf"{_NAME}(?:\.{_NAME})*"
+_HEADER_RE = re.compile(rf"\[[ \t]*({_DOTTED})[ \t]*\](?:[ \t]*|[ \t]+[#;].*)")
+_ENTRY_RE = re.compile(rf"({_DOTTED})[ \t]*=")
+_NAME_CHAR_RE = re.compile(r"[A-Za-z0-9_-]")
+_LINE_END_RE = re.compile(r"\r\n|\r|\n")
+_HEX4_RE = re.compile(r"[0-9A-Fa-f]{4}")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_PREFIXED_INT_RE = re.compile(
+    r"[+-]?0(?:[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*"
+    r"|[oO][0-7](?:_?[0-7])*"
+    r"|[bB][01](?:_?[01])*)"
+)
+_FLOAT_RE = re.compile(
+    rf"[+-]?(?:{_DIGITS}\.(?:{_DIGITS})?|\.{_DIGITS})(?:[eE][+-]?[0-9]+)?"
+    rf"|[+-]?{_DIGITS}[eE][+-]?[0-9]+"
+)
+
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+
+
+# ---------------------------------------------------------------- scalars
+
+def _convert(text):
+    """Convert an unquoted, trimmed scalar; anything that matches no rule is a str."""
+    if text.lower() in ("true", "false"):
+        return text.lower() == "true"
+    if _INT_RE.fullmatch(text):
+        return int(text.replace("_", ""))
+    if _PREFIXED_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 0)
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
+
+
+# ------------------------------------------------------- value scanning
+# A value text is the entry's text after "=" plus its continuation lines,
+# joined with "\n" and with blank and comment lines already removed.
+
+def _skip(text, pos):
+    """Skip whitespace (including newlines) and inline comments."""
+    n = len(text)
+    while pos < n:
+        ch = text[pos]
+        if ch in " \t\n":
+            pos += 1
+        elif ch in "#;" and (pos == 0 or text[pos - 1] in " \t\n"):
+            end = text.find("\n", pos)
+            pos = n if end < 0 else end
+        else:
+            break
+    return pos
+
+
+def _scan_string(text, pos):
+    """Read a quoted string starting at text[pos]; return (value, end)."""
+    quote = text[pos]
+    n = len(text)
+    out = []
+    i = pos + 1
+    while True:
+        if i >= n or text[i] == "\n":
+            raise _Syntax("unterminated string")
+        ch = text[i]
+        if ch == quote:
+            return "".join(out), i + 1
+        if quote == "'" or ch != "\\":
+            out.append(ch)
+            i += 1
+            continue
+        if i + 1 >= n or text[i + 1] == "\n":
+            raise _Syntax("unterminated string")
+        esc = text[i + 1]
+        if esc in _ESCAPES:
+            out.append(_ESCAPES[esc])
+            i += 2
+        elif esc == "u":
+            digits = text[i + 2:i + 6]
+            if not _HEX4_RE.fullmatch(digits):
+                raise _Syntax("invalid escape")
+            out.append(chr(int(digits, 16)))
+            i += 6
+        else:
+            raise _Syntax("invalid escape")
+
+
+def _scan_token(text, pos):
+    """Read an unquoted list item; return (value, end)."""
+    n = len(text)
+    end = pos
+    while end < n:
+        ch = text[end]
+        if ch in ",][\n":
+            break
+        if ch in "#;" and text[end - 1] in " \t":
+            break
+        end += 1
+    if end == pos:
+        raise _Syntax("invalid list")
+    return _convert(text[pos:end].strip(" \t")), end
+
+
+def _scan_item(text, pos):
+    ch = text[pos]
+    if ch == ",":
+        raise _Syntax("invalid list")
+    if ch in "\"'":
+        return _scan_string(text, pos)
+    if ch == "[":
+        return _scan_list(text, pos)
+    return _scan_token(text, pos)
+
+
+def _scan_list(text, pos):
+    """Read a list starting at text[pos] == "["; return (items, end)."""
+    n = len(text)
+    items = []
+    pos = _skip(text, pos + 1)
+    if pos >= n:
+        raise _Syntax("unterminated list")
+    if text[pos] == "]":
+        return items, pos + 1
+    while True:
+        value, pos = _scan_item(text, pos)
+        items.append(value)
+        pos = _skip(text, pos)
+        if pos >= n:
+            raise _Syntax("unterminated list")
+        if text[pos] == "]":
+            return items, pos + 1
+        if text[pos] != ",":
+            raise _Syntax("invalid list")
+        pos = _skip(text, pos + 1)
+        if pos >= n:
+            raise _Syntax("unterminated list")
+        if text[pos] == "]":
+            return items, pos + 1
+
+
+def _strip_comment(line):
+    for i, ch in enumerate(line):
+        if ch in "#;" and (i == 0 or line[i - 1] in " \t"):
+            return line[:i].rstrip(" \t")
+    return line
+
+
+def _parse_value(text):
+    n = len(text)
+    pos = _skip(text, 0)
+    if pos >= n:
+        return ""
+    ch = text[pos]
+    if ch in "\"'":
+        value, end = _scan_string(text, pos)
+        if _skip(text, end) != n:
+            raise _Syntax("unexpected text after string")
+        return value
+    if ch == "[":
+        items, end = _scan_list(text, pos)
+        if _skip(text, end) != n:
+            raise _Syntax("invalid list")
+        return items
+    lines = [_strip_comment(line.strip(" \t")) for line in text.split("\n")]
+    lines = [line for line in lines if line]
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _convert(lines[0])
+    return "\n".join(lines)
+
+
+# ------------------------------------------------------------ document
+
+class _State:
+    def __init__(self, active):
+        self.root = {}
+        self.defined = set()  # full names of sections that have a header
+        self.active = list(active)  # real paths of the files being read
+
+
+class _Entry:
+    def __init__(self, key, raw, lineno):
+        self.key = key
+        self.raw = raw
+        self.lineno = lineno
+        self.conts = []
+
+
+def _table(state, path, lineno, source):
+    node = state.root
+    for i, part in enumerate(path):
+        if part not in node:
+            node[part] = {}
+        elif not isinstance(node[part], dict):
+            raise ParseError(f"key conflict {'.'.join(path[:i + 1])}", lineno, source)
+        node = node[part]
+    return node
+
+
+def _store(state, path, value, lineno, source):
+    name = ".".join(path)
+    parent = _table(state, path[:-1], lineno, source)
+    last = path[-1]
+    if last in parent:
+        if isinstance(parent[last], dict):
+            raise ParseError(f"key conflict {name}", lineno, source)
+        raise ParseError(f"duplicate key {name}", lineno, source)
+    parent[last] = value
+
+
+def _finish_entry(state, section, entry, source):
+    text = "\n".join([entry.raw.strip(" \t")] + entry.conts)
+    try:
+        value = _parse_value(text)
+    except _Syntax as exc:
+        raise ParseError(exc.message, entry.lineno, source) from None
+    _store(state, section + entry.key, value, entry.lineno, source)
+
+
+def _header(state, line, lineno, source):
+    match = _HEADER_RE.fullmatch(line)
+    if not match:
+        raise ParseError("invalid section header", lineno, source)
+    name = tuple(match.group(1).split("."))
+    if name in state.defined:
+        raise ParseError(f"duplicate section {'.'.join(name)}", lineno, source)
+    state.defined.add(name)
+    _table(state, name, lineno, source)
+    return name
+
+
+def _include(state, line, lineno, base_dir, source):
+    rest = line[len("@include"):]
+    if not rest or rest[0] not in " \t":
+        raise ParseError("invalid include", lineno, source)
+    rest = rest.lstrip(" \t")
+    if not rest or rest[0] not in "\"'":
+        raise ParseError("invalid include", lineno, source)
+    try:
+        name, end = _scan_string(rest, 0)
+    except _Syntax:
+        raise ParseError("invalid include", lineno, source) from None
+    if _skip(rest, end) != len(rest):
+        raise ParseError("invalid include", lineno, source)
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+
+    raw = os.path.join(base_dir, name)
+    real = os.path.realpath(raw)
+    if real in state.active:
+        raise ParseError(f'include cycle: "{name}"', lineno, source)
+    try:
+        with open(raw, encoding="utf-8") as handle:
+            text = handle.read()
+    except (OSError, UnicodeDecodeError):
+        raise ParseError(f'cannot read include "{name}"', lineno, source) from None
+
+    state.active.append(real)
+    try:
+        _parse_text(state, text, os.path.dirname(raw), os.path.normpath(raw))
+    finally:
+        state.active.pop()
+
+
+def _parse_text(state, text, base_dir, source):
+    if text.startswith("﻿"):
+        text = text[1:]
+    section = ()
+    pending = None
+    for lineno, line in enumerate(_LINE_END_RE.split(text), 1):
+        stripped = line.strip(" \t")
+        if not stripped:
+            continue
+        if line[0] in " \t":
+            if stripped[0] in "#;":
+                continue
+            if pending is None:
+                raise ParseError("continuation without a value", lineno, source)
+            pending.conts.append(stripped)
+            continue
+        if line[0] in "#;":
+            continue
+        if pending is not None:
+            _finish_entry(state, section, pending, source)
+            pending = None
+        if line[0] == "[":
+            section = _header(state, line, lineno, source)
+        elif line.startswith("@include") and (
+            len(line) == len("@include") or not _NAME_CHAR_RE.match(line, len("@include"))
+        ):
+            _include(state, line, lineno, base_dir, source)
+        else:
+            match = _ENTRY_RE.match(line)
+            if not match:
+                raise ParseError("invalid line", lineno, source)
+            key = tuple(match.group(1).split("."))
+            pending = _Entry(key, line[match.end():], lineno)
+    if pending is not None:
+        _finish_entry(state, section, pending, source)
+
+
+# -------------------------------------------------------------- public
+
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    """Parse configuration text and return a nested dict.
+
+    ``base_dir`` is where relative ``@include`` paths resolve; without it an
+    include is an error.
+    """
+    active = []
+    if base_dir is not None:
+        active.append(os.path.realpath(os.path.join(base_dir, source)))
+    state = _State(active)
+    _parse_text(state, text, base_dir, source)
+    return state.root
 
 
 def load(path):
+    """Read and parse the UTF-8 file at ``path``."""
     with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+        text = handle.read()
+    state = _State([os.path.realpath(path)])
+    _parse_text(state, text, os.path.dirname(path), path)
+    return state.root
