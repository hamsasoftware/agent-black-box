+import re
+
 from .version import Version
 
+# A partial version position: a number, or a wildcard (x, X, *).
+_POSITION = r"(?:0|[1-9]\d*|[xX*])"
+_PARTIAL = re.compile(rf"^v?({_POSITION})(?:\.({_POSITION})(?:\.({_POSITION}))?)?$")
+_OPERATORS = ("<=", ">=", "<", ">", "=")
+_WILDCARDS = ("x", "X", "*")
+
+# Sentinel operator for comparators that can never match (e.g. "<*").
+_NEVER = "never"
+
+
+class _Partial:
+    """A version with missing or wildcard positions (major/minor/patch may be None)."""
+
+    __slots__ = ("major", "minor", "patch", "prerelease")
+
+    def __init__(self, major, minor, patch, prerelease=()):
+        self.major = major
+        self.minor = minor
+        self.patch = patch
+        self.prerelease = tuple(prerelease)
+
+    def floor(self):
+        """Lowest version this partial stands for, with missing positions as zero."""
+        return Version(self.major or 0, self.minor or 0, self.patch or 0, self.prerelease)
+
+    def ceiling(self):
+        """Exclusive upper bound of the x-range this partial stands for."""
+        if self.minor is None:
+            return Version(self.major + 1, 0, 0)
+        if self.patch is None:
+            return Version(self.major, self.minor + 1, 0)
+        return None  # fully specified: no x-range
+
+
+def _parse_partial(token):
+    """Parse a version token that may contain wildcards or missing positions."""
+    match = _PARTIAL.match(token)
+    if match:
+        parts = [p for p in match.groups() if p is not None]
+        values = []
+        wildcard_seen = False
+        for part in parts:
+            if part in _WILDCARDS:
+                wildcard_seen = True
+                values.append(None)
+            elif wildcard_seen:
+                raise ValueError(f"number after wildcard in version: {token!r}")
+            else:
+                values.append(int(part))
+        values += [None] * (3 - len(values))
+        if values[0] is None:
+            return _Partial(None, None, None)  # any version
+        return _Partial(*values)
+    version = Version.parse(token)  # raises ValueError if invalid
+    return _Partial(version.major, version.minor, version.patch, version.prerelease)
+
+
+def _comparator_bounds(op, token):
+    """Turn one comparator (operator + version token) into primitive bounds."""
+    partial = _parse_partial(token)
+    if partial.major is None:
+        # Any version. Strict comparisons against "any" can never match.
+        return [(_NEVER, None)] if op in ("<", ">") else []
+    full = partial.ceiling() is None
+    exact = partial.floor()
+    upper = partial.ceiling()
+
+    if op in ("", "="):
+        if full:
+            return [("=", exact)]
+        return [(">=", exact), ("<", upper)]
+    if op == ">":
+        return [(">", exact)] if full else [(">=", upper)]
+    if op == ">=":
+        return [(">=", exact)]
+    if op == "<":
+        return [("<", exact)]
+    if op == "<=":
+        return [("<=", exact)] if full else [("<", upper)]
+    raise ValueError(f"unknown operator: {op!r}")
+
+
+def _tilde_bounds(token):
+    partial = _parse_partial(token)
+    if partial.major is None:
+        return []
+    if partial.minor is None:
+        upper = Version(partial.major + 1, 0, 0)
+    else:
+        upper = Version(partial.major, partial.minor + 1, 0)
+    return [(">=", partial.floor()), ("<", upper)]
+
+
+def _caret_bounds(token):
+    partial = _parse_partial(token)
+    if partial.major is None:
+        return []
+    major, minor, patch = partial.major, partial.minor, partial.patch
+    if major > 0 or minor is None:
+        upper = Version(major + 1, 0, 0)
+    elif minor > 0 or patch is None:
+        upper = Version(0, minor + 1, 0)
+    else:
+        upper = Version(0, 0, patch + 1)
+    return [(">=", partial.floor()), ("<", upper)]
+
+
+def _hyphen_bounds(low_token, high_token):
+    low = _parse_partial(low_token)
+    high = _parse_partial(high_token)
+    bounds = []
+    if low.major is not None:
+        bounds.append((">=", low.floor()))
+    if high.major is None:
+        return bounds
+    if high.ceiling() is None:
+        bounds.append(("<=", high.floor()))
+    else:
+        bounds.append(("<", high.ceiling()))
+    return bounds
+
+
+def _compile_set(text):
+    """Compile one comparator set into (bounds, matches_everything)."""
+    tokens = text.split()
+    bounds = []
+    i = 0
+    while i < len(tokens):
+        token = tokens[i]
+        # Hyphen range: "A - B"
+        if i + 2 < len(tokens) and tokens[i + 1] == "-":
+            bounds += _hyphen_bounds(token, tokens[i + 2])
+            i += 3
+            continue
+        # Operator separated from its version by whitespace: ">= 1.2.3"
+        op = next((o for o in _OPERATORS if token.startswith(o)), "")
+        if op:
+            token = token[len(op):]
+            if not token:
+                if i + 1 >= len(tokens):
+                    raise ValueError(f"operator without version in range: {text!r}")
+                i += 1
+                token = tokens[i]
+            bounds += _comparator_bounds(op, token)
+        elif token.startswith("~"):
+            bounds += _tilde_bounds(token[1:])
+        elif token.startswith("^"):
+            bounds += _caret_bounds(token[1:])
+        else:
+            bounds += _comparator_bounds("", token)
+        i += 1
+    # A set whose comparators impose no bounds ("", "*", "x", ">=*") matches every version.
+    return bounds, not bounds
+
+
+def _compile(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"range must be a string: {range_!r}")
+    return [_compile_set(part) for part in range_.split("||")]
+
+
+def _bound_holds(version, op, bound):
+    if op == "=":
+        return version == bound
+    if op == ">":
+        return version > bound
+    if op == ">=":
+        return version >= bound
+    if op == "<":
+        return version < bound
+    if op == "<=":
+        return version <= bound
+    return False  # _NEVER
+
+
+def _set_matches(version, bounds, matches_everything):
+    if matches_everything:
+        return True
+    for op, bound in bounds:
+        if not _bound_holds(version, op, bound):
+            return False
+    # Prereleases only match when a comparator names the same major.minor.patch with a prerelease.
+    if version.prerelease:
+        return any(
+            bound is not None and bound.prerelease and bound.release == version.release
+            for _, bound in bounds
+        )
+    return True
+
+
+def _matches(version, compiled):
+    return any(_set_matches(version, bounds, everything) for bounds, everything in compiled)
+
+
+def _as_version(value):
+    if isinstance(value, Version):
+        return value
+    if not isinstance(value, str):
+        raise ValueError(f"invalid version: {value!r}")
+    return Version.parse(value)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    """Return True if ``version`` satisfies the npm-style ``range_``."""
+    compiled = _compile(range_)
+    return _matches(_as_version(version), compiled)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    """Return the highest of ``versions`` that satisfies ``range_``, as given, or None."""
+    compiled = _compile(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        version = _as_version(item)
+        if not _matches(version, compiled):
+            continue
+        if best_version is None or version > best_version:
+            best, best_version = item, version
+    return best
