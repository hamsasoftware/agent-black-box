@@ -0,0 +1,36 @@
+import os
+
+from .config import SECRET_KEYS, load_config
+
+DOTENV_PATH = ".env"
+
+
+def _display(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        # Never print secret material; the length is enough to spot truncation.
+        return f"<redacted, {len(value)} chars>"
+    return value
+
+
+def render(config, dotenv_path=DOTENV_PATH):
+    abs_path = os.path.abspath(dotenv_path)
+    found = "found" if os.path.exists(dotenv_path) else "not found"
+    lines = [
+        "payhook doctor",
+        f"dotenv file: {abs_path} ({found})",
+        "settings:",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append(f"  {key:<{width}} = {_display(key, value)}  [source: {source}]")
+    missing = [key for key, (value, _) in config.items() if value is None]
+    if missing:
+        lines.append("missing required settings: " + ", ".join(missing))
+    return "\n".join(lines)
+
+
+def doctor(dotenv_path=DOTENV_PATH):
+    print(render(load_config(dotenv_path=dotenv_path), dotenv_path=dotenv_path))
+    return 0
