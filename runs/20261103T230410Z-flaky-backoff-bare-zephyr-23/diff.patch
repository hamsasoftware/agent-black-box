@@ -0,0 +1,29 @@
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class MaxRng:
+    def uniform(self, a, b):
+        return b
+
+
+class CapPolicyTest(unittest.TestCase):
+    def test_never_exceeds_cap_with_jitter(self):
+        # 0.5 * 2**6 = 32 is below cap 34, but +10% jitter would give 35.2
+        for seed in range(2000):
+            r = Retrier(base=0.5, cap=34, max_attempts=10, rng=random.Random(seed))
+            for d in r.schedule():
+                self.assertLessEqual(d, 34)
+                self.assertGreaterEqual(d, 0)
+
+    def test_worst_case_jitter_is_clamped(self):
+        self.assertEqual(compute_delay(7, base=0.5, cap=34, rng=MaxRng()), 34)
+
+    def test_jitter_still_applied_below_cap(self):
+        self.assertAlmostEqual(compute_delay(1, base=1, cap=100, jitter=0.1, rng=MaxRng()), 1.1)
+
+
+if __name__ == "__main__":
+    unittest.main()
