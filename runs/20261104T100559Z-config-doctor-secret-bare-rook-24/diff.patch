 }
 
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+_EXPORT_PREFIX = re.compile(r"^export\s+")
+_INLINE_COMMENT = re.compile(r"\s#")
+
+
+def _parse_value(raw):
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        # Quoted: everything up to the matching quote is the value.
+        end = raw.find(raw[0], 1)
+        if end != -1:
+            return raw[1:end]
+    # Unquoted: a " #" starts a trailing comment.
+    match = _INLINE_COMMENT.search(raw)
+    return (raw[: match.start()] if match else raw).strip()
+
 
 def read_dotenv(path):
     values = {}
     if not os.path.exists(path):
         return values
-    with open(path, encoding="utf-8") as handle:
+    with open(path, encoding="utf-8-sig") as handle:
         for line in handle:
             line = line.strip()
             if not line or line.startswith("#"):
                 continue
-            key, value = line.split("=")
-            values[key] = value
+            line = _EXPORT_PREFIX.sub("", line)
+            key, sep, raw = line.partition("=")
+            key = key.strip()
+            if not sep or not key:
+                continue  # not a KEY=value line; ignore it
+            values[key] = _parse_value(raw)
     return values
 
 
