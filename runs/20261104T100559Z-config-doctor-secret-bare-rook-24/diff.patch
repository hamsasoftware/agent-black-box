@@ -0,0 +1,38 @@
+import os
+
+from .config import SECRET_KEYS, load_config
+
+SOURCE_LABELS = {"env": "environment", ".env": ".env", "default": "default"}
+
+
+def _display_value(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        # Never print secrets, not even partially: this output is pasted into tickets.
+        return f"<redacted, {len(value)} chars>"
+    return repr(value)
+
+
+def doctor_report(config, dotenv_path=".env"):
+    dotenv_abs = os.path.abspath(dotenv_path)
+    lines = [
+        "payhook doctor",
+        f"working directory: {os.getcwd()}",
+        f".env: {dotenv_abs} ({'found' if os.path.exists(dotenv_path) else 'not found'})",
+        "",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append(
+            f"{key.ljust(width)}  {_display_value(key, value)}  [{SOURCE_LABELS[source]}]"
+        )
+    missing = [key for key, (value, _) in config.items() if value is None]
+    lines.append("")
+    lines.append("required settings missing: " + ", ".join(missing) if missing else "required settings: ok")
+    return "\n".join(lines)
+
+
+def run_doctor(dotenv_path=".env"):
+    config = load_config(dotenv_path=dotenv_path)
+    return doctor_report(config, dotenv_path=dotenv_path)
