 from collections import Counter
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timezone
 
 
 @dataclass(frozen=True)
@@ -31,3 +31,15 @@ def read_events(path):
 
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
+
+
+def as_utc(ts):
+    """Normalise to an aware UTC datetime; naive timestamps (legacy collectors) are UTC."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def filter_since(events, since):
+    since = as_utc(since)
+    return (event for event in events if as_utc(event.ts) >= since)
diff --git a/tests/test_since.py b/tests/test_since.py
new file mode 100644
index 0000000..d70cb19
--- /dev/null
+++ b/tests/test_since.py
@@ -0,0 +1,49 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from evlog.cli import main
+
+TIMESTAMPS = ["2024-03-09T23:30:00-05:00", "2024-03-10T00:00:00", "2024-03-09T20:00:00-05:00"]
+
+
+class SinceTest(unittest.TestCase):
+    def setUp(self):
+        handle, self.path = tempfile.mkstemp(suffix=".jsonl")
+        with os.fdopen(handle, "w") as f:
+            for ts in TIMESTAMPS:
+                f.write(json.dumps({"ts": ts, "service": "a", "level": "x"}) + "\n")
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, *args):
+        out = io.StringIO()
+        main(["report", self.path, *args], out=out)
+        return out.getvalue().strip().splitlines()
+
+    def fail_cli(self, *args):
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err), self.assertRaises(SystemExit) as cm:
+            main(["report", *args])
+        self.assertEqual(cm.exception.code, 2)
+        self.assertNotIn("Traceback", err.getvalue())
+        return err.getvalue()
+
+    def test_boundary_is_utc_and_inclusive(self):
+        # 23:30-05:00 on 03-09 is 04:30 UTC on 03-10; 20:00-05:00 is 01:00 UTC.
+        self.assertEqual(self.run_cli("--since", "2024-03-10"), ["a x 3", "total 3"])
+        self.assertEqual(self.run_cli("--since", "2024-03-10T02:00:00"), ["a x 1", "total 1"])
+
+    def test_since_with_offset(self):
+        self.assertEqual(self.run_cli("--since", "2024-03-10T00:00:00+05:00"), ["a x 3", "total 3"])
+
+    def test_bad_since_is_clean_error(self):
+        for bad in ["yesterday", "2024-13-01", ""]:
+            self.assertIn("invalid date", self.fail_cli(self.path, "--since", bad))
+
+    def test_missing_file_is_clean_error(self):
+        self.assertIn("cannot read", self.fail_cli(self.path + ".nope"))
