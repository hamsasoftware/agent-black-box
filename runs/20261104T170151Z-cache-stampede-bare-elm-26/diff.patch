+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        owner = start_all([lambda: cache.get("a")])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        out = []
+        waiter = start_all([lambda: out.append(cache.get("a"))])
+        wait_until_blocked(cache, waiter)
+        release.set()
+        join_all(owner + waiter)
+        self.assertEqual(out, ["a"])
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 0)
+
+
+class StatsTest(unittest.TestCase):
+    def test_plain_and_extended_stats_have_the_documented_keys(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        self.assertEqual(set(cache.stats()), {"hits", "misses", "loads", "failures"})
+        self.assertEqual(
+            set(cache.stats(extended=True)),
+            {"hits", "misses", "loads", "failures", "evictions", "stale_served", "timeouts", "deadlocks"},
+        )
+
+    def test_hits_and_misses_are_exact_under_concurrency(self):
+        cache = TTLCache(lambda k: k, ttl=1000, clock=FakeClock())
+        cache.get("a")
+        barrier = threading.Barrier(8)
+
+        def work():
+            barrier.wait(JOIN_TIMEOUT)
+            for _ in range(200):
+                cache.get("a")
+
+        join_all(start_all([work] * 8))
+        stats = cache.stats()
+        self.assertEqual(stats["hits"], 1600)
+        self.assertEqual(stats["misses"], 1)
+        self.assertEqual(stats["loads"], 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
