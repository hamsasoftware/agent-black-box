+class DeadlockTest(unittest.TestCase):
+    def _run_two_calls(self, cache, first, second):
+        results = {}
+
+        def call(key):
+            try:
+                results[key] = cache.get(key)
+            except Exception as exc:  # noqa: BLE001
+                results[key] = exc
+
+        join_all(start_all([lambda: call(first), lambda: call(second)]))
+        return results
+
+    def test_two_threads_waiting_for_each_other_raise_deadlock_error(self):
+        a_running = threading.Event()
+        b_running = threading.Event()
+        cache = None
+
+        def loader(key):
