+    def test_deadlock_is_detected_even_with_timeout_zero(self):
+        # Thread Y owns B and is blocked waiting for A. Thread X owns A and then asks for B with timeout=0.
+        # The cycle is X -> B (owned by Y) -> A (owned by X), so X must get DeadlockError, not TimeoutError.
+        x_running = threading.Event()
+        go = threading.Event()
+        cache = None
+
+        def loader(key):
+            if key == "a":
+                x_running.set()
+                go.wait(JOIN_TIMEOUT)
+                return cache.get("b", timeout=0)
+            return cache.get("a")
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        results = {}
+
+        def call(key):
+            try:
+                results[key] = cache.get(key)
+            except Exception as exc:  # noqa: BLE001
+                results[key] = exc
+
+        x = start_all([lambda: call("a")])
+        self.assertTrue(x_running.wait(JOIN_TIMEOUT))
+        y = start_all([lambda: call("b")])
+        wait_until_blocked(cache, y)
+        go.set()
+        join_all(x + y)
+        self.assertIsInstance(results["a"], DeadlockError)
+        self.assertIsInstance(results["b"], DeadlockError)
+        stats = cache.stats(extended=True)
+        self.assertEqual(stats["deadlocks"], 1)
+        self.assertEqual(stats["timeouts"], 0)
+
+    def test_waiting_that_does_not_close_a_cycle_is_normal(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
