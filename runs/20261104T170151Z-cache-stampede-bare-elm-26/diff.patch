+import threading
+import time
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import DeadlockError, TTLCache
+
+JOIN_TIMEOUT = 10  # seconds; a thread still alive after this means the library hung
+
+
+def start_all(targets):
+    threads = [threading.Thread(target=t) for t in targets]
+    for t in threads:
+        t.start()
+    return threads
+
+
+def join_all(threads):
+    for t in threads:
+        t.join(JOIN_TIMEOUT)
+    for t in threads:
+        if t.is_alive():
+            raise AssertionError("a thread is still blocked: the cache hung")
+
+
+def wait_until_blocked(cache, threads):
+    """Test helper: returns once each thread is registered as waiting for a load (white-box, tests only)."""
+    end = time.monotonic() + JOIN_TIMEOUT
+    while True:
+        with cache._cond:
+            if all(t.ident in cache._waiting for t in threads):
+                return
+        if time.monotonic() > end:
+            raise AssertionError("threads never started waiting")
+        time.sleep(0.001)
+
+
+class ValidationTest(unittest.TestCase):
+    def test_bad_options_raise_value_error(self):
+        clock = FakeClock()
+        for kwargs in [
+            {"ttl": 0},
+            {"ttl": -1},
+            {"ttl": 1, "max_size": 0},
+            {"ttl": 1, "max_size": 1.5},
+            {"ttl": 1, "max_size": True},
+            {"ttl": 1, "stale_grace": 0},
+            {"ttl": 1, "stale_grace": -2},
+        ]:
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    TTLCache(lambda k: k, clock=clock, **kwargs)
+
+    def test_negative_timeout_raises_and_is_not_counted(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            cache.get("a", timeout=-1)
+        self.assertEqual(cache.stats(extended=True), {
+            "hits": 0, "misses": 0, "loads": 0, "failures": 0,
+            "evictions": 0, "stale_served": 0, "timeouts": 0, "deadlocks": 0,
+        })
+
+    def test_deadlock_error_is_a_runtime_error(self):
+        self.assertTrue(issubclass(DeadlockError, RuntimeError))
+
+
+class ClockTest(unittest.TestCase):
+    def test_exactly_ttl_old_is_expired(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: object(), ttl=10, clock=clock)
+        first = cache.get("a")
+        clock.advance(10)
+        self.assertIsNot(cache.get("a"), first)
+
+    def test_loaded_at_is_read_after_the_loader_returns(self):
+        clock = FakeClock()
+
+        def slow(key):
+            clock.advance(5)  # the loader itself takes 5 seconds
+            return key
+
+        cache = TTLCache(slow, ttl=10, clock=clock)
+        cache.get("a")  # loaded_at is 5, not 0
+        clock.advance(9)  # age 9: still valid
+        self.assertEqual(cache.get("a"), "a")
+        self.assertEqual(cache.stats()["loads"], 1)
+        clock.advance(1)  # age 10: expired
+        cache.get("a")
+        self.assertEqual(cache.stats()["loads"], 2)
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_misses_cause_one_load(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return "v"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        results = []
+        owner = start_all([lambda: results.append(cache.get("a"))])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = start_all([lambda: results.append(cache.get("a"))] * 6)
+        wait_until_blocked(cache, waiters)
+        release.set()
+        join_all(owner + waiters)
+        self.assertEqual(calls, ["a"])
+        self.assertEqual(results, ["v"] * 7)
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 7, "loads": 1, "failures": 0})
+
+    def test_expired_entry_with_many_readers_is_reloaded_once(self):
+        clock = FakeClock()
+        calls = []
+        lock = threading.Lock()
+
+        def loader(key):
+            with lock:
+                calls.append(key)
+                return len(calls)
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("a"), 1)
+        clock.advance(10)
+        barrier = threading.Barrier(8)
+        results = []
+
+        def work():
+            barrier.wait(JOIN_TIMEOUT)
+            results.append(cache.get("a"))
+
+        join_all(start_all([work] * 8))
+        self.assertEqual(results, [2] * 8)
+        self.assertEqual(len(calls), 2)
+
+    def test_falsy_values_are_stored(self):
+        for value in [None, 0, "", False]:
+            with self.subTest(value=value):
+                calls = []
+
+                def loader(key, value=value):
+                    calls.append(key)
+                    return value
+
+                cache = TTLCache(loader, ttl=10, clock=FakeClock())
+                self.assertIs(cache.get("a"), value)
+                self.assertIs(cache.get("a"), value)
+                self.assertEqual(len(calls), 1)
+
+
+class FailureTest(unittest.TestCase):
+    def test_waiters_receive_the_same_exception_object(self):
+        release = threading.Event()
+        started = threading.Event()
+        error = ValueError("boom")
+
+        def loader(key):
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise error
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        seen = []
+
+        def call():
+            try:
+                cache.get("a")
+            except ValueError as exc:
+                seen.append(exc)
+
+        owner = start_all([call])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = start_all([call] * 3)
+        wait_until_blocked(cache, waiters)
+        release.set()
+        join_all(owner + waiters)
+        self.assertEqual(len(seen), 4)
+        self.assertTrue(all(exc is error for exc in seen))
+        self.assertEqual(cache.stats()["failures"], 1)
+        self.assertEqual(cache.stats()["loads"], 1)
+
+
+class InvalidateTest(unittest.TestCase):
+    def test_invalidate_during_load_keeps_the_result(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return "v"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        out = []
+        t = start_all([lambda: out.append(cache.get("a"))])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        cache.invalidate("a")
+        release.set()
+        join_all(t)
+        self.assertEqual(out, ["v"])
+        self.assertEqual(cache.get("a"), "v")
+        self.assertEqual(len(calls), 1)
+
+    def test_invalidate_all_counts_expired_entries_and_is_not_an_eviction(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock)
+        cache.get("a")
+        cache.get("b")
+        clock.advance(100)
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.invalidate_all(), 2)
+        self.assertEqual(len(cache), 0)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+
+    def test_len_does_not_count_a_load_without_a_stored_entry(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        t = start_all([lambda: cache.get("a")])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        self.assertEqual(len(cache), 0)
+        release.set()
+        join_all(t)
+        self.assertEqual(len(cache), 1)
+
+
+class IndependenceTest(unittest.TestCase):
+    def test_slow_load_does_not_block_other_keys_or_stats(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            if key == "slow":
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        cache.get("fast")
+        t = start_all([lambda: cache.get("slow")])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        # None of these may wait for the slow load.
+        self.assertEqual(cache.get("fast"), "fast")
+        self.assertEqual(cache.get("other"), "other")
+        cache.invalidate("fast")
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.stats()["loads"], 3)
+        release.set()
+        join_all(t)
+
+    def test_loader_may_get_another_key(self):
+        cache = None
+
+        def loader(key):
+            if key == "a":
+                return ("a", cache.get("b"))
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        self.assertEqual(cache.get("a"), ("a", "b"))
+
+
+class RecursionTest(unittest.TestCase):
+    def test_same_key_from_own_loader_raises_runtime_error(self):
+        errors = []
+
+        def loader(key):
+            try:
+                cache.get(key)
+            except RuntimeError as exc:
+                errors.append(exc)
+                raise
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertIs(type(ctx.exception), RuntimeError)
+        self.assertIs(errors[0], ctx.exception)
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 0)
+
+    def test_chain_back_to_own_key_in_same_thread_raises(self):
+        def loader(key):
+            other = "b" if key == "a" else "a"
+            return cache.get(other)
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertIs(type(ctx.exception), RuntimeError)
+
+
+class TimeoutTest(unittest.TestCase):
+    def _blocked_cache(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return "v"
+
+        return TTLCache(loader, ttl=10, clock=FakeClock()), release, started, calls
+
+    def test_timeout_zero_raises_at_once_when_a_load_is_in_flight(self):
+        cache, release, started, calls = self._blocked_cache()
+        out = []
+        t = start_all([lambda: out.append(cache.get("a"))])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        with self.assertRaises(TimeoutError):
+            cache.get("a", timeout=0)
+        release.set()
+        join_all(t)
+        # The timed-out call did not disturb the load.
+        self.assertEqual(out, ["v"])
+        self.assertEqual(cache.get("a"), "v")
+        self.assertEqual(len(calls), 1)
+        stats = cache.stats(extended=True)
+        self.assertEqual(stats["timeouts"], 1)
+        self.assertEqual(stats["loads"], 1)
+        self.assertEqual(stats["misses"], 2)
+
+    def test_waiter_with_small_timeout_times_out_and_load_completes(self):
+        cache, release, started, calls = self._blocked_cache()
+        out = []
+        t = start_all([lambda: out.append(cache.get("a"))])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        with self.assertRaises(TimeoutError):
+            cache.get("a", timeout=0.05)
+        release.set()
+        join_all(t)
+        self.assertEqual(out, ["v"])
+        self.assertEqual(cache.stats(extended=True)["timeouts"], 1)
+
+    def test_timeout_does_not_limit_the_owner_or_hits(self):
+        cache = TTLCache(lambda k: "v", ttl=10, clock=FakeClock())
+        self.assertEqual(cache.get("a", timeout=0), "v")  # owner runs the loader, never times out
+        self.assertEqual(cache.get("a", timeout=0), "v")  # hit, never waits
+        self.assertEqual(cache.stats(extended=True)["timeouts"], 0)
+
+    def test_waiter_gets_result_when_load_finishes_within_timeout(self):
+        cache, release, started, calls = self._blocked_cache()
+        out = []
+        owner = start_all([lambda: out.append(cache.get("a"))])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiter = start_all([lambda: out.append(cache.get("a", timeout=JOIN_TIMEOUT))])
+        wait_until_blocked(cache, waiter)
+        release.set()
+        join_all(owner + waiter)
+        self.assertEqual(out, ["v", "v"])
+        self.assertEqual(cache.stats(extended=True)["timeouts"], 0)
+
+
+class StaleTest(unittest.TestCase):
+    def _cache(self, outcomes, clock, grace=5):
+        def loader(key):
+            outcome = outcomes.pop(0)
+            if isinstance(outcome, Exception):
+                raise outcome
+            return outcome
+
+        return TTLCache(loader, ttl=10, clock=clock, stale_grace=grace)
+
+    def test_failed_reload_serves_stale_value_inside_grace(self):
+        clock = FakeClock()
+        cache = self._cache(["old", ValueError("down")], clock)
+        self.assertEqual(cache.get("a"), "old")
+        clock.advance(12)  # expired, inside the grace period
+        self.assertEqual(cache.get("a"), "old")
+        stats = cache.stats(extended=True)
+        self.assertEqual(stats["stale_served"], 1)
+        self.assertEqual(stats["failures"], 1)
+        self.assertEqual(stats["loads"], 2)
+        self.assertEqual(stats["misses"], 2)
+
+    def test_stale_value_is_not_a_use_and_grace_ends(self):
+        clock = FakeClock()
+        cache = self._cache(["old", ValueError("down"), "new"], clock)
+        cache.get("a")
+        clock.advance(12)
+        self.assertEqual(cache.get("a"), "old")  # stale, the load failed
+        clock.advance(3)  # age 15 = ttl + grace: no longer stale
+        self.assertEqual(cache.get("a"), "new")
+
+    def test_failure_outside_grace_raises(self):
+        clock = FakeClock()
+        error = ValueError("down")
+        cache = self._cache(["old", error], clock)
+        cache.get("a")
+        clock.advance(15)  # exactly ttl + grace old: not stale
+        with self.assertRaises(ValueError) as ctx:
+            cache.get("a")
+        self.assertIs(ctx.exception, error)
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 0)
+
+    def test_no_stale_value_when_entry_was_invalidated_before_failure(self):
+        clock = FakeClock()
+        release = threading.Event()
+        started = threading.Event()
+        error = ValueError("down")
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            if len(calls) == 1:
+                return "old"
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise error
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("a")
+        clock.advance(12)
+        out = []
+
+        def call():
+            try:
+                out.append(cache.get("a"))
+            except ValueError as exc:
+                out.append(exc)
+
+        t = start_all([call])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        cache.invalidate("a")
+        release.set()
+        join_all(t)
+        self.assertIs(out[0], error)
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 0)
+
+    def test_waiters_of_a_failed_load_get_the_stale_value(self):
+        clock = FakeClock()
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            if len(calls) == 1:
+                return "old"
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise ValueError("down")
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("a")
+        clock.advance(12)
+        out = []
+
+        def call():
+            out.append(cache.get("a"))
+
+        owner = start_all([call])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = start_all([call] * 3)
+        wait_until_blocked(cache, waiters)
+        release.set()
+        join_all(owner + waiters)
+        self.assertEqual(out, ["old"] * 4)
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 4)
+        self.assertEqual(len(calls), 2)
+
