+class LRUTest(unittest.TestCase):
+    def test_least_recently_used_is_evicted(self):
+        cache = TTLCache(lambda k: k, ttl=100, clock=FakeClock(), max_size=2)
+        cache.get("a")
+        cache.get("b")
+        cache.get("a")  # use of a
+        cache.get("c")  # evicts b
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+        loads_before = cache.stats()["loads"]
+        cache.get("a")
+        self.assertEqual(cache.stats()["loads"], loads_before)  # a still stored
+        cache.get("b")
+        self.assertEqual(cache.stats()["loads"], loads_before + 1)  # b was evicted
+
+    def test_key_with_load_in_flight_is_not_evicted(self):
+        clock = FakeClock()
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            n = len(calls) + 1
+            calls.append(key)
+            if key == "a" and n == 2:
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return f"{key}:{n}"
+
+        cache = TTLCache(loader, ttl=10, clock=clock, max_size=1)
+        cache.get("a")  # a:1 stored
+        clock.advance(10)  # a is expired
+        refresh = start_all([lambda: cache.get("a")])
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        self.assertEqual(cache.get("c"), "c:3")  # c is stored, then evicted at once; a is protected
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+        release.set()
+        join_all(refresh)
+        self.assertEqual(cache.get("a"), "a:2")  # the refresh stored its value
+
+    def test_replacing_an_entry_does_not_grow_the_cache(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock, max_size=1)
+        cache.get("a")
+        clock.advance(10)
+        cache.get("a")
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+
