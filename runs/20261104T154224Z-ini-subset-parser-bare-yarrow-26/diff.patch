-"""Configuration parser.
-
-This module used to be a thin wrapper around the third-party package ``inilite``.
-"""
-import inilite
+"""Configuration parser for the format described in docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_WS = " \t"
+_BOM = chr(0xFEFF)
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_ENTRY_RE = re.compile(r"(" + _DOTTED + r")[ \t]*=(.*)", re.S)
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\](.*)", re.S)
+_HEX4_RE = re.compile(r"[0-9a-fA-F]{4}")
+
+_D = r"[0-9]+(?:_[0-9]+)*"
+_DEC_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_PREFIXED = (
+    (re.compile(r"[+-]?0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*"), 16),
+    (re.compile(r"[+-]?0[oO][0-7]+(?:_[0-7]+)*"), 8),
+    (re.compile(r"[+-]?0[bB][01]+(?:_[01]+)*"), 2),
+)
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:" + _D + r"\.(?:" + _D + r")?|\." + _D + r"|" + _D + r")"
+    r"(?:[eE][+-]?[0-9]+)?"
+)
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+
+
+class _ValueError(Exception):
+    """Internal: an error inside a value; reported at the key line."""
+
+
+def _convert(text):
+    low = text.lower()
+    if low == "true":
+        return True
+    if low == "false":
+        return False
+    if _DEC_RE.fullmatch(text):
+        return int(text.replace("_", ""), 10)
+    for regex, base in _PREFIXED:
+        if regex.fullmatch(text):
+            return int(text.replace("_", ""), base)
+    if _FLOAT_RE.fullmatch(text) and ("." in text or "e" in low):
+        return float(text.replace("_", ""))
+    return text
+
+
+def _strip_comment(line):
+    for i, ch in enumerate(line):
+        if ch in "#;" and (i == 0 or line[i - 1] in _WS):
+            return line[:i].rstrip(_WS)
+    return line.rstrip(_WS)
+
+
+def _only_comment(rest):
+    rest = rest.strip(_WS)
+    return rest == "" or rest[0] in "#;"
+
+
+def _parse_string(s, i):
+    """Parse a quoted string starting at s[i]; return (value, index after)."""
+    quote = s[i]
+    i += 1
+    if quote == "'":
+        j = i
+        while j < len(s) and s[j] not in "'\n":
+            j += 1
+        if j >= len(s) or s[j] == "\n":
+            raise _ValueError("unterminated string")
+        return s[i:j], j + 1
+    out = []
+    while True:
+        if i >= len(s) or s[i] == "\n":
+            raise _ValueError("unterminated string")
+        ch = s[i]
+        if ch == '"':
+            return "".join(out), i + 1
+        if ch != "\\":
+            out.append(ch)
+            i += 1
+            continue
+        i += 1
+        if i >= len(s) or s[i] == "\n":
+            raise _ValueError("unterminated string")
+        esc = s[i]
+        if esc == "u":
+            digits = s[i + 1:i + 5]
+            if not _HEX4_RE.fullmatch(digits):
+                raise _ValueError("invalid escape: \\u")
+            out.append(chr(int(digits, 16)))
+            i += 5
+        elif esc in _ESCAPES:
+            out.append(_ESCAPES[esc])
+            i += 1
+        else:
+            raise _ValueError("invalid escape: \\" + esc)
+
+
+def _parse_list(t):
+    n = len(t)
+
+    def skip(p):
+        while p < n:
+            if t[p] in " \t\n":
+                p += 1
+            elif t[p] in "#;" and (p == 0 or t[p - 1] in " \t\n"):
+                while p < n and t[p] != "\n":
+                    p += 1
+            else:
+                break
+        return p
+
+    def items(p):
+        # t[p] is just after '['; returns (list, index after the closing ']')
+        result = []
+        expect_item = True  # True at start or right after a comma
+        while True:
+            p = skip(p)
+            if p >= n:
+                raise _ValueError("unterminated list")
+            ch = t[p]
+            if ch == "]":
+                return result, p + 1
+            if ch == ",":
+                if expect_item:
+                    raise _ValueError("invalid list: empty item")
+                expect_item = True
+                p += 1
+                continue
+            if not expect_item:
+                raise _ValueError("invalid list: missing comma")
+            if ch in "\"'":
+                value, p = _parse_string(t, p)
+                result.append(value)
+            elif ch == "[":
+                value, p = items(p + 1)
+                result.append(value)
+            else:
+                q = p
+                while q < n and t[q] not in ",]\n" and not (
+                    t[q] in "#;" and t[q - 1] in " \t"
+                ):
+                    q += 1
+                token = t[p:q].strip(_WS)
+                if "[" in token:
+                    raise _ValueError("invalid list: '[' in item")
+                result.append(_convert(token))
+                p = q
+            expect_item = False
+
+    value, p = items(1)
+    p = skip(p)
+    if p < n:
+        raise _ValueError("invalid list: text after list")
+    return value
+
+
+def _parse_value(first, conts):
+    lines = [first] + conts
+    cleaned = [_strip_comment(line) for line in lines]
+    nonempty = [i for i, c in enumerate(cleaned) if c]
+    if not nonempty:
+        return ""
+    idx = nonempty[0]
+    head = cleaned[idx][0]
+    if head in "\"'":
+        value, end = _parse_string(lines[idx], 0)
+        if not _only_comment(lines[idx][end:]) or len(nonempty) > 1:
+            raise _ValueError("unexpected text after string")
+        return value
+    if head == "[":
+        return _parse_list("\n".join(lines[idx:]))
+    if len(nonempty) == 1:
+        return _convert(cleaned[idx])
+    return "\n".join(cleaned[i] for i in nonempty)
+
+
+class _State:
+    def __init__(self):
+        self.root = {}
+        self.sections = set()
+
+
+def _open_section(state, path, source, lineno):
+    if path in state.sections:
+        raise ParseError("duplicate section: " + ".".join(path), lineno, source)
+    node = state.root
+    for depth, part in enumerate(path):
+        child = node.get(part)
+        if child is None:
+            child = node[part] = {}
+        elif not isinstance(child, dict):
+            raise ParseError("key conflict: " + ".".join(path[:depth + 1]), lineno, source)
+        node = child
+    state.sections.add(path)
+
+
+def _store(state, path, value, source, lineno):
+    node = state.root
+    for depth, part in enumerate(path[:-1]):
+        child = node.get(part)
+        if child is None:
+            child = node[part] = {}
+        elif not isinstance(child, dict):
+            raise ParseError("key conflict: " + ".".join(path[:depth + 1]), lineno, source)
+        node = child
+    last = path[-1]
+    if last in node:
+        if isinstance(node[last], dict):
+            raise ParseError("key conflict: " + ".".join(path), lineno, source)
+        raise ParseError("duplicate key: " + ".".join(path), lineno, source)
+    node[last] = value
+
+
+def _parse_text(text, source, base_dir, state, stack):
+    if text.startswith(_BOM):
+        text = text[1:]
+    section = ()
+    pending = None  # [path, lineno, first, conts]
+    can_continue = False
+
+    def flush():
+        nonlocal pending
+        if pending is None:
+            return
+        path, lineno, first, conts = pending
+        pending = None
+        try:
+            value = _parse_value(first, conts)
+        except _ValueError as exc:
+            raise ParseError(str(exc), lineno, source) from None
+        _store(state, path, value, source, lineno)
+
+    for lineno, line in enumerate(re.split(r"\r\n|\r|\n", text), 1):
+        stripped = line.strip(_WS)
+        if not stripped or stripped[0] in "#;":
+            continue
+        if line[0] in _WS:
+            if not can_continue:
+                raise ParseError("continuation without a value", lineno, source)
+            pending[3].append(stripped)
+            continue
+        flush()
+        can_continue = False
+        if line[0] == "[":
+            m = _HEADER_RE.fullmatch(line)
+            if not m or not _only_comment(m.group(2)):
+                raise ParseError("invalid section header", lineno, source)
+            section = tuple(m.group(1).split("."))
+            _open_section(state, section, source, lineno)
+        elif line.startswith("@include") and not re.match(
+            r"[A-Za-z0-9_-]", line[8:9] or " "
+        ):
+            _include(line[8:], source, base_dir, state, stack, lineno)
+        else:
+            m = _ENTRY_RE.fullmatch(line)
+            if not m:
+                raise ParseError("invalid line", lineno, source)
+            pending = [section + tuple(m.group(1).split(".")), lineno,
+                       m.group(2).strip(_WS), []]
+            can_continue = True
+    flush()
+
+
+def _include(rest, source, base_dir, state, stack, lineno):
+    rest = rest.strip(_WS)
+    if not rest or rest[0] not in "\"'":
+        raise ParseError("invalid include", lineno, source)
+    try:
+        name, end = _parse_string(rest, 0)
+        if not _only_comment(rest[end:]):
+            raise _ValueError("unexpected text after string")
+    except _ValueError as exc:
+        raise ParseError(str(exc), lineno, source) from None
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    inc_source = os.path.normpath(os.path.join(base_dir, name))
+    real = os.path.realpath(inc_source)
+    if real in stack:
+        raise ParseError("include cycle: " + inc_source, lineno, source)
+    try:
+        with open(inc_source, encoding="utf-8", newline="") as handle:
+            inc_text = handle.read()
+    except (OSError, ValueError) as exc:
+        raise ParseError("cannot read include: %s (%s)" % (inc_source, exc),
+                         lineno, source) from None
+    _parse_text(inc_text, inc_source, os.path.dirname(inc_source), state,
+                stack + (real,))
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    state = _State()
+    _parse_text(text, source, base_dir, state, ())
+    return state.root
 
 
 def load(path):
-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    with open(path, encoding="utf-8", newline="") as handle:
+        text = handle.read()
+    state = _State()
+    _parse_text(text, path, os.path.dirname(path), state,
+                (os.path.realpath(path),))
+    return state.root
