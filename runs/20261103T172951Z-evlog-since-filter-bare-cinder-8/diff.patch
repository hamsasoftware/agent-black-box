+def parse_since(value):
+    try:
+        day = date.fromisoformat(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date {value!r}: expected YYYY-MM-DD, e.g. 2024-03-10")
+    # Start of that day in UTC, matching how naive timestamps are read.
+    return datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
 
 
