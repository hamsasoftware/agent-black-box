 from dataclasses import dataclass
+from datetime import datetime, timedelta, timezone
 
 
 @dataclass(frozen=True)
@@ -12,9 +13,83 @@ class Plan:
     prune: list
 
 
+def _check_aware(value, what):
+    if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() is None:
+        raise ValueError(f"{what} must be a timezone-aware datetime, got {value!r}")
+
+
+def _newer_key(snapshot):
+    # ADR-0001 "Ordering": later taken_at is newer; equal taken_at is broken by the greater id.
+    return (snapshot.taken_at, snapshot.id)
+
+
+def _bucket_date(taken_at, policy):
+    # ADR-0004 "Decision": convert to the fixed offset, subtract day_start_hour, take the date.
+    local = taken_at.astimezone(timezone(timedelta(minutes=policy.tz_offset_minutes)))
+    return (local - timedelta(hours=policy.day_start_hour)).date()
+
+
+# ADR-0001 bucket keys, with ADR-0003 weeks. Each key orders naturally (greatest = newest).
+_BUCKET_KEYS = {
+    "keep_daily": lambda d: d,
+    "keep_weekly": lambda d: d.isocalendar()[:2],
+    "keep_monthly": lambda d: (d.year, d.month),
+    "keep_yearly": lambda d: d.year,
+}
+
+
+def _newest_of_newest_buckets(keyed, count):
+    """Ids of the newest snapshot in each of the `count` newest buckets.
+
+    `keyed` is a list of (snapshot, bucket key) pairs, ordered newest snapshot first.
+    """
+    newest_in_bucket = {}
+    for snapshot, key in keyed:
+        newest_in_bucket.setdefault(key, snapshot.id)  # first hit per bucket is its newest
+    chosen = sorted(newest_in_bucket, reverse=True)[:count]
+    return {newest_in_bucket[key] for key in chosen}
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
     """
-    raise NotImplementedError
+    snaps = list(snapshots)
+    _check_aware(now, "now")
+    seen = set()
+    for snapshot in snaps:
+        _check_aware(snapshot.taken_at, f"taken_at of snapshot {snapshot.id!r}")
+        if snapshot.id in seen:
+            raise ValueError(f"duplicate snapshot id {snapshot.id!r}")
+        seen.add(snapshot.id)
+
+    ordered = sorted(snaps, key=_newer_key, reverse=True)
+
+    if not policy.has_rules:
+        return Plan(keep=[s.id for s in ordered], prune=[])
+
+    # ADR-0001 "Set-aside snapshots": always kept, not counted, never a bucket representative.
+    kept = set()
+    remaining = []
+    for snapshot in ordered:
+        if snapshot.tags & policy.protect_tags or snapshot.taken_at > now:
+            kept.add(snapshot.id)
+        else:
+            remaining.append(snapshot)
+
+    # ADR-0001 "keep_last": the N newest remaining snapshots.
+    if policy.keep_last:
+        kept.update(s.id for s in remaining[: policy.keep_last])
+
+    # ADR-0001 "Buckets": each rule is independent; a snapshot is kept if any rule keeps it.
+    dated = [(s, _bucket_date(s.taken_at, policy)) for s in remaining]
+    for rule, key_of in _BUCKET_KEYS.items():
+        count = getattr(policy, rule)
+        if count:
+            keyed = [(s, key_of(day)) for s, day in dated]
+            kept |= _newest_of_newest_buckets(keyed, count)
+
+    keep = [s.id for s in ordered if s.id in kept]
+    prune = [s.id for s in ordered if s.id not in kept]
+    return Plan(keep=keep, prune=prune)
