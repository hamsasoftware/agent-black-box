diff --git a/tests/test_migration.py b/tests/test_migration.py
new file mode 100644
index 0000000..a061598
--- /dev/null
+++ b/tests/test_migration.py
@@ -0,0 +1,101 @@
+import json
+import os
+import tempfile
+import unittest
+from decimal import Decimal
+
+from shipcalc import cache, export, reports, storage
+from shipcalc.format import format_weight
+from shipcalc.limits import check_total_kg
+from shipcalc.models import Item, Order
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+from shipcalc.validate import validate_item
+
+
+class UnitsTest(unittest.TestCase):
+    def test_rounding_half_even(self):
+        for raw, want in [("1.0005", "1.000"), ("1.0015", "1.002"), ("2.0025", "2.002"),
+                          ("1.00051", "1.001"), ("2", "2.000"), ("0.0004", "0.000")]:
+            self.assertEqual(normalize_kg(raw), want)
+
+    def test_invalid(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".",
+                    "1\n", "٣", 1500, 1.5, True, None, Decimal("1")]:
+            with self.assertRaises(WeightError) as ctx:
+                normalize_kg(bad)
+            self.assertEqual(str(ctx.exception), f"invalid weight: {bad!r}")
+
+    def test_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        for bad in [-1, True, 1.0, "1"]:
+            with self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+    def test_carrier_limit(self):
+        self.assertEqual(check_total_kg("2147483.647"), "2147483.647")
+        with self.assertRaises(WeightError):
+            check_total_kg("2147483.648")
+
+
+class ValidateTest(unittest.TestCase):
+    def test_weight_range_after_rounding(self):
+        def problems(w):
+            return validate_item({"sku": "A", "weight_kg": w, "qty": 1})
+
+        self.assertEqual(problems("1000.0004"), [])
+        self.assertEqual(problems("0.001"), [])
+        self.assertEqual(problems("0.0004"), ["weight_kg: out of range 0.001..1000.000"])
+        self.assertEqual(problems("1000.0006"), ["weight_kg: out of range 0.001..1000.000"])
+        self.assertTrue(problems("abc")[0].startswith("weight_kg:"))
+        self.assertTrue(problems(5)[0].startswith("weight_kg:"))
+        self.assertEqual(validate_item({"sku": "A", "weight_g": 5, "qty": 1}), ["weight_kg: missing"])
+
+
+class OtherTest(unittest.TestCase):
+    def setUp(self):
+        self.order = Order([Item("A", "0.350", 2), Item("B", "1.200")])
+
+    def test_export_stays_in_grams(self):
+        self.assertEqual(export.to_csv(self.order), "sku,weight_g,qty\nA,350,2\nB,1200,1\n")
+        payload = export.carrier_payload(self.order)
+        self.assertEqual(payload, {"weight_g": 1900, "parcels": 1})
+        self.assertIs(type(payload["weight_g"]), int)
+
+    def test_format_and_cache(self):
+        self.assertEqual(format_weight("12"), "12.000 kg")
+        self.assertEqual(cache.quote_key(self.order, "eu"), "quote:v2:eu:1.900:2")
+
