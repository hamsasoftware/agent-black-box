diff --git a/shipcalc/units.py b/shipcalc/units.py
index f69aa94..666cca3 100644
--- a/shipcalc/units.py
+++ b/shipcalc/units.py
@@ -1,8 +1,43 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are kilograms written as decimal strings with exactly
+three decimal places (for example "0.250"). Arithmetic uses integers (grams)."""
+import re
 
+_INPUT = re.compile(r"[0-9]+(?:\.[0-9]+)?")
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+
+class WeightError(ValueError):
+    """An invalid weight, or a total over the carrier limit."""
+
+
+def _invalid(value):
+    return WeightError(f"invalid weight: {value!r}")
+
+
+def kg_to_g(value):
+    """Normalise value (kg) and return the exact whole number of grams."""
+    if not isinstance(value, str) or not _INPUT.fullmatch(value):
+        raise _invalid(value)
+    whole, _, frac = value.partition(".")
+    try:
+        grams = int(whole) * 1000 + int(frac[:3].ljust(3, "0"))
+        rest = frac[3:]
+        if rest:
+            rest_val = int(rest)
+            half = 5 * 10 ** (len(rest) - 1)
+            if rest_val > half or (rest_val == half and grams % 2 == 1):
+                grams += 1
+    except ValueError:  # absurdly long digit strings
+        raise _invalid(value) from None
+    return grams
+
+
+def g_to_kg(grams):
+    """Return the canonical kg string for a non-negative int number of grams."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise _invalid(grams)
+    return f"{grams // 1000}.{grams % 1000:03d}"
+
+
+def normalize_kg(value):
+    """Return value in canonical form, rounding half to even, or raise WeightError."""
+    return g_to_kg(kg_to_g(value))
