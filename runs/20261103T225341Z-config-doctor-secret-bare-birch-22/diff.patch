index 0000000..c26b7b1
--- /dev/null
+++ b/tests/test_dotenv_and_doctor.py
@@ -0,0 +1,128 @@
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.config import load_config, parse_dotenv_line
+from payhook.doctor import doctor_report
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def write_env(text):
+    handle, path = tempfile.mkstemp(suffix=".env")
+    with os.fdopen(handle, "w", encoding="utf-8") as f:
+        f.write(text)
+    return path
+
+
+class DotenvParsingTest(unittest.TestCase):
+    def test_single_and_double_quotes_are_stripped(self):
+        self.assertEqual(parse_dotenv_line('A="x y"\n'), ("A", "x y"))
+        self.assertEqual(parse_dotenv_line("A='x y'\n"), ("A", "x y"))
+
+    def test_export_with_quotes_and_equals(self):
+        self.assertEqual(
+            parse_dotenv_line('export PAYHOOK_ENDPOINT="https://a.example/?r=eu&m=live"'),
+            ("PAYHOOK_ENDPOINT", "https://a.example/?r=eu&m=live"),
+        )
+
+    def test_double_quoted_escapes(self):
+        self.assertEqual(parse_dotenv_line(r'A="say \"hi\" \\ ok"'), ("A", 'say "hi" \\ ok'))
+
+    def test_single_quotes_are_literal(self):
+        self.assertEqual(parse_dotenv_line(r"A='a\nb'"), ("A", r"a\nb"))
+
+    def test_inline_comment_after_unquoted_value(self):
+        self.assertEqual(parse_dotenv_line("A=15 # seconds"), ("A", "15"))
+
+    def test_hash_inside_quotes_is_kept(self):
+        self.assertEqual(parse_dotenv_line('A="x # y" # note'), ("A", "x # y"))
+
+    def test_hash_without_leading_space_is_kept(self):
+        self.assertEqual(parse_dotenv_line("A=abc#def"), ("A", "abc#def"))
+
+    def test_empty_value(self):
+        self.assertEqual(parse_dotenv_line("A="), ("A", ""))
+        self.assertEqual(parse_dotenv_line('A=""'), ("A", ""))
+
+    def test_blank_comment_and_malformed_lines_are_skipped(self):
+        self.assertIsNone(parse_dotenv_line(""))
+        self.assertIsNone(parse_dotenv_line("   "))
+        self.assertIsNone(parse_dotenv_line("# A=1"))
+        self.assertIsNone(parse_dotenv_line("just some text"))
+        self.assertIsNone(parse_dotenv_line("bad key=1"))
+
+    def test_crlf_and_bom_file(self):
+        path = write_env("﻿export PAYHOOK_API_TOKEN='tok_crlf'\r\nPAYHOOK_TIMEOUT=\"2\"\r\n")
+        try:
+            config = load_config(environ={}, dotenv_path=path)
+        finally:
+            os.remove(path)
+        self.assertEqual(config["PAYHOOK_API_TOKEN"], ("tok_crlf", ".env"))
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("2", ".env"))
+
+    def test_repo_style_file_loads(self):
+        path = write_env(
+            '# Local settings\n'
+            'PAYHOOK_API_TOKEN="tok_1"\n'
+            "PAYHOOK_WEBHOOK_SECRET='whsec_2'\n"
+            "export PAYHOOK_ENDPOINT=https://api.payments.example/v2?region=eu&mode=live\n"
+            "PAYHOOK_TIMEOUT=15\n"
+        )
+        try:
+            config = load_config(environ={}, dotenv_path=path)
+        finally:
+            os.remove(path)
+        self.assertEqual(config["PAYHOOK_API_TOKEN"], ("tok_1", ".env"))
+        self.assertEqual(config["PAYHOOK_WEBHOOK_SECRET"], ("whsec_2", ".env"))
+        self.assertEqual(
+            config["PAYHOOK_ENDPOINT"],
+            ("https://api.payments.example/v2?region=eu&mode=live", ".env"),
+        )
+        self.assertEqual(config["PAYHOOK_TIMEOUT"], ("15", ".env"))
+
+
+class DoctorReportTest(unittest.TestCase):
+    def test_secrets_are_redacted_and_sources_shown(self):
+        path = write_env('PAYHOOK_API_TOKEN="sk_live_SECRETVALUE123"\nPAYHOOK_TIMEOUT=7\n')
+        try:
+            report = doctor_report(
+                environ={"PAYHOOK_WEBHOOK_SECRET": "whsec_ENVSECRET999"},
+                dotenv_path=path,
+            )
+        finally:
+            os.remove(path)
+        self.assertNotIn("SECRETVALUE123", report)
+        self.assertNotIn("ENVSECRET999", report)
+        self.assertIn("<redacted, 22 characters>", report)
+        self.assertNotIn("MISSING", report)  # both required secrets are set
+        self.assertIn("PAYHOOK_TIMEOUT", report)
+        timeout_line = [l for l in report.splitlines() if l.startswith("PAYHOOK_TIMEOUT")][0]
+        self.assertIn(".env", timeout_line)
+        webhook_line = [l for l in report.splitlines() if l.startswith("PAYHOOK_WEBHOOK_SECRET")][0]
+        self.assertIn("env", webhook_line)
+
+    def test_missing_dotenv_reported(self):
+        report = doctor_report(environ={}, dotenv_path=os.path.join(ROOT, "no-such-file.env"))
+        self.assertIn("not found", report)
+        self.assertIn("(not set)", report)
+        self.assertIn("MISSING (required)", report)
+
+    def test_cli_doctor_exit_zero_and_no_secret_in_output(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            with open(os.path.join(tmp, ".env"), "w", encoding="utf-8") as f:
+                f.write("PAYHOOK_API_TOKEN=sk_live_CLISECRET77\n")
+            result = subprocess.run(
+                [sys.executable, "-m", "payhook", "doctor"],
+                cwd=tmp, capture_output=True, text=True,
+                env={"PYTHONPATH": ROOT, "PATH": os.environ.get("PATH", "")},
+            )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn("CLISECRET77", result.stdout)
+        self.assertIn("<redacted, 19 characters>", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
