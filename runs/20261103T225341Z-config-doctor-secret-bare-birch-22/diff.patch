index 0000000..e98a2e6
--- /dev/null
+++ b/payhook/doctor.py
@@ -0,0 +1,51 @@
+import os
+
+from .config import DEFAULTS, load_config
+
+# Values that must never be printed in full, since doctor output is pasted into tickets.
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+REQUIRED_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+
+def _display_value(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        return "<redacted, %d characters>" % len(value)
+    return value
+
+
+def doctor_report(environ=None, dotenv_path=".env"):
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    dotenv_exists = os.path.exists(dotenv_path)
+    rows = []
+    for key in DEFAULTS:
+        value, source = config[key]
+        status = ""
+        if value is None and key in REQUIRED_KEYS:
+            status = "MISSING (required)"
+        rows.append((key, _display_value(key, value), source, status))
+
+    headers = ("setting", "effective value", "source", "status")
+    widths = [max(len(headers[i]), *(len(r[i]) for r in rows)) for i in range(4)]
+
+    def fmt(cols):
+        return "  ".join(c.ljust(widths[i]) for i, c in enumerate(cols)).rstrip()
+
+    lines = [
+        "payhook doctor",
+        "dotenv file: %s (%s)" % (
+            os.path.abspath(dotenv_path),
+            "found" if dotenv_exists else "not found",
+        ),
+        "",
+        fmt(headers),
+        fmt(tuple("-" * w for w in widths)),
+    ]
+    lines.extend(fmt(r) for r in rows)
+    lines.append("")
+    lines.append(
+        "secrets are redacted; sources: env = process environment, "
+        ".env = dotenv file, default = built-in default"
+    )
+    return "\n".join(lines)
diff --git a/tests/test_dotenv_and_doctor.py b/tests/test_dotenv_and_doctor.py
