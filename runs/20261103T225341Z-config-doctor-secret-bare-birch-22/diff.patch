 import os
+import re
 
 DEFAULTS = {
     "PAYHOOK_API_TOKEN": None,
@@ -8,18 +9,59 @@ DEFAULTS = {
     "PAYHOOK_REGION": "eu",
 }
 
+_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
+_EXPORT_RE = re.compile(r"^export\s+")
+
+
+def _parse_value(raw):
+    raw = raw.strip()
+    if raw[:1] in ("'", '"'):
+        quote = raw[0]
+        out = []
+        i = 1
+        while i < len(raw):
+            ch = raw[i]
+            if quote == '"' and ch == "\\" and i + 1 < len(raw) and raw[i + 1] in '"\\':
+                out.append(raw[i + 1])
+                i += 2
+                continue
+            if ch == quote:
+                # Anything after the closing quote (such as a comment) is ignored.
+                return "".join(out)
+            out.append(ch)
+            i += 1
+        # Unterminated quote: keep the text as written rather than guessing.
+        return raw
+    # Unquoted: a " #" starts an inline comment.
+    match = re.search(r"\s#", raw)
+    if match:
+        raw = raw[: match.start()]
+    return raw.strip()
+
+
+def parse_dotenv_line(line):
+    """Return (key, value) for an assignment line, or None for blanks, comments and malformed lines."""
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    line = _EXPORT_RE.sub("", line, count=1)
+    key, sep, raw_value = line.partition("=")
+    key = key.strip()
+    if not sep or not _KEY_RE.match(key):
+        return None
+    return key, _parse_value(raw_value)
+
 
 def read_dotenv(path):
     values = {}
     if not os.path.exists(path):
         return values
-    with open(path, encoding="utf-8") as handle:
+    with open(path, encoding="utf-8-sig") as handle:
         for line in handle:
-            line = line.strip()
-            if not line or line.startswith("#"):
-                continue
-            key, value = line.split("=")
-            values[key] = value
+            parsed = parse_dotenv_line(line)
+            if parsed is not None:
+                key, value = parsed
+                values[key] = value
     return values
 
 
