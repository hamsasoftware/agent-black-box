+# An HTML comment. The body may not contain "-->", so each match ends at the first close.
+COMMENT = re.compile(r"<!--(?:(?!-->).)*-->", re.DOTALL)
+
+# Placeholder left where a comment was removed, so the line it sat on can be tidied.
+_MARK = ""
 
 
 @dataclass
@@ -12,12 +18,29 @@ class Release:
     body: list = field(default_factory=list)
 
 
+def _strip_comments(text):
+    """Remove HTML comments, returning the remaining text as a list of lines.
+
+    Whitespace left at the end of a line by a removed comment is dropped.
+    """
+    text = text.replace("\r\n", "\n").replace("\r", "\n")
+    text = COMMENT.sub(_MARK, text)
+    lines = []
+    for line in text.split("\n"):
+        if _MARK in line:
+            line = line.replace(_MARK, "").rstrip()
+        lines.append(line)
+    return lines
+
+
