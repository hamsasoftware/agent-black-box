     current = None
-    for line in text.splitlines():
+    for line in _strip_comments(text):
         if line.startswith("## "):
             match = HEADING.match(line)
+            if match is None:
+                raise ValueError(f"malformed release heading: {line!r}")
             current = Release(match.group("version"), match.group("date"))
             releases.append(current)
         elif current is not None:
@@ -25,9 +48,31 @@ def parse_changelog(text):
     return releases
 
 
+def _tidy(lines):
+    """Collapse runs of blank lines to one and trim blank lines at both ends."""
+    out = []
+    for line in lines:
+        if line.strip() == "":
+            if out and out[-1] == "":
+                continue
+            out.append("")
+        else:
+            out.append(line)
+    while out and out[0] == "":
+        out.pop(0)
+    while out and out[-1] == "":
+        out.pop()
+    return out
+
+
 def render_release(text, version):
     for release in parse_changelog(text):
         if release.version == version:
-            body = "\n".join(release.body).strip()
-            return f"# {release.version} ({release.date})\n\n{body}\n"
+            title = f"# {release.version}"
+            if release.date:
+                title += f" ({release.date})"
+            body = _tidy(release.body)
+            if not body:
+                return title + "\n"
+            return f"{title}\n\n" + "\n".join(body) + "\n"
     raise LookupError(version)
