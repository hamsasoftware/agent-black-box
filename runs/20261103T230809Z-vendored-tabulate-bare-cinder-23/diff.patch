new file mode 100644
index 0000000..4c9a965
--- /dev/null
+++ b/tests/test_markdown_escape.py
@@ -0,0 +1,14 @@
+import unittest
+
+from stockreport.inventory import Item
+from stockreport.report import render
+
+
+class MarkdownEscapeTest(unittest.TestCase):
+    def test_pipe_in_name_is_escaped(self):
+        out = render([Item("X-1", "a|b", 1, 2.0)], "markdown")
+        self.assertIn("| a\\|b |", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
