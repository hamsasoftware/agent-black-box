diff --git a/stockreport/report.py b/stockreport/report.py
index 4084f70..f7ef1d5 100644
--- a/stockreport/report.py
+++ b/stockreport/report.py
@@ -3,8 +3,13 @@ from tabulate import tabulate
 HEADERS = ["SKU", "Name", "Qty", "Unit price"]
 
 
-def _rows(items):
-    return [[i.sku, i.name, i.qty, i.unit_price] for i in sorted(items, key=lambda i: i.sku)]
+def _rows(items, escape_pipes=False):
+    def cell(text):
+        # A literal "|" would end a GitHub markdown cell early, so escape it.
+        return text.replace("|", "\\|") if escape_pipes else text
+
+    return [[cell(i.sku), cell(i.name), i.qty, i.unit_price]
+            for i in sorted(items, key=lambda i: i.sku)]
 
 
 def total_value(items):
@@ -15,4 +20,8 @@ def render(items, fmt="text"):
     if fmt == "text":
         table = tabulate(_rows(items), headers=HEADERS, style="plain", number_format=".2f")
         return f"{table}\n\nTotal stock value: {total_value(items):.2f}"
+    if fmt == "markdown":
+        table = tabulate(_rows(items, escape_pipes=True), headers=HEADERS, style="pipe",
+                         align="llrr", number_format=".2f")
+        return f"{table}\n\n**Total stock value:** {total_value(items):.2f}"
     raise ValueError(f"unknown format {fmt!r}")
