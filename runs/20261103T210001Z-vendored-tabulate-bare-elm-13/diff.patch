+import os
+import tempfile
+import unittest
+
+from stockreport.inventory import load_csv
+from stockreport.report import render
+
+
+class MarkdownEscapeTest(unittest.TestCase):
+    def test_pipe_in_name_is_escaped(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "items.csv")
+            with open(path, "w", encoding="utf-8", newline="") as handle:
+                handle.write("sku,name,qty,unit_price\nX-1,Bolt | nut,2,1.5\n")
+            out = render(load_csv(path), "markdown")
+        self.assertIn("| X-1 | Bolt \\| nut |", out)
+        self.assertTrue(out.endswith("\n\n**Total stock value:** 3.00"))
+
+
+if __name__ == "__main__":
+    unittest.main()
