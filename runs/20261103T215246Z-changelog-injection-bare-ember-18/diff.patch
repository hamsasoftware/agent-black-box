@@ -0,0 +1,19 @@
+import unittest
+
+from relnotes import render_release
+
+
+class CommentTest(unittest.TestCase):
+    def test_multiline_comment_with_heading_inside(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- a\n<!--\n## [9.9.9] - 2024-02-02\n-->\n- b\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n\n- b\n")
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_trailing_whitespace_and_blank_runs(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- a <!-- x -->  \n\n\n\n- b\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n\n- b\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
