+"""Tests for the guarantees in docs/CONTRACT.md that tests/test_cache.py does not cover.
+
+Blocking is done with threading.Event. Timeouts are only used so that a broken library fails the test instead of
+hanging it. `wait_until` polls only inside the test, to observe counters; the library itself never polls.
+"""
+import threading
+import time
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import TTLCache
+
+TIMEOUT = 5
+
+
+def wait_until(predicate, timeout=TIMEOUT):
+    deadline = time.monotonic() + timeout
+    while not predicate():
+        if time.monotonic() > deadline:
+            raise AssertionError("condition not reached in time")
+        time.sleep(0.001)
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_misses_share_one_load(self):
+        gate = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            gate.wait(TIMEOUT)
+            return "value"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        n = 8
+        results = []
+        threads = [threading.Thread(target=lambda: results.append(cache.get("k"))) for _ in range(n)]
+        for t in threads:
+            t.start()
+        wait_until(lambda: cache.stats()["misses"] == n)  # every caller has arrived while the load is open
+        gate.set()
+        for t in threads:
+            t.join(TIMEOUT)
+        self.assertEqual(results, ["value"] * n)
+        self.assertEqual(calls, ["k"])
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": n, "loads": 1, "failures": 0})
+
+    def test_expired_entry_with_load_in_flight_waits_for_it(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            if len(calls) == 2:
+                gate.wait(TIMEOUT)
+            return f"v{len(calls)}"
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("k"), "v1")
+        clock.advance(10)  # now expired
+        second = []
+        t1 = threading.Thread(target=lambda: second.append(cache.get("k")))
+        t1.start()
+        wait_until(lambda: len(calls) == 2)
+        waiter_result = []
+        t2 = threading.Thread(target=lambda: waiter_result.append(cache.get("k")))
+        t2.start()
+        wait_until(lambda: cache.stats()["misses"] == 3)
+        gate.set()
+        t1.join(TIMEOUT)
+        t2.join(TIMEOUT)
+        self.assertEqual(second, ["v2"])
+        self.assertEqual(waiter_result, ["v2"])
+        self.assertEqual(len(calls), 2)
+
+
+class FailureTest(unittest.TestCase):
+    def test_waiters_receive_the_same_exception_object(self):
+        gate = threading.Event()
+        calls = []
+        error = RuntimeError("upstream down")
+
+        def loader(key):
+            calls.append(key)
+            gate.wait(TIMEOUT)
+            raise error
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        n = 5
+        raised = []
+        lock = threading.Lock()
+
+        def work():
+            try:
+                cache.get("k")
+            except RuntimeError as exc:
+                with lock:
+                    raised.append(exc)
+
+        threads = [threading.Thread(target=work) for _ in range(n)]
+        for t in threads:
+            t.start()
+        wait_until(lambda: cache.stats()["misses"] == n)
+        gate.set()
+        for t in threads:
+            t.join(TIMEOUT)
+        self.assertEqual(len(raised), n)
+        self.assertTrue(all(exc is error for exc in raised))
+        self.assertEqual(calls, ["k"])
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": n, "loads": 1, "failures": 1})
+
+    def test_base_exception_from_loader_does_not_leave_waiters_hanging(self):
+        cache = TTLCache(self._raise_interrupt, ttl=60, clock=FakeClock())
+        with self.assertRaises(KeyboardInterrupt):
+            cache.get("k")
+        # The failed load is gone; a new get starts a fresh load instead of blocking.
+        cache._loader = lambda key: "ok"
+        self.assertEqual(cache.get("k"), "ok")
+
+    @staticmethod
+    def _raise_interrupt(key):
+        raise KeyboardInterrupt()
+
+
+class RecursionTest(unittest.TestCase):
+    def test_loader_calling_get_for_its_own_key_raises_runtime_error(self):
+        cache = None
+
+        def loader(key):
+            return cache.get(key)  # programming error
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        with self.assertRaises(RuntimeError):
+            cache.get("a")
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 2, "loads": 1, "failures": 1})
+        cache._loader = lambda key: "fine"
+        self.assertEqual(cache.get("a"), "fine")
+
+
+class IndependenceTest(unittest.TestCase):
+    def test_slow_load_does_not_block_other_keys_or_stats(self):
+        gate = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            if key == "slow":
+                started.set()
+                gate.wait(TIMEOUT)
+            return key.upper()
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        slow_result = []
+        slow = threading.Thread(target=lambda: slow_result.append(cache.get("slow")))
+        slow.start()
+        self.assertTrue(started.wait(TIMEOUT))
+
+        others = {}
+
+        def other_calls():
+            others["miss"] = cache.get("fast")
+            others["hit"] = cache.get("fast")
+            cache.invalidate("fast")
+            others["stats"] = cache.stats()
+
+        helper = threading.Thread(target=other_calls)
+        helper.start()
+        helper.join(TIMEOUT)
+        self.assertFalse(helper.is_alive(), "other keys were blocked by a slow load")
+        self.assertEqual(others["miss"], "FAST")
+        self.assertEqual(others["hit"], "FAST")
+
+        gate.set()
+        slow.join(TIMEOUT)
+        self.assertEqual(slow_result, ["SLOW"])
+
+    def test_loader_may_call_get_for_another_key(self):
+        cache = None
+
+        def loader(key):
+            if key == "outer":
+                return "outer+" + cache.get("inner")
+            return "inner"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        self.assertEqual(cache.get("outer"), "outer+inner")
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 2, "loads": 2, "failures": 0})
+
+
+class InvalidateDuringLoadTest(unittest.TestCase):
+    def test_invalidate_does_not_cancel_the_load_result_is_stored(self):
+        gate = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            started.set()
+            gate.wait(TIMEOUT)
+            return "stored"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        result = []
+        t = threading.Thread(target=lambda: result.append(cache.get("k")))
+        t.start()
+        self.assertTrue(started.wait(TIMEOUT))
+        before = cache.stats()
+        cache.invalidate("k")
+        self.assertEqual(cache.stats(), before)  # invalidate does not change stats
+        gate.set()
+        t.join(TIMEOUT)
+        self.assertEqual(result, ["stored"])
+        self.assertEqual(cache.get("k"), "stored")
+        self.assertEqual(calls, ["k"])
+
+
+class ValueAndClockTest(unittest.TestCase):
+    def test_falsy_values_are_stored_and_served(self):
+        values = {"none": None, "zero": 0, "empty": "", "false": False}
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            return values[key]
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        for key, value in values.items():
+            self.assertIs(cache.get(key), value)
+            self.assertIs(cache.get(key), value)
+        self.assertEqual(sorted(calls), sorted(values))
+        self.assertEqual(cache.stats(), {"hits": 4, "misses": 4, "loads": 4, "failures": 0})
+
+    def test_loaded_at_is_read_after_the_loader_returns(self):
+        clock = FakeClock()
+
+        def slow_loader(key):
+            clock.advance(100)  # the load itself takes 100 seconds
+            return "v"
+
+        cache = TTLCache(slow_loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("k"), "v")
+        clock.advance(9)  # 9 seconds after the value was produced: still valid
+        calls = []
+        cache._loader = lambda key: calls.append(key) or "again"
+        self.assertEqual(cache.get("k"), "v")
+        self.assertEqual(calls, [])
+
+    def test_stats_has_exactly_the_documented_keys(self):
+        cache = TTLCache(lambda key: key, ttl=1, clock=FakeClock())
+        self.assertEqual(set(cache.stats()), {"hits", "misses", "loads", "failures"})
+
+
+if __name__ == "__main__":
+    unittest.main()
