@@ -0,0 +1,25 @@
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class MaxRng:
+    def uniform(self, a, b):
+        return b
+
+
+class CapTest(unittest.TestCase):
+    def test_cap_holds_with_worst_case_jitter(self):
+        for attempt in range(1, 12):
+            self.assertLessEqual(compute_delay(attempt, base=0.5, cap=34, rng=MaxRng()), 34)
+
+    def test_schedule_cap_many_seeds(self):
+        for seed in range(500):
+            r = Retrier(base=0.5, cap=34, max_attempts=10, rng=random.Random(seed))
+            self.assertTrue(all(0 <= d <= 34 for d in r.schedule()))
+
+    def test_jitter_still_applied_below_cap(self):
+        delays = {compute_delay(1, base=1, cap=100, rng=random.Random(s)) for s in range(20)}
+        self.assertGreater(len(delays), 1)
+        self.assertTrue(all(0.9 <= d <= 1.1 for d in delays))
