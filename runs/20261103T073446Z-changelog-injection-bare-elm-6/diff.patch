+# Release headings: "## [2.4.0] - 2024-05-02". The date is absent for "## [Unreleased]".
+HEADING = re.compile(
+    r"^## \[(?P<version>[^\]]+)\](?: - (?P<date>\d{4}-\d{2}-\d{2}))?\s*$"
+)
+
+# Maintainer comments, inline or spanning lines. Spaces or tabs before the
+# comment go with it, and so do trailing spaces when the comment ends its line.
+COMMENT = re.compile(r"[ \t]*<!--.*?-->(?:[ \t]*(?=\r?\n|\Z))?", re.DOTALL)
 
 
 @dataclass
@@ -12,12 +19,17 @@ class Release:
     body: list = field(default_factory=list)
 
 
+def strip_comments(text):
