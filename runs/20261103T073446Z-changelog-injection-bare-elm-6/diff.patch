+def _clean_body(lines):
+    out = []
+    for line in lines:
+        if line.strip() == "":
+            if out and out[-1] != "":
+                out.append("")
+        else:
+            out.append(line)
+    while out and out[-1] == "":
+        out.pop()
+    return "\n".join(out)
+
+
 def render_release(text, version):
