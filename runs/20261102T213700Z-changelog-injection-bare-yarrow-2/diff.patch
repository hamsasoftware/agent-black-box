+def clean_body(lines):
+    """Strip HTML comments and collapse blank lines."""
+    raw = "\n".join(lines)
+    # Replace each comment with a marker so we know which lines were touched.
+    marked = COMMENT.sub(MARK, raw)
+    out = []
+    for line in marked.split("\n"):
+        if MARK in line:
+            line = line.replace(MARK, "").rstrip()
+        if not line.strip():
+            if not out or out[-1] == "":
+                continue
+            line = ""
+        out.append(line)
+    return "\n".join(out).strip("\n")
