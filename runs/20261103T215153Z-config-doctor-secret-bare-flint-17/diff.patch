+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class DoctorMaskTest(unittest.TestCase):
+    def test_secrets_are_masked_and_source_shown(self):
+        env = dict(os.environ)
+        env.update(PYTHONPATH=ROOT, PAYHOOK_API_TOKEN="supersecrettoken1234")
+        env.pop("PAYHOOK_REGION", None)
+        with tempfile.TemporaryDirectory() as tmp:
+            result = subprocess.run(
+                [sys.executable, "-m", "payhook", "doctor"],
+                cwd=tmp, capture_output=True, text=True, env=env,
+            )
+        self.assertNotIn("supersecrettoken", result.stdout)
+        self.assertIn("****1234  [env]", result.stdout)
+        self.assertIn("PAYHOOK_REGION = eu  [default]", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
