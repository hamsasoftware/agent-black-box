--- a/payhook/config.py
+++ b/payhook/config.py
@@ -18,11 +18,31 @@ def read_dotenv(path):
             line = line.strip()
             if not line or line.startswith("#"):
                 continue
-            key, value = line.split("=")
+            if line.startswith("export ") or line.startswith("export\t"):
+                line = line[7:].lstrip()
+            if "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            key = key.strip()
+            value = value.strip()
+            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
+                value = value[1:-1]
             values[key] = value
     return values
 
 
+SECRETS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def mask(value):
+    """Mask a secret, keeping only a short hint of its tail."""
+    if not value:
+        return value
+    if len(value) <= 8:
+        return "****"
+    return "****" + value[-4:]
+
+
 def load_config(environ=None, dotenv_path=".env"):
     environ = os.environ if environ is None else environ
     dotenv = read_dotenv(dotenv_path)
