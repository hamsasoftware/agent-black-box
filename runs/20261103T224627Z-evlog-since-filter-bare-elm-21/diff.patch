 from collections import Counter
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timezone
 
 
 @dataclass(frozen=True)
@@ -31,3 +31,16 @@ def read_events(path):
 
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
+
+
+def as_utc(ts):
+    """Naive timestamps (legacy collectors) are UTC."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def since(events, cutoff):
+    """Keep events at or after cutoff (compared in UTC; naive cutoff is UTC)."""
+    cutoff = as_utc(cutoff)
+    return (event for event in events if as_utc(event.ts) >= cutoff)
