+"""Deterministic checks for the invariants in docs/RETRY.md.
+
+These use seeded or fixed random sources so they never depend on chance.
+"""
+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedRng:
+    """Stands in for random.Random and always returns the same uniform value."""
+
+    def __init__(self, value):
+        self.value = value
+
+    def uniform(self, low, high):
+        return low + (high - low) * self.value
+
+
+class RetryPolicyTest(unittest.TestCase):
+    def test_cap_holds_at_maximum_jitter(self):
+        # Factor 1 + jitter is the largest possible multiplier.
+        rng = _FixedRng(1.0)
+        for attempt in range(1, 12):
+            self.assertLessEqual(
+                compute_delay(attempt, base=0.5, cap=34, jitter=0.1, rng=rng), 34
+            )
+
+    def test_cap_holds_across_many_seeds(self):
+        # Regression for the case where jitter pushed a capped delay above cap.
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34, f"seed={seed} delay={delay}")
+                self.assertGreaterEqual(delay, 0)
+
+    def test_capped_delays_are_still_jittered(self):
+        # The policy makes jitter mandatory, so capped attempts must not all
+        # land on exactly `cap`; that would make clients retry in lockstep.
+        rng = random.Random(3)
+        capped = [
+            compute_delay(10, base=1, cap=5, jitter=0.1, rng=rng) for _ in range(50)
+        ]
+        self.assertTrue(all(4.5 <= d <= 5 for d in capped))
+        self.assertGreater(len(set(capped)), 1)
+
+    def test_delay_never_negative(self):
+        # jitter > 1 can make the raw factor negative; the clamp must floor it at 0.
+        self.assertEqual(compute_delay(1, base=0.5, jitter=1.5, rng=_FixedRng(0.0)), 0.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
