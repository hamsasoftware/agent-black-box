+class GramConversionTest(unittest.TestCase):
+    def test_g_to_kg(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(g_to_kg(0), "0.000")
+
+    def test_g_to_kg_rejects_other_types(self):
+        for bad in [-1, 1.0, "1250", True, None]:
+            with self.subTest(bad=bad), self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+    def test_kg_to_g(self):
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        self.assertIsInstance(kg_to_g("1.25"), int)
+        self.assertEqual(kg_to_g("1.0015"), 1002)
+
