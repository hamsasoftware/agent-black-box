+class ValidateTest(unittest.TestCase):
+    def test_weight_range_applies_after_rounding(self):
+        self.assertIn("weight_kg: out of range 0.001..1000.000",
+                      validate.validate_item({"sku": "A", "weight_kg": "0.0004", "qty": 1}))
+        self.assertEqual(validate.validate_item({"sku": "A", "weight_kg": "1000.0004", "qty": 1}), [])
+
+    def test_invalid_weight_is_a_problem(self):
+        problems = validate.validate_item({"sku": "A", "weight_kg": "1,5", "qty": 1})
+        self.assertEqual(problems, ["weight_kg: invalid weight: '1,5'"])
+
+    def test_weight_g_is_missing_weight_kg(self):
+        problems = validate.validate_item({"sku": "A", "weight_g": 500, "qty": 1})
+        self.assertIn("weight_kg: missing", problems)
