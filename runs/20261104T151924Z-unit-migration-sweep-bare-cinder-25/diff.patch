+class ReportsTest(unittest.TestCase):
+    def test_average_rounds_half_even(self):
+        # 0.001 + 0.002 = 0.003 kg over 2 units: 1.5 g rounds to 2 g (even)
+        order = Order([Item("A", "0.001"), Item("B", "0.002")])
+        self.assertEqual(reports.average_weight_kg(order), "0.002")
+        # 0.001 + 0.002 over 4 units (qty) -> 0.75 g rounds to 1 g
+        order = Order([Item("A", "0.001", 1), Item("B", "0.002", 3)])
+        self.assertEqual(reports.average_weight_kg(order), "0.002")
+
+    def test_average_empty(self):
+        self.assertEqual(reports.average_weight_kg(Order()), "0.000")
+
+    def test_bands_keep_thresholds(self):
+        order = Order([Item("L", "0.500"), Item("M", "0.501"), Item("M2", "2.000"), Item("H", "2.001")])
+        self.assertEqual(reports.weight_bands(order), {"light": 1, "medium": 2, "heavy": 1})
+
+    def test_heaviest_orders_numerically(self):
+        order = Order([Item("B", "10.000"), Item("A", "9.500"), Item("C", "10.000")])
+        self.assertEqual([i.sku for i in reports.heaviest(order)], ["B", "C", "A"])
+
