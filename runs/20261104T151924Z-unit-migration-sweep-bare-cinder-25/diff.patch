diff --git a/shipcalc/units.py b/shipcalc/units.py
index f69aa94..a8ac190 100644
--- a/shipcalc/units.py
+++ b/shipcalc/units.py
@@ -1,8 +1,40 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are kilograms: canonical decimal strings with exactly three decimal places.
 
+Arithmetic on weights is done with integers (whole grams, i.e. thousandths of a kilogram) or Decimal.
+"""
+import re
+from decimal import ROUND_HALF_EVEN, Decimal, localcontext
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+_INPUT = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+_THOUSANDTH = Decimal("0.001")
+
+
+class WeightError(ValueError):
+    """An invalid weight, or a total over the carrier limit."""
+
+
+def _invalid(value):
+    return WeightError(f"invalid weight: {value!r}")
+
+
+def normalize_kg(value):
+    """Return value as a canonical kilogram string, rounding to three places half to even."""
+    if not isinstance(value, str) or not _INPUT.fullmatch(value):
+        raise _invalid(value)
+    with localcontext() as ctx:
+        ctx.prec = len(value) + 10  # enough digits that quantize never overflows
+        rounded = Decimal(value).quantize(_THOUSANDTH, rounding=ROUND_HALF_EVEN)
+    return f"{rounded:.3f}"
+
+
+def kg_to_g(value):
+    """Return the exact whole number of grams in a weight."""
+    whole, fraction = normalize_kg(value).split(".")
+    return int(whole) * 1000 + int(fraction)
+
+
+def g_to_kg(grams):
+    """Return a non-negative whole number of grams as a canonical kilogram string."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise _invalid(grams)
+    return f"{grams // 1000}.{grams % 1000:03d}"
