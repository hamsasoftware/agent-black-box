+class StorageTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "order.json")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def _write(self, data):
+        with open(self.path, "w", encoding="utf-8") as handle:
+            json.dump(data, handle)
+
+    def test_save_writes_schema_2(self):
+        storage.save(Order([Item("A", "1.5", 2)]), self.path)
+        with open(self.path, encoding="utf-8") as handle:
+            data = json.load(handle)
+        self.assertEqual(data, {"schema": 2, "items": [{"sku": "A", "weight_kg": "1.500", "qty": 2}]})
+
+    def test_load_schema_1_converts_grams(self):
+        self._write({"schema": 1, "items": [{"sku": "A", "weight_g": 1250, "qty": 2}]})
+        order = storage.load(self.path)
+        self.assertEqual(order.items[0].weight_kg, "1.250")
+        self.assertEqual(order.items[0].qty, 2)
+
+    def test_load_schema_1_invalid_weight(self):
+        self._write({"schema": 1, "items": [{"sku": "A", "weight_g": -5}]})
+        with self.assertRaises(WeightError):
+            storage.load(self.path)
+
+    def test_load_schema_2_normalises(self):
+        self._write({"schema": 2, "items": [{"sku": "A", "weight_kg": "0.0015", "qty": 1}]})
+        self.assertEqual(storage.load(self.path).items[0].weight_kg, "0.002")
+
+    def test_unknown_schema(self):
+        self._write({"schema": 3, "items": []})
+        with self.assertRaises(ValueError):
+            storage.load(self.path)
+
