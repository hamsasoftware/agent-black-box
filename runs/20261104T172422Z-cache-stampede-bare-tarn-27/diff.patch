+import threading
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import DeadlockError, TTLCache
+
+JOIN_SECONDS = 10  # a test that hangs fails instead of blocking CI forever
+
+
+def run_in_thread(target):
+    """Run target in a thread; return (thread, box) where box['result'] or box['error'] is set after join."""
+    box = {}
+
+    def body():
+        try:
+            box["result"] = target()
+        except BaseException as exc:  # recorded for the test to inspect
+            box["error"] = exc
+
+    thread = threading.Thread(target=body)
+    thread.start()
+    return thread, box
+
+
+def join(thread):
+    thread.join(JOIN_SECONDS)
+    if thread.is_alive():
+        raise AssertionError("thread did not finish: a call is hanging")
+
+
+class ValidationTest(unittest.TestCase):
+    def test_bad_options_raise_value_error(self):
+        clock = FakeClock()
+        for kwargs in (
+            {"max_size": 0},
+            {"max_size": 1.5},
+            {"max_size": True},
+            {"stale_grace": 0},
+            {"stale_grace": -1},
+            {"stale_grace": "5"},
+        ):
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                TTLCache(lambda k: k, ttl=10, clock=clock, **kwargs)
+
+    def test_negative_timeout_raises_and_is_not_counted(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            cache.get("a", timeout=-1)
+        self.assertEqual(cache.stats(extended=True)["misses"], 0)
+
+    def test_deadlock_error_is_a_runtime_error(self):
+        self.assertTrue(issubclass(DeadlockError, RuntimeError))
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_gets_of_a_missing_key_load_once(self):
+        release = threading.Event()
+        calls = []
+
+        def slow(key):
+            calls.append(key)
+            release.wait(JOIN_SECONDS)
+            return "v"
+
+        cache = TTLCache(slow, ttl=60, clock=FakeClock())
+        threads = [run_in_thread(lambda: cache.get("k")) for _ in range(6)]
+        release.set()
+        for thread, _ in threads:
+            join(thread)
+        self.assertEqual(calls, ["k"])
+        self.assertEqual([box["result"] for _, box in threads], ["v"] * 6)
+        self.assertEqual(cache.stats()["loads"], 1)
+
+    def test_expired_value_is_not_served_while_a_refresh_runs(self):
+        clock = FakeClock()
+        release = threading.Event()
+        n = {"calls": 0}
+
+        def loader(key):
+            n["calls"] += 1
+            if n["calls"] == 2:
+                release.wait(JOIN_SECONDS)
+            return n["calls"]
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("k"), 1)
+        clock.advance(10)  # exactly ttl old: expired
+        refresh, refresh_box = run_in_thread(lambda: cache.get("k"))
+        other, other_box = run_in_thread(lambda: cache.get("k"))
+        release.set()
+        join(refresh)
+        join(other)
+        self.assertEqual(refresh_box["result"], 2)
+        self.assertEqual(other_box["result"], 2)
+        self.assertEqual(n["calls"], 2)
+
+    def test_failure_is_shared_and_the_same_object(self):
+        release = threading.Event()
+        error = ValueError("boom")
+
+        def failing(key):
+            release.wait(JOIN_SECONDS)
+            raise error
+
+        cache = TTLCache(failing, ttl=10, clock=FakeClock())
+        threads = [run_in_thread(lambda: cache.get("k")) for _ in range(4)]
+        release.set()
+        for thread, _ in threads:
+            join(thread)
+        for _, box in threads:
+            self.assertIs(box["error"], error)
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 4, "loads": 1, "failures": 1})
+
+    def test_loader_may_return_falsy_values(self):
+        for value in (None, 0, "", False):
+            with self.subTest(value=value):
+                calls = []
+                cache = TTLCache(lambda k: calls.append(k) or value, ttl=10, clock=FakeClock())
+                self.assertIs(cache.get("k"), value)
+                self.assertIs(cache.get("k"), value)
+                self.assertEqual(len(calls), 1)
+
+
+class RecursionTest(unittest.TestCase):
+    def test_get_of_own_key_from_loader_raises_runtime_error(self):
+        cache = None
+
+        def loader(key):
+            return cache.get(key)
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertNotIsInstance(ctx.exception, DeadlockError)
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 0)
+
+    def test_chain_back_to_the_same_thread_raises_runtime_error(self):
+        cache = None
+
+        def loader(key):
+            return cache.get("b" if key == "a" else "a")
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertNotIsInstance(ctx.exception, DeadlockError)
+
+
+class DeadlockTest(unittest.TestCase):
+    def test_cross_thread_cycle_raises_deadlock_error_instead_of_hanging(self):
+        a_running = threading.Event()
+        b_running = threading.Event()
+        cache = None
+
+        def loader(key):
+            if key == "a":
+                a_running.set()
+                b_running.wait(JOIN_SECONDS)
+                return cache.get("b")
+            b_running.set()
+            return cache.get("a")
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        thread_a, box_a = run_in_thread(lambda: cache.get("a"))
+        self.assertTrue(a_running.wait(JOIN_SECONDS))
+        thread_b, box_b = run_in_thread(lambda: cache.get("b"))
+        join(thread_a)
+        join(thread_b)
+        self.assertIsInstance(box_a.get("error"), DeadlockError)
+        self.assertIsInstance(box_b.get("error"), DeadlockError)
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 1)
+
+
+class TimeoutTest(unittest.TestCase):
+    def test_zero_timeout_raises_at_once_and_load_still_stores(self):
+        release = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            release.wait(JOIN_SECONDS)
+            return "v"
+
+        clock = FakeClock()
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        owner, owner_box = run_in_thread(lambda: cache.get("k"))
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0)
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0.01)
+        release.set()
+        join(owner)
+        self.assertEqual(owner_box["result"], "v")
+        self.assertEqual(cache.get("k"), "v")  # stored by the load that timed-out waiters did not cancel
+        self.assertEqual(calls, ["k"])
+        stats = cache.stats(extended=True)
+        self.assertEqual(stats["timeouts"], 2)
+        self.assertEqual(stats["misses"], 3)
+        self.assertEqual(stats["hits"], 1)
+
+    def test_timeout_does_not_limit_the_owner(self):
+        cache = TTLCache(lambda k: "v", ttl=10, clock=FakeClock())
+        self.assertEqual(cache.get("k", timeout=0), "v")
+
+
+class StaleTest(unittest.TestCase):
+    def test_failed_reload_serves_stale_value_within_grace(self):
+        clock = FakeClock()
+        outcomes = ["old", ValueError("down")]
+
+        def loader(key):
+            outcome = outcomes.pop(0)
+            if isinstance(outcome, Exception):
+                raise outcome
+            return outcome
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        self.assertEqual(cache.get("k"), "old")
+        clock.advance(12)  # stale: 10 <= age < 15
+        self.assertEqual(cache.get("k"), "old")
+        stats = cache.stats(extended=True)
+        self.assertEqual(stats["stale_served"], 1)
+        self.assertEqual(stats["failures"], 1)
+        self.assertEqual(stats["loads"], 2)
+        self.assertEqual(stats["misses"], 2)
+
+    def test_exception_is_raised_once_grace_has_ended(self):
+        clock = FakeClock()
+        outcomes = ["old", ValueError("down")]
+
+        def loader(key):
+            outcome = outcomes.pop(0)
+            if isinstance(outcome, Exception):
+                raise outcome
+            return outcome
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("k")
+        clock.advance(15)  # exactly ttl + grace old: not stale
+        with self.assertRaises(ValueError):
+            cache.get("k")
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 0)
+
+    def test_invalidated_entry_is_not_served_as_stale(self):
+        clock = FakeClock()
+        outcomes = ["old", ValueError("down")]
+
+        def loader(key):
+            outcome = outcomes.pop(0)
+            if isinstance(outcome, Exception):
+                raise outcome
+            return outcome
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("k")
+        clock.advance(12)
+        cache.invalidate("k")
+        with self.assertRaises(ValueError):
+            cache.get("k")
+
+
+class EvictionTest(unittest.TestCase):
+    def test_contract_example_protects_in_flight_key(self):
+        clock = FakeClock()
+        release = threading.Event()
+        versions = {"a": 1}
+
+        def loader(key):
+            if key == "a" and versions["a"] == 2:
+                release.wait(JOIN_SECONDS)
+            if key == "a":
+                return "a-" + str(versions["a"])
+            return "c"
+
+        cache = TTLCache(loader, ttl=10, clock=clock, max_size=1)
+        self.assertEqual(cache.get("a"), "a-1")
+        clock.advance(10)
+        versions["a"] = 2
+        refresh, refresh_box = run_in_thread(lambda: cache.get("a"))
+        self.assertEqual(cache.get("c"), "c")
+        self.assertEqual(len(cache), 1)
+        release.set()
+        join(refresh)
+        self.assertEqual(refresh_box["result"], "a-2")
+        self.assertEqual(cache.get("a"), "a-2")
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+
+    def test_least_recently_used_is_evicted_first(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=100, clock=clock, max_size=2)
+        cache.get("a")
+        cache.get("b")
+        cache.get("a")  # a is now more recent than b
+        cache.get("c")  # evicts b
+        self.assertEqual(len(cache), 2)
+        cache.get("a")
+        self.assertEqual(cache.stats(extended=True)["hits"], 2)
+
+
+class InvalidateTest(unittest.TestCase):
+    def test_invalidate_all_counts_expired_entries_and_is_not_an_eviction(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock)
+        cache.get("a")
+        cache.get("b")
+        clock.advance(20)
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.invalidate_all(), 2)
+        self.assertEqual(len(cache), 0)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+
+    def test_invalidate_during_load_still_stores_the_result(self):
+        release = threading.Event()
+
+        def loader(key):
+            release.wait(JOIN_SECONDS)
+            return "v"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        thread, box = run_in_thread(lambda: cache.get("k"))
+        cache.invalidate("k")
+        release.set()
+        join(thread)
+        self.assertEqual(box["result"], "v")
+        self.assertEqual(len(cache), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
