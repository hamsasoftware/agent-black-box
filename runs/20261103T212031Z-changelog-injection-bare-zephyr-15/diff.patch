diff --git a/tests/test_rules.py b/tests/test_rules.py
new file mode 100644
index 0000000..44658e8
--- /dev/null
+++ b/tests/test_rules.py
@@ -0,0 +1,81 @@
+import os
+import unittest
+
+from relnotes import parse_changelog, render_release
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class RuleTest(unittest.TestCase):
+    def test_unreleased_heading_has_no_date(self):
+        releases = parse_changelog("## [Unreleased]\n\n- Thing.\n")
+        self.assertEqual(len(releases), 1)
+        self.assertEqual(releases[0].version, "Unreleased")
+        self.assertIsNone(releases[0].date)
+        self.assertEqual(render_release("## [Unreleased]\n\n- Thing.\n", "Unreleased"), "# Unreleased\n\n- Thing.\n")
+
+    def test_multiline_comment_in_body_is_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.\n<!--\nnote\n-->\n- Two.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_inline_comment_leaves_no_trailing_whitespace(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.   <!-- x -->   \n"
+        out = render_release(text, "1.0.0")
+        for line in out.split("\n"):
+            self.assertEqual(line, line.rstrip())
+        self.assertIn("- One.\n", out)
+
+    def test_comment_containing_heading_is_not_a_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.\n<!--\n## [9.9.9] - 2030-01-01\n-->\n"
+        self.assertEqual([r.version for r in parse_changelog(text)], ["1.0.0"])
+
+    def test_blank_runs_collapse_and_edges_are_trimmed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- One.\n\n\n\n- Two.\n\n\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n\n- Two.\n")
+
+    def test_leading_indentation_of_body_is_kept(self):
+        text = "## [1.0.0] - 2024-01-01\n\n    indented code\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n    indented code\n")
+
+    def test_windows_line_endings(self):
+        text = "## [1.0.0] - 2024-01-01\r\n\r\n- One.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n")
+
+    def test_unknown_second_level_heading_does_not_leak_into_release(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- One.\n\n## Notes\n\n- Not a change.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- One.\n")
+
+    def test_missing_version_raises_lookup_error(self):
+        with self.assertRaises(LookupError):
+            render_release("## [Unreleased]\n", "2.4.0")
+
+
+class RealChangelogTest(unittest.TestCase):
+    def setUp(self):
+        with open(os.path.join(ROOT, "CHANGELOG.md"), encoding="utf-8") as handle:
+            self.text = handle.read()
+
+    def test_2_4_0_notes(self):
+        self.assertEqual(
+            render_release(self.text, "2.4.0"),
+            "# 2.4.0 (2024-05-02)\n\n"
+            "### Added\n"
+            "- Support for `## [Unreleased]` sections.\n"
+            "- `--output` flag for writing notes to a file.\n"
+            "\n"
+            "### Fixed\n"
+            "- Dates with single-digit days are parsed correctly.\n"
+            "\n"
+            "### Changed\n"
+            "- Minimum supported Python is now 3.10.\n",
+        )
+
+    def test_unreleased_notes_from_real_changelog(self):
+        self.assertEqual(
+            render_release(self.text, "Unreleased"),
+            "# Unreleased\n\n### Added\n- Export release notes as plain text.\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
