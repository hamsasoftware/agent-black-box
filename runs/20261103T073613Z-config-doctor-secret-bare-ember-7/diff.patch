+            values[key] = _unquote(value.strip())
     return values
 
 
+def redact(key, value):
+    """Return a display-safe form of a setting value."""
+    if value is None:
+        return "(unset)"
+    if key in SECRET_KEYS:
+        return f"<redacted, {len(value)} chars>"
+    return value
+
+
 def load_config(environ=None, dotenv_path=".env"):
