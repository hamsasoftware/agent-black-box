        "command": "cat > payhook/__main__.py <<'EOF'\nimport os\nimport sys\n\nfrom .config import DEFAULTS, load_config, redact\n\nDOTENV_PATH = \".env\"\n\n\ndef doctor_report(config, dotenv_path=DOTENV_PATH):\n    lines = [\"payhook configuration\"]\n    found = os.path.exists(dotenv_path)\n    lines.append(f\"dotenv: {os.path.abspath(dotenv_path)} ({'found' if found else 'not found'})\")\n    width = max(len(key) for key in config)\n    for key, (value, source) in config.items():\n        lines.append(f\"{key.ljust(width)} = {redact(key, value)}  [{source}]\")\n    return \"\\n\".join(lines)\n\n\ndef main(argv=None):\n    argv = sys.argv[1:] if argv is None else argv\n    if argv == [\"check\"]:\n        config = load_config()\n        missing = [k for k, (v, _) in config.items() if v is None]\n        print(\"missing: \" + \", \".join(missing) if missing else \"ok\")\n        return 1 if missing else 0\n    if argv == [\"doctor\"]:\n        print(doctor_report(load_config()))\n        return 0\n    print(\"usage: python -m payhook {check,doctor}\", file=sys.stderr)\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nEOF\nsed -i 's/^from .config import DEFAULTS, load_config, redact$/from .config import load_config, redact/' payhook/__main__.py\npython -m unittest 2>&1 | tail -4; echo \"--- doctor in repo:\"; python -m payhook doctor; echo \"exit=$?\"; echo \"--- check:\"; python -m payhook check; echo \"exit=$?\"",
