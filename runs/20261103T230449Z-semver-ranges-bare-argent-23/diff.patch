+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+class ContractTest(unittest.TestCase):
+    """Cases taken from docs/RANGES.md."""
+
+    def assertSatisfies(self, version, range_, expected):
+        self.assertIs(satisfies(version, range_), expected, f"{version} in {range_!r}")
+
+    def test_wildcards(self):
+        self.assertSatisfies("2.0.0", "*", True)
+        self.assertSatisfies("0.0.1", "", True)
+        self.assertSatisfies("1.2.3-alpha", "*", False)
+        self.assertSatisfies("1.9.9", "1.x", True)
+        self.assertSatisfies("2.0.0", "1", False)
+        self.assertSatisfies("1.2.9", "1.2.x", True)
+        self.assertSatisfies("1.3.0", "1.2", False)
+
+    def test_partial_with_operator(self):
+        self.assertSatisfies("2.0.0", ">1", True)
+        self.assertSatisfies("1.9.9", ">1", False)
+        self.assertSatisfies("1.3.0", ">1.2", True)
+        self.assertSatisfies("1.2.9", ">1.2", False)
+        self.assertSatisfies("1.2.0", ">=1.2", True)
+        self.assertSatisfies("1.1.9", "<1.2", True)
+        self.assertSatisfies("1.2.0", "<1.2", False)
+        self.assertSatisfies("1.9.9", "<=1", True)
+        self.assertSatisfies("2.0.0", "<=1", False)
+        self.assertSatisfies("1.3.0", "<=1.2", False)
+        self.assertSatisfies("1.2.9", "<=1.2", True)
+        self.assertSatisfies("1.2.0", "=1.2", True)
+        self.assertSatisfies("1.3.0", "=1.2", False)
+
+    def test_wildcard_with_operator_matches_nothing(self):
+        self.assertSatisfies("1.0.0", ">*", False)
+        self.assertSatisfies("1.0.0", "<*", False)
+        self.assertSatisfies("1.0.0", ">=*", True)
+
+    def test_hyphen_ranges(self):
+        self.assertSatisfies("2.3.9", "1.2.3 - 2.3", True)
+        self.assertSatisfies("2.4.0", "1.2.3 - 2.3", False)
+        self.assertSatisfies("1.2.2", "1.2.3 - 2.3", False)
+        self.assertSatisfies("2.9.9", "1.2.3 - 2", True)
+        self.assertSatisfies("3.0.0", "1.2.3 - 2", False)
+        self.assertSatisfies("1.2.3", "1.2.3 - 2", True)
+
+    def test_tilde_table(self):
+        self.assertSatisfies("1.2.9", "~1.2.3", True)
+        self.assertSatisfies("1.3.0", "~1.2.3", False)
+        self.assertSatisfies("1.2.0", "~1.2", True)
+        self.assertSatisfies("1.3.0", "~1.2", False)
+        self.assertSatisfies("1.9.9", "~1", True)
+        self.assertSatisfies("2.0.0", "~1", False)
+        self.assertSatisfies("1.2.3-beta.3", "~1.2.3-beta.2", True)
+        self.assertSatisfies("1.3.0-beta.1", "~1.2.3-beta.2", False)
+
+    def test_caret_table(self):
+        self.assertSatisfies("1.9.9", "^1.2.3", True)
+        self.assertSatisfies("2.0.0", "^1.2.3", False)
+        self.assertSatisfies("0.2.9", "^0.2.3", True)
+        self.assertSatisfies("0.3.0", "^0.2.3", False)
+        self.assertSatisfies("0.0.3", "^0.0.3", True)
+        self.assertSatisfies("0.0.4", "^0.0.3", False)
+        self.assertSatisfies("1.9.0", "^1.2", True)
+        self.assertSatisfies("1.9.0", "^1.2.x", True)
+        self.assertSatisfies("2.0.0", "^1.2.x", False)
+        self.assertSatisfies("0.2.5", "^0.2", True)
+        self.assertSatisfies("0.3.0", "^0.2", False)
+        self.assertSatisfies("0.0.9", "^0.0", True)
+        self.assertSatisfies("0.1.0", "^0.0", False)
+        self.assertSatisfies("0.0.9", "^0.0.x", True)
+        self.assertSatisfies("0.1.0", "^0.0.x", False)
+        self.assertSatisfies("1.5.0", "^1", True)
+        self.assertSatisfies("1.5.0", "^1.x", True)
+        self.assertSatisfies("0.9.0", "^0", True)
+        self.assertSatisfies("1.0.0", "^0", False)
+        self.assertSatisfies("0.9.0", "^0.x", True)
+        self.assertSatisfies("1.0.0", "^0.x", False)
+
+    def test_prerelease_rule(self):
+        self.assertSatisfies("2.0.0-rc.1", "^1.0.0", False)
+        self.assertSatisfies("1.5.0-beta", "^1.0.0", False)
+        self.assertSatisfies("1.0.0-beta", "^1.0.0", False)
+        self.assertSatisfies("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0", True)
+        self.assertSatisfies("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0", False)
+        self.assertSatisfies("1.2.3-alpha", "*", False)
+        self.assertSatisfies("1.2.3-alpha", "", False)
+        self.assertSatisfies("1.2.3-beta.1", ">1.2.3-beta", True)
+        self.assertSatisfies("1.2.4", ">1.2.3-beta", True)
+        self.assertSatisfies("1.2.3-alpha.0", "1.x || 1.2.3-alpha.0", True)
+        self.assertSatisfies("1.2.3-alpha.1", "1.x || 1.2.3-alpha.0", False)
+
+    def test_prerelease_only_applies_within_its_set(self):
+        # A prerelease is only allowed by a set that names its release; "1.x" names none.
+        self.assertSatisfies("1.2.3-alpha.7", "1.x || >=1.2.3-alpha.1 <1.3.0", True)
+        self.assertSatisfies("1.5.0-beta", "^1.0.0 || >=1.2.3-alpha.1", False)
+
+    def test_whitespace_v_prefix_and_build(self):
+        self.assertSatisfies("1.2.3", ">= 1.2.3", True)
+        self.assertSatisfies("v1.2.3", "^1.0.0", True)
+        self.assertSatisfies("1.2.3+build.9", "=1.2.3", True)
+        self.assertSatisfies("1.2.3", "^1.0.0+build.4", True)
+
+    def test_union_and_empty_sets(self):
+        self.assertSatisfies("1.0.0", "1 ||", True)
+        self.assertSatisfies("9.9.9", "1.x || >=2.4.0 <3", False)
+
+    def test_invalid_ranges(self):
+        for bad in [">=", "^", "1.x.3", "x.2", "1.2.3 -", "- 1.2.3", "1.2.3 - >=2", ">1.2.3-", ">1.2.3-beta+"]:
+            with self.subTest(range=bad):
+                with self.assertRaises(ValueError):
+                    satisfies("1.0.0", bad)
+
+    def test_invalid_versions(self):
+        for bad in ["1.0", "01.0.0", "1.2.3.4", "abc", ""]:
+            with self.subTest(version=bad):
+                with self.assertRaises(ValueError):
+                    satisfies(bad, "*")
+
+    def test_max_satisfying_returns_original_text(self):
+        self.assertEqual(max_satisfying(["v1.5.0", "1.4.0"], "^1"), "v1.5.0")
+        self.assertEqual(max_satisfying(["1.0.0-rc.1", "0.9.0"], "*"), "0.9.0")
+        self.assertEqual(max_satisfying(["1.0.0-rc.1", "1.0.0"], "*"), "1.0.0")
+        self.assertIsNone(max_satisfying([], "*"))
+
+    def test_max_satisfying_validates_every_version(self):
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bogus"], "*")
+
+    def test_max_satisfying_invalid_range(self):
+        with self.assertRaises(ValueError):
+            max_satisfying([], ">=")
+
+
+if __name__ == "__main__":
+    unittest.main()
