+"""npm-style version ranges. The contract lives in docs/RANGES.md."""
+
+import re
+from functools import lru_cache
+
 from .version import Version
 
+_NUM = r"(?:0|[1-9]\d*)"
+_PART = rf"(?:{_NUM}|[xX*])"
+_COMPARATOR = re.compile(
+    rf"^(<=|>=|<|>|=|~|\^)?v?({_PART})(?:\.({_PART}))?(?:\.({_PART}))?"
+    r"(?:-([0-9A-Za-z.-]+))?(?:\+([0-9A-Za-z.-]+))?$"
+)
+_OPERATOR_SPACING = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+
+
+class _Comparator:
+    """A parsed partial/full version with an optional operator.
+
+    vals holds the three numeric positions, None where missing or a wildcard.
+    k is the number of leading specified positions (0 for `*`).
+    """
+
+    __slots__ = ("op", "vals", "k", "floor", "named")
+
+    def __init__(self, op, vals, k, floor, named):
+        self.op = op
+        self.vals = vals
+        self.k = k
+        self.floor = floor  # full Version (keeps prerelease) or zero-filled partial
+        self.named = named  # Version with prerelease written in the comparator, or None
+
+
+def _parse_comparator(text):
+    match = _COMPARATOR.match(text)
+    if not match:
+        raise ValueError(f"invalid comparator: {text!r}")
+    op = match.group(1) or ""
+    raw = [match.group(2), match.group(3), match.group(4)]
+    pre, build = match.group(5), match.group(6)
+
+    vals = []
+    wild = False
+    for part in raw:
+        if part is None or part in ("x", "X", "*"):
+            wild = True
+            vals.append(None)
+        else:
+            if wild:
+                raise ValueError(f"number after wildcard in {text!r}")
+            vals.append(int(part))
+    k = sum(v is not None for v in vals)
+
+    named = None
+    if k == 3:
+        full = f"{vals[0]}.{vals[1]}.{vals[2]}"
+        if pre:
+            full += "-" + pre
+        if build:
+            full += "+" + build
+        floor = Version.parse(full)  # validates prerelease/build identifiers
+        if floor.prerelease:
+            named = floor
+    else:
+        if pre:
+            raise ValueError(f"prerelease needs a full version: {text!r}")
+        floor = _floor(vals)
+    return _Comparator(op, tuple(vals), k, floor, named)
+
+
+def _floor(vals):
+    return Version(*(0 if v is None else v for v in vals))
+
+
+def _ceil(vals, index):
+    """Version with position `index` incremented and everything after it zeroed."""
+    parts = [0 if v is None else v for v in vals]
+    parts[index] += 1
+    for i in range(index + 1, 3):
+        parts[i] = 0
+    return Version(*parts)
+
+
+def _caret_ceil(vals, k):
+    major, minor, patch = (0 if v is None else v for v in vals)
+    if major > 0 or k == 1:
+        return Version(major + 1, 0, 0)
+    if minor > 0 or k == 2:
+        return Version(0, minor + 1, 0)
+    return Version(0, 0, patch + 1)
+
+
+def _always(_version):
+    return True
+
+
+def _never(_version):
+    return False
+
+
+def _predicates_for(comp):
+    """Predicates for a single comparator (operator applied to a partial version)."""
+    op, vals, k = comp.op, comp.vals, comp.k
+    if k == 0:
+        if op in (">", "<"):
+            return [_never]
+        return [_always]
+
+    floor = comp.floor
+    last = k - 1
+
+    if op in ("", "="):
+        if k == 3:
+            return [lambda v: v == floor]
+        ceil = _ceil(vals, last)
+        return [lambda v: floor <= v < ceil]
+    if op == ">=":
+        return [lambda v: v >= floor]
+    if op == "<":
+        return [lambda v: v < floor]
+    if op == ">":
+        if k == 3:
+            return [lambda v: v > floor]
+        ceil = _ceil(vals, last)
+        return [lambda v: v >= ceil]
+    if op == "<=":
+        if k == 3:
+            return [lambda v: v <= floor]
+        ceil = _ceil(vals, last)
+        return [lambda v: v < ceil]
+    if op == "~":
+        ceil = _ceil(vals, min(k, 2) - 1)
+        return [lambda v: floor <= v < ceil]
+    if op == "^":
+        ceil = _caret_ceil(vals, k)
+        return [lambda v: floor <= v < ceil]
+    raise ValueError(f"unknown operator {op!r}")  # pragma: no cover
+
+
+def _hyphen_predicates(low, high):
+    lower = low.floor
+    preds = [lambda v: v >= lower]
+    if high.k == 3:
+        upper = high.floor
+        preds.append(lambda v: v <= upper)
+    elif high.k > 0:
+        upper = _ceil(high.vals, high.k - 1)
+        preds.append(lambda v: v < upper)
+    return preds
+
+
+class _CompiledSet:
+    __slots__ = ("predicates", "prerelease_releases")
+
+    def __init__(self, predicates, prerelease_releases):
+        self.predicates = predicates
+        self.prerelease_releases = prerelease_releases
+
+    def matches(self, version):
+        if version.prerelease and version.release not in self.prerelease_releases:
+            return False
+        return all(p(version) for p in self.predicates)
+
+
+def _compile_set(text):
+    tokens = _OPERATOR_SPACING.sub(r"\1", text.strip()).split()
+    predicates = []
+    named = []
+    i = 0
+    while i < len(tokens):
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range in {text!r}")
+            low = _parse_comparator(tokens[i])
+            high = _parse_comparator(tokens[i + 2])
+            if low.op or high.op:
+                raise ValueError(f"operator in hyphen range: {text!r}")
+            predicates.extend(_hyphen_predicates(low, high))
+            named.extend(c.named for c in (low, high) if c.named is not None)
+            i += 3
+        else:
+            comp = _parse_comparator(tokens[i])
+            predicates.extend(_predicates_for(comp))
+            if comp.named is not None:
+                named.append(comp.named)
+            i += 1
+    releases = frozenset(v.release for v in named)
+    return _CompiledSet(predicates, releases)
+
+
+@lru_cache(maxsize=512)
+def _compile(range_):
+    return tuple(_compile_set(part) for part in range_.split("||"))
+
+
+def _coerce_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _coerce_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    return _compile(range_)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    """True if `version` satisfies the npm-style `range_`."""
+    compiled = _coerce_range(range_)
+    parsed = _coerce_version(version)
+    return any(cset.matches(parsed) for cset in compiled)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    """Highest version in `versions` satisfying `range_`, as given, or None."""
+    compiled = _coerce_range(range_)
+    best = None
+    best_parsed = None
+    for original in versions:
+        parsed = _coerce_version(original)
+        if best_parsed is not None and not best_parsed < parsed:
+            continue
+        if any(cset.matches(parsed) for cset in compiled):
+            best = original
+            best_parsed = parsed
+    return best
