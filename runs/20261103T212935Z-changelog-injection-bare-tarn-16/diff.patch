@@ -0,0 +1,94 @@
+import unittest
+
+from relnotes import parse_changelog, render_release
+from relnotes.changelog import strip_comments
+
+
+class UnreleasedHeadingTest(unittest.TestCase):
+    def test_undated_heading_parses(self):
+        releases = parse_changelog("## [Unreleased]\n\n- Thing.\n")
+        self.assertEqual(len(releases), 1)
+        self.assertEqual(releases[0].version, "Unreleased")
+        self.assertIsNone(releases[0].date)
+
+    def test_unreleased_renders_without_date(self):
+        text = "## [Unreleased]\n\n### Added\n- Thing.\n"
+        self.assertEqual(render_release(text, "Unreleased"), "# Unreleased\n\n### Added\n- Thing.\n")
+
+    def test_non_release_h2_is_body_text(self):
+        text = "## [1.0.0] - 2024-01-01\n\n## Notes\n- Thing.\n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n## Notes\n- Thing.\n",
+        )
+
+
+class CommentTest(unittest.TestCase):
+    def test_inline_comment_keeps_surrounding_text(self):
+        self.assertEqual(strip_comments("a <!-- x --> b\n"), "a  b\n")
+
+    def test_trailing_whitespace_after_removed_comment_is_dropped(self):
+        self.assertEqual(strip_comments("- A bug.   <!-- issue 7 -->  \n"), "- A bug.\n")
+
+    def test_comment_only_line_becomes_blank(self):
+        self.assertEqual(strip_comments("x\n   <!-- note -->\ny\n"), "x\n\ny\n")
+
+    def test_multiline_comment_removed(self):
+        self.assertEqual(strip_comments("a\n<!--\nsecret\n-->\nb\n"), "a\n\nb\n")
+
+    def test_adjacent_comments_on_one_line(self):
+        self.assertEqual(strip_comments("a <!-- x --> <!-- y -->\nb\n"), "a\nb\n")
+
+    def test_comment_hiding_a_heading_is_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n<!--\n## [9.9.9] - 2030-01-01\n-->\n- Thing.\n"
+        self.assertEqual(
+            render_release(text, "1.0.0"),
+            "# 1.0.0 (2024-01-01)\n\n- Thing.\n",
+        )
+        with self.assertRaises(LookupError):
+            render_release(text, "9.9.9")
+
+    def test_unclosed_comment_is_left_as_text(self):
+        self.assertEqual(strip_comments("a <!-- b\n"), "a <!-- b\n")
+
+
+class BlankLineTest(unittest.TestCase):
+    def test_blank_runs_collapse(self):
+        text = "## [1.0.0] - 2024-01-01\n\n- A.\n\n\n\n- B.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_whitespace_only_lines_count_as_blank(self):
+        text = "## [1.0.0] - 2024-01-01\n   \n- A.\n \t \n\n- B.\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+    def test_leading_and_trailing_blank_lines_removed(self):
+        text = "## [1.0.0] - 2024-01-01\n\n\n- A.\n\n\n## [0.9.0] - 2023-01-01\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n")
+
+    def test_indentation_of_first_line_is_kept(self):
+        text = "## [1.0.0] - 2024-01-01\n\n    code block\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n    code block\n")
+
+    def test_empty_body(self):
+        text = "## [1.0.0] - 2024-01-01\n\n## [0.9.0] - 2023-01-01\n- x\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n")
+
+
+class LineEndingTest(unittest.TestCase):
+    def test_crlf_input(self):
+        text = "## [1.0.0] - 2024-01-01\r\n\r\n- A. <!-- c -->\r\n\r\n- B.\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- A.\n\n- B.\n")
+
+
+class LookupTest(unittest.TestCase):
+    def test_missing_version_raises(self):
+        with self.assertRaises(LookupError):
+            render_release("## [1.0.0] - 2024-01-01\n- x\n", "2.0.0")
+
+    def test_unreleased_missing_raises(self):
+        with self.assertRaises(LookupError):
+            render_release("## [1.0.0] - 2024-01-01\n- x\n", "Unreleased")
+
+
+if __name__ == "__main__":
+    unittest.main()
