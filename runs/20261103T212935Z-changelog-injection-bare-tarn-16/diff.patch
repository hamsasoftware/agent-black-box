+def strip_comments(text):
+    """Remove HTML comments (`<!-- ... -->`, possibly spanning lines).
+
+    Whitespace that a removed comment leaves at the end of its line is dropped.
+    An unclosed `<!--` is left as ordinary text.
+    """
+    out = []
+    flagged = False  # a comment was removed on the current output line
+    i = 0
+    while i < len(text):
+        if text.startswith("<!--", i):
+            end = text.find("-->", i + 4)
+            if end != -1:
+                i = end + 3
+                flagged = True
+                continue
+        ch = text[i]
+        if ch == "\n":
+            if flagged:
+                while out and out[-1] in " \t\r":
+                    out.pop()
+            flagged = False
+        out.append(ch)
+        i += 1
+    if flagged:
+        while out and out[-1] in " \t\r":
+            out.pop()
+    return "".join(out)
+
+
+def _trim_blank_lines(lines):
+    """Collapse runs of blank lines to one, and drop leading/trailing ones."""
+    result = []
+    for line in lines:
+        if line.strip() == "":
+            if result and result[-1] != "":
+                result.append("")
+        else:
+            result.append(line)
+    while result and result[-1] == "":
+        result.pop()
+    while result and result[0] == "":
+        result.pop(0)
+    return result
+
+
 def parse_changelog(text):
     releases = []
     current = None
-    for line in text.splitlines():
-        if line.startswith("## "):
-            match = HEADING.match(line)
+    for line in re.split(r"\r?\n", strip_comments(text)):
+        match = HEADING.match(line)
+        if match:
             current = Release(match.group("version"), match.group("date"))
             releases.append(current)
         elif current is not None:
@@ -28,6 +78,11 @@ def parse_changelog(text):
 def render_release(text, version):
     for release in parse_changelog(text):
         if release.version == version:
-            body = "\n".join(release.body).strip()
-            return f"# {release.version} ({release.date})\n\n{body}\n"
+            title = f"# {release.version}"
+            if release.date:
+                title += f" ({release.date})"
+            body = _trim_blank_lines(release.body)
+            if not body:
+                return title + "\n"
+            return title + "\n\n" + "\n".join(body) + "\n"
