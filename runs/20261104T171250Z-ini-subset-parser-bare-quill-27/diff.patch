-"""Configuration parser.
-
-This module used to be a thin wrapper around the third-party package ``inilite``.
-"""
-import inilite
+"""Parser for the confkit configuration format. The contract is docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = rf"{_NAME}(?:\.{_NAME})*"
+_KEY_RE = re.compile(rf"({_DOTTED})[ \t]*=(.*)")
+_HEADER_RE = re.compile(rf"\[[ \t]*({_DOTTED})[ \t]*\](?:[ \t]+[#;].*|[ \t]*)")
+_NAME_CHAR_RE = re.compile(r"[A-Za-z0-9_-]")
+_LINE_SPLIT_RE = re.compile(r"\r\n|\r|\n")
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX4_RE = re.compile(r"[0-9A-Fa-f]{4}")
+
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_BASED_INT_RES = (
+    (re.compile(r"([+-]?)0[xX]([0-9a-fA-F](?:_?[0-9a-fA-F])*)"), 16),
+    (re.compile(r"([+-]?)0[oO]([0-7](?:_?[0-7])*)"), 8),
+    (re.compile(r"([+-]?)0[bB]([01](?:_?[01])*)"), 2),
+)
+_FLOAT_RE = re.compile(
+    rf"[+-]?(?:(?:{_DIGITS}\.(?:{_DIGITS})?|\.{_DIGITS})(?:[eE][+-]?[0-9]+)?"
+    rf"|{_DIGITS}[eE][+-]?[0-9]+)"
+)
+_BOOL_RE = re.compile(r"true|false", re.IGNORECASE)
+
+
+class _Bad(Exception):
+    """A value-level error; the caller attaches the line number of the key."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    """Parse configuration text into a nested dict."""
+    return _Loader().run(text, base_dir, source)
 
 
 def load(path):
-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    """Read and parse the UTF-8 file at ``path``."""
+    with open(path, encoding="utf-8", newline="") as handle:
+        text = handle.read()
+    loader = _Loader()
+    loader.stack.append(os.path.realpath(path))
+    return loader.run(text, os.path.dirname(path), path)
+
+
+class _Loader:
+    def __init__(self):
+        self.root = {}
+        self.defined = set()  # full section names seen so far, across includes
+        self.stack = []  # real paths of the files being parsed (for cycles)
+
+    def run(self, text, base_dir, source):
+        self._parse_text(text, base_dir, source)
+        return self.root
+
+    def _parse_text(self, text, base_dir, source):
+        if text.startswith("﻿"):
+            text = text[1:]
+        lines = _LINE_SPLIT_RE.split(text)
+        section = []
+        i = 0
+        while i < len(lines):
+            line = lines[i]
+            lineno = i + 1
+            stripped = line.strip(" \t")
+            if not stripped or stripped[0] in "#;":
+                i += 1
+                continue
+            if line[0] in " \t":
+                raise ParseError("continuation without a value", lineno, source)
+            if line[0] == "[":
+                section = self._header(line, lineno, source)
+                i += 1
+                continue
+            if line[0] == "@":
+                self._directive(line, lineno, source, base_dir)
+                i += 1
+                continue
+            match = _KEY_RE.match(line)
+            if not match:
+                raise ParseError("invalid line", lineno, source)
+            cont, j = _gather_continuation(lines, i + 1)
+            try:
+                value = _parse_value(match.group(2), cont)
+            except _Bad as exc:
+                raise ParseError(exc.message, lineno, source) from None
+            path = match.group(1).split(".")
+            self._store(section + path[:-1], path[-1], value, lineno, source)
+            i = j
+
+    def _walk(self, path, lineno, source):
+        """Return the table at ``path``, creating missing tables on the way."""
+        node = self.root
+        for depth, name in enumerate(path):
+            if name not in node:
+                node[name] = {}
+            elif not isinstance(node[name], dict):
+                dotted = ".".join(path[:depth + 1])
+                raise ParseError(f"key conflict: {dotted} is not a table", lineno, source)
+            node = node[name]
+        return node
+
+    def _header(self, line, lineno, source):
+        match = _HEADER_RE.fullmatch(line)
+        if not match:
+            raise ParseError("invalid section header", lineno, source)
+        names = match.group(1).split(".")
+        key = tuple(names)
+        if key in self.defined:
+            raise ParseError(f"duplicate section: {match.group(1)}", lineno, source)
+        self._walk(names, lineno, source)
+        self.defined.add(key)
+        return names
+
+    def _store(self, path, key, value, lineno, source):
+        node = self._walk(path, lineno, source)
+        full = ".".join(path + [key])
+        if key in node:
+            if isinstance(node[key], dict):
+                raise ParseError(f"key conflict: {full} is a table", lineno, source)
+            raise ParseError(f"duplicate key: {full}", lineno, source)
+        node[key] = value
+
+    def _directive(self, line, lineno, source, base_dir):
+        keyword = "@include"
+        if not line.startswith(keyword) or (
+            len(line) > len(keyword) and _NAME_CHAR_RE.match(line[len(keyword)])
+        ):
+            raise ParseError("invalid line", lineno, source)
+        rest = line[len(keyword):].lstrip(" \t")
+        if not rest or rest[0] not in "\"'":
+            raise ParseError("invalid include", lineno, source)
+        try:
+            path, end = _read_quoted(rest, 0)
+        except _Bad:
+            raise ParseError("invalid include", lineno, source) from None
+        if not _only_comment_tail(rest[end:]):
+            raise ParseError("invalid include", lineno, source)
+        if base_dir is None:
+            raise ParseError("include needs a base directory", lineno, source)
+
+        joined = os.path.join(base_dir, path)
+        child_source = os.path.normpath(joined)
+        real = os.path.realpath(joined)
+        if real in self.stack:
+            raise ParseError(f"include cycle: {path}", lineno, source)
+        try:
+            with open(joined, encoding="utf-8", newline="") as handle:
+                text = handle.read()
+        except (OSError, UnicodeDecodeError) as exc:
+            raise ParseError(f"cannot read include: {path}", lineno, source) from exc
+        self.stack.append(real)
+        try:
+            self._parse_text(text, os.path.dirname(joined), child_source)
+        finally:
+            self.stack.pop()
+
+
+def _gather_continuation(lines, start):
+    """Collect continuation lines after a key line; return (lines, index of next entry)."""
+    cont = []
+    j = start
+    while j < len(lines):
+        raw = lines[j]
+        stripped = raw.strip(" \t")
+        if not stripped or stripped[0] in "#;":
+            j += 1
+            continue
+        if raw[0] not in " \t":
+            break
+        cont.append(raw)
+        j += 1
+    return cont, j
+
+
+def _parse_value(first, cont):
+    segments = []
+    for raw in [first, *cont]:
+        text = raw.lstrip(" \t")
+        if text and text[0] not in "#;":
+            segments.append(text)
+    if not segments:
+        return ""
+    head = segments[0][0]
+    if head in "\"'":
+        value, end = _read_quoted(segments[0], 0)
+        if len(segments) > 1 or not _only_comment_tail(segments[0][end:]):
+            raise _Bad("unexpected text after string")
+        return value
+    if head == "[":
+        buffer = "\n".join(segments)
+        items, end = _parse_list(buffer, 0)
+        if _skip(buffer, end) < len(buffer):
+            raise _Bad("invalid list")
+        return items
+    lines = []
+    for text in segments:
+        cut = _comment_start(text)
+        if cut is not None:
+            text = text[:cut]
+        text = text.strip(" \t")
+        if text:
+            lines.append(text)
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _comment_start(text):
+    for index, char in enumerate(text):
+        if char in "#;" and (index == 0 or text[index - 1] in " \t"):
+            return index
+    return None
+
+
+def _only_comment_tail(rest):
+    """True if ``rest`` is whitespace, or whitespace followed by an inline comment."""
+    stripped = rest.lstrip(" \t")
+    if not stripped:
+        return True
+    return rest[0] in " \t" and stripped[0] in "#;"
+
+
+def _skip(text, i):
+    """Skip whitespace, newlines and comments starting at ``i``; return the new index."""
+    while i < len(text):
+        char = text[i]
+        if char in " \t\n":
+            i += 1
+        elif char in "#;" and (i == 0 or text[i - 1] in " \t\n"):
+            end = text.find("\n", i)
+            i = len(text) if end < 0 else end
+        else:
+            break
+    return i
+
+
+def _read_quoted(text, i):
+    """Read a quoted string starting at text[i]; return (value, index after the closing quote).
+
+    The string must close before the end of its line (a newline in ``text`` ends it).
+    """
+    quote = text[i]
+    i += 1
+    out = []
+    while True:
+        if i >= len(text) or text[i] == "\n":
+            raise _Bad("unterminated string")
+        char = text[i]
+        if char == quote:
+            return "".join(out), i + 1
+        if quote == '"' and char == "\\":
+            if i + 1 >= len(text) or text[i + 1] == "\n":
+                raise _Bad("unterminated string")
+            escape = text[i + 1]
+            if escape in _ESCAPES:
+                out.append(_ESCAPES[escape])
+                i += 2
+                continue
+            if escape == "u":
+                digits = text[i + 2:i + 6]
+                if _HEX4_RE.fullmatch(digits):
+                    out.append(chr(int(digits, 16)))
+                    i += 6
+                    continue
+            raise _Bad(f"invalid escape: \\{escape}")
+        out.append(char)
+        i += 1
+
+
+def _parse_list(text, i):
+    """Parse the list whose '[' is at text[i]; return (items, index after ']')."""
+    i += 1
+    items = []
+    while True:
+        i = _skip(text, i)
+        if i >= len(text):
+            raise _Bad("unterminated list")
+        char = text[i]
+        if char == "]":
+            return items, i + 1
+        if char == ",":
+            raise _Bad("invalid list")
+        if char in "\"'":
+            item, i = _read_quoted(text, i)
+        elif char == "[":
+            item, i = _parse_list(text, i)
+        else:
+            j = i
+            while j < len(text) and text[j] not in ",]\n":
+                if text[j] == "[":
+                    raise _Bad("invalid list")
+                if text[j] in "#;" and j > 0 and text[j - 1] in " \t":
+                    break
+                j += 1
+            token = text[i:j].strip(" \t")
+            if not token:
+                raise _Bad("invalid list")
+            item = _scalar(token)
+            i = j
+        items.append(item)
+        i = _skip(text, i)
+        if i >= len(text):
+            raise _Bad("unterminated list")
+        if text[i] == ",":
+            i += 1
+            continue
+        if text[i] == "]":
+            return items, i + 1
+        raise _Bad("invalid list")
+
+
+def _scalar(text):
+    if _BOOL_RE.fullmatch(text):
+        return text.lower() == "true"
+    if _DEC_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""))
+    for pattern, base in _BASED_INT_RES:
+        match = pattern.fullmatch(text)
+        if match:
+            value = int(match.group(2).replace("_", ""), base)
+            return -value if match.group(1) == "-" else value
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
