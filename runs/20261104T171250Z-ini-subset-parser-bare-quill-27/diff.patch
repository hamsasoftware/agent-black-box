+class IncludeErrorTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def write(self, name, text):
+        path = os.path.join(self.tmp.name, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_invalid_include_forms(self):
+        for text in ("@include\n", "@include base.ini\n", '@include "a.ini\n',
+                     '@include "a.ini"x\n', '@include "a.ini"#c\n', "@include \"a\\q\"\n"):
+            e = error_of(text, base_dir=self.tmp.name)
+            self.assertTrue(e.message.startswith("invalid include"), text)
+            self.assertEqual(e.lineno, 1)
+
+    def test_include_comment_with_space_is_fine(self):
+        self.write("a.ini", "x = 1\n")
+        self.assertEqual(loads('@include "a.ini"   ; note\n', base_dir=self.tmp.name), {"x": 1})
+
+    def test_word_boundary(self):
+        self.assertTrue(error_of("@includes \"a\"\n", base_dir=self.tmp.name).message.startswith("invalid line"))
+        self.assertTrue(error_of("@foo\n", base_dir=self.tmp.name).message.startswith("invalid line"))
+
+    def test_no_base_dir(self):
+        self.assertTrue(error_of('@include "a.ini"\n').message.startswith("include needs a base directory"))
+
+    def test_cannot_read_include(self):
+        e = error_of('x = 1\n@include "missing.ini"\n', base_dir=self.tmp.name)
+        self.assertTrue(e.message.startswith("cannot read include"))
+        self.assertEqual(e.lineno, 2)
+
+    def test_include_continues_section(self):
+        self.write("part.ini", "inner = 1\n")
+        main = self.write("main.ini", '[s]\nbefore = 1\n@include "part.ini"\nafter = 2\n')
+        # The included file starts at the top level, so "inner" is at the root; the
+        # including file then continues in section [s].
+        self.assertEqual(load(main), {"inner": 1, "s": {"before": 1, "after": 2}})
+
+    def test_error_inside_include_uses_its_source(self):
+        self.write("sub/bad.ini", "ok = 1\n\nok = 2\n")
+        main = self.write("main.ini", '@include "sub/bad.ini"\n')
+        e = None
+        try:
+            load(main)
+        except ParseError as exc:
+            e = exc
+        self.assertIsNotNone(e)
+        self.assertEqual(e.source, os.path.normpath(os.path.join(self.tmp.name, "sub/bad.ini")))
+        self.assertEqual(e.lineno, 3)
+        self.assertTrue(e.message.startswith("duplicate key"))
+
+    def test_same_file_twice_is_not_a_cycle_but_duplicates(self):
+        self.write("base.ini", "x = 1\n")
+        main = self.write("main.ini", '@include "base.ini"\n@include "base.ini"\n')
+        e = None
+        try:
+            load(main)
+        except ParseError as exc:
+            e = exc
+        self.assertIsNotNone(e)
+        self.assertTrue(e.message.startswith("duplicate key"))
+
+    def test_self_include_is_a_cycle(self):
+        main = self.write("self.ini", '@include "self.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("include cycle"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_load_missing_file_raises_oserror(self):
+        with self.assertRaises(OSError) as ctx:
+            load(os.path.join(self.tmp.name, "nope.ini"))
+        self.assertNotIsInstance(ctx.exception, ParseError)
+
+    def test_load_strips_bom(self):
+        path = os.path.join(self.tmp.name, "bom.ini")
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write("\ufeffa = 1\n")
+        self.assertEqual(load(path), {"a": 1})
+
+
+if __name__ == "__main__":
+    unittest.main()
