+class DuplicateTest(unittest.TestCase):
+    def test_duplicate_key_in_included_section_reports_key_line(self):
+        e = error_of("[a]\nx = 1\n[a.b]\n[a]\n")
+        self.assertTrue(e.message.startswith("duplicate section"))
+        self.assertEqual(e.lineno, 4)
+
+    def test_key_then_table_conflict(self):
+        self.assertTrue(error_of("a = 1\n[a]\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a = 1\n[a.b]\n").message.startswith("key conflict"))
+        self.assertTrue(error_of("a = 1\na.b = 2\n").message.startswith("key conflict"))
+
+    def test_table_then_value_conflict(self):
+        e = error_of("a.b = 1\na = 2\n")
+        self.assertTrue(e.message.startswith("key conflict"))
+        self.assertEqual(e.lineno, 2)
+
+    def test_bad_value_wins_over_duplicate(self):
+        e = error_of('a = 1\na = "open\n')
+        self.assertTrue(e.message.startswith("unterminated string"))
+        self.assertEqual(e.lineno, 2)
+
+    def test_duplicate_key_message_names_key(self):
+        e = error_of("a.b = 1\na.b = 2\n")
+        self.assertTrue(e.message.startswith("duplicate key"))
+        self.assertIn("a.b", e.message)
