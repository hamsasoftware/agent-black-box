+"""Edge cases from docs/FORMAT.md. Each error test checks the message prefix and line number."""
+import os
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def error_of(text, base_dir=None):
+    with unittest.TestCase().assertRaises(ParseError) as ctx:
+        loads(text, base_dir=base_dir)
+    return ctx.exception
+
+
+class ScalarTest(unittest.TestCase):
+    def test_bool_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\nc = tRuE\n"), {"a": True, "b": False, "c": True})
+
+    def test_ints(self):
+        self.assertEqual(
+            loads("a = 42\nb = -0\nc = +7\nd = 1_000\ne = 0\n"),
+            {"a": 42, "b": 0, "c": 7, "d": 1000, "e": 0},
+        )
+
+    def test_based_ints(self):
+        self.assertEqual(loads("a = 0xFF\nb = -0b101\nc = 0o17\nd = 0XfF\n"),
+                         {"a": 255, "b": -5, "c": 15, "d": 255})
+
+    def test_floats(self):
+        self.assertEqual(
+            loads("a = .5\nb = 5.\nc = 1e3\nd = -2.5E-3\ne = 1_0.2\nf = 00.5\ng = 007e1\n"),
+            {"a": 0.5, "b": 5.0, "c": 1000.0, "d": -0.0025, "e": 10.2, "f": 0.5, "g": 70.0},
+        )
+
+    def test_non_scalars_stay_strings(self):
+        text = "a = 1__0\nb = _1\nc = inf\nd = nan\ne = yes\nf = 1.2.3\ng = 0x\nh = 1e\ni = +\nj = .\nk = 1_\n"
+        self.assertEqual(loads(text), {
+            "a": "1__0", "b": "_1", "c": "inf", "d": "nan", "e": "yes",
+            "f": "1.2.3", "g": "0x", "h": "1e", "i": "+", "j": ".", "k": "1_",
+        })
+
+    def test_empty_value_is_empty_string(self):
+        self.assertEqual(loads("a =\nb =   # only a comment\n"), {"a": "", "b": ""})
+
+
+class LineTest(unittest.TestCase):
+    def test_crlf_and_cr_endings_count_lines(self):
+        self.assertEqual(loads("a = 1\r\nb = 2\rc = 3\n"), {"a": 1, "b": 2, "c": 3})
+        self.assertEqual(error_of("a = 1\r\nb = 2\r\na = 3\r\n").lineno, 3)
+
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+    def test_comment_inside_multiline_value_is_skipped(self):
+        self.assertEqual(loads("x =\n  one\n  # note\n\n  two\n"), {"x": "one\ntwo"})
+
+    def test_entry_ends_at_column_zero_line(self):
+        self.assertEqual(loads("x =\n  one\ny = 2\n"), {"x": "one", "y": 2})
+
+    def test_continuation_without_value(self):
+        self.assertTrue(error_of("  stray\n").message.startswith("continuation without a value"))
+        self.assertTrue(error_of("[a]\n  stray\n").message.startswith("continuation without a value"))
+        self.assertEqual(error_of("[a]\n  stray\n").lineno, 2)
+
+    def test_invalid_line(self):
+        for text in ("just words\n", "a..b = 1\n", "1x = 2\n", "a b = 3\n", "x@y = 1\n"):
+            self.assertTrue(error_of(text).message.startswith("invalid line"), text)
+
+
+class CommentTest(unittest.TestCase):
+    def test_hash_without_space_is_text(self):
+        self.assertEqual(loads("x = 1#c\ny = a;b\n"), {"x": "1#c", "y": "a;b"})
+
+    def test_semicolon_comment(self):
+        self.assertEqual(loads("x = 1 ; note\n"), {"x": 1})
+
+    def test_comment_after_header(self):
+        self.assertEqual(loads("[a]  # hi\nk = 1\n"), {"a": {"k": 1}})
+
+    def test_header_comment_needs_space(self):
+        self.assertTrue(error_of("[a]#c\n").message.startswith("invalid section header"))
+
+
+class SectionTest(unittest.TestCase):
+    def test_spaces_inside_brackets(self):
+        self.assertEqual(loads("[ a.b ]\nk = 1\n"), {"a": {"b": {"k": 1}}})
+
+    def test_empty_section_is_empty_dict(self):
+        self.assertEqual(loads("[a]\n[b]\n"), {"a": {}, "b": {}})
+
+    def test_keys_before_header_are_top_level(self):
+        self.assertEqual(loads("top = 1\n[s]\nx = 2\n"), {"top": 1, "s": {"x": 2}})
+
+    def test_invalid_headers(self):
+        for text in ("[a\n", "[a]x\n", "[]\n", "[a..b]\n", "[.a]\n", "[a b]\n"):
+            self.assertTrue(error_of(text).message.startswith("invalid section header"), text)
+
+    def test_dotted_header_then_plain_header_is_fine(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_dotted_key_does_not_define_section(self):
+        self.assertEqual(loads("a.x = 1\n[a]\ny = 2\n"), {"a": {"x": 1, "y": 2}})
+
+
+class DottedKeyTest(unittest.TestCase):
+    def test_dotted_key_nests(self):
+        self.assertEqual(loads("x.y.z = 1\nx.w = 2\n"), {"x": {"y": {"z": 1}, "w": 2}})
+
+
+class StringTest(unittest.TestCase):
+    def test_unicode_escape(self):
+        self.assertEqual(loads('a = "\\u0041\\u00e9"\n'), {"a": "A\u00e9"})
+
+    def test_escape_backslash_and_quote(self):
+        self.assertEqual(loads('a = "x\\\\y\\"z"\n'), {"a": 'x\\y"z'})
+
+    def test_invalid_escape(self):
+        e = error_of('a = "\\q"\n')
+        self.assertTrue(e.message.startswith("invalid escape"))
+        self.assertEqual(e.lineno, 1)
+
+    def test_short_unicode_escape_is_invalid(self):
+        self.assertTrue(error_of('a = "\\u12"\n').message.startswith("invalid escape"))
+
+    def test_backslash_at_end_of_line_is_unterminated(self):
+        self.assertTrue(error_of('a = "abc\\\n').message.startswith("unterminated string"))
+
+    def test_single_quotes_are_literal(self):
+        self.assertEqual(loads("a = 'x\\\\n\\'\n"), {"a": "x\\\\n\\"})
+
+    def test_quoted_is_never_converted(self):
+        self.assertEqual(loads('a = "true"\nb = \'12\'\n'), {"a": "true", "b": "12"})
+
+    def test_text_after_string(self):
+        self.assertTrue(error_of('a = "x" y\n').message.startswith("unexpected text after string"))
+        self.assertTrue(error_of('a = "x"#c\n').message.startswith("unexpected text after string"))
+        self.assertEqual(loads('a = "x"  # ok\n'), {"a": "x"})
+
+    def test_string_must_close_on_its_line(self):
+        e = error_of('a = "one\ntwo"\n')
+        self.assertTrue(e.message.startswith("unterminated string"))
+        self.assertEqual(e.lineno, 1)
+
+    def test_value_error_on_continuation_reports_key_line(self):
