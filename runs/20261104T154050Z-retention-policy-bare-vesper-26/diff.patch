+# Summary
+
+## What changed
+- `vaultsnap/retention.py`: implemented `plan_retention(snapshots, policy, now)`. It only plans and deletes nothing.
+- `tests/test_retention_adr.py` (new): 10 extra tests for the edge cases below. No existing test was touched.
+- Nothing outside `vaultsnap/`, `tests/` and this file was changed.
+
+## ADRs applied
+- **ADR-0001** (model): validation (naive datetimes and duplicate ids raise `ValueError`), ordering (`taken_at`, then greater id), and the empty-policy rule (all five rules off means keep everything). It also covers set-aside snapshots (protected tags, and `taken_at` later than `now`; a snapshot exactly at `now` is not set aside), `keep_last`, newest-N non-empty buckets with the newest snapshot as representative, independent rules combined by union, and output newest first.
+- **ADR-0003**: weekly key is `(isocalendar year, week)`. This replaces ADR-0001's Sunday weeks. Monthly and yearly keys stay on the calendar year and month.
+- **ADR-0004**: bucket time is `taken_at` converted to a fixed `tz_offset_minutes`, minus `day_start_hour` hours. Daily, weekly, monthly and yearly keys all come from that one result. `keep_last`, ordering and the `now` comparison use the real instant. ADR-0004 supersedes ADR-0002 (UTC), so I did not use ADR-0002.
+- The README retention section is an old draft, so I ignored it.
+
+## Verification
+- Before the change, `python -m unittest` gave 7 errors, all `NotImplementedError`.
+- After the change, `python -m unittest` ran 17 tests (7 existing, 10 new), all OK.
+
+## Not verified or unsure
+- ADR-0001 doesn't say whether the naive-datetime and duplicate-id checks apply when the policy has no rules. I applied them always, so bad input is rejected before anything is planned.
+- Set-aside snapshots are kept even when the policy has no rules, which is the same result as keeping everything.
+- Snapshots in different time zones are compared by instant, which follows from ADR-0004.
+- I didn't test against real snapshot data or the CLI. Nothing outside the library calls `plan_retention` yet.
+- Docs outside the allowed paths still describe the old rules: the README retention draft, and ADR-0001's status text. I didn't edit them.
diff --git a/tests/test_retention_adr.py b/tests/test_retention_adr.py
new file mode 100644
index 0000000..7a2af37
--- /dev/null
+++ b/tests/test_retention_adr.py
@@ -0,0 +1,80 @@
+import unittest
+from datetime import datetime
+
+from vaultsnap import Policy, Snapshot, plan_retention
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def S(id, stamp, *tags):
+    return Snapshot(id, datetime.fromisoformat(stamp), frozenset(tags))
+
+
+class AdrTest(unittest.TestCase):
+    def test_iso_week_year_boundary(self):
+        # ADR-0003: 2025-12-28 (Sun) is week (2025,52); 2025-12-30 is week (2026,1).
+        shots = [S("a", "2025-12-28T03:00+00:00"), S("b", "2025-12-30T03:00+00:00")]
+        self.assertEqual(plan_retention(shots, Policy(keep_weekly=2), NOW).prune, [])
+        self.assertEqual(plan_retention(shots, Policy(keep_weekly=1), NOW).keep, ["b"])
+        # Yearly stays the calendar year: both are 2025, newest wins.
+        self.assertEqual(plan_retention(shots, Policy(keep_yearly=1), NOW).keep, ["b"])
+
+    def test_sunday_and_monday_are_different_weeks(self):
+        shots = [S("sun", "2026-03-08T03:00+00:00"), S("mon", "2026-03-09T03:00+00:00")]
+        self.assertEqual(plan_retention(shots, Policy(keep_weekly=2), NOW).prune, [])
+
+    def test_day_start_hour_shifts_all_keys(self):
+        # ADR-0004: with day_start_hour=4, 03:30 on 1 Jan belongs to 31 Dec (previous year).
+        shots = [S("a", "2026-01-01T03:30+00:00"), S("b", "2026-01-01T05:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_yearly=2, day_start_hour=4), NOW)
+        self.assertEqual(plan.prune, [])
+        plan = plan_retention(shots, Policy(keep_yearly=2), NOW)
+        self.assertEqual((plan.keep, plan.prune), (["b"], ["a"]))
+
+    def test_tz_offset(self):
+        shots = [S("a", "2026-03-10T23:30+00:00"), S("b", "2026-03-10T10:00+00:00")]
+        self.assertEqual(plan_retention(shots, Policy(keep_daily=5), NOW).prune, ["b"])
+        plan = plan_retention(shots, Policy(keep_daily=5, tz_offset_minutes=60), NOW)
+        self.assertEqual(plan.prune, [])
+
+    def test_keep_last_not_shifted(self):
+        shots = [S("a", "2026-03-10T03:00+00:00"), S("b", "2026-03-10T05:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, ["b"])
+
+    def test_future_and_protected_do_not_count(self):
+        shots = [
+            S("future", "2026-03-21T00:00+00:00"),
+            S("prot", "2026-03-19T00:00+00:00", "rel"),
+            S("x", "2026-03-18T00:00+00:00"),
+            S("y", "2026-03-17T00:00+00:00"),
+        ]
+        plan = plan_retention(shots, Policy(keep_last=1, keep_daily=1, protect_tags={"rel"}), NOW)
+        self.assertEqual(plan.keep, ["future", "prot", "x"])
+        self.assertEqual(plan.prune, ["y"])
+
+    def test_snapshot_at_now_is_not_set_aside(self):
+        shots = [S("a", "2026-03-20T12:00+00:00"), S("b", "2026-03-19T12:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual((plan.keep, plan.prune), (["a"], ["b"]))
+
+    def test_tie_break_by_id(self):
+        shots = [S("a", "2026-03-10T03:00+00:00"), S("b", "2026-03-10T03:00+00:00")]
+        plan = plan_retention(shots, Policy(keep_daily=1), NOW)
+        self.assertEqual((plan.keep, plan.prune), (["b"], ["a"]))
+
+    def test_empty_buckets_do_not_count(self):
+        shots = [S("a", "2026-03-01T03:00+00:00"), S("b", "2026-03-15T03:00+00:00")]
+        self.assertEqual(plan_retention(shots, Policy(keep_daily=2), NOW).prune, [])
+
+    def test_errors(self):
+        with self.assertRaises(ValueError):
+            plan_retention([], Policy(keep_last=1), datetime(2026, 1, 1))
+        with self.assertRaises(ValueError):
+            plan_retention([S("a", "2026-03-01T00:00+00:00")] * 2, Policy(keep_last=1), NOW)
+        with self.assertRaises(ValueError):
+            plan_retention([Snapshot("n", datetime(2026, 1, 1))], Policy(), NOW)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/vaultsnap/retention.py b/vaultsnap/retention.py
index 5ad59e7..f75f3d8 100644
--- a/vaultsnap/retention.py
+++ b/vaultsnap/retention.py
@@ -1,4 +1,5 @@
 from dataclasses import dataclass
+from datetime import timedelta, timezone
 
 
 @dataclass(frozen=True)
@@ -17,4 +18,63 @@ def plan_retention(snapshots, policy, now):
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
     """
-    raise NotImplementedError
+    def aware(dt):
+        return dt.tzinfo is not None and dt.utcoffset() is not None
+
+    if not aware(now):
+        raise ValueError("now must be timezone-aware")
+    snapshots = list(snapshots)
+    seen = set()
+    for s in snapshots:
+        if not aware(s.taken_at):
+            raise ValueError(f"snapshot {s.id!r} has a naive taken_at")
+        if s.id in seen:
+            raise ValueError(f"duplicate snapshot id {s.id!r}")
+        seen.add(s.id)
+
+    # ADR-0001 "Ordering": newer = later taken_at, ties broken by greater id.
+    ordered = sorted(snapshots, key=lambda s: (s.taken_at, s.id), reverse=True)
+
+    if not policy.has_rules:  # ADR-0001: an empty policy never prunes
+        return Plan(keep=[s.id for s in ordered], prune=[])
+
+    # ADR-0001 "Set-aside snapshots": protected tags and future snapshots.
+    keep = set()
+    remaining = []
+    for s in ordered:
+        if (s.tags & policy.protect_tags) or s.taken_at > now:
+            keep.add(s.id)
+        else:
+            remaining.append(s)
+
+    if policy.keep_last:
+        keep.update(s.id for s in remaining[: policy.keep_last])
+
+    # ADR-0004: bucket time = taken_at at fixed offset, minus day_start_hour.
+    tz = timezone(timedelta(minutes=policy.tz_offset_minutes))
+    shift = timedelta(hours=policy.day_start_hour)
+    dated = [(s, (s.taken_at.astimezone(tz) - shift).date()) for s in remaining]
+
+    def iso_week(d):  # ADR-0003
+        y, w, _ = d.isocalendar()
+        return (y, w)
+
+    rules = (
+        (policy.keep_daily, lambda d: d),
+        (policy.keep_weekly, iso_week),
+        (policy.keep_monthly, lambda d: (d.year, d.month)),
+        (policy.keep_yearly, lambda d: d.year),
+    )
+    for n, keyfn in rules:
+        if not n:
+            continue
+        newest = {}  # remaining is newest first, so first seen is the bucket's newest
+        for s, d in dated:
+            newest.setdefault(keyfn(d), s.id)
+        for key in sorted(newest, reverse=True)[:n]:
+            keep.add(newest[key])
+
+    return Plan(
+        keep=[s.id for s in ordered if s.id in keep],
+        prune=[s.id for s in ordered if s.id not in keep],
+    )
