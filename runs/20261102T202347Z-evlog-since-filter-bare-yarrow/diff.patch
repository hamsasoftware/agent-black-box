 @dataclass(frozen=True)
@@ -31,3 +31,13 @@ def read_events(path):
 
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
+
+
+def filter_since(events, since):
+    """Keep events at or after `since` (aware). Naive timestamps are taken as UTC."""
+    for event in events:
+        ts = event.ts
+        if ts.tzinfo is None:
+            ts = ts.replace(tzinfo=timezone.utc)
+        if ts >= since:
+            yield event
