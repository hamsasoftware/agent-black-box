-"""Configuration parser.
-
-This module used to be a thin wrapper around the third-party package ``inilite``.
-"""
-import inilite
+"""Configuration parser for the format documented in docs/FORMAT.md."""
+import os
+import re
 
 from .errors import ParseError
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DOTTED = _NAME + r"(?:\." + _NAME + r")*"
+_KEY_RE = re.compile(r"(" + _DOTTED + r")[ \t]*=")
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _DOTTED + r")[ \t]*\](.*)")
+_INCLUDE_RE = re.compile(r"@include(?![A-Za-z0-9_-])")
+
+_DEC_INT_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_BASED_INT_RE = re.compile(
+    r"[+-]?0(?:[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*"
+    r"|[oO][0-7](?:_?[0-7])*"
+    r"|[bB][01](?:_?[01])*)"
+)
+_D = r"[0-9](?:_?[0-9])*"
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:(?:" + _D + r"\.(?:" + _D + r")?|\." + _D + r")(?:[eE][+-]?[0-9]+)?"
+    r"|" + _D + r"[eE][+-]?[0-9]+)"
+)
+
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX = "0123456789abcdefABCDEF"
+
+
+class _ValueFault(Exception):
+    """An error inside a value; the caller adds the line number."""
+
+
+def _scalar(text):
+    low = text.lower()
+    if low == "true":
+        return True
+    if low == "false":
+        return False
+    if _DEC_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 10)
+    if _BASED_INT_RE.fullmatch(text):
+        return int(text.replace("_", ""), 0)
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
+
+
+def _strip_comment(line):
+    for i, ch in enumerate(line):
+        if ch in "#;" and (i == 0 or line[i - 1] in " \t"):
+            return line[:i]
+    return line
+
+
+def _skip(text, p):
+    """Skip spaces, tabs, newlines and comments; return the next significant index."""
+    n = len(text)
+    while p < n:
+        ch = text[p]
+        if ch in " \t\n":
+            p += 1
+        elif ch in "#;" and (p == 0 or text[p - 1] in " \t\n"):
+            end = text.find("\n", p)
+            p = n if end < 0 else end
+        else:
+            break
+    return p
+
+
+def _quoted(text, p):
+    """Parse the quoted string starting at text[p]. It must close on the same line."""
+    quote = text[p]
+    out = []
+    i = p + 1
+    while True:
+        if i >= len(text) or text[i] == "\n":
+            raise _ValueFault("unterminated string")
+        ch = text[i]
+        if ch == quote:
+            return "".join(out), i + 1
+        if quote == '"' and ch == "\\":
+            if i + 1 >= len(text) or text[i + 1] == "\n":
+                raise _ValueFault("unterminated string")
+            esc = text[i + 1]
+            if esc == "u":
+                digits = text[i + 2:i + 6]
+                if len(digits) != 4 or any(c not in _HEX for c in digits):
+                    raise _ValueFault("invalid escape")
+                out.append(chr(int(digits, 16)))
+                i += 6
+            elif esc in _ESCAPES:
+                out.append(_ESCAPES[esc])
+                i += 2
+            else:
+                raise _ValueFault("invalid escape")
+        else:
+            out.append(ch)
+            i += 1
+
+
+def _list(text, p):
+    """Parse the list whose '[' is at text[p]; return (items, index after ']')."""
+    n = len(text)
+    items = []
+    state = "first"  # "first", "after_comma" or "after_item"
+    p += 1
+    while True:
+        p = _skip(text, p)
+        if p >= n:
+            raise _ValueFault("unterminated list")
+        ch = text[p]
+        if ch == "]":
+            return items, p + 1
+        if ch == ",":
+            if state != "after_item":
+                raise _ValueFault("invalid list")
+            state = "after_comma"
+            p += 1
+            continue
+        if state == "after_item":
+            raise _ValueFault("invalid list")
+        if ch in "\"'":
+            item, p = _quoted(text, p)
+        elif ch == "[":
+            item, p = _list(text, p)
+        else:
+            q = p
+            while q < n and text[q] not in ",][\n" and not (text[q] in "#;" and text[q - 1] in " \t"):
+                q += 1
+            if q < n and text[q] == "[":
+                raise _ValueFault("invalid list")
+            item = _scalar(text[p:q].strip(" \t"))
+            p = q
+        items.append(item)
+        state = "after_item"
+
+
+def _value(text):
+    """Turn the value text (after '=' plus continuation lines) into a Python value."""
+    n = len(text)
+    p = _skip(text, 0)
+    if p >= n:
+        return ""
+    ch = text[p]
+    if ch in "\"'":
+        value, end = _quoted(text, p)
+        if _skip(text, end) != n:
+            raise _ValueFault("unexpected text after string")
+        return value
+    if ch == "[":
+        items, end = _list(text, p)
+        if _skip(text, end) != n:
+            raise _ValueFault("invalid list")
+        return items
+    lines = [_strip_comment(line).strip(" \t") for line in text.split("\n")]
+    lines = [line for line in lines if line]
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _rest_ok(rest):
+    """True if rest is only whitespace, or whitespace and then an inline comment."""
+    stripped = rest.lstrip(" \t")
+    return stripped == "" or (stripped[0] in "#;" and len(stripped) < len(rest))
+
+
+class _Document:
+    def __init__(self):
+        self.root = {}
+        self.table = self.root
+        self.section = ""
+        self.sections = set()
+
+    def parse(self, text, base_dir, source, chain):
+        saved = (self.table, self.section)
+        self.table, self.section = self.root, ""
+        if text.startswith("﻿"):
+            text = text[1:]
+        lines = re.split(r"\r\n|\r|\n", text)
+        n = len(lines)
+        i = 0
+        while i < n:
+            raw = lines[i]
+            lineno = i + 1
+            stripped = raw.strip(" \t")
+            if not stripped or stripped[0] in "#;":
+                i += 1
+                continue
+            if raw[0] in " \t":
+                raise ParseError("continuation without a value", lineno, source)
+            if raw[0] == "[":
+                self._header(raw, lineno, source)
+                i += 1
+            elif raw[0] == "@":
+                self._include(raw, lineno, source, base_dir, chain)
+                i += 1
+            else:
+                match = _KEY_RE.match(raw)
+                if not match:
+                    raise ParseError(f"invalid line: {stripped}", lineno, source)
+                value_lines = [raw[match.end():]]
+                j = i + 1
+                while j < n:
+                    nxt = lines[j]
+                    t = nxt.strip(" \t")
+                    if not t or t[0] in "#;":
+                        j += 1
+                        continue
+                    if nxt[0] not in " \t":
+                        break
+                    value_lines.append(nxt)
+                    j += 1
+                i = j
+                try:
+                    value = _value("\n".join(value_lines))
+                except _ValueFault as exc:
+                    raise ParseError(str(exc), lineno, source) from None
+                self._store(match.group(1).split("."), value, lineno, source)
+        self.table, self.section = saved
+
+    def _header(self, raw, lineno, source):
+        match = _HEADER_RE.match(raw)
+        if not match or not _rest_ok(match.group(2)):
+            raise ParseError("invalid section header", lineno, source)
+        name = match.group(1)
+        table = self.root
+        for part in name.split("."):
+            if part not in table:
+                table[part] = {}
+            elif not isinstance(table[part], dict):
+                raise ParseError(f"key conflict: [{name}]", lineno, source)
+            table = table[part]
+        if name in self.sections:
+            raise ParseError(f"duplicate section: [{name}]", lineno, source)
+        self.sections.add(name)
+        self.table, self.section = table, name
+
+    def _store(self, parts, value, lineno, source):
+        full = ".".join(parts)
+        table = self.table
+        for part in parts[:-1]:
+            if part not in table:
+                table[part] = {}
+            elif not isinstance(table[part], dict):
+                raise ParseError(f"key conflict: {full}", lineno, source)
+            table = table[part]
+        last = parts[-1]
+        if last in table:
+            if isinstance(table[last], dict):
+                raise ParseError(f"key conflict: {full}", lineno, source)
+            raise ParseError(f"duplicate key: {full}", lineno, source)
+        table[last] = value
+
+    def _include(self, raw, lineno, source, base_dir, chain):
+        if not _INCLUDE_RE.match(raw):
+            raise ParseError(f"invalid line: {raw.strip(' \t')}", lineno, source)
+        rest = raw[len("@include"):]
+        body = rest.lstrip(" \t")
+        if len(body) == len(rest) or not body or body[0] not in "\"'":
+            raise ParseError("invalid include", lineno, source)
+        try:
+            path, end = _quoted(body, 0)
+        except _ValueFault:
+            raise ParseError("invalid include", lineno, source) from None
+        if not _rest_ok(body[end:]):
+            raise ParseError("invalid include", lineno, source)
+        if base_dir is None:
+            raise ParseError("include needs a base directory", lineno, source)
+        target = os.path.normpath(os.path.join(base_dir, path))
+        real = os.path.realpath(target)
+        if real in chain:
+            raise ParseError("include cycle", lineno, source)
+        try:
+            with open(target, encoding="utf-8", newline="") as handle:
+                text = handle.read()
+        except (OSError, UnicodeDecodeError):
+            raise ParseError(f"cannot read include: {path}", lineno, source) from None
+        self.parse(text, os.path.dirname(target), target, chain + [real])
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    document = _Document()
+    document.parse(text, base_dir, source, [])
+    return document.root
 
 
 def load(path):
-    with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+    with open(path, encoding="utf-8", newline="") as handle:
+        text = handle.read()
+    document = _Document()
+    document.parse(text, os.path.dirname(path), path, [os.path.realpath(path)])
+    return document.root
