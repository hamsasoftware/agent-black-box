+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+
+def fail_message(text, **kwargs):
+    with_error = None
+    try:
+        loads(text, **kwargs)
+    except ParseError as exc:
+        with_error = exc
+    if with_error is None:
+        raise AssertionError(f"no ParseError for {text!r}")
+    return with_error
+
+
+class TypedValueTest(unittest.TestCase):
+    def test_bools_any_case(self):
+        self.assertEqual(loads("a = True\nb = FALSE\nc = tRuE\n"), {"a": True, "b": False, "c": True})
+
+    def test_ints(self):
+        self.assertEqual(
+            loads("a = 42\nb = -0\nc = +7\nd = 1_000\ne = 0xFF\nf = -0b101\ng = 0o17\nh = 0XAB\n"),
+            {"a": 42, "b": 0, "c": 7, "d": 1000, "e": 255, "f": -5, "g": 15, "h": 171},
+        )
+
+    def test_floats(self):
+        self.assertEqual(
+            loads("a = .5\nb = 5.\nc = 1e3\nd = -2.5E-3\ne = 1_0.2\nf = 00.5\ng = 007e1\n"),
+            {"a": 0.5, "b": 5.0, "c": 1000.0, "d": -0.0025, "e": 10.2, "f": 0.5, "g": 70.0},
+        )
+
+    def test_non_numbers_stay_strings(self):
+        text = "a = 1__0\nb = _1\nc = inf\nd = nan\ne = yes\nf = 1.2.3\ng = 0x\nh = 1e\ni = +\nj = .\nk = 1_\n"
+        self.assertEqual(loads(text), {
+            "a": "1__0", "b": "_1", "c": "inf", "d": "nan", "e": "yes", "f": "1.2.3",
+            "g": "0x", "h": "1e", "i": "+", "j": ".", "k": "1_",
+        })
+
+    def test_quoted_values_are_never_converted(self):
+        self.assertEqual(loads("a = \"true\"\nb = '42'\n"), {"a": "true", "b": "42"})
+
+    def test_quoted_escapes(self):
+        self.assertEqual(loads('a = "q\\"x\\\\y\\r\\n\\0\\u0041"\n'), {"a": 'q"x\\y\r\n\x00A'})
+
+    def test_invalid_escape(self):
+        self.assertTrue(fail_message('a = "\\q"\n').message.startswith("invalid escape"))
+        self.assertTrue(fail_message('a = "\\u12"\n').message.startswith("invalid escape"))
+
+    def test_plain_multiline_is_not_converted(self):
+        self.assertEqual(loads("a =\n  1\n  2\n"), {"a": "1\n2"})
+
+    def test_empty_value(self):
+        self.assertEqual(loads("a =\nb = # only a comment\nc = \"\"\n"), {"a": "", "b": "", "c": ""})
+
+    def test_text_after_string(self):
+        self.assertTrue(fail_message('a = "x" y\n').message.startswith("unexpected text after string"))
+        self.assertEqual(loads('a = "x" # ok\n'), {"a": "x"})
+
+    def test_single_quotes_are_literal(self):
+        self.assertEqual(loads("a = 'x\\ty'\n"), {"a": "x\\ty"})
+
+
+class ListTest(unittest.TestCase):
+    def test_nested_and_comments(self):
+        text = "a = [[1, 2], [\"x\"]] # c\nb = [1, # first\n  2 # second\n  ]\n"
+        self.assertEqual(loads(text), {"a": [[1, 2], ["x"]], "b": [1, 2]})
+
+    def test_quote_inside_token_is_ordinary(self):
+        self.assertEqual(loads("a = [it's, x#y]\n"), {"a": ["it's", "x#y"]})
+
+    def test_list_errors(self):
+        for text in ["a = [1,,2]\n", "a = [,]\n", "a = [\"x\" \"y\"]\n", "a = [1] x\n", "a = [a[b]\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(fail_message(text).message.startswith("invalid list"))
+
+    def test_unterminated_list(self):
+        self.assertTrue(fail_message("a = [1, 2\n").message.startswith("unterminated list"))
+
+    def test_error_line_is_key_line(self):
+        exc = fail_message("x = 1\na = [1,\n  2 3 4\n  ] y\n")
+        self.assertEqual(exc.lineno, 2)
+        self.assertTrue(exc.message.startswith("invalid list"))
+
+
+class SectionAndKeyTest(unittest.TestCase):
+    def test_header_with_no_keys_is_empty_dict(self):
+        self.assertEqual(loads("[a]\n[b.c]\n"), {"a": {}, "b": {"c": {}}})
+
+    def test_spaces_inside_brackets_and_trailing_comment(self):
+        self.assertEqual(loads("[ a.b ]  ; note\nk = 1\n"), {"a": {"b": {"k": 1}}})
+
+    def test_invalid_header(self):
+        for text in ["[a b]\n", "[a] x\n", "[a]#c\n", "[a.]\n", "[ a . b ]\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(fail_message(text).message.startswith("invalid section header"))
+
+    def test_implicit_table_then_explicit_is_fine(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+
+    def test_explicit_section_twice_is_duplicate(self):
+        self.assertTrue(fail_message("[a]\n[a]\n").message.startswith("duplicate section"))
+
+    def test_dotted_key_does_not_define_section(self):
+        self.assertEqual(loads("[x]\ny.z = 1\n[x.y]\nw = 2\n"), {"x": {"y": {"z": 1, "w": 2}}})
+
+    def test_key_conflicts(self):
+        for text in ["a = 1\na.b = 2\n", "a.b = 1\na = 2\n", "a = 1\n[a]\n", "a = 1\n[a.b]\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(fail_message(text).message.startswith("key conflict"))
+
+    def test_duplicate_dotted_key(self):
+        self.assertTrue(fail_message("a.b = 1\na.b = 2\n").message.startswith("duplicate key"))
+
+    def test_bad_value_reported_before_duplicate(self):
+        self.assertTrue(fail_message("a = 1\na = \"x\n").message.startswith("unterminated string"))
+
+    def test_invalid_line(self):
+        for text in ["a b = 1\n", "= 1\n", "1x = 2\n"]:
+            with self.subTest(text=text):
+                self.assertTrue(fail_message(text).message.startswith("invalid line"))
+
+    def test_continuation_without_value(self):
+        self.assertTrue(fail_message("  x\n").message.startswith("continuation without a value"))
+        self.assertTrue(fail_message("[a]\n  x\n").message.startswith("continuation without a value"))
+
+    def test_multiline_skips_blank_and_comment_lines(self):
+        self.assertEqual(loads("a =\n  one\n\n  # hidden\n  two\n"), {"a": "one\ntwo"})
+
+
+class TextHandlingTest(unittest.TestCase):
+    def test_bom_and_crlf(self):
+        self.assertEqual(loads("\ufeffa = 1\r\n[s]\r\nb = 2\r\n"), {"a": 1, "s": {"b": 2}})
+
+    def test_lone_cr_line_endings(self):
+        self.assertEqual(loads("a = 1\rb = 2"), {"a": 1, "b": 2})
+
+    def test_error_line_numbers_with_crlf(self):
+        self.assertEqual(fail_message("a = 1\r\n\r\nb = \"x\r\n").lineno, 3)
+
+    def test_error_source_name(self):
+        exc = fail_message("x = \"\n", source="deploy.ini")
+        self.assertEqual(str(exc), "deploy.ini:1: unterminated string")
+
+
+class IncludeFormatTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def write(self, rel, text):
+        path = os.path.join(self.tmp.name, rel)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_include_needs_base_dir(self):
+        self.assertTrue(fail_message('@include "x.ini"\n').message.startswith("include needs a base directory"))
+
+    def test_invalid_include_forms(self):
+        for text in ["@include\n", "@include x.ini\n", "@include \"x\" y\n", "@includes \"x\"\n"]:
+            with self.subTest(text=text):
+                exc = fail_message(text, base_dir=self.tmp.name)
+                expected = "invalid line" if text.startswith("@includes") else "invalid include"
+                self.assertTrue(exc.message.startswith(expected), exc.message)
+
+    def test_missing_include(self):
+        self.assertTrue(fail_message('@include "nope.ini"\n', base_dir=self.tmp.name)
+                        .message.startswith("cannot read include"))
+
+    def test_section_restored_after_include(self):
+        self.write("part.ini", "p = 1\n")
+        main = self.write("main.ini", "[s]\n@include \"part.ini\"\nq = 2\n")
+        self.assertEqual(load(main), {"s": {"q": 2}, "p": 1})
+
+    def test_nested_relative_include(self):
+        self.write("sub/inner.ini", "v = 3\n")
+        self.write("sub/outer.ini", '@include "inner.ini"\n')
+        main = self.write("main.ini", '@include "sub/outer.ini"\n')
+        self.assertEqual(load(main), {"v": 3})
+
+    def test_error_in_include_uses_included_source(self):
+        self.write("bad.ini", "a = 1\nb = \"open\n")
+        main = self.write("main.ini", "x = 1\n@include \"bad.ini\"\n")
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertEqual(ctx.exception.source, os.path.join(self.tmp.name, "bad.ini"))
+
+    def test_include_twice_is_duplicate_not_cycle(self):
+        self.write("one.ini", "k = 1\n")
+        main = self.write("main.ini", '@include "one.ini"\n@include "one.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+
+    def test_missing_root_file_is_oserror(self):
+        with self.assertRaises(OSError):
+            load(os.path.join(self.tmp.name, "absent.ini"))
+
+
+class CommandLineFormatTest(unittest.TestCase):
+    def run_cli(self, text, *args):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write(text)
+            root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+            return subprocess.run(
+                [sys.executable, "-m", "confkit", path, *args],
+                cwd=root, capture_output=True, text=True,
+            )
+
+    def test_print_whole_config(self):
+        result = self.run_cli("a = 1\n[s]\nb = [true]\n")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, '{\n  "a": 1,\n  "s": {\n    "b": [\n      true\n    ]\n  }\n}\n')
+
+    def test_parse_error_exit_1(self):
+        result = self.run_cli("a = 1\na = 2\n")
+        self.assertEqual(result.returncode, 1)
+        self.assertTrue(result.stderr.strip().endswith("c.ini:2: duplicate key: a"), result.stderr)
+
+    def test_missing_get_key_exit_2(self):
+        result = self.run_cli("a = 1\n", "--get", "b.c")
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stderr.strip(), "no such key: b.c")
+
+
+if __name__ == "__main__":
+    unittest.main()
