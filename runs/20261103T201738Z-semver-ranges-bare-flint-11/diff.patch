+import re
+from functools import lru_cache
+
 from .version import Version
 
+_OPERATORS = ("<=", ">=", "<", ">", "=", "~", "^")
+_WILDCARDS = ("x", "X", "*")
+_NUMBER = re.compile(r"0|[1-9]\d*")
+
+
+class _Partial:
+    """One version as written in a range: 0-3 leading numbers, rest wildcards."""
+
+    __slots__ = ("nums", "pre")
+
+    def __init__(self, nums, pre=()):
+        self.nums = tuple(nums)
+        self.pre = tuple(pre)
+
+    @property
+    def count(self):
+        return len(self.nums)
+
+    def _padded(self):
+        return self.nums + (0,) * (3 - len(self.nums))
+
+    def lower(self):
+        """Smallest version this partial stands for (missing parts are zero)."""
+        major, minor, patch = self._padded()
+        return Version(major, minor, patch, self.pre)
+
+    def next_bound(self):
+        """Exclusive upper bound of the partial, or None if it is '*'."""
+        if self.count == 0:
+            return None
+        major, minor, _ = self._padded()
+        if self.count == 1:
+            return Version(major + 1, 0, 0)
+        return Version(major, minor + 1, 0)
+
+    def release(self):
+        return self._padded()
+
+
+def _parse_partial(text):
+    if not text:
+        raise ValueError("missing version")
+    body = text[1:] if text[0] == "v" else text
+    body = body.split("+", 1)[0]
+    core, sep, pre = body.partition("-")
+    if not core:
+        raise ValueError(f"invalid version: {text!r}")
+
+    parts = ["*"] if core in _WILDCARDS else core.split(".")
+    if len(parts) > 3:
+        raise ValueError(f"invalid version: {text!r}")
+
+    nums = []
+    seen_wildcard = False
+    for part in parts:
+        if part in _WILDCARDS:
+            seen_wildcard = True
+        elif seen_wildcard or not _NUMBER.fullmatch(part):
+            raise ValueError(f"invalid version: {text!r}")
+        else:
+            nums.append(int(part))
+
+    pre_tuple = ()
+    if sep:
+        # Only a complete MAJOR.MINOR.PATCH may carry a prerelease tag.
+        if len(nums) != 3:
+            raise ValueError(f"invalid version: {text!r}")
+        pre_tuple = Version.parse(f"{core}-{pre}").prerelease
+    return _Partial(nums, pre_tuple)
+
+
+def _never(_v):
+    return False
+
+
+def _ge(bound):
+    return lambda v: v >= bound
+
+
+def _gt(bound):
+    return lambda v: v > bound
+
+
+def _lt(bound):
+    return lambda v: v < bound
+
+
+def _le(bound):
+    return lambda v: v <= bound
+
+
+def _eq(bound):
+    return lambda v: v == bound
+
+
+def _interval(lo, hi):
+    preds = [_ge(lo)]
+    if hi is not None:
+        preds.append(_lt(hi))
+    return preds
+
+
+def _caret_upper(p):
+    major, minor, patch = p._padded()
+    if p.count == 1 or major > 0:
+        return Version(major + 1, 0, 0)
+    if minor > 0:
+        return Version(0, minor + 1, 0)
+    if p.count == 2:
+        return Version(0, 1, 0)
+    return Version(0, 0, patch + 1)
+
+
+def _operator_predicates(op, p):
+    """Predicates for a single comparator `op` applied to partial `p`."""
+    full = p.count == 3
+    if op in ("", "="):
+        if full:
+            return [_eq(p.lower())]
+        if p.count == 0:
+            return []
+        return _interval(p.lower(), p.next_bound())
+    if op == ">":
+        if p.count == 0:
+            return [_never]
+        return [_gt(p.lower())] if full else [_ge(p.next_bound())]
+    if op == ">=":
+        return [] if p.count == 0 else [_ge(p.lower())]
+    if op == "<":
+        return [_never] if p.count == 0 else [_lt(p.lower())]
+    if op == "<=":
+        if p.count == 0:
+            return []
+        return [_le(p.lower())] if full else [_lt(p.next_bound())]
+    if op == "~":
+        if p.count == 0:
+            return []
+        return _interval(p.lower(), p.next_bound())
+    if op == "^":
+        if p.count == 0:
+            return []
+        return _interval(p.lower(), _caret_upper(p))
+    raise ValueError(f"unknown operator: {op!r}")
+
+
+def _parse_set(text):
+    """Parse one comparator set into (predicates, prerelease anchors)."""
+    tokens = text.split()
+    preds = []
+    anchors = set()
+    i = 0
+    while i < len(tokens):
+        token = tokens[i]
+        if i + 1 < len(tokens) and tokens[i + 1] == "-":
+            # Hyphen range: A - B
+            if i + 2 >= len(tokens):
+                raise ValueError(f"incomplete hyphen range in {text!r}")
+            lo = _parse_partial(token)
+            hi = _parse_partial(tokens[i + 2])
+            preds.append(_ge(lo.lower()))
+            if hi.count == 3:
+                preds.append(_le(hi.lower()))
+            elif hi.count > 0:
+                preds.append(_lt(hi.next_bound()))
+            for p in (lo, hi):
+                if p.pre:
+                    anchors.add(p.release())
+            i += 3
+            continue
+
+        if token in _OPERATORS and i + 1 < len(tokens):
+            op, operand = token, tokens[i + 1]
+            i += 2
+        else:
+            op = next((o for o in _OPERATORS if token.startswith(o)), "")
+            operand = token[len(op):]
+            i += 1
+        p = _parse_partial(operand)
+        preds.extend(_operator_predicates(op, p))
+        if p.pre:
+            anchors.add(p.release())
+    return tuple(preds), frozenset(anchors)
+
+
+@lru_cache(maxsize=512)
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError(f"range must be a string: {range_!r}")
+    return tuple(_parse_set(part) for part in range_.split("||"))
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise ValueError(f"invalid version: {version!r}")
+
+
+def _set_matches(comparator_set, version):
+    preds, anchors = comparator_set
+    if version.prerelease and version.release not in anchors:
+        return False
+    return all(pred(version) for pred in preds)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    v = _coerce(version)
+    return any(_set_matches(s, v) for s in sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        v = _coerce(item)
+        if best_version is not None and not v > best_version:
+            continue
+        if any(_set_matches(s, v) for s in sets):
+            best, best_version = item, v
+    return best
