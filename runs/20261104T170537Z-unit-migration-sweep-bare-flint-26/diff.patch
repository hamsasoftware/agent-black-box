+import re
+
+_INPUT = re.compile(r"[0-9]+(?:\.[0-9]+)?")
+
+
+class WeightError(ValueError):
+    """An invalid weight, or a total over the carrier limit."""
+
+
+def _thousandths(value):
+    """Exact whole grams (thousandths of a kilogram) of a weight, rounded half to even."""
+    if not isinstance(value, str) or not _INPUT.fullmatch(value):
+        raise WeightError(f"invalid weight: {value!r}")
+    whole, _, fraction = value.partition(".")
+    grams = int(whole) * 1000 + int(fraction[:3].ljust(3, "0"))
+    rest = fraction[3:]
+    if rest and (rest[0] > "5" or (rest[0] == "5" and (rest[1:].strip("0") or grams % 2))):
+        grams += 1
+    return grams
+
+
+def _canonical(grams):
+    return f"{grams // 1000}.{grams % 1000:03d}"
+
+
+def normalize_kg(value):
+    """Canonical form of a weight: rounded half to even to three places.
+
+    >>> normalize_kg("0.250")
+    '0.250'
+    >>> normalize_kg("1.0005")
+    '1.000'
+    >>> normalize_kg("1.0015")
+    '1.002'
+    """
+    return _canonical(_thousandths(value))
+
+
+def kg_to_g(value):
+    """Exact whole grams of a weight, after normalisation.
+
+    >>> kg_to_g("1.25")
+    1250
+    """
+    return _thousandths(value)
 
 
