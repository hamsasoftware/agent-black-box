+"""Checks the worked examples of docs/MIGRATION.md, docs/ROUNDING.md and docs/FORMATS.md."""
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from shipcalc import auditlog, cli, export, importer, plugins, reports, storage, surcharges, validate
+from shipcalc.calc import order_weight_kg, quote
+from shipcalc.models import Item, Order
+from shipcalc.pallets import fill_percent, pallet_count
+from shipcalc.pricing import freight_cents
+from shipcalc.rates import shipping_cents
+from shipcalc.tare import net_after_percent_kg, tare_for_percent_kg
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+from shipcalc.weighbridge import allowance_kg, within_tolerance
+
+
+class UnitsTest(unittest.TestCase):
+    def test_rounding_half_even(self):
+        self.assertEqual(normalize_kg("1.0005"), "1.000")
+        self.assertEqual(normalize_kg("1.0015"), "1.002")
+        self.assertEqual(normalize_kg("2.0025"), "2.002")
+        self.assertEqual(normalize_kg("1000.0004"), "1000.000")
+        self.assertEqual(normalize_kg("0.0004"), "0.000")
+
+    def test_invalid_input(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", "1.2.3"]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+        for bad in [1, 1.0, True, None]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+
+    def test_error_message(self):
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg("abc")
+        self.assertEqual(str(ctx.exception), "invalid weight: 'abc'")
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg(1500)
+        self.assertEqual(str(ctx.exception), "invalid weight: 1500")
+
+    def test_gram_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        self.assertEqual(kg_to_g("1.0005"), 1000)
+        for bad in [-1, True, 1.5, "1"]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+
+class RoundingTest(unittest.TestCase):
+    def test_freight(self):
+        self.assertEqual(freight_cents("0.125", 100), 12)
+        self.assertEqual(freight_cents("0.375", 100), 38)
+        self.assertEqual(freight_cents("0.003", 500), 2)
+        self.assertEqual(freight_cents("0.001", 499), 0)
+        self.assertEqual(freight_cents("2.000", 350), 700)
+        self.assertEqual(freight_cents("1.0005", 100), 100)
+        self.assertEqual(freight_cents("1.0015", 100), 100)
+
+    def test_pallets(self):
+        rows = [("250.000", 1, 50), ("1.250", 1, 0), ("2.500", 1, 0), ("7.500", 1, 2),
+                ("12.500", 1, 2), ("500.000", 1, 100), ("500.001", 2, 50)]
+        for total, pallets, percent in rows:
+            order = Order([Item("A", total)])
+            with self.subTest(total=total):
+                self.assertEqual(pallet_count(order), pallets)
+                self.assertEqual(fill_percent(order), percent)
+        self.assertEqual(pallet_count(Order()), 0)
+        self.assertEqual(fill_percent(Order()), 0)
+
+    def test_weighbridge(self):
+        self.assertEqual(allowance_kg("10.025"), "0.200")
+        self.assertEqual(allowance_kg("0.500"), "0.020")
+        self.assertTrue(within_tolerance("10.025", "10.225"))
+        self.assertFalse(within_tolerance("10.025", "10.226"))
+        self.assertTrue(within_tolerance("10.075", "9.873"))
+        self.assertTrue(within_tolerance("0.500", "0.480"))
+
+    def test_tare(self):
+        self.assertEqual(tare_for_percent_kg("10.005", 10), "1.000")
+        self.assertEqual(tare_for_percent_kg("0.005", 50), "0.002")
+        self.assertEqual(tare_for_percent_kg("0.015", 50), "0.008")
+        self.assertEqual(net_after_percent_kg("10.015", 10), "9.013")
+        self.assertEqual(net_after_percent_kg("0.015", 50), "0.007")
+
+    def test_shipping_steps(self):
+        self.assertEqual(shipping_cents("0.500", "eu"), 400)
+        self.assertEqual(shipping_cents("0.501", "eu"), 490)
+        self.assertEqual(shipping_cents("10.000", "eu"), 400 + 90 * 19)
+        self.assertEqual(shipping_cents("10.001", "eu"), 400 + 90 * 20 + 500)
+
+    def test_surcharge_bands(self):
+        table = surcharges.load()
+        self.assertEqual(surcharges.cents_for("1.000", table), 0)
+        self.assertEqual(surcharges.cents_for("1.001", table), 150)
+        self.assertEqual(surcharges.cents_for("15.000", table), 400)
+        self.assertEqual(surcharges.cents_for("15.001", table), 900)
+
+    def test_plugin_example(self):
+        order = Order([Item("F", "0.300", 3), Item("H", "4.000")])
+        self.assertEqual(order_weight_kg(order), "4.900")
+        self.assertEqual(plugins.extras_cents(order), 360 + 0 + 90)
+
+    def test_carrier_limit(self):
+        self.assertEqual(order_weight_kg(Order([Item("A", "2147483.647")])), "2147483.647")
+        with self.assertRaises(WeightError):
+            order_weight_kg(Order([Item("A", "2147483.648")]))
+        with self.assertRaises(WeightError):
+            quote(Order([Item("A", "2147483.000"), Item("B", "0.648")]), "eu")
+
+
+class ReportsTest(unittest.TestCase):
+    def test_average(self):
+        self.assertEqual(reports.average_weight_kg(Order()), "0.000")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001", 2)])), "0.001")
+
+    def test_heaviest_ties_by_sku(self):
+        order = Order([Item("B", "2.000"), Item("A", "2.000"), Item("C", "0.500")])
+        self.assertEqual([i.sku for i in reports.heaviest(order, 2)], ["A", "B"])
+
+    def test_bands(self):
+        order = Order([Item("A", "0.500"), Item("B", "0.501"), Item("C", "2.000"), Item("D", "2.001", 2)])
+        self.assertEqual(reports.weight_bands(order), {"light": 1, "medium": 2, "heavy": 2})
+
+
+class ItemTest(unittest.TestCase):
+    def test_weight_error_before_quantity(self):
+        with self.assertRaises(WeightError):
+            Item("A", "heavy", 0)
+
+    def test_validate_item(self):
+        self.assertEqual(validate.validate_item({"sku": "A", "weight_kg": "0.0004", "qty": 1}),
+                         ["weight_kg: out of range 0.001..1000.000"])
+        self.assertEqual(validate.validate_item({"sku": "A", "weight_kg": "1000.0004", "qty": 1}), [])
+        self.assertEqual(validate.validate_item({"sku": "A", "weight_g": 5, "qty": 1}),
+                         ["weight_kg: missing"])
+        self.assertTrue(validate.validate_item({"sku": "A", "weight_kg": "x", "qty": 1})[0]
+                        .startswith("weight_kg:"))
+
+
+class FormatsTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = lambda name: os.path.join(self.dir.name, name)
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_storage_reads_schema_1_and_writes_schema_2(self):
+        with open(self.path("old.json"), "w", encoding="utf-8") as handle:
+            json.dump({"schema": 1, "items": [{"sku": "M", "weight_g": 350, "qty": 2}]}, handle)
+        order = storage.load(self.path("old.json"))
+        self.assertEqual(order.items[0].weight_kg, "0.350")
+        storage.save(order, self.path("new.json"))
+        with open(self.path("new.json"), encoding="utf-8") as handle:
+            data = json.load(handle)
+        self.assertEqual(data, {"schema": 2, "items": [{"sku": "M", "weight_kg": "0.350", "qty": 2}]})
+        with open(self.path("bad.json"), "w", encoding="utf-8") as handle:
+            json.dump({"schema": 3, "items": []}, handle)
+        with self.assertRaises(ValueError):
+            storage.load(self.path("bad.json"))
+
+    def test_csv_import(self):
+        order = importer.parse_csv("sku,weight_g,qty\nA,1250,2\nB,0,1\n")
+        self.assertEqual([(i.sku, i.weight_kg, i.qty) for i in order.items], [("A", "1.250", 2), ("B", "0.000", 1)])
+        order = importer.parse_csv("sku,weight_kg\nA,1.0005\n")
+        self.assertEqual(order.items[0].weight_kg, "1.000")
+        self.assertEqual(importer.parse_csv("sku,weight_kg\nA,1.0015\n").items[0].weight_kg, "1.002")
+        self.assertEqual(importer.parse_csv("sku,weight_g\r\nA,7\r\n").items[0].weight_kg, "0.007")
+
+    def test_csv_errors(self):
+        cases = [
+            ("", "empty file"),
+            ("sku,weight_g,colour\n", "unknown column: 'colour'"),
+            ("sku,sku,weight_g\n", "duplicate column: 'sku'"),
+            ("weight_g\n", "missing column: 'sku'"),
+            ("sku,weight_g,weight_kg\n", "both weight_g and weight_kg"),
+            ("sku,qty\n", "missing weight column"),
+            ("sku,weight_g\nA,1,2\n", "row 2: wrong number of cells"),
+            ("sku,weight_kg\nA,abc\n", "invalid weight: 'abc'"),
+            ("sku,weight_g\nA,-1\n", "invalid weight: '-1'"),
+            ("sku,weight_g,qty\nA,1,0\n", "invalid quantity: '0'"),
+        ]
+        for text, message in cases:
+            with self.subTest(text=text), self.assertRaises(ValueError) as ctx:
+                importer.parse_csv(text)
+            self.assertEqual(str(ctx.exception), message)
+
+    def test_audit_log_versions(self):
+        path = self.path("log.jsonl")
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write('{"event": "add", "qty": 2, "sku": "M", "v": 1, "weight_g": 350}\n\n')
+            handle.write('{"event": "note", "sku": "M"}\n')
+        auditlog.write_entry(path, "add", "N", "1.250", 2)
+        entries = auditlog.read_entries(path)
+        self.assertEqual(entries[0], {"event": "add", "qty": 2, "sku": "M", "v": 2, "weight_kg": "0.350"})
+        self.assertEqual(entries[1], {"event": "note", "sku": "M", "v": 2})
+        self.assertEqual(auditlog.total_added_kg(path), "3.200")
+        before = os.path.getsize(path)
+        with self.assertRaises(WeightError):
+            auditlog.write_entry(path, "add", "N", "heavy")
+        self.assertEqual(os.path.getsize(path), before)
+        with open(path, "a", encoding="utf-8") as handle:
+            handle.write('{"v": "2", "event": "add"}\n')
+        with self.assertRaises(ValueError) as ctx:
+            auditlog.read_entries(path)
+        self.assertEqual(str(ctx.exception), "unsupported log version: '2'")
+
+    def test_gram_formats(self):
+        order = Order([Item("MUG-01", "0.350", 2), Item("BOOK-07", "1.200")])
+        self.assertEqual(export.to_csv(order), "sku,weight_g,qty\nMUG-01,350,2\nBOOK-07,1200,1\n")
+        self.assertEqual(export.carrier_payload(order), {"weight_g": 1900, "parcels": 1})
+        self.assertEqual(export.edi_segment(order), "WGT*G*1900~")
+        self.assertEqual(export.barcode(order), "WT0000001900")
+
+    def test_cli_add_takes_kilograms(self):
+        path = self.path("order.json")
+        storage.save(Order(), path)
