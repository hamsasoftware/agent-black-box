+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
+            self.assertEqual(cli.main(["add", path, "LAMP", "2.400", "1"]), 0)
+            self.assertEqual(cli.main(["add", path, "LAMP", "-1", "1"]), 2)
