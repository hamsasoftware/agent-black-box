     return Event(
-        ts=datetime.fromisoformat(raw["ts"]),
+        ts=parse_timestamp(raw["ts"]),
         service=raw["service"],
         level=raw["level"],
         msg=raw.get("msg", ""),
@@ -29,5 +37,10 @@ def read_events(path):
                 yield parse_line(line)
 
 
+def filter_since(events, since):
+    """Keep events at or after `since` (an aware datetime)."""
+    return (event for event in events if event.ts >= since)
+
+
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
diff --git a/tests/test_since.py b/tests/test_since.py
new file mode 100644
index 0000000..195a4a3
--- /dev/null
+++ b/tests/test_since.py
@@ -0,0 +1,98 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+
+from evlog.cli import main
+from evlog.events import parse_timestamp
+
+EVENTS = [
+    {"ts": "2024-03-09T23:30:00-05:00", "service": "api", "level": "error"},  # 03-10 04:30 UTC
+    {"ts": "2024-03-10 00:00:00", "service": "api", "level": "info"},  # naive, UTC midnight
+    {"ts": "2024-03-10T08:00:00+09:00", "service": "api", "level": "info"},  # 03-09 23:00 UTC
+    {"ts": "2024-03-11T12:00:00+00:00", "service": "worker", "level": "error"},
+]
+
+
+class SinceTest(unittest.TestCase):
+    def setUp(self):
+        handle, self.path = tempfile.mkstemp(suffix=".jsonl")
+        with os.fdopen(handle, "w") as f:
+            for event in EVENTS:
+                f.write(json.dumps(event) + "\n")
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, *args):
+        out = io.StringIO()
+        code = main(["report", self.path, *args], out=out)
+        return code, out.getvalue().strip().splitlines()
+
+    def run_cli_expecting_exit(self, *args):
+        out, err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stderr(err), contextlib.redirect_stdout(out):
+            with self.assertRaises(SystemExit) as cm:
+                main(["report", self.path, *args], out=out)
+        return cm.exception.code, err.getvalue()
+
+    def test_date_is_midnight_utc(self):
+        # Naive "2024-03-10 00:00" is UTC midnight, so it is included;
+        # the -05:00 event at 04:30 UTC on 03-10 is included too;
+        # the +09:00 event that is 23:00 UTC on 03-09 is excluded.
+        code, lines = self.run_cli("--since", "2024-03-10")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, ["api error 1", "api info 1", "worker error 1", "total 3"])
+
+    def test_boundary_is_inclusive(self):
+        code, lines = self.run_cli("--since", "2024-03-10T00:00:00+00:00")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, ["api error 1", "api info 1", "worker error 1", "total 3"])
+
+    def test_offset_datetime_is_compared_as_instant(self):
+        # 2024-03-10T08:00+09:00 is 2024-03-09T23:00Z, so a cutoff of 23:30Z excludes it
+        # but a cutoff of 22:30Z includes it.
+        _, lines = self.run_cli("--since", "2024-03-09T23:30:00+00:00")
+        self.assertEqual(lines, ["api error 1", "api info 1", "worker error 1", "total 3"])
+        _, lines = self.run_cli("--since", "2024-03-09T22:30:00+00:00")
+        self.assertEqual(lines, ["api error 1", "api info 2", "worker error 1", "total 4"])
+
+    def test_future_date_gives_zero_total(self):
+        code, lines = self.run_cli("--since", "2030-01-01")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, ["total 0"])
+
+    def test_invalid_date_is_clear_error_not_traceback(self):
+        code, err = self.run_cli_expecting_exit("--since", "2024-13-45")
+        self.assertEqual(code, 2)
+        self.assertIn("invalid --since value '2024-13-45'", err)
+        self.assertIn("usage:", err)
+        self.assertNotIn("Traceback", err)
+
+    def test_garbage_value_is_clear_error(self):
+        code, err = self.run_cli_expecting_exit("--since", "yesterday")
+        self.assertEqual(code, 2)
+        self.assertIn("invalid --since value 'yesterday'", err)
+        self.assertNotIn("Traceback", err)
+
+    def test_missing_value_is_clear_error(self):
+        code, err = self.run_cli_expecting_exit("--since")
+        self.assertEqual(code, 2)
+        self.assertIn("--since", err)
+        self.assertNotIn("Traceback", err)
+
+
+class ParseTimestampTest(unittest.TestCase):
+    def test_naive_is_utc(self):
+        ts = parse_timestamp("2024-03-10 12:00:00")
+        self.assertEqual(ts.utcoffset().total_seconds(), 0)
+
+    def test_aware_keeps_offset(self):
+        ts = parse_timestamp("2024-03-10T12:00:00+09:00")
+        self.assertEqual(ts.utcoffset().total_seconds(), 9 * 3600)
+
+
+if __name__ == "__main__":
+    unittest.main()
