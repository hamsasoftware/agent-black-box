+        self.assertEqual(cache.get("fast"), "fast:2")
+        self.assertEqual(len(cache), 1)
+        cache.invalidate("fast")
+        self.assertEqual(len(cache), 0)
+        self.assertEqual(cache.invalidate_all(), 0)
+        self.assertEqual(cache.stats()["loads"], 2)
