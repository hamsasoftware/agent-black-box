+"""Tests for the guarantees in docs/CONTRACT.md. Waiting in these tests is on events, never on sleeps; the
+only polling is `wait_until`, which watches the cache's own bookkeeping so a test knows a thread is blocked."""
+import threading
+import time
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import DeadlockError, Stats, TTLCache
+
+
+def wait_until(predicate, limit=5.0):
+    deadline = time.monotonic() + limit
+    while not predicate():
+        if time.monotonic() > deadline:
+            raise AssertionError("condition was not reached")
+        time.sleep(0.001)
+
+
+def start(fn):
+    """Run fn in a thread; return (thread, box) where box holds 'value' or 'error' once it ends."""
+    box = {}
+
+    def run():
+        try:
+            box["value"] = fn()
+        except BaseException as exc:  # the test inspects every outcome
+            box["error"] = exc
+
+    thread = threading.Thread(target=run, daemon=True)
+    thread.start()
+    return thread, box
+
+
+def finish(thread, box):
+    thread.join(5)
+    if thread.is_alive():
+        raise AssertionError("thread did not finish: the cache is hanging")
+    return box
+
+
+class GatedLoader:
+    """Returns f"{key}:{n}" where n counts calls. Calls for keys in `gated` block until `release` is set."""
+
+    def __init__(self, gated=()):
+        self.gated = set(gated)
+        self.release = threading.Event()
+        self.entered = threading.Event()
+        self.calls = 0
+        self.lock = threading.Lock()
+
+    def __call__(self, key):
+        with self.lock:
+            self.calls += 1
+            n = self.calls
+        if key in self.gated:
+            self.entered.set()
+            self.release.wait(5)
+        return f"{key}:{n}"
+
+
+class ValidationTest(unittest.TestCase):
+    def test_bad_ttl_is_rejected(self):
+        for ttl in (0, -1, True, float("nan")):
+            with self.subTest(ttl=ttl), self.assertRaises(ValueError):
+                TTLCache(lambda k: k, ttl=ttl)
+
+    def test_bad_max_size_is_rejected(self):
+        for max_size in (0, -3, 1.5, True, "10"):
+            with self.subTest(max_size=max_size), self.assertRaises(ValueError):
+                TTLCache(lambda k: k, ttl=1, max_size=max_size)
+
+    def test_bad_stale_grace_is_rejected(self):
+        for grace in (0, -1, float("nan"), True):
+            with self.subTest(stale_grace=grace), self.assertRaises(ValueError):
+                TTLCache(lambda k: k, ttl=1, stale_grace=grace)
+
+    def test_negative_timeout_raises_and_is_not_counted(self):
+        cache = TTLCache(lambda k: k, ttl=1)
+        with self.assertRaises(ValueError):
+            cache.get("a", timeout=-0.1)
+        self.assertEqual(cache.stats(extended=True), Stats().snapshot(extended=True))
+
+    def test_exports(self):
+        self.assertTrue(issubclass(DeadlockError, RuntimeError))
+        self.assertIsNot(DeadlockError, RuntimeError)
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_gets_cause_one_load(self):
+        loader = GatedLoader(gated={"k"})
+        cache = TTLCache(loader, ttl=60)
+        owner, owner_box = start(lambda: cache.get("k"))
+        self.assertTrue(loader.entered.wait(5))
+        others = [start(lambda: cache.get("k")) for _ in range(7)]
+        wait_until(lambda: len(cache._waiting) == 7)
+        loader.release.set()
+        results = [finish(owner, owner_box)] + [finish(*o) for o in others]
+        self.assertEqual({r["value"] for r in results}, {"k:1"})
+        self.assertEqual(loader.calls, 1)
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 8, "loads": 1, "failures": 0})
+
+    def test_expired_value_is_not_served_while_refresh_is_in_flight(self):
+        clock = FakeClock()
+        loader = GatedLoader(gated=set())
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("a"), "a:1")
+        clock.advance(10)  # exactly ttl old: expired
+        loader.gated.add("a")
+        refresh, refresh_box = start(lambda: cache.get("a"))
+        self.assertTrue(loader.entered.wait(5))
+        with self.assertRaises(TimeoutError):  # must not return the expired "a:1"
+            cache.get("a", timeout=0)
+        loader.release.set()
+        self.assertEqual(finish(refresh, refresh_box)["value"], "a:2")
+        self.assertEqual(cache.get("a"), "a:2")
+
+    def test_entry_expires_exactly_at_ttl(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: clock.now, ttl=10, clock=clock)
+        cache.get("a")
+        clock.advance(10 - 1e-9)
+        self.assertEqual(cache.get("a"), 0.0)  # still valid just before the ttl
+        clock.advance(1e-9)
+        self.assertEqual(cache.get("a"), 10.0)  # expired at exactly ttl
+
+    def test_loaded_at_is_read_after_the_loader_returns(self):
+        clock = FakeClock()
+
+        def slow(key):
+            clock.advance(8)  # the load itself takes 8 seconds of clock time
+            return key
+
+        cache = TTLCache(slow, ttl=10, clock=clock)
+        cache.get("a")
+        clock.advance(9)  # 9 s after the store, 17 s after the call started: still valid
+        self.assertEqual(cache.get("a"), "a")
+        self.assertEqual(cache.stats()["loads"], 1)
+
+
+class FailureTest(unittest.TestCase):
+    def test_waiters_receive_the_same_exception_object(self):
+        error = ValueError("boom")
+        loader = GatedLoader(gated={"k"})
+
+        def failing(key):
+            loader(key)
+            raise error
+
+        cache = TTLCache(failing, ttl=60)
+        owner, owner_box = start(lambda: cache.get("k"))
+        self.assertTrue(loader.entered.wait(5))
+        waiter, waiter_box = start(lambda: cache.get("k"))
+        wait_until(lambda: len(cache._waiting) == 1)
+        loader.release.set()
+        self.assertIs(finish(owner, owner_box)["error"], error)
+        self.assertIs(finish(waiter, waiter_box)["error"], error)
+        self.assertEqual(loader.calls, 1)
+        self.assertEqual(cache.stats(extended=True)["failures"], 1)
+
+    def test_a_failure_leaves_no_trace_and_a_retry_loads_again(self):
+        state = {"fail": True}
+
+        def loader(key):
+            if state["fail"]:
+                raise KeyError(key)
+            return "ok"
+
+        cache = TTLCache(loader, ttl=60)
+        with self.assertRaises(KeyError):
+            cache.get("a")
+        self.assertEqual(len(cache), 0)
+        state["fail"] = False
+        self.assertEqual(cache.get("a"), "ok")
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 2, "loads": 2, "failures": 1})
+
+    def test_base_exception_from_loader_does_not_leave_waiters_hanging(self):
+        loader = GatedLoader(gated={"k"})
+
+        def interrupted(key):
+            loader(key)
+            raise KeyboardInterrupt()
+
+        cache = TTLCache(interrupted, ttl=60)
+        owner, owner_box = start(lambda: cache.get("k"))
+        self.assertTrue(loader.entered.wait(5))
+        waiter, waiter_box = start(lambda: cache.get("k"))
+        wait_until(lambda: len(cache._waiting) == 1)
+        loader.release.set()
+        self.assertIsInstance(finish(owner, owner_box)["error"], KeyboardInterrupt)
+        self.assertIsInstance(finish(waiter, waiter_box)["error"], KeyboardInterrupt)
+
+
+class ValueTest(unittest.TestCase):
+    def test_falsy_and_none_values_are_stored_and_served(self):
+        for value in (None, 0, "", False):
+            with self.subTest(value=value):
+                calls = []
+
+                def loader(key, value=value):
+                    calls.append(key)
+                    return value
+
+                cache = TTLCache(loader, ttl=60)
+                self.assertIs(cache.get("k"), value)
+                self.assertIs(cache.get("k"), value)
+                self.assertEqual(len(calls), 1)
+
+
+class RecursionTest(unittest.TestCase):
+    def test_loader_getting_its_own_key_raises_runtime_error(self):
+        cache = None
+
+        def loader(key):
+            return cache.get(key)
+
+        cache = TTLCache(loader, ttl=60)
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertIs(type(ctx.exception), RuntimeError)
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 0)
+
+    def test_longer_chain_in_one_thread_raises_runtime_error(self):
+        cache = None
+
+        def loader(key):
+            return cache.get("b" if key == "a" else "a")
+
+        cache = TTLCache(loader, ttl=60)
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertIs(type(ctx.exception), RuntimeError)
+
+    def test_loader_may_get_another_key(self):
+        cache = None
+
+        def loader(key):
+            return ("outer", cache.get("inner")) if key == "outer" else "inner-value"
+
+        cache = TTLCache(loader, ttl=60)
+        self.assertEqual(cache.get("outer"), ("outer", "inner-value"))
+
+
+class DeadlockTest(unittest.TestCase):
+    def test_cycle_across_two_threads_raises_deadlock_error(self):
+        b_entered = threading.Event()
+        go_b = threading.Event()
+
+        def loader(key):
+            if key == "b":
+                b_entered.set()
+                go_b.wait(5)
+                return cache.get("a", timeout=0)  # closes the cycle: thread 1 is waiting on b
+            return cache.get("b", timeout=5)
+
+        cache = TTLCache(loader, ttl=60)
+        t2, box2 = start(lambda: cache.get("b"))
+        self.assertTrue(b_entered.wait(5))
+        t1, box1 = start(lambda: cache.get("a"))
+        wait_until(lambda: len(cache._waiting) == 1)
+        go_b.set()
+        self.assertIsInstance(finish(t2, box2)["error"], DeadlockError)
+        self.assertIsInstance(finish(t1, box1)["error"], DeadlockError)
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 1)
+
+    def test_waiting_that_completes_no_cycle_is_normal(self):
+        b_entered = threading.Event()
+        release_b = threading.Event()
+
+        def loader(key):
+            if key == "b":
+                b_entered.set()
+                release_b.wait(5)
+                return "B"
+            return ("A", cache.get("b"))
+
+        cache = TTLCache(loader, ttl=60)
+        t2, box2 = start(lambda: cache.get("b"))
+        self.assertTrue(b_entered.wait(5))
+        t1, box1 = start(lambda: cache.get("a"))
+        wait_until(lambda: len(cache._waiting) == 1)
+        release_b.set()
+        self.assertEqual(finish(t2, box2)["value"], "B")
+        self.assertEqual(finish(t1, box1)["value"], ("A", "B"))
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 0)
+
+
+class TimeoutTest(unittest.TestCase):
+    def test_waiter_times_out_and_the_load_still_completes(self):
+        loader = GatedLoader(gated={"k"})
+        cache = TTLCache(loader, ttl=60)
+        owner, owner_box = start(lambda: cache.get("k"))
+        self.assertTrue(loader.entered.wait(5))
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0.01)
+        self.assertEqual(cache.stats(extended=True)["timeouts"], 1)
+        loader.release.set()
+        self.assertEqual(finish(owner, owner_box)["value"], "k:1")
+        self.assertEqual(cache.get("k"), "k:1")
+        self.assertEqual(loader.calls, 1)
+
+    def test_timeout_zero_raises_at_once_when_it_would_wait(self):
+        loader = GatedLoader(gated={"k"})
+        cache = TTLCache(loader, ttl=60)
+        owner, owner_box = start(lambda: cache.get("k"))
+        self.assertTrue(loader.entered.wait(5))
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0)
+        loader.release.set()
+        finish(owner, owner_box)
+
+    def test_timeout_does_not_limit_the_owner_or_a_hit(self):
+        cache = TTLCache(lambda k: k.upper(), ttl=60)
+        self.assertEqual(cache.get("x", timeout=0), "X")  # nothing in flight: it runs the loader itself
+        self.assertEqual(cache.get("x", timeout=0), "X")  # valid entry: a hit, never waits
+        self.assertEqual(cache.stats(extended=True)["timeouts"], 0)
+
+    def test_timed_out_waiter_does_not_fail_the_other_waiters(self):
+        loader = GatedLoader(gated={"k"})
+        cache = TTLCache(loader, ttl=60)
+        owner, owner_box = start(lambda: cache.get("k"))
+        self.assertTrue(loader.entered.wait(5))
+        patient, patient_box = start(lambda: cache.get("k", timeout=None))
+        wait_until(lambda: len(cache._waiting) == 1)
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0)
+        loader.release.set()
+        self.assertEqual(finish(patient, patient_box)["value"], "k:1")
+        self.assertEqual(finish(owner, owner_box)["value"], "k:1")
+
+
+class StaleTest(unittest.TestCase):
+    def test_stale_value_is_served_when_the_reload_fails(self):
+        clock = FakeClock()
+        state = {"fail": False}
+
+        def loader(key):
+            if state["fail"]:
+                raise OSError("down")
+            return f"{key}:{clock.now}"
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        self.assertEqual(cache.get("a"), "a:0.0")
+        clock.advance(10)  # stale from here until 15
+        state["fail"] = True
+        self.assertEqual(cache.get("a"), "a:0.0")
+        self.assertEqual(cache.get("a"), "a:0.0")  # still stale, the entry itself is unchanged
+        stats = cache.stats(extended=True)
+        self.assertEqual((stats["stale_served"], stats["failures"], stats["loads"]), (2, 2, 3))
+        clock.advance(5)  # age 15 == ttl + grace: no longer stale
+        with self.assertRaises(OSError):
+            cache.get("a")
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 2)
+
+    def test_waiters_get_the_stale_value_too(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        entered = threading.Event()
+        state = {"fail": False}
+
+        def loader(key):
+            if not state["fail"]:
+                return "fresh"
+            entered.set()
+            gate.wait(5)
+            raise OSError("down")
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("a")
+        clock.advance(10)
+        state["fail"] = True
+        owner, owner_box = start(lambda: cache.get("a"))
+        self.assertTrue(entered.wait(5))
+        waiter, waiter_box = start(lambda: cache.get("a"))
+        wait_until(lambda: len(cache._waiting) == 1)
+        gate.set()
+        self.assertEqual(finish(owner, owner_box)["value"], "fresh")
+        self.assertEqual(finish(waiter, waiter_box)["value"], "fresh")
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 2)
+
+    def test_invalidated_entry_is_not_served_stale(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        entered = threading.Event()
+        state = {"fail": False}
+
+        def loader(key):
+            if not state["fail"]:
+                return "fresh"
+            entered.set()
+            gate.wait(5)
+            raise OSError("down")
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("a")
+        clock.advance(10)
+        state["fail"] = True
+        owner, owner_box = start(lambda: cache.get("a"))
+        self.assertTrue(entered.wait(5))
+        cache.invalidate("a")  # the entry is gone before the failure is recorded
+        gate.set()
+        self.assertIsInstance(finish(owner, owner_box)["error"], OSError)
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 0)
+
+
+class BoundTest(unittest.TestCase):
+    def test_lru_protects_in_flight_keys_as_in_the_contract_example(self):
+        clock = FakeClock()
+        loader = GatedLoader(gated=set())
+        cache = TTLCache(loader, ttl=10, clock=clock, max_size=1)
+        self.assertEqual(cache.get("a"), "a:1")
+        clock.advance(10)
+        loader.gated.add("a")
+        refresh, refresh_box = start(lambda: cache.get("a"))
+        self.assertTrue(loader.entered.wait(5))
+        loader.gated.discard("a")
+        self.assertEqual(cache.get("c"), "c:3")  # stored, then evicted at once: "a" is protected
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+        loader.release.set()
+        self.assertEqual(finish(refresh, refresh_box)["value"], "a:2")
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.get("c"), "c:4")  # c was evicted, so this is a new load
+
+    def test_least_recently_used_goes_first(self):
+        cache = TTLCache(lambda k: k, ttl=60, max_size=2)
+        cache.get("a")
+        cache.get("b")
+        cache.get("a")  # a is now more recent than b
+        cache.get("c")  # evicts b
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+        calls = []
+        cache2 = TTLCache(lambda k: calls.append(k) or k, ttl=60, max_size=2)
+        cache2.get("a")
+        cache2.get("b")
+        cache2.get("a")
+        cache2.get("c")
+        cache2.get("a")  # hit: a survived
+        cache2.get("b")  # miss: b was evicted
+        self.assertEqual(calls, ["a", "b", "c", "b"])
+
+    def test_replacing_an_entry_does_not_grow_the_cache(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock, max_size=1)
+        cache.get("a")
+        clock.advance(10)
+        cache.get("a")
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+
+
+class InvalidateTest(unittest.TestCase):
+    def test_invalidate_all_returns_count_including_expired(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock)
+        cache.get("a")
+        cache.get("b")
+        clock.advance(10)
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.invalidate_all(), 2)
+        self.assertEqual(len(cache), 0)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+        self.assertIsNone(cache.invalidate("zzz"))
+
+    def test_invalidate_during_a_load_still_stores_the_result(self):
+        loader = GatedLoader(gated={"a"})
+        cache = TTLCache(loader, ttl=60)
+        owner, owner_box = start(lambda: cache.get("a"))
+        self.assertTrue(loader.entered.wait(5))
+        cache.invalidate("a")
+        loader.release.set()
+        self.assertEqual(finish(owner, owner_box)["value"], "a:1")
+        self.assertEqual(cache.get("a"), "a:1")
+        self.assertEqual(loader.calls, 1)
+
+    def test_len_does_not_count_a_load_without_an_entry(self):
+        loader = GatedLoader(gated={"a"})
+        cache = TTLCache(loader, ttl=60)
+        owner, owner_box = start(lambda: cache.get("a"))
