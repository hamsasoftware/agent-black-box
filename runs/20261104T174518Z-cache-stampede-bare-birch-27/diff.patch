+            {"hits", "misses", "loads", "failures", "evictions", "stale_served", "timeouts", "deadlocks"},
+        )
+
+    def test_extended_counters_are_zero_on_a_fresh_cache(self):
+        cache = TTLCache(lambda k: k, ttl=60)
+        self.assertEqual(cache.stats(extended=True), dict.fromkeys(cache.stats(extended=True), 0))
+
+    def test_every_call_is_counted_once_as_hit_or_miss(self):
+        cache = TTLCache(lambda k: k, ttl=60)
+        for key in ("a", "a", "b", "a"):
+            cache.get(key)
+        stats = cache.stats()
+        self.assertEqual(stats["hits"] + stats["misses"], 4)
+        self.assertEqual((stats["hits"], stats["misses"], stats["loads"]), (2, 2, 2))
+
