+class StorageTest(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = os.path.join(self.dir.name, "order.json")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def write(self, data):
+        with open(self.path, "w", encoding="utf-8") as handle:
+            json.dump(data, handle)
+
+    def test_save_writes_schema_2(self):
+        storage.save(Order([Item("MUG-01", "0.35", 2)]), self.path)
+        with open(self.path, encoding="utf-8") as handle:
+            data = json.load(handle)
+        self.assertEqual(data["schema"], 2)
+        self.assertEqual(data["items"], [{"sku": "MUG-01", "weight_kg": "0.350", "qty": 2}])
+
+    def test_loads_schema_1_exactly(self):
+        self.write({"schema": 1, "items": [{"sku": "MUG-01", "weight_g": 350, "qty": 2}]})
+        order = storage.load(self.path)
+        self.assertEqual(order.items[0].weight_kg, "0.350")
+
+    def test_schema_2_is_normalised(self):
+        self.write({"schema": 2, "items": [{"sku": "A", "weight_kg": "1.5", "qty": 1}]})
+        self.assertEqual(storage.load(self.path).items[0].weight_kg, "1.500")
+
+    def test_invalid_weight_in_either_schema(self):
+        self.write({"schema": 1, "items": [{"sku": "A", "weight_g": -1}]})
+        with self.assertRaises(WeightError):
+            storage.load(self.path)
+        self.write({"schema": 2, "items": [{"sku": "A", "weight_kg": "1e3"}]})
+        with self.assertRaises(WeightError):
+            storage.load(self.path)
+
+    def test_unknown_schema(self):
+        self.write({"schema": 3, "items": []})
+        with self.assertRaises(ValueError):
+            storage.load(self.path)
+
+
+if __name__ == "__main__":
+    unittest.main()
