index f69aa94..f8bcc04 100644
--- a/shipcalc/units.py
+++ b/shipcalc/units.py
@@ -1,8 +1,41 @@
-"""Weight helpers. Weights are whole grams (int) everywhere in the package."""
+"""Weight helpers. Weights are kilograms as canonical decimal strings (see docs/MIGRATION.md)."""
+import re
+from decimal import ROUND_HALF_EVEN, Decimal, localcontext
 
+_THOUSANDTH = Decimal("0.001")
+_ACCEPTED = re.compile(r"[0-9]+(?:\.[0-9]+)?")
 
-def to_grams(value):
-    """Return value if it is a valid weight in grams, else raise ValueError."""
-    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
-        raise ValueError(f"invalid weight: {value!r}")
-    return value
+
+class WeightError(ValueError):
+    """An invalid weight, or a total over the carrier limit."""
+
+
+def _invalid(value):
+    return WeightError(f"invalid weight: {value!r}")
+
+
+def to_canonical(value):
+    """Round a Decimal to three places (half to even) and return its canonical string."""
+    with localcontext() as ctx:
+        ctx.prec = max(28, len(str(value)) + 10)
+        rounded = Decimal(value).quantize(_THOUSANDTH, rounding=ROUND_HALF_EVEN)
+    return format(rounded, "f")
+
+
+def normalize_kg(value):
+    """Return value as a canonical kilogram string, else raise WeightError."""
+    if not isinstance(value, str) or not _ACCEPTED.fullmatch(value):
+        raise _invalid(value)
+    return to_canonical(Decimal(value))
+
+
+def kg_to_g(value):
+    """Return the exact whole number of grams in a weight, as an int."""
+    return int(normalize_kg(value).replace(".", ""))
+
+
+def g_to_kg(grams):
+    """Return a whole number of grams as a canonical kilogram string."""
+    if isinstance(grams, bool) or not isinstance(grams, int) or grams < 0:
+        raise _invalid(grams)
+    return f"{grams // 1000}.{grams % 1000:03d}"
