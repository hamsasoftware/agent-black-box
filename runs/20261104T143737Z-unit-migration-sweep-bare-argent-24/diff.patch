+import unittest
+
+from shipcalc import calc, cache, export, format as fmt, limits, reports, storage, validate
+from shipcalc.models import Item, Order
+from shipcalc.rates import shipping_cents
+from shipcalc.units import WeightError, g_to_kg, kg_to_g, normalize_kg
+
+
+class UnitsTest(unittest.TestCase):
+    def test_accepted_input(self):
+        self.assertEqual(normalize_kg("2"), "2.000")
+        self.assertEqual(normalize_kg("1.5"), "1.500")
+        self.assertEqual(normalize_kg("1.2345"), "1.234")
+
+    def test_half_to_even(self):
+        self.assertEqual(normalize_kg("1.0005"), "1.000")
+        self.assertEqual(normalize_kg("1.0015"), "1.002")
+        self.assertEqual(normalize_kg("2.0025"), "2.002")
+
+    def test_invalid_input(self):
+        for bad in ["-1", "+1", "1e3", "nan", "inf", "", " 1", "1 ", "1,5", "1.", ".5", ".", "1\n"]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+        for bad in [1, 1.5, True, None]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                normalize_kg(bad)
+
+    def test_error_message(self):
+        with self.assertRaises(WeightError) as ctx:
+            normalize_kg("abc")
+        self.assertEqual(str(ctx.exception), "invalid weight: 'abc'")
+        with self.assertRaises(ValueError) as ctx:
+            normalize_kg(1500)
+        self.assertEqual(str(ctx.exception), "invalid weight: 1500")
+
+    def test_grams_conversions(self):
+        self.assertEqual(g_to_kg(1250), "1.250")
+        self.assertEqual(kg_to_g("1.25"), 1250)
+        self.assertIs(type(kg_to_g("1.25")), int)
+        for bad in [-1, True, 1.0, "1000"]:
+            with self.subTest(value=bad), self.assertRaises(WeightError):
+                g_to_kg(bad)
+
+
+class LimitsTest(unittest.TestCase):
+    def test_carrier_limit_is_inclusive(self):
+        self.assertEqual(limits.check_total_kg("2147483.647"), "2147483.647")
+        with self.assertRaises(WeightError):
+            limits.check_total_kg("2147483.648")
+
+    def test_order_over_limit_raises_weight_error(self):
+        # 2000000 + 147000 + 483.648 = 2147483.648 kg, just over the limit
+        order = Order([Item("A", "1000.000", 1000), Item("B", "1000.000", 1000),
+                       Item("C", "1000.000", 147), Item("D", "483.648")])
+        with self.assertRaises(WeightError):
+            calc.order_weight_kg(order)
+
+
+class ValidateTest(unittest.TestCase):
+    def valid(self, **overrides):
+        data = {"sku": "MUG-01", "weight_kg": "0.350", "qty": 2}
+        data.update(overrides)
+        return data
+
+    def test_valid(self):
+        self.assertEqual(validate.validate_item(self.valid()), [])
+
+    def test_weight_range_after_rounding(self):
+        self.assertEqual(validate.validate_item(self.valid(weight_kg="0.0004")),
+                         ["weight_kg: out of range 0.001..1000.000"])
+        self.assertEqual(validate.validate_item(self.valid(weight_kg="1000.0004")), [])
+        self.assertEqual(validate.validate_item(self.valid(weight_kg="1000.0006")),
+                         ["weight_kg: out of range 0.001..1000.000"])
+
+    def test_invalid_weight_is_a_problem(self):
+        problems = validate.validate_item(self.valid(weight_kg="heavy"))
+        self.assertEqual(len(problems), 1)
+        self.assertTrue(problems[0].startswith("weight_kg:"))
+
+    def test_grams_only_record_is_missing_weight_kg(self):
+        data = {"sku": "MUG-01", "weight_g": 350, "qty": 2}
+        self.assertIn("weight_kg: missing", validate.validate_item(data))
+
+
+class ReportsTest(unittest.TestCase):
+    def test_average_rounds_half_to_even(self):
+        # 0.001 kg over 2 units is 0.0005 kg -> 0.000 (even); 0.003 over 2 -> 0.0015 -> 0.002
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.001"), Item("B", "0.000")])), "0.000")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.003"), Item("B", "0.000")])), "0.002")
+        self.assertEqual(reports.average_weight_kg(Order([Item("A", "0.350", 2)])), "0.350")
+
+    def test_average_empty(self):
+        self.assertEqual(reports.average_weight_kg(Order()), "0.000")
+
+    def test_bands_and_heaviest(self):
+        order = Order([Item("A", "0.500"), Item("B", "0.501", 2), Item("C", "2.000"), Item("D", "2.001")])
+        self.assertEqual(reports.weight_bands(order), {"light": 1, "medium": 3, "heavy": 1})
+        self.assertEqual([i.sku for i in reports.heaviest(order, 2)], ["D", "C"])
+
+
+class RatesTest(unittest.TestCase):
+    def test_heavy_surcharge_threshold(self):
+        self.assertEqual(shipping_cents("10.000", "eu"), 400 + 90 * 19)
+        self.assertEqual(shipping_cents("10.001", "eu"), 400 + 90 * 20 + 500)
+
+
+class FormatTest(unittest.TestCase):
+    def test_format_weight(self):
+        self.assertEqual(fmt.format_weight("0.250"), "0.250 kg")
+        self.assertEqual(fmt.format_weight("12.000"), "12.000 kg")
+
+
+class ExportTest(unittest.TestCase):
+    def test_csv_and_payload_are_grams(self):
+        order = Order([Item("MUG-01", "0.350", 2), Item("BOOK-07", "1.200")])
+        self.assertEqual(export.to_csv(order), "sku,weight_g,qty\nMUG-01,350,2\nBOOK-07,1200,1\n")
+        payload = export.carrier_payload(order)
+        self.assertEqual(payload, {"weight_g": 1900, "parcels": 1})
+        self.assertIs(type(payload["weight_g"]), int)
+
+
+class CacheTest(unittest.TestCase):
+    def test_key_is_v2_with_canonical_total(self):
+        order = Order([Item("MUG-01", "0.350", 2), Item("BOOK-07", "1.200")])
+        self.assertEqual(cache.quote_key(order, "eu"), "quote:v2:eu:1.900:2")
+
