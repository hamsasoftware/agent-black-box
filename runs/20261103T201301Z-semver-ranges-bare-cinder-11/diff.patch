+"""npm-style version ranges. The contract is docs/RANGES.md."""
+
+import re
+from functools import lru_cache
+
 from .version import Version
 
+_OPERAND = re.compile(
+    r"^v?([0-9xX*]+(?:\.[0-9xX*]+){0,2})"
+    r"(?:-([0-9A-Za-z.-]+))?"
+    r"(?:\+([0-9A-Za-z.-]+))?$"
+)
+_NUMBER = re.compile(r"0|[1-9]\d*")
+_WILDCARDS = frozenset("xX*")
+_SPLIT_OP = re.compile(r"^(<=|>=|<|>|=|\^|~)?(.*)$", re.DOTALL)
+_NORMALIZE_OP = re.compile(r"(<=|>=|[<>=^~])\s+")
+
+
+class _Operand:
+    """A parsed version or partial version.
+
+    ``given`` holds the leading numeric parts (length 0 to 3). ``floor`` is the
+    version with missing parts as zero. ``version`` is set only for full
+    versions and keeps any prerelease. ``anchor`` is the release tuple when the
+    operand names a prerelease, which the prerelease rule needs.
+    """
+
+    __slots__ = ("given", "floor", "version", "anchor")
+
+    def __init__(self, given, floor, version, anchor):
+        self.given = given
+        self.floor = floor
+        self.version = version
+        self.anchor = anchor
+
+
+def _parse_operand(text):
+    match = _OPERAND.match(text)
+    if not match:
+        raise ValueError(f"invalid version in range: {text!r}")
+    core, pre, build = match.groups()
+    given = []
+    wild = False
+    for part in core.split("."):
+        if part in _WILDCARDS:
+            wild = True
+        elif _NUMBER.fullmatch(part) and not wild:
+            given.append(int(part))
+        else:
+            raise ValueError(f"invalid version in range: {text!r}")
+    if wild and pre:
+        raise ValueError(f"prerelease not allowed on partial version: {text!r}")
+    given = tuple(given)
+    floor = Version(*(given + (0,) * (3 - len(given))))
+    if len(given) == 3:
+        full = Version.parse(
+            f"{'.'.join(map(str, given))}"
+            + (f"-{pre}" if pre else "")
+            + (f"+{build}" if build else "")
+        )
+        anchor = given if pre else None
+        return _Operand(given, floor, full, anchor)
+    return _Operand(given, floor, None, None)
+
+
+def _bump(operand, index):
+    """The version after incrementing position ``index`` and zeroing the rest."""
+    parts = list(operand.given[: index + 1])
+    parts[index] += 1
+    return Version(*(parts + [0] * (3 - len(parts))))
+
+
+def _expand(op, operand):
+    """Turn one operator and operand into primitive (op, bound) comparators.
+
+    The op ``any`` matches every release, ``none`` matches nothing.
+    """
+    k = len(operand.given)
+    exact = operand.version if k == 3 else None
+
+    if op in (None, "="):
+        if k == 3:
+            return [("=", exact)]
+        if k == 0:
+            return [("any", None)]
+        return [(">=", operand.floor), ("<", _bump(operand, k - 1))]
+
+    if op == "<":
+        if k == 0:
+            return [("none", None)]
+        return [("<", exact or operand.floor)]
+
+    if op == "<=":
+        if k == 0:
+            return [("any", None)]
+        if k == 3:
+            return [("<=", exact)]
+        return [("<", _bump(operand, k - 1))]
+
+    if op == ">":
+        if k == 0:
+            return [("none", None)]
+        if k == 3:
+            return [(">", exact)]
+        return [(">=", _bump(operand, k - 1))]
+
+    if op == ">=":
+        if k == 0:
+            return [("any", None)]
+        return [(">=", exact or operand.floor)]
+
+    if op == "~":
+        if k == 0:
+            return [("any", None)]
+        return [(">=", exact or operand.floor), ("<", _bump(operand, min(k, 2) - 1))]
+
+    if op == "^":
+        if k == 0:
+            return [("any", None)]
+        index = next((i for i in range(k) if operand.given[i] != 0), k - 1)
+        return [(">=", exact or operand.floor), ("<", _bump(operand, index))]
+
+    raise ValueError(f"unknown operator: {op!r}")
+
+
+def _parse_comparator_set(text):
+    """Return (comparators, anchors) for one whitespace-separated set."""
+    text = _NORMALIZE_OP.sub(r"\1", text.strip())
+    tokens = text.split()
+    if not tokens:
+        return (("any", None),), frozenset()
+
+    if "-" in tokens:
+        if len(tokens) != 3 or tokens[1] != "-":
+            raise ValueError(f"invalid hyphen range: {text!r}")
+        low, high = tokens[0], tokens[2]
+        if _SPLIT_OP.match(low).group(1) or _SPLIT_OP.match(high).group(1):
+            raise ValueError(f"operators not allowed in hyphen range: {text!r}")
+        lo = _parse_operand(low)
+        hi = _parse_operand(high)
+        comparators = [(">=", lo.floor)]
+        if len(hi.given) == 3:
+            comparators.append(("<=", hi.version))
+        elif hi.given:
+            comparators.append(("<", _bump(hi, len(hi.given) - 1)))
+        anchors = {x.anchor for x in (lo, hi) if x.anchor}
+        return tuple(comparators), frozenset(anchors)
+
+    comparators = []
+    anchors = set()
+    for token in tokens:
+        op, rest = _SPLIT_OP.match(token).groups()
+        operand = _parse_operand(rest)
+        comparators.extend(_expand(op, operand))
+        if operand.anchor:
+            anchors.add(operand.anchor)
+    return tuple(comparators), frozenset(anchors)
+
+
+@lru_cache(maxsize=256)
+def _parse_range(range_):
+    return tuple(_parse_comparator_set(part) for part in range_.split("||"))
+
+
+def _test(op, bound, version):
+    if op == "any":
+        return True
+    if op == "none":
+        return False
+    if op == "=":
+        return version == bound
+    if op == "<":
+        return version < bound
+    if op == "<=":
+        return version <= bound
+    if op == ">":
+        return version > bound
+    if op == ">=":
+        return version >= bound
+    raise ValueError(f"unknown comparator: {op!r}")
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise ValueError(f"invalid version: {version!r}")
+
+
+def _matches(version, parsed):
+    for comparators, anchors in parsed:
+        if version.prerelease and version.release not in anchors:
+            continue
+        if all(_test(op, bound, version) for op, bound in comparators):
+            return True
+    return False
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    """Return True if ``version`` satisfies the npm-style ``range_``."""
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    parsed = _parse_range(range_)
+    return _matches(_coerce(version), parsed)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    """Return the highest of ``versions`` that satisfies ``range_``, or None.
+
+    The result is the item exactly as given, not a normalized copy.
+    """
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    parsed = _parse_range(range_)
+    best = None
+    best_version = None
+    for item in versions:
+        candidate = _coerce(item)
+        if _matches(candidate, parsed) and (best_version is None or candidate > best_version):
+            best, best_version = item, candidate
+    return best
