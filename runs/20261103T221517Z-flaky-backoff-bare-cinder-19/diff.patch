+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _MaxJitterRng:
+    """Always draws the top of the jitter range."""
+
+    def uniform(self, lo, hi):
+        return hi
+
+
+class _MinJitterRng:
+    """Always draws the bottom of the jitter range."""
+
+    def uniform(self, lo, hi):
+        return lo
+
+
+class CapAfterJitterTest(unittest.TestCase):
+    def test_capped_delay_never_exceeds_cap_at_max_jitter(self):
+        # Pre-jitter delay is exactly cap; max jitter would push it to cap * 1.1.
+        delay = compute_delay(3, base=1, cap=4, jitter=0.1, rng=_MaxJitterRng())
+        self.assertLessEqual(delay, 4)
+
+    def test_uncapped_delay_still_gets_jitter(self):
+        delay = compute_delay(1, base=1, cap=100, jitter=0.1, rng=_MaxJitterRng())
+        self.assertAlmostEqual(delay, 1.1)
+
+    def test_delay_is_never_negative(self):
+        delay = compute_delay(1, base=1, cap=100, jitter=1.0, rng=_MinJitterRng())
+        self.assertGreaterEqual(delay, 0)
+
+    def test_schedule_respects_cap_across_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34, f"seed={seed}")
+                self.assertGreaterEqual(delay, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
