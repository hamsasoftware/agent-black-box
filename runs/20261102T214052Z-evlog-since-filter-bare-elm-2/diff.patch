 import argparse
 import sys
+from datetime import datetime, timezone
 
 from .events import count_events, read_events
 
 
+def parse_since(text):
+    try:
+        value = datetime.fromisoformat(text)
+    except ValueError:
+        raise argparse.ArgumentTypeError(
+            f"invalid --since value {text!r}: expected ISO date or datetime, e.g. 2024-03-10 or 2024-03-10T12:00:00+00:00"
+        )
+    return as_utc(value)
+
+
+def as_utc(ts):
+    # Timestamps without an offset are treated as UTC.
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts
+
+
 def build_parser():
     parser = argparse.ArgumentParser(prog="evlog")
     commands = parser.add_subparsers(dest="command", required=True)
     report = commands.add_parser("report", help="count events per service and level")
     report.add_argument("path", help="events file (JSON lines)")
+    report.add_argument(
+        "--since",
+        type=parse_since,
+        help="only count events at or after this ISO date/datetime (no offset = UTC)",
+    )
     return parser
 
 
@@ -20,8 +43,15 @@ def render(counts):
 
 def main(argv=None, out=None):
     out = out or sys.stdout
-    args = build_parser().parse_args(argv)
+    parser = build_parser()
+    args = parser.parse_args(argv)
     if args.command == "report":
-        counts = count_events(read_events(args.path))
+        events = read_events(args.path)
+        if args.since is not None:
+            events = (e for e in events if as_utc(e.ts) >= args.since)
+        try:
+            counts = count_events(events)
+        except OSError as exc:
+            parser.error(f"cannot read {args.path}: {exc.strerror}")
         print(render(counts), file=out)
     return 0
