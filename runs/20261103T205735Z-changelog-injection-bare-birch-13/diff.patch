@@ -0,0 +1,21 @@
+import unittest
+
+from relnotes import render_release
+
+
+class ExtraTest(unittest.TestCase):
+    def test_two_comments_one_line_keep_text_between(self):
+        text = "## [1.0.0] - 2024-01-01\n- a <!-- x --> b <!-- y -->\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a  b\n")
+
+    def test_comment_with_heading_inside(self):
+        text = "## [1.0.0] - 2024-01-01\n- a\n<!--\n## [bogus]\n-->\n## [0.9.0] - 2023-01-01\n- b\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n")
+
+    def test_crlf(self):
+        text = "## [1.0.0] - 2024-01-01\r\n- a <!-- x -->\r\n"
+        self.assertEqual(render_release(text, "1.0.0"), "# 1.0.0 (2024-01-01)\n\n- a\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
