+import operator
+import re
+
 from .version import Version
 
+_NUM = re.compile(r"0|[1-9]\d*")
+_WILD = frozenset({"x", "X", "*"})
+_BUILD = re.compile(r"[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*")
+
+# Operators that may be written apart from their version (">= 1.2.3").
+_OPERATORS = ("<=", ">=", "<", ">", "=", "~", "^")
+_BARE_OPERATORS = frozenset(_OPERATORS)
+
+_COMPARE = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+# Lowest possible prerelease: matches nothing, used for `>*` and `<*`.
+_NOTHING = Version(0, 0, 0, ("0",))
+
+
+def _coerce(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError(f"invalid version: {version!r}")
+    return Version.parse(version)
+
+
+def _split_operator(token):
+    for op in _OPERATORS:
+        if token.startswith(op):
+            return op, token[len(op):]
+    return "", token
+
+
+def _parse_version_text(text):
+    """Return a full Version, or the list [major, minor, patch] with None for
+    wildcards and missing positions."""
+    body = text[1:] if text.startswith("v") else text
+    body, plus, build = body.partition("+")
+    if plus and not _BUILD.fullmatch(build):
+        raise ValueError(f"invalid version: {text!r}")
+    core, dash, _pre = body.partition("-")
+    pieces = core.split(".") if core else []
+    if len(pieces) > 3:
+        raise ValueError(f"invalid version: {text!r}")
+
+    parts = []
+    wild = False
+    for piece in pieces:
+        if piece in _WILD:
+            wild = True
+            parts.append(None)
+        elif wild or not _NUM.fullmatch(piece):
+            raise ValueError(f"invalid version: {text!r}")
+        else:
+            parts.append(int(piece))
+    parts += [None] * (3 - len(parts))
+
+    if None not in parts:
+        return Version.parse(text)  # validates the prerelease and build too
+    if dash:
+        raise ValueError(f"prerelease needs a full version: {text!r}")
+    return parts
+
+
+def _comparator(op, text):
+    """Expand one comparator into primitive (operator, Version) pairs."""
+    op = op or "="
+    parsed = _parse_version_text(text)
+
+    if isinstance(parsed, Version):
+        if op not in ("~", "^"):
+            return [(op, parsed)]
+        lo = parsed
+        parts = [parsed.major, parsed.minor, parsed.patch]
+    else:
+        parts = parsed
+        if parts[0] is None:  # any version
+            if op in (">", "<"):
+                return [("<", _NOTHING)]
+            return []
+        nums = [p or 0 for p in parts]
+        lo = Version(*nums)
+        last = max(i for i, p in enumerate(parts) if p is not None)
+        bumped = list(nums)
+        bumped[last] += 1
+        for j in range(last + 1, 3):
+            bumped[j] = 0
+        hi = Version(*bumped)
+        if op == ">":
+            return [(">=", hi)]
+        if op == "<=":
+            return [("<", hi)]
+        if op == "=":
+            return [(">=", lo), ("<", hi)]
+        if op == ">=":
+            return [(">=", lo)]
+        if op == "<":
+            return [("<", lo)]
+        # "~" and "^" continue below with lo and parts
+
+    major, minor, patch = parts
+    if op == "~":
+        if minor is None:
+            upper = (major + 1, 0, 0)
+        else:
+            upper = (major, minor + 1, 0)
+    elif op == "^":
+        if major != 0:
+            upper = (major + 1, 0, 0)
+        elif minor is None:
+            upper = (1, 0, 0)
+        elif minor != 0:
+            upper = (0, minor + 1, 0)
+        elif patch is None:
+            upper = (0, 1, 0)
+        else:
+            upper = (0, 0, patch + 1)
+    else:
+        raise ValueError(f"unknown operator: {op!r}")
+    return [(">=", lo), ("<", Version(*upper))]
+
+
+def _parse_range(range_):
+    """Parse a range into a list of comparator sets, each a list of primitives."""
+    if not isinstance(range_, str):
+        raise ValueError(f"invalid range: {range_!r}")
+    sets = []
+    for set_text in range_.split("||"):
+        tokens = set_text.split()
+        items = []  # (op, text) pairs, or ("-", left, right) for hyphen ranges
+        i = 0
+        while i < len(tokens):
+            token = tokens[i]
+            if token == "-":
+                if not items or items[-1][0] != "" or i + 1 >= len(tokens):
+                    raise ValueError(f"invalid range: {range_!r}")
+                right = tokens[i + 1]
+                if right in _BARE_OPERATORS or right == "-" or _split_operator(right)[0]:
+                    raise ValueError(f"invalid range: {range_!r}")
+                left = items.pop()[1]
+                items.append(("-", left, right))
+                i += 2
+            elif token in _BARE_OPERATORS:
+                if i + 1 >= len(tokens) or tokens[i + 1] in _BARE_OPERATORS or tokens[i + 1] == "-":
+                    raise ValueError(f"invalid range: {range_!r}")
+                items.append((token, tokens[i + 1]))
+                i += 2
+            else:
+                items.append(_split_operator(token))
+                i += 1
+
+        prims = []
+        for item in items:
+            if item[0] == "-":
+                prims += _comparator(">=", item[1])
+                prims += _comparator("<=", item[2])
+            else:
+                prims += _comparator(*item)
+        sets.append(prims)
+    return sets
+
+
+def _set_matches(version, prims):
+    if version.prerelease:
+        # A prerelease only matches if the set names its release with a prerelease.
+        if not any(p.prerelease and p.release == version.release for _, p in prims):
+            return False
+    return all(_COMPARE[op](version, bound) for op, bound in prims)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    v = _coerce(version)
+    return any(_set_matches(v, prims) for prims in _parse_range(range_))
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_version = None, None
+    for item in versions:
+        v = _coerce(item)
+        if best_version is not None and not v > best_version:
+            continue
+        if any(_set_matches(v, prims) for prims in sets):
+            best, best_version = item, v
+    return best
