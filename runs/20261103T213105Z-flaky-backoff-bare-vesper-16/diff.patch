+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class _FixedFactor:
+    """Stand-in rng whose uniform() always returns the given factor's endpoint."""
+
+    def __init__(self, factor):
+        self.factor = factor
+
+    def uniform(self, lo, hi):
+        return self.factor
+
+
+class CapPolicyTest(unittest.TestCase):
+    # docs/RETRY.md: jitter is applied first, then the result is clamped to [0, cap].
+
+    def test_maximum_jitter_cannot_exceed_cap(self):
+        # 32 * 1.1 = 35.2 would exceed cap=34 if the clamp ran before jitter.
+        delay = compute_delay(7, base=0.5, cap=34, jitter=0.1, rng=_FixedFactor(1.1))
+        self.assertEqual(delay, 34)
+
+    def test_minimum_jitter_stays_non_negative(self):
+        delay = compute_delay(1, base=0.5, cap=34, jitter=0.1, rng=_FixedFactor(0.0))
+        self.assertEqual(delay, 0.0)
+
+    def test_schedule_respects_cap_across_many_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertLessEqual(delay, 34, f"seed={seed} delay={delay}")
+                self.assertGreaterEqual(delay, 0)
+
+    def test_uncapped_delay_keeps_jitter_range(self):
+        delay = compute_delay(2, base=1, cap=100, jitter=0.2, rng=_FixedFactor(1.2))
+        self.assertAlmostEqual(delay, 2 * 1.2)
+
+
+if __name__ == "__main__":
+    unittest.main()
