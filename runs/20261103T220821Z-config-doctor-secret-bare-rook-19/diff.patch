--- /dev/null
+++ b/payhook/doctor.py
@@ -0,0 +1,48 @@
+import os
+import platform
+
+from .config import REQUIRED_KEYS, SECRET_KEYS, load_config, read_dotenv_details
+
+
+def mask_secret(value):
+    """Show only the length and last 4 characters of a secret."""
+    if value is None:
+        return "<unset>"
+    tail = value[-4:] if len(value) > 8 else ""
+    return f"'{'*' * max(len(value) - len(tail), 0)}{tail}' (length {len(value)})"
+
+
+def render(environ=None, dotenv_path=".env"):
+    environ = os.environ if environ is None else environ
+    dotenv_abs = os.path.abspath(dotenv_path)
+    _, ignored = read_dotenv_details(dotenv_path)
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+
+    lines = [
+        "payhook doctor",
+        f"python: {platform.python_version()}",
+        f"working directory: {os.getcwd()}",
+        f"dotenv file: {dotenv_abs} ({'found' if os.path.exists(dotenv_abs) else 'not found'})",
+    ]
+    for number, text in ignored:
+        lines.append(f"dotenv line {number} ignored (not a KEY=value line): {mask_line(text)}")
+    lines.append("")
+    lines.append("settings:")
+    for key, (value, source) in config.items():
+        if key in SECRET_KEYS:
+            shown = mask_secret(value)
+        elif value is None:
+            shown = "<unset>"
+        else:
+            shown = repr(value)
+        lines.append(f"  {key} = {shown}  [source: {source}]")
+
+    missing = [k for k in REQUIRED_KEYS if config[k][0] is None]
+    lines.append("")
+    lines.append("missing required: " + ", ".join(missing) if missing else "required settings: ok")
+    return "\n".join(lines)
+
+
+def mask_line(text):
+    """An ignored line may hold a secret with a typo'd key; never print it."""
+    return f"<{len(text)} characters>"
