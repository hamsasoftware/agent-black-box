+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from payhook.config import parse_dotenv
+from payhook.doctor import mask_secret, render
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class ParseDotenvTest(unittest.TestCase):
+    def values(self, text):
+        return parse_dotenv(text)[0]
+
+    def test_single_and_double_quotes_are_stripped(self):
+        self.assertEqual(self.values("A=\"x y\"\nB='x y'\n"), {"A": "x y", "B": "x y"})
+
+    def test_export_prefix_with_quotes(self):
+        self.assertEqual(self.values("export A='1'\nexport\tB=\"2\"\n"), {"A": "1", "B": "2"})
+
+    def test_spaces_around_equals(self):
+        self.assertEqual(self.values("A = 5\n"), {"A": "5"})
+
+    def test_inline_comment_after_unquoted_value(self):
+        self.assertEqual(self.values("A=5 # seconds\nB=x#y\n"), {"A": "5", "B": "x#y"})
+
+    def test_hash_inside_quotes_is_kept(self):
+        self.assertEqual(self.values("A=\"a # b\"  # note\n"), {"A": "a # b"})
+
+    def test_escaped_quote_in_double_quotes(self):
+        self.assertEqual(self.values('A="say \\"hi\\""\n'), {"A": 'say "hi"'})
+
+    def test_crlf_line_endings(self):
+        self.assertEqual(self.values("A=1\r\nB='2'\r\n"), {"A": "1", "B": "2"})
+
+    def test_value_with_equals_and_query_string(self):
+        self.assertEqual(self.values("export U='https://h/x?a=1&b=2'\n"), {"U": "https://h/x?a=1&b=2"})
+
+    def test_malformed_lines_are_reported_not_fatal(self):
+        values, ignored = parse_dotenv("GOOD=1\njust some words\n")
+        self.assertEqual(values, {"GOOD": "1"})
+        self.assertEqual(ignored, [(2, "just some words")])
+
+    def test_empty_value(self):
+        self.assertEqual(self.values("A=\nB=''\n"), {"A": "", "B": ""})
+
+
+class DoctorTest(unittest.TestCase):
+    def run_doctor(self, env_text, extra_env=None):
+        with tempfile.TemporaryDirectory() as tmp:
+            if env_text is not None:
+                with open(os.path.join(tmp, ".env"), "w", encoding="utf-8") as f:
+                    f.write(env_text)
+            env = {k: v for k, v in os.environ.items() if not k.startswith("PAYHOOK_")}
+            env["PYTHONPATH"] = ROOT
+            env.update(extra_env or {})
+            result = subprocess.run(
+                [sys.executable, "-m", "payhook", "doctor"],
+                cwd=tmp, capture_output=True, text=True, env=env,
+            )
+        return result
+
+    def test_reports_value_and_source_for_each_setting(self):
+        result = self.run_doctor(
+            "export PAYHOOK_ENDPOINT='https://e.example/v9?x=1'\nPAYHOOK_TIMEOUT=30 # secs\n",
+            extra_env={"PAYHOOK_REGION": "us"},
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        out = result.stdout
+        self.assertIn("PAYHOOK_REGION = 'us'  [source: env]", out)
+        self.assertIn("PAYHOOK_ENDPOINT = 'https://e.example/v9?x=1'  [source: .env]", out)
+        self.assertIn("PAYHOOK_TIMEOUT = '30'  [source: .env]", out)
+        self.assertIn("PAYHOOK_API_TOKEN = <unset>  [source: default]", out)
+        self.assertIn("missing required: PAYHOOK_API_TOKEN, PAYHOOK_WEBHOOK_SECRET", out)
+
+    def test_secrets_are_masked(self):
+        secret = "sk_live_EXAMPLE_0123456789abcdef"
+        result = self.run_doctor(f"PAYHOOK_API_TOKEN=\"{secret}\"\nPAYHOOK_WEBHOOK_SECRET=whsec_short\n")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn(secret, result.stdout)
+        self.assertNotIn("EXAMPLE_0123456789", result.stdout)
+        self.assertIn("cdef' (length", result.stdout)
+        self.assertNotIn("whsec_short", result.stdout)
+        self.assertIn("required settings: ok", result.stdout)
+
+    def test_no_dotenv_file(self):
+        result = self.run_doctor(None)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("(not found)", result.stdout)
+
+    def test_ignored_line_content_is_not_printed(self):
+        result = self.run_doctor("PAYHOOK_API_TOKEN sk_live_SECRETWORDS\n")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("dotenv line 1 ignored", result.stdout)
+        self.assertNotIn("SECRETWORDS", result.stdout)
+
+    def test_mask_secret(self):
+        self.assertEqual(mask_secret(None), "<unset>")
+        self.assertEqual(mask_secret("abcdefghijkl"), "'********ijkl' (length 12)")
+        self.assertEqual(mask_secret("abc"), "'***' (length 3)")
+
+
+if __name__ == "__main__":
+    unittest.main()
