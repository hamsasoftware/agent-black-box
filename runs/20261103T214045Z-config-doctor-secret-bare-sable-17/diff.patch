@@ -0,0 +1,38 @@
+import os
+import platform
+import sys
+
+from .config import SECRET_KEYS, load_config
+
+
+def _describe_value(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        # Never print secrets in full; only show that they are set and their length.
+        return "(hidden, %d characters)" % len(value)
+    return repr(value)
+
+
+def format_report(config, dotenv_path=".env"):
+    lines = [
+        "payhook doctor",
+        "python: %s (%s)" % (platform.python_version(), sys.platform),
+        "working directory: %s" % os.getcwd(),
+        "dotenv file: %s (%s)" % (
+            os.path.abspath(dotenv_path),
+            "found" if os.path.exists(dotenv_path) else "not found",
+        ),
+        "",
+        "settings:",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append("  %-*s = %s  [source: %s]" % (width, key, _describe_value(key, value), source))
+    return "\n".join(lines)
+
+
+def run_doctor(dotenv_path=".env"):
+    config = load_config(dotenv_path=dotenv_path)
+    print(format_report(config, dotenv_path))
+    return 0
