+"""Tests for the guarantees in docs/CONTRACT.md that tests/test_cache.py does not cover.
+
+Threads are coordinated with events, never with sleeps. Joins use a generous timeout only so that a
+deadlock shows up as a failure instead of hanging the run.
+"""
+import threading
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import TTLCache
+
+JOIN_TIMEOUT = 10
+
+
+def start(target):
+    t = threading.Thread(target=target)
+    t.start()
+    return t
+
+
+def join_all(threads):
+    for t in threads:
+        t.join(JOIN_TIMEOUT)
+        if t.is_alive():
+            raise AssertionError("thread still running: cache deadlocked or a waiter was left waiting")
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_gets_on_a_missing_key_cause_one_load(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def slow(key):
+            calls.append(key)
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            return "v"
+
+        cache = TTLCache(slow, ttl=60, clock=FakeClock())
+        results = []
+        owner = start(lambda: results.append(cache.get("k")))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = [start(lambda: results.append(cache.get("k"))) for _ in range(5)]
+        release.set()
+        join_all([owner] + waiters)
+        self.assertEqual(results, ["v"] * 6)
+        self.assertEqual(calls, ["k"])
+        s = cache.stats()
+        self.assertEqual((s["loads"], s["failures"], s["hits"] + s["misses"]), (1, 0, 6))
+
+    def test_concurrent_gets_on_an_expired_key_cause_one_reload(self):
+        clock = FakeClock()
+        values = iter(["old", "fresh"])
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            v = next(values)
+            if v == "fresh":
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return v
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("k"), "old")
+        clock.advance(10)  # exactly ttl old: expired
+        results = []
+        owner = start(lambda: results.append(cache.get("k")))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = [start(lambda: results.append(cache.get("k"))) for _ in range(3)]
+        release.set()
+        join_all([owner] + waiters)
+        self.assertEqual(results, ["fresh"] * 4)
+        self.assertEqual(calls, ["k", "k"])
+
+
+class NoExpiredValueTest(unittest.TestCase):
+    def test_expired_value_is_not_served_while_a_reload_is_in_flight(self):
+        clock = FakeClock()
+        values = iter(["old", "new"])
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            v = next(values)
+            if v == "new":
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return v
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("k"), "old")
+        clock.advance(10)
+        results = []
+        owner = start(lambda: results.append(cache.get("k")))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiter = start(lambda: results.append(cache.get("k")))
+        release.set()
+        join_all([owner, waiter])
+        self.assertEqual(results, ["new", "new"])
+
+
+class FailureTest(unittest.TestCase):
+    def test_waiters_receive_the_same_exception_object(self):
+        release = threading.Event()
+        started = threading.Event()
+        error = ValueError("boom")
+
+        def failing(key):
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise error
+
+        cache = TTLCache(failing, ttl=60, clock=FakeClock())
+        raised = []
+
+        def call():
+            try:
+                cache.get("k")
+            except ValueError as exc:
+                raised.append(exc)
+
+        owner = start(call)
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiters = [start(call) for _ in range(3)]
+        release.set()
+        join_all([owner] + waiters)
+        self.assertEqual(len(raised), 4)
+        self.assertTrue(all(exc is error for exc in raised))
+        s = cache.stats()
+        self.assertEqual((s["loads"], s["failures"], s["hits"]), (1, 1, 0))
+
+    def test_a_failure_leaves_no_trace_and_a_later_load_is_stored(self):
+        outcomes = [RuntimeError("first"), "ok"]
+        calls = []
+
+        def flaky(key):
+            calls.append(key)
+            outcome = outcomes.pop(0)
+            if isinstance(outcome, Exception):
+                raise outcome
+            return outcome
+
+        cache = TTLCache(flaky, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError):
+            cache.get("k")
+        self.assertEqual(cache.get("k"), "ok")
+        self.assertEqual(cache.get("k"), "ok")
+        self.assertEqual(calls, ["k", "k"])
+        self.assertEqual(cache.stats(), {"hits": 1, "misses": 2, "loads": 2, "failures": 1})
+
+    def test_base_exception_from_loader_still_releases_waiters(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def interrupted(key):
+            started.set()
+            release.wait(JOIN_TIMEOUT)
+            raise KeyboardInterrupt()
+
+        cache = TTLCache(interrupted, ttl=60, clock=FakeClock())
+        outcomes = []
+
+        def call():
+            try:
+                cache.get("k")
+            except BaseException as exc:
+                outcomes.append(type(exc))
+
+        owner = start(call)
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        waiter = start(call)
+        release.set()
+        join_all([owner, waiter])
+        self.assertEqual(outcomes, [KeyboardInterrupt, KeyboardInterrupt])
+
+
+class RecursionTest(unittest.TestCase):
+    def test_loader_calling_get_for_its_own_key_raises_runtime_error(self):
+        errors = []
+
+        def loader(key):
+            try:
+                cache.get(key)
+            except RuntimeError as exc:
+                errors.append(exc)
+                raise
+            return "never"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        with self.assertRaises(RuntimeError):
+            cache.get("k")
+        self.assertEqual(len(errors), 1)
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 2, "loads": 1, "failures": 1})
+
+    def test_loader_calling_get_for_another_key_is_allowed(self):
+        def loader(key):
+            if key == "outer":
+                return "outer+" + cache.get("inner")
+            return "inner"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        self.assertEqual(cache.get("outer"), "outer+inner")
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 2, "loads": 2, "failures": 0})
+
+    def test_cross_thread_cycle_raises_instead_of_deadlocking(self):
+        # Thread A loads "a", which needs "b". Thread B loads "b", which needs "a".
+        a_started = threading.Event()
+        b_started = threading.Event()
+
+        def loader(key):
+            if key == "a":
+                a_started.set()
+                b_started.wait(JOIN_TIMEOUT)
+                return cache.get("b")
+            a_started.wait(JOIN_TIMEOUT)
+            b_started.set()
+            return cache.get("a")
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        results = []
+
+        def call(key):
+            try:
+                results.append(cache.get(key))
+            except RuntimeError as exc:
+                results.append(exc)
+
+        ta = start(lambda: call("a"))
+        tb = start(lambda: call("b"))
+        join_all([ta, tb])
+        self.assertEqual(len(results), 2)
+        self.assertTrue(all(isinstance(r, RuntimeError) for r in results))
+
+
+class ValueTest(unittest.TestCase):
+    def test_falsy_and_none_values_are_stored_and_served(self):
+        for value in (None, 0, "", False):
+            with self.subTest(value=value):
+                loads = []
+
+                def loader(key, value=value):
+                    loads.append(key)
+                    return value
+
+                cache = TTLCache(loader, ttl=60, clock=FakeClock())
+                self.assertIs(cache.get("k"), value)
+                self.assertIs(cache.get("k"), value)
+                self.assertEqual(loads, ["k"])
+
+
+class ClockTest(unittest.TestCase):
+    def test_loaded_at_is_read_after_the_loader_returns(self):
+        clock = FakeClock()
+        calls = []
+
+        def slow(key):
+            calls.append(key)
+            clock.advance(5)
+            return "v"
+
+        cache = TTLCache(slow, ttl=10, clock=clock)
+        cache.get("k")  # loader returns at t=5, so loaded_at must be 5
+        clock.advance(7)  # t=12, age 7: still valid
+        self.assertEqual(cache.get("k"), "v")
+        self.assertEqual(calls, ["k"])
+        clock.advance(3)  # t=15, age 10: expired
+        cache.get("k")
+        self.assertEqual(calls, ["k", "k"])
+
+
+class IndependenceTest(unittest.TestCase):
+    def test_slow_load_does_not_block_other_keys_stats_or_invalidate(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            if key == "slow":
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return key
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        self.assertEqual(cache.get("fast"), "fast")
+        owner = start(lambda: cache.get("slow"))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        try:
+            # None of these may block on the in-flight "slow" load.
+            self.assertEqual(cache.get("other"), "other")
+            self.assertEqual(cache.get("fast"), "fast")
+            cache.invalidate("fast")
+            cache.invalidate("slow")
+            self.assertEqual(cache.stats()["loads"], 3)
+        finally:
+            release.set()
+            join_all([owner])
+
+    def test_invalidate_does_not_cancel_a_load_in_flight(self):
+        release = threading.Event()
+        started = threading.Event()
+        calls = []
+
+        def loader(key):
+            calls.append(key)
+            if len(calls) == 1:
+                started.set()
+                release.wait(JOIN_TIMEOUT)
+            return f"v{len(calls)}"
+
+        cache = TTLCache(loader, ttl=60, clock=FakeClock())
+        results = []
+        owner = start(lambda: results.append(cache.get("k")))
+        self.assertTrue(started.wait(JOIN_TIMEOUT))
+        cache.invalidate("k")
+        release.set()
+        join_all([owner])
+        self.assertEqual(results, ["v1"])
+        # The completed load was stored, so this is a hit with no new load.
+        self.assertEqual(cache.get("k"), "v1")
+        self.assertEqual(calls, ["k"])
+        self.assertEqual(cache.stats(), {"hits": 1, "misses": 1, "loads": 1, "failures": 0})
+
+
+class StatsTest(unittest.TestCase):
+    def test_stats_are_exact_under_concurrency(self):
+        cache = TTLCache(lambda key: key, ttl=60, clock=FakeClock())
+        per_thread = 200
+        threads_n = 8
+
+        def work():
+            for i in range(per_thread):
+                cache.get(i % 5)
+
+        threads = [start(work) for _ in range(threads_n)]
+        join_all(threads)
+        s = cache.stats()
+        self.assertEqual(set(s), {"hits", "misses", "loads", "failures"})
+        self.assertEqual(s["hits"] + s["misses"], per_thread * threads_n)
+        # The clock never moves and nothing is invalidated, so each of the 5 keys loads exactly once.
+        self.assertEqual(s["loads"], 5)
+        self.assertEqual(s["failures"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
