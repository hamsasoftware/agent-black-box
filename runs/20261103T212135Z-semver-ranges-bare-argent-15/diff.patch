+import unittest
+
+from depres import max_satisfying, satisfies
+
+
+class ExtraRangeTest(unittest.TestCase):
+    def test_table(self):
+        cases = [
+            ("2.0.0", ">1", True), ("1.9.9", ">1", False),
+            ("1.3.0", ">1.2", True), ("1.2.9", ">1.2", False),
+            ("1.1.9", "<1.2", True), ("1.2.0", "<1.2", False),
+            ("1.9.9", "<=1", True), ("2.0.0", "<=1", False),
+            ("1.3.0", "<=1.2", False), ("1.2.9", "<=1.2", True),
+            ("1.2.5", "=1.2", True), ("1.3.0", "=1.2", False),
+            ("1.2.3", ">= 1.2.3", True), ("1.2.2", ">= 1.2.3", False),
+            ("1.2.3", "v1.2.3", True), ("9.9.9", "*", True), ("9.9.9", "", True),
+            ("1.2.3-alpha", "*", False), ("1.2.3-alpha", "", False),
+            ("1.2.3-alpha.7", ">=1.2.3-alpha.1 <1.3.0", True),
+            ("1.2.4-alpha.1", ">=1.2.3-alpha.1 <1.3.0", False),
+            ("1.5.0-beta", "^1.0.0", False), ("2.0.0-rc.1", "^1.0.0", False),
+            ("1.2.9", "~1.2", True), ("1.9.0", "~1", True), ("2.0.0", "~1", False),
+            ("1.2.3-beta.3", "~1.2.3-beta.2", True),
+            ("0.0.3", "^0.0.3", True), ("0.0.4", "^0.0.3", False),
+            ("0.0.9", "^0.0", True), ("0.1.0", "^0.0.x", False),
+            ("0.9.0", "^0", True), ("1.0.0", "^0.x", False),
+            ("1.9.0", "^1.2", True), ("1.2.0", "^1.2.x", True),
+            ("0.2.9", "^0.2", True), ("0.3.0", "^0.2", False),
+            ("2.3.9", "1.2.3 - 2.3", True), ("2.4.0", "1.2.3 - 2.3", False),
+            ("2.9.9", "1.2.3 - 2", True), ("3.0.0", "1.2.3 - 2", False),
+            ("1.0.0", "1 - 2", True),
+            ("1.2.5", "1.2.x", True), ("1.3.0", "1.2", False),
+            ("5.0.0", "1.x || 5", True), ("3.0.0", "1.x || 5", False),
+            ("3.0.0", "1.x ||", True),
+        ]
+        for v, r, expected in cases:
+            self.assertIs(satisfies(v, r), expected, "%s in %r" % (v, r))
+
+    def test_invalid(self):
+        for r in ["1.x.3", ">", "^", "1.2.3 -", "a.b", "1.2.3 - 2 - 3", ">=1.2.3 >="]:
+            with self.assertRaises(ValueError, msg=r):
+                satisfies("1.0.0", r)
+        with self.assertRaises(ValueError):
+            satisfies("nope", "*")
+        with self.assertRaises(ValueError):
+            max_satisfying(["1.0.0", "bad"], "*")
+
+    def test_max_returns_original(self):
+        self.assertEqual(max_satisfying(["v1.0.0", "1.2.0+b"], "^1"), "1.2.0+b")
+        self.assertEqual(max_satisfying(["1.0.0", "1.1.0-rc.1"], "^1"), "1.0.0")
+        self.assertIsNone(max_satisfying([], "*"))
