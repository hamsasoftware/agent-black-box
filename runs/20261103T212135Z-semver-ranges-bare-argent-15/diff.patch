+import operator
+import re
+
 from .version import Version
 
+_NUM = r"0|[1-9]\d*"
+_PART = r"(?:x|X|\*|" + _NUM + r")"
+_PRE_ID = r"(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)"
+_PARTIAL = re.compile(
+    r"^v?(" + _PART + r")(?:\.(" + _PART + r")(?:\.(" + _PART + r")"
+    r"(?:-(" + _PRE_ID + r"(?:\." + _PRE_ID + r")*))?"
+    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?)?)?$"
+)
+_OP = re.compile(r"^(<=|>=|<|>|=|~|\^)?(.*)$", re.S)
+_OP_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+_HYPHEN = re.compile(r"(?:^|\s)-(?:\s|$)")
+
+_OPS = {
+    "<": operator.lt,
+    "<=": operator.le,
+    ">": operator.gt,
+    ">=": operator.ge,
+    "=": operator.eq,
+}
+
+# Lowest possible version; "< lowest" matches nothing.
+_NEVER = [("<", Version(0, 0, 0, ("0",)))]
+
+
+def _invalid(text):
+    return ValueError("invalid range: %r" % (text,))
+
+
+def _parse_partial(text, whole):
+    """Return (numbers, prerelease); numbers are the leading concrete parts."""
+    m = _PARTIAL.match(text)
+    if not m:
+        raise _invalid(whole)
+    nums = []
+    wild = False
+    for p in m.group(1, 2, 3):
+        if p is None or p in ("x", "X", "*"):
+            wild = True
+        elif wild:
+            raise _invalid(whole)  # wildcard followed by a number
+        else:
+            nums.append(int(p))
+    pre = tuple(m.group(4).split(".")) if m.group(4) else ()
+    if pre and len(nums) < 3:
+        raise _invalid(whole)
+    return nums, pre
+
+
+def _fill(nums, pre=()):
+    n = list(nums) + [0] * (3 - len(nums))
+    return Version(n[0], n[1], n[2], pre)
+
+
+def _next(nums):
+    """Version just past everything matching the partial `nums` (len 1 or 2)."""
+    if len(nums) == 1:
+        return Version(nums[0] + 1, 0, 0)
+    return Version(nums[0], nums[1] + 1, 0)
+
+
+def _primitive(op, nums, pre):
+    n = len(nums)
+    if op in ("", "="):
+        if n == 0:
+            return []
+        if n == 3:
+            return [("=", _fill(nums, pre))]
+        return [(">=", _fill(nums)), ("<", _next(nums))]
+    if op == ">=":
+        return [(">=", _fill(nums, pre))] if n else []
+    if op == "<":
+        return [("<", _fill(nums, pre))] if n else list(_NEVER)
+    if op == ">":
+        if n == 0:
+            return list(_NEVER)
+        if n == 3:
+            return [(">", _fill(nums, pre))]
+        return [(">=", _next(nums))]
+    if op == "<=":
+        if n == 0:
+            return []
+        if n == 3:
+            return [("<=", _fill(nums, pre))]
+        return [("<", _next(nums))]
+    raise AssertionError(op)
+
+
+def _tilde(nums, pre):
+    if not nums:
+        return []
+    upper = Version(nums[0] + 1, 0, 0) if len(nums) == 1 else Version(nums[0], nums[1] + 1, 0)
+    return [(">=", _fill(nums, pre)), ("<", upper)]
+
+
+def _caret(nums, pre):
+    n = len(nums)
+    if n == 0:
+        return []
+    if nums[0] > 0:
+        upper = Version(nums[0] + 1, 0, 0)
+    elif n == 1:
+        upper = Version(1, 0, 0)
+    elif nums[1] > 0 or n == 2:
+        upper = Version(0, nums[1] + 1, 0)
+    else:
+        upper = Version(0, 0, nums[2] + 1)
+    return [(">=", _fill(nums, pre)), ("<", upper)]
+
+
+def _parse_set(text, whole):
+    text = text.strip()
+    if _HYPHEN.search(text):
+        tokens = text.split()
+        if len(tokens) != 3 or tokens[1] != "-":
+            raise _invalid(whole)
+        lo, pre_lo = _parse_partial(tokens[0], whole)
+        hi, pre_hi = _parse_partial(tokens[2], whole)
+        comps = [(">=", _fill(lo, pre_lo))]
+        if len(hi) == 3:
+            comps.append(("<=", _fill(hi, pre_hi)))
+        elif hi:
+            comps.append(("<", _next(hi)))
+        return comps
+    comps = []
+    for token in _OP_SPACE.sub(r"\1", text).split():
+        op, rest = _OP.match(token).groups()
+        op = op or ""
+        if not rest:
+            raise _invalid(whole)
+        nums, pre = _parse_partial(rest, whole)
+        if op == "~":
+            comps += _tilde(nums, pre)
+        elif op == "^":
+            comps += _caret(nums, pre)
+        else:
+            comps += _primitive(op, nums, pre)
+    return comps
+
+
+def _parse_range(range_):
+    if not isinstance(range_, str):
+        raise ValueError("invalid range: %r" % (range_,))
+    return [_parse_set(part, range_) for part in range_.split("||")]
+
+
+def _set_matches(comps, v):
+    if not all(_OPS[op](v, bound) for op, bound in comps):
+        return False
+    if v.prerelease:
+        return any(b.prerelease and b.release == v.release for _, b in comps)
+    return True
+
+
+def _parse_version(version):
+    if isinstance(version, Version):
+        return version
+    if not isinstance(version, str):
+        raise ValueError("invalid version: %r" % (version,))
+    return Version.parse(version)
+
 
 def satisfies(version, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    v = _parse_version(version)
+    return any(_set_matches(s, v) for s in sets)
 
 
 def max_satisfying(versions, range_):
-    raise NotImplementedError
+    sets = _parse_range(range_)
+    best, best_v = None, None
+    for item in versions:
+        v = _parse_version(item)
+        if any(_set_matches(s, v) for s in sets) and (best_v is None or v > best_v):
+            best, best_v = item, v
+    return best
