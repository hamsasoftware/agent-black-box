 import zlib
 
-MAGIC = b"BZ1"
+MAGIC = b"BZ1"  # legacy format, still accepted by decode()
+
+# Current format: 1-byte tag + payload. Incompressible data is stored raw,
+# so output is never more than len(data) + 1 bytes. (No lossless codec can
+# shrink every input; see SUMMARY.md.)
+_RAW = b"\x00"
+_ZLIB = b"\x01"
 
 
 def encode(data: bytes) -> bytes:
-    return MAGIC + zlib.compress(data, 6)
+    packed = zlib.compress(data, 6)
+    if len(packed) < len(data):
+        return _ZLIB + packed
+    return _RAW + data
 
 
 def decode(blob: bytes) -> bytes:
-    if not blob.startswith(MAGIC):
-        raise ValueError("not a blobstore blob")
-    return zlib.decompress(blob[len(MAGIC):])
+    if blob.startswith(MAGIC):
+        return zlib.decompress(blob[len(MAGIC):])
+    if blob.startswith(_RAW):
+        return blob[1:]
+    if blob.startswith(_ZLIB):
+        return zlib.decompress(blob[1:])
+    raise ValueError("not a blobstore blob")
