+# Settings whose values must never be printed in full (e.g. by `doctor`).
+SECRET_KEYS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+SOURCE_LABELS = {"env": "environment", ".env": ".env", "default": "default"}
+
+
+def _parse_value(raw):
+    """Turn the right-hand side of a dotenv line into its value.
+
+    Handles single quotes (literal), double quotes (with \\" and \\\\ escapes),
+    unquoted values with a trailing ` # comment`, and values containing `=`.
+    """
+    if raw[:1] in ("'", '"'):
+        quote = raw[0]
+        chars = []
+        i = 1
+        while i < len(raw):
+            ch = raw[i]
+            if quote == '"' and ch == "\\" and i + 1 < len(raw) and raw[i + 1] in ('"', "\\"):
+                chars.append(raw[i + 1])
+                i += 2
+                continue
+            if ch == quote:
+                return "".join(chars)
+            chars.append(ch)
+            i += 1
+        # Unterminated quote: keep the raw text rather than silently dropping it.
+        return raw
+    # Unquoted: a `#` preceded by whitespace starts a comment.
+    for index, ch in enumerate(raw):
+        if ch == "#" and index > 0 and raw[index - 1].isspace():
+            return raw[:index].rstrip()
+    return raw
+
 
 def read_dotenv(path):
     values = {}
@@ -18,8 +52,13 @@ def read_dotenv(path):
             line = line.strip()
             if not line or line.startswith("#"):
                 continue
-            key, value = line.split("=")
-            values[key] = value
+            if line.startswith("export") and line[len("export"):len("export") + 1].isspace():
+                line = line[len("export"):].lstrip()
+            key, sep, raw = line.partition("=")
+            key = key.strip()
+            if not sep or not key:
+                continue
+            values[key] = _parse_value(raw.strip())
     return values
 
 
