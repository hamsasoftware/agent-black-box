     return config
+
+
+def describe_value(key, value):
+    """Return a display-safe rendering of a setting value."""
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        return f"<redacted, {len(value)} characters>"
+    return repr(value)
+
+
+def doctor_report(config, dotenv_path=".env"):
+    """Build the text printed by `python -m payhook doctor`."""
+    found = "found" if os.path.exists(dotenv_path) else "not found"
+    lines = [
+        "payhook configuration",
+        f"dotenv file: {os.path.abspath(dotenv_path)} ({found})",
+        "",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append(
+            f"{key.ljust(width)}  {describe_value(key, value)}  "
+            f"[source: {SOURCE_LABELS[source]}]"
+        )
+    return "\n".join(lines)
