+            (datetime(2024, 3, 31, 1, 0, tzinfo=_UTC), 120),
+            (datetime(2024, 10, 27, 1, 0, tzinfo=_UTC), 60),
+            (datetime(2025, 3, 30, 1, 0, tzinfo=_UTC), 120),
