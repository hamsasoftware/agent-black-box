+"""Tests for the rules of docs/adr/ that test_retention.py does not cover. Each test names the record it checks."""
+
+import unittest
+from datetime import date, datetime
+
+from vaultsnap import Plan, Policy, Snapshot, plan_retention
+from vaultsnap.retention import _local_date, _monthly_key
+
+NOW = datetime.fromisoformat("2026-03-20T12:00:00+00:00")
+
+
+def sid(stamp):
+    return "s-" + stamp.replace("-", "").replace(":", "")
+
+
+def snap(stamp, *tags, parent=None):
+    """`stamp` is UTC, e.g. "2026-03-10T03:00"; the id is derived from it as in test_retention.py."""
+    return Snapshot(sid(stamp), datetime.fromisoformat(stamp + "+00:00"), frozenset(tags), parent)
+
+
+def at(stamp):
+    return datetime.fromisoformat(stamp + "+00:00")
+
+
+class Iso8601WeeksTest(unittest.TestCase):  # ADR-0003
+    def test_weeks_are_iso_weeks_starting_monday(self):
+        shots = [snap("2025-12-21T03:00"), snap("2025-12-22T03:00"), snap("2025-12-28T03:00"), snap("2025-12-29T03:00")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        # ISO weeks: 12-29 is (2026, 1); 12-22 and 12-28 are both (2025, 52); 12-21 is (2025, 51).
+        # The two newest weeks are (2026, 1) and (2025, 52), so 12-29 and the newer 12-28 are kept.
+        self.assertEqual(plan.keep, [sid("2025-12-29T03:00"), sid("2025-12-28T03:00")])
+        self.assertEqual(plan.prune, [sid("2025-12-22T03:00"), sid("2025-12-21T03:00")])
+
+    def test_iso_week_key_of_a_late_december_date(self):
+        self.assertEqual(_local_date(snap("2025-12-30T03:00"), Policy()).isocalendar()[:2], (2026, 1))
+
+
+class DayBoundaryTest(unittest.TestCase):  # ADR-0004
+    def test_day_start_hour_moves_an_early_snapshot_to_the_previous_day(self):
+        policy = Policy(day_start_hour=4)
+        self.assertEqual(_local_date(snap("2026-01-01T03:30"), policy), date(2025, 12, 31))
+        self.assertEqual(_local_date(snap("2026-01-01T04:00"), policy), date(2026, 1, 1))
+
+    def test_day_start_hour_shares_one_daily_bucket(self):
+        shots = [snap("2025-12-31T23:00"), snap("2026-01-01T03:30")]
+        plan = plan_retention(shots, Policy(keep_daily=1, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, [sid("2026-01-01T03:30")])
+        self.assertEqual(plan.prune, [sid("2025-12-31T23:00")])
+
+    def test_yearly_key_follows_the_shifted_date(self):
+        shots = [snap("2025-06-01T10:00"), snap("2026-01-01T03:30")]
+        plan = plan_retention(shots, Policy(keep_yearly=2, day_start_hour=4), NOW)
+        # The 2026-01-01 03:30 snapshot belongs to the 2025 bucket, which already holds 2025-06-01.
+        self.assertEqual(plan.keep, [sid("2026-01-01T03:30")])
+
+    def test_fixed_offset_shifts_the_date(self):
+        self.assertEqual(_local_date(snap("2026-01-01T20:00"), Policy(tz_offset_minutes=600)), date(2026, 1, 2))
+        self.assertEqual(_local_date(snap("2026-01-01T13:00"), Policy(tz_offset_minutes=600)), date(2026, 1, 1))
+
+
+class NamedZoneTest(unittest.TestCase):  # ADR-0005
+    def test_summer_and_standard_offsets(self):
+        lake = Policy(zone="lakeside")
+        self.assertEqual(_local_date(snap("2026-07-01T23:30"), lake), date(2026, 7, 2))  # +120
+        self.assertEqual(_local_date(snap("2026-01-01T23:30"), lake), date(2026, 1, 2))  # +60
+
+    def test_offset_is_read_at_the_instant_of_the_snapshot(self):
+        lake = Policy(zone="lakeside")
+        self.assertEqual(_local_date(snap("2026-03-29T22:30"), lake), date(2026, 3, 30))  # +120 applies: 00:30
+
+    def test_exact_row_instant_already_has_the_new_offset(self):
+        policy = Policy(zone="lakeside", day_start_hour=3)
+        self.assertEqual(_local_date(snap("2026-03-29T01:00"), policy), date(2026, 3, 29))  # +120 applies
+        self.assertEqual(_local_date(snap("2026-03-29T00:59"), policy), date(2026, 3, 28))  # +60 applies
+
+    def test_before_the_first_row_the_initial_offset_applies(self):
+        self.assertEqual(_local_date(snap("2021-12-31T15:00"), Policy(zone="harbor")), date(2022, 1, 1))  # +630
+
+    def test_tz_offset_minutes_is_ignored_with_a_zone(self):
+        self.assertEqual(_local_date(snap("2026-07-01T23:30"), Policy(zone="lakeside", tz_offset_minutes=-720)), date(2026, 7, 2))
+
+
+class WindowTest(unittest.TestCase):  # ADR-0006 and ADR-0009
+    def test_window_snapshots_do_not_use_up_bucket_slots(self):
+        shots = [snap("2026-03-20T06:00"), snap("2026-03-19T06:00"), snap("2026-03-17T06:00"), snap("2026-03-16T06:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=72, keep_daily=1), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-20T06:00"), sid("2026-03-19T06:00"), sid("2026-03-17T06:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-16T06:00")])
+
+    def test_a_snapshot_exactly_at_the_window_edge_is_in_the_window(self):
+        shots = [snap("2026-03-17T12:00"), snap("2026-03-17T11:59")]
+        plan = plan_retention(shots, Policy(keep_within_hours=72), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-17T12:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-17T11:59")])
+
+    def test_window_alone_prunes_what_is_older(self):
+        shots = [snap("2026-03-20T11:00"), snap("2026-03-17T12:00")]
+        plan = plan_retention(shots, Policy(keep_within_hours=24), NOW)
+        self.assertEqual(plan.keep, [sid("2026-03-20T11:00")])
+        self.assertEqual(plan.prune, [sid("2026-03-17T12:00")])
+
+
+class ParentTest(unittest.TestCase):  # ADR-0007
+    def test_parent_of_a_kept_snapshot_is_kept_up_the_chain(self):
+        x = snap("2026-03-01T03:00")
+        y = snap("2026-03-05T03:00", parent=x.id)
+        z = snap("2026-03-06T03:00", parent=y.id)
+        plan = plan_retention([x, y, z], Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=[z.id, y.id, x.id], prune=[]))
+
+    def test_held_snapshots_do_not_count_toward_keep_last(self):
+        w = snap("2026-03-01T03:00")
+        v = snap("2026-03-02T03:00", parent=w.id)
+        u = snap("2026-03-03T03:00")
+        t = snap("2026-03-04T03:00", parent=v.id)
+        plan = plan_retention([w, v, u, t], Policy(keep_last=2), NOW)
+        self.assertEqual(plan, Plan(keep=[t.id, u.id, v.id, w.id], prune=[]))
+
+    def test_a_pruned_snapshot_holds_nothing(self):
+        x = snap("2026-03-01T03:00")
+        y = snap("2026-03-02T03:00", parent=x.id)
+        z = snap("2026-03-03T03:00")
+        plan = plan_retention([x, y, z], Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=[z.id], prune=[y.id, x.id]))
+
+    def test_unknown_parent_raises_whatever_the_policy(self):
+        shots = [snap("2026-03-01T03:00", parent="s-missing")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(), NOW)
+
+    def test_parent_cycle_raises(self):
+        a = snap("2026-03-01T03:00", parent=sid("2026-03-02T03:00"))
+        b = snap("2026-03-02T03:00", parent=sid("2026-03-01T03:00"))
+        with self.assertRaises(ValueError):
+            plan_retention([a, b], Policy(keep_last=1), NOW)
+
+    def test_self_parent_raises(self):
+        a = snap("2026-03-01T03:00", parent=sid("2026-03-01T03:00"))
+        with self.assertRaises(ValueError):
+            plan_retention([a], Policy(), NOW)
+
+
+class OverrideOrderTest(unittest.TestCase):  # ADR-0001 set-aside, ADR-0008
+    def test_expired_snapshots_are_pruned_even_when_a_rule_would_keep_them(self):
+        shots = [snap("2026-03-01T03:00", "scratch"), snap("2026-03-02T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=5, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-02T03:00")], prune=[sid("2026-03-01T03:00")]))
+
+    def test_expired_snapshots_do_not_count_toward_keep_last(self):
+        shots = [snap("2026-03-02T03:00", "scratch"), snap("2026-03-01T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-01T03:00")], prune=[sid("2026-03-02T03:00")]))
+
+    def test_empty_policy_still_prunes_expired(self):
+        shots = [snap("2026-03-01T03:00", "scratch"), snap("2026-03-02T03:00")]
+        plan = plan_retention(shots, Policy(expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-02T03:00")], prune=[sid("2026-03-01T03:00")]))
+
+    def test_protect_wins_over_expire(self):
+        shots = [snap("2026-03-01T03:00", "scratch", "release"), snap("2026-03-02T03:00")]
+        policy = Policy(keep_last=1, protect_tags={"release"}, expire_tags={"scratch"})
+        plan = plan_retention(shots, policy, NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-02T03:00"), sid("2026-03-01T03:00")], prune=[]))
+
+    def test_future_snapshot_wins_over_expire(self):
+        shots = [snap("2026-03-21T03:00", "scratch"), snap("2026-03-19T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-21T03:00"), sid("2026-03-19T03:00")], prune=[]))
+
+    def test_expired_parent_is_held(self):  # ADR-0008 says the dependency step overrides line 3
+        p = snap("2026-03-01T03:00", "scratch")
+        c = snap("2026-03-02T03:00", parent=p.id)
+        plan = plan_retention([p, c], Policy(keep_last=1, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan, Plan(keep=[c.id, p.id], prune=[]))
+
+    def test_future_snapshots_are_set_aside_and_do_not_count(self):
+        shots = [snap("2026-03-21T03:00"), snap("2026-03-19T03:00"), snap("2026-03-18T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-21T03:00"), sid("2026-03-19T03:00")], prune=[sid("2026-03-18T03:00")]))
+
+    def test_snapshot_taken_exactly_now_is_not_set_aside(self):
+        shots = [snap("2026-03-20T12:00"), snap("2026-03-19T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-03-20T12:00")], prune=[sid("2026-03-19T03:00")]))
+
+
+class MonthStartDayTest(unittest.TestCase):  # ADR-0010
+    def test_billing_cycle_from_the_15th(self):
+        self.assertEqual(_monthly_key(date(2026, 1, 10), 15), (2025, 12))
+        self.assertEqual(_monthly_key(date(2026, 1, 15), 15), (2026, 1))
+
+    def test_short_months_use_the_last_day(self):
+        self.assertEqual(_monthly_key(date(2028, 2, 28), 31), (2028, 1))
+        self.assertEqual(_monthly_key(date(2028, 2, 29), 31), (2028, 2))
+        self.assertEqual(_monthly_key(date(2027, 2, 28), 31), (2027, 2))
+        self.assertEqual(_monthly_key(date(2027, 3, 30), 31), (2027, 2))
+        self.assertEqual(_monthly_key(date(2027, 3, 31), 31), (2027, 3))
+
+    def test_default_is_calendar_month(self):
+        self.assertEqual(_monthly_key(date(2026, 1, 10), 1), (2026, 1))
+
+    def test_monthly_rule_with_month_start_day(self):
+        shots = [snap("2026-01-10T03:00"), snap("2026-01-20T03:00")]
+        plan = plan_retention(shots, Policy(keep_monthly=1, month_start_day=15), NOW)
+        self.assertEqual(plan, Plan(keep=[sid("2026-01-20T03:00")], prune=[sid("2026-01-10T03:00")]))
+
+
+class InputTest(unittest.TestCase):  # ADR-0001 inputs and output
+    def test_duplicate_ids_raise(self):
+        t = at("2026-03-01T03:00")
+        with self.assertRaises(ValueError):
+            plan_retention([Snapshot("s-x", t), Snapshot("s-x", t)], Policy(keep_last=1), NOW)
+
+    def test_naive_now_raises(self):
+        with self.assertRaises(ValueError):
+            plan_retention([snap("2026-03-01T03:00")], Policy(keep_last=1), datetime(2026, 3, 20, 12))
+
+    def test_equal_taken_at_orders_by_greater_id(self):
+        t = at("2026-03-01T03:00")
+        plan = plan_retention([Snapshot("s-a", t), Snapshot("s-b", t)], Policy(keep_last=1), NOW)
+        self.assertEqual(plan, Plan(keep=["s-b"], prune=["s-a"]))
+
+    def test_zero_rule_is_off(self):
+        shots = [snap("2026-03-01T03:00"), snap("2026-03-02T03:00")]
+        plan = plan_retention(shots, Policy(keep_last=0), NOW)
+        self.assertEqual(plan.prune, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
