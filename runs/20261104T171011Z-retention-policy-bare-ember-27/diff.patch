 @dataclass(frozen=True)
@@ -16,5 +58,126 @@ def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+
+    The rules are those of docs/adr/ (see the index there and the Status line of each record):
+    ADR-0001 (model), 0003 (ISO weeks), 0004/0005 (day boundary and zones), 0006/0009 (window),
+    0007 (parents), 0008 (expire tags and order of overrides), 0010 (month start day).
     """
-    raise NotImplementedError
+    _require_aware(now, "now")
+    shots = list(snapshots)
+    by_id = {}
+    for s in shots:
+        _require_aware(s.taken_at, f"taken_at of snapshot {s.id!r}")
+        if s.id in by_id:
+            raise ValueError(f"duplicate snapshot id {s.id!r}")
+        by_id[s.id] = s
+    for s in shots:  # ADR-0007: parents must exist in the plan, whatever the policy is
+        if s.parent is not None and s.parent not in by_id:
+            raise ValueError(f"snapshot {s.id!r} has parent {s.parent!r}, which is not in the plan")
+    _check_no_cycles(by_id)
+
+    # Newest first: later taken_at wins; equal taken_at, the greater id is newer (ADR-0001).
+    ordered = sorted(shots, key=lambda s: (s.taken_at, s.id), reverse=True)
+
+    # ADR-0008 order of overrides, with ADR-0009's window as line 4.
+    kept = set()
+    remaining = []
+    window = timedelta(hours=policy.keep_within_hours) if policy.keep_within_hours else None
+    for s in ordered:
+        if s.tags & policy.protect_tags or s.taken_at > now:  # lines 1 and 2: set aside, kept
+            kept.add(s.id)
+        elif s.tags & policy.expire_tags:  # line 3: expired, pruned (not in `remaining`)
+            continue
+        elif window is not None and now - s.taken_at <= window:  # line 4: window, set aside, kept
+            kept.add(s.id)
+        else:  # line 5: subject to the rules
+            remaining.append(s)
+
+    if policy.has_rules:
+        kept |= _apply_rules(remaining, policy)
+    else:  # ADR-0001 / ADR-0008: with no rule on, every remaining snapshot is kept
+        kept |= {s.id for s in remaining}
+
+    # ADR-0007: the dependency step, applied last. Every parent of a kept snapshot is kept, up the chain.
+    stack = list(kept)
+    while stack:
+        parent = by_id[stack.pop()].parent
+        if parent is not None and parent not in kept:
+            kept.add(parent)
+            stack.append(parent)
+
+    return Plan(
+        keep=[s.id for s in ordered if s.id in kept],
+        prune=[s.id for s in ordered if s.id not in kept],
+    )
+
+
+def _require_aware(value, what):
+    if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() is None:
+        raise ValueError(f"{what} must be a timezone-aware datetime, got {value!r}")
+
+
+def _check_no_cycles(by_id):
+    state = {}  # id -> "visiting" while on the current walk, "done" once fully walked
+    for start in by_id:
+        walk = []
+        cur = start
+        while cur is not None and state.get(cur) != "done":
+            if state.get(cur) == "visiting":
+                raise ValueError(f"parent cycle through snapshot {cur!r}")
+            state[cur] = "visiting"
+            walk.append(cur)
+            cur = by_id[cur].parent
+        for sid in walk:
+            state[sid] = "done"
+
+
+def _apply_rules(remaining, policy):
+    """Ids chosen by keep_last and the bucket rules. `remaining` is ordered newest first."""
+    chosen = set()
+    if policy.keep_last:
+        chosen |= {s.id for s in remaining[: policy.keep_last]}
+    bucket_rules = (
+        (policy.keep_daily, lambda s: _local_date(s, policy)),
+        (policy.keep_weekly, lambda s: _local_date(s, policy).isocalendar()[:2]),  # ADR-0003: ISO weeks
+        (policy.keep_monthly, lambda s: _monthly_key(_local_date(s, policy), policy.month_start_day)),
+        (policy.keep_yearly, lambda s: _local_date(s, policy).year),
+    )
+    for n, key_of in bucket_rules:
+        if not n:
+            continue
+        newest_in_bucket = {}
+        for s in remaining:  # newest first, so the first snapshot seen in a bucket is its newest
+            newest_in_bucket.setdefault(key_of(s), s)
+        for key in sorted(newest_in_bucket, reverse=True)[:n]:
+            chosen.add(newest_in_bucket[key].id)
+    return chosen
+
+
+def _offset_minutes(snapshot, policy):
+    """ADR-0004 / ADR-0005: the UTC offset, in minutes, used to find the bucket time."""
+    if policy.zone is None:
+        return policy.tz_offset_minutes
+    initial, rows = ZONE_TABLES[policy.zone]
+    offset = initial
+    for start, row_offset in rows:
+        if start <= snapshot.taken_at:
+            offset = row_offset
+        else:
+            break
+    return offset
+
+
+def _local_date(snapshot, policy):
+    """ADR-0004: convert taken_at to the fixed offset, subtract day_start_hour; the date of that is the bucket date."""
+    local = snapshot.taken_at.astimezone(timezone(timedelta(minutes=_offset_minutes(snapshot, policy))))
+    return (local - timedelta(hours=policy.day_start_hour)).date()
+
+
+def _monthly_key(day, month_start_day):
+    """ADR-0010: (year, month) of the billing cycle that `day` falls in."""
+    start = min(month_start_day, monthrange(day.year, day.month)[1])
+    if day.day >= start:
+        return (day.year, day.month)
+    previous = day.replace(day=1) - timedelta(days=1)
+    return (previous.year, previous.month)
