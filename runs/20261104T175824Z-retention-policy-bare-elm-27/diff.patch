+}
+_ZONE_OFFSETS = {name: [offset for _, offset in rows] for name, rows in _ZONE_ROWS.items()}
+
+
 def plan_retention(snapshots, policy, now):
     """Decide which snapshots to keep and which to prune. Nothing is deleted here; this only plans.
 
     `snapshots` is an iterable of Snapshot, `policy` a Policy, `now` a timezone-aware datetime.
+    The rules are those of docs/adr/ (ADR-0001 as amended by ADR-0003 to ADR-0010).
     """
-    raise NotImplementedError
+    snaps = list(snapshots)
+    _validate(snaps, now)
+    by_id = {s.id: s for s in snaps}
+    newest_first = sorted(snaps, key=_newest_key, reverse=True)
+
+    keep = set()
+    remaining = []
+    # ADR-0008 and ADR-0009: the order of overrides, decided per snapshot.
+    for s in newest_first:
+        if s.tags & policy.protect_tags or s.taken_at > now:  # lines 1 and 2: set aside, kept
+            keep.add(s.id)
+        elif s.tags & policy.expire_tags:  # line 3: expired, pruned
+            continue
+        elif _in_window(s, policy, now):  # line 4 (ADR-0006, ADR-0009): set aside, kept
+            keep.add(s.id)
+        else:  # line 5: the rules apply
+            remaining.append(s)
+
+    if policy.has_rules:
+        keep |= _keep_last(remaining, policy.keep_last)
+        keep |= _newest_per_bucket(remaining, policy, lambda d: d, policy.keep_daily)
+        keep |= _newest_per_bucket(remaining, policy, lambda d: d.isocalendar()[:2], policy.keep_weekly)
+        keep |= _newest_per_bucket(remaining, policy, lambda d: _month_key(d, policy.month_start_day), policy.keep_monthly)
+        keep |= _newest_per_bucket(remaining, policy, lambda d: d.year, policy.keep_yearly)
+    else:  # ADR-0001 and ADR-0008: with no rules on, every remaining snapshot is kept.
+        keep |= {s.id for s in remaining}
+
+    # ADR-0007: the dependency step, last. A kept snapshot holds its parent, and the parent holds its own.
+    pending = list(keep)
+    while pending:
+        s = by_id[pending.pop()]
+        if s.parent is not None and s.parent not in keep:
+            keep.add(s.parent)
+            pending.append(s.parent)
+
+    return Plan(
+        keep=[s.id for s in newest_first if s.id in keep],
+        prune=[s.id for s in newest_first if s.id not in keep],
+    )
+
+
+def _newest_key(snapshot):
+    # ADR-0001 "Ordering": later taken_at is newer; on a tie the greater id is newer.
+    return (snapshot.taken_at, snapshot.id)
+
+
+def _aware(value):
+    return isinstance(value, datetime) and value.utcoffset() is not None
+
+
+def _validate(snaps, now):
+    if not _aware(now):
+        raise ValueError(f"now must be a timezone-aware datetime, got {now!r}")
+    by_id = {}
+    for s in snaps:
+        if not _aware(s.taken_at):
+            raise ValueError(f"snapshot {s.id!r}: taken_at must be a timezone-aware datetime, got {s.taken_at!r}")
+        if s.id in by_id:
+            raise ValueError(f"duplicate snapshot id {s.id!r}")
+        by_id[s.id] = s
+    for s in snaps:
+        if s.parent is not None and s.parent not in by_id:
+            raise ValueError(f"snapshot {s.id!r}: parent {s.parent!r} is not a snapshot in this plan")
+    # ADR-0007: a cycle of parents (including a snapshot that is its own parent) is an error.
+    verified = set()
+    for s in snaps:
+        path = set()
+        cur = s
+        while cur is not None and cur.id not in verified:
+            if cur.id in path:
+                raise ValueError(f"parent cycle through snapshot {cur.id!r}")
+            path.add(cur.id)
+            cur = by_id[cur.parent] if cur.parent is not None else None
+        verified |= path
+
+
+def _in_window(snapshot, policy, now):
+    # ADR-0006: a snapshot not later than now, at most keep_within_hours old. None and 0 are off.
+    hours = policy.keep_within_hours
+    if not hours:
+        return False
+    return snapshot.taken_at <= now and now - snapshot.taken_at <= timedelta(hours=hours)
+
+
+def _zone_offset(zone, instant):
+    # ADR-0005: the offset of the latest row whose instant is not later than `instant`.
+    index = bisect_right(_ZONE_STARTS[zone], instant)
+    return _ZONE_INITIAL[zone] if index == 0 else _ZONE_OFFSETS[zone][index - 1]
+
+
+def _bucket_date(snapshot, policy):
+    # ADR-0004 and ADR-0005: convert to the local offset, then subtract day_start_hour; the date of
+    # the result is the snapshot's date for every bucket rule. The offset is looked up from the real instant.
+    if policy.zone is None:
+        offset = policy.tz_offset_minutes
+    else:
+        offset = _zone_offset(policy.zone, snapshot.taken_at)
+    shifted = snapshot.taken_at.astimezone(timezone.utc) + timedelta(minutes=offset, hours=-policy.day_start_hour)
+    return shifted.date()
+
+
+def _month_key(day, month_start_day):
+    # ADR-0010: a monthly cycle starts on min(month_start_day, days in month). Dates before their month's
+    # cycle start belong to the previous month's cycle.
+    last = monthrange(day.year, day.month)[1]
+    if day.day >= min(month_start_day, last):
+        return (day.year, day.month)
+    if day.month == 1:
+        return (day.year - 1, 12)
+    return (day.year, day.month - 1)
+
+
+def _keep_last(remaining, n):
+    # ADR-0001 "keep_last"; `remaining` is newest first. 0 or None is off.
+    return {s.id for s in remaining[:n]} if n else set()
+
+
+def _newest_per_bucket(remaining, policy, key_of, n):
+    # ADR-0001 "Buckets": keep the newest snapshot of the N newest buckets that hold a remaining snapshot.
+    # `key_of` receives the bucket date. `remaining` is newest first, so the first snapshot seen in a bucket is its newest.
+    if not n:
+        return set()
+    representative = {}
+    for s in remaining:
+        representative.setdefault(key_of(_bucket_date(s, policy)), s.id)
+    chosen = sorted(representative, reverse=True)[:n]
+    return {representative[key] for key in chosen}
