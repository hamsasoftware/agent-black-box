+import unittest
+from datetime import datetime, timedelta
+
+from vaultsnap import Plan, Policy, Snapshot, plan_retention
+
+# Later than every stamp used below, so no snapshot is in the future unless a test makes it one.
+NOW = datetime.fromisoformat("2030-01-01T12:00:00+00:00")
+
+
+def at(stamp, *tags, id=None, parent=None):
+    """Snapshot taken at `stamp` (UTC unless the stamp carries an offset)."""
+    when = datetime.fromisoformat(stamp if "+" in stamp[10:] else stamp + "+00:00")
+    return Snapshot(id or "s" + stamp.replace("-", "").replace(":", "").replace("+", "p"), when, frozenset(tags), parent)
+
+
+def ago(hours, id):
+    return Snapshot(id, NOW - timedelta(hours=hours))
+
+
+class IsoWeekTest(unittest.TestCase):
+    def test_weekly_key_uses_the_iso_year(self):
+        # 2025-12-28 is ISO week 52 of 2025; 2025-12-29 and 2025-12-30 are ISO week 1 of 2026 (ADR-0003).
+        shots = [at("2025-12-28T03:00", id="a"), at("2025-12-29T03:00", id="b"), at("2025-12-30T03:00", id="c")]
+        plan = plan_retention(shots, Policy(keep_weekly=1), NOW)
+        self.assertEqual(plan.keep, ["c"])
+        self.assertEqual(plan.prune, ["b", "a"])
+
+    def test_two_weeks_across_the_year_boundary(self):
+        shots = [at("2025-12-28T03:00", id="a"), at("2025-12-30T03:00", id="c")]
+        plan = plan_retention(shots, Policy(keep_weekly=2), NOW)
+        self.assertEqual(plan.keep, ["c", "a"])
+
+
+class DayBoundaryTest(unittest.TestCase):
+    def test_day_start_hour_moves_early_snapshots_to_the_previous_day(self):
+        # 03:30 on 1 January with day_start_hour 4 belongs to 31 December (ADR-0004).
+        shots = [at("2025-12-31T22:00", id="a"), at("2026-01-01T03:30", id="b")]
+        plan = plan_retention(shots, Policy(keep_daily=1, day_start_hour=4), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_tz_offset_minutes_shifts_the_day(self):
+        # 23:30 UTC is 01:30 next day at +120; with the default offset they share 15 March.
+        shots = [at("2026-03-15T20:00", id="a"), at("2026-03-15T23:30", id="b")]
+        plan = plan_retention(shots, Policy(keep_daily=2, tz_offset_minutes=120), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        plan_utc = plan_retention(shots, Policy(keep_daily=2), NOW)
+        self.assertEqual(plan_utc.keep, ["b"])
+
+
+class ZoneTest(unittest.TestCase):
+    def test_named_zone_changes_offset_at_the_transition(self):
+        # lakeside is +60 until 2026-03-29T01:00Z and +120 after it (ADR-0005). With day_start_hour 2,
+        # the first snapshot falls on 28 March and the second on 29 March.
+        shots = [at("2026-03-29T00:30", id="a"), at("2026-03-29T01:30", id="b")]
+        plan = plan_retention(shots, Policy(keep_daily=2, zone="lakeside", day_start_hour=2), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+
+    def test_zone_is_used_instead_of_tz_offset(self):
+        shots = [at("2026-03-29T00:30", id="a"), at("2026-03-29T01:30", id="b")]
+        plan = plan_retention(shots, Policy(keep_daily=2, zone="lakeside", day_start_hour=2, tz_offset_minutes=0), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        plan_fixed = plan_retention(shots, Policy(keep_daily=2, day_start_hour=2, tz_offset_minutes=0), NOW)
+        self.assertEqual(plan_fixed.keep, ["b"])
+
+    def test_harbor_initial_offset_before_its_first_row(self):
+        # harbor's initial offset is +630 (ADR-0005). 14:00Z is 00:30 on 2 January locally; 12:00Z is 22:30 on 1 January.
+        # With UTC days both would be 1 January, so keeping both shows the zone offset was used.
+        shots = [at("2022-01-01T12:00", id="a"), at("2022-01-01T14:00", id="b")]
+        plan = plan_retention(shots, Policy(keep_daily=2, zone="harbor"), NOW)
+        self.assertEqual(plan.keep, ["b", "a"])
+        self.assertEqual(plan_retention(shots, Policy(keep_daily=2), NOW).keep, ["b"])
+
+
+class WindowTest(unittest.TestCase):
+    def test_window_is_set_aside_and_does_not_count_toward_keep_last(self):
+        shots = [ago(1, "w1"), ago(5, "w5"), ago(10, "old"), ago(20, "oldest")]
+        plan = plan_retention(shots, Policy(keep_last=1, keep_within_hours=6), NOW)
+        self.assertEqual(plan.keep, ["w1", "w5", "old"])
+        self.assertEqual(plan.prune, ["oldest"])
+
+    def test_snapshot_exactly_at_the_window_edge_is_in_the_window(self):
+        plan = plan_retention([ago(6, "edge"), ago(7, "outside")], Policy(keep_within_hours=6), NOW)
+        self.assertEqual(plan.keep, ["edge"])
+        self.assertEqual(plan.prune, ["outside"])
+
+    def test_zero_window_is_off(self):
+        plan = plan_retention([ago(0, "now"), ago(1, "hour")], Policy(keep_within_hours=0, keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["now"])
+
+
+class ExpireAndProtectTest(unittest.TestCase):
+    def test_expired_snapshot_is_pruned_even_inside_the_window(self):
+        shots = [Snapshot("scratch", NOW - timedelta(hours=1), frozenset({"scratch"})), ago(2, "keep")]
+        plan = plan_retention(shots, Policy(keep_within_hours=24, expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["keep"])
+        self.assertEqual(plan.prune, ["scratch"])
+
+    def test_protect_wins_over_expire(self):
+        shot = Snapshot("both", NOW - timedelta(hours=1), frozenset({"release", "scratch"}))
+        plan = plan_retention([shot], Policy(expire_tags={"scratch"}, protect_tags={"release"}, keep_last=0), NOW)
+        self.assertEqual(plan.keep, ["both"])
+
+    def test_future_snapshot_is_kept_even_if_expired(self):
+        shot = Snapshot("future", NOW + timedelta(hours=1), frozenset({"scratch"}))
+        plan = plan_retention([shot], Policy(expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["future"])
+
+    def test_empty_policy_still_prunes_expired(self):
+        shots = [Snapshot("x", NOW - timedelta(days=1), frozenset({"scratch"})), Snapshot("y", NOW - timedelta(days=2))]
+        plan = plan_retention(shots, Policy(expire_tags={"scratch"}), NOW)
+        self.assertEqual(plan.keep, ["y"])
+        self.assertEqual(plan.prune, ["x"])
+
+    def test_future_snapshot_is_set_aside(self):
+        shots = [Snapshot("future", NOW + timedelta(minutes=5)), ago(1, "now-ish")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["future", "now-ish"])
+        self.assertEqual(plan.prune, [])
+
+
+class ParentTest(unittest.TestCase):
+    def test_kept_child_holds_its_parent(self):
+        shots = [at("2026-03-01T03:00", id="P"), at("2026-03-09T03:00", id="D"), at("2026-03-10T03:00", id="C", parent="P")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["C", "P"])
+        self.assertEqual(plan.prune, ["D"])
+
+    def test_hold_chains_up_and_the_parent_does_not_count(self):
+        shots = [
+            at("2026-03-01T03:00", id="G"),
+            at("2026-03-05T03:00", id="P", parent="G"),
+            at("2026-03-10T03:00", id="C", parent="P"),
+            at("2026-03-11T03:00", id="D"),
+        ]
+        plan = plan_retention(shots, Policy(keep_last=2), NOW)
+        self.assertEqual(plan.keep, ["D", "C", "P", "G"])
+        self.assertEqual(plan.prune, [])
+
+    def test_pruned_child_holds_nothing(self):
+        shots = [at("2026-03-01T03:00", id="P"), at("2026-03-10T03:00", id="C", parent="P"), at("2026-03-11T03:00", id="D")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["D"])
+        self.assertEqual(plan.prune, ["C", "P"])
+
+    def test_expired_parent_of_a_kept_child_is_kept(self):
+        parent = Snapshot("P", datetime.fromisoformat("2026-03-01T03:00+00:00"), frozenset({"scratch"}))
+        child = at("2026-03-10T03:00", id="C", parent="P")
+        plan = plan_retention([parent, child], Policy(expire_tags={"scratch"}, keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["C", "P"])
+
+    def test_parent_taken_later_than_its_child_is_held(self):
+        # C is protected, so it is kept; its parent P is newer than C and is held.
+        shots = [
+            at("2026-03-10T03:00", "release", id="C", parent="P"),
+            at("2026-03-11T03:00", id="P"),
+            at("2026-03-12T03:00", id="D"),
+        ]
+        plan = plan_retention(shots, Policy(keep_last=1, protect_tags={"release"}), NOW)
+        self.assertEqual(plan.keep, ["D", "P", "C"])
+        self.assertEqual(plan.prune, [])
+
+
+class ParentErrorTest(unittest.TestCase):
+    def test_unknown_parent_is_an_error_under_any_policy(self):
+        with self.assertRaises(ValueError):
+            plan_retention([at("2026-03-10T03:00", id="C", parent="nope")], Policy(), NOW)
+
+    def test_cycle_is_an_error(self):
+        shots = [at("2026-03-10T03:00", id="A", parent="B"), at("2026-03-11T03:00", id="B", parent="A")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(), NOW)
+
+    def test_self_parent_is_an_error(self):
+        with self.assertRaises(ValueError):
+            plan_retention([at("2026-03-10T03:00", id="A", parent="A")], Policy(), NOW)
+
+
+class InputErrorTest(unittest.TestCase):
+    def test_duplicate_ids_are_an_error(self):
+        shots = [at("2026-03-10T03:00", id="same"), at("2026-03-11T03:00", id="same")]
+        with self.assertRaises(ValueError):
+            plan_retention(shots, Policy(keep_last=1), NOW)
+
+    def test_naive_now_is_an_error(self):
+        with self.assertRaises(ValueError):
+            plan_retention([at("2026-03-10T03:00", id="a")], Policy(keep_last=1), datetime(2026, 3, 20, 12, 0))
+
+    def test_equal_instants_order_by_id(self):
+        shots = [at("2026-03-10T03:00", id="a"), at("2026-03-10T03:00", id="b")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+class MonthCycleTest(unittest.TestCase):
+    def test_billing_cycle_from_the_15th(self):
+        # 2026-01-10 is in the cycle that started 15 December 2025, so it shares a bucket with 2025-12-20.
+        shots = [at("2025-12-20T12:00", id="a"), at("2026-01-10T12:00", id="b"), at("2026-01-20T12:00", id="c")]
+        plan = plan_retention(shots, Policy(keep_monthly=1, month_start_day=15), NOW)
+        self.assertEqual(plan.keep, ["c"])
+        plan2 = plan_retention(shots, Policy(keep_monthly=2, month_start_day=15), NOW)
+        self.assertEqual(plan2.keep, ["c", "b"])
+        self.assertEqual(plan2.prune, ["a"])
+
+    def test_short_february_cycle_with_month_start_31(self):
+        shots = [at("2028-02-28T12:00", id="a"), at("2028-02-29T12:00", id="b")]
+        plan = plan_retention(shots, Policy(keep_monthly=1, month_start_day=31), NOW)
+        self.assertEqual(plan.keep, ["b"])
+        self.assertEqual(plan.prune, ["a"])
+
+    def test_cycle_boundaries_in_a_non_leap_year(self):
+        # With month_start_day 31: 2027-02-28 and 2027-03-30 are both in the (2027, 2) cycle; 2027-03-31 starts (2027, 3).
+        shots = [at("2027-02-28T12:00", id="a"), at("2027-03-30T12:00", id="b"), at("2027-03-31T12:00", id="c")]
+        plan = plan_retention(shots, Policy(keep_monthly=2, month_start_day=31), NOW)
+        self.assertEqual(plan.keep, ["c", "b"])
+        self.assertEqual(plan.prune, ["a"])
+
+
+class RuleIndependenceTest(unittest.TestCase):
+    def test_rules_union_and_each_sees_the_same_remaining_set(self):
+        shots = [at("2026-03-01T03:00", id="a"), at("2026-03-02T03:00", id="b"), at("2026-03-02T09:00", id="c")]
+        plan = plan_retention(shots, Policy(keep_last=1, keep_daily=2), NOW)
+        self.assertEqual(plan.keep, ["c", "a"])
+        self.assertEqual(plan.prune, ["b"])
+
+
+class PlanShapeTest(unittest.TestCase):
+    def test_every_id_appears_exactly_once(self):
+        shots = [at("2026-03-01T03:00"), at("2026-03-02T03:00", "release"), ago(1, "w")]
+        plan = plan_retention(shots, Policy(keep_last=1), NOW)
+        self.assertIsInstance(plan, Plan)
+        self.assertEqual(sorted(plan.keep + plan.prune), sorted(s.id for s in shots))
+
+
+if __name__ == "__main__":
+    unittest.main()
