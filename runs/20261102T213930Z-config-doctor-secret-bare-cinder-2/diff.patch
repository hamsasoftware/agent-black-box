+SECRET_KEYS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def _parse_value(value):
+    if value[:1] in ("\"", "'"):
+        end = value.find(value[0], 1)
+        if end != -1:
+            return value[1:end]
+    for i, ch in enumerate(value):
+        if ch == "#" and i > 0 and value[i - 1] in " \t":
+            return value[:i].rstrip()
+    return value
+
+
+def mask(key, value):
+    if value is None:
+        return "<not set>"
+    if key in SECRET_KEYS:
+        return "<set, hidden, %d chars>" % len(value)
+    return value
+
