+import threading
+import unittest
+
+from tests.support import FakeClock
+from ttlcache import DeadlockError, TTLCache
+
+JOIN = 10  # seconds; a thread still alive after this means the test found a hang
+
+
+def run_threads(targets):
+    threads = [threading.Thread(target=t) for t in targets]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(JOIN)
+    alive = [t for t in threads if t.is_alive()]
+    if alive:
+        raise AssertionError(f"{len(alive)} thread(s) still blocked: deadlock or lost wakeup")
+
+
+class SingleLoadTest(unittest.TestCase):
+    def test_concurrent_gets_of_a_missing_key_load_once(self):
+        release = threading.Event()
+        calls = []
+
+        def slow(key):
+            calls.append(key)
+            release.wait(JOIN)
+            return "v"
+
+        cache = TTLCache(slow, ttl=60, clock=FakeClock())
+        results = []
+        lock = threading.Lock()
+
+        def work():
+            value = cache.get("k")
+            with lock:
+                results.append(value)
+
+        threads = [threading.Thread(target=work) for _ in range(6)]
+        for t in threads:
+            t.start()
+        # Waiters must not be able to start a second load while the first one is blocked.
+        while cache.stats(extended=True)["misses"] < 6:
+            threading.Event().wait(0.001)
+        release.set()
+        for t in threads:
+            t.join(JOIN)
+        self.assertEqual(calls, ["k"])
+        self.assertEqual(results, ["v"] * 6)
+        self.assertEqual(cache.stats(), {"hits": 0, "misses": 6, "loads": 1, "failures": 0})
+
+    def test_expired_entry_is_never_served_while_it_is_refreshed(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        count = [0]
+
+        def loader(key):
+            count[0] += 1
+            if count[0] == 2:
+                gate.wait(JOIN)
+            return count[0]
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        self.assertEqual(cache.get("k"), 1)
+        clock.advance(10)  # exactly ttl old: expired
+        got = []
+        t = threading.Thread(target=lambda: got.append(cache.get("k")))
+        t.start()
+        gate.set()
+        t.join(JOIN)
+        self.assertEqual(got, [2])
+        self.assertEqual(cache.get("k"), 2)
+
+    def test_expired_value_is_not_returned_to_a_waiter(self):
+        clock = FakeClock()
+        release = threading.Event()
+        count = [0]
+
+        def loader(key):
+            count[0] += 1
+            if count[0] == 2:
+                release.wait(JOIN)
+            return f"v{count[0]}"
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        cache.get("k")
+        clock.advance(10)
+        out = []
+        owner = threading.Thread(target=lambda: out.append(cache.get("k")))
+        owner.start()
+        while count[0] < 2:
+            threading.Event().wait(0.001)
+        waiter = threading.Thread(target=lambda: out.append(cache.get("k")))
+        waiter.start()
+        release.set()
+        owner.join(JOIN)
+        waiter.join(JOIN)
+        self.assertEqual(out, ["v2", "v2"])
+        self.assertEqual(count[0], 2)
+
+
+class FailureTest(unittest.TestCase):
+    def test_waiters_get_the_same_exception_object(self):
+        release = threading.Event()
+        err = ValueError("boom")
+        loads = []
+
+        def failing(key):
+            loads.append(key)
+            release.wait(JOIN)
+            raise err
+
+        cache = TTLCache(failing, ttl=10, clock=FakeClock())
+        seen = []
+        lock = threading.Lock()
+
+        def work():
+            try:
+                cache.get("k")
+            except ValueError as e:
+                with lock:
+                    seen.append(e)
+
+        threads = [threading.Thread(target=work) for _ in range(4)]
+        for t in threads:
+            t.start()
+        while cache.stats(extended=True)["misses"] < 4:
+            threading.Event().wait(0.001)
+        release.set()
+        for t in threads:
+            t.join(JOIN)
+        self.assertEqual(loads, ["k"])
+        self.assertEqual(len(seen), 4)
+        self.assertTrue(all(e is err for e in seen))
+        self.assertEqual(cache.stats()["failures"], 1)
+
+    def test_failure_is_not_cached_and_retry_stores_the_value(self):
+        clock = FakeClock()
+        outcomes = [RuntimeError("x"), None]
+
+        def loader(key):
+            o = outcomes.pop(0)
+            if o is not None:
+                raise o
+            return None  # None is a real value and must be stored
+
+        cache = TTLCache(loader, ttl=10, clock=clock)
+        with self.assertRaises(RuntimeError):
+            cache.get("k")
+        self.assertIsNone(cache.get("k"))
+        self.assertIsNone(cache.get("k"))
+        self.assertEqual(cache.stats()["loads"], 2)
+
+    def test_falsy_values_are_stored(self):
+        for value in (0, "", False):
+            loads = []
+            cache = TTLCache(lambda k, v=value: loads.append(k) or v, ttl=10, clock=FakeClock())
+            self.assertEqual(cache.get("k"), value)
+            self.assertEqual(cache.get("k"), value)
+            self.assertEqual(loads, ["k"])
+
+
+class RecursionTest(unittest.TestCase):
+    def test_loader_getting_its_own_key_raises_runtime_error(self):
+        holder = {}
+
+        def loader(key):
+            return holder["cache"].get(key)
+
+        cache = holder["cache"] = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertIs(type(ctx.exception), RuntimeError)
+
+    def test_longer_same_thread_chain_raises_runtime_error(self):
+        holder = {}
+
+        def loader(key):
+            if key == "a":
+                return holder["cache"].get("b")
+            return holder["cache"].get("a")
+
+        cache = holder["cache"] = TTLCache(loader, ttl=10, clock=FakeClock())
+        with self.assertRaises(RuntimeError) as ctx:
+            cache.get("a")
+        self.assertIs(type(ctx.exception), RuntimeError)
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 0)
+
+
+class IndependenceTest(unittest.TestCase):
+    def test_slow_load_does_not_block_other_keys_or_admin_calls(self):
+        gate = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            if key == "slow":
+                started.set()
+                gate.wait(JOIN)
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        cache.get("fast")
+        t = threading.Thread(target=lambda: cache.get("slow"))
+        t.start()
+        started.wait(JOIN)
+        self.assertEqual(cache.get("fast"), "fast")
+        self.assertEqual(cache.get("other"), "other")
+        cache.invalidate("fast")
+        self.assertEqual(cache.invalidate_all(), 1)  # "fast" was invalidated; "other" is still stored
+        self.assertEqual(len(cache), 0)
+        cache.stats()
+        gate.set()
+        t.join(JOIN)
+        self.assertFalse(t.is_alive())
+
+
+class InvalidateTest(unittest.TestCase):
+    def test_invalidate_during_load_still_stores_the_result(self):
+        release = threading.Event()
+        started = threading.Event()
+
+        def loader(key):
+            started.set()
+            release.wait(JOIN)
+            return "new"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        out = []
+        t = threading.Thread(target=lambda: out.append(cache.get("k")))
+        t.start()
+        started.wait(JOIN)
+        cache.invalidate("k")
+        release.set()
+        t.join(JOIN)
+        self.assertEqual(out, ["new"])
+        self.assertEqual(len(cache), 1)
+
+    def test_invalidate_all_counts_expired_entries_and_not_in_flight(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock)
+        cache.get("a")
+        cache.get("b")
+        clock.advance(100)
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.invalidate_all(), 2)
+        self.assertEqual(cache.invalidate_all(), 0)
+        self.assertIsNone(cache.invalidate("zzz"))
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+
+
+class StatsShapeTest(unittest.TestCase):
+    def test_default_and_extended_keys(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        self.assertEqual(set(cache.stats()), {"hits", "misses", "loads", "failures"})
+        self.assertEqual(
+            set(cache.stats(extended=True)),
+            {"hits", "misses", "loads", "failures", "evictions", "stale_served", "timeouts", "deadlocks"},
+        )
+
+
+class ConstructorTest(unittest.TestCase):
+    def test_bad_options_raise_value_error(self):
+        clock = FakeClock()
+        for kwargs in (
+            {"ttl": 0},
+            {"ttl": -1},
+            {"ttl": float("nan")},
+            {"ttl": 10, "max_size": 0},
+            {"ttl": 10, "max_size": 1.5},
+            {"ttl": 10, "max_size": True},
+            {"ttl": 10, "stale_grace": 0},
+            {"ttl": 10, "stale_grace": -1},
+            {"ttl": 10, "stale_grace": "5"},
+        ):
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    TTLCache(lambda k: k, clock=clock, **kwargs)
+
+    def test_negative_timeout_raises_before_anything_and_is_not_counted(self):
+        cache = TTLCache(lambda k: k, ttl=10, clock=FakeClock())
+        cache.get("a")
+        with self.assertRaises(ValueError):
+            cache.get("a", timeout=-1)
+        with self.assertRaises(ValueError):
+            cache.get("b", timeout=-0.5)
+        self.assertEqual(cache.stats(extended=True), {
+            "hits": 0, "misses": 1, "loads": 1, "failures": 0,
+            "evictions": 0, "stale_served": 0, "timeouts": 0, "deadlocks": 0,
+        })
+
+
+class LruTest(unittest.TestCase):
+    def test_least_recently_used_entry_is_evicted(self):
+        cache = TTLCache(lambda k: k, ttl=100, clock=FakeClock(), max_size=2)
+        cache.get("a")
+        cache.get("b")
+        cache.get("a")  # a is now more recent than b
+        cache.get("c")  # evicts b
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+        loads_before = cache.stats()["loads"]
+        cache.get("a")
+        self.assertEqual(cache.stats()["loads"], loads_before)  # a still stored
+        cache.get("b")
+        self.assertEqual(cache.stats()["loads"], loads_before + 1)  # b was evicted
+
+    def test_in_flight_key_is_protected_and_new_entry_is_evicted_at_once(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        started = threading.Event()
+        count = {"a": 0}
+
+        def loader(key):
+            if key == "a":
+                count["a"] += 1
+                if count["a"] == 2:
+                    started.set()
+                    gate.wait(JOIN)
+                    return "new-a"
+                return "old-a"
+            return key
+
+        cache = TTLCache(loader, ttl=10, clock=clock, max_size=1)
+        self.assertEqual(cache.get("a"), "old-a")
+        clock.advance(10)
+        out = []
+        t = threading.Thread(target=lambda: out.append(cache.get("a")))
+        t.start()
+        started.wait(JOIN)
+        self.assertEqual(cache.get("c"), "c")
+        self.assertEqual(len(cache), 1)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 1)
+        gate.set()
+        t.join(JOIN)
+        self.assertEqual(out, ["new-a"])
+        self.assertEqual(len(cache), 1)
+
+    def test_storing_over_an_existing_key_does_not_grow(self):
+        clock = FakeClock()
+        cache = TTLCache(lambda k: k, ttl=10, clock=clock, max_size=2)
+        cache.get("a")
+        cache.get("b")
+        clock.advance(10)
+        cache.get("a")
+        self.assertEqual(len(cache), 2)
+        self.assertEqual(cache.stats(extended=True)["evictions"], 0)
+
+
+class StaleTest(unittest.TestCase):
+    def _cache(self, clock, outcomes):
+        def loader(key):
+            o = outcomes.pop(0)
+            if isinstance(o, Exception):
+                raise o
+            return o
+
+        return TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+
+    def test_stale_value_served_when_reload_fails(self):
+        clock = FakeClock()
+        cache = self._cache(clock, ["old", ValueError("down")])
+        self.assertEqual(cache.get("k"), "old")
+        clock.advance(12)  # stale: 10 <= age < 15
+        self.assertEqual(cache.get("k"), "old")
+        stats = cache.stats(extended=True)
+        self.assertEqual((stats["stale_served"], stats["failures"], stats["loads"], stats["misses"]), (1, 1, 2, 2))
+
+    def test_grace_ends_and_exception_is_raised(self):
+        clock = FakeClock()
+        cache = self._cache(clock, ["old", ValueError("down")])
+        cache.get("k")
+        clock.advance(15)  # exactly ttl + grace: not stale
+        with self.assertRaises(ValueError):
+            cache.get("k")
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 0)
+
+    def test_stale_entry_keeps_its_loaded_at(self):
+        clock = FakeClock()
+        cache = self._cache(clock, ["old", ValueError("down"), "fresh"])
+        cache.get("k")
+        clock.advance(12)
+        self.assertEqual(cache.get("k"), "old")  # served stale, still not a use
+        clock.advance(3)  # age 15: grace is over, a new load starts
+        self.assertEqual(cache.get("k"), "fresh")
+
+    def test_invalidated_entry_is_not_served_stale(self):
+        clock = FakeClock()
+        cache = self._cache(clock, ["old", ValueError("down")])
+        cache.get("k")
+        clock.advance(12)
+        cache.invalidate("k")
+        with self.assertRaises(ValueError):
+            cache.get("k")
+
+    def test_stale_value_goes_to_waiters_too(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        started = threading.Event()
+        count = [0]
+
+        def loader(key):
+            count[0] += 1
+            if count[0] == 1:
+                return "old"
+            started.set()
+            gate.wait(JOIN)
+            raise ValueError("down")
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("k")
+        clock.advance(12)
+        out = []
+        lock = threading.Lock()
+
+        def work():
+            value = cache.get("k")
+            with lock:
+                out.append(value)
+
+        owner = threading.Thread(target=work)
+        owner.start()
+        started.wait(JOIN)
+        waiters = [threading.Thread(target=work) for _ in range(3)]
+        for t in waiters:
+            t.start()
+        while cache.stats(extended=True)["misses"] < 5:
+            threading.Event().wait(0.001)
+        gate.set()
+        owner.join(JOIN)
+        for t in waiters:
+            t.join(JOIN)
+        self.assertEqual(out, ["old"] * 4)
+        self.assertEqual(count[0], 2)
+        self.assertEqual(cache.stats(extended=True)["stale_served"], 4)
+
+
+class TimeoutTest(unittest.TestCase):
+    def test_timeout_zero_raises_at_once_and_leaves_the_load_alone(self):
+        gate = threading.Event()
+        started = threading.Event()
+        count = [0]
+
+        def loader(key):
+            count[0] += 1
+            started.set()
+            gate.wait(JOIN)
+            return "v"
+
+        cache = TTLCache(loader, ttl=10, clock=FakeClock())
+        out = []
+        owner = threading.Thread(target=lambda: out.append(cache.get("k")))
+        owner.start()
+        started.wait(JOIN)
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0)
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0.05)
+        gate.set()
+        owner.join(JOIN)
+        self.assertEqual(out, ["v"])
+        self.assertEqual(cache.get("k"), "v")
+        self.assertEqual(count[0], 1)
+        stats = cache.stats(extended=True)
+        self.assertEqual(stats["timeouts"], 2)
+        self.assertEqual(stats["misses"], 3)
+
+    def test_timeout_does_not_limit_the_owner_and_hits_never_wait(self):
+        cache = TTLCache(lambda k: k * 2, ttl=10, clock=FakeClock())
+        self.assertEqual(cache.get(3, timeout=0), 6)  # owner runs the loader even with timeout=0
+        self.assertEqual(cache.get(3, timeout=0), 6)  # hit
+
+    def test_timed_out_error_is_not_replaced_by_stale_value(self):
+        clock = FakeClock()
+        gate = threading.Event()
+        started = threading.Event()
+        count = [0]
+
+        def loader(key):
+            count[0] += 1
+            if count[0] == 1:
+                return "old"
+            started.set()
+            gate.wait(JOIN)
+            raise ValueError("down")
+
+        cache = TTLCache(loader, ttl=10, clock=clock, stale_grace=5)
+        cache.get("k")
+        clock.advance(12)
+        owner = threading.Thread(target=lambda: cache.get("k"))
+        owner.start()
+        started.wait(JOIN)
+        with self.assertRaises(TimeoutError):
+            cache.get("k", timeout=0)
+        gate.set()
+        owner.join(JOIN)
+
