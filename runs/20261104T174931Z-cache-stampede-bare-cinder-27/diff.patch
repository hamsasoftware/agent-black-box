+class DeadlockTest(unittest.TestCase):
+    def test_two_threads_waiting_for_each_other_get_deadlock_error(self):
+        holder = {}
+        a_running = threading.Event()
+        b_running = threading.Event()
+        results = {}
+
+        def loader(key):
+            if key == "a":
+                a_running.set()
+                b_running.wait(JOIN)
+                other = "b"
+            else:
+                b_running.set()
+                a_running.wait(JOIN)
+                other = "a"
+            try:
+                return holder["cache"].get(other)
+            except DeadlockError as e:
+                results[key] = e
+                return f"{key}-after-deadlock"
+
+        cache = holder["cache"] = TTLCache(loader, ttl=10, clock=FakeClock())
+        out = {}
+        run_threads([
+            lambda: out.__setitem__("a", cache.get("a")),
+            lambda: out.__setitem__("b", cache.get("b")),
+        ])
+        self.assertEqual(len(results), 1)  # exactly the call that closed the cycle is rejected
+        self.assertEqual(set(out), {"a", "b"})
+        self.assertEqual(cache.stats(extended=True)["deadlocks"], 1)
+
+    def test_cycle_closed_by_a_timeout_zero_call_is_still_a_deadlock(self):
+        import ttlcache.cache as cache_module
+
+        holder = {}
+        a_running = threading.Event()
+        b_running = threading.Event()
+        ident = {}
+        errors = []
+
+        def loader(key):
+            if key == "a":
+                ident["a"] = threading.get_ident()
