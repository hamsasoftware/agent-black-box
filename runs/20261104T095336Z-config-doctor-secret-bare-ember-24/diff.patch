+def _display_value(key, value):
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        # Show only the type prefix (e.g. "sk_", "whsec_") and the length.
+        prefix = value[: value.index("_") + 1] if "_" in value else ""
+        return f"{prefix}… (redacted, {len(value)} chars)"
+    return value
+
+
+def render_doctor(config, dotenv_path=".env"):
+    abs_path = os.path.abspath(dotenv_path)
+    found = "found" if os.path.exists(abs_path) else "not found"
+    lines = [
+        "payhook doctor",
+        f"dotenv file: {abs_path} ({found})",
+        "",
+    ]
+    width = max(len(key) for key in config)
+    for key, (value, source) in config.items():
+        lines.append(
+            f"{key:<{width}}  {_display_value(key, value)}  [{SOURCE_LABELS[source]}]"
+        )
+    lines.append("")
+    lines.append("Secrets are redacted. Sources: environment > .env > default.")
+    return "\n".join(lines)
