+SECRETS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def redact(key, value):
+    """Return a value safe to paste into a support ticket."""
+    if key in SECRETS and value:
+        return "<set, redacted>"
+    return value
+
 
 def read_dotenv(path):
