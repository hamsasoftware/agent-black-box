+
+
+SECRETS = {"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"}
+
+
+def _redact_url(value):
+    # hide any user:password@ part of a URL
+    if "://" in value:
+        scheme, rest = value.split("://", 1)
+        authority, sep, tail = rest.partition("/")
+        if "@" in authority:
+            authority = "***@" + authority.rsplit("@", 1)[1]
+        return scheme + "://" + authority + sep + tail
+    return value
+
+
+def describe(config):
+    """Rows of (key, display value, source) that are safe to paste in a ticket."""
+    rows = []
+    for key, (value, source) in config.items():
+        if value is None:
+            shown = "(not set)"
+        elif key in SECRETS:
+            shown = "(set, hidden)"
+        else:
+            shown = _redact_url(value)
+        rows.append((key, shown, source))
+    return rows
