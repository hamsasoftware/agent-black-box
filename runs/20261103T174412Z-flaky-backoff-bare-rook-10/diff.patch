+import random
+import unittest
+
+from retrykit import Retrier, compute_delay
+
+
+class CapPolicyTest(unittest.TestCase):
+    """docs/RETRY.md: the jittered delay is clamped to [0, cap]."""
+
+    def test_jitter_cannot_push_delay_past_cap(self):
+        class MaxJitter:
+            def uniform(self, lo, hi):
+                return hi
+
+        # attempt 7 uncapped is 32; jittered upward by 10% it would be 35.2.
+        self.assertEqual(compute_delay(7, base=0.5, cap=34, rng=MaxJitter()), 34)
+
+    def test_schedule_respects_cap_across_seeds(self):
+        for seed in range(2000):
+            retrier = Retrier(base=0.5, cap=34, max_attempts=7, rng=random.Random(seed))
+            for delay in retrier.schedule():
+                self.assertGreaterEqual(delay, 0)
+                self.assertLessEqual(delay, 34)
+
+
+if __name__ == "__main__":
+    unittest.main()
