@@ -35,3 +50,29 @@ def load_config(environ=None, dotenv_path=".env"):
         else:
             config[key] = (default, "default")
     return config
+
+
+def mask(key, value):
+    """Return a printable form of a setting value that hides secrets."""
+    if value is None:
+        return "<not set>"
+    if key in SECRET_KEYS:
+        return f"<hidden, {len(value)} chars>"
+    return value
+
+
+def doctor_report(environ=None, dotenv_path=".env"):
+    """Return the lines printed by `python -m payhook doctor`."""
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    lines = [
+        "payhook configuration",
+        f"dotenv file: {os.path.abspath(dotenv_path)} "
+        f"({'found' if os.path.exists(dotenv_path) else 'not found'})",
+        "",
+    ]
+    for key, (value, source) in config.items():
+        lines.append(f"{key} = {mask(key, value)}  [source: {source}]")
+    missing = [key for key, (value, _) in config.items() if value is None]
+    lines.append("")
+    lines.append("missing required: " + (", ".join(missing) if missing else "none"))
+    return lines
diff --git a/tests/test_dotenv_and_doctor.py b/tests/test_dotenv_and_doctor.py
