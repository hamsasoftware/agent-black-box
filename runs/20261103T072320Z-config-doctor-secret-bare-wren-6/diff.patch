+# Settings whose values must never be shown in full (support tickets, logs).
+SECRET_KEYS = frozenset({"PAYHOOK_API_TOKEN", "PAYHOOK_WEBHOOK_SECRET"})
+
+
+def _parse_line(line):
+    """Parse one dotenv line into (key, value), or None if it is not an assignment.
+
+    Supports ``KEY=value``, ``export KEY=value``, single- or double-quoted
+    values, and ``=`` characters inside the value. Unquoted values may be
+    followed by a ``# comment``.
+    """
+    line = line.strip()
+    if not line or line.startswith("#"):
+        return None
+    if line.startswith("export ") or line.startswith("export\t"):
+        line = line[len("export"):].lstrip()
+    if "=" not in line:
+        return None
+    key, value = line.split("=", 1)
+    key = key.strip()
+    if not key:
+        return None
+    value = value.strip()
+    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
+        value = value[1:-1]
+    else:
+        # Unquoted: drop a trailing inline comment ("value  # note").
+        for marker in (" #", "\t#"):
+            if marker in value:
+                value = value.split(marker, 1)[0].rstrip()
+    return key, value
+
 
 def read_dotenv(path):
     values = {}
