     return config
+
+
+def redact(key, value):
+    """Return a display-safe form of a setting value."""
+    if value is None:
+        return "(not set)"
+    if key in SECRET_KEYS:
+        if len(value) <= 8:
+            return "****"
+        return value[:4] + "****" + value[-4:]
+    return value
+
+
+def doctor_report(environ=None, dotenv_path=".env"):
+    """Build the lines printed by ``python -m payhook doctor``."""
+    config = load_config(environ=environ, dotenv_path=dotenv_path)
+    dotenv_abs = os.path.abspath(dotenv_path)
+    lines = ["payhook doctor"]
+    if os.path.exists(dotenv_path):
+        lines.append(".env file: " + dotenv_abs)
+    else:
+        lines.append(".env file: " + dotenv_abs + " (not found)")
+    lines.append("")
+    width = max(len(k) for k in config)
+    for key, (value, source) in config.items():
+        lines.append("%-*s  %-8s  %s" % (width, key, source, redact(key, value)))
+    lines.append("")
+    lines.append("sources: env = process environment, .env = dotenv file, default = built-in")
+    lines.append("secret values are shown redacted; do not paste full secrets into tickets")
+    return lines
