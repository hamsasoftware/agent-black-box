     report.add_argument("path", help="events file (JSON lines)")
+    report.add_argument(
+        "--since",
+        type=parse_since,
+        metavar="DATE",
+        help="only count events at or after this time, e.g. 2024-03-10 (UTC unless an offset is given)",
+    )
     return parser
 
 
@@ -22,6 +40,13 @@ def main(argv=None, out=None):
