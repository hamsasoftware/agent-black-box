+class IncludeTest(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.tmp = tmp.name
+
+    def write(self, name, text):
+        path = os.path.join(self.tmp, name)
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write(text)
+        return path
+
+    def test_included_file_starts_at_top_level_and_includer_resumes_its_section(self):
+        self.write("b.ini", "z = 1\n[t]\nq = 1\n")
+        main = self.write("main.ini", '[sec]\n@include "b.ini"\ny = 2\n')
+        self.assertEqual(load(main), {"z": 1, "t": {"q": 1}, "sec": {"y": 2}})
+
+    def test_relative_paths_resolve_against_including_file(self):
+        self.write("sub/b.ini", "v = 1\n")
+        self.write("sub/a.ini", '@include "b.ini"\n')
+        main = self.write("main.ini", '@include "sub/a.ini"\n')
+        self.assertEqual(load(main), {"v": 1})
+
+    def test_error_in_included_file_uses_its_source_and_line(self):
+        self.write("sub/b.ini", "x = 1\nx = 2\n")
+        self.write("sub/a.ini", '@include "b.ini"\n')
+        main = self.write("main.ini", '@include "sub/a.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertEqual(ctx.exception.source, os.path.normpath(os.path.join(self.tmp, "sub", "b.ini")))
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+
+    def test_including_the_same_file_twice_is_not_a_cycle(self):
+        self.write("b.ini", "x = 1\n")
+        main = self.write("main.ini", '@include "b.ini"\n@include "b.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+        self.assertEqual(ctx.exception.lineno, 1)
+        self.assertEqual(ctx.exception.source, os.path.join(self.tmp, "b.ini"))
+
+    def test_self_include_is_a_cycle(self):
+        path = self.write("a.ini", '@include "a.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(path)
+        self.assertTrue(ctx.exception.message.startswith("include cycle"))
+        self.assertEqual(ctx.exception.lineno, 1)
+        self.assertEqual(ctx.exception.source, path)
+
+    def test_missing_include(self):
+        main = self.write("main.ini", '@include "nope.ini"\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("cannot read include"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_include_without_base_directory(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('@include "x.ini"\n')
+        self.assertTrue(ctx.exception.message.startswith("include needs a base directory"))
+
+    def test_invalid_include_directives(self):
+        for text in ("@include x.ini\n", '@include "x.ini" junk\n', "@include\n", "@includes \"x\"\n"):
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text, base_dir=self.tmp)
+            self.assertTrue(ctx.exception.message.startswith(
+                "invalid line" if "includes" in text else "invalid include"), ctx.exception.message)
+
+    def test_indented_line_after_include_is_continuation_error(self):
+        self.write("b.ini", "z = 1\n")
+        main = self.write("main.ini", '@include "b.ini"\n  q = 2\n')
+        with self.assertRaises(ParseError) as ctx:
+            load(main)
+        self.assertTrue(ctx.exception.message.startswith("continuation without a value"))
+        self.assertEqual(ctx.exception.lineno, 2)
+
+    def test_load_ignores_bom_and_reads_utf8(self):
+        path = os.path.join(self.tmp, "bom.ini")
+        with open(path, "wb") as handle:
+            handle.write("\ufeffname = \u00e9t\u00e9\n".encode("utf-8"))
+        self.assertEqual(load(path), {"name": "\u00e9t\u00e9"})
+
+    def test_missing_file_raises_os_error_not_parse_error(self):
+        with self.assertRaises(OSError) as ctx:
+            load(os.path.join(self.tmp, "missing.ini"))
+        self.assertNotIsInstance(ctx.exception, ParseError)
+
+
+class CommandLineTest(unittest.TestCase):
+    def run_cli(self, *args):
+        return subprocess.run([sys.executable, "-m", "confkit", *args],
+                              cwd=ROOT, capture_output=True, text=True)
+
+    def test_prints_whole_document_as_json(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("[server]\nport = 9000\n")
+            result = self.run_cli(path)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout.strip().splitlines(),
+                         ['{', '  "server": {', '    "port": 9000', '  }', '}'])
+
+    def test_parse_error_exits_1_with_message_on_stderr(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "bad.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("a = 1\na = 2\n")
+            result = self.run_cli(path)
+        self.assertEqual(result.returncode, 1)
+        self.assertTrue(result.stderr.strip().endswith(":2: duplicate key: a"), result.stderr)
+
+    def test_missing_get_key_exits_2(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "c.ini")
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write("[server]\nport = 9000\n")
+            result = self.run_cli(path, "--get", "server.nope")
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stderr.strip(), "no such key: server.nope")
+
+
+if __name__ == "__main__":
+    unittest.main()
