+"""Tests for the full contract in docs/FORMAT.md (the existing test_parse.py covers the basics)."""
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from confkit import ParseError, load, loads
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+class LineTest(unittest.TestCase):
+    def test_bom_is_ignored(self):
+        self.assertEqual(loads("\ufeffa = 1\n"), {"a": 1})
+
+    def test_crlf_and_cr_line_endings(self):
+        self.assertEqual(loads("[a]\r\nx = 1\r\ny = [1,\r\n 2]\r\n"), {"a": {"x": 1, "y": [1, 2]}})
+        self.assertEqual(loads("a = 1\rb = 2"), {"a": 1, "b": 2})
+
+    def test_cr_counts_as_a_line_end_for_line_numbers(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads("a = 1\rb\r")
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertEqual(ctx.exception.message.split(":")[0], "invalid line")
+
+    def test_error_attributes_and_str(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads("a = 1\na = 2\n", source="conf.ini")
+        error = ctx.exception
+        self.assertIsInstance(error, ValueError)
+        self.assertEqual((error.message, error.lineno, error.source),
+                         ("duplicate key: a", 2, "conf.ini"))
+        self.assertEqual(str(error), "conf.ini:2: duplicate key: a")
+
+
+class CommentTest(unittest.TestCase):
+    def test_comment_after_header_and_values(self):
+        text = "# c\n; c\n[a] # c\nx = 1 ; c\n"
+        self.assertEqual(loads(text), {"a": {"x": 1}})
+
+    def test_hash_or_semicolon_inside_a_word_is_not_a_comment(self):
+        self.assertEqual(loads("a = x;y # c\nb = p#q\n"), {"a": "x;y", "b": "p#q"})
+
+    def test_hash_inside_quoted_string_is_kept(self):
+        self.assertEqual(loads('a = "x # y" # real\n'), {"a": "x # y"})
+
+    def test_comment_only_line_inside_multiline_value_is_skipped(self):
+        self.assertEqual(loads("a =\n  x\n\n  # note\n  y\nb = 1\n"), {"a": "x\ny", "b": 1})
+
+
+class ScalarTest(unittest.TestCase):
+    def test_typed_values(self):
+        text = (
+            "a = True\nb = FALSE\nc = +5\nd = -0x1F\ne = 0o17\nf = 1_000\n"
+            "g = .5\nh = 5.\ni = 1e3\nj = -2.5E-3\nk = 1_0.2\nl = 00.5\nm = 007e1\n"
+            "n = -0b101\no = -0\n"
+        )
+        self.assertEqual(loads(text), {
+            "a": True, "b": False, "c": 5, "d": -31, "e": 15, "f": 1000,
+            "g": 0.5, "h": 5.0, "i": 1000.0, "j": -0.0025, "k": 10.2,
+            "l": 0.5, "m": 70.0, "n": -5, "o": 0,
+        })
+
+    def test_things_that_stay_strings(self):
+        text = (
+            "a = 007\nb = 1__0\nc = _1\nd = inf\ne = nan\nf = yes\n"
+            "g = 1.2.3\nh = 0x\ni = 1e\nj = +\nk = .\nl = 0b2\n"
+        )
+        result = loads(text)
+        for key in "abcdefghijkl":
+            self.assertIsInstance(result[key], str, key)
+        self.assertEqual(result["a"], "007")
+
+    def test_quoted_values_are_never_converted(self):
+        self.assertEqual(loads("a = \"42\"\nb = 'true'\n"), {"a": "42", "b": "true"})
+
+    def test_escapes(self):
+        self.assertEqual(loads('a = "A\\u0042\\0\\t|\\\\\\""\n'), {"a": 'AB\x00\t|\\"'})
+        self.assertEqual(loads("a = 'raw \\n \\'\n"), {"a": "raw \\n \\"})
+
+    def test_invalid_escape(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('x = "a\\qb"\n')
+        self.assertTrue(ctx.exception.message.startswith("invalid escape"))
+        self.assertEqual(ctx.exception.lineno, 1)
+
+    def test_short_unicode_escape_is_invalid(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('x = "\\u12"\n')
+        self.assertTrue(ctx.exception.message.startswith("invalid escape"))
+
+    def test_text_after_closing_quote(self):
+        for text in ('x = "a" b\n', 'x = "a"b\n', 'x = "a"#c\n'):
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text)
+            self.assertTrue(ctx.exception.message.startswith("unexpected text after string"))
+        self.assertEqual(loads('x = "a" # ok\n'), {"x": "a"})
+
+    def test_unterminated_string_on_continuation_reports_key_line(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('x = 1\ny =\n  "abc\n')
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertTrue(ctx.exception.message.startswith("unterminated string"))
+
+    def test_quoted_value_may_start_on_continuation_line(self):
+        self.assertEqual(loads('a =\n   "q"\n'), {"a": "q"})
+
+
+class MultilineTest(unittest.TestCase):
+    def test_empty_first_line_and_trailing_comment(self):
+        self.assertEqual(loads("hosts =\n    alpha\n    beta        # primary\n"),
+                         {"hosts": "alpha\nbeta"})
+
+    def test_single_value_on_continuation_is_scalar(self):
+        self.assertEqual(loads("n =\n    42\n"), {"n": 42})
+
+
+class ListTest(unittest.TestCase):
+    def test_nested_quoted_bare_and_comments(self):
+        text = 'a = [1, [2, "x"], it\'s, bare # c\n  ]\n'
+        self.assertEqual(loads(text), {"a": [1, [2, "x"], "it's", "bare"]})
+
+    def test_empty_and_trailing_comma(self):
+        self.assertEqual(loads("a = []\nb = [ ]\nc = [1,]\n"), {"a": [], "b": [], "c": [1]})
+
+    def test_comment_between_items(self):
+        self.assertEqual(loads("a = [1, 2 # c\n  , 3]\n"), {"a": [1, 2, 3]})
+
+    def test_invalid_lists(self):
+        cases = ["a = [1,,2]\n", "a = [,]\n", "a = [1]z\n", "a = [1[2]]\n", 'a = ["x" "y"]\n']
+        for text in cases:
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text)
+            self.assertTrue(ctx.exception.message.startswith("invalid list"), ctx.exception.message)
+
+    def test_unterminated_list(self):
+        for text in ("a = [1, 2\n", "a = [[1]\n"):
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text)
+            self.assertTrue(ctx.exception.message.startswith("unterminated list"))
+
+    def test_list_error_reports_key_line(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads("x = 1\na = [\n  1,\n  2,,\n  ]\n")
+        self.assertEqual(ctx.exception.lineno, 2)
+        self.assertTrue(ctx.exception.message.startswith("invalid list"))
+
+
+class StructureTest(unittest.TestCase):
+    def test_dotted_key_in_section(self):
+        self.assertEqual(loads("[a]\nx.y = 1\nx.z = 2\n"), {"a": {"x": {"y": 1, "z": 2}}})
+
+    def test_empty_section(self):
+        self.assertEqual(loads("[a]\n[b]\nx = 1\n"), {"a": {}, "b": {"x": 1}})
+
+    def test_spaces_inside_header_brackets(self):
+        self.assertEqual(loads("[ a.b ]\nx = 1\n"), {"a": {"b": {"x": 1}}})
+
+    def test_invalid_headers(self):
+        for text in ("[a b]\n", "[a]x\n", "[a]#c\n", "[a . b]\n", "[a.]\n", "[\n"):
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text)
+            self.assertTrue(ctx.exception.message.startswith("invalid section header"))
+
+    def test_invalid_lines(self):
+        for text in ("x y = 1\n", "@foo = 1\n", "=1\n", "x.= 1\n", "a\n"):
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text)
+            self.assertTrue(ctx.exception.message.startswith("invalid line"))
+
+    def test_continuation_without_value(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads(" x = 1\n")
+        self.assertTrue(ctx.exception.message.startswith("continuation without a value"))
+        self.assertEqual(ctx.exception.lineno, 1)
+        with self.assertRaises(ParseError) as ctx:
+            loads("[a]\n  y\n")
+        self.assertEqual(ctx.exception.lineno, 2)
+
+    def test_duplicate_key(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads("a = 1\na = 2\n")
+        self.assertTrue(ctx.exception.message.startswith("duplicate key"))
+        self.assertEqual(ctx.exception.lineno, 2)
+
+    def test_key_conflicts(self):
+        cases = ["a = 1\na.b = 2\n", "a.b = 1\na = 2\n", "a = 1\n[a]\n", "x = 1\n[x]\n",
+                 "[a]\nx = 1\n[a.x.y]\n"]
+        for text in cases:
+            with self.subTest(text=text), self.assertRaises(ParseError) as ctx:
+                loads(text)
+            self.assertTrue(ctx.exception.message.startswith("key conflict"), ctx.exception.message)
+
+    def test_duplicate_section(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads("[a]\n[b]\n[a]\n")
+        self.assertTrue(ctx.exception.message.startswith("duplicate section"))
+        self.assertEqual(ctx.exception.lineno, 3)
+
+    def test_implicit_table_is_not_a_section(self):
+        self.assertEqual(loads("[a.b]\nx = 1\n[a]\ny = 2\n"), {"a": {"b": {"x": 1}, "y": 2}})
+        self.assertEqual(loads("a.b = 1\n[a]\nc = 2\n"), {"a": {"b": 1, "c": 2}})
+
+    def test_value_error_wins_over_duplicate_key(self):
+        with self.assertRaises(ParseError) as ctx:
+            loads('a = 1\na = "x\n')
+        self.assertTrue(ctx.exception.message.startswith("unterminated string"))
+        self.assertEqual(ctx.exception.lineno, 2)
+
