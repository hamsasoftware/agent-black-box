-"""Configuration parser.
+"""Parser for the confkit configuration format.
 
-This module used to be a thin wrapper around the third-party package ``inilite``.
+The format is specified in docs/FORMAT.md, which is the contract for this module.
 """
-import inilite
+import os
+import re
 
 from .errors import ParseError
 
+_NAME = r"[A-Za-z_][A-Za-z0-9_-]*"
+_DIGITS = r"[0-9](?:_?[0-9])*"
+_HEADER_RE = re.compile(r"\[[ \t]*(" + _NAME + r"(?:\." + _NAME + r")*)[ \t]*\]")
+_ENTRY_RE = re.compile(r"(" + _NAME + r"(?:\." + _NAME + r")*)[ \t]*=(.*)")
+_INCLUDE_RE = re.compile(r"@include(?![A-Za-z0-9_.-])(.*)")
+_NEWLINE_RE = re.compile(r"\r\n|\r|\n")
+_INT_DEC_RE = re.compile(r"[+-]?(?:0|[1-9](?:_?[0-9])*)")
+_INT_BASED = (
+    (re.compile(r"[+-]?0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*"), 16),
+    (re.compile(r"[+-]?0[oO][0-7](?:_?[0-7])*"), 8),
+    (re.compile(r"[+-]?0[bB][01](?:_?[01])*"), 2),
+)
+_FLOAT_RE = re.compile(
+    r"[+-]?(?:(?:" + _DIGITS + r"\.(?:" + _DIGITS + r")?|\." + _DIGITS + r")(?:[eE][+-]?[0-9]+)?"
+    r"|" + _DIGITS + r"[eE][+-]?[0-9]+)"
+)
+_ESCAPES = {"\\": "\\", '"': '"', "n": "\n", "t": "\t", "r": "\r", "0": "\0"}
+_HEX_DIGITS = "0123456789abcdefABCDEF"
+
+
+class _Fail(Exception):
+    """A value or include-path error without a line number yet; the caller adds it."""
+
+    def __init__(self, message):
+        super().__init__(message)
+        self.message = message
+
+
+class _Context:
+    """State shared by a document and every file it includes."""
+
+    def __init__(self, stack):
+        self.root = {}
+        self.declared = set()  # full paths of section headers seen so far
+        self.stack = stack     # real paths of the files being parsed, outermost first
+
 
 def loads(text, base_dir=None, source="<string>"):
-    return inilite.parse(text)
+    ctx = _Context([])
+    _parse_text(ctx, text, source, base_dir)
+    return ctx.root
 
 
 def load(path):
     with open(path, encoding="utf-8") as handle:
-        return loads(handle.read())
+        text = handle.read()
+    ctx = _Context([os.path.realpath(path)])
+    _parse_text(ctx, text, path, os.path.dirname(path))
+    return ctx.root
+
+
+def _parse_text(ctx, text, source, base_dir):
+    if text.startswith("﻿"):
+        text = text[1:]
+    section = ()
+    pending = None  # (full key path, line number of the key, raw value pieces)
+    for lineno, raw in enumerate(_NEWLINE_RE.split(text), 1):
+        if not raw.strip(" \t") or raw.lstrip(" \t")[0] in "#;":
+            continue
+        if raw[0] in " \t":
+            if pending is None:
+                raise ParseError("continuation without a value", lineno, source)
+            pending[2].append(raw)
+            continue
+        if pending is not None:
+            _finish(ctx, pending, source)
+            pending = None
+        if raw[0] == "@":
+            _include(ctx, raw, lineno, source, base_dir)
+        elif raw[0] == "[":
+            section = _header(ctx, raw, lineno, source)
+        else:
+            match = _ENTRY_RE.fullmatch(raw)
+            if not match:
+                raise ParseError("invalid line", lineno, source)
+            names = tuple(match.group(1).split("."))
+            pending = (section + names, lineno, [match.group(2)])
+    if pending is not None:
+        _finish(ctx, pending, source)
+
+
+def _header(ctx, raw, lineno, source):
+    match = _HEADER_RE.match(raw)
+    if not match or _has_junk(raw[match.end():]):
+        raise ParseError("invalid section header", lineno, source)
+    parts = tuple(match.group(1).split("."))
+    dotted = ".".join(parts)
+    if parts in ctx.declared:
+        raise ParseError(f"duplicate section: {dotted}", lineno, source)
+    node = ctx.root
+    for name in parts:
+        if name not in node:
+            node[name] = {}
+        elif not isinstance(node[name], dict):
+            raise ParseError(f"key conflict: {dotted}", lineno, source)
+        node = node[name]
+    ctx.declared.add(parts)
+    return parts
+
+
+def _include(ctx, raw, lineno, source, base_dir):
+    if not raw.startswith("@"):
+        raise ParseError("invalid line", lineno, source)
+    match = _INCLUDE_RE.match(raw)
+    if not match:
+        raise ParseError("invalid line", lineno, source)
+    try:
+        path = _include_path(match.group(1))
+    except _Fail:
+        raise ParseError("invalid include", lineno, source) from None
+    if base_dir is None:
+        raise ParseError("include needs a base directory", lineno, source)
+    full = os.path.normpath(os.path.join(base_dir, path))
+    real = os.path.realpath(full)
+    if real in ctx.stack:
+        raise ParseError(f"include cycle: {full}", lineno, source)
+    try:
+        with open(full, encoding="utf-8") as handle:
+            text = handle.read()
+    except (OSError, UnicodeDecodeError):
+        raise ParseError(f"cannot read include: {full}", lineno, source) from None
+    ctx.stack.append(real)
+    try:
+        _parse_text(ctx, text, full, os.path.dirname(full))
+    finally:
+        ctx.stack.pop()
+
+
+def _include_path(rest):
+    pos = 0
+    while pos < len(rest) and rest[pos] in " \t":
+        pos += 1
+    if pos >= len(rest) or rest[pos] not in "\"'":
+        raise _Fail("invalid include")
+    value, end = _quoted(rest, pos)
+    if _skip(rest, end) != len(rest):
+        raise _Fail("invalid include")
+    return value
+
+
+def _finish(ctx, pending, source):
+    full, lineno, pieces = pending
+    try:
+        value = _parse_value(pieces)
+    except _Fail as exc:
+        raise ParseError(exc.message, lineno, source) from None
+    _store(ctx, full, value, lineno, source)
+
+
+def _store(ctx, full, value, lineno, source):
+    dotted = ".".join(full)
+    node = ctx.root
+    for name in full[:-1]:
+        if name not in node:
+            node[name] = {}
+        elif not isinstance(node[name], dict):
+            raise ParseError(f"key conflict: {dotted}", lineno, source)
+        node = node[name]
+    last = full[-1]
+    if last in node:
+        if isinstance(node[last], dict):
+            raise ParseError(f"key conflict: {dotted}", lineno, source)
+        raise ParseError(f"duplicate key: {dotted}", lineno, source)
+    node[last] = value
+
+
+def _has_junk(rest):
+    """True if text after a section header is more than whitespace and an inline comment."""
+    if not rest.strip(" \t"):
+        return False
+    return not (rest[0] in " \t" and rest.lstrip(" \t")[0] in "#;")
+
+
+def _skip(text, pos):
+    """Skip whitespace, newlines and inline comments; return the next position."""
+    n = len(text)
+    while pos < n:
+        c = text[pos]
+        if c in " \t\n":
+            pos += 1
+        elif c in "#;" and (pos == 0 or text[pos - 1] in " \t\n"):
+            end = text.find("\n", pos)
+            pos = n if end < 0 else end
+        else:
+            break
+    return pos
+
+
+def _parse_value(pieces):
+    """Read a value from its raw pieces: the text after '=' and each continuation line."""
+    joined = "\n".join(pieces)
+    start = _skip(joined, 0)
+    if start == len(joined):
+        return ""
+    first = joined[start]
+    if first in "\"'":
+        value, end = _quoted(joined, start)
+        if _skip(joined, end) != len(joined):
+            raise _Fail("unexpected text after string")
+        return value
+    if first == "[":
+        value, end = _list(joined, start)
+        if _skip(joined, end) != len(joined):
+            raise _Fail("invalid list")
+        return value
+    return _plain(pieces)
+
+
+def _cut_comment(text):
+    for i, c in enumerate(text):
+        if c in "#;" and (i == 0 or text[i - 1] in " \t"):
+            return text[:i]
+    return text
+
+
+def _plain(pieces):
+    lines = []
+    for piece in pieces:
+        line = _cut_comment(piece).strip(" \t")
+        if line:
+            lines.append(line)
+    if not lines:
+        return ""
+    if len(lines) == 1:
+        return _scalar(lines[0])
+    return "\n".join(lines)
+
+
+def _quoted(text, pos):
+    """Read a quoted string starting at text[pos]; return (value, position after the quote)."""
+    quote = text[pos]
+    n = len(text)
+    out = []
+    i = pos + 1
+    while True:
+        if i >= n or text[i] == "\n":
+            raise _Fail("unterminated string")
+        c = text[i]
+        if c == quote:
+            return "".join(out), i + 1
+        if quote == "'" or c != "\\":
+            out.append(c)
+            i += 1
+            continue
+        if i + 1 >= n or text[i + 1] == "\n":
+            raise _Fail("unterminated string")
+        e = text[i + 1]
+        if e in _ESCAPES:
+            out.append(_ESCAPES[e])
+            i += 2
+        elif e == "u":
+            digits = text[i + 2:i + 6]
+            if len(digits) != 4 or any(d not in _HEX_DIGITS for d in digits):
+                raise _Fail("invalid escape \\u")
+            out.append(chr(int(digits, 16)))
+            i += 6
+        else:
+            raise _Fail("invalid escape \\" + e)
+
+
+def _list(text, pos):
+    """Read a list starting at text[pos] == '['; return (items, position after ']')."""
+    n = len(text)
+    items = []
+    state = "start"  # start | item | comma
+    pos += 1
+    while True:
+        pos = _skip(text, pos)
+        if pos >= n:
+            raise _Fail("unterminated list")
+        c = text[pos]
+        if c == "]":
+            return items, pos + 1
+        if c == ",":
+            if state != "item":
+                raise _Fail("invalid list")
+            state = "comma"
+            pos += 1
+            continue
+        if state == "item":
+            raise _Fail("invalid list")
+        if c in "\"'":
+            value, pos = _quoted(text, pos)
+        elif c == "[":
+            value, pos = _list(text, pos)
+        else:
+            end = pos
+            while end < n and text[end] not in ",]\n" and not (text[end] in "#;" and text[end - 1] in " \t"):
+                if text[end] == "[":
+                    raise _Fail("invalid list")
+                end += 1
+            value = _scalar(text[pos:end].strip(" \t"))
+            pos = end
+        items.append(value)
+        state = "item"
+
+
+def _scalar(text):
+    """Convert an unquoted, already trimmed value; anything that matches no type stays a str."""
+    if text.lower() == "true":
+        return True
+    if text.lower() == "false":
+        return False
+    if _INT_DEC_RE.fullmatch(text):
+        return int(text.replace("_", ""), 10)
+    for regex, base in _INT_BASED:
+        if regex.fullmatch(text):
+            return int(text.replace("_", ""), base)
+    if _FLOAT_RE.fullmatch(text):
+        return float(text.replace("_", ""))
+    return text
