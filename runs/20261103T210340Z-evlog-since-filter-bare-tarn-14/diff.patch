index f5b9d64..b7dbccf 100644
--- a/evlog/events.py
+++ b/evlog/events.py
@@ -1,7 +1,7 @@
 import json
 from collections import Counter
 from dataclasses import dataclass
-from datetime import datetime
+from datetime import datetime, timezone
 
 
 @dataclass(frozen=True)
@@ -31,3 +31,24 @@ def read_events(path):
 
 def count_events(events):
     return Counter((event.service, event.level) for event in events)
+
+
+def as_utc(ts):
+    """Return ``ts`` as an aware UTC datetime. Naive values are taken to be UTC."""
+    if ts.tzinfo is None:
+        return ts.replace(tzinfo=timezone.utc)
+    return ts.astimezone(timezone.utc)
+
+
+def parse_since(text):
+    """Parse a ``--since`` value: a date (``2024-03-10``) or an ISO datetime.
+
+    A bare date means midnight UTC. Raises ValueError if the text is not valid.
+    """
+    return as_utc(datetime.fromisoformat(text))
+
+
+def events_since(events, cutoff):
+    """Keep only events whose timestamp is at or after ``cutoff`` (an aware datetime)."""
+    cutoff = as_utc(cutoff)
+    return (event for event in events if as_utc(event.ts) >= cutoff)
diff --git a/tests/test_since.py b/tests/test_since.py
new file mode 100644
index 0000000..8f7995c
--- /dev/null
+++ b/tests/test_since.py
@@ -0,0 +1,108 @@
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from datetime import datetime, timezone
+
+from evlog.cli import main
+from evlog.events import parse_since
+
+
+def _write_events(lines):
+    handle, path = tempfile.mkstemp(suffix=".jsonl")
+    with os.fdopen(handle, "w") as f:
+        for line in lines:
+            f.write(line + "\n")
+    return path
+
+
+def _event(ts, level="error"):
+    return json.dumps({"ts": ts, "service": "api", "level": level, "msg": "x"})
+
+
+class ParseSinceTest(unittest.TestCase):
+    def test_bare_date_is_utc_midnight(self):
+        self.assertEqual(parse_since("2024-03-10"), datetime(2024, 3, 10, tzinfo=timezone.utc))
+
+    def test_naive_datetime_is_utc(self):
+        self.assertEqual(
+            parse_since("2024-03-10T08:00:00"),
+            datetime(2024, 3, 10, 8, tzinfo=timezone.utc),
+        )
+
+    def test_offset_datetime_is_converted_to_utc(self):
+        self.assertEqual(
+            parse_since("2024-03-10T08:00:00+02:00"),
+            datetime(2024, 3, 10, 6, tzinfo=timezone.utc),
+        )
+
+    def test_rejects_nonsense(self):
+        for bad in ["yesterday", "2024-02-30", "03/10/2024", ""]:
+            with self.subTest(value=bad), self.assertRaises(ValueError):
+                parse_since(bad)
+
+
+class SinceReportTest(unittest.TestCase):
+    def setUp(self):
+        self.path = _write_events([
+            # Naive (legacy, UTC) timestamps straddling the boundary.
+            _event("2024-03-09 23:59:59"),
+            _event("2024-03-10 00:00:00"),
+            # Offset timestamps: 01:00+02:00 is 23:00 UTC on the 9th, so excluded.
+            _event("2024-03-10T01:00:00+02:00"),
+            # 2024-03-10T00:30-05:00 is 05:30 UTC on the 10th, so included.
+            _event("2024-03-10T00:30:00-05:00", level="info"),
+        ])
+
+    def tearDown(self):
+        os.unlink(self.path)
+
+    def run_cli(self, *args):
+        out = io.StringIO()
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            try:
+                code = main(["report", self.path, *args], out=out)
+            except SystemExit as exc:
+                code = exc.code
+        return code, out.getvalue().strip().splitlines(), err.getvalue()
+
+    def test_boundary_is_utc_and_inclusive(self):
+        code, lines, _ = self.run_cli("--since", "2024-03-10")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, ["api error 1", "api info 1", "total 2"])
+
+    def test_datetime_value_is_accepted(self):
+        # 07:30+02:00 is 05:30 UTC, exactly the info event's time, so it is included.
+        code, lines, _ = self.run_cli("--since", "2024-03-10T07:30:00+02:00")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, ["api info 1", "total 1"])
+
+    def test_no_matches_reports_zero_total(self):
+        code, lines, _ = self.run_cli("--since", "2030-01-01")
+        self.assertEqual(code, 0)
+        self.assertEqual(lines, ["total 0"])
+
+    def test_invalid_since_is_clear_usage_error(self):
+        code, lines, err = self.run_cli("--since", "not-a-date")
+        self.assertEqual(code, 2)
+        self.assertEqual(lines, [])
+        self.assertIn("invalid --since value 'not-a-date'", err)
+        self.assertNotIn("Traceback", err)
+
+    def test_missing_file_is_clear_error(self):
+        missing = self.path + ".missing"
+        out = io.StringIO()
+        err = io.StringIO()
+        with contextlib.redirect_stderr(err):
+            code = main(["report", missing, "--since", "2024-03-10"], out=out)
+        self.assertEqual(code, 1)
+        self.assertEqual(out.getvalue(), "")
+        self.assertIn("cannot read", err.getvalue())
+        self.assertNotIn("Traceback", err.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
