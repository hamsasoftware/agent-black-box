{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make scan)",
      "Bash(make report)",
      "Bash(python3 -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python3 scripts/secret_scan.py *)",
      "Bash(python3 scripts/validate_files.py)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(wc *)"
    ],
    "ask": [
      "Bash(make run-task *)",
      "Bash(make setup)",
      "Bash(make labels)",
      "Bash(make clean)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(rm *)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(printenv*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(git commit * --no-verify*)",
      "Bash(gh pr merge *)",
      "Edit(/runs/**)",
      "Write(/runs/**)",
      "Edit(/ledger/**)",
      "Write(/ledger/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log_tool_call.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_reminder.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
